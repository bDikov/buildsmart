    private string NormalizeImageUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return "/images/blog/remont-apartament-cover.jpg";

        var trimmed = url.Trim();
        if (trimmed.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || trimmed.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            if (trimmed.Contains("localhost", StringComparison.OrdinalIgnoreCase) || trimmed.Contains("127.0.0.1"))
            {
                try
                {
                    var uri = new Uri(trimmed);
                    return uri.AbsolutePath;
                }
                catch { }
            }
            return trimmed;
        }

        if (!trimmed.StartsWith("/"))
        {
            return "/" + trimmed;
        }

        return trimmed;
    }

    private string GetCoverImage()
    {
        if (_meta != null && !string.IsNullOrWhiteSpace(_meta.Image))
            return NormalizeImageUrl(_meta.Image);

        var slug = (Slug ?? "").ToLower();
        if (slug.Contains("banya")) return "/images/blog/bathroom-renovation-cover.jpg";
        if (slug.Contains("gipskarton")) return "/images/blog/drywall-led-ceiling-cover.jpg";
        if (slug.Contains("red-flags") || slug.Contains("dogovor")) return "/images/blog/contractor-contract-cover.jpg";
        if (slug.Contains("3-staen") || slug.Contains("kazus")) return "/images/blog/apartment-case-study-cover.jpg";

        return "/images/blog/remont-apartament-cover.jpg";
    }

    private string GetFullCoverImageUrl()
    {
        var img = GetCoverImage();
        if (img.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || img.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
            return img;

        return $"https://buildsmart.bg{img}";
    }

    private string GetEstimatorUrl()
    {
        var slug = (Slug ?? "").ToLower();
        if (slug.Contains("banya") || slug.Contains("bathroom"))
        {
            return "/renovation-estimator?scope=bathroom";
        }
        if (slug.Contains("apartament") || slug.Contains("3-staen") || slug.Contains("gipskarton") || slug.Contains("kazus"))
        {
            return "/renovation-estimator?scope=full";
        }
        return "/renovation-estimator";
    }

