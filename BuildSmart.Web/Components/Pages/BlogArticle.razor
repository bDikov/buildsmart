@code {
    [Parameter]
    public string Slug { get; set; } = default!;

    private BlogPostMetadata? _meta;
    private string? _htmlContent;
    private bool _isNotFound;
    private string _currentLang = "bg";

    protected override async Task OnParametersSetAsync()
    {
        _isNotFound = false;
        _meta = null;
        _htmlContent = null;
        _currentLang = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;

        try
        {
            // 1. Fetch metadata from posts.json
            var postsFilePath = Path.Combine(WebHostEnvironment.WebRootPath, "posts", "posts.json");
            if (File.Exists(postsFilePath))
            {
                var jsonContent = await File.ReadAllTextAsync(postsFilePath);
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                var posts = JsonSerializer.Deserialize<List<BlogPostMetadata>>(jsonContent, options);
                _meta = posts?.FirstOrDefault(p => p.Slug.Equals(Slug, StringComparison.OrdinalIgnoreCase));
            }

            // 2. Fetch markdown content and convert (Try {slug}.{lang}.md first, fallback to {slug}.md)
            var localizedMdPath = Path.Combine(WebHostEnvironment.WebRootPath, "posts", $"{Slug}.{_currentLang}.md");
            var defaultMdPath = Path.Combine(WebHostEnvironment.WebRootPath, "posts", $"{Slug}.md");
            
            var targetPath = File.Exists(localizedMdPath) ? localizedMdPath : (File.Exists(defaultMdPath) ? defaultMdPath : null);

            if (targetPath != null)
            {
                var mdContent = await File.ReadAllTextAsync(targetPath);
                var pipeline = new Markdig.MarkdownPipelineBuilder()
                    .UseAdvancedExtensions()
                    .Build();
                _htmlContent = Markdig.Markdown.ToHtml(mdContent, pipeline);
            }
            else
            {
                _isNotFound = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error reading article {Slug}: {ex.Message}");
            _isNotFound = true;
        }
    }

    private string GetTitle() =>
        _meta == null ? "" : (_currentLang == "en" ? (!string.IsNullOrEmpty(_meta.TitleEn) ? _meta.TitleEn : _meta.TitleBg ?? _meta.Title ?? "") : (!string.IsNullOrEmpty(_meta.TitleBg) ? _meta.TitleBg : _meta.TitleEn ?? _meta.Title ?? ""));

    private string GetDescription() =>
        _meta == null ? "" : (_currentLang == "en" ? (!string.IsNullOrEmpty(_meta.DescriptionEn) ? _meta.DescriptionEn : _meta.DescriptionBg ?? _meta.Description ?? "") : (!string.IsNullOrEmpty(_meta.DescriptionBg) ? _meta.DescriptionBg : _meta.DescriptionEn ?? _meta.Description ?? ""));

    private string GetCategory() =>
        _meta == null ? "" : (_currentLang == "en" ? (!string.IsNullOrEmpty(_meta.CategoryEn) ? _meta.CategoryEn : _meta.CategoryBg ?? _meta.Category ?? "") : (!string.IsNullOrEmpty(_meta.CategoryBg) ? _meta.CategoryBg : _meta.CategoryEn ?? _meta.Category ?? ""));

    private string GetReadTime() =>
        _meta == null ? "" : (_currentLang == "en" ? (!string.IsNullOrEmpty(_meta.ReadTimeEn) ? _meta.ReadTimeEn : _meta.ReadTimeBg ?? _meta.ReadTime ?? "") : (!string.IsNullOrEmpty(_meta.ReadTimeBg) ? _meta.ReadTimeBg : _meta.ReadTimeEn ?? _meta.ReadTime ?? ""));

    private string GetKeywords() =>
        _meta == null ? "" : (_currentLang == "en" ? (!string.IsNullOrEmpty(_meta.SeoKeywordsEn) ? _meta.SeoKeywordsEn : _meta.SeoKeywordsBg ?? _meta.SeoKeywords ?? "") : (!string.IsNullOrEmpty(_meta.SeoKeywordsBg) ? _meta.SeoKeywordsBg : _meta.SeoKeywordsEn ?? _meta.SeoKeywords ?? ""));

    public class BlogPostMetadata
    {
        public string Slug { get; set; } = "";
        public string? TitleBg { get; set; }
        public string? TitleEn { get; set; }
        public string? DescriptionBg { get; set; }
        public string? DescriptionEn { get; set; }
        public string Date { get; set; } = "";
        public string? CategoryBg { get; set; }
        public string? CategoryEn { get; set; }
        public string Image { get; set; } = "";
        public string? ReadTimeBg { get; set; }
        public string? ReadTimeEn { get; set; }
        public string? SeoKeywordsBg { get; set; }
        public string? SeoKeywordsEn { get; set; }
        public string? Title { get; set; }
        public string? Description { get; set; }
        public string? Category { get; set; }
        public string? ReadTime { get; set; }
        public string? SeoKeywords { get; set; }
    }
