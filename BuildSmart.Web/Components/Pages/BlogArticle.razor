    public class ArticleSegment
    {
        public string? Html { get; set; }
        public List<HeroCarousel.HeroCarouselItemModel>? CarouselItems { get; set; }
    }

    private List<ArticleSegment> _segments = new();

    private void ProcessMarkdownContent(string mdContent)
    {
        var newSegments = new List<ArticleSegment>();

        // 1. Extract Top Carousel (at the very beginning of the document)
        var matchTop = CarouselRegex.Match(mdContent);
        if (matchTop.Success)
        {
            try
            {
                var json = matchTop.Groups[1].Value;
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                var parsedCarousel = JsonSerializer.Deserialize<List<HeroCarousel.HeroCarouselItemModel>>(json, options);
                if (parsedCarousel != null && parsedCarousel.Count > 0)
                {
                    _carouselItems = parsedCarousel;
                }
            }
            catch { }
            mdContent = CarouselRegex.Replace(mdContent, "").TrimStart();
        }

        var pipeline = new Markdig.MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .Build();

        var cleanMd = VideoCarouselRegex.Replace(mdContent, "");
        _htmlContent = Markdig.Markdown.ToHtml(cleanMd, pipeline);

        // 2. Find all inline video carousels / showcases
        var matches = VideoCarouselRegex.Matches(mdContent);
        if (matches.Count == 0)
        {
            newSegments.Add(new ArticleSegment { Html = _htmlContent });
            _segments = newSegments;
            return;
        }

        int lastIndex = 0;
        foreach (System.Text.RegularExpressions.Match m in matches)
        {
            if (m.Index > lastIndex)
            {
                var textBefore = mdContent.Substring(lastIndex, m.Index - lastIndex);
                if (!string.IsNullOrEmpty(textBefore))
                {
                    var html = Markdig.Markdown.ToHtml(textBefore, pipeline);
                    newSegments.Add(new ArticleSegment { Html = html });
                }
            }

            try
            {
                var json = m.Groups[1].Value;
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                var items = JsonSerializer.Deserialize<List<HeroCarousel.HeroCarouselItemModel>>(json, options);
                if (items != null && items.Count > 0)
                {
                    newSegments.Add(new ArticleSegment { CarouselItems = items });
                }
            }
            catch { }

            lastIndex = m.Index + m.Length;
        }

        if (lastIndex < mdContent.Length)
        {
            var remainingText = mdContent.Substring(lastIndex);
            if (!string.IsNullOrEmpty(remainingText))
            {
                var html = Markdig.Markdown.ToHtml(remainingText, pipeline);
                newSegments.Add(new ArticleSegment { Html = html });
            }
        }

        _segments = newSegments;
    }

    private IDisposable? _locationChangingRegistration;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _locationChangingRegistration = NavManager.RegisterLocationChangingHandler(OnLocationChanging);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[BlogArticle] LocationChangingHandler registration: {ex.Message}");
            }
        }
    }

    private async ValueTask OnLocationChanging(LocationChangingContext context)
    {
        try
        {
            var target = context.TargetLocation;
            if (IsEstimatorOrWizardUrl(target))
            {
                bool isGuest = await CheckIsGuestAsync();
                if (AuthService != null && (!AuthService.IsAuthenticated || isGuest))
                {
                    context.PreventNavigation();
                    _pendingEstimatorUrl = target;
                    _showAuthModal = true;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BlogArticle] OnLocationChanging error: {ex.Message}");
        }
    }

    private bool IsEstimatorOrWizardUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return false;
        return url.Contains("/job-wizard", StringComparison.OrdinalIgnoreCase) ||
               url.Contains("/renovation-estimator", StringComparison.OrdinalIgnoreCase) ||
               url.Contains("/estimator", StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        try
        {
            _locationChangingRegistration?.Dispose();
        }
        catch { }
    }

    private async Task HandleEstimatorClick(string? targetUrl = null)
    {
        var url = !string.IsNullOrEmpty(targetUrl) ? targetUrl : GetEstimatorUrl();
        bool isGuest = await CheckIsGuestAsync();
        if (AuthService != null && (!AuthService.IsAuthenticated || isGuest))
        {
            _pendingEstimatorUrl = url;
            _showAuthModal = true;
            StateHasChanged();
        }
        else
        {
            NavManager.NavigateTo(url);
        }
    }

    private void OnAuthConfirmationChanged(bool proceed)
    {
        _showAuthModal = false;
        if (proceed)
        {
            var dest = !string.IsNullOrEmpty(_pendingEstimatorUrl) ? _pendingEstimatorUrl : GetEstimatorUrl();
            var returnUrl = Uri.EscapeDataString(dest);
            NavManager.NavigateTo($"/create-account?ReturnUrl={returnUrl}");
        }
    }

    private async Task<bool> CheckIsGuestAsync()
    {
        try
        {
            if (AuthService == null) return false;
            var token = await AuthService.GetTokenAsync();
            if (string.IsNullOrEmpty(token)) return false;
            var handler = new System.IdentityModel.Tokens.Jwt.JwtSecurityTokenHandler();
            var jwtToken = handler.ReadJwtToken(token);
            var email = jwtToken.Claims.FirstOrDefault(c =>
                c.Type == "email" ||
                c.Type == "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress")?.Value;
            return email != null && email.EndsWith("@buildsmart.guest", StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            return false;
        }
    }

