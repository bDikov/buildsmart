    // Direct and R2 File Uploads
    private async Task<string?> UploadFileToServerAsync(IBrowserFile file)
    {
        try
        {
            var folderPath = _activePost != null && !string.IsNullOrWhiteSpace(_activePost.Slug)
                ? $"/blog/{_activePost.Slug}"
                : "/blog";

            var urlResult = await ApiClient.RequestFolderUploadUrl.ExecuteAsync(
                folderPath: folderPath,
                fileName: file.Name,
                contentType: file.ContentType ?? "application/octet-stream");

            if (urlResult.Errors.Count == 0 && !string.IsNullOrEmpty(urlResult.Data?.RequestFolderUploadUrl))
            {
                var preSignedUrl = urlResult.Data.RequestFolderUploadUrl;
                using var rawStream = file.OpenReadStream(maxAllowedSize: 500 * 1024 * 1024);
                using var streamContent = new StreamContent(rawStream);
                streamContent.Headers.ContentLength = file.Size;
                var contentTypeHeader = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType;
                streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(contentTypeHeader);

                using var uploadClient = new HttpClient();
                uploadClient.Timeout = TimeSpan.FromMinutes(30);

                var r2Response = await uploadClient.PutAsync(preSignedUrl, streamContent);
                if (r2Response.IsSuccessStatusCode)
                {
                    var uri = new Uri(preSignedUrl);
                    var path = uri.AbsolutePath.TrimStart('/');
                    var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
                    var r2Key = segments.Length > 1 ? string.Join('/', segments.Skip(1)) : path;

                    var regResult = await ApiClient.RegisterUploadedMedia.ExecuteAsync(
                        folderId: null,
                        r2Key: r2Key,
                        fileName: file.Name,
                        contentType: file.ContentType ?? "application/octet-stream",
                        sizeBytes: file.Size,
                        width: null,
                        height: null,
                        durationSeconds: null);

                    if (regResult.Errors.Count == 0 && regResult.Data?.RegisterUploadedMedia != null)
                    {
                        return regResult.Data.RegisterUploadedMedia.PublicUrl;
                    }

                    return $"https://pub-7c580f96b011420fb7163dccc8051790.r2.dev/{r2Key}";
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[R2 Upload Warning] {ex.Message}. Falling back to local disk storage.");
        }

        // Local storage fallback
        try
        {
            var isVideo = file.ContentType != null && file.ContentType.StartsWith("video", StringComparison.OrdinalIgnoreCase);
            var subFolder = isVideo ? "videos/blog" : "images/blog";
            var fileName = $"{Guid.NewGuid()}_{file.Name}";
            var folder = Path.Combine(WebHostEnvironment.WebRootPath, subFolder.Replace('/', Path.DirectorySeparatorChar));
            Directory.CreateDirectory(folder);
            var path = Path.Combine(folder, fileName);

            await using (var rawStream = file.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024))
            await using (var fs = new FileStream(path, FileMode.Create))
            {
                await rawStream.CopyToAsync(fs);
            }

            try
            {
                var binFolder = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "wwwroot", subFolder.Replace('/', Path.DirectorySeparatorChar));
                Directory.CreateDirectory(binFolder);
                File.Copy(path, Path.Combine(binFolder, fileName), overwrite: true);
            }
            catch { }

            return $"/{subFolder}/{fileName}";
        }
        catch (Exception ex)
        {
            _statusMessage = "Грешка при качване на файла: " + ex.Message;
            _isStatusError = true;
            return null;
        }
    }

