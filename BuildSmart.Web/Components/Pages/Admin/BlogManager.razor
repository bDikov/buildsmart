    private void DeleteImageFileAsync(BlogImageOption img)
    {
        try
        {
            var webPath = Path.Combine(WebHostEnvironment.WebRootPath, "images", "blog", img.FileName);
            var binPath = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "wwwroot", "images", "blog", img.FileName);

            if (File.Exists(webPath)) File.Delete(webPath);
            if (File.Exists(binPath)) File.Delete(binPath);

            _blogImageOptions.Remove(img);
            _statusMessage = $"Снимката '{img.FileName}' беше изтрита успешно от диска!";
            _isStatusError = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting image file: {ex.Message}");
        }
    }

