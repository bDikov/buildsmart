                if (File.Exists(bgPath)) File.Delete(bgPath);
                if (File.Exists(enPath)) File.Delete(enPath);
                if (File.Exists(defPath)) File.Delete(defPath);
            }
            catch { }

            _statusMessage = "Post deleted successfully from PostgreSQL!";
            await LoadPostsAsync();
        }
    }

    private string RenderMarkdown(string? md)
    {
        if (string.IsNullOrEmpty(md)) return "";
        var pipeline = new Markdig.MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .Build();
        return Markdig.Markdown.ToHtml(md, pipeline);
    }

    private void CancelEditing()
    {
        _isEditing = false;
    }

