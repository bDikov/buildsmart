    private async Task SavePostAsync()
    {
        if (string.IsNullOrWhiteSpace(_activePost.Slug))
            return;

        try
        {
            await using var db = await DbContextFactory.CreateDbContextAsync();
            var targetSlug = _activePost.Slug.Trim().ToLower();
            var existing = await db.BlogPosts.FirstOrDefaultAsync(b => b.Slug.ToLower() == targetSlug);
            if (existing == null)
            {
                existing = new BlogPost
                {
                    Id = Guid.NewGuid(),
                    Slug = _activePost.Slug.Trim()
                };
                await db.BlogPosts.AddAsync(existing);
            }

            existing.TitleBg = _activePost.TitleBg;
            existing.TitleEn = _activePost.TitleEn;
            existing.DescriptionBg = _activePost.DescriptionBg;
            existing.DescriptionEn = _activePost.DescriptionEn;
            existing.ContentBg = _activePost.ContentBg ?? "";
            existing.ContentEn = _activePost.ContentEn ?? "";
            existing.CoverImageUrl = _activePost.Image ?? "";
            existing.CategoryBg = _activePost.CategoryBg;
            existing.CategoryEn = _activePost.CategoryEn;
            existing.ReadTimeBg = _activePost.ReadTimeBg;
            existing.ReadTimeEn = _activePost.ReadTimeEn;
            existing.SeoKeywordsBg = _activePost.SeoKeywordsBg;
            existing.SeoKeywordsEn = _activePost.SeoKeywordsEn;
            existing.UpdatedAt = DateTime.UtcNow;

            if (DateTime.TryParse(_activePost.Date, out var dt))
            {
                existing.PublishedAt = DateTime.SpecifyKind(dt, DateTimeKind.Utc);
            }

            await db.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving post to DB: {ex.Message}");
        }

        // Also save to local posts.json / md files for backwards compatibility
        try
        {
            var postsFilePath = Path.Combine(WebHostEnvironment.WebRootPath, "posts", "posts.json");
            Directory.CreateDirectory(Path.Combine(WebHostEnvironment.WebRootPath, "posts"));

            var existingIndex = _posts!.FindIndex(p => p.Slug.Equals(_activePost.Slug, StringComparison.OrdinalIgnoreCase));
            if (existingIndex >= 0) _posts[existingIndex] = _activePost;
            else _posts.Add(_activePost);

            var options = new JsonSerializerOptions { WriteIndented = true };
            var jsonContent = JsonSerializer.Serialize(_posts, options);
            await File.WriteAllTextAsync(postsFilePath, jsonContent);

            if (!string.IsNullOrWhiteSpace(_activePost.ContentBg))
            {
                await File.WriteAllTextAsync(Path.Combine(WebHostEnvironment.WebRootPath, "posts", $"{_activePost.Slug}.bg.md"), _activePost.ContentBg);
            }
            if (!string.IsNullOrWhiteSpace(_activePost.ContentEn))
            {
                await File.WriteAllTextAsync(Path.Combine(WebHostEnvironment.WebRootPath, "posts", $"{_activePost.Slug}.en.md"), _activePost.ContentEn);
            }
        }
        catch { }

        _statusMessage = "Post saved successfully to PostgreSQL database!";
        _isEditing = false;
        await LoadPostsAsync();
    }

