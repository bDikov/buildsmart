    // Media Picker Dialog methods
    private void OpenMediaPickerForTarget(string target, string allowedType = "all")
    {
        _libraryPickerTarget = target;
        _pickerAllowedType = allowedType;
        _showMediaPickerModal = true;
    }

    private void OnPickerAssetSelected(MediaAssetDto asset)
    {
        var resolvedType = string.Equals(asset.MediaType, "video", StringComparison.OrdinalIgnoreCase) ||
                           (!string.IsNullOrEmpty(asset.PublicUrl) && asset.PublicUrl.EndsWith(".mp4", StringComparison.OrdinalIgnoreCase))
                            ? "video" : "image";
        var assetUrl = !string.IsNullOrEmpty(asset.PublicUrl) ? asset.PublicUrl : asset.Url;

        if (_libraryPickerTarget == "cover-image")
        {
            _activePost.Image = assetUrl;
        }
        else if (_libraryPickerTarget == "carousel-add")
        {
            _heroCarouselItems.Add(new HeroCarousel.HeroCarouselItemModel
            {
                Url = assetUrl,
                Type = resolvedType,
                CaptionBg = asset.AltTextBg ?? "",
                CaptionEn = asset.AltTextEn ?? "",
                Order = _heroCarouselItems.Count + 1
            });
        }
        else if (_libraryPickerTarget.StartsWith("carousel-item-"))
        {
            var indexStr = _libraryPickerTarget.Replace("carousel-item-", "");
            if (int.TryParse(indexStr, out var idx) && idx >= 0 && idx < _heroCarouselItems.Count)
            {
                _heroCarouselItems[idx].Url = assetUrl;
                _heroCarouselItems[idx].Type = resolvedType;
            }
        }
        else if (_libraryPickerTarget == "bottom-video-add")
        {
            _bottomVideoItems.Add(new HeroCarousel.HeroCarouselItemModel
            {
                Url = assetUrl,
                Type = "video",
                CaptionBg = asset.AltTextBg ?? "",
                CaptionEn = asset.AltTextEn ?? "",
                Order = _bottomVideoItems.Count + 1
            });
        }
        else if (_libraryPickerTarget.StartsWith("bottom-video-item-"))
        {
            var indexStr = _libraryPickerTarget.Replace("bottom-video-item-", "");
            if (int.TryParse(indexStr, out var idx) && idx >= 0 && idx < _bottomVideoItems.Count)
            {
                _bottomVideoItems[idx].Url = assetUrl;
                _bottomVideoItems[idx].Type = "video";
            }
        }
        else if (_libraryPickerTarget == "inline-image-bg")
        {
            var markdownImage = $"\n![{asset.FileName}]({assetUrl})\n";
            InsertSnippet(markdownImage, "bg");
        }
        else if (_libraryPickerTarget == "inline-image-en")
        {
            var markdownImage = $"\n![{asset.FileName}]({assetUrl})\n";
            InsertSnippet(markdownImage, "en");
        }

        _showMediaPickerModal = false;
        _libraryPickerTarget = string.Empty;
        StateHasChanged();
    }

    // Top Hero Carousel Management Methods
    private async Task UploadCarouselSlideFile(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        var url = await UploadFileToServerAsync(file);
        if (!string.IsNullOrEmpty(url))
        {
            var isVideo = file.ContentType != null && file.ContentType.StartsWith("video", StringComparison.OrdinalIgnoreCase);
            _heroCarouselItems.Add(new HeroCarousel.HeroCarouselItemModel
            {
                Url = url,
                Type = isVideo ? "video" : "image",
                Order = _heroCarouselItems.Count + 1
            });
            _statusMessage = "Слайдът беше качен и добавен към карусела!";
            _isStatusError = false;
            StateHasChanged();
        }
    }

    private void RemoveCarouselItem(int index)
    {
        if (index >= 0 && index < _heroCarouselItems.Count)
        {
            _heroCarouselItems.RemoveAt(index);
        }
    }

    private void MoveCarouselItemUp(int index)
    {
        if (index > 0 && index < _heroCarouselItems.Count)
        {
            var item = _heroCarouselItems[index];
            _heroCarouselItems.RemoveAt(index);
            _heroCarouselItems.Insert(index - 1, item);
        }
    }

    private void MoveCarouselItemDown(int index)
    {
        if (index >= 0 && index < _heroCarouselItems.Count - 1)
        {
            var item = _heroCarouselItems[index];
            _heroCarouselItems.RemoveAt(index);
            _heroCarouselItems.Insert(index + 1, item);
        }
    }

    // Bottom Video Carousel Management Methods
    private async Task UploadBottomVideoSlideFile(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        var url = await UploadFileToServerAsync(file);
        if (!string.IsNullOrEmpty(url))
        {
            _bottomVideoItems.Add(new HeroCarousel.HeroCarouselItemModel
            {
                Url = url,
                Type = "video",
                Order = _bottomVideoItems.Count + 1
            });
            _statusMessage = "Видеото беше качено и добавено в крайния слайдер!";
            _isStatusError = false;
            StateHasChanged();
        }
    }

    private void RemoveBottomVideoItem(int index)
    {
        if (index >= 0 && index < _bottomVideoItems.Count)
        {
            _bottomVideoItems.RemoveAt(index);
        }
    }

    private void MoveBottomVideoItemUp(int index)
    {
        if (index > 0 && index < _bottomVideoItems.Count)
        {
            var item = _bottomVideoItems[index];
            _bottomVideoItems.RemoveAt(index);
            _bottomVideoItems.Insert(index - 1, item);
        }
    }

    private void MoveBottomVideoItemDown(int index)
    {
        if (index >= 0 && index < _bottomVideoItems.Count - 1)
        {
            var item = _bottomVideoItems[index];
            _bottomVideoItems.RemoveAt(index);
            _bottomVideoItems.Insert(index + 1, item);
        }
    }

