    private async Task<(MemoryStream Stream, string ContentType, string WebpFileName)> OptimizeAndCompressImageAsync(IBrowserFile file, int maxWidth = 1200)
    {
        using var rawStream = file.OpenReadStream(maxAllowedSize: 30 * 1024 * 1024);
        using var tempMemStream = new MemoryStream();
        await rawStream.CopyToAsync(tempMemStream);
        tempMemStream.Position = 0;

        using var originalBitmap = SKBitmap.Decode(tempMemStream);
        if (originalBitmap == null)
        {
            // If bitmap decode fails, fallback to original stream
            tempMemStream.Position = 0;
            var fallbackMs = new MemoryStream();
            await tempMemStream.CopyToAsync(fallbackMs);
            fallbackMs.Position = 0;
            return (fallbackMs, file.ContentType, file.Name);
        }

        SKBitmap targetBitmap = originalBitmap;
        bool wasResized = false;

        if (originalBitmap.Width > maxWidth)
        {
            var newHeight = (int)((double)originalBitmap.Height / originalBitmap.Width * maxWidth);
            var imageInfo = new SKImageInfo(maxWidth, newHeight, originalBitmap.ColorType, originalBitmap.AlphaType);
            targetBitmap = originalBitmap.Resize(imageInfo, SKFilterQuality.High);
            wasResized = true;
        }

        using var image = SKImage.FromBitmap(targetBitmap ?? originalBitmap);
        using var data = image.Encode(SKEncodedImageFormat.Webp, 80);

        var outputStream = new MemoryStream();
        data.SaveTo(outputStream);
        outputStream.Position = 0;

        if (wasResized && targetBitmap != null)
        {
            targetBitmap.Dispose();
        }

        var nameWithoutExt = Path.GetFileNameWithoutExtension(file.Name);
        var webpFileName = $"{nameWithoutExt}.webp";

        return (outputStream, "image/webp", webpFileName);
    }

