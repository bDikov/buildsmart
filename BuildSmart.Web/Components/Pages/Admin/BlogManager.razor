    private void ScanBlogImages()
    {
        _blogImageOptions.Clear();
        var folder = Path.Combine(WebHostEnvironment.WebRootPath, "images", "blog");
        if (Directory.Exists(folder))
        {
            var files = Directory.GetFiles(folder, "*.*")
                .Where(f => f.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) ||
                            f.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) ||
                            f.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ||
                            f.EndsWith(".webp", StringComparison.OrdinalIgnoreCase))
                .Select(f => new FileInfo(f))
                .OrderByDescending(f => f.LastWriteTime)
                .ToList();

            foreach (var fi in files)
            {
                _blogImageOptions.Add(new BlogImageOption
                {
                    FileName = fi.Name,
                    Url = $"/images/blog/{fi.Name}",
                    FileSizeBytes = fi.Length
                });
            }
        }
    }

    private async Task UploadGalleryImageAsync(InputFileChangeEventArgs e)
    {
