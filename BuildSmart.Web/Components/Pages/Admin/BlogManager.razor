@page "/admin/blog"
@using Microsoft.AspNetCore.Authorization
@using Markdig
@attribute [Authorize(Roles = "Admin, ADMIN, admin")]
@using System.Text.Json
@using System.IO
@using Microsoft.AspNetCore.Hosting
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Localization
@using BuildSmart.Infrastructure.Persistence
@using BuildSmart.Core.Domain.Entities
@using BuildSmart.Core.Application.DTOs
@using BuildSmart.SharedUI.GraphQL
@using BuildSmart.SharedUI.Components.Common
@using BuildSmart.SharedUI.Components.Pages.Landing
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject IWebHostEnvironment WebHostEnvironment
@inject IStringLocalizer<BuildSmart.SharedUI.Resources.AppResources> Loc
@inject NavigationManager NavManager
@inject BuildSmartApiClient ApiClient
@inject IConfiguration Configuration

<PageTitle>@Loc["Admin_BlogManager"] - BuildSmart</PageTitle>

<div class="admin-blog-container container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="admin-page-title m-0">@Loc["Admin_BlogManager"]</h1>
            <p class="text-muted small m-0">@Loc["Admin_BlogManager_Subtitle"]</p>
        </div>
        @if (!_isEditing)
        {
            <div class="d-flex gap-2 flex-wrap">
                <button class="btn btn-outline-secondary" @onclick='() => NavManager.NavigateTo("/admin/media-library")'>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                    @Loc["Media_LibraryTitle"]
                </button>
                <button class="btn btn-outline-secondary" @onclick="OpenImageGalleryModal">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                    @Loc["Admin_PhotoGallery"]
                </button>
                <button class="btn btn-primary" @onclick="CreateNewPost">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="me-1"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    @Loc["Admin_CreatePost"]
                </button>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="alert @(_isStatusError ? "alert-danger" : "alert-success") alert-dismissible fade show mb-4" role="alert">
            @_statusMessage
            <button type="button" class="btn-close" @onclick='() => _statusMessage = null'></button>
        </div>
    }

    @if (!_isEditing)
    {
        <!-- POSTS LIST TABLE -->
        <div class="admin-card">
            @if (_posts == null)
            {
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else if (!_posts.Any())
            {
                <div class="text-center py-4">
                    <p class="text-secondary m-0">No posts available. Create your first post!</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table admin-table align-middle m-0">
                        <thead>
                            <tr>
                                <th>@Loc["Admin_Title"]</th>
                                <th>@Loc["Admin_Category"]</th>
                                <th>@Loc["Admin_Date"]</th>
                                <th>@Loc["Admin_ReadTime"]</th>
                                <th>@Loc["Cms_Published"]</th>
                                <th class="text-end">@Loc["Admin_Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var post in _posts)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-primary-custom">@GetDisplayTitle(post)</div>
                                        <div class="small text-muted">/blog/@post.Slug</div>
                                    </td>
                                    <td><span class="badge bg-card-alt text-primary-custom">@GetDisplayCategory(post)</span></td>
                                    <td>@post.Date</td>
                                    <td>@GetDisplayReadTime(post)</td>
                                    <td>
                                        <span class="badge @(post.IsPublished ? "bg-success" : "bg-secondary")">
                                            @(post.IsPublished ? Loc["Admin_Status_Published"] : Loc["Admin_Status_Draft"])
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a href="/blog/@post.Slug" target="_blank" class="btn btn-sm btn-outline-secondary me-2">
                                            @Loc["Admin_Preview"]
                                        </a>
                                        <button class="btn btn-sm btn-secondary me-2" @onclick="() => EditPost(post)">
                                            @Loc["Admin_EditPost"]
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => PromptDeletePost(post.Slug)">
                                            @Loc["Admin_DeletePost"]
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
    else
    {
        <!-- MODERN 2-COLUMN CMS STUDIO -->
        <div class="blog-studio-container">
            <!-- Studio Top Action Bar -->
            <div class="admin-card studio-top-bar mb-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" @onclick="CancelEditing">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                            @Loc["Admin_Cancel"]
                        </button>
                        <div class="studio-lang-switch">
                            <button type="button" class="lang-pill-btn @(_formLang == "bg" ? "active" : "")" @onclick='() => _formLang = "bg"'>
                                Български (BG)
                            </button>
                            <button type="button" class="lang-pill-btn @(_formLang == "en" ? "active" : "")" @onclick='() => _formLang = "en"'>
                                English (EN)
                            </button>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        @if (!_isNew && !string.IsNullOrEmpty(_activePost.Slug))
                        {
                            <a href="/blog/@_activePost.Slug" target="_blank" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                                @Loc["Admin_LivePreview"]
                            </a>
                        }
                        <button type="button" class="btn btn-sm btn-primary px-4 d-flex align-items-center gap-1" @onclick="SavePostAsync">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                            @Loc["Admin_Save"]
                        </button>
                    </div>
                </div>
            </div>

            <div class="blog-editor-grid">
                <!-- LEFT MAIN COLUMN (70% Canvas) -->
                <div class="editor-main-column">
                    <!-- Distraction-Free Title & Excerpt -->
                    <div class="admin-card canvas-card mb-4">
                        <input type="text" 
                               class="post-title-input" 
                               placeholder="@(_formLang == "bg" ? "Въведете заглавие на статията тук..." : "Enter article title here...")" 
                               @bind="CurrentTitle" 
                               @bind:after="OnTitleChanged" 
                               required />
                        <textarea class="post-excerpt-input" 
                                  rows="2" 
                                  placeholder="@(_formLang == "bg" ? "Кратко въведение и резюме на статията..." : "Short excerpt and summary...")" 
                                  @bind="CurrentDescription"></textarea>
                    </div>

                    <!-- Top Interactive Hero Carousel Builder Card -->
                    <div class="admin-card carousel-builder-card mb-4">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                            <div>
                                <h3 class="h6 fw-bold m-0 text-primary d-flex align-items-center gap-2">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect><line x1="7" y1="2" x2="7" y2="22"></line><line x1="17" y1="2" x2="17" y2="22"></line></svg>
                                    @Loc["Admin_InteractiveSlider"]
                                </h3>
                                <p class="text-muted small m-0">@Loc["Admin_InteractiveSliderSubtitle"]</p>
                            </div>
                            <div class="d-flex gap-2 flex-wrap">
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='() => OpenMediaPickerForTarget("carousel-add")'>
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                                    @Loc["Admin_MediaLibraryShort"]
                                </button>
                                <label class="btn btn-sm btn-primary mb-0">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                    @Loc["Admin_UploadSlide"]
                                    <InputFile OnChange="UploadCarouselSlideFile" accept="image/*,video/*" class="d-none" />
                                </label>
                            </div>
                        </div>

                        <div class="carousel-slide-grid">
                            @for (int i = 0; i < _heroCarouselItems.Count; i++)
                            {
                                var index = i;
                                var item = _heroCarouselItems[index];
                                <div class="slide-card">
                                    <div class="slide-preview-thumb">
                                        @if (item.Type == "video" && !string.IsNullOrEmpty(item.Url))
                                        {
                                            <video src="@item.Url" muted playsinline></video>
                                            <span class="slide-badge video">VIDEO</span>
                                        }
                                        else if (!string.IsNullOrEmpty(item.Url))
                                        {
                                            <img src="@item.Url" alt="Slide" />
                                            <span class="slide-badge img">IMG</span>
                                        }
                                        else
                                        {
                                            <div class="slide-placeholder">@Loc["Admin_EmptySlide"]</div>
                                        }

                                        <div class="slide-actions-overlay">
                                            <button type="button" class="action-btn" disabled="@(index == 0)" @onclick="() => MoveCarouselItemUp(index)" title="@Loc["Admin_MoveUp"]">
                                                ▲
                                            </button>
                                            <button type="button" class="action-btn" disabled="@(index == _heroCarouselItems.Count - 1)" @onclick="() => MoveCarouselItemDown(index)" title="@Loc["Admin_MoveDown"]">
                                                ▼
                                            </button>
                                            <button type="button" class="action-btn danger" @onclick="() => RemoveCarouselItem(index)" title="@Loc["Admin_Remove"]">
                                                ✕
                                            </button>
                                        </div>
                                    </div>

                                    <div class="slide-fields">
                                        <div class="d-flex gap-1">
                                            <select class="form-select form-select-sm" style="width: 90px;" @bind="item.Type">
                                                <option value="image">@Loc["Admin_SlideImage"]</option>
                                                <option value="video">@Loc["Admin_SlideVideo"]</option>
                                            </select>
                                            <div class="input-group input-group-sm flex-grow-1">
                                                <input type="text" class="form-control" @bind="item.Url" placeholder="URL..." />
                                                <button class="btn btn-outline-secondary" type="button" @onclick='() => OpenMediaPickerForTarget($"carousel-item-{index}", item.Type)'>@Loc["Admin_MediaLibraryShort"]</button>
                                            </div>
                                        </div>
                                        <input type="text" class="form-control form-control-sm" @bind="item.CaptionBg" placeholder="@Loc["Admin_CaptionBg"]" />
                                        <input type="text" class="form-control form-control-sm" @bind="item.CaptionEn" placeholder="@Loc["Admin_CaptionEn"]" />
                                    </div>
                                </div>
                            }

                            <!-- Add Slide Dropzone Tile -->
                            <div class="add-slide-dropzone" @onclick='() => OpenMediaPickerForTarget("carousel-add")'>
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="12" y1="5" x2="12" y2="19"></line>
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                </svg>
                                <span>@Loc["Admin_AddSlide"]</span>
                            </div>
                        </div>
                    </div>

                    <!-- Bottom Video Carousel (Showcase) Builder Card -->
                    <div class="admin-card carousel-builder-card mb-4" style="border-left: 4px solid var(--color-primary);">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                            <div>
                                <h3 class="h6 fw-bold m-0 text-primary d-flex align-items-center gap-2">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
                                    @Loc["Admin_BottomVideosCarousel"]
                                </h3>
                                <p class="text-muted small m-0">@Loc["Admin_BottomVideosCarouselSubtitle"]</p>
                            </div>
                            <div class="d-flex gap-2 flex-wrap">
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='() => OpenVideoSelectorModal(_formLang)'>
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
                                    @Loc["Admin_Toolbar_CatalogVideo"]
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='() => OpenMediaPickerForTarget("bottom-video-add", "video")'>
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                                    @Loc["Admin_MediaLibraryShort"]
                                </button>
                                <label class="btn btn-sm btn-primary mb-0">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                    @Loc["Admin_AddVideoSlide"]
                                    <InputFile OnChange="UploadBottomVideoSlideFile" accept="video/mp4,video/*" class="d-none" />
                                </label>
                            </div>
                        </div>

                        <div class="carousel-slide-grid">
                            @for (int i = 0; i < _bottomVideoItems.Count; i++)
                            {
                                var index = i;
                                var item = _bottomVideoItems[index];
                                <div class="slide-card">
                                    <div class="slide-preview-thumb">
                                        @if (!string.IsNullOrEmpty(item.Url))
                                        {
                                            <video src="@item.Url" muted playsinline></video>
                                            <span class="slide-badge video">VIDEO</span>
                                        }
                                        else
                                        {
                                            <div class="slide-placeholder">@Loc["Admin_EmptySlide"]</div>
                                        }

                                        <div class="slide-actions-overlay">
                                            <button type="button" class="action-btn" disabled="@(index == 0)" @onclick="() => MoveBottomVideoItemUp(index)" title="@Loc["Admin_MoveUp"]">
                                                ▲
                                            </button>
                                            <button type="button" class="action-btn" disabled="@(index == _bottomVideoItems.Count - 1)" @onclick="() => MoveBottomVideoItemDown(index)" title="@Loc["Admin_MoveDown"]">
                                                ▼
                                            </button>
                                            <button type="button" class="action-btn danger" @onclick="() => RemoveBottomVideoItem(index)" title="@Loc["Admin_Remove"]">
                                                ✕
                                            </button>
                                        </div>
                                    </div>

                                    <div class="slide-fields">
                                        <div class="input-group input-group-sm">
                                            <input type="text" class="form-control" @bind="item.Url" placeholder="Video URL..." />
                                            <button class="btn btn-outline-secondary" type="button" @onclick='() => OpenMediaPickerForTarget($"bottom-video-item-{index}", "video")'>@Loc["Admin_MediaLibraryShort"]</button>
                                        </div>
                                        <input type="text" class="form-control form-control-sm" @bind="item.CaptionBg" placeholder="@Loc["Admin_CaptionBg"]" />
                                        <input type="text" class="form-control form-control-sm" @bind="item.CaptionEn" placeholder="@Loc["Admin_CaptionEn"]" />
                                    </div>
                                </div>
                            }

                            <!-- Add Bottom Video Dropzone Tile -->
                            <div class="add-slide-dropzone" @onclick='() => OpenVideoSelectorModal(_formLang)'>
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polygon points="23 7 16 12 23 17 23 7"></polygon>
                                    <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                                </svg>
                                <span>@Loc["Admin_AddVideoSlide"]</span>
                            </div>
                        </div>
                    </div>

                    <!-- Rich Visual Toolbar & Content Workspace -->
                    <div class="admin-card editor-workspace-card">
                        <div class="editor-toolbar-header">
                            <div class="toolbar-group">
                                <button type="button" class="toolbar-btn" title="Heading 2" @onclick='() => InsertSnippet("## ", _formLang)'>H2</button>
                                <button type="button" class="toolbar-btn" title="Heading 3" @onclick='() => InsertSnippet("### ", _formLang)'>H3</button>
                                <div class="toolbar-divider"></div>
                                <button type="button" class="toolbar-btn" title="Bold" @onclick='() => InsertSnippet("**bold text**", _formLang)'>
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"></path><path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"></path></svg>
                                </button>
                                <button type="button" class="toolbar-btn" title="Italic" @onclick='() => InsertSnippet("*italic text*", _formLang)'>
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="4" x2="10" y2="4"></line><line x1="14" y1="20" x2="5" y2="20"></line><line x1="15" y1="4" x2="9" y2="20"></line></svg>
                                </button>
                                <button type="button" class="toolbar-btn" title="Quote" @onclick='() => InsertSnippet("> Цитат или важна бележка\n", _formLang)'>
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"></path></svg>
                                </button>
                                <button type="button" class="toolbar-btn" title="Bullet List" @onclick='() => InsertSnippet("- Точка 1\n- Точка 2\n", _formLang)'>
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                                </button>
                            </div>

                            <div class="toolbar-group">
                                <button type="button" class="toolbar-pill-btn info" @onclick='() => InsertSnippet("\n<div class=\"blog-callout blog-callout-info\">\nИнформационен акцент\n</div>\n", _formLang)'>
                                    @Loc["Admin_Toolbar_InfoBox"]
                                </button>
                                <button type="button" class="toolbar-pill-btn warning" @onclick='() => InsertSnippet("\n<div class=\"blog-callout blog-callout-warning\">\nВнимание / Предупреждение\n</div>\n", _formLang)'>
                                    @Loc["Admin_Toolbar_WarningBox"]
                                </button>
                                <button type="button" class="toolbar-pill-btn" @onclick='() => OpenMediaPickerForTarget($"inline-image-{_formLang}", "image")'>
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                    @Loc["Admin_Toolbar_LibraryImage"]
                                </button>
                                <label class="toolbar-pill-btn mb-0">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                    @Loc["Admin_Toolbar_UploadImage"]
                                    <InputFile OnChange='e => UploadInlineImageAsync(e, _formLang)' accept="image/*" class="d-none" />
                                </label>
                                <button type="button" class="toolbar-pill-btn" @onclick='() => OpenVideoSelectorModal(_formLang)'>
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
                                    @Loc["Admin_Toolbar_CatalogVideo"]
                                </button>
                                <label class="toolbar-pill-btn mb-0">
                                    @Loc["Admin_Toolbar_UploadVideo"]
                                    <InputFile OnChange='e => UploadInlineVideoAsync(e, _formLang)' accept="video/mp4,video/*" class="d-none" />
                                </label>
                                <button type="button" class="toolbar-pill-btn cta" @onclick='() => InsertSnippet("\n<div class=\"blog-calc-cta\">\n### Искате точна оферта за вашия ремонт?\n[Изчислете точна оферта в нашия Калкулатор](/job-wizard)\n</div>\n", _formLang)'>
                                    @Loc["Admin_Toolbar_CtaCalc"]
                                </button>
                            </div>

                            <!-- View Mode Switcher -->
                            <div class="view-mode-toggle">
                                <button type="button" class="mode-btn @(_editorMode == "write" ? "active" : "")" @onclick='() => _editorMode = "write"'>
                                    @Loc["Admin_Mode_Write"]
                                </button>
                                <button type="button" class="mode-btn @(_editorMode == "split" ? "active" : "")" @onclick='() => _editorMode = "split"'>
                                    @Loc["Admin_Mode_Split"]
                                </button>
                                <button type="button" class="mode-btn @(_editorMode == "preview" ? "active" : "")" @onclick='() => _editorMode = "preview"'>
                                    @Loc["Admin_Mode_Preview"]
                                </button>
                            </div>
                        </div>

                        <!-- Content Workspace -->
                        <div class="editor-pane-container mode-@_editorMode">
                            @if (_editorMode == "write" || _editorMode == "split")
                            {
                                <div class="editor-input-pane">
                                    <textarea class="content-raw-textarea" 
                                              @bind="CurrentContent" 
                                              placeholder="Пишете съдържанието на статията в Markdown формат..."></textarea>
                                </div>
                            }
                            @if (_editorMode == "preview" || _editorMode == "split")
                            {
                                <div class="editor-preview-pane">
                                    <div class="blog-article-preview">
                                        @((MarkupString)RenderMarkdown(CurrentContent))
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- RIGHT SIDEBAR (30% Settings Column) -->
                <div class="editor-sidebar-column">
                    <!-- Card 1: Publish Actions & Status Switch -->
                    <div class="admin-card sidebar-card mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h4 class="h6 fw-bold m-0">@Loc["Admin_Publishing"]</h4>
                            <span class="badge @(_activePost.IsPublished ? "bg-success" : "bg-secondary")">
                                @(_activePost.IsPublished ? Loc["Admin_Status_Published"] : Loc["Admin_Status_Draft"])
                            </span>
                        </div>

                        <div class="form-check form-switch mb-3 p-2 bg-card-alt rounded">
                            <input class="form-check-input ms-0 me-2" type="checkbox" role="switch" id="publishStateSwitch" @bind="_activePost.IsPublished" />
                            <label class="form-check-label small fw-bold" for="publishStateSwitch">@Loc["Admin_Status_IsPublished"]</label>
                        </div>

                        <div class="d-flex flex-column gap-2">
                            <button type="button" class="btn btn-primary w-100 py-2 d-flex align-items-center justify-content-center gap-2" @onclick="SavePostAsync">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                                @Loc["Admin_Save"]
                            </button>

                            @if (!_isNew && !string.IsNullOrEmpty(_activePost.Slug))
                            {
                                <a href="/blog/@_activePost.Slug" target="_blank" class="btn btn-outline-secondary w-100 text-center text-decoration-none">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                                    @Loc["Admin_LivePreview"]
                                </a>
                            }

                            <button type="button" class="btn btn-secondary w-100" @onclick="CancelEditing">
                                @Loc["Admin_Cancel"]
                            </button>
                        </div>
                    </div>

                    <!-- Card 2: Cover Photo Card with Dropzone & Library Picker -->
                    <div class="admin-card sidebar-card mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h4 class="h6 fw-bold m-0">@Loc["Admin_CoverImage"]</h4>
                        </div>

                        <div class="cover-photo-container">
                            @if (!string.IsNullOrEmpty(_activePost.Image))
                            {
                                <div class="cover-image-preview position-relative overflow-hidden rounded mb-2" style="height: 140px; background: #000;">
                                    <img src="@_activePost.Image" alt="Cover" style="width: 100%; height: 100%; object-fit: cover;" />
                                    <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-2 py-0 px-2" @onclick="() => _activePost.Image = string.Empty" title="@Loc["Admin_Remove"]">
                                        ✕
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="cover-dropzone mb-2" @onclick='() => OpenMediaPickerForTarget("cover-image", "image")'>
                                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                        <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                        <polyline points="21 15 16 10 5 21"></polyline>
                                    </svg>
                                    <span class="small text-muted">@Loc["Admin_CoverImage_Dropzone"]</span>
                                </div>
                            }

                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control" @bind="_activePost.Image" placeholder="/images/blog/cover.jpg" />
                                <button type="button" class="btn btn-outline-secondary" @onclick='() => OpenMediaPickerForTarget("cover-image", "image")' title="@Loc["Admin_MediaLibraryShort"]">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                                </button>
                                <label class="btn btn-secondary mb-0">
                                    @Loc["Admin_Upload"]
                                    <InputFile OnChange="UploadCoverImageAsync" accept="image/*" class="d-none" />
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Card 3: Document Metadata -->
                    <div class="admin-card sidebar-card mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h4 class="h6 fw-bold m-0">@Loc["Admin_ArticleSettings"]</h4>
                        </div>

                        <div class="d-flex flex-column gap-3">
                            <div>
                                <label class="form-label small fw-bold mb-1">URL Адрес (@Loc["Admin_Slug"]) *</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">/blog/</span>
                                    <input type="text" class="form-control" @bind="_activePost.Slug" required />
                                </div>
                            </div>

                            <div>
                                <label class="form-label small fw-bold mb-1">@Loc["Admin_Category"] (@_formLang.ToUpper())</label>
                                <div class="d-flex flex-column gap-1">
                                    <select class="form-select form-select-sm" @onchange="OnCategoryDropdownSelected">
                                        <option value="">@Loc["Admin_SelectCategory_Default"]</option>
                                        @foreach (var cat in _availableCategories)
                                        {
                                            <option value="@cat" selected="@(CurrentCategory == cat)">@cat</option>
                                        }
                                    </select>
                                    <input type="text" class="form-control form-control-sm" @bind="CurrentCategory" placeholder="@Loc["Admin_CustomCategory_Placeholder"]" />
                                </div>
                            </div>

                            <div>
                                <label class="form-label small fw-bold mb-1">@Loc["Admin_ReadTime"] (@_formLang.ToUpper())</label>
                                <input type="text" class="form-control form-control-sm" @bind="CurrentReadTime" placeholder="e.g. 5 мин." />
                            </div>

                            <div>
                                <label class="form-label small fw-bold mb-1">@Loc["Admin_Date"]</label>
                                <input type="text" class="form-control form-control-sm" @bind="_activePost.Date" placeholder="yyyy-MM-dd" />
                            </div>
                        </div>
                    </div>

                    <!-- Card 4: Collapsible SEO & Google SERP Preview Card -->
                    <div class="admin-card sidebar-card mb-4">
                        <div class="d-flex justify-content-between align-items-center" @onclick="() => _seoExpanded = !_seoExpanded" style="cursor: pointer;">
                            <h4 class="h6 fw-bold m-0">@Loc["Admin_SeoGooglePreview"]</h4>
                            <span class="small text-muted">@(_seoExpanded ? "▲" : "▼")</span>
                        </div>

                        @if (_seoExpanded)
                        {
                            <div class="mt-3">
                                <div class="mb-3">
                                    <label class="form-label small fw-bold mb-1">@Loc["Admin_SeoKeywords"] (@_formLang.ToUpper())</label>
                                    <input type="text" class="form-control form-control-sm" @bind="CurrentSeoKeywords" placeholder="ремонт апартамент софия, цени" />
                                </div>

                                <!-- SERP Snippet Preview -->
                                <div class="serp-preview-box p-3 rounded">
                                    <span class="serp-url text-muted small d-block mb-1">https://buildsmart.bg > blog > @(_activePost.Slug)</span>
                                    <h5 class="serp-title text-primary small fw-bold m-0 mb-1">@(string.IsNullOrEmpty(CurrentTitle) ? "Заглавие на статията" : CurrentTitle)</h5>
                                    <p class="serp-desc text-muted small m-0">@(string.IsNullOrEmpty(CurrentDescription) ? "Кратко описание на статията, както ще се визуализира в резултатите на Google..." : CurrentDescription)</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- CENTRAL MEDIA PICKER MODAL -->
<MediaPickerModal 
    IsOpen="_showMediaPickerModal" 
    InitialFolder="" 
    AllowedType="@_pickerAllowedType" 
    OnAssetSelected="OnPickerAssetSelected" 
    OnClose="() => _showMediaPickerModal = false" />

<!-- MULTI-VIDEO SELECTION MODAL -->
@if (_showVideoSelectorModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.65); z-index: 1060;">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content bg-card border shadow-lg">
                <div class="modal-header border-bottom d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="modal-title fw-bold text-primary m-0">@Loc["Admin_VideoSelector_Title"]</h5>
                        <span class="text-muted small">@string.Format(Loc["Admin_VideoSelector_SelectedCount"], _selectedVideoUrls.Count)</span>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseVideoSelectorModal"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">@Loc["Admin_VideoSelector_SingleOrMulti"]</p>

                    <!-- TOP ACTIONS BAR IN MODAL -->
                    <div class="d-flex justify-content-between align-items-center gap-2 mb-3 flex-wrap p-2 bg-card-alt rounded">
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="SelectAllVideos">
                                Избери всички
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearVideoSelection">
                                Изчисти избора
                            </button>
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            @if (_selectedVideoUrls.Count == 1)
                            {
                                <button type="button" class="btn btn-sm btn-success shadow-sm" @onclick="InsertSelectedSingleVideo">
                                    @Loc["Admin_VideoSelector_InsertSingle"]
                                </button>
                            }
                            @if (_selectedVideoUrls.Count > 0)
                            {
                                <button type="button" class="btn btn-sm btn-primary shadow-sm" @onclick="InsertSelectedVideosAsCarousel">
                                    @string.Format(Loc["Admin_VideoSelector_InsertCarousel"], _selectedVideoUrls.Count)
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary shadow-sm" @onclick="AddSelectedVideosToBottomCarousel">
                                    @string.Format(Loc["Admin_VideoSelector_AddToBottom"], _selectedVideoUrls.Count)
                                </button>
                            }
                        </div>
                    </div>

                    <!-- VISUAL MULTI-SELECT VIDEO CARDS GRID -->
                    @if (_blogVideoOptions == null || !_blogVideoOptions.Any())
                    {
                        <div class="text-muted p-4 text-center border rounded bg-card-alt">
                            No videos found. Upload videos using the "Upload Video" button.
                        </div>
                    }
                    else
                    {
                        <div class="row g-3" style="max-height: 460px; overflow-y: auto;">
                            @foreach (var video in _blogVideoOptions)
                            {
                                var isSelected = _selectedVideoUrls.Contains(video.Url);
                                <div class="col-md-6 col-lg-4">
                                    <div class="card h-100 p-2 d-flex flex-column justify-content-between shadow-sm position-relative" 
                                         style="background: var(--bg-card); border: 2px solid @(isSelected ? "var(--color-primary)" : "var(--border-color)"); cursor: pointer; border-radius: 12px;"
                                         @onclick="() => ToggleVideoSelection(video.Url)">
                                        
                                        <!-- Selection Indicator Checkbox Badge -->
                                        <div class="position-absolute top-0 start-0 m-3" style="z-index: 5;">
                                            <input type="checkbox" class="form-check-input" checked="@isSelected" @onclick:stopPropagation="true" @onchange="() => ToggleVideoSelection(video.Url)" style="width: 20px; height: 20px; cursor: pointer;" />
                                        </div>

                                        <div class="position-relative overflow-hidden rounded mb-2" style="background: #000; height: 150px;">
                                            <video src="@video.Url" poster="@video.PosterUrl" controls style="width: 100%; height: 100%; object-fit: cover; border-radius: 8px;" @onclick:stopPropagation="true"></video>
                                        </div>
                                        <div>
                                            <span class="badge bg-secondary mb-1">@video.Category</span>
                                            <div class="small fw-bold text-truncate" title="@video.Title">@video.Title</div>
                                            <div class="extra-small text-muted font-monospace text-truncate">@video.Url</div>
                                        </div>

                                        <div class="mt-2 d-flex gap-1">
                                            <button type="button" class="btn btn-xs @(isSelected ? "btn-primary" : "btn-outline-primary") w-100" @onclick:stopPropagation="true" @onclick="() => ToggleVideoSelection(video.Url)">
                                                @(isSelected ? "✓ Избрано" : "+ Избери")
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer border-top d-flex justify-content-between">
                    <span class="small text-muted">@string.Format(Loc["Admin_VideoSelector_SelectedCount"], _selectedVideoUrls.Count)</span>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-secondary" @onclick="CloseVideoSelectorModal">@Loc["Admin_Cancel"]</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- DELETE CONFIRMATION MODAL -->
<BsConfirmationModal IsVisible="_showDeleteConfirmModal"
                     Title="@Loc["Admin_DeleteConfirm_Title"]"
                     Message="@string.Format(Loc["Admin_DeleteConfirm_Message"], _slugToDelete)"
                     AcceptText="@Loc["Admin_DeletePost"]"
                     CancelText="@Loc["Admin_Cancel"]"
                     OnConfirmationChanged="OnDeleteConfirmationChanged" />

<style>
    .admin-page-title {
        font: var(--font-h1);
        font-size: 2rem;
        color: var(--text-primary);
    }

    .admin-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 24px;
        box-shadow: var(--shadow-main);
    }

    .admin-table {
        color: var(--text-primary);
    }

    .admin-table th {
        font: var(--font-h3);
        color: var(--text-muted);
        border-bottom-color: var(--border-color);
    }

    .admin-table td {
        border-bottom-color: var(--border-color);
    }

    /* -------------------------------------------------------------
       Blog Studio 2-Column Grid & Canvas
       ------------------------------------------------------------- */
    .blog-editor-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }

    @@media (min-width: 992px) {
        .blog-editor-grid {
            grid-template-columns: 7fr 3fr;
            align-items: start;
        }
    }

    .studio-top-bar {
        padding: 16px 24px;
    }

    .studio-lang-switch {
        display: inline-flex;
        background: var(--bg-card-alt);
        border: 1px solid var(--border-color);
        border-radius: 24px;
        padding: 2px;
    }

    .lang-pill-btn {
        background: transparent;
        border: none;
        border-radius: 20px;
        padding: 4px 16px;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-secondary);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .lang-pill-btn.active {
        background: var(--color-primary);
        color: #ffffff;
    }

    /* Distraction-Free Canvas Card */
    .canvas-card {
        padding: 24px;
    }

    .post-title-input {
        width: 100%;
        border: none;
        outline: none;
        background: transparent;
        color: var(--text-primary);
        font: var(--font-h1);
        font-size: 1.75rem;
        font-weight: 700;
        line-height: 1.3;
        padding: 0;
        margin-bottom: 12px;
    }

    .post-title-input::placeholder {
        color: var(--text-muted);
    }

    .post-excerpt-input {
        width: 100%;
        border: none;
        outline: none;
        background: transparent;
        color: var(--text-secondary);
        font: var(--font-body-1);
        resize: none;
        padding: 0;
        line-height: 1.5;
    }

    .post-excerpt-input::placeholder {
        color: var(--text-muted);
    }

    /* Carousel Slide Grid */
    .carousel-slide-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
        gap: 1rem;
        margin-top: 1rem;
    }

    .slide-card {
        background-color: var(--bg-card-alt);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 0.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .slide-preview-thumb {
        position: relative;
        height: 120px;
        border-radius: 8px;
        overflow: hidden;
        background-color: #000;
    }

    .slide-preview-thumb img,
    .slide-preview-thumb video {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .slide-actions-overlay {
        position: absolute;
        top: 6px;
        right: 6px;
        display: flex;
        gap: 4px;
    }

    .action-btn {
        background: rgba(0, 0, 0, 0.75);
        border: none;
        border-radius: 4px;
        color: #ffffff;
        width: 22px;
        height: 22px;
        font-size: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    .action-btn.danger {
        background: var(--color-danger, #ef4444);
    }

    .add-slide-dropzone {
        border: 2px dashed var(--border-color);
        border-radius: 10px;
        min-height: 120px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 6px;
        cursor: pointer;
        background-color: var(--bg-card-alt);
        color: var(--text-secondary);
        transition: all 0.2s ease;
        font-size: 0.85rem;
        font-weight: 500;
    }

    .add-slide-dropzone:hover {
        border-color: var(--color-primary);
        color: var(--color-primary);
    }

    /* Visual Editor Toolbar */
    .editor-toolbar-header {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--border-color);
        margin-bottom: 1rem;
    }

    .toolbar-group {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        flex-wrap: wrap;
    }

    .toolbar-btn {
        background: transparent;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        color: var(--text-secondary);
        padding: 4px 8px;
        font-size: 0.85rem;
        cursor: pointer;
    }

    .toolbar-btn:hover {
        background: var(--bg-card-alt);
        color: var(--text-primary);
    }

    .toolbar-divider {
        width: 1px;
        height: 18px;
        background: var(--border-color);
        margin: 0 4px;
    }

    .toolbar-pill-btn {
        background: var(--bg-card-alt);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        color: var(--text-primary);
        padding: 3px 10px;
        font-size: 0.8rem;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        cursor: pointer;
    }

    .toolbar-pill-btn.info {
        border-color: var(--color-info, #0284c7);
        color: var(--color-info, #0284c7);
    }

    .toolbar-pill-btn.warning {
        border-color: var(--color-warning, #f59e0b);
        color: var(--color-warning, #f59e0b);
    }

    .toolbar-pill-btn.cta {
        border-color: var(--color-primary);
        color: var(--color-primary);
    }

    .view-mode-toggle {
        display: inline-flex;
        background: var(--bg-card-alt);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 2px;
    }

    .mode-btn {
        background: transparent;
        border: none;
        border-radius: 6px;
        padding: 3px 10px;
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--text-secondary);
        cursor: pointer;
    }

    .mode-btn.active {
        background: var(--color-primary);
        color: #ffffff;
    }

    /* Content Area */
    .editor-pane-container.mode-split {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
    }

    .content-raw-textarea {
        width: 100%;
        min-height: 480px;
        background-color: var(--bg-card-alt);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 1rem;
        color: var(--text-primary);
        font-family: inherit;
        font-size: 0.95rem;
        line-height: 1.6;
        outline: none;
    }

    .editor-preview-pane {
        min-height: 480px;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 1.25rem;
        background-color: var(--bg-card);
        overflow-y: auto;
    }

    /* Sidebar Styling */
    .editor-sidebar-column {
        display: flex;
        flex-direction: column;
        position: sticky;
        top: 24px;
    }

    .cover-dropzone {
        border: 2px dashed var(--border-color);
        border-radius: 8px;
        padding: 1.75rem 1rem;
        text-align: center;
        background: var(--bg-card-alt);
        color: var(--text-secondary);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
    }

    .serp-preview-box {
        background: var(--bg-card-alt);
        border: 1px solid var(--border-color);
    }
</style>

@if (_showImageGalleryModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.65); backdrop-filter: blur(4px); z-index: 1060;">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content" style="background: var(--bg-card); color: var(--text-primary); border-radius: 20px; border: 1px solid var(--border-color);">
                <div class="modal-header border-bottom border-color">
                    <div class="d-flex align-items-center gap-2">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                        <h5 class="modal-title fw-bold m-0">Управление на Снимките (Галерия)</h5>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseImageGalleryModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                        <p class="text-secondary m-0">Всички качени снимки в <code>/images/blog/</code>. Можете да ги преглеждате, избирате или изтривате физически от сървъра.</p>
                        <label class="btn btn-primary px-3 py-2 mb-0">
