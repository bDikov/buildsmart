@page "/admin/blog"
@using Microsoft.AspNetCore.Authorization
@using Markdig
@attribute [Authorize(Roles = "Admin, ADMIN, admin")]
@using System.Text.Json
@using System.IO
@using Microsoft.AspNetCore.Hosting
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Localization
@using SkiaSharp
@using BuildSmart.Infrastructure.Persistence
@using BuildSmart.Core.Domain.Entities
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject IWebHostEnvironment WebHostEnvironment
@inject IStringLocalizer<BuildSmart.SharedUI.Resources.AppResources> Loc
@inject NavigationManager NavManager
@inject BuildSmart.SharedUI.GraphQL.BuildSmartApiClient ApiClient
@inject BuildSmart.Core.Application.Interfaces.IMediaService MediaService
@inject IConfiguration Configuration

<PageTitle>@Loc["Admin_BlogManager"] - BuildSmart</PageTitle>

<div class="admin-blog-container container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="admin-page-title m-0">@Loc["Admin_BlogManager"]</h1>
        </div>
        @if (!_isEditing)
        {
            <div>
                <button class="btn btn-outline-secondary me-2" @onclick="OpenImageGalleryModal">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                    Управление на Снимки
                </button>
                <button class="btn btn-primary" @onclick="CreateNewPost">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="me-1"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    @Loc["Admin_CreatePost"]
                </button>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            @_statusMessage
            <button type="button" class="btn-close" @onclick='() => _statusMessage = null'></button>
        </div>
    }

    @if (!_isEditing)
    {
        <!-- POSTS LIST TABLE -->
        <div class="admin-card">
            @if (_posts == null)
            {
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else if (!_posts.Any())
            {
                <div class="text-center py-4">
                    <p class="text-secondary m-0">No posts available. Create your first post!</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table admin-table align-middle m-0">
                        <thead>
                            <tr>
                                <th>@Loc["Admin_Title"]</th>
                                <th>@Loc["Admin_Category"]</th>
                                <th>@Loc["Admin_Date"]</th>
                                <th>@Loc["Admin_ReadTime"]</th>
                                <th class="text-end">@Loc["Admin_Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var post in _posts)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-primary-custom">@GetDisplayTitle(post)</div>
                                        <div class="small text-muted">/blog/@post.Slug</div>
                                    </td>
                                    <td><span class="badge bg-card-alt text-primary-custom">@GetDisplayCategory(post)</span></td>
                                    <td>@post.Date</td>
                                    <td>@GetDisplayReadTime(post)</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-secondary me-2" @onclick="() => EditPost(post)">
                                            @Loc["Admin_EditPost"]
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePostAsync(post.Slug)">
                                            @Loc["Admin_DeletePost"]
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
    else
    {
        <!-- EDITOR FORM -->
        <div class="admin-card">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <h2 class="h5 fw-bold m-0">@(_isNew ? Loc["Admin_CreatePost"] : Loc["Admin_EditPost"])</h2>
                <button class="btn btn-sm btn-secondary" @onclick="CancelEditing">
                    @Loc["Admin_Cancel"]
                </button>
            </div>

            <!-- MULTILINGUAL LANGUAGE SELECTION TABS -->
            <div class="mb-4">
                <div class="btn-group w-100" role="group">
                    <button type="button" class="btn @(_formLang == "bg" ? "btn-primary" : "btn-outline-secondary") py-2" @onclick='() => _formLang = "bg"'>
                        Български (BG)
                    </button>
                    <button type="button" class="btn @(_formLang == "en" ? "btn-primary" : "btn-outline-secondary") py-2" @onclick='() => _formLang = "en"'>
                        English (EN)
                    </button>
                </div>
            </div>

            <EditForm Model="_activePost" OnValidSubmit="SavePostAsync">
                <div class="row g-3">
                    <!-- SHARED FIELDS -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold">@Loc["Admin_Slug"] *</label>
                        <input type="text" class="form-control" @bind="_activePost.Slug" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">@Loc["Admin_Date"]</label>
                        <input type="text" class="form-control" @bind="_activePost.Date" placeholder="yyyy-MM-dd" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">@Loc["Admin_CoverImage"]</label>
                        <div class="input-group">
                            <input type="text" class="form-control" @bind="_activePost.Image" placeholder="/images/blog/cover.jpg" />
                            <button class="btn btn-outline-secondary" type="button" @onclick="OpenImageGalleryModal" title="Галерия и Управление на Снимки">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                            </button>
                            <label class="btn btn-secondary mb-0">
                                Upload
                                <InputFile OnChange="UploadCoverImageAsync" accept="image/*" class="d-none" />
                            </label>
                        </div>
                    </div>

                    @if (_formLang == "bg")
                    {
                        <!-- BULGARIAN FORM FIELDS -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold">@Loc["Admin_Title"] (BG) *</label>
                            <input type="text" class="form-control" @bind="_activePost.TitleBg" @bind:after="OnTitleChanged" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">@Loc["Admin_Category"] (BG)</label>
                            <input type="text" class="form-control" @bind="_activePost.CategoryBg" placeholder="e.g. Цени и Бюджет" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">@Loc["Admin_ReadTime"] (BG)</label>
                            <input type="text" class="form-control" @bind="_activePost.ReadTimeBg" placeholder="e.g. 5 мин." />
                        </div>

                        <div class="col-12">
                            <div class="p-3 border rounded bg-card-alt">
                                <h3 class="h6 fw-bold mb-2">SEO Settings (BG)</h3>
                                <label class="form-label font-body-1">@Loc["Admin_SeoKeywords"] (BG)</label>
                                <input type="text" class="form-control" @bind="_activePost.SeoKeywordsBg" placeholder="ремонт на апартамент, цени София" />
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold">@Loc["Admin_Description"] (BG) *</label>
                            <textarea class="form-control" rows="2" @bind="_activePost.DescriptionBg" required></textarea>
                        </div>

                        <!-- BG CONTENT TOOLBAR & EDITOR -->
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-bold mb-0">@Loc["Admin_Content"] (BG) *</label>
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn @(_activeTab == "write" ? "btn-primary" : "btn-secondary")" @onclick='() => _activeTab = "write"'>Write</button>
                                    <button type="button" class="btn @(_activeTab == "preview" ? "btn-primary" : "btn-secondary")" @onclick='() => _activeTab = "preview"'>@Loc["Admin_Preview"]</button>
                                </div>
                            </div>

                            @if (_activeTab == "write")
                            {
                                <div class="editor-toolbar p-2 border border-bottom-0 rounded-top bg-card-alt d-flex flex-wrap gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='() => InsertSnippet("## ", "bg")'>H2</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='() => InsertSnippet("### ", "bg")'>H3</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='() => InsertSnippet("**bold**", "bg")'>Bold</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='() => InsertSnippet("\n<div class=\"blog-callout blog-callout-info\">\nInfo box content\n</div>\n", "bg")'>Info Box</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='() => InsertSnippet("\n<div class=\"blog-callout blog-callout-warning\">\nWarning content\n</div>\n", "bg")'>Warning Box</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='() => InsertSnippet("<span class=\"text-accent\">Accent text</span>", "bg")'>Accent</button>
                                    
                                    <label class="btn btn-sm btn-outline-primary mb-0">
                                        @Loc["Admin_InsertImage"]
                                        <InputFile OnChange='e => UploadInlineImageAsync(e, "bg")' accept="image/*" class="d-none" />
                                    </label>
                                    <label class="btn btn-sm btn-outline-success mb-0 ms-auto">
                                        Upload Video
                                        <InputFile OnChange='e => UploadInlineVideoAsync(e, "bg")' accept="video/mp4,video/*" class="d-none" />
                                    </label>
                                    <button type="button" class="btn btn-sm btn-outline-info mb-0 ms-1" @onclick='() => OpenVideoSelectorModal("bg")'>Select Existing Video</button>
                                </div>

                                <textarea class="form-control rounded-top-0 font-monospace" rows="16" @bind="_activePost.ContentBg" required placeholder="Write Bulgarian article content in Markdown format..."></textarea>
                            }
                            else
                            {
                                <div class="preview-box p-4 border rounded bg-card min-vh-50">
                                    @((MarkupString)RenderMarkdown(_activePost.ContentBg))
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <!-- ENGLISH FORM FIELDS -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold">@Loc["Admin_Title"] (EN)</label>
                            <input type="text" class="form-control" @bind="_activePost.TitleEn" placeholder="English Title" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">@Loc["Admin_Category"] (EN)</label>
                            <input type="text" class="form-control" @bind="_activePost.CategoryEn" placeholder="e.g. Prices & Budget" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">@Loc["Admin_ReadTime"] (EN)</label>
                            <input type="text" class="form-control" @bind="_activePost.ReadTimeEn" placeholder="e.g. 5 min." />
                        </div>

                        <div class="col-12">
                            <div class="p-3 border rounded bg-card-alt">
                                <h3 class="h6 fw-bold mb-2">SEO Settings (EN)</h3>
                                <label class="form-label font-body-1">@Loc["Admin_SeoKeywords"] (EN)</label>
                                <input type="text" class="form-control" @bind="_activePost.SeoKeywordsEn" placeholder="apartment renovation, Sofia prices" />
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold">@Loc["Admin_Description"] (EN)</label>
                            <textarea class="form-control" rows="2" @bind="_activePost.DescriptionEn" placeholder="English short summary..."></textarea>
                        </div>

                        <!-- EN CONTENT TOOLBAR & EDITOR -->
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-bold mb-0">@Loc["Admin_Content"] (EN)</label>
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn @(_activeTab == "write" ? "btn-primary" : "btn-secondary")" @onclick='() => _activeTab = "write"'>Write</button>
                                    <button type="button" class="btn @(_activeTab == "preview" ? "btn-primary" : "btn-secondary")" @onclick='() => _activeTab = "preview"'>@Loc["Admin_Preview"]</button>
                                </div>
                            </div>

                            @if (_activeTab == "write")
                            {
                                <div class="editor-toolbar p-2 border border-bottom-0 rounded-top bg-card-alt d-flex flex-wrap gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='() => InsertSnippet("## ", "en")'>H2</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='() => InsertSnippet("### ", "en")'>H3</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='() => InsertSnippet("**bold**", "en")'>Bold</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='() => InsertSnippet("\n<div class=\"blog-callout blog-callout-info\">\nInfo box content\n</div>\n", "en")'>Info Box</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='() => InsertSnippet("\n<div class=\"blog-callout blog-callout-warning\">\nWarning content\n</div>\n", "en")'>Warning Box</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='() => InsertSnippet("<span class=\"text-accent\">Accent text</span>", "en")'>Accent</button>
                                    
                                    <label class="btn btn-sm btn-outline-primary mb-0">
                                        @Loc["Admin_InsertImage"]
                                        <InputFile OnChange='e => UploadInlineImageAsync(e, "en")' accept="image/*" class="d-none" />
                                    </label>
                                    <label class="btn btn-sm btn-outline-success mb-0 ms-auto">
                                        Upload Video
                                        <InputFile OnChange='e => UploadInlineVideoAsync(e, "en")' accept="video/mp4,video/*" class="d-none" />
                                    </label>
                                    <button type="button" class="btn btn-sm btn-outline-info mb-0 ms-1" @onclick='() => OpenVideoSelectorModal("en")'>Select Existing Video</button>
                                </div>

                                <textarea class="form-control rounded-top-0 font-monospace" rows="16" @bind="_activePost.ContentEn" placeholder="Write English article content in Markdown format..."></textarea>
                            }
                            else
                            {
                                <div class="preview-box p-4 border rounded bg-card min-vh-50">
                                    @((MarkupString)RenderMarkdown(_activePost.ContentEn))
                                </div>
                            }
                        </div>
                    }

                    <div class="col-12 d-flex justify-content-end gap-2 mt-4">
                        <button type="button" class="btn btn-secondary" @onclick="CancelEditing">@Loc["Admin_Cancel"]</button>
                        <button type="submit" class="btn btn-primary px-4">@Loc["Admin_Save"]</button>
                    </div>
                </div>
            </EditForm>
        </div>
    }
</div>

@if (_showVideoSelectorModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.65); z-index: 1060;">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content bg-card border shadow-lg">
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold">Select Existing Video for Article</h5>
                    <button type="button" class="btn-close" @onclick="CloseVideoSelectorModal"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- 1. DROPDOWN SELECTOR -->
                    <div class="mb-4 p-3 border rounded bg-card-alt">
                        <label class="form-label fw-bold text-primary">1. Choose Video from Dropdown List:</label>
                        <select class="form-select form-select-lg" @onchange="OnDropdownVideoSelected">
                            <option value="">-- Click here to select a video --</option>
                            @foreach (var v in _blogVideoOptions)
                            {
                                <option value="@v.Url" selected="@(v.Url == _customVideoUrlInput)">@v.Title - [@v.Category]</option>
                            }
                        </select>
                    </div>

                    <!-- 2. SELECTED VIDEO PREVIEW & INSERT ACTION -->
                    @if (!string.IsNullOrEmpty(_customVideoUrlInput))
                    {
                        <div class="mb-4 p-3 border border-primary rounded bg-card text-center shadow-sm">
                            <span class="d-block small text-muted mb-2 fw-bold">Selected Video Preview:</span>
                            <video src="@_customVideoUrlInput" controls style="max-height: 220px; width: 100%; border-radius: 8px; background: #000;"></video>
                            <div class="mt-2 text-truncate small font-monospace">@_customVideoUrlInput</div>
                            <button type="button" class="btn btn-success btn-lg px-4 mt-3 shadow" @onclick="InsertCustomVideoUrl">
                                Insert Selected Video into Article
                            </button>
                        </div>
                    }

                    <hr />

                    <!-- 3. VISUAL GALLERY CARDS -->
                    <h6 class="fw-bold mb-3">2. Or Click any Video Card below to Insert:</h6>
                    @if (_blogVideoOptions == null || !_blogVideoOptions.Any())
                    {
                        <div class="text-muted p-3 text-center border rounded bg-card-alt">
                            No videos found. Upload a video using the "Upload Video" button above.
                        </div>
                    }
                    else
                    {
                        <div class="row g-3" style="max-height: 360px; overflow-y: auto;">
                            @foreach (var video in _blogVideoOptions)
                            {
                                <div class="col-md-6">
                                    <div class="card bg-card-alt border h-100 p-2 d-flex flex-column justify-content-between shadow-sm">
                                        <video src="@video.Url" poster="@video.PosterUrl" controls style="max-height: 140px; width: 100%; border-radius: 8px; background: #000;"></video>
                                        <div class="mt-2">
                                            <span class="badge bg-secondary mb-1">@video.Category</span>
                                            <div class="small fw-bold text-truncate" title="@video.Title">@video.Title</div>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-success mt-2 w-100" @onclick='() => SelectVideoForArticle(video.Url)'>
                                            Insert into Article
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-secondary" @onclick="CloseVideoSelectorModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .admin-page-title {
        font: var(--font-h1);
        font-size: 2rem;
        color: var(--text-primary);
    }

    .admin-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 24px;
        box-shadow: var(--shadow-main);
    }

    .admin-table {
        color: var(--text-primary);
    }

    .admin-table th {
        font: var(--font-h3);
        color: var(--text-muted);
        border-bottom-color: var(--border-color);
    }

    .admin-table td {
        border-bottom-color: var(--border-color);
    }

    .bg-card-alt {
        background-color: var(--bg-card-alt) !important;
    }

    .text-primary-custom {
        color: var(--text-primary) !important;
    }

    .editor-toolbar {
        border-color: var(--border-color) !important;
    }

    .preview-box {
        border-color: var(--border-color) !important;
        min-height: 350px;
    }
</style>

    @if (_showImageGalleryModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.65); backdrop-filter: blur(4px); z-index: 1060;">
            <div class="modal-dialog modal-xl modal-dialog-scrollable">
                <div class="modal-content" style="background: var(--bg-card); color: var(--text-primary); border-radius: 20px; border: 1px solid var(--border-color);">
                    <div class="modal-header border-bottom border-color">
                        <div class="d-flex align-items-center gap-2">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                            <h5 class="modal-title fw-bold m-0">Управление на Снимките (Галерия)</h5>
                        </div>
                        <button type="button" class="btn-close" @onclick="CloseImageGalleryModal"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                            <p class="text-secondary m-0">Всички качени снимки в <code>/images/blog/</code>. Можете да ги преглеждате, избирате или изтривате физически от сървъра.</p>
                            <label class="btn btn-primary px-3 py-2 mb-0">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                                Качи Нова Снимка
                                <InputFile OnChange="UploadGalleryImageAsync" accept="image/*" class="d-none" />
                            </label>
                        </div>

                        @if (!_blogImageOptions.Any())
                        {
                            <div class="text-center py-5">
                                <p class="text-muted m-0">Няма намерени снимки в папката.</p>
                            </div>
                        }
                        else
                        {
                            <div class="row g-3">
                                @foreach (var img in _blogImageOptions)
                                {
                                    <div class="col-6 col-md-4 col-lg-3">
                                        <div class="card h-100 p-2" style="background: var(--bg-card-alt); border: 1px solid var(--border-color); border-radius: 14px;">
                                            <div class="position-relative overflow-hidden mb-2" style="height: 140px; border-radius: 10px; background: #000;">
                                                <img src="@img.Url" alt="@img.FileName" style="width: 100%; height: 100%; object-fit: cover;" />
                                            </div>
                                            <div class="px-1 mb-2">
                                                <div class="fw-bold text-truncate small" title="@img.FileName">@img.FileName</div>
                                                <div class="text-muted small">@img.FileSizeFormatted</div>
                                            </div>
                                            <div class="d-flex gap-1 mt-auto">
                                                @if (_isEditing)
                                                {
                                                    <button class="btn btn-sm btn-primary flex-grow-1 py-1" style="font-size: 0.8rem;" @onclick="() => SelectImageForCover(img.Url)">
                                                        Избери
                                                    </button>
                                                }
                                                <button class="btn btn-sm btn-outline-danger py-1" style="font-size: 0.8rem;" @onclick="() => DeleteImageFileAsync(img)" title="Изтрий файла от сървъра">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="modal-footer border-top border-color py-2">
                        <button type="button" class="btn btn-secondary" @onclick="CloseImageGalleryModal">Затвори</button>
                    </div>
                </div>
