    // Save and Delete
    private async Task SavePostAsync()
    {
        if (string.IsNullOrWhiteSpace(_activePost.Slug))
            return;

        _activePost.CarouselItems = _heroCarouselItems;
        _activePost.BottomVideoItems = _bottomVideoItems;

        // Serialize top hero carousel JSON if slides exist
        string topCarouselComment = "";
        if (_heroCarouselItems != null && _heroCarouselItems.Count > 0)
        {
            var jsonOptions = new JsonSerializerOptions { WriteIndented = false };
            var jsonStr = JsonSerializer.Serialize(_heroCarouselItems, jsonOptions);
            topCarouselComment = $"<!-- CAROUSEL_JSON: {jsonStr} -->\n\n";
        }

        // Serialize bottom video carousel JSON only if explicitly configured in bottom builder and not inline
        string bottomVideoComment = "";
        if (_bottomVideoItems != null && _bottomVideoItems.Count > 0)
        {
            var jsonOptions = new JsonSerializerOptions { WriteIndented = false };
            var vJsonStr = JsonSerializer.Serialize(_bottomVideoItems, jsonOptions);
            bottomVideoComment = $"\n\n<!-- BOTTOM_VIDEOS_JSON: {vJsonStr} -->";
        }

        var cleanContentBg = CarouselRegex.Replace(_activePost.ContentBg ?? "", "").Trim();
        var cleanContentEn = CarouselRegex.Replace(_activePost.ContentEn ?? "", "").Trim();

        var finalContentBg = (string.IsNullOrEmpty(topCarouselComment) ? cleanContentBg : topCarouselComment + cleanContentBg) + bottomVideoComment;
        var finalContentEn = (string.IsNullOrEmpty(topCarouselComment) ? cleanContentEn : topCarouselComment + cleanContentEn) + bottomVideoComment;

        try
        {
            await using var db = await DbContextFactory.CreateDbContextAsync();
            var targetSlug = _activePost.Slug.Trim().ToLower();

            // Slug Collision Guard for new articles
            if (_isNew)
            {
                var existingSlug = await db.BlogPosts.AnyAsync(b => b.Slug.ToLower() == targetSlug);
                if (existingSlug)
                {
                    _statusMessage = string.Format(Loc["Admin_SlugConflict_Warning"], _activePost.Slug);
                    _isStatusError = true;
                    return;
                }
            }

            var existing = await db.BlogPosts.FirstOrDefaultAsync(b => b.Slug.ToLower() == targetSlug);
            if (existing == null)
            {
                existing = new BlogPost
                {
                    Id = Guid.NewGuid(),
                    Slug = _activePost.Slug.Trim()
                };
                await db.BlogPosts.AddAsync(existing);
            }

            existing.TitleBg = _activePost.TitleBg;
            existing.TitleEn = _activePost.TitleEn;
            existing.DescriptionBg = _activePost.DescriptionBg;
            existing.DescriptionEn = _activePost.DescriptionEn;
            existing.ContentBg = finalContentBg;
            existing.ContentEn = finalContentEn;
            existing.CoverImageUrl = _activePost.Image ?? "";
            existing.CategoryBg = _activePost.CategoryBg;
            existing.CategoryEn = _activePost.CategoryEn;
            existing.ReadTimeBg = _activePost.ReadTimeBg;
            existing.ReadTimeEn = _activePost.ReadTimeEn;
            existing.SeoKeywordsBg = _activePost.SeoKeywordsBg;
            existing.SeoKeywordsEn = _activePost.SeoKeywordsEn;
            existing.IsPublished = _activePost.IsPublished;
            existing.UpdatedAt = DateTime.UtcNow;

            if (DateTime.TryParse(_activePost.Date, out var dt))
            {
                existing.PublishedAt = DateTime.SpecifyKind(dt, DateTimeKind.Utc);
            }

            await db.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving post to DB: {ex.Message}");
        }

        // Also save to local posts.json / md files for backwards compatibility
        try
        {
            var postsFilePath = Path.Combine(WebHostEnvironment.WebRootPath, "posts", "posts.json");
            Directory.CreateDirectory(Path.Combine(WebHostEnvironment.WebRootPath, "posts"));

            var existingIndex = _posts!.FindIndex(p => p.Slug.Equals(_activePost.Slug, StringComparison.OrdinalIgnoreCase));
            if (existingIndex >= 0) _posts[existingIndex] = _activePost;
            else _posts.Add(_activePost);

            var options = new JsonSerializerOptions { WriteIndented = true };
            var jsonContent = JsonSerializer.Serialize(_posts, options);
            await File.WriteAllTextAsync(postsFilePath, jsonContent);

            if (!string.IsNullOrWhiteSpace(finalContentBg))
            {
                await File.WriteAllTextAsync(Path.Combine(WebHostEnvironment.WebRootPath, "posts", $"{_activePost.Slug}.bg.md"), finalContentBg);
            }
            if (!string.IsNullOrWhiteSpace(finalContentEn))
            {
                await File.WriteAllTextAsync(Path.Combine(WebHostEnvironment.WebRootPath, "posts", $"{_activePost.Slug}.en.md"), finalContentEn);
            }
        }
        catch { }

        _statusMessage = "Статията беше запазена успешно!";
        _isStatusError = false;
        _isEditing = false;
        await LoadPostsAsync();
    }

    private void PromptDeletePost(string slug)
    {
        _slugToDelete = slug;
        _showDeleteConfirmModal = true;
    }

    private async Task OnDeleteConfirmationChanged(bool proceed)
    {
        _showDeleteConfirmModal = false;
        if (proceed && !string.IsNullOrEmpty(_slugToDelete))
        {
            await DeletePostAsync(_slugToDelete);
            _slugToDelete = string.Empty;
        }
    }

    private async Task DeletePostAsync(string slug)
    {
        try
        {
            await using var db = await DbContextFactory.CreateDbContextAsync();
            var targetSlug = (slug ?? "").Trim().ToLower();
            var existing = await db.BlogPosts.FirstOrDefaultAsync(b => b.Slug.ToLower() == targetSlug);
            if (existing != null)
            {
                db.BlogPosts.Remove(existing);
                await db.SaveChangesAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting post from DB: {ex.Message}");
        }

        var post = _posts?.FirstOrDefault(p => p.Slug.Equals(slug, StringComparison.OrdinalIgnoreCase));
        if (post != null)
        {
            _posts!.Remove(post);
            
            try
            {
                var postsFilePath = Path.Combine(WebHostEnvironment.WebRootPath, "posts", "posts.json");
                var options = new JsonSerializerOptions { WriteIndented = true };
                var jsonContent = JsonSerializer.Serialize(_posts, options);
                await File.WriteAllTextAsync(postsFilePath, jsonContent);

                var bgPath = Path.Combine(WebHostEnvironment.WebRootPath, "posts", $"{slug}.bg.md");
                var enPath = Path.Combine(WebHostEnvironment.WebRootPath, "posts", $"{slug}.en.md");
                var defPath = Path.Combine(WebHostEnvironment.WebRootPath, "posts", $"{slug}.md");

                if (File.Exists(bgPath)) File.Delete(bgPath);
                if (File.Exists(enPath)) File.Delete(enPath);
                if (File.Exists(defPath)) File.Delete(defPath);
            }
            catch { }

            _statusMessage = "Статията беше изтрита успешно!";
            _isStatusError = false;
            await LoadPostsAsync();
        }
    }

    private string RenderMarkdown(string? md)
    {
        if (string.IsNullOrEmpty(md)) return "";
        var clean = CarouselRegex.Replace(md, "");
        clean = VideoCarouselRegex.Replace(clean, match =>
        {
            return "\n<div class=\"p-3 my-3 rounded-3 text-center\" style=\"background: rgba(16, 185, 129, 0.1); border: 1px dashed var(--color-primary); color: var(--color-primary); font-weight: 600;\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" class=\"me-1\"><polygon points=\"23 7 16 12 23 17 23 7\"></polygon><rect x=\"1\" y=\"5\" width=\"15\" height=\"14\" rx=\"2\" ry=\"2\"></rect></svg> Интерактивен Видео Слайдер (Hero Carousel)</div>\n";
        }).Trim();
        var pipeline = new Markdig.MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .Build();
        return Markdig.Markdown.ToHtml(clean, pipeline);
    }

