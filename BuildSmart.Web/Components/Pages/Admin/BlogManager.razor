    private void SelectVideoOptionForArticle(BlogVideoOption option)
    {
        if (option == null || string.IsNullOrWhiteSpace(option.Url)) return;

        string posterAttr = !string.IsNullOrEmpty(option.PosterUrl) ? $" poster=\"{option.PosterUrl}\"" : "";
        string sourcesTag = "";

        if (!string.IsNullOrEmpty(option.MobileUrl))
        {
            sourcesTag = $"  <source src=\"{option.MobileUrl}\" media=\"(max-width: 768px)\" type=\"video/mp4\" />\n  <source src=\"{option.Url}\" type=\"video/mp4\" />";
        }
        else
        {
            sourcesTag = $"  <source src=\"{option.Url}\" type=\"video/mp4\" />";
        }

        var newVideoTag = $"<div class=\"blog-video-container\">\n<video controls playsinline preload=\"metadata\" class=\"blog-video-player\"{posterAttr}>\n{sourcesTag}\n</video>\n</div>";

        string content = _videoSelectorTargetLang == "bg" ? (_activePost.ContentBg ?? "") : (_activePost.ContentEn ?? "");

        var regexContainer = new System.Text.RegularExpressions.Regex(@"<div\s+class=[""']blog-video-container[""'][\s\S]*?</div>", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        var regexVideo = new System.Text.RegularExpressions.Regex(@"<video[\s\S]*?</video>", System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        if (regexContainer.IsMatch(content))
        {
            content = regexContainer.Replace(content, newVideoTag, 1);
        }
        else if (regexVideo.IsMatch(content))
        {
            content = regexVideo.Replace(content, newVideoTag, 1);
        }
        else
        {
            content = string.IsNullOrWhiteSpace(content) ? newVideoTag : $"{content}\n\n{newVideoTag}\n";
        }

        if (_videoSelectorTargetLang == "bg")
        {
            _activePost.ContentBg = content;
        }
        else
        {
            _activePost.ContentEn = content;
        }

        _showVideoSelectorModal = false;
        StateHasChanged();
    }

