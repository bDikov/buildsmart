        {
          "id": "demo_floor_sqm",
          "text": "Колко кв.м. приблизително са старите подови настилки за премахване?",
          "type": "number",
          "required": true,
          "dependsOn": "demo_what",
          "dependsOnValue": "Стари подови настилки (замазка/мозайка)"
