@namespace BuildSmart.SharedUI.Components
@using BuildSmart.Core.Application.DTOs

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h4 class="modal-title">Create New Task (Admin)</h4>
                <button class="close-btn" @onclick="Close" aria-label="Close">&times;</button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="alert-danger-box">@ErrorMessage</div>
                }

                <div class="form-group">
                    <label class="form-label">Category / Work Package</label>
                    <select class="form-control" @bind="SelectedJobPostId">
                        @foreach (var cat in CategorySections)
                        {
                            <option value="@cat.JobPostId">@cat.CategoryName</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Task Title <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" placeholder="e.g. Install Main Circuit Breaker" @bind="Title" />
                </div>

                <div class="form-group">
                    <label class="form-label">Description</label>
                    <textarea class="form-control" rows="3" placeholder="Task details and scope of work..." @bind="Description"></textarea>
                </div>

                <div class="form-group">
                    <label class="form-label">Estimated Price (€)</label>
                    <input type="number" step="0.01" class="form-control" placeholder="0.00" @bind="EstimatedPrice" />
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn-cancel" @onclick="Close">Cancel</button>
                <button class="btn-submit" disabled="@IsSubmitting" @onclick="Submit">
                    @(IsSubmitting ? "Creating..." : "Create Task")
                </button>
            </div>
        </div>
    </div>
}

<style>
    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10000;
        padding: 1rem;
        animation: modalFadeIn 0.15s ease-out;
    }

    .modal-card {
        background-color: var(--bg-card);
        color: var(--text-primary);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        width: 100%;
        max-width: 480px;
        display: flex;
        flex-direction: column;
        box-shadow: var(--shadow-lg, 0 10px 30px rgba(0,0,0,0.3));
        overflow: hidden;
    }

    .modal-header {
        padding: 1.25rem 1.5rem 0.75rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--border-color);
    }

    .modal-title {
        font: var(--font-h5, 600 1.1rem/1.3 'Inter', sans-serif);
        margin: 0;
        color: var(--text-primary);
    }

    .close-btn {
        background: transparent;
        border: none;
        color: var(--text-muted);
        font-size: 1.5rem;
        cursor: pointer;
        line-height: 1;
        transition: color 0.15s;
    }
    .close-btn:hover {
        color: var(--text-primary);
    }

    .modal-body {
        padding: 1.25rem 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .alert-danger-box {
        background-color: rgba(239, 68, 68, 0.15);
        color: #ef4444;
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 6px;
        padding: 0.6rem 0.8rem;
        font-size: 0.85rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .form-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-primary);
    }

    .form-control {
        background-color: var(--bg-card-alt) !important;
        color: var(--text-primary) !important;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 0.65rem 0.85rem;
        font-size: 0.9rem;
        outline: none !important;
        transition: border-color 0.15s, box-shadow 0.15s;
    }
    .form-control:focus,
    .form-control:active {
        background-color: var(--bg-card-alt) !important;
        color: var(--text-primary) !important;
        border-color: var(--color-primary) !important;
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.25) !important;
        outline: none !important;
    }
    .form-control::placeholder,
    .form-control::-webkit-input-placeholder,
    .form-control::-moz-placeholder {
        color: rgba(255, 255, 255, 0.65) !important;
        opacity: 1 !important;
    }
    select.form-control option {
        background-color: var(--bg-card) !important;
        color: var(--text-primary) !important;
    }

    .text-danger { color: #ef4444; }

    .modal-footer {
        padding: 1rem 1.5rem;
        border-top: 1px solid var(--border-color);
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
        background-color: var(--bg-card-alt);
    }

    .btn-cancel {
        background: transparent;
        border: 1px solid var(--border-color);
        color: var(--text-primary);
        padding: 0.5rem 1.1rem;
        border-radius: 6px;
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        transition: background-color 0.15s;
    }
    .btn-cancel:hover {
        background-color: var(--bg-card);
    }

    .btn-submit {
        background-color: var(--color-primary);
        color: #ffffff;
        padding: 0.5rem 1.25rem;
        border-radius: 6px;
        font-size: 0.9rem;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: opacity 0.15s;
    }
    .btn-submit:hover {
        opacity: 0.9;
    }
    .btn-submit:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    @@keyframes modalFadeIn {
        from { opacity: 0; transform: scale(0.97); }
        to { opacity: 1; transform: scale(1); }
    }
</style>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public List<CategoryKanbanSectionDto> CategorySections { get; set; } = new();
    [Parameter] public EventCallback<CreateTaskRequest> OnSubmit { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    public class CreateTaskRequest
    {
        public Guid JobPostId { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public decimal EstimatedPrice { get; set; }
    }

    private Guid SelectedJobPostId { get; set; }
    private string Title { get; set; } = string.Empty;
    private string Description { get; set; } = string.Empty;
    private decimal EstimatedPrice { get; set; }
    private string ErrorMessage { get; set; } = string.Empty;
    private bool IsSubmitting { get; set; }

    protected override void OnParametersSet()
    {
        if (IsOpen && SelectedJobPostId == Guid.Empty && CategorySections.Any())
        {
            SelectedJobPostId = CategorySections.First().JobPostId;
        }
    }

    private async Task Submit()
    {
        ErrorMessage = string.Empty;
        if (string.IsNullOrWhiteSpace(Title))
        {
            ErrorMessage = "Task Title is required.";
            return;
        }

        if (SelectedJobPostId == Guid.Empty)
        {
            ErrorMessage = "Please select a valid category.";
            return;
        }

        IsSubmitting = true;
        try
        {
            await OnSubmit.InvokeAsync(new CreateTaskRequest
            {
                JobPostId = SelectedJobPostId,
                Title = Title.Trim(),
                Description = Description.Trim(),
                EstimatedPrice = EstimatedPrice
            });

            Title = string.Empty;
            Description = string.Empty;
            EstimatedPrice = 0;
            await Close();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task Close()
    {
        ErrorMessage = string.Empty;
        await OnClosed.InvokeAsync();
    }
}
