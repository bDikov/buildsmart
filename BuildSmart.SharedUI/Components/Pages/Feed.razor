@page "/"
@page "/feed"
@using BuildSmart.SharedUI.ViewModels
@using System.ComponentModel
@using Microsoft.Extensions.Localization
@layout BuildSmart.SharedUI.Components.Layout.MainLayout
@implements IAsyncDisposable
@inject FeedPageViewModel ViewModel
@inject NavigationManager NavManager
@inject IStringLocalizer<BuildSmart.SharedUI.Resources.AppResources> Loc

<ErrorBoundary>
    <ChildContent>
        @if (ViewModel == null)
        {
            <div class="d-flex justify-content-center align-items-center" style="min-height: 200px;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">@Loc["Feed_Loading"]</span>
                </div>
            </div>
        }
        else
        {
            <div class="container-fluid py-3" style="overflow-x: hidden;">
                <!-- Tradesman Feed Header -->
                @if (ViewModel.IsTradesman)
                {
                    <div class="d-flex justify-content-between align-items-center mb-4 px-2">
                        <h2 class="h5 fw-bold mb-0">@Loc["Feed_AvailableAuctions"]</h2>
                        <a href="#" class="text-primary text-decoration-underline" style="font-size: 0.85rem;" @onclick='() => NavManager.NavigateTo("/passed-auctions")' @onclick:preventDefault>
                            @Loc["Feed_DismissedJobs"]
                        </a>
                    </div>
                }

                <!-- Loading Indicator -->
                @if (ViewModel.IsLoading)
                {
                    <div class="text-center my-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">@Loc["Feed_Loading"]</span>
                        </div>
                    </div>
                }
                else
                {
                    <!-- 1. Homeowner View: Pros Directory (Reels) -->
                    @if (ViewModel.IsHomeowner)
                    {
                        var galleryImages = ViewModel.FeedVideos?.Take(3).Select(v => v.ImageUrl).ToList() ?? new List<string>();
                        while (galleryImages.Count < 3)
                        {
                            galleryImages.Add(""); 
                        }

                        <div class="bs-homeowner-page-container">
                            <!-- Background Split for Desktop -->
                            <div class="bs-hero-bg-split d-none d-lg-block"></div>

                            <!-- Desktop Split Layout / Mobile Stack Layout -->
                            <div class="bs-homeowner-layout-wrapper">
                                <!-- LEFT COLUMN on Desktop / BOTTOM SECTION on Mobile -->
                                <div @key='"homeowner_left_col"' class="bs-homeowner-content-col">
                                    <!-- Mini Logo (Desktop only) -->
                                    <div class="d-none d-lg-block">
                                        <div class="bs-hero-mini-logo">BuildSmart</div>
                                        <div class="bs-hero-mini-slogan">@Loc["Feed_HeroMiniSlogan"]</div>
                                    </div>

                                    <!-- Carousel container with swipe pointer events -->
                                    <div class="bs-carousel-container" @onpointerdown="OnPointerDown" @onpointerup="OnPointerUp">
                                        <div class="bs-carousel-track" style="transform: translateX(-@($"{_activeSlideIndex * 100}%"));">
                                            <!-- Slide 1: Hero Info & CTA -->
                                            <div class="bs-carousel-slide">
                                                <h1 class="bs-hero-title mb-2">@Loc["Feed_HeroTitle"]</h1>
                                                <p class="bs-hero-subtitle mb-4">@Loc["Feed_HeroSubtitle"]</p>
                                                
                                                <!-- Main CTA Button -->
                                                <button class="bs-btn-primary bs-hero-cta py-3 px-4 w-100 mb-3" 
                                                        @onclick='() => NavManager.NavigateTo(ViewModel.SelectedCategoryId.HasValue ? $"/job-wizard?TargetCategoryId={ViewModel.SelectedCategoryId.Value}" : "/job-wizard")'>
                                                    @Loc["Feed_HeroCta"]
                                                </button>

                                                <!-- Social Icons -->
                                                <div class="bs-social-icons">
                                                    <a href="https://youtube.com" target="_blank" class="bs-social-icon-link">
                                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2a29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
                                                    </a>
                                                    <a href="https://instagram.com" target="_blank" class="bs-social-icon-link">
                                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                                                    </a>
                                                    <a href="https://facebook.com" target="_blank" class="bs-social-icon-link">
                                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
                                                    </a>
                                                    <a href="https://twitter.com" target="_blank" class="bs-social-icon-link">
                                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg>
                                                    </a>
                                                    <a href="https://linkedin.com" target="_blank" class="bs-social-icon-link">
                                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
                                                    </a>
                                                </div>
                                            </div>

                                            <!-- Slide 2: Why BuildSmart FAQ / Benefits -->
                                            <div class="bs-carousel-slide">
                                                <h1 class="bs-hero-title mb-2" style="color: var(--color-primary);">Защо BuildSmart?</h1>
                                                <p class="bs-hero-subtitle mb-4">Ние управляваме целия процес, за да не се налага на вас.</p>
                                                
                                                <div class="bs-reels-faq-benefits d-flex flex-column gap-3">
                                                    <div class="bs-faq-benefit-item" @onclick='() => NavManager.NavigateTo("/faq")'>
                                                        <div class="bs-benefit-icon">
                                                            <svg class="bs-benefit-icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                                                <path d="m9 11 2 2 4-4"/>
                                                            </svg>
                                                        </div>
                                                        <div class="bs-benefit-content">
                                                            <h5 class="fw-bold mb-1">0% Аванс. - Плащате за свършена работа!</h5>
                                                            <p class="mb-0 small">Няма риск за вас – ако направим грешка, я коригираме изцяло за наша сметка.</p>
                                                        </div>
                                                    </div>
                                                    
                                                    <div class="bs-faq-benefit-item" @onclick='() => NavManager.NavigateTo("/faq")'>
                                                        <div class="bs-benefit-icon">
                                                            <svg class="bs-benefit-icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                <circle cx="12" cy="12" r="10" />
                                                                <polyline points="12 6 12 12 16 14" />
                                                            </svg>
                                                        </div>
                                                        <div class="bs-benefit-content">
                                                            <h5 class="fw-bold mb-1">Конкурентни цени без скрити такси.</h5>
                                                            <p class="mb-0 small">Искаме вашият проект да бъде поредното доказателство за нашия професионализъм!</p>
                                                        </div>
                                                    </div>
                                                    
                                                    <div class="bs-faq-benefit-item" @onclick='() => NavManager.NavigateTo("/faq")'>
                                                        <div class="bs-benefit-icon">
                                                            <svg class="bs-benefit-icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275Z"/>
                                                                <path d="m5 3 1 2.5L8.5 6 6 7 5 9.5 4 7 1.5 6 4 5.5Z" opacity="0.5"/>
                                                                <path d="m19 17 1 2.5 2.5.5-2.5 1-1 2.5-1-2.5-2.5-1 2.5-1Z" opacity="0.5"/>
                                                            </svg>
                                                        </div>
                                                        <div class="bs-benefit-content">
                                                            <h5 class="fw-bold mb-1">Ремонт без скъсани нерви!</h5>
                                                            <p class="mb-0 small">Вашето спокойствие е наша отговорност, а мечтите ви – нашата добре свършена работа!</p>
                                                        </div>
                                                    </div>
                                                </div>


                                            </div>
                                        </div>
                                    </div>

                                    <!-- Carousel Dot Indicators -->
                                    <div class="bs-carousel-indicators">
                                        <button class="bs-indicator @(_activeSlideIndex == 0 ? "active" : "")" @onclick="() => { _activeSlideIndex = 0; ResetAutoPlayTimer(); }" title="Slide 1"></button>
                                        <button class="bs-indicator @(_activeSlideIndex == 1 ? "active" : "")" @onclick="() => { _activeSlideIndex = 1; ResetAutoPlayTimer(); }" title="Slide 2"></button>
                                    </div>
                                </div>

                                <!-- RIGHT COLUMN on Desktop / TOP SECTION on Mobile -->
                                <div @key='"homeowner_right_col"' class="bs-homeowner-visual-col">
                                    <!-- Category Filters (Placed directly on top of the videos!) -->
                                    <div class="bs-category-filters-container @(ViewModel.IsFilterExpanded ? "expanded" : "collapsed") mb-3">
                                        <div class="bs-category-filters-scroll">
                                            <div class="bs-category-filters-list">
                                                <button class="bs-chip @(ViewModel.SelectedCategoryId == null ? "active" : "")" 
                                                        @onclick="async () => { await ClearVideos(); await ViewModel.SelectCategoryCommand.ExecuteAsync(null); }">
                                                    @Loc["Feed_All"]
                                                </button>
                                                
                                                @foreach (var cat in (ViewModel.IsFilterExpanded ? ViewModel.Categories : ViewModel.Categories.Take(4)))
                                                {
                                                    <button class="bs-chip @(ViewModel.SelectedCategoryId == cat.Id ? "active" : "")" 
                                                            @onclick="async () => { await ClearVideos(); await ViewModel.SelectCategoryCommand.ExecuteAsync(cat.Id); }">
                                                        @cat.Name
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                        
                                        @if (!ViewModel.IsFilterExpanded && ViewModel.Categories.Count > 4)
                                        {
                                            <button class="bs-chip-add" @onclick="() => ViewModel.ToggleFilterCommand.Execute(null)">
                                                @Loc["Feed_ViewAll"]
                                            </button>
                                        }
                                        
                                        @if (ViewModel.IsFilterExpanded)
                                        {
                                            <button class="bs-chip-add" @onclick="() => ViewModel.ToggleFilterCommand.Execute(null)">
                                                @Loc["Feed_Collapse"]
                                            </button>
                                        }
                                    </div>

                                    @if (ViewModel.FeedVideos != null && ViewModel.FeedVideos.Any())
                                    {
                                        <div id="reels-feed-container" class="bs-reels-container">
                                            @foreach (var video in ViewModel.FeedVideos)
                                            {
                                                var videoId = $"video_{video.Id}";
                                                var wrapperId = $"wrapper_{videoId}";
                                                var isFirst = ViewModel.FeedVideos.IndexOf(video) == 0;
                                                <div @key="video.Id" class="bs-reel-item @(isFirst ? "bs-first-reel-cue" : "")" data-video-id="@videoId" id="@wrapperId">
                                                    <video id="@videoId" class="bs-reel-video plyr" loop playsinline preload="auto" poster="@video.ImageUrl" muted>
                                                        @if (!string.IsNullOrEmpty(video.MobileVideoUrl))
                                                        {
                                                            <source src="@video.MobileVideoUrl" media="(max-width: 768px)" type="video/mp4" />
                                                        }
                                                        <source src="@video.VideoUrl" type="video/mp4" />
                                                    </video>
                                                    
                                                    <!-- Theater Mode Navigation (Hidden unless in theater mode) -->
                                                    <button type="button" class="bs-theater-btn bs-theater-close" title="Close Theater Mode">
                                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                            <line x1="18" y1="6" x2="6" y2="18"></line>
                                                            <line x1="6" y1="6" x2="18" y2="18"></line>
                                                        </svg>
                                                    </button>

                                                    @if (isFirst)
                                                    {
                                                        <!-- Swipe Guide Hint (Fades out automatically) -->
                                                        <div class="bs-swipe-indicator">
                                                            <div class="bs-swipe-icon">
                                                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                    <polyline points="17 11 12 6 7 11"></polyline>
                                                                    <polyline points="17 18 12 13 7 18" style="opacity: 0.4;"></polyline>
                                                                </svg>
                                                            </div>
                                                            <span class="bs-swipe-text">@Loc["Feed_SwipeHint"]</span>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-center p-5 bg-card border-radius-lg">
                                            <p class="text-muted mb-0">@Loc["Feed_NoMediaFound"]</p>
                                        </div>
                                    }

                                    <!-- Video Disclaimer (Visible under the videos on desktop) -->
                                    <div class="bs-video-disclaimer mt-3 px-2 text-start" style="max-width: 440px;">
                                        <p class="small text-secondary mb-0" style="font-size: 0.8rem; font-style: italic; line-height: 1.3;">
                                            @Loc["Feed_VideoCaption"]
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- 2. Tradesman View: Available Auctions Feed -->
                    @if (ViewModel.IsTradesman && ViewModel.Auctions != null)
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var auction in ViewModel.Auctions)
                            {
                                <div class="bs-card shadow-sm">
                                    <div class="card-body p-3">
                                        <!-- Job Header -->
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <h5 class="fw-bold mb-0" style="font-size: 1.1rem;">@auction.Job?.Title</h5>
                                                <small class="text-primary d-block">@auction.Job?.ServiceCategory?.Name</small>
                                            </div>
                                            <span class="fw-bold text-success" style="font-size: 1.1rem;">
                                                @(auction.Job?.EstimatedBudget != null ? string.Format("{0:C0}", auction.Job.EstimatedBudget.Total) : Loc["Feed_NA"])
                                            </span>
                                        </div>

                                        <!-- Details -->
                                        <p class="mb-3" style="font-size: 0.9rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                            @auction.Job?.Description
                                        </p>
                                        
                                        <div class="d-flex gap-4 mb-3">
                                            <div class="d-flex align-items-center">
                                                <span class="me-1" style="font-size: 0.8rem;">📍</span>
                                                <small class="text-muted">@auction.Job?.Location</small>
                                            </div>
                                            <div class="d-flex align-items-center">
                                                <span class="me-1" style="font-size: 0.8rem;">💬</span>
                                                <small class="text-muted">@string.Format(Loc["Feed_QuestionsCount"], auction.Questions?.Count ?? 0)</small>
                                            </div>
                                        </div>

                                        <!-- Actions -->
                                        <div class="d-flex gap-2">
                                            <button class="bs-btn-dark w-50 py-2" @onclick="() => ViewModel.PassAuctionCommand.Execute(auction)">
                                                @Loc["Feed_Pass"]
                                            </button>
                                            <button class="bs-btn-primary w-50 py-2" @onclick="() => ViewModel.NavigateToDetailsCommand.Execute(auction)">
                                                @Loc["Feed_ViewAndBid"]
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }
    </ChildContent>
    <ErrorContent>
        <div class="alert alert-danger m-3">
            <h4>@Loc["Feed_RenderingError"]</h4>
            <p>@context.Message</p>
            <pre style="font-size: 10px; overflow-x: auto;">@context.StackTrace</pre>
        </div>
    </ErrorContent>
</ErrorBoundary>

<style>
    /* --- SWIPE CAROUSEL --- */
    .bs-carousel-container {
        width: 100%;
        overflow: hidden;
        position: relative;
        touch-action: pan-y;
        user-select: none;
        cursor: grab;
    }
    .bs-carousel-container:active {
        cursor: grabbing;
    }
    .bs-carousel-track {
        display: flex;
        flex-direction: row;
        flex-wrap: nowrap;
        transition: transform 0.45s cubic-bezier(0.25, 1, 0.5, 1);
        width: 100%;
    }
    .bs-carousel-slide {
        width: 100%;
        flex: 0 0 100%;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
    }
    .bs-carousel-indicators {
        display: flex;
        justify-content: flex-start;
        align-items: center;
        gap: 12px;
        margin-top: 1.5rem;
        padding: 8px 4px;
    }
    .bs-indicator {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background-color: var(--border-color);
        border: none;
        padding: 0;
        cursor: pointer;
        transition: all 0.25s ease;
    }
    .bs-indicator:hover {
        background-color: var(--text-secondary);
        transform: scale(1.1);
    }
    .bs-indicator.active {
        background-color: var(--color-primary);
        width: 32px;
        border-radius: 6px;
    }

    /* --- COMPACT CATEGORY FILTERS --- */
    .bs-category-filters-container {
        position: relative;
        z-index: 10; 
        width: 100%;
        max-width: 600px;
        margin: -10px auto 1rem auto; /* Reduced from 2.5rem to pull videos closer */
        box-sizing: border-box;
        transition: all 0.3s ease;
    }

    .bs-category-filters-container.collapsed {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0 1rem;
    }

    .bs-category-filters-container.expanded {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 1rem;
        background-color: var(--bg-card);
        border-radius: 16px;
        box-shadow: var(--elevation-08dp);
    }

    .bs-category-filters-scroll {
        flex: 1;
        min-width: 0; /* Important for flex child to allow inner scroll */
    }

    .bs-category-filters-container.collapsed .bs-category-filters-scroll {
        overflow-x: auto;
        scrollbar-width: none; /* Firefox */
        -webkit-overflow-scrolling: touch;
    }

    .bs-category-filters-container.collapsed .bs-category-filters-scroll::-webkit-scrollbar {
        display: none; /* Chrome/Safari */
    }

    .bs-category-filters-container.expanded .bs-category-filters-scroll {
        overflow: visible;
    }

    .bs-category-filters-list {
        display: flex;
        gap: 0.5rem;
    }

    .bs-category-filters-container.collapsed .bs-category-filters-list {
        flex-wrap: nowrap;
    }

    .bs-category-filters-container.expanded .bs-category-filters-list {
        flex-wrap: wrap;
    }

    .bs-chip {
        flex: 0 0 auto;
        height: 32px; /* Smaller height */
        background-color: var(--bg-card-alt);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        font-family: var(--font-body-2, sans-serif);
        font-weight: 500;
        font-size: 0.85rem; /* Smaller text */
        color: var(--text-primary);
        padding: 0 12px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        box-shadow: var(--elevation-01dp);
    }

    .bs-chip.active {
        background-color: var(--color-primary);
        color: var(--bg-page);
        font-weight: 700;
        border-color: var(--color-primary);
    }

    .bs-chip-add {
        flex: 0 0 auto;
        height: 32px;
        background-color: var(--bg-card);
        border: 1px dashed var(--color-primary);
        border-radius: 16px;
        font-family: var(--font-body-2, sans-serif);
        font-weight: 600;
        font-size: 0.85rem;
        color: var(--color-primary);
        padding: 0 12px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        box-shadow: var(--elevation-01dp);
    }

    .bs-category-filters-container.expanded .bs-chip-add {
        align-self: flex-start;
    }
    
    .bs-chip-add:hover {
        background-color: var(--color-primary);
        color: var(--bg-page);
    }

    .bs-reels-container {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 480px; /* Locked height for premium scroll container card */
        max-width: 356px; /* Match standard mobile screen widths */
        margin: 0 auto;
        overflow-y: scroll;
        scroll-snap-type: y mandatory;
        scrollbar-width: none;
        -ms-overflow-style: none;
        border-radius: 24px;
        box-shadow: var(--elevation-08dp);
    }

    .bs-reels-container::-webkit-scrollbar {
        display: none;
    }

    .bs-reel-item {
        scroll-snap-align: start;
        scroll-snap-stop: always;
        flex: 0 0 100%;
        width: 100%;
        height: 100%;
        position: relative;
        background-color: var(--bg-card);
        border: 2px solid var(--border-color, var(--bg-card-alt));
        border-radius: 24px;
        overflow: hidden;
        cursor: pointer;
        pointer-events: auto;
    }

    /* --- THEATER MODE --- */
    .bs-reels-container.in-theater-mode {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        width: 100vw !important;
        max-width: none !important;
        height: 100vh !important;
        height: 100dvh !important;
        margin: 0 !important;
        border-radius: 0 !important;
        border: none !important;
        z-index: 999999 !important; /* Float above everything including navbars */
        background-color: black !important;
        box-shadow: none !important;
    }

    .bs-reels-container.in-theater-mode .bs-reel-item {
        border-radius: 0 !important;
        border: none !important;
    }

    .bs-reel-video {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* --- PLYR VIDEO CONTROLS FIX --- */
    /* Force Plyr wrapper to fill the container so vertical videos aren't letterboxed weirdly */
    #reels-feed-container .plyr {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        width: 100%;
        height: 100%;
    }
    #reels-feed-container .plyr__video-wrapper,
    #reels-feed-container .plyr__video-wrapper video {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* Standard controls padding */
    #reels-feed-container .plyr__controls {
        padding-bottom: calc(10px + env(safe-area-inset-bottom, 0px));
        z-index: 20;
        background: transparent;
    }

    /* --- THEATER MODE NAVIGATION BUTTONS --- */
    .bs-theater-btn {
        display: none; /* Hidden by default */
        position: absolute;
        z-index: 30; /* Above everything */
        background: rgba(0, 0, 0, 0.5);
        color: white;
        border: none;
        border-radius: 50%;
        width: 56px; /* Increased for better mobile tap target */
        height: 56px;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        backdrop-filter: blur(4px);
        transition: background 0.2s ease, transform 0.2s ease, opacity 0.3s ease;
        opacity: 1;
        pointer-events: auto;
    }

    .bs-theater-btn:hover {
        background: rgba(0, 0, 0, 0.8);
        transform: scale(1.1);
    }

    /* Only show these buttons when theater mode is active */
    .bs-theater-mode .bs-theater-btn {
        display: flex;
    }

    /* Hide theater buttons when Plyr auto-hides controls, but add a delay so they don't vanish too fast */
    .bs-theater-mode .plyr.plyr--hide-controls ~ .bs-theater-btn {
        opacity: 0;
        /* Removed pointer-events: none; to fix the desktop hover flickering bug */
        transition: opacity 0.5s ease 0.5s; /* 0.5s delay before fading out */
    }

    .bs-theater-close {
        top: calc(20px + env(safe-area-inset-top, 0px));
        right: calc(20px + env(safe-area-inset-right, 0px));
    }


    @@media (min-width: 992px) {
        /* Larger video card in normal mode on desktop */
        .bs-reels-container:not(.in-theater-mode) {
            height: 600px !important;
            max-width: 440px !important;
        }

        /* Center the vertical video in theater mode with 9:16 ratio */
        .bs-reels-container.in-theater-mode .plyr {
            position: absolute !important;
            top: 0 !important;
            bottom: 0 !important;
            left: 50% !important;
            transform: translateX(-50%) !important;
            width: auto !important;
            height: 100% !important;
            aspect-ratio: 9 / 16 !important;
            max-width: calc(100vh * (9/16)) !important;
            max-width: calc(100dvh * (9/16)) !important;
        }
        
        /* Adjust theater close button on desktop */
        .bs-reels-container.in-theater-mode .bs-theater-close {
            position: fixed !important;
            top: 100px !important;
            right: 40px !important;
            z-index: 1000000 !important;
        }
    }
    
