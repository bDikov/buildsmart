	private string GetVideoCtaSubtitleStyle()
	{
		ResolveActiveVideoCtaRule();
		var color = (_activeVideoCtaRule != null && !string.IsNullOrEmpty(_activeVideoCtaRule.SubtitleColor)) 
			? _activeVideoCtaRule.SubtitleColor 
			: "#9ca3af";
