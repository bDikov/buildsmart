@page "/"
@page "/feed"
@using BuildSmart.SharedUI.ViewModels
@using System.ComponentModel
@using Microsoft.Extensions.Localization
@layout BuildSmart.SharedUI.Components.Layout.MainLayout
@implements IAsyncDisposable
@inject FeedPageViewModel ViewModel
@inject NavigationManager NavManager
@inject IStringLocalizer<BuildSmart.SharedUI.Resources.AppResources> Loc

<ErrorBoundary>
    <ChildContent>
        @if (ViewModel == null)
        {
            <div class="d-flex justify-content-center align-items-center" style="min-height: 200px;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">@Loc["Feed_Loading"]</span>
                </div>
            </div>
        }
        else
        {
            <div class="container-fluid py-3" style="overflow-x: hidden;">
                <!-- Tradesman Feed Header -->
                @if (ViewModel.IsTradesman)
                {
                    <div class="d-flex justify-content-between align-items-center mb-4 px-2">
                        <h2 class="h5 fw-bold mb-0">@Loc["Feed_AvailableAuctions"]</h2>
                        <a href="#" class="text-primary text-decoration-underline" style="font-size: 0.85rem;" @onclick='() => NavManager.NavigateTo("/passed-auctions")' @onclick:preventDefault>
                            @Loc["Feed_DismissedJobs"]
                        </a>
                    </div>
                }

                <!-- Loading Indicator -->
                @if (ViewModel.IsLoading)
                {
                    <div class="text-center my-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">@Loc["Feed_Loading"]</span>
                        </div>
                    </div>
                }
                else
                {
                    <!-- 1. Homeowner View: Pros Directory (Reels) -->
                    @if (ViewModel.IsHomeowner)
                    {
                        <!-- TikTok Style Interest Filters -->
                        <div class="bs-category-filters-container @(ViewModel.IsFilterExpanded ? "expanded" : "collapsed")">
                            <div class="bs-category-filters-scroll">
                                <div class="bs-category-filters-list">
                                    <button class="bs-chip @(ViewModel.SelectedCategoryId == null ? "active" : "")" 
                                            @onclick="async () => { await ClearVideos(); await ViewModel.SelectCategoryCommand.ExecuteAsync(null); }">
                                        @Loc["Feed_All"]
                                    </button>
                                    
                                    @* If collapsed, only show first 4 categories. If expanded, show all. *@
                                    @foreach (var cat in (ViewModel.IsFilterExpanded ? ViewModel.Categories : ViewModel.Categories.Take(4)))
                                    {
                                        <button class="bs-chip @(ViewModel.SelectedCategoryId == cat.Id ? "active" : "")" 
                                                @onclick="async () => { await ClearVideos(); await ViewModel.SelectCategoryCommand.ExecuteAsync(cat.Id); }">
                                            @cat.Name
                                        </button>
                                    }
                                </div>
                            </div>
                            
                            @if (!ViewModel.IsFilterExpanded && ViewModel.Categories.Count > 4)
                            {
                                <button class="bs-chip-add" @onclick="() => ViewModel.ToggleFilterCommand.Execute(null)">
                                    @Loc["Feed_ViewAll"]
                                </button>
                            }
                            
                            @if (ViewModel.IsFilterExpanded)
                            {
                                <button class="bs-chip-add" @onclick="() => ViewModel.ToggleFilterCommand.Execute(null)">
                                    @Loc["Feed_Collapse"]
                                </button>
                            }
                        </div>

                        @if (ViewModel.FeedVideos != null && ViewModel.FeedVideos.Any())
                        {
                            <div id="reels-feed-container" class="bs-reels-container mt-4">
                                @foreach (var video in ViewModel.FeedVideos)
                                {
                                    var videoId = $"video_{video.Id}";
                                    var wrapperId = $"wrapper_{videoId}";
                                    var isFirst = ViewModel.FeedVideos.IndexOf(video) == 0;
                                    <div @key="video.Id" class="bs-reel-item @(isFirst ? "bs-first-reel-cue" : "")" data-video-id="@videoId" id="@wrapperId">
                                        <video id="@videoId" class="bs-reel-video plyr" loop playsinline preload="auto" poster="@video.ImageUrl" muted>
                                            @if (!string.IsNullOrEmpty(video.MobileVideoUrl))
                                            {
                                                <source src="@video.MobileVideoUrl" media="(max-width: 768px)" type="video/mp4" />
                                            }
                                            <source src="@video.VideoUrl" type="video/mp4" />
                                        </video>
                                        
                                        <!-- Theater Mode Navigation (Hidden unless in theater mode) -->
                                        <button type="button" class="bs-theater-btn bs-theater-close" title="Close Theater Mode">
                                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                                <line x1="6" y1="6" x2="18" y2="18"></line>
                                            </svg>
                                        </button>

                                        @if (isFirst)
                                        {
                                            <!-- Swipe Guide Hint (Fades out automatically) -->
                                            <div class="bs-swipe-indicator">
                                                <div class="bs-swipe-icon">
                                                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <polyline points="17 11 12 6 7 11"></polyline>
                                                        <polyline points="17 18 12 13 7 18" style="opacity: 0.4;"></polyline>
                                                    </svg>
                                                </div>
                                                <span class="bs-swipe-text">@Loc["Feed_SwipeHint"]</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            <!-- FAQ & Benefits Section (links to /faq) -->
                            <div class="bs-reels-faq-section mt-4 mb-3">
                                <div class="bs-reels-faq-header text-center mb-3">
                                    <h4 class="h6 fw-bold mb-1">@Loc["Feed_FaqSectionTitle"]</h4>
                                    <p class="text-muted small mb-0">@Loc["Feed_FaqSectionSubtitle"]</p>
                                </div>
                                
                                <div class="bs-reels-faq-benefits d-flex flex-column gap-3">
                                    <div class="bs-faq-benefit-item" @onclick='() => NavManager.NavigateTo("/faq")'>
                                        <div class="bs-benefit-icon">
                                            <svg class="bs-benefit-icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                                <path d="m9 11 2 2 4-4"/>
                                            </svg>
                                        </div>
                                        <div class="bs-benefit-content">
                                            <h5 class="fw-bold mb-1">@Loc["Feed_BenefitNoAdvanceTitle"]</h5>
                                            <p class="mb-0 text-muted small">@Loc["Feed_BenefitNoAdvanceDesc"]</p>
                                        </div>
                                    </div>
                                    
                                    <div class="bs-faq-benefit-item" @onclick='() => NavManager.NavigateTo("/faq")'>
                                        <div class="bs-benefit-icon">
                                            <svg class="bs-benefit-icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="10" />
                                                <polyline points="12 6 12 12 16 14" />
                                            </svg>
                                        </div>
                                        <div class="bs-benefit-content">
                                            <h5 class="fw-bold mb-1">@Loc["Feed_BenefitNoVisitsTitle"]</h5>
                                            <p class="mb-0 text-muted small">@Loc["Feed_BenefitNoVisitsDesc"]</p>
                                        </div>
                                    </div>
                                    
                                    <div class="bs-faq-benefit-item" @onclick='() => NavManager.NavigateTo("/faq")'>
                                        <div class="bs-benefit-icon">
                                            <svg class="bs-benefit-icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275Z"/>
                                                <path d="m5 3 1 2.5L8.5 6 6 7 5 9.5 4 7 1.5 6 4 5.5Z" opacity="0.5"/>
                                                <path d="m19 17 1 2.5 2.5.5-2.5 1-1 2.5-1-2.5-2.5-1 2.5-1Z" opacity="0.5"/>
                                            </svg>
                                        </div>
                                        <div class="bs-benefit-content">
                                            <h5 class="fw-bold mb-1">@Loc["Feed_BenefitNoStressTitle"]</h5>
                                            <p class="mb-0 text-muted small">@Loc["Feed_BenefitNoStressDesc"]</p>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="text-center mt-3">
                                    <button class="bs-btn-primary w-100 py-2" style="border-radius: 12px; font-size: 0.9rem;" @onclick='() => NavManager.NavigateTo("/faq")'>
                                        @Loc["Feed_FaqSectionLink"] &rarr;
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-center mt-5">
                                <p class="text-muted">@Loc["Feed_NoMediaFound"]</p>
                            </div>
                        }
                    }

                    <!-- 2. Tradesman View: Available Auctions Feed -->
                    @if (ViewModel.IsTradesman && ViewModel.Auctions != null)
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var auction in ViewModel.Auctions)
                            {
                                <div class="bs-card shadow-sm">
                                    <div class="card-body p-3">
                                        <!-- Job Header -->
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <h5 class="fw-bold mb-0" style="font-size: 1.1rem;">@auction.Job?.Title</h5>
                                                <small class="text-primary d-block">@auction.Job?.ServiceCategory?.Name</small>
                                            </div>
                                            <span class="fw-bold text-success" style="font-size: 1.1rem;">
                                                @(auction.Job?.EstimatedBudget != null ? string.Format("{0:C0}", auction.Job.EstimatedBudget.Total) : Loc["Feed_NA"])
                                            </span>
                                        </div>

                                        <!-- Details -->
                                        <p class="mb-3" style="font-size: 0.9rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                            @auction.Job?.Description
                                        </p>
                                        
                                        <div class="d-flex gap-4 mb-3">
                                            <div class="d-flex align-items-center">
                                                <span class="me-1" style="font-size: 0.8rem;">📍</span>
                                                <small class="text-muted">@auction.Job?.Location</small>
                                            </div>
                                            <div class="d-flex align-items-center">
                                                <span class="me-1" style="font-size: 0.8rem;">💬</span>
                                                <small class="text-muted">@string.Format(Loc["Feed_QuestionsCount"], auction.Questions?.Count ?? 0)</small>
                                            </div>
                                        </div>

                                        <!-- Actions -->
                                        <div class="d-flex gap-2">
                                            <button class="bs-btn-dark w-50 py-2" @onclick="() => ViewModel.PassAuctionCommand.Execute(auction)">
                                                @Loc["Feed_Pass"]
                                            </button>
                                            <button class="bs-btn-primary w-50 py-2" @onclick="() => ViewModel.NavigateToDetailsCommand.Execute(auction)">
                                                @Loc["Feed_ViewAndBid"]
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }
    </ChildContent>
    <ErrorContent>
        <div class="alert alert-danger m-3">
            <h4>@Loc["Feed_RenderingError"]</h4>
            <p>@context.Message</p>
            <pre style="font-size: 10px; overflow-x: auto;">@context.StackTrace</pre>
        </div>
    </ErrorContent>
</ErrorBoundary>

<style>
    /* --- COMPACT CATEGORY FILTERS --- */
    .bs-category-filters-container {
        position: relative;
        z-index: 10; 
        width: 100%;
        max-width: 600px;
        margin: -10px auto 1rem auto; /* Reduced from 2.5rem to pull videos closer */
        box-sizing: border-box;
        transition: all 0.3s ease;
    }

    .bs-category-filters-container.collapsed {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0 1rem;
    }

    .bs-category-filters-container.expanded {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 1rem;
        background-color: var(--bg-card);
        border-radius: 16px;
        box-shadow: var(--elevation-08dp);
    }

    .bs-category-filters-scroll {
        flex: 1;
        min-width: 0; /* Important for flex child to allow inner scroll */
    }

    .bs-category-filters-container.collapsed .bs-category-filters-scroll {
        overflow-x: auto;
        scrollbar-width: none; /* Firefox */
        -webkit-overflow-scrolling: touch;
    }

    .bs-category-filters-container.collapsed .bs-category-filters-scroll::-webkit-scrollbar {
        display: none; /* Chrome/Safari */
    }

    .bs-category-filters-container.expanded .bs-category-filters-scroll {
        overflow: visible;
    }

    .bs-category-filters-list {
        display: flex;
        gap: 0.5rem;
    }

    .bs-category-filters-container.collapsed .bs-category-filters-list {
        flex-wrap: nowrap;
    }

    .bs-category-filters-container.expanded .bs-category-filters-list {
        flex-wrap: wrap;
    }

    .bs-chip {
        flex: 0 0 auto;
        height: 32px; /* Smaller height */
        background-color: var(--bg-card-alt);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        font-family: var(--font-body-2, sans-serif);
        font-weight: 500;
        font-size: 0.85rem; /* Smaller text */
        color: var(--text-primary);
        padding: 0 12px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        box-shadow: var(--elevation-01dp);
    }

    .bs-chip.active {
        background-color: var(--color-primary);
        color: var(--bg-page);
        font-weight: 700;
        border-color: var(--color-primary);
    }

    .bs-chip-add {
        flex: 0 0 auto;
        height: 32px;
        background-color: var(--bg-card);
        border: 1px dashed var(--color-primary);
        border-radius: 16px;
        font-family: var(--font-body-2, sans-serif);
        font-weight: 600;
        font-size: 0.85rem;
        color: var(--color-primary);
        padding: 0 12px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        box-shadow: var(--elevation-01dp);
    }

    .bs-category-filters-container.expanded .bs-chip-add {
        align-self: flex-start;
    }
    
    .bs-chip-add:hover {
        background-color: var(--color-primary);
        color: var(--bg-page);
    }

    .bs-reels-container {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 480px; /* Locked height for premium scroll container card */
        max-width: 356px; /* Match standard mobile screen widths */
        margin: 0 auto;
        overflow-y: scroll;
        scroll-snap-type: y mandatory;
        scrollbar-width: none;
        -ms-overflow-style: none;
        border-radius: 24px;
        box-shadow: var(--elevation-08dp);
    }

    .bs-reels-container::-webkit-scrollbar {
        display: none;
    }

    .bs-reel-item {
        scroll-snap-align: start;
        scroll-snap-stop: always;
        flex: 0 0 100%;
        width: 100%;
        height: 100%;
        position: relative;
        background-color: var(--bg-card);
        border: 2px solid var(--border-color, var(--bg-card-alt));
        border-radius: 24px;
        overflow: hidden;
        cursor: pointer;
        pointer-events: auto;
    }

    /* --- THEATER MODE --- */
    .bs-reels-container.in-theater-mode {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        width: 100vw !important;
        max-width: none !important;
        height: 100vh !important;
        height: 100dvh !important;
        margin: 0 !important;
        border-radius: 0 !important;
        border: none !important;
        z-index: 9999 !important; /* Float above everything including navbars */
        background-color: black !important;
        box-shadow: none !important;
    }

    .bs-reels-container.in-theater-mode .bs-reel-item {
        border-radius: 0 !important;
        border: none !important;
    }

    .bs-reel-video {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* --- PLYR VIDEO CONTROLS FIX --- */
    /* Force Plyr wrapper to fill the container so vertical videos aren't letterboxed weirdly */
    #reels-feed-container .plyr {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        width: 100%;
        height: 100%;
    }
    #reels-feed-container .plyr__video-wrapper,
    #reels-feed-container .plyr__video-wrapper video {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* Standard controls padding */
    #reels-feed-container .plyr__controls {
        padding-bottom: calc(10px + env(safe-area-inset-bottom, 0px));
        z-index: 20;
        background: transparent;
    }

    /* --- THEATER MODE NAVIGATION BUTTONS --- */
    .bs-theater-btn {
        display: none; /* Hidden by default */
        position: absolute;
        z-index: 30; /* Above everything */
        background: rgba(0, 0, 0, 0.5);
        color: white;
        border: none;
        border-radius: 50%;
        width: 56px; /* Increased for better mobile tap target */
        height: 56px;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        backdrop-filter: blur(4px);
        transition: background 0.2s ease, transform 0.2s ease, opacity 0.3s ease;
        opacity: 1;
        pointer-events: auto;
    }

    .bs-theater-btn:hover {
        background: rgba(0, 0, 0, 0.8);
        transform: scale(1.1);
    }

    /* Only show these buttons when theater mode is active */
    .bs-theater-mode .bs-theater-btn {
        display: flex;
    }

    /* Hide theater buttons when Plyr auto-hides controls, but add a delay so they don't vanish too fast */
    .bs-theater-mode .plyr.plyr--hide-controls ~ .bs-theater-btn {
        opacity: 0;
        /* Removed pointer-events: none; to fix the desktop hover flickering bug */
        transition: opacity 0.5s ease 0.5s; /* 0.5s delay before fading out */
    }

    .bs-theater-close {
        top: calc(20px + env(safe-area-inset-top, 0px));
        right: calc(20px + env(safe-area-inset-right, 0px));
    }


    @@media (min-width: 992px) {
        /* Larger video card in normal mode on desktop */
        .bs-reels-container:not(.in-theater-mode) {
            height: 600px !important;
            max-width: 440px !important;
        }

        /* Center the vertical video in theater mode with 9:16 ratio */
        .bs-reels-container.in-theater-mode .plyr {
            position: absolute !important;
            top: 0 !important;
            bottom: 0 !important;
            left: 50% !important;
            transform: translateX(-50%) !important;
            width: auto !important;
            height: 100% !important;
            aspect-ratio: 9 / 16 !important;
            max-width: calc(100vh * (9/16)) !important;
            max-width: calc(100dvh * (9/16)) !important;
        }
        
        /* Adjust theater close button on desktop */
        .bs-reels-container.in-theater-mode .bs-theater-close {
            top: 30px !important;
            right: 30px !important;
        }
    }

    /* FAQ & Benefits Section styles */
    .bs-reels-faq-section {
        display: none; /* Hidden by default on short screen viewports */
        width: 100%;
        max-width: 356px;
        margin: 1.5rem auto 0 auto;
        padding: 20px;
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        box-shadow: var(--elevation-02dp);
        transition: all 0.3s ease;
    }

    .bs-reels-faq-section:hover {
        box-shadow: var(--elevation-04dp);
    }

    .bs-reels-faq-header h4 {
        color: var(--text-primary);
        font-family: var(--font-primary), sans-serif;
    }

    .bs-faq-benefit-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        background-color: var(--bg-card-alt);
        border: 1px solid transparent;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .bs-faq-benefit-item:hover {
        border-color: var(--color-primary);
        transform: translateY(-2px);
        box-shadow: var(--elevation-01dp);
    }

    .bs-benefit-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        color: var(--color-primary);
        flex-shrink: 0;
    }

    .bs-benefit-content h5 {
        font-size: 0.9rem;
        color: var(--text-primary);
        margin: 0;
    }

    .bs-benefit-content p {
        font-size: 0.75rem;
        line-height: 1.4;
        margin: 0;
        color: var(--text-muted);
    }

    /* Media queries to show the component ONLY if we have BIG space under the videos */

    /* For Mobile viewports: show only if height is at least 780px */
    @@media (max-width: 991px) and (min-height: 780px) {
        .bs-reels-faq-section {
            display: block;
        }
    }

    /* For Desktop viewports: show only if height is at least 900px */
    @@media (min-width: 992px) and (min-height: 900px) {
        .bs-reels-faq-section {
            display: block;
            max-width: 440px !important;
        }
    }

    /* Swipe Guide Hint Indicator */
    .bs-swipe-indicator {
        position: absolute;
        bottom: 50px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        z-index: 99; /* Higher than Plyr players and posters */
        color: white; /* Hardcoded white for dark/video overlay context */
        background: rgba(17, 17, 17, 0.75);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        padding: 8px 18px;
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.15);
        box-shadow: var(--elevation-03dp);
        pointer-events: none; /* Let swipes pass through to the video container */
        animation: bsSwipeFade 4.5s forwards;
    }

    .bs-swipe-icon {
        animation: bsSwipeBounce 1.2s infinite;
    }

    .bs-swipe-text {
        font-family: var(--font-primary), sans-serif;
        font-size: 0.75rem;
        font-weight: 600;
        text-shadow: 0px 1px 4px rgba(0, 0, 0, 0.9);
        letter-spacing: 0.5px;
        text-transform: uppercase;
        opacity: 0.9;
        white-space: nowrap;
    }

    @@keyframes bsSwipeBounce {
        0%, 100% {
            transform: translateY(0);
            opacity: 0.3;
        }
        50% {
            transform: translateY(-8px);
            opacity: 1;
        }
    }

    @@keyframes bsSwipeFade {
        0% {
            opacity: 0;
        }
        10% {
            opacity: 1;
        }
        80% {
            opacity: 1;
        }
        100% {
            opacity: 0;
            visibility: hidden;
        }
    }

    /* Swipe Peek Animation for the first video card stack */
    .bs-first-reel-cue {
        animation: bsFirstReelCueAnimation 2.2s cubic-bezier(0.25, 1, 0.5, 1) 0.5s; /* 0.5s delay to let layout settle */
    }

    @@keyframes bsFirstReelCueAnimation {
        0% {
            transform: translateY(0);
        }
        35% {
            transform: translateY(50%); /* Swipe down to reveal 50% of the next video */
        }
        65% {
