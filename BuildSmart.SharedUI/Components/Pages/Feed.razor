@page "/"
@page "/feed"
@using BuildSmart.SharedUI.ViewModels
@using System.ComponentModel
@using Microsoft.Extensions.Localization
@layout BuildSmart.SharedUI.Components.Layout.MainLayout
@implements IAsyncDisposable
@inject FeedPageViewModel ViewModel
@inject NavigationManager NavManager
@inject IStringLocalizer<BuildSmart.SharedUI.Resources.AppResources> Loc

<ErrorBoundary>
    <ChildContent>
        @if (ViewModel == null)
        {
            <div class="d-flex justify-content-center align-items-center" style="min-height: 200px;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">@Loc["Feed_Loading"]</span>
                </div>
            </div>
        }
        else
        {
            <div class="container-fluid py-3" style="min-height: 100vh;">
                <!-- Homeowner Action Header -->
                @if (ViewModel.IsHomeowner && ViewModel.HasProjects == false)
                {
                    <div class="mb-4">
                        <button class="bs-btn-primary w-100" @onclick="() => ViewModel.NavigateToWizardCommand.Execute(null)">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            @Loc["Feed_StartNewProject"]
                        </button>
                    </div>
                }

                <!-- Tradesman Feed Header -->
                @if (ViewModel.IsTradesman)
                {
                    <div class="d-flex justify-content-between align-items-center mb-3 px-2">
                        <h2 class="h5 fw-bold mb-0">@Loc["Feed_AvailableAuctions"]</h2>
                        <a href="#" class="text-primary text-decoration-underline" style="font-size: 0.85rem;" @onclick='() => NavManager.NavigateTo("/passed-auctions")' @onclick:preventDefault>
                            @Loc["Feed_DismissedJobs"]
                        </a>
                    </div>
                }

                <!-- Loading Indicator -->
                @if (ViewModel.IsLoading)
                {
                    <div class="text-center my-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">@Loc["Feed_Loading"]</span>
                        </div>
                    </div>
                }
                else
                {
                    <!-- 1. Homeowner View: Pros Directory (Reels) -->
                    @if (ViewModel.IsHomeowner && ViewModel.FeedVideos != null)
                    {
                        <div id="reels-feed-container" class="reels-container">
                            @foreach (var video in ViewModel.FeedVideos)
                            {
                                var videoId = $"video_{video.TradesmanId}_{video.VideoUrl.GetHashCode()}";
                                var wrapperId = $"wrapper_{videoId}";
                                <div class="reel-item" data-video-id="@videoId" id="@wrapperId">
                                    <video id="@videoId" class="reel-video plyr" loop playsinline preload="auto" poster="" muted>
                                        <source src="@video.VideoUrl" type="video/mp4" />
                                    </video>
                                    
                                    <div class="reel-overlay" @onclick:stopPropagation="true">
                                        <div class="reel-info">
                                            <h3 class="reel-name">@video.Name</h3>
                                            <p class="reel-role">@video.Role・@video.Location</p>
                                            
                                            <div class="reel-stats">
                                                <div class="reel-stat-item">
                                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                                    </svg>
                                                    <span>@string.Format("{0:F1}", video.Rating)</span>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="reel-actions">
                                            <div class="reel-avatar-ring">
                                                <img src="@(string.IsNullOrEmpty(video.ProfilePictureUrl) ? "" : video.ProfilePictureUrl)" alt="Profile" class="reel-avatar-image" />
                                            </div>
                                            <button class="reel-action-btn" @onclick="() => NavigateToTradesmanProfile(video.TradesmanId)">
                                                @Loc["Feed_ViewProfile"]
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!-- 2. Tradesman View: Available Auctions Feed -->
                    @if (ViewModel.IsTradesman && ViewModel.Auctions != null)
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var auction in ViewModel.Auctions)
                            {
                                <div class="bs-card shadow-sm">
                                    <div class="card-body p-3">
                                        <!-- Job Header -->
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <h5 class="fw-bold mb-0" style="font-size: 1.1rem;">@auction.Job?.Title</h5>
                                                <small class="text-primary d-block">@auction.Job?.ServiceCategory?.Name</small>
                                            </div>
                                            <span class="fw-bold text-success" style="font-size: 1.1rem;">
                                                @(auction.Job?.EstimatedBudget != null ? string.Format("{0:C0}", auction.Job.EstimatedBudget.Total) : Loc["Feed_NA"])
                                            </span>
                                        </div>

                                        <!-- Details -->
                                        <p class="mb-3" style="font-size: 0.9rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                            @auction.Job?.Description
                                        </p>
                                        
                                        <div class="d-flex gap-4 mb-3">
                                            <div class="d-flex align-items-center">
                                                <span class="me-1" style="font-size: 0.8rem;">📍</span>
                                                <small class="text-muted">@auction.Job?.Location</small>
                                            </div>
                                            <div class="d-flex align-items-center">
                                                <span class="me-1" style="font-size: 0.8rem;">💬</span>
                                                <small class="text-muted">@string.Format(Loc["Feed_QuestionsCount"], auction.Questions?.Count ?? 0)</small>
                                            </div>
                                        </div>

                                        <!-- Actions -->
                                        <div class="d-flex gap-2">
                                            <button class="bs-btn-dark w-50 py-2" @onclick="() => ViewModel.PassAuctionCommand.Execute(auction)">
                                                @Loc["Feed_Pass"]
                                            </button>
                                            <button class="bs-btn-primary w-50 py-2" @onclick="() => ViewModel.NavigateToDetailsCommand.Execute(auction)">
                                                @Loc["Feed_ViewAndBid"]
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }
    </ChildContent>
    <ErrorContent>
        <div class="alert alert-danger m-3">
            <h4>@Loc["Feed_RenderingError"]</h4>
            <p>@context.Message</p>
            <pre style="font-size: 10px; overflow-x: auto;">@context.StackTrace</pre>
        </div>
    </ErrorContent>
</ErrorBoundary>

<style>
    .reels-container {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 20px;
        padding-bottom: 20px;
        width: 100%;
        max-width: 100%;
        margin: 0 auto;
        padding-top: 20px;
        padding-left: 20px;
        padding-right: 20px;
        overflow-x: auto;
        overflow-y: hidden;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        scroll-behavior: smooth;
    }

    /* Hide scrollbar for cleaner look */
    .reels-container::-webkit-scrollbar {
        display: none;
    }
    .reels-container {
        -ms-overflow-style: none;  /* IE and Edge */
        scrollbar-width: none;  /* Firefox */
    }

    .reel-item {
        position: relative;
        flex: 0 0 auto; /* Prevent shrinking in horizontal layout */
        width: 85vw; /* Take up most of the screen width */
        max-width: 326px; /* Match Figma exact width */
        aspect-ratio: 326 / 438; /* Match Figma exactly */
        background-color: var(--bg-card);
        
        /* Figma PersonalityCard Properties */
        border: 2px solid var(--border-color, #ffffff);
        border-radius: 24px;
        box-shadow: 
            inset 3.6px 2.7px 19.8px rgba(0, 0, 0, 0.30), 
            0px 6px 14px 0px rgba(0, 0, 0, 0.75);
            
        overflow: hidden;
        cursor: pointer;
        scroll-snap-align: center;
    }

    .reel-video {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .reel-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        /* Add border-radius to match the container so the gradient doesn't bleed */
        border-bottom-left-radius: 22px;
        border-bottom-right-radius: 22px;
        background: linear-gradient(to top, var(--bg-card) 0%, transparent 100%);
        padding: 30px 20px 20px 20px;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        color: var(--text-primary);
        z-index: 10;
        pointer-events: none; /* Let clicks pass through to Plyr controls */
    }

    .reel-actions {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 15px;
        pointer-events: auto; /* Re-enable clicks on buttons */
    }

    .reel-avatar-ring {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        border: 2px solid var(--bg-card);
        overflow: hidden;
    }

    .reel-avatar-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .reel-action-btn {
        background-color: var(--color-primary);
        border: none;
        border-radius: 20px;
        color: var(--bg-page);
        font-weight: bold;
        padding: 8px 16px;
        font-size: 12px;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .reel-action-btn:hover {
        background-color: var(--color-secondary, #7943e0);
    }
</style>

@code {
    private string _errorMessage = string.Empty;
    private DotNetObjectReference<Feed>? _objRef;
    private bool _isJsInitialized = false;

    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (ViewModel != null)
            {
                ViewModel.PropertyChanged += OnViewModelPropertyChanged;
                await ViewModel.LoadFeedCommand.ExecuteAsync(null);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            Console.WriteLine($"[Feed.razor] OnInitializedAsync Error: {ex}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ViewModel.IsHomeowner && ViewModel.FeedVideos != null && ViewModel.FeedVideos.Any())
        {
            try
            {
                if (firstRender || !_isJsInitialized)
                {
                    _objRef = DotNetObjectReference.Create(this);
                    await JSRuntime.InvokeVoidAsync("reelsObserver.initialize", _objRef, "reels-feed-container");
                    _isJsInitialized = true;
                }
                
                // Re-observe elements (the JS safely handles duplicates)
                foreach (var video in ViewModel.FeedVideos)
                {
                    var vId = $"video_{video.TradesmanId}_{video.VideoUrl.GetHashCode()}";
                    var wId = $"wrapper_{vId}";
                    await JSRuntime.InvokeVoidAsync("reelsObserver.observeVideo", wId, vId);
                }
            }
            catch (Exception ex)
            {
                // Graceful degradation: The video will still render and have controls, 
                // but auto-play on scroll won't work until the browser cache is cleared.
                Console.WriteLine($"[Feed.razor] JSInterop Error: {ex.Message}. Please Hard Refresh (Ctrl+F5) to clear browser cache.");
            }
        }
    }

    [JSInvokable]
    public void OnVideoVisible(string videoId)
    {
        // Handled by JS for playback, we can use this hook for analytics later if needed.
    }

    private void NavigateToTradesmanProfile(string id) => NavManager.NavigateTo($"/tradesman-profile?TradesmanId={id}");

    private void OnViewModelPropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (ViewModel != null)
        {
            ViewModel.PropertyChanged -= OnViewModelPropertyChanged;
        }
        
        if (_isJsInitialized)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("reelsObserver.dispose");
            }
            catch { /* Ignore if JS interop is disconnected */ }
        }
        _objRef?.Dispose();
    }
}
