@page "/"
@page "/feed"
@using BuildSmart.SharedUI.ViewModels
@using System.ComponentModel
@using Microsoft.Extensions.Localization
@layout BuildSmart.SharedUI.Components.Layout.MainLayout
@implements IAsyncDisposable
@inject FeedPageViewModel ViewModel
@inject NavigationManager NavManager
@inject IStringLocalizer<BuildSmart.SharedUI.Resources.AppResources> Loc

<ErrorBoundary>
    <ChildContent>
        @if (ViewModel == null)
        {
            <div class="d-flex justify-content-center align-items-center" style="min-height: 200px;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">@Loc["Feed_Loading"]</span>
                </div>
            </div>
        }
        else
        {
            <div class="container-fluid py-3" style="min-height: 100vh; overflow-x: hidden;">
                <!-- Homeowner Action Header -->
                @if (ViewModel.IsHomeowner && ViewModel.HasProjects == false)
                {
                    <div class="mb-5 pb-3">
                        <button class="bs-btn-primary w-100" @onclick="() => ViewModel.NavigateToWizardCommand.Execute(null)">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            @Loc["Feed_StartNewProject"]
                        </button>
                    </div>
                }

                <!-- Tradesman Feed Header -->
                @if (ViewModel.IsTradesman)
                {
                    <div class="d-flex justify-content-between align-items-center mb-4 px-2">
                        <h2 class="h5 fw-bold mb-0">@Loc["Feed_AvailableAuctions"]</h2>
                        <a href="#" class="text-primary text-decoration-underline" style="font-size: 0.85rem;" @onclick='() => NavManager.NavigateTo("/passed-auctions")' @onclick:preventDefault>
                            @Loc["Feed_DismissedJobs"]
                        </a>
                    </div>
                }

                <!-- Loading Indicator -->
                @if (ViewModel.IsLoading)
                {
                    <div class="text-center my-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">@Loc["Feed_Loading"]</span>
                        </div>
                    </div>
                }
                else
                {
                    <!-- 1. Homeowner View: Pros Directory (Reels) -->
                    @if (ViewModel.IsHomeowner && ViewModel.FeedVideos != null)
                    {
                        <div id="reels-feed-container" class="bs-reels-container mt-4">
                            @foreach (var video in ViewModel.FeedVideos)
                            {
                                var videoId = $"video_{video.Id}";
                                var wrapperId = $"wrapper_{videoId}";
                                <div @key="video.Id" class="bs-reel-item" data-video-id="@videoId" id="@wrapperId">
                                    <video id="@videoId" class="bs-reel-video plyr" loop playsinline preload="auto" poster="" muted>
                                        <source src="@video.VideoUrl" type="video/mp4" />
                                    </video>
                                    
                                    <div class="bs-reel-overlay" @onclick:stopPropagation="true">
                                        <div class="bs-reel-info">
                                            <h3 class="bs-reel-name">@video.Name</h3>
                                            <p class="bs-reel-role">@video.Role・@video.Location</p>
                                            
                                            <div class="bs-reel-stats">
                                                <div class="bs-reel-stat-item">
                                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                                    </svg>
                                                    <span>@string.Format("{0:F1}", video.Rating)</span>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="bs-reel-actions">
                                            <div class="bs-reel-avatar-ring">
                                                <img src="@(string.IsNullOrEmpty(video.ProfilePictureUrl) ? "" : video.ProfilePictureUrl)" alt="Profile" class="bs-reel-avatar-image" />
                                            </div>
                                            <button class="bs-reel-action-btn" @onclick="() => NavigateToTradesmanProfile(video.TradesmanId)">
                                                @Loc["Feed_ViewProfile"]
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!-- 2. Tradesman View: Available Auctions Feed -->
                    @if (ViewModel.IsTradesman && ViewModel.Auctions != null)
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var auction in ViewModel.Auctions)
                            {
                                <div class="bs-card shadow-sm">
                                    <div class="card-body p-3">
                                        <!-- Job Header -->
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <h5 class="fw-bold mb-0" style="font-size: 1.1rem;">@auction.Job?.Title</h5>
                                                <small class="text-primary d-block">@auction.Job?.ServiceCategory?.Name</small>
                                            </div>
                                            <span class="fw-bold text-success" style="font-size: 1.1rem;">
                                                @(auction.Job?.EstimatedBudget != null ? string.Format("{0:C0}", auction.Job.EstimatedBudget.Total) : Loc["Feed_NA"])
                                            </span>
                                        </div>

                                        <!-- Details -->
                                        <p class="mb-3" style="font-size: 0.9rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                            @auction.Job?.Description
                                        </p>
                                        
                                        <div class="d-flex gap-4 mb-3">
                                            <div class="d-flex align-items-center">
                                                <span class="me-1" style="font-size: 0.8rem;">📍</span>
                                                <small class="text-muted">@auction.Job?.Location</small>
                                            </div>
                                            <div class="d-flex align-items-center">
                                                <span class="me-1" style="font-size: 0.8rem;">💬</span>
                                                <small class="text-muted">@string.Format(Loc["Feed_QuestionsCount"], auction.Questions?.Count ?? 0)</small>
                                            </div>
                                        </div>

                                        <!-- Actions -->
                                        <div class="d-flex gap-2">
                                            <button class="bs-btn-dark w-50 py-2" @onclick="() => ViewModel.PassAuctionCommand.Execute(auction)">
                                                @Loc["Feed_Pass"]
                                            </button>
                                            <button class="bs-btn-primary w-50 py-2" @onclick="() => ViewModel.NavigateToDetailsCommand.Execute(auction)">
                                                @Loc["Feed_ViewAndBid"]
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }
    </ChildContent>
    <ErrorContent>
        <div class="alert alert-danger m-3">
            <h4>@Loc["Feed_RenderingError"]</h4>
            <p>@context.Message</p>
            <pre style="font-size: 10px; overflow-x: auto;">@context.StackTrace</pre>
        </div>
    </ErrorContent>
</ErrorBoundary>

<style>
    .bs-reels-container {
        position: relative;
        width: 100%;
        height: 70vh; /* Give the stack some height to live in */
        max-width: 400px;
        margin: 0 auto;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .bs-reel-item {
        position: absolute;
        width: 100%;
        max-width: 326px; /* Match Figma exact width */
        aspect-ratio: 326 / 438; /* Match Figma exactly */
        background-color: var(--bg-card);
        
        /* Figma PersonalityCard Properties */
        border: 2px solid var(--border-color, var(--bg-card-alt));
        border-radius: 24px;
        box-shadow: var(--elevation-08dp, 0px 8px 10px 0px rgba(0, 0, 0, 0.20));
            
        overflow: hidden;
        cursor: pointer;
        
        /* Stack them perfectly on top of each other */
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        transition: transform 0.3s ease;
        
        /* Only allow the top card to be swipeable to prevent bugs */
        pointer-events: none;
    }

    /* --- MOBILE VIEW: Tinder Stack --- */
    @@media (max-width: 768px) {
        /* Simulate depth by pushing earlier items back slightly, similar to JobWizard */
        .bs-reel-item:nth-last-child(1) {
            z-index: 3;
            transform: translate(-50%, -50%) scale(1);
            pointer-events: auto; /* Active Top Card */
        }
        .bs-reel-item:nth-last-child(2) {
            z-index: 2;
            transform: translate(-50%, calc(-50% + 14px)) scale(0.96);
            opacity: 0.8;
        }
        .bs-reel-item:nth-last-child(3) {
            z-index: 1;
            transform: translate(-50%, calc(-50% + 28px)) scale(0.92);
            opacity: 0.4;
        }
        .bs-reel-item:nth-last-child(n+4) {
            opacity: 0;
        }
    }

    /* --- DESKTOP/TABLET VIEW: 3D Roller Coaster --- */
    @@media (min-width: 769px) {
        .bs-reels-container {
            max-width: 1200px; /* Allow wider container on desktop */
        }
        
        .bs-reel-item {
            transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.5s ease, filter 0.5s ease;
        }

        /* Center (Active) */
        .bs-reel-item:nth-last-child(1) {
            z-index: 3;
            transform: translate(-50%, -50%) scale(1);
            filter: blur(0px);
            opacity: 1;
            pointer-events: auto; /* Active Top Card */
        }
        /* Right Side (Next in queue) */
        .bs-reel-item:nth-last-child(2) {
            z-index: 2;
            transform: translate(calc(-50% + 360px), -50%) scale(0.85);
            filter: blur(4px);
            opacity: 0.5;
        }
        /* Left Side (Previously viewed / Bottom of deck) */
        .bs-reel-item:nth-child(1):not(:nth-last-child(1)):not(:nth-last-child(2)) {
            z-index: 1;
            transform: translate(calc(-50% - 360px), -50%) scale(0.85);
            filter: blur(4px);
            opacity: 0.5;
        }
        /* Hidden (Any cards in the middle of the deck) */
        .bs-reel-item:not(:nth-last-child(1)):not(:nth-last-child(2)):not(:nth-child(1)) {
            opacity: 0;
            transform: translate(-50%, -50%) scale(0.5);
        }
    }

    .bs-reel-video {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .bs-reel-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        /* Add border-radius to match the container so the gradient doesn't bleed */
        border-bottom-left-radius: 22px;
        border-bottom-right-radius: 22px;
        background: linear-gradient(to top, var(--bg-card) 0%, transparent 100%);
        padding: 30px 20px 20px 20px;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        color: var(--text-primary);
        z-index: 10;
        pointer-events: none; /* Let clicks pass through to Plyr controls */
    }

    .bs-reel-actions {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 15px;
        pointer-events: auto; /* Re-enable clicks on buttons */
    }

    .bs-reel-avatar-ring {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        border: 2px solid var(--bg-card);
        overflow: hidden;
    }

    .bs-reel-avatar-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .bs-reel-action-btn {
        background-color: var(--color-primary);
        border: none;
        border-radius: 20px;
        color: var(--bg-page);
        font-weight: bold;
        padding: 8px 16px;
        font-size: var(--font-body-2, 12px);
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .bs-reel-action-btn:hover {
        background-color: var(--color-secondary);
    }

    /* --- PLYR VIDEO CONTROLS FIX --- */
    /* Force Plyr wrapper to fill the container so vertical videos aren't letterboxed weirdly */
    #reels-feed-container .plyr {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        width: 100%;
        height: 100%;
    }
    #reels-feed-container .plyr__video-wrapper,
    #reels-feed-container .plyr__video-wrapper video {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* Push the Plyr controls up so they aren't hidden behind our custom title/avatar overlay */
    #reels-feed-container .plyr__controls {
        padding-bottom: 120px;
        z-index: 20; /* Ensure it floats above the gradient overlay */
        background: transparent;
    }
</style>

@code {
    private string _errorMessage = string.Empty;
    private DotNetObjectReference<Feed>? _objRef;
    private bool _isJsInitialized = false;

    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (ViewModel != null)
            {
                ViewModel.PropertyChanged += OnViewModelPropertyChanged;
                await ViewModel.LoadFeedCommand.ExecuteAsync(null);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            Console.WriteLine($"[Feed.razor] OnInitializedAsync Error: {ex}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ViewModel.IsHomeowner && ViewModel.FeedVideos != null && ViewModel.FeedVideos.Any())
        {
            try
            {
                if (firstRender || !_isJsInitialized)
                {
                    _objRef = DotNetObjectReference.Create(this);
                    await JSRuntime.InvokeVoidAsync("reelsObserver.initialize", _objRef, "reels-feed-container");
                    _isJsInitialized = true;
                }
                
                // Re-observe elements (the JS safely handles duplicates)
                foreach (var video in ViewModel.FeedVideos)
                {
                    var vId = $"video_{video.Id}";
                    var wId = $"wrapper_{vId}";
                    await JSRuntime.InvokeVoidAsync("reelsObserver.observeVideo", wId, vId);
                }
            }
            catch (Exception ex)
            {
                // Graceful degradation: The video will still render and have controls, 
                // but auto-play on scroll won't work until the browser cache is cleared.
                Console.WriteLine($"[Feed.razor] JSInterop Error: {ex.Message}. Please Hard Refresh (Ctrl+F5) to clear browser cache.");
            }
        }
    }

    [JSInvokable]
    public async Task ProcessSwipeEndFromJS(double deltaX, double velocity, double currentX, double currentRot, string videoId)
    {
        // For the Feed, any significant swipe (left or right) dismisses the current video
        bool isSwipeAction = Math.Abs(deltaX) > 80 || (Math.Abs(deltaX) > 30 && Math.Abs(velocity) > 0.5);

        if (isSwipeAction && ViewModel.FeedVideos != null && ViewModel.FeedVideos.Count > 1)
        {
            if (deltaX < 0)
            {
                // SWIPE LEFT -> Go to Next Video
                // The top video (Last item) moves to the bottom of the stack (Index 0)
                var videoToRemove = ViewModel.FeedVideos.Last();
                ViewModel.FeedVideos.Remove(videoToRemove);
                ViewModel.FeedVideos.Insert(0, videoToRemove);
            }
            else
            {
                // SWIPE RIGHT -> Go to Previous Video
                // The bottom video (Index 0) moves to the top of the stack (Last item)
                var previousVideo = ViewModel.FeedVideos.First();
                ViewModel.FeedVideos.Remove(previousVideo);
                ViewModel.FeedVideos.Add(previousVideo);
            }
                
            // Optional: Stop the old top video player
            try { await JSRuntime.InvokeVoidAsync("reelsObserver.pauseVideo", videoId); } catch { }
            
            await InvokeAsync(StateHasChanged);
            
            // Trigger the observer to play the NEW top video
            if (ViewModel.FeedVideos.Any())
            {
                var newTopVideo = ViewModel.FeedVideos.Last();
                var newTopVideoId = $"video_{newTopVideo.Id}";
                try { await JSRuntime.InvokeVoidAsync("reelsObserver.playVideo", newTopVideoId); } catch { }
            }
        }
    }

    [JSInvokable]
    public void OnVideoVisible(string videoId)
    {
        // Handled by JS for playback, we can use this hook for analytics later if needed.
    }

    private void NavigateToTradesmanProfile(string id) => NavManager.NavigateTo($"/tradesman-profile?TradesmanId={id}");

    private void OnViewModelPropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (ViewModel != null)
        {
            ViewModel.PropertyChanged -= OnViewModelPropertyChanged;
        }
        
        if (_isJsInitialized)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("reelsObserver.dispose");
            }
            catch { /* Ignore if JS interop is disconnected */ }
        }
        _objRef?.Dispose();
    }
}
