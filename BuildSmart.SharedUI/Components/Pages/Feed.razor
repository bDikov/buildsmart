@page "/"
@page "/feed"
@attribute [AllowAnonymous]
@using BuildSmart.SharedUI.ViewModels
@using BuildSmart.SharedUI.Services
@using System.ComponentModel
@using Microsoft.Extensions.Localization
@layout BuildSmart.SharedUI.Components.Layout.MainLayout
@implements IAsyncDisposable
@inject FeedPageViewModel ViewModel
@inject NavigationManager NavManager
@inject IStringLocalizer<BuildSmart.SharedUI.Resources.AppResources> Loc
@inject BuildSmart.SharedUI.Services.IAuthService AuthService

<ErrorBoundary>
	<ChildContent>
		@if (ViewModel == null)
		{
			<div class="d-flex justify-content-center align-items-center" style="min-height: 200px;">
				<div class="spinner-border text-primary" role="status">
					<span class="visually-hidden">@Loc["Feed_Loading"]</span>
				</div>
			</div>
		}
		else
		{
			<div class="container-fluid py-3" style="overflow-x: hidden;">
				<!-- Tradesman Feed Header -->
				@if (ViewModel.IsTradesman)
				{
					<div class="d-flex justify-content-between align-items-center mb-4 px-2">
						<h2 class="h5 fw-bold mb-0">@Loc["Feed_AvailableAuctions"]</h2>
						<a href="#" class="text-primary text-decoration-underline" style="font-size: 0.85rem;" @onclick='() => NavManager.NavigateTo("/passed-auctions")' @onclick:preventDefault>
							@Loc["Feed_DismissedJobs"]
						</a>
					</div>
				}

				<!-- Loading Indicator -->
				@if (ViewModel.IsLoading)
				{
					<div class="text-center my-5">
						<div class="spinner-border text-primary" role="status">
							<span class="visually-hidden">@Loc["Feed_Loading"]</span>
						</div>
					</div>
				}
				else
				{
					<!-- 1. Homeowner View: Pros Directory (Reels) -->
					@if (ViewModel.IsHomeowner)
					{
						var galleryImages = ViewModel.FeedVideos?.Take(3).Select(v => v.ImageUrl).ToList() ?? new List<string>();
						while (galleryImages.Count < 3)
						{
							galleryImages.Add("");
						}

						<div class="bs-homeowner-page-container">
							<!-- Background Split for Desktop -->
							<div class="bs-hero-bg-split d-none d-lg-block"></div>

							<!-- Desktop Split Layout / Mobile Stack Layout -->
							<div class="bs-homeowner-layout-wrapper">
								<!-- LEFT COLUMN on Desktop / BOTTOM SECTION on Mobile -->
								<div @key='"homeowner_left_col"' class="bs-homeowner-content-col">
									<!-- Mini Logo (Desktop only) -->
									<div class="d-none d-lg-block">
										<div class="bs-hero-mini-logo">BuildSmart</div>
										<div class="bs-hero-mini-slogan">@Loc["Feed_HeroMiniSlogan"]</div>
									</div>

									<!-- Carousel container with swipe pointer events -->
									<div class="bs-carousel-container" @onpointerdown="OnPointerDown" @onpointerup="OnPointerUp">
										<div class="bs-carousel-track" style="transform: translateX(-@($"{_activeSlideIndex * 100}%"));">
											<!-- Slide 1: Hero Info & CTA -->
											<div class="bs-carousel-slide">
												<h1 class="bs-hero-title mb-2">@GetHeroTitle()</h1>
												<p class="bs-hero-subtitle mb-4">@GetHeroSubtitle()</p>

												<!-- Main CTA Button -->
												<button class="bs-btn-primary bs-hero-cta py-3 px-4 w-100 mb-3"
														@onclick="HandleHeroCtaClick">
													@GetHeroCtaText()
												</button>

												<!-- Guest Login/Register Prompt -->
												@if (_activeRule != null && _activeRule.ShowLoginPrompt)
												{
													<div class="mb-3 text-center" style="cursor: pointer; width: 100%;" @onclick='() => NavManager.NavigateTo("/login")'>
														<span style="color: var(--text-secondary); font: var(--font-body-1); text-decoration: underline;">
															@Loc["Feed_HeroGuestLoginPrompt"]
														</span>
													</div>
												}

												<!-- Social Icons -->
												<div class="bs-social-icons">
													<a href="https://youtube.com" target="_blank" class="bs-social-icon-link">
														<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2a29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
													</a>
													<a href="https://instagram.com" target="_blank" class="bs-social-icon-link">
														<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
													</a>
													<a href="https://facebook.com" target="_blank" class="bs-social-icon-link">
														<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
													</a>
													<a href="https://twitter.com" target="_blank" class="bs-social-icon-link">
														<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg>
													</a>
													<a href="https://linkedin.com" target="_blank" class="bs-social-icon-link">
														<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
													</a>
												</div>
											</div>

											<!-- Slide 2: Why BuildSmart FAQ / Benefits -->
											<div class="bs-carousel-slide">
												<h1 class="bs-hero-title mb-2" style="color: var(--color-primary);">@Loc["Feed_FaqSectionTitle"]</h1>
												<p class="bs-hero-subtitle mb-4">@Loc["Feed_FaqSectionSubtitle"]</p>

												<div class="bs-reels-faq-benefits d-flex flex-column gap-3">
													<div class="bs-faq-benefit-item" @onclick='() => ShowBenefitModal("advance")'>
														<div class="bs-benefit-icon">
															<svg class="bs-benefit-icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
																<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
																<path d="m9 11 2 2 4-4" />
															</svg>
														</div>
														<div class="bs-benefit-content">
															<h5 class="fw-bold mb-1">@Loc["Feed_BenefitNoAdvanceTitle"]</h5>
															<p class="mb-0 small">@Loc["Feed_BenefitNoAdvanceDesc"]</p>
														</div>
													</div>

													<div class="bs-faq-benefit-item" @onclick='() => ShowBenefitModal("visits")'>
														<div class="bs-benefit-icon">
															<svg class="bs-benefit-icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
																<circle cx="12" cy="12" r="10" />
																<polyline points="12 6 12 12 16 14" />
															</svg>
														</div>
														<div class="bs-benefit-content">
															<h5 class="fw-bold mb-1">@Loc["Feed_BenefitNoVisitsTitle"]</h5>
															<p class="mb-0 small">@Loc["Feed_BenefitNoVisitsDesc"]</p>
														</div>
													</div>

													<div class="bs-faq-benefit-item" @onclick='() => ShowBenefitModal("stress")'>
														<div class="bs-benefit-icon">
															<svg class="bs-benefit-icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
																<path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275Z" />
																<path d="m5 3 1 2.5L8.5 6 6 7 5 9.5 4 7 1.5 6 4 5.5Z" opacity="0.5" />
																<path d="m19 17 1 2.5 2.5.5-2.5 1-1 2.5-1-2.5-2.5-1 2.5-1Z" opacity="0.5" />
															</svg>
														</div>
														<div class="bs-benefit-content">
															<h5 class="fw-bold mb-1">@Loc["Feed_BenefitNoStressTitle"]</h5>
															<p class="mb-0 small">@Loc["Feed_BenefitNoStressDesc"]</p>
														</div>
													</div>
												</div>


											</div>
										</div>
									</div>

									<!-- Carousel Dot Indicators -->
									<div class="bs-carousel-indicators">
										<button class="bs-indicator @(_activeSlideIndex == 0 ? "active" : "")" @onclick="() => { _activeSlideIndex = 0; ResetAutoPlayTimer(); }" title="Slide 1"></button>
										<button class="bs-indicator @(_activeSlideIndex == 1 ? "active" : "")" @onclick="() => { _activeSlideIndex = 1; ResetAutoPlayTimer(); }" title="Slide 2"></button>
									</div>
								</div>

								<!-- RIGHT COLUMN on Desktop / TOP SECTION on Mobile -->
								<div @key='"homeowner_right_col"' class="bs-homeowner-visual-col">
									<!-- Mobile-only Brand Header -->
									<div class="bs-mobile-brand-header text-center mb-3">
										<div style="color: var(--text-primary); font: var(--font-h5); margin-bottom: 2px;">BuildSmart</div>
										<div style="color: var(--text-secondary); font: var(--font-body-1);">@Loc["Feed_HeroMiniSlogan"]</div>
									</div>

									<!-- Category Filters (Placed directly on top of the videos!) -->
									@if (ViewModel.Categories != null && ViewModel.Categories.Any())
									{
										<div class="bs-category-filters-container @(ViewModel.IsFilterExpanded ? "expanded" : "collapsed") mb-3">
											<div class="bs-category-filters-scroll">
												<div class="bs-category-filters-list">
													<button class="bs-chip @(ViewModel.SelectedCategoryId == null ? "active" : "")"
															@onclick="async () => { await ClearVideos(); await ViewModel.SelectCategoryCommand.ExecuteAsync(null); }">
														@Loc["Feed_All"]
													</button>

													@foreach (var cat in (ViewModel.IsFilterExpanded ? ViewModel.Categories : ViewModel.Categories.Take(4)))
													{
														<button class="bs-chip @(ViewModel.SelectedCategoryId == cat.Id ? "active" : "")"
																@onclick="async () => { await ClearVideos(); await ViewModel.SelectCategoryCommand.ExecuteAsync(cat.Id); }">
															@cat.Name
														</button>
													}
												</div>
											</div>

											@if (!ViewModel.IsFilterExpanded && ViewModel.Categories.Count > 4)
											{
												<button class="bs-chip-add" @onclick="() => ViewModel.ToggleFilterCommand.Execute(null)">
													@Loc["Feed_ViewAll"]
												</button>
											}

											@if (ViewModel.IsFilterExpanded)
											{
												<button class="bs-chip-add" @onclick="() => ViewModel.ToggleFilterCommand.Execute(null)">
													@Loc["Feed_Collapse"]
												</button>
											}
										</div>
									}

									<div id="reels-feed-container" class="bs-reels-container">
										@if (ViewModel.FeedVideos != null && ViewModel.FeedVideos.Any())
										{
											@foreach (var video in ViewModel.FeedVideos)
											{
												var videoId = $"video_{video.Id}";
												var wrapperId = $"wrapper_{videoId}";
												var index = ViewModel.FeedVideos.IndexOf(video);
												var isFirst = index == 0;
												var activeVideo = ViewModel.ActiveVideoId.HasValue 
													? ViewModel.FeedVideos.FirstOrDefault(v => v.Id == ViewModel.ActiveVideoId.Value) 
													: null;
												var activeIndex = activeVideo != null ? ViewModel.FeedVideos.IndexOf(activeVideo) : 0;
												var preload = (index <= activeIndex) ? "auto" : (index == activeIndex + 1) ? "metadata" : "none";

												<div @key="video.Id" class="bs-reel-item @(isFirst ? "bs-first-reel-cue" : "")" data-video-id="@videoId" id="@wrapperId">
													<video id="@videoId" class="bs-reel-video plyr" loop playsinline preload="@preload" poster="@video.ImageUrl" muted>
														@if (!string.IsNullOrEmpty(video.MobileVideoUrl))
														{
															<source src="@video.MobileVideoUrl" media="(max-width: 768px)" type="video/mp4" />
														}
														<source src="@video.VideoUrl" type="video/mp4" />
													</video>

													<!-- Theater Mode Navigation (Hidden unless in theater mode) -->
													<button type="button" class="bs-theater-btn bs-theater-close" title="Close Theater Mode">
														<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
															<line x1="18" y1="6" x2="6" y2="18"></line>
															<line x1="6" y1="6" x2="18" y2="18"></line>
														</svg>
													</button>

													@if (isFirst)
													{
														<!-- Swipe Guide Hint (Fades out automatically) -->
														<div class="bs-swipe-indicator">
															<div class="bs-swipe-icon">
																<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
																	<polyline points="17 11 12 6 7 11"></polyline>
																	<polyline points="17 18 12 13 7 18" style="opacity: 0.4;"></polyline>
																</svg>
															</div>
															<span class="bs-swipe-text">@Loc["Feed_SwipeHint"]</span>
														</div>
													}
												</div>
											}
										}
										
										<!-- Always render the CTA card at the bottom of the feed -->
										<div class="bs-reel-item bs-cta-reel-card d-flex flex-column align-items-center justify-content-center text-center p-4" style="@GetVideoCtaCardStyle()">
											@if (_activeVideoCtaRule == null || string.IsNullOrEmpty(_activeVideoCtaRule.BackgroundImageUrl))
											{
												<div class="cta-icon-wrapper mb-4">
													<div class="pulse-circle">
														<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
															<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
														</svg>
													</div>
												</div>
											}
											
											<h3 class="mb-3" style="@GetVideoCtaTitleStyle()">
												@GetVideoCtaTitle()
											</h3>
											
											<p class="mb-4" style="@GetVideoCtaSubtitleStyle()">
												@GetVideoCtaSubtitle()
											</p>
											
											<button class="bs-btn-primary py-3 px-5 mt-2" style="@GetVideoCtaButtonStyle()" @onclick="HandleVideoCtaClick">
												@GetVideoCtaText()
											</button>
										</div>
									</div>

									<!-- Video Disclaimer (Visible under the videos on desktop) -->
									<div class="bs-video-disclaimer mt-3 px-2 text-center" style="max-width: 440px; margin-left: auto; margin-right: auto;">
										<p class="small text-secondary mb-0" style="font-size: 0.8rem; font-style: italic; line-height: 1.3;">
											@Loc["Feed_VideoCaption"]
										</p>
									</div>
								</div>
							</div>
						</div>
					}

					<!-- 2. Tradesman View: Available Auctions Feed -->
					@if (ViewModel.IsTradesman && ViewModel.Auctions != null)
					{
						<div class="d-flex flex-column gap-3">
							@foreach (var auction in ViewModel.Auctions)
							{
								<div class="bs-card shadow-sm">
									<div class="card-body p-3">
										<!-- Job Header -->
										<div class="d-flex justify-content-between align-items-start mb-2">
											<div>
												<h5 class="fw-bold mb-0" style="font-size: 1.1rem;">@auction.Job?.Title</h5>
												<small class="text-primary d-block">@auction.Job?.ServiceCategory?.Name</small>
											</div>
											<span class="fw-bold text-success" style="font-size: 1.1rem;">
												@(auction.Job?.EstimatedBudget != null ? string.Format("{0:C0}", auction.Job.EstimatedBudget.Total) : Loc["Feed_NA"])
											</span>
										</div>

										<!-- Details -->
										<p class="mb-3" style="font-size: 0.9rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
											@auction.Job?.Description
										</p>

										<div class="d-flex gap-4 mb-3">
											<div class="d-flex align-items-center">
												<span class="me-1" style="font-size: 0.8rem;">📍</span>
												<small class="text-muted">@auction.Job?.Location</small>
											</div>
											<div class="d-flex align-items-center">
												<span class="me-1" style="font-size: 0.8rem;">💬</span>
												<small class="text-muted">@string.Format(Loc["Feed_QuestionsCount"], auction.Questions?.Count ?? 0)</small>
											</div>
										</div>

										<!-- Actions -->
										<div class="d-flex gap-2">
											<button class="bs-btn-dark w-50 py-2" @onclick="() => ViewModel.PassAuctionCommand.Execute(auction)">
												@Loc["Feed_Pass"]
											</button>
											<button class="bs-btn-primary w-50 py-2" @onclick="() => ViewModel.NavigateToDetailsCommand.Execute(auction)">
												@Loc["Feed_ViewAndBid"]
											</button>
										</div>
									</div>
								</div>
							}
						</div>
					}
				}
			</div>
		}
	</ChildContent>
	<ErrorContent>
		<div class="alert alert-danger m-3">
			<h4>@Loc["Feed_RenderingError"]</h4>
			<p>@context.Message</p>
			<pre style="font-size: 10px; overflow-x: auto;">@context.StackTrace</pre>
		</div>
	</ErrorContent>
</ErrorBoundary>

<BsConfirmationModal IsVisible="_showAuthModal"
					 Title="@Loc["Feed_AuthAlert_Title"]"
					 Message="@Loc["Feed_AuthAlert_Message"]"
					 AcceptText="@Loc["Feed_AuthAlert_Accept"]"
					 CancelText="@Loc["Feed_AuthAlert_Cancel"]"
					 OnConfirmationChanged="OnAuthConfirmationChanged" />

@if (_showBenefitModal)
{
	<div class="bs-modal-overlay" @onclick="() => _showBenefitModal = false">
		<div class="bs-modal-card bs-card" @onclick:stopPropagation="true">
			<button class="bs-modal-close-btn" @onclick="() => _showBenefitModal = false" aria-label="Close">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<line x1="18" y1="6" x2="6" y2="18"></line>
					<line x1="6" y1="6" x2="18" y2="18"></line>
				</svg>
			</button>

			<div class="bs-modal-icon-container">
				@if (_benefitType == "advance")
				{
					<svg class="bs-benefit-icon-svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
						<path d="m9 11 2 2 4-4" />
					</svg>
				}
				else if (_benefitType == "visits")
				{
					<svg class="bs-benefit-icon-svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="12" cy="12" r="10" />
						<polyline points="12 6 12 12 16 14" />
					</svg>
				}
				else if (_benefitType == "stress")
				{
					<svg class="bs-benefit-icon-svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275Z" />
						<path d="m5 3 1 2.5L8.5 6 6 7 5 9.5 4 7 1.5 6 4 5.5Z" opacity="0.5" />
						<path d="m19 17 1 2.5 2.5.5-2.5 1-1 2.5-1-2.5-2.5-1 2.5-1Z" opacity="0.5" />
					</svg>
				}
			</div>

			<h3 class="bs-modal-title">
				@if (_benefitType == "advance")
				{
					@Loc["Feed_BenefitNoAdvanceTitle"]
				}
				else if (_benefitType == "visits")
				{

					@Loc["Feed_BenefitNoVisitsTitle"]
				}
				else if (_benefitType == "stress")
				{

					@Loc["Feed_BenefitNoStressTitle"]
				}
			</h3>

			<p class="bs-modal-message mb-3">
				@if (_benefitType == "advance")
				{
					@Loc["Feed_BenefitNoAdvanceDesc"]
				}
				else if (_benefitType == "visits")
				{

					@Loc["Feed_BenefitNoVisitsDesc"]
				}
				else if (_benefitType == "stress")
				{

					@Loc["Feed_BenefitNoStressDesc"]
				}
			</p>

			<a href="/faq" class="bs-modal-more-link mb-4" @onclick="() => _showBenefitModal = false">
				@Loc["Feed_FaqSectionLink"]
			</a>

