</style>

@code {
	public static Action? OnFeedResetRequested;

	private int _activeSlideIndex = 0;
	private double _pointerStartX;
	private System.Threading.Timer? _autoPlayTimer;

	private void OnPointerDown(Microsoft.AspNetCore.Components.Web.PointerEventArgs e)
	{
		_pointerStartX = e.ClientX;
	}

	private void OnPointerUp(Microsoft.AspNetCore.Components.Web.PointerEventArgs e)
	{
		var diffX = e.ClientX - _pointerStartX;
		if (Math.Abs(diffX) > 40)
		{
			if (diffX < 0)
			{
				_activeSlideIndex = 1;
			}
			else
			{
				_activeSlideIndex = 0;
			}
			ResetAutoPlayTimer();
		}
	}

	private void ResetAutoPlayTimer()
	{
		_autoPlayTimer?.Change(7000, 7000);
	}

	private string _errorMessage = string.Empty;
	private DotNetObjectReference<Feed>? _objRef;
	private bool _isJsInitialized = false;
	private bool _isGuest = true;

	[Inject] private IJSRuntime JSRuntime { get; set; } = default!;

	private LandingPageCopyRule? _activeRule;

	private void ResolveActiveCopyRule()
	{
		_activeRule = null;
		
		if (!BuildSmart.SharedUI.ApiConfig.LandingPage_EnableDynamicTitles)
		{
			return;
		}

		try
		{
			var json = Loc["LandingPage_CopywritingRules"];
			var rules = LandingPageRuleEvaluator.ParseRules(json);
			
			bool hasProjectsVal = ViewModel.HasProjects == true;
			bool hasDraftVal = ViewModel.LatestDraftProjectId.HasValue;
			bool hasActiveVal = ViewModel.LatestActiveProjectId.HasValue;
			
			foreach (var rule in rules)
			{
				if (LandingPageRuleEvaluator.EvaluateCondition(
					rule.Condition, 
					_isGuest, 
					hasProjectsVal, 
					ViewModel.IsTradesman, 
					ViewModel.IsHomeowner,
					hasDraftVal,
					hasActiveVal))
				{
					_activeRule = rule;
					break;
				}
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"[Feed.razor] ResolveActiveCopyRule Error: {ex.Message}");
		}
	}

	private string FormatCopywritingText(string rawText)
	{
		if (string.IsNullOrEmpty(rawText)) return string.Empty;
		if (!rawText.Contains("{0}")) return rawText;

		if (_activeRule != null)
		{
			if (string.Equals(_activeRule.Condition, "hasDraftProject", StringComparison.OrdinalIgnoreCase))
			{
				return string.Format(rawText, ViewModel.LatestDraftProjectTitle ?? string.Empty);
			}
			if (string.Equals(_activeRule.Condition, "hasActiveProject", StringComparison.OrdinalIgnoreCase))
			{
				return string.Format(rawText, ViewModel.LatestActiveProjectTitle ?? string.Empty);
			}
		}

		// Fallback to configured city name
		var city = BuildSmart.SharedUI.ApiConfig.LandingPage_CityName;
		return string.Format(rawText, city);
	}

	private string GetHeroTitle()
	{
		ResolveActiveCopyRule();
		
		if (_activeRule != null && !string.IsNullOrEmpty(_activeRule.TitleKey))
		{
			return FormatCopywritingText(Loc[_activeRule.TitleKey].Value);
		}
		return Loc["Feed_HeroTitle"];
	}

	private string GetHeroSubtitle()
	{
		ResolveActiveCopyRule();
		
		if (_activeRule != null && !string.IsNullOrEmpty(_activeRule.SubtitleKey))
		{
			return FormatCopywritingText(Loc[_activeRule.SubtitleKey].Value);
		}
		return Loc["Feed_HeroSubtitle"];
	}

	private string GetHeroCtaText()
	{
		ResolveActiveCopyRule();
		
		if (_activeRule != null && !string.IsNullOrEmpty(_activeRule.CtaKey))
		{
			return Loc[_activeRule.CtaKey];
		}
		return Loc["Feed_HeroCta"];
	}

	private void HandleHeroCtaClick()
	{
		ResolveActiveCopyRule();
		
		if (_activeRule != null && !string.IsNullOrEmpty(_activeRule.CtaAction))
		{
			var route = _activeRule.CtaAction;
			
			// Replace dynamic project ID tokens in route if present
			if (route.Contains("{DraftProjectId}"))
			{
				route = route.Replace("{DraftProjectId}", ViewModel.LatestDraftProjectId?.ToString() ?? string.Empty);
			}
			if (route.Contains("{ActiveProjectId}"))
			{
				route = route.Replace("{ActiveProjectId}", ViewModel.LatestActiveProjectId?.ToString() ?? string.Empty);
			}
			
			NavManager.NavigateTo(route);
		}
		else
		{
			HandleCreateProjectClick();
		}
	}

	protected override async Task OnInitializedAsync()
	{
		try
		{
			OnFeedResetRequested += ResetFeed;
			if (ViewModel != null)
			{
				ViewModel.PropertyChanged += OnViewModelPropertyChanged;
				await ViewModel.LoadFeedCommand.ExecuteAsync(null);
			}

			_isGuest = !AuthService.IsAuthenticated || await CheckIsGuestAsync();

			_autoPlayTimer = new System.Threading.Timer(_ =>
			{
				if (ViewModel.IsHomeowner)
				{
					_activeSlideIndex = (_activeSlideIndex + 1) % 2;
					InvokeAsync(StateHasChanged);
				}
			}, null, 7000, 7000);
		}
		catch (Exception ex)
		{
			_errorMessage = ex.Message;
			Console.WriteLine($"[Feed.razor] OnInitializedAsync Error: {ex}");
		}
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (ViewModel.IsHomeowner && ViewModel.FeedVideos != null && ViewModel.FeedVideos.Any())
		{
			try
			{
				if (firstRender || !_isJsInitialized)
				{
					_objRef = DotNetObjectReference.Create(this);
					await JSRuntime.InvokeVoidAsync("reelsObserver.initialize", _objRef, "reels-feed-container");
					_isJsInitialized = true;
				}

				// Re-observe elements (the JS safely handles duplicates)
				foreach (var video in ViewModel.FeedVideos)
				{
					var vId = $"video_{video.Id}";
					var wId = $"wrapper_{vId}";
					await JSRuntime.InvokeVoidAsync("reelsObserver.observeVideo", wId, vId);
				}
			}
			catch (Exception ex)
			{
				// Graceful degradation: The video will still render and have controls,
				// but auto-play on scroll won't work until the browser cache is cleared.
				Console.WriteLine($"[Feed.razor] JSInterop Error: {ex.Message}. Please Hard Refresh (Ctrl+F5) to clear browser cache.");
			}
		}
	}

	[JSInvokable]
	public async Task OnVideoVisible(string videoId)
	{
		if (!string.IsNullOrEmpty(videoId) && videoId.StartsWith("video_"))
		{
			var guidStr = videoId.Substring(6);
			if (Guid.TryParse(guidStr, out var id))
			{
				ViewModel.ActiveVideoId = id;
				if (ViewModel.ShouldLoadMore())
				{
					// Fire and forget
					_ = ViewModel.LoadMoreFeedMediaAsync();
				}
				await InvokeAsync(StateHasChanged);
			}
		}
	}

	private void NavigateToTradesmanProfile(string id) => NavManager.NavigateTo($"/tradesman-profile?TradesmanId={id}");

	private async Task ClearVideos()
	{
		if (_isJsInitialized)
		{
			try
			{
				await JSRuntime.InvokeVoidAsync("reelsObserver.clearAll");
			}
			catch { /* ignore */ }
		}
	}

	private async void ResetFeed()
	{
		await InvokeAsync(async () =>
		{
			// 1. Close theater mode if open
			if (_isJsInitialized)
			{
				try
				{
					await JSRuntime.InvokeVoidAsync("reelsObserver.closeTheaterMode");
				}
				catch { }
			}

			// 2. Clear category filter or reset scroll
			if (ViewModel != null)
			{
				if (ViewModel.SelectedCategoryId != null)
				{
					// Switching categories: Clean swap required, so clear old ones
					await ClearVideos();
					await ViewModel.SelectCategoryCommand.ExecuteAsync(null);
				}
				else
				{
					// Already in "All": Just pause and scroll back to top to preserve loaded videos
					if (_isJsInitialized)
					{
						try
						{
							await JSRuntime.InvokeVoidAsync("reelsObserver.resetScroll");
						}
						catch { }
					}
				}
			}

			// 3. Scroll page back to top
			if (_isJsInitialized)
			{
				try
				{
					await JSRuntime.InvokeVoidAsync("window.scrollTo", 0, 0);
				}
				catch { }
			}

			StateHasChanged();
		});
	}

	private void OnViewModelPropertyChanged(object? sender, PropertyChangedEventArgs e)
	{
		InvokeAsync(StateHasChanged);
	}

	private bool _showAuthModal = false;
	private bool _showBenefitModal = false;
	private string _benefitType = "";

	private void ShowBenefitModal(string type)
	{
		_benefitType = type;
		_showBenefitModal = true;
	}

	private void HandleBenefitCtaClick()
	{
		_showBenefitModal = false;
		HandleCreateProjectClick();
	}

	private async void HandleCreateProjectClick()
	{
		bool isGuest = await CheckIsGuestAsync();
		if (AuthService != null && (!AuthService.IsAuthenticated || isGuest))
		{
			_showAuthModal = true;
			StateHasChanged();
		}
		else
		{
			NavigateToWizard();
		}
	}

	private void OnAuthConfirmationChanged(bool proceed)
	{
		_showAuthModal = false;
		if (proceed)
		{
			string targetUrl = ViewModel.SelectedCategoryId.HasValue
				? $"/job-wizard?TargetCategoryId={ViewModel.SelectedCategoryId.Value}"
				: "/job-wizard";
			var returnUrl = Uri.EscapeDataString(targetUrl);
			NavManager.NavigateTo($"/create-account?ReturnUrl={returnUrl}");
		}
	}

	private void NavigateToWizard()
	{
		string targetUrl = ViewModel.SelectedCategoryId.HasValue
			? $"/job-wizard?TargetCategoryId={ViewModel.SelectedCategoryId.Value}"
			: "/job-wizard";
		NavManager.NavigateTo(targetUrl);
	}

	private async Task<bool> CheckIsGuestAsync()
	{
		try
		{
			if (AuthService == null) return false;
			var token = await AuthService.GetTokenAsync();
			if (string.IsNullOrEmpty(token)) return false;
			var handler = new System.IdentityModel.Tokens.Jwt.JwtSecurityTokenHandler();
			var jwtToken = handler.ReadJwtToken(token);
			var email = jwtToken.Claims.FirstOrDefault(c =>
				c.Type == "email" ||
				c.Type == "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress")?.Value;
			return email != null && email.EndsWith("@buildsmart.guest", StringComparison.OrdinalIgnoreCase);
		}
		catch
		{
			return false;
		}
	}

	public async ValueTask DisposeAsync()
	{
		OnFeedResetRequested -= ResetFeed;
		_autoPlayTimer?.Dispose();
		if (ViewModel != null)
		{
			ViewModel.PropertyChanged -= OnViewModelPropertyChanged;
		}

		if (_isJsInitialized)
		{
			try
			{
				await JSRuntime.InvokeVoidAsync("reelsObserver.dispose");
			}
			catch { /* Ignore if JS interop is disconnected */ }
		}
		_objRef?.Dispose();
	}

	private VideoCtaRule? _activeVideoCtaRule;

	private void ResolveActiveVideoCtaRule()
	{
		_activeVideoCtaRule = null;
		try
		{
			var json = Loc["LandingPage_VideoCtaRules"];
			if (string.IsNullOrEmpty(json) || json.Value == "LandingPage_VideoCtaRules")
			{
				return;
			}
			
			var rules = System.Text.Json.JsonSerializer.Deserialize<List<VideoCtaRule>>(json.Value, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
			if (rules == null) return;
			
			bool hasProjectsVal = ViewModel.HasProjects == true;
			bool hasDraftVal = ViewModel.LatestDraftProjectId.HasValue;
			bool hasActiveVal = ViewModel.LatestActiveProjectId.HasValue;
			
			foreach (var rule in rules)
			{
				if (LandingPageRuleEvaluator.EvaluateCondition(
					rule.Condition, 
					_isGuest, 
					hasProjectsVal, 
					ViewModel.IsTradesman, 
					ViewModel.IsHomeowner,
					hasDraftVal,
					hasActiveVal))
				{
					_activeVideoCtaRule = rule;
					break;
				}
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"[Feed.razor] ResolveActiveVideoCtaRule Error: {ex.Message}");
		}
	}

	private string GetVideoCtaTitle()
	{
		ResolveActiveVideoCtaRule();
		if (_activeVideoCtaRule != null && !string.IsNullOrEmpty(_activeVideoCtaRule.TitleKey))
		{
			return FormatVideoCtaText(Loc[_activeVideoCtaRule.TitleKey].Value);
		}
		return Loc["VideoCta_Title_Guest"];
	}

	private string GetVideoCtaSubtitle()
	{
		ResolveActiveVideoCtaRule();
		if (_activeVideoCtaRule != null && !string.IsNullOrEmpty(_activeVideoCtaRule.SubtitleKey))
		{
			return FormatVideoCtaText(Loc[_activeVideoCtaRule.SubtitleKey].Value);
		}
		return Loc["VideoCta_Subtitle_Guest"];
	}

	private string GetVideoCtaText()
	{
		ResolveActiveVideoCtaRule();
		if (_activeVideoCtaRule != null && !string.IsNullOrEmpty(_activeVideoCtaRule.CtaKey))
		{
			return Loc[_activeVideoCtaRule.CtaKey];
		}
		return Loc["VideoCta_Cta_Guest"];
	}

	private string FormatVideoCtaText(string rawText)
	{
		if (string.IsNullOrEmpty(rawText)) return string.Empty;
		if (!rawText.Contains("{0}")) return rawText;

		if (_activeVideoCtaRule != null)
		{
			if (string.Equals(_activeVideoCtaRule.Condition, "hasDraftProject", StringComparison.OrdinalIgnoreCase))
			{
				return string.Format(rawText, ViewModel.LatestDraftProjectTitle ?? string.Empty);
			}
			if (string.Equals(_activeVideoCtaRule.Condition, "hasActiveProject", StringComparison.OrdinalIgnoreCase))
			{
				return string.Format(rawText, ViewModel.LatestActiveProjectTitle ?? string.Empty);
			}
		}
		
		var city = BuildSmart.SharedUI.ApiConfig.LandingPage_CityName;
		return string.Format(rawText, city);
	}

	private void HandleVideoCtaClick()
	{
		ResolveActiveVideoCtaRule();
		if (_activeVideoCtaRule != null && !string.IsNullOrEmpty(_activeVideoCtaRule.CtaAction))
		{
			var route = _activeVideoCtaRule.CtaAction;
			if (route.Contains("{DraftProjectId}"))
			{
				route = route.Replace("{DraftProjectId}", ViewModel.LatestDraftProjectId?.ToString() ?? string.Empty);
			}
			if (route.Contains("{ActiveProjectId}"))
			{
				route = route.Replace("{ActiveProjectId}", ViewModel.LatestActiveProjectId?.ToString() ?? string.Empty);
