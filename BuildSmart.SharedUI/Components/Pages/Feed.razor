	private string GetVideoCtaCardStyle()
	{
		ResolveActiveVideoCtaRule();
		if (_activeVideoCtaRule == null)
		{
			return "border-radius: 20px; text-decoration: none;";
		}

		var style = "border-radius: 20px; text-decoration: none;";
		if (!string.IsNullOrEmpty(_activeVideoCtaRule.BackgroundColor))
		{
			style += $" background-color: {_activeVideoCtaRule.BackgroundColor} !important;";
		}
		if (!string.IsNullOrEmpty(_activeVideoCtaRule.BackgroundImageUrl))
		{
			var absoluteUrl = _activeVideoCtaRule.BackgroundImageUrl.StartsWith("http") 
				? _activeVideoCtaRule.BackgroundImageUrl 
				: $"{BuildSmart.SharedUI.ApiConfig.GetBaseUrl()}{_activeVideoCtaRule.BackgroundImageUrl}";
			style += $" background-image: linear-gradient(rgba(0,0,0,0.55), rgba(0,0,0,0.55)), url('{absoluteUrl}') !important; background-size: cover !important; background-position: center !important;";
		}
		if (!string.IsNullOrEmpty(_activeVideoCtaRule.CustomCss))
		{
			style += $" {_activeVideoCtaRule.CustomCss}";
		}
		return style;
	}

	private string GetVideoCtaTitleStyle()
	{
		ResolveActiveVideoCtaRule();
		var color = (_activeVideoCtaRule != null && !string.IsNullOrEmpty(_activeVideoCtaRule.TitleColor)) 
			? _activeVideoCtaRule.TitleColor 
			: "#ffffff";
