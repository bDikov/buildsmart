@page "/project-messages"
@page "/chat"
@page "/chat/{ProjectIdParam:guid}"
@using BuildSmart.SharedUI.ViewModels
@using System.ComponentModel
@using Microsoft.Extensions.Localization
@using BuildSmart.SharedUI.GraphQL
@using BuildSmart.SharedUI.Services
@layout BuildSmart.SharedUI.Components.Layout.MainLayout
@implements IAsyncDisposable
@inject IBuildSmartApiClient ApiClient
@inject SignalRService SignalRService
@inject IAuthService AuthService
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<BuildSmart.SharedUI.Resources.AppResources> Loc

<div class="chat-page-container">
    <!-- Header -->
    <div class="chat-header">
        @if (!_isGuest)
        {
            <button class="back-btn" @onclick="GoBack">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
            </button>
        }
        <div class="header-avatar">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2C6.48 2 2 6.14 2 11.25c0 2.91 1.45 5.48 3.72 7.12.21.15.33.42.27.68l-.55 2.71c-.06.29.22.54.5.42l3.1-1.3c.21-.09.46-.06.65.07.74.52 1.52.8 2.31.8 5.52 0 10-4.14 10-9.25C22 6.14 17.52 2 12 2zm1.25 11.5l-2.25-2.4-4.4 2.4 4.85-5.15 2.25 2.4 4.4-2.4-4.85 5.15z"/>
            </svg>
        </div>
        <div class="chat-header-info">
            <h2 class="chat-title">@(_projectName ?? Loc["ProjectDetail_Loading"])</h2>
            <span class="chat-subtitle">@Loc["ProjectDetail_NextSteps_AskBtn"]</span>
        </div>
        @if (_isAdmin && _projectDetails != null)
        {
            <button class="lead-info-btn @(_showLeadDrawer ? "active" : "")" @onclick="ToggleLeadDrawer" title="Детайли за лийда">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
                <span class="lead-info-btn-text">Инфо</span>
            </button>
        }
    </div>

    @if (_isAdmin && _showLeadDrawer && _projectDetails != null)
    {
        <div class="lead-info-panel">
            <div class="lead-info-grid">
                <div class="lead-info-item">
                    <span class="lead-label">Клиент:</span>
                    <span class="lead-val">@(_projectDetails.Homeowner?.FirstName) @(_projectDetails.Homeowner?.LastName)</span>
                </div>
                @if (!string.IsNullOrEmpty(_projectDetails.Homeowner?.Email))
                {
                    <div class="lead-info-item">
                        <span class="lead-label">Имейл:</span>
                        <span class="lead-val">@_projectDetails.Homeowner.Email</span>
                    </div>
                }
                @if (_projectDetails.JobPosts != null && _projectDetails.JobPosts.Any())
                {
                    var firstJob = _projectDetails.JobPosts.First();
                    if (!string.IsNullOrEmpty(firstJob.Location))
                    {
                        <div class="lead-info-item">
                            <span class="lead-label">Локация:</span>
                            <span class="lead-val">@firstJob.Location</span>
                        </div>
                    }
                    <div class="lead-info-item">
                        <span class="lead-label">Дейности:</span>
                        <span class="lead-val">@string.Join(", ", _projectDetails.JobPosts.Select(j => j.Title))</span>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Messages Window -->
    <div class="chat-messages-wrapper">
        <div @ref="_messageContainerRef" class="chat-messages-container" @onscroll="OnScroll">
            @if (_isLoadingHistory && _messages.Count == 0)
            {
                <div class="chat-loading-state">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    <p>@Loc["Notifications_Loading"]</p>
                </div>
            }
            else
            {
                @if (_messages.Count > 0)
                {
                    <div class="chat-spacer" style="flex: 1 1 auto; min-height: 0;"></div>
                }
                
                @if (_isLoadingMore)
                {
                    <div class="chat-loading-more">
                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    </div>
                }
                
                @if (_messages.Count == 0)
                {
                    <div class="chat-empty-state">
                        <div class="chat-empty-icon">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                            </svg>
                        </div>
                        <p class="empty-title">@Loc["Chat_EmptyTitle"]</p>
                        <p class="empty-subtitle">@Loc["Chat_EmptySubtitle"]</p>
                    </div>
                }
                else
                {
                    DateTime? lastDate = null;
                    @foreach (var msg in _messages)
                    {
                        var msgLocalDate = FormatToLocalDateTime(msg.CreatedAt);
                        var showDateHeader = lastDate == null || lastDate.Value.Date != msgLocalDate.Date;
                        lastDate = msgLocalDate;

                        if (showDateHeader)
                        {
                            <div class="chat-date-divider">
                                <span data-utc="@msg.CreatedAt.ToString("o")">@FormatDateHeader(msgLocalDate)</span>
                            </div>
                        }

                        <div class="chat-bubble-row @(msg.IsCurrentUser ? "current-user" : "other-user")">
                            @if (!msg.IsCurrentUser)
                            {
                                <div class="sender-avatar">
                                    <span>@msg.SenderName[0]</span>
                                </div>
                            }
                            <div class="chat-bubble-content">
                                @if (!msg.IsCurrentUser)
                                {
                                    <span class="sender-name">@msg.SenderName</span>
                                }
                                <div class="chat-bubble">
                                    <p class="message-text">@FormatMessageText(msg.MessageText)</p>
                                    <span class="message-time" data-utc="@msg.CreatedAt.ToString("o")">@msgLocalDate.ToString("HH:mm")</span>
                                </div>
                            </div>
                        </div>
                    }
                }
            }
        </div>
    </div>

    <!-- Input Footer -->
    <div class="chat-footer">
        <div class="input-container">
            @if (_isAdmin)
            {
                <button type="button"
                        class="ai-suggest-btn @(_isAiGenerating ? "loading" : "")"
                        @onclick="GenerateAiReplySuggestionAsync"
                        disabled="@_isAiGenerating"
                        title="AI Предложи отговор">
                    @if (_isAiGenerating)
                    {
                        <div class="spinner-border spinner-border-sm" role="status"></div>
                    }
                    else
                    {
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path>
                        </svg>
                    }
                </button>
            }
            <textarea @ref="_textareaRef"
                      class="chat-input"
                      placeholder="Напишете съобщение..."
                      @bind="_newMessageText"
                      @bind:event="oninput"
                      @onkeydown="OnInputKeyDown"
                      rows="1"></textarea>
            <button class="send-btn @(string.IsNullOrWhiteSpace(_newMessageText) ? "disabled" : "")"
                    @onclick="SendMessageAsync"
                    disabled="@string.IsNullOrWhiteSpace(_newMessageText)">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="22" y1="2" x2="11" y2="13"></line>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
            </button>
        </div>
    </div>
</div>

<script>
    window.chatHelpers = {
        scrollToBottom: (el) => {
            if (el) {
                requestAnimationFrame(() => {
                    el.scrollTop = el.scrollHeight;
                });
            }
        },
        getScrollHeight: (el) => el ? el.scrollHeight : 0,
        getScrollTop: (el) => el ? el.scrollTop : 0,
        setScrollTop: (el, val) => {
            if (el) el.scrollTop = val;
        },
        autoResize: (el) => {
            if (el) {
                el.style.height = 'auto';
                if (el.value) {
                    el.style.height = Math.min(el.scrollHeight, 280) + 'px';
                }
            }
        },
        resetHeight: (el) => {
            if (el) {
                el.value = '';
                el.style.height = 'auto';
            }
        },
        initAutoResize: (el) => {
            if (el) {
                el.addEventListener('input', () => {
                    window.chatHelpers.autoResize(el);
                });
            }
        },
        formatLocalTimes: () => {
            document.querySelectorAll('.message-time[data-utc]').forEach(el => {
                const utcStr = el.getAttribute('data-utc');
                if (utcStr) {
                    const d = new Date(utcStr);
                    if (!isNaN(d.getTime())) {
                        const h = String(d.getHours()).padStart(2, '0');
                        const m = String(d.getMinutes()).padStart(2, '0');
                        el.textContent = h + ':' + m;
                    }
                }
            });
            document.querySelectorAll('.chat-date-divider span[data-utc]').forEach(el => {
                const utcStr = el.getAttribute('data-utc');
                if (utcStr) {
                    const d = new Date(utcStr);
                    if (!isNaN(d.getTime())) {
                        const today = new Date();
                        const yesterday = new Date();
                        yesterday.setDate(today.getDate() - 1);
                        if (d.toDateString() === today.toDateString()) {
                            el.textContent = 'Днес';
                        } else if (d.toDateString() === yesterday.toDateString()) {
                            el.textContent = 'Вчера';
                        } else {
                            el.textContent = d.toLocaleDateString('bg-BG', { day: '2-digit', month: 'long', year: 'numeric' });
                        }
                    }
                }
            });
            document.querySelectorAll('.chat-time-stamp[data-utc]').forEach(el => {
                const utcStr = el.getAttribute('data-utc');
                if (utcStr) {
                    const d = new Date(utcStr);
                    if (!isNaN(d.getTime())) {
                        const today = new Date();
                        const yesterday = new Date();
                        yesterday.setDate(today.getDate() - 1);
                        if (d.toDateString() === today.toDateString()) {
                            const h = String(d.getHours()).padStart(2, '0');
                            const m = String(d.getMinutes()).padStart(2, '0');
                            el.textContent = h + ':' + m;
                        } else if (d.toDateString() === yesterday.toDateString()) {
                            el.textContent = 'Yesterday';
                        } else {
                            el.textContent = d.toLocaleDateString('bg-BG', { day: '2-digit', month: '2-digit', year: 'numeric' });
                        }
                    }
                }
            });
        }
    };
</script>
