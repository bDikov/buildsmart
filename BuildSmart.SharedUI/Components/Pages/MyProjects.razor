@page "/my-projects"
@using BuildSmart.SharedUI.ViewModels
@using BuildSmart.SharedUI.GraphQL
@inject MyProjectsViewModel ViewModel
@inject NavigationManager NavManager
@implements IDisposable
@inject BuildSmart.SharedUI.Services.SignalRService SignalRService
@inject BuildSmart.SharedUI.GraphQL.State.BuildSmartApiClientStoreAccessor StoreAccessor

<div class="projects-container">
    <div class="header-section">
        <div class="title-group">
            <h1 class="page-title">@Loc["Projects_Title"]</h1>
            <p class="page-subtitle">@Loc["Projects_Subtitle"]</p>
        </div>
        <button class="bs-btn-primary" @onclick='() => NavManager.NavigateTo("/job-wizard")'>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            @Loc["Projects_CreateNew"]
        </button>
    </div>

    @if (ViewModel.IsAdmin)
    {
        <div class="bs-card admin-filters-card mb-4">
            <h3 class="filters-title">Admin Filters</h3>
            <div class="filters-grid">
                <div class="filter-item">
                    <label class="filter-label">Search Query</label>
                    <input type="text" class="bs-input" @bind="ViewModel.SearchQuery" placeholder="Search title, ID, email..." />
                </div>
                <div class="filter-item">
                    <label class="filter-label">User ID</label>
                    <input type="text" class="bs-input" @bind="ViewModel.FilterUserId" placeholder="Filter by User GUID..." />
                </div>
                <div class="filter-item">
                    <label class="filter-label">User Email</label>
                    <input type="text" class="bs-input" @bind="ViewModel.FilterUserEmail" placeholder="user@example.com..." />
                </div>
                <div class="filter-item">
                    <label class="filter-label">Status</label>
                    <select class="bs-select" @bind="ViewModel.FilterStatus">
                        <option value="ALL">All Statuses</option>
                        <option value="DRAFT">Draft</option>
                        <option value="UNDERREVIEW">Requested Consultation (Under Review)</option>
                        <option value="ACTIVE">Active</option>
                        <option value="COMPLETED">Completed</option>
                    </select>
                </div>
            </div>
            <div class="filter-actions mt-3">
                <button class="bs-btn-primary" @onclick="ApplyFilters">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    Apply Filters
                </button>
                <button class="bs-btn-secondary" @onclick="ClearAdminFilters">
                    Reset
                </button>
            </div>
        </div>
    }

    @if (ViewModel.IsBusy && !ViewModel.Projects.Any())
    {
        <div class="loading-state">
            <div class="spinner-border text-primary" role="status"></div>
            <p>@Loc["Projects_Loading"]</p>
        </div>
    }
    else if (ViewModel.IsEmpty)
    {
        <div class="empty-state bs-card">
            <div class="empty-icon">🏗️</div>
            <h3>@Loc["Projects_EmptyTitle"]</h3>
            <p>@Loc["Projects_EmptySubtitle"]</p>
            <button class="bs-btn-primary" @onclick='() => NavManager.NavigateTo("/job-wizard")'>@Loc["Projects_GetStarted"]</button>
        </div>
    }
    else
    {
        <div class="projects-grid">
            @foreach (var project in ViewModel.Projects.Take(_visibleCount))
            {
                var progress = CalculateProgress(project);
                <div class="bs-card project-card" @onclick="() => HandleProjectClick(project)">
                    <div class="card-content">
                        <div class="project-header">
                            <div class="project-title-bar">
                                <h3 class="project-title">@(string.IsNullOrEmpty(project.Title) ? Loc["Projects_Untitled"] : project.Title)</h3>
                                <div class="status-badge-container">
                                    <span class="status-pill status-@project.Status.ToString().ToLower()">
                                        @GetProjectDisplayStatus(project)
                                    </span>
                                    @if (ShouldShowConsultationBadge(project))
                                    {
                                        <span class="status-pill status-underreview" style="background-color: rgba(255, 152, 0, 0.15); color: #ff9800; border-color: transparent;">
                                            @(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("bg", StringComparison.OrdinalIgnoreCase) ? "Заявена Консултация" : "Consultation Requested")
                                        </span>
                                    }
                                </div>
                            </div>
                            @if (ViewModel.IsAdmin && project.Homeowner != null)
                            {
                                <div class="project-owner-info mt-1" style="font-size: 13px; color: var(--text-muted);">
                                    <strong>Owner:</strong> @project.Homeowner.FirstName @project.Homeowner.LastName 
                                    @if (!string.IsNullOrEmpty(project.Homeowner.Email))
                                    {
                                        <span>(@project.Homeowner.Email)</span>
                                    }
                                </div>
                            }
                            <div class="project-meta">
                                <span class="meta-item">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                                    @(project.JobPosts?.FirstOrDefault()?.Location ?? Loc["Projects_Remote"])
                                </span>
                                <span class="meta-item">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                    @(project.JobPosts?.Sum(jp => jp.JobTasks?.Count ?? 0) ?? 0) @Loc["Projects_Jobs"]
                                </span>
                            </div>
                        </div>
                        
                        @{
                            bool isExpanded = _expandedProjects.Contains(project.Id);
                            string descText = string.IsNullOrEmpty(project.Description) ? Loc["Projects_DefaultDesc"] : project.Description;
                            bool isLongDesc = descText?.Length > 120;
                        }
                        <div class="project-desc-container mb-4">
                            <p class="project-desc @(isExpanded ? "expanded" : "collapsed")">@descText</p>
                            @if (isLongDesc)
                            {
                                <button type="button" class="bs-btn-text p-0 mt-1" style="font-size: 13px; font-weight: 600; color: var(--color-primary); background: transparent; border: none; cursor: pointer;" @onclick:stopPropagation="true" @onclick="() => ToggleProjectDescription(project.Id)">
                                    @(isExpanded ? Loc["ProjectDetail_ViewLess", "View Less"] : Loc["ProjectDetail_ViewMore", "View More"])
                                </button>
                            }
                        </div>
                        
                        @if (project.JobPosts != null && project.JobPosts.Any())
                        {
                            <div class="sub-heading mt-2 mb-2" style="font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">@Loc["Nav_Categories"]</div>
                            <div class="jobs-preview">
                                @foreach (var job in project.JobPosts.Take(2))
                                {
                                    <div class="job-chip">
                                        <span class="job-dot status-@job.Status.ToString().ToLower()"></span>
                                        <span class="job-name">@job.Title</span>
                                    </div>
                                }
                                @if (project.JobPosts.Count > 2)
                                {
                                    <span class="more-jobs">+@(project.JobPosts.Count - 2) @Loc["Projects_More"]</span>
                                }
                            </div>
                        }
                    </div>

                    <div class="card-footer">
                        <div class="progress-container">
                            <div class="progress-info">
                                <span class="progress-label">@Loc["Projects_Progress"]</span>
                                <span class="progress-percent">@progress%</span>
                            </div>
                            <div class="bs-progress-bar">
                                <div class="progress-fill" style="width: @progress%"></div>
                            </div>
                        </div>
                        <button class="delete-btn" @onclick:stopPropagation="true" @onclick="() => ViewModel.DeleteProjectCommand.ExecuteAsync(project)" title="@Loc["Projects_Delete"]">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                        </button>
                    </div>
                </div>
            }
        </div>
        @if (ViewModel.Projects.Count > _visibleCount)
        {
            <div class="d-flex justify-content-center mt-4 w-100" style="grid-column: 1 / -1;">
                <button class="bs-btn-secondary px-4 py-2" style="border-radius: 8px; font-weight: 600;" @onclick="LoadMoreProjects">
                    Load More Projects (@(ViewModel.Projects.Count - _visibleCount) remaining)
                </button>
            </div>
        }
    }
</div>

<style>
    .admin-filters-card {
        padding: 24px;
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        margin-bottom: 24px;
    }

    .filters-title {
        font-size: 18px;
        font-weight: 700;
        margin-top: 0;
        margin-bottom: 16px;
        color: var(--text-primary);
    }

    .filters-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
    }

    .filter-item {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .filter-label {
        font-size: 12px;
        font-weight: 600;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .bs-input, .bs-select {
        width: 100%;
        padding: 10px 14px;
        background-color: var(--bg-card-alt);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        color: var(--text-primary);
        font-size: 14px;
        outline: none;
        box-sizing: border-box;
        transition: border-color 0.2s ease;
    }

    .bs-input:focus, .bs-select:focus {
        border-color: var(--color-primary);
    }

    .filter-actions {
        display: flex;
        gap: 12px;
        justify-content: flex-start;
        align-items: center;
    }

    .projects-container {
        padding: 40px 20px;
        max-width: 1100px;
        margin: 0 auto;
        min-height: 100vh;
    }

    .header-section {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 40px;
        gap: 20px;
    }

    .page-title {
        font-size: 38px;
        font-weight: 800;
        margin: 0 0 8px 0;
        letter-spacing: -0.5px;
    }

    .page-subtitle {
        color: var(--text-muted);
        font-size: 16px;
        margin: 0;
    }

    .loading-state, .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 80px 40px;
    }

    .empty-icon {
        font-size: 64px;
        margin-bottom: 24px;
    }

    .empty-state h3 {
        font-size: 24px;
        margin-bottom: 12px;
    }

    .empty-state p {
        max-width: 400px;
        margin-bottom: 30px;
        color: var(--text-muted);
    }

    .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(450px, 1fr));
        gap: 24px;
    }

    @@media (max-width: 600px) {
        .projects-grid {
            grid-template-columns: 1fr;
        }
        .header-section {
            flex-direction: column;
            align-items: flex-start;
        }
        .project-title-bar {
            flex-direction: column-reverse;
            align-items: flex-start;
            gap: 8px;
        }
        .project-meta {
            flex-direction: row;
            flex-wrap: wrap;
            align-items: center;
            gap: 12px;
        }
        .status-badge-container {
            justify-content: flex-start;
            width: 100%;
        }
    }

    .project-card {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 0;
        overflow: hidden;
        border: 1px solid var(--border-color);
        cursor: pointer;
        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
    }

    .project-card:hover {
        transform: translateY(-6px) scale(1.01);
        box-shadow: var(--shadow-hover);
        background-color: var(--bg-card-alt);
    }

    .card-content {
        padding: 28px;
        flex-grow: 1;
    }

    .project-header {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        margin-bottom: 20px;
        gap: 12px;
    }

    .project-title-bar {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
        width: 100%;
    }

    .status-badge-container {
        flex-shrink: 0;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-start;
    }

    .project-title {
        font-size: 22px;
        font-weight: 700;
        margin: 0;
        color: var(--text-primary);
        line-height: 1.2;
        word-break: break-word; /* Prevent long words from breaking layout */
        overflow-wrap: break-word;
    }

    .project-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        color: var(--text-muted);
        font-size: 13px;
        font-weight: 500;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }

    .status-pill {
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        padding: 6px 12px;
        border-radius: 20px;
        letter-spacing: 0.5px;
        white-space: nowrap;
    }

    .status-active { background: rgba(16, 185, 129, 0.15); color: var(--color-success); }
    .status-completed { background: rgba(23, 162, 184, 0.15); color: var(--color-info); }
    .status-draft { background: rgba(119, 119, 119, 0.15); color: var(--color-secondary); }
    .status-underreview { background: rgba(255, 193, 7, 0.15); color: var(--color-warning); }

    .project-desc {
        font-size: 14px;
        color: var(--text-secondary);
        margin-bottom: 24px;
        line-height: 1.6;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .jobs-preview {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
    }

    .job-chip {
        display: flex;
        align-items: center;
        gap: 8px;
        background: var(--bg-card-alt);
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        color: var(--text-primary);
        border: 1px solid var(--border-color);
    }

    .job-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--border-color);
    }

    .job-dot.status-open { background: var(--color-success); box-shadow: 0 0 8px var(--color-success); }
    .job-dot.status-contracted { background: var(--color-info); }
    .job-dot.status-waitingforadminreview { background: var(--color-warning); }

    .more-jobs {
        font-size: 12px;
        color: var(--text-muted);
        font-weight: 600;
        margin-left: 4px;
    }

    .card-footer {
        padding: 20px 28px;
        background: var(--bg-page);
        display: flex;
        align-items: center;
        gap: 20px;
        border-top: 1px solid var(--border-color);
    }

    .progress-container {
        flex-grow: 1;
    }

    .progress-info {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
    }

    .progress-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--text-muted);
        letter-spacing: 0.5px;
    }

    .progress-percent {
        font-size: 12px;
        font-weight: 700;
        color: var(--color-primary);
    }

    .bs-progress-bar {
        height: 6px;
        background: var(--border-color);
        border-radius: 3px;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--color-primary), #a855f7);
        border-radius: 3px;
        transition: width 1s ease-out;
    }

    .delete-btn {
        background: transparent;
        border: none;
        color: var(--text-muted);
        cursor: pointer;
        padding: 8px;
        border-radius: 8px;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .delete-btn:hover {
        color: #ff5252;
        background: rgba(255, 82, 82, 0.1);
    }
</style>

@code {
    private HashSet<Guid> _expandedProjects = new HashSet<Guid>();
    private int _visibleCount = 6;

    private void LoadMoreProjects()
    {
        _visibleCount += 6;
    }

    private async Task ApplyFilters()
    {
        _visibleCount = 6;
        await ViewModel.LoadProjectsAsync();
    }

    private void ToggleProjectDescription(Guid projectId)
    {
        if (_expandedProjects.Contains(projectId))
            _expandedProjects.Remove(projectId);
        else
            _expandedProjects.Add(projectId);
    }

    protected override async Task OnInitializedAsync()
    {
        _visibleCount = 6;
        SignalRService.NotificationReceived += OnNotificationReceived;
        SignalRService.NotificationsStateChanged += OnNotificationsStateChanged;
        await ViewModel.LoadProjectsAsync();
    }

    private void OnNotificationReceived(string title, string msg, object? data)
    {
        InvokeAsync(async () =>
        {
            try { StoreAccessor.OperationStore.Clear(); } catch { }
            await ViewModel.LoadProjectsAsync();
            StateHasChanged();
        });
    }

    private void OnNotificationsStateChanged()
    {
        InvokeAsync(async () =>
        {
            try { StoreAccessor.OperationStore.Clear(); } catch { }
            await ViewModel.LoadProjectsAsync();
            StateHasChanged();
        });
    }

    private async Task ClearAdminFilters()
    {
        _visibleCount = 6;
        ViewModel.SearchQuery = string.Empty;
        ViewModel.FilterUserId = string.Empty;
        ViewModel.FilterUserEmail = string.Empty;
        ViewModel.FilterStatus = "ALL";
        await ViewModel.LoadProjectsAsync();
    }

    private int CalculateProgress(BuildSmart.SharedUI.GraphQL.IProjectDetails project)
    {
        if (project.JobPosts == null || !project.JobPosts.Any()) return 0;
        
        // Simple heuristic: 
        // Draft = 10%, Open = 40%, Contracted = 80%, Completed = 100%
        double total = 0;
        foreach(var job in project.JobPosts)
        {
            switch(job.Status)
            {
                case JobPostStatus.Contracted: total += 100; break;
                case JobPostStatus.BiddingClosed: total += 70; break;
                case JobPostStatus.Open: total += 40; break;
                case JobPostStatus.WaitingForAdminReview: total += 30; break;
                case JobPostStatus.WaitingForUserReview: total += 20; break;
                case JobPostStatus.Draft: total += 10; break;
                default: total += 5; break;
            }
        }
        
        return (int)(total / project.JobPosts.Count);
    }

    private string GetProjectDisplayStatus(BuildSmart.SharedUI.GraphQL.IProjectDetails project)
    {
        if (project.Status == ProjectStatus.UnderReview)
        {
            var jobs = project.JobPosts;
            if (jobs != null && jobs.Any())
            {
                if (jobs.Any(jp => jp.Status == JobPostStatus.Draft || jp.Status == JobPostStatus.GeneratingScope))
                {
                    return Loc["Status_GeneratingScope"];
                }
                
                if (jobs.Any(jp => jp.Status == JobPostStatus.WaitingForUserReview))
                {
                    return Loc["Status_WaitingForUserReview"];
                }
            }
        }

        return Loc[$"Status_{project.Status}"];
    }

    private bool ShouldShowConsultationBadge(BuildSmart.SharedUI.GraphQL.IProjectDetails project)
    {
        if (project.Status != ProjectStatus.UnderReview) return false;
        
        var jobs = project.JobPosts;
        if (jobs == null || !jobs.Any()) return true;
        
        return !jobs.Any(jp => 
            jp.Status == JobPostStatus.WaitingForUserReview || 
            jp.Status == JobPostStatus.Draft || 
            jp.Status == JobPostStatus.GeneratingScope);
    }

    private void HandleProjectClick(BuildSmart.SharedUI.GraphQL.IProjectDetails project)
    {
        if (project.Status == BuildSmart.SharedUI.GraphQL.ProjectStatus.Draft)
        {
            ViewModel.GoToDetailsCommand.Execute(project);
        }
        else
        {
            NavManager.NavigateTo($"/project-detail?projectId={project.Id}");
        }
    }

    public void Dispose()
    {
        SignalRService.NotificationReceived -= OnNotificationReceived;
        SignalRService.NotificationsStateChanged -= OnNotificationsStateChanged;
        ViewModel.Dispose();
    }
}
