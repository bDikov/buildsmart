@code {
    private bool isBulgarian = true;
    private bool _showCaptchaModal = false;
    private string _honeypot = string.Empty;
    private int _captchaNum1;
    private int _captchaNum2;
    private string _captchaAnswerInput = string.Empty;
    private string? _captchaError;

    [Parameter]
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    protected override void OnInitialized()
    {
        var currentCultureName = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
        isBulgarian = currentCultureName.Equals("bg", StringComparison.OrdinalIgnoreCase);
    }

    private void SetLanguage(bool bulgarian)
    {
        isBulgarian = bulgarian;
    }

    private async Task GoBack()
    {
        var fallback = string.IsNullOrEmpty(ReturnUrl) ? "/" : ReturnUrl;
        await JSRuntime.InvokeVoidAsync("eval", $@"
            (function() {{
                var originalPath = window.location.pathname;
                var hasBack = window.history.length > 1;
                if (hasBack) {{
                    window.history.back();
                    setTimeout(function() {{
                        if (window.location.pathname === originalPath) {{
                            window.location.href = '{fallback}';
                        }}
                    }}, 150);
                }} else {{
                    window.location.href = '{fallback}';
                }}
            }})()
        ");
    }

    private void GenerateCaptcha()
    {
        var rand = new Random();
        _captchaNum1 = rand.Next(1, 10);
        _captchaNum2 = rand.Next(1, 10);
        _captchaAnswerInput = string.Empty;
        _captchaError = null;
    }

    private void TriggerStartChat()
    {
        if (!string.IsNullOrEmpty(_honeypot))
        {
            // Honeypot triggered, silently discard
            return;
        }

        GenerateCaptcha();
        _showCaptchaModal = true;
        StateHasChanged();
    }

    private async Task VerifyAndStartChat()
    {
        if (!int.TryParse(_captchaAnswerInput, out var userAnswer) || userAnswer != (_captchaNum1 + _captchaNum2))
        {
            _captchaError = isBulgarian ? "Невалиден отговор. Моля, опитайте отново." : "Incorrect answer. Please try again.";
            GenerateCaptcha();
            return;
        }

        _showCaptchaModal = false;
        await StartChat();
    }

    private async Task OnCaptchaKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await VerifyAndStartChat();
        }
    }

    private bool _isStartingChat = false;

    private async Task StartChat()
    {
        if (_isStartingChat) return;
        _isStartingChat = true;
        StateHasChanged();

        try
        {
            var result = await ApiClient.StartAnonymousSupportChat.ExecuteAsync();
            if (result.Errors.Count == 0 && result.Data?.StartAnonymousSupportChat != null)
            {
                var payload = result.Data.StartAnonymousSupportChat;
                await AuthService.SaveTokenAsync(payload.Token);
                NavManager.NavigateTo($"/project-messages?projectId={payload.ProjectId}", forceLoad: true);
            }
            else
            {
                var error = result.Errors.FirstOrDefault()?.Message ?? "Failed to start support chat.";
                Console.WriteLine($"[PrivacyPolicy] Error starting chat: {error}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[PrivacyPolicy] Exception starting chat: {ex.Message}");
        }
        finally
        {
            _isStartingChat = false;
            StateHasChanged();
        }
    }
}
