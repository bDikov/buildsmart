    private Dictionary<string, (decimal min, decimal max)> GetCategoryProcessPrices(int catId)
    {
        var procs = GetCategoryProcesses(catId);
        var catBudget = GetCategoryBudget(catId);
        var result = new Dictionary<string, (decimal min, decimal max)>(procs.Count);

        decimal runningMin = 0;
        decimal runningMax = 0;
        for (int i = 0; i < procs.Count; i++)
        {
            var p = procs[i];
            if (i == procs.Count - 1)
            {
                result[p.Id] = (catBudget.min - runningMin, catBudget.max - runningMax);
            }
            else
            {
                decimal pMin = Math.Round(catBudget.min * p.Weight, 0);
                decimal pMax = Math.Round(catBudget.max * p.Weight, 0);
                runningMin += pMin;
                runningMax += pMax;
                result[p.Id] = (pMin, pMax);
            }
        }
        return result;
    }

    private (decimal min, decimal max) GetCategoryActiveBudget(int catId)
    {
        var prices = GetCategoryProcessPrices(catId);
        decimal activeMin = 0;
        decimal activeMax = 0;
        foreach (var kvp in prices)
        {
            if (!_excludedProcessIds.Contains(kvp.Key))
            {
                activeMin += kvp.Value.min;
                activeMax += kvp.Value.max;
            }
        }
        return (activeMin, activeMax);
    }

    private bool IsCategoryFullyIncluded(int catId)
    {
        var procs = GetCategoryProcesses(catId);
        if (!procs.Any()) return true;
        return procs.All(p => !_excludedProcessIds.Contains(p.Id));
    }

    private bool IsCategoryPartiallyIncluded(int catId)
    {
        var procs = GetCategoryProcesses(catId);
        if (!procs.Any()) return true;
        return procs.Any(p => !_excludedProcessIds.Contains(p.Id));
    }

    private async Task ToggleCategoryInclusionAsync(int catId)
    {
        var procs = GetCategoryProcesses(catId);
        bool allIncluded = procs.All(p => !_excludedProcessIds.Contains(p.Id));

        if (allIncluded)
        {
            foreach (var p in procs)
            {
                _excludedProcessIds.Add(p.Id);
            }
            if (catId == 9) _includeFurniture = false;
        }
        else
        {
            foreach (var p in procs)
            {
                _excludedProcessIds.Remove(p.Id);
            }
            if (catId == 9) _includeFurniture = true;
        }

        StateHasChanged();
        await UpdateLeadInDatabaseAsync();
    }

    private async Task ToggleProcessInclusionAsync(string processId, int catId)
    {
        if (_excludedProcessIds.Contains(processId))
        {
            _excludedProcessIds.Remove(processId);
            if (catId == 9) _includeFurniture = true;
        }
        else
        {
            _excludedProcessIds.Add(processId);
            if (catId == 9 && !IsCategoryPartiallyIncluded(9))
            {
                _includeFurniture = false;
            }
        }

        StateHasChanged();
        await UpdateLeadInDatabaseAsync();
    }

    private async Task UpdateLeadInDatabaseAsync()
    {
        if (_savedLead == null) return;

        try
        {
            decimal minEur = GetMinPriceEur();
            decimal maxEur = GetMaxPriceEur();
            decimal initMinEur = GetInitialMinEur();
            decimal initMaxEur = GetInitialMaxEur();

            _savedLead.MinPriceEur = minEur;
            _savedLead.MaxPriceEur = maxEur;
            _savedLead.MinPriceBgn = Math.Round(minEur * 1.95583m, 0);
            _savedLead.MaxPriceBgn = Math.Round(maxEur * 1.95583m, 0);
            _savedLead.IncludeFurniture = _includeFurniture && IsCategoryPartiallyIncluded(9);

            var excludedList = new List<string>();
            for (int c = 1; c <= 10; c++)
            {
                if (c == 9 && !_includeFurniture) continue;
                var procs = GetCategoryProcesses(c);
                var catExcluded = procs.Where(p => _excludedProcessIds.Contains(p.Id)).ToList();
                if (catExcluded.Count == procs.Count)
                {
                    excludedList.Add($"Всички пера от {GetCategoryName(c)}");
                }
                else if (catExcluded.Any())
                {
                    var procTitles = catExcluded.Select(p => GetProcessTitle(p));
                    excludedList.Add($"{GetCategoryName(c)}: [{string.Join(", ", procTitles)}]");
                }
            }

            string summaryText;
            if (excludedList.Any())
            {
                summaryText = $"[Клиентът коригира офертата]: Изключени пера: {string.Join(" | ", excludedList)}. Актуализирана стойност: €{minEur:N0} – €{maxEur:N0} ({Math.Round(minEur * 1.95583m, 0):N0} – {Math.Round(maxEur * 1.95583m, 0):N0} лв.)";
            }
            else
            {
                summaryText = $"[Клиентът включи всички пера]. Актуализирана стойност: €{minEur:N0} – €{maxEur:N0} ({Math.Round(minEur * 1.95583m, 0):N0} – {Math.Round(maxEur * 1.95583m, 0):N0} лв.)";
            }

            string existingCrmNotes = ExtractCrmNotes(_savedLead.AdminNotes);

            var configObj = new
            {
                excludedProcessIds = _excludedProcessIds.ToList(),
                initialMinEur = initMinEur,
                initialMaxEur = initMaxEur,
                customizedMinEur = minEur,
                customizedMaxEur = maxEur,
                savedMinEur = Math.Max(0, initMinEur - minEur),
                savedMaxEur = Math.Max(0, initMaxEur - maxEur),
                updatedAt = DateTime.UtcNow
            };

            var jsonConfig = System.Text.Json.JsonSerializer.Serialize(configObj);

            _savedLead.AdminNotes = $"[CONFIG]:{jsonConfig}\n[SUMMARY]:{summaryText}" +
                (string.IsNullOrWhiteSpace(existingCrmNotes) ? "" : $"\n[CRM_NOTES]:\n{existingCrmNotes}");

            await LeadRepository.UpdateLeadAsync(_savedLead);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating CalculatorLead: {ex.Message}");
        }
    }

    private decimal GetInitialMinEur()
    {
        if (_activeScope == "bathroom")
        {
            decimal total = 0;
            for (int i = 0; i < _bathroomCount; i++)
            {
                total += GetSingleBathroomPriceEur(i, isMax: false);
            }
            return total;
        }

        decimal totalMin = 0;
        for (int catId = 1; catId <= 10; catId++)
        {
            if (catId == 9 && !_includeFurniture) continue;
            totalMin += GetCategoryBudget(catId).min;
        }
        return totalMin;
    }

    private decimal GetInitialMaxEur()
    {
        if (_activeScope == "bathroom")
        {
            decimal total = 0;
            for (int i = 0; i < _bathroomCount; i++)
            {
                total += GetSingleBathroomPriceEur(i, isMax: true);
            }
            return total;
        }

        decimal totalMax = 0;
        for (int catId = 1; catId <= 10; catId++)
        {
            if (catId == 9 && !_includeFurniture) continue;
            totalMax += GetCategoryBudget(catId).max;
        }
        return totalMax;
    }

    private static string ExtractCrmNotes(string? adminNotes)
    {
        if (string.IsNullOrWhiteSpace(adminNotes)) return string.Empty;
        var marker = "[CRM_NOTES]:";
        var idx = adminNotes.IndexOf(marker, StringComparison.OrdinalIgnoreCase);
        if (idx >= 0)
        {
            return adminNotes.Substring(idx + marker.Length).Trim();
        }
        if (adminNotes.StartsWith("[CONFIG]:") || adminNotes.StartsWith("[SUMMARY]:") || adminNotes.StartsWith("[Клиентът"))
        {
            return string.Empty;
        }
        return adminNotes.Trim();
    }

