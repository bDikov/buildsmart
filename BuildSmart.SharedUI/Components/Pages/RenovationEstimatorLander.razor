@code {
    [SupplyParameterFromQuery(Name = "scope")]
    public string? QueryScope { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? QueryStatus { get; set; }

    [SupplyParameterFromQuery(Name = "area")]
    public int? QueryArea { get; set; }

    [SupplyParameterFromQuery(Name = "hideTabs")]
    public bool? QueryHideTabs { get; set; }

    [SupplyParameterFromQuery(Name = "tier")]
    public string? QueryTier { get; set; }

    [SupplyParameterFromQuery(Name = "bathrooms")]
    public int? QueryBathrooms { get; set; }

    [SupplyParameterFromQuery(Name = "proposalReady")]
    public bool? QueryProposalReady { get; set; }

    [SupplyParameterFromQuery(Name = "leadSubmitted")]
    public bool? QueryLeadSubmitted { get; set; }

    [SupplyParameterFromQuery(Name = "excluded")]
    public string? QueryExcluded { get; set; }

    [SupplyParameterFromQuery(Name = "utm_source")]
    public string? UtmSource { get; set; }

    [SupplyParameterFromQuery(Name = "utm_medium")]
    public string? UtmMedium { get; set; }

    [SupplyParameterFromQuery(Name = "utm_campaign")]
    public string? UtmCampaign { get; set; }

    [SupplyParameterFromQuery(Name = "utm_term")]
    public string? UtmTerm { get; set; }

    [SupplyParameterFromQuery(Name = "utm_content")]
    public string? UtmContent { get; set; }

    private string _activeScope = "full"; // full, bathroom, finishing
    private int _selectedArea = 75;
    private bool _includeFurniture = true;
    private bool _includeEquipment = true;
    private string _buildingStatus = "bds"; // bds, rough, old
    private string _finishQualityTier = "premium"; // standard, premium, luxury

    // Bathroom Scope Variables
    private int _bathroomCount = 1;
    private int[] _bathroomSizes = new int[] { 5, 4, 3 };

    private bool _isProcessingModalOpen = false;
    private int _processingStep = 1;
    private bool _isLeadModalOpen = false;
    private bool _isProposalReady = false;
    private bool _isPhoneCopied = false;

    private void HandleGoogleSocialAccess()
    {
        var returnDest = $"/renovation-estimator?scope={_activeScope}&area={_selectedArea}&status={_buildingStatus}&tier={_finishQualityTier}&bathrooms={_bathroomCount}&proposalReady=true";
        var returnUrl = Uri.EscapeDataString(returnDest);
        NavManager.NavigateTo($"/create-account?ReturnUrl={returnUrl}");
    }

    private void HandleFacebookSocialAccess()
    {
        var returnDest = $"/renovation-estimator?scope={_activeScope}&area={_selectedArea}&status={_buildingStatus}&tier={_finishQualityTier}&bathrooms={_bathroomCount}&proposalReady=true";
        var returnUrl = Uri.EscapeDataString(returnDest);
        NavManager.NavigateTo($"/create-account?ReturnUrl={returnUrl}");
    }

    private async Task CopyPhoneToClipboard()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", "+359 888 888 888");
        }
        catch { }

        _isPhoneCopied = true;
        StateHasChanged();

        await Task.Delay(3500);
        _isPhoneCopied = false;
        StateHasChanged();
    }

    // Field-level validation states
    private bool _isSubmitted = false;
    private bool _isEmailInvalid => string.IsNullOrWhiteSpace(_email) || !IsValidEmail(_email);
    private bool _isPhoneInvalid => !_phoneValidation.IsValid;
    private bool _isNameInvalid => string.IsNullOrWhiteSpace(_name) || _name.Trim().Length < 2;

    private string _email = string.Empty;
    private string _phone = string.Empty;
    private PhoneValidationResult _phoneValidation = BulgarianPhoneValidator.Evaluate(string.Empty);
    private string _name = string.Empty;

    private void OnPhoneInputChanged(ChangeEventArgs e)
    {
        _phone = e.Value?.ToString() ?? string.Empty;
        _phoneValidation = BulgarianPhoneValidator.Evaluate(_phone);
    }

    private string GetPhoneStatusStyle()
    {
        return _phoneValidation.Severity switch
        {
            PhoneFeedbackSeverity.Success => "color: var(--color-success); font-weight: 600;",
            PhoneFeedbackSeverity.Warning => "color: var(--color-warning, #f59e0b); font-weight: 500;",
            PhoneFeedbackSeverity.Danger => "color: var(--color-danger); font-weight: 500;",
            PhoneFeedbackSeverity.Info => "color: var(--text-muted); font-weight: 500;",
            _ => "color: var(--text-muted);"
        };
    }

    private string GetPhoneStatusText()
    {
        return _phoneValidation.ErrorCode switch
        {
            PhoneErrorCode.MissingDigits => _phoneValidation.DigitsDelta == -1
                ? Loc["Lander_Phone_MissingOneDigit"].Value
                : string.Format(Loc["Lander_Phone_MissingDigits"].Value, -_phoneValidation.DigitsDelta, _phoneValidation.DigitCount),
            PhoneErrorCode.ExtraDigits => _phoneValidation.DigitsDelta == 1
                ? Loc["Lander_Phone_ExtraOneDigit"].Value
                : string.Format(Loc["Lander_Phone_ExtraDigits"].Value, _phoneValidation.DigitsDelta, _phoneValidation.DigitCount),
            PhoneErrorCode.InvalidPrefix => Loc["Lander_Phone_InvalidPrefix"].Value,
            PhoneErrorCode.DummySequence => Loc["Lander_Phone_DummySequence"].Value,
            PhoneErrorCode.DummyRepetition => Loc["Lander_Phone_DummyRepetition"].Value,
            PhoneErrorCode.LowEntropy => Loc["Lander_Phone_DummyLowEntropy"].Value,
            PhoneErrorCode.InvalidCharacters => Loc["Lander_Phone_InvalidChars"].Value,
            PhoneErrorCode.None when _phoneValidation.IsValid => Loc["Lander_Phone_Valid"].Value,
            _ => Loc["Lander_PhoneError"].Value
        };
    }

    private HashSet<int> _expandedCategories = new HashSet<int> { 1, 2 };
    private HashSet<string> _excludedProcessIds = new HashSet<string>();
    private BuildSmart.Core.Domain.Entities.CalculatorLead? _savedLead;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(QueryScope))
        {
            var s = QueryScope.ToLower();
            if (s == "bathroom")
            {
                _activeScope = "bathroom";
            }
            else if (s == "finishing")
            {
                _activeScope = "full";
                _includeFurniture = false;
            }
            else
            {
                _activeScope = "full";
                _includeFurniture = true;
            }
        }

        if (!string.IsNullOrWhiteSpace(QueryStatus))
        {
            var st = QueryStatus.ToLower();
            if (st == "bds" || st == "rough" || st == "old")
            {
                _buildingStatus = st;
            }
        }

        if (QueryArea.HasValue && QueryArea.Value >= 20 && QueryArea.Value <= 300)
        {
            _selectedArea = QueryArea.Value;
        }

        if (!string.IsNullOrWhiteSpace(QueryTier))
        {
            var t = QueryTier.ToLower();
            if (t == "standard" || t == "premium" || t == "luxury")
            {
                _finishQualityTier = t;
            }
        }

        if (QueryBathrooms.HasValue && QueryBathrooms.Value >= 1 && QueryBathrooms.Value <= 5)
        {
            _bathroomCount = QueryBathrooms.Value;
        }

        if (QueryProposalReady == true || QueryLeadSubmitted == true)
        {
            _isProposalReady = true;
        }

        if (!string.IsNullOrWhiteSpace(QueryExcluded))
        {
            var ids = QueryExcluded.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            _excludedProcessIds.Clear();
            foreach (var id in ids)
            {
                _excludedProcessIds.Add(id);
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await EnsureAttributionHydratedAsync();
        }
    }

    private async Task EnsureAttributionHydratedAsync()
    {
        try
        {
            var utms = await JSRuntime.InvokeAsync<Dictionary<string, string>>("getSavedUtms");
            if (utms != null)
            {
                if (string.IsNullOrWhiteSpace(UtmSource) && utms.TryGetValue("utm_source", out var src))
                {
                    UtmSource = src;
                }
                if (string.IsNullOrWhiteSpace(UtmMedium) && utms.TryGetValue("utm_medium", out var med))
                {
                    UtmMedium = med;
                }
                if (string.IsNullOrWhiteSpace(UtmCampaign) && utms.TryGetValue("utm_campaign", out var cmp))
                {
                    UtmCampaign = cmp;
                }
                if (string.IsNullOrWhiteSpace(UtmTerm) && utms.TryGetValue("utm_term", out var trm))
                {
                    UtmTerm = trm;
                }
                if (string.IsNullOrWhiteSpace(UtmContent) && utms.TryGetValue("utm_content", out var cnt))
                {
                    UtmContent = cnt;
                }
            }
        }
        catch { }
    }

    private void ToggleCategory(int catId)
    {
        if (_expandedCategories.Contains(catId))
        {
            _expandedCategories.Remove(catId);
        }
        else
        {
            _expandedCategories.Add(catId);
        }
    }

    private int GetTotalBathroomArea()
    {
        int sum = 0;
        for (int i = 0; i < _bathroomCount; i++)
        {
            sum += _bathroomSizes[i];
        }
        return sum;
    }

    private string GetProjectTitle()
    {
        if (_activeScope == "bathroom")
        {
            return string.Format(Loc["Lander_DynamicTitle_Bathroom"], _bathroomCount);
        }
        return string.Format(Loc["Lander_DynamicTitle_Full"], _selectedArea);
    }

    private string GetStatusLabel()
    {
        if (_buildingStatus == "old") return Loc["Lander_Status_Old"];
        if (_buildingStatus == "rough") return Loc["Lander_Status_Rough"];
        return Loc["Lander_Status_Bds"];
    }

    private int GetCategoryCount()
    {
        if (_activeScope == "bathroom") return _bathroomCount;
        int count = 0;
        for (int i = 1; i <= 10; i++)
        {
            if (i == 9 && !_includeFurniture) continue;
            if (IsCategoryPartiallyIncluded(i)) count++;
        }
        return count;
    }

    private void SetScope(string scope)
    {
        if (scope == "finishing")
        {
            _activeScope = "full";
            _includeFurniture = false;
        }
        else
        {
            _activeScope = scope;
            if (scope == "full")
            {
                _includeFurniture = true;
            }
        }
    }

    private decimal GetSingleBathroomPriceEur(int index, bool isMax)
    {
        if (index < 0 || index >= _bathroomSizes.Length) return 0;
        int area = _bathroomSizes[index];
        return EstimatorCalculator.GetSingleBathroomPriceEur(area, isMax, _buildingStatus, _finishQualityTier, _includeEquipment);
    }

    private (decimal min, decimal max) GetCategoryBudget(int catId)
    {
        return EstimatorCalculator.GetCategoryBudget(catId, _selectedArea, _buildingStatus, _finishQualityTier, _includeFurniture);
    }

    private string GetCategoryName(int catId) => catId switch
    {
        1 => Loc["Lander_Trade_Bathroom"],
        2 => Loc["Lander_Trade_Plaster"],
        3 => Loc["Lander_Trade_Painting"],
        4 => Loc["Lander_Trade_Drywall"],
        5 => Loc["Lander_Trade_Flooring"],
        6 => Loc["Lander_Trade_Electrical"],
        7 => Loc["Lander_Trade_Plumbing_Kitchen"],
        8 => Loc["Lander_Trade_Doors"],
        9 => Loc["Lander_Trade_Furniture"],
        10 => Loc["Lander_Trade_Logistics"],
        _ => $"СМР #{catId}"
    };

    private record ProcessDef(
        string Id,
        int CatId,
        string TitleKey,
        string Subtitle,
        string BadgeClass,
        string BadgeKey,
        decimal Weight
    );

    private string GetProcessTitle(ProcessDef proc)
    {
        if (proc.Id == "cat10_p2")
        {
            return _buildingStatus == "old"
                ? Loc["Lander_Full_Item_DemolitionLogistics"]
                : Loc["Lander_Full_Item_Logistics"];
        }
        return Loc[proc.TitleKey];
    }

