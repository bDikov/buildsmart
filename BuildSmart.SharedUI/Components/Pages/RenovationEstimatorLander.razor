    private bool IsValidEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email)) return false;
        return Regex.IsMatch(email, @"^[^@\s]+@[^@\s]+\.[^@\s]+$", RegexOptions.IgnoreCase);
    }

    private async Task SubmitLeadAndGeneratePdf()
    {
        _isSubmitted = true;
        _emailValidationError = null;
        _phoneValidation = BulgarianPhoneValidator.Evaluate(_phone);

        if (_isEmailInvalid || _isPhoneInvalid || _isNameInvalid)
        {
            return;
        }

        _isVerifyingEmail = true;
        StateHasChanged();

        EmailVerificationResult verificationResult;
        try
        {
            verificationResult = await EmailVerificationService.VerifyEmailAsync(_email);
        }
        catch
        {
            verificationResult = new EmailVerificationResult { IsValid = true, Status = "Valid" };
        }
        _isVerifyingEmail = false;

        bool isVerified = verificationResult.IsValid;
        string verificationStatus = verificationResult.Status ?? (isVerified ? "Valid" : "Unverified");
        string? verificationReason = verificationResult.ErrorMessage;

        if (!verificationResult.IsValid)
        {
            _emailValidationError = verificationResult.ErrorMessage ?? "Моля, въведете реален имейл адрес.";
            
            try
            {
                await JSRuntime.InvokeVoidAsync("posthog.capture", "estimator_email_verification_failed", new
                {
                    email_domain = _email.Contains('@') ? _email.Split('@')[1] : "",
                    reason = verificationResult.Status
                });
            }
            catch { }
        }

        // Ensure Attribution is Hydrated from Stored State (Facebook Ads, UTMs, etc.)
        await EnsureAttributionHydratedAsync();

        // Save CalculatorLead to Database
        decimal minEur = GetMinPriceEur();
        decimal maxEur = GetMaxPriceEur();
        decimal minBgn = Math.Round(minEur * 1.95583m, 0);
        decimal maxBgn = Math.Round(maxEur * 1.95583m, 0);

        decimal initMinEur = GetInitialMinEur();
        decimal initMaxEur = GetInitialMaxEur();
        var initialConfigObj = new
        {
            excludedProcessIds = _excludedProcessIds.ToList(),
            initialMinEur = initMinEur,
            initialMaxEur = initMaxEur,
            customizedMinEur = minEur,
            customizedMaxEur = maxEur,
            savedMinEur = Math.Max(0, initMinEur - minEur),
            savedMaxEur = Math.Max(0, initMaxEur - maxEur),
            updatedAt = DateTime.UtcNow
        };
        string initialConfigJson = System.Text.Json.JsonSerializer.Serialize(initialConfigObj);
        string initialSummary = _excludedProcessIds.Any()
            ? $"[Първоначална персонализирана оферта]: Изключени пера ({_excludedProcessIds.Count}). Стойност: €{minEur:N0} – €{maxEur:N0}"
            : $"[Първоначална оферта]: Пълен обхват €{minEur:N0} – €{maxEur:N0}";

        var lead = new BuildSmart.Core.Domain.Entities.CalculatorLead
        {
            Email = _email.Trim(),
            Phone = _phoneValidation.IsValid ? _phoneValidation.FormattedDisplay : (string.IsNullOrWhiteSpace(_phone) ? null : _phone.Trim()),
            Name = string.IsNullOrWhiteSpace(_name) ? null : _name.Trim(),
            Scope = string.IsNullOrWhiteSpace(_activeScope) ? "full" : _activeScope,
            SelectedArea = _selectedArea,
            BuildingStatus = _buildingStatus,
            QualityTier = _finishQualityTier,
            IncludeFurniture = _includeFurniture,
            IncludeEquipment = _includeEquipment,
            BathroomCount = _bathroomCount,
            MinPriceEur = minEur,
            MaxPriceEur = maxEur,
            MinPriceBgn = minBgn,
            MaxPriceBgn = maxBgn,
            EstimatedDays = GetEstimatedDays(),
            IsEmailVerified = isVerified,
            VerificationStatus = verificationStatus,
            VerificationReason = verificationReason,
            AdminNotes = $"[CONFIG]:{initialConfigJson}\n[SUMMARY]:{initialSummary}",
            UtmSource = UtmSource,
            UtmMedium = UtmMedium,
            UtmCampaign = UtmCampaign,
            UtmTerm = UtmTerm,
            UtmContent = UtmContent,
            CreatedAt = DateTime.UtcNow
        };

        try
        {
            await LeadRepository.AddLeadAsync(lead);
            _savedLead = lead;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving CalculatorLead: {ex.Message}");
        }

        // Fire-and-forget email offer & Telegram lead alert dispatch
        _ = Task.Run(async () =>
        {
            try
            {
                await EmailService.SendCalculatorLeadOfferEmailAsync(lead);
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"Error sending lead offer email: {ex.Message}");
            }

            try
            {
                var telegramService = (BuildSmart.Core.Application.Interfaces.ITelegramBotService?)ServiceProvider.GetService(typeof(BuildSmart.Core.Application.Interfaces.ITelegramBotService));
                if (telegramService != null)
                {
                    var scopeName = lead.Scope == "bathroom" ? "Ремонт на баня" : "Цялостен ремонт на апартамент";
                    var summary = $"Ориентировъчен бюджет: €{lead.MinPriceEur:N0} – €{lead.MaxPriceEur:N0} ({lead.MinPriceBgn:N0} – {lead.MaxPriceBgn:N0} лв.)\nПлощ: {lead.SelectedArea} кв.м, Състояние: {lead.BuildingStatus}, Пакет: {lead.QualityTier}\nИзточник: {lead.UtmSource ?? "Директен"}";

                    await telegramService.SendLeadAlertAsync(
                        projectId: lead.Id,
                        projectTitle: $"Калкулатор: {scopeName} ({lead.SelectedArea} м²)",
                        homeownerName: lead.Name,
                        homeownerPhone: lead.Phone,
                        homeownerEmail: lead.Email,
                        location: "София",
                        aiSummary: summary
                    );
                }
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"Error sending telegram lead alert: {ex.Message}");
            }
        });

        _isLeadModalOpen = false;

        // Start background processing calculation sequence
        _isProcessingModalOpen = true;
        _processingStep = 1;
        StateHasChanged();

        await Task.Delay(600);
        _processingStep = 2;
        StateHasChanged();

        await Task.Delay(600);
        _processingStep = 3;
        StateHasChanged();

        await Task.Delay(600);
        _isProcessingModalOpen = false;
        _isProposalReady = true;
        StateHasChanged();

        try
        {
            await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", "lead_email", _email);
            await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", "lead_phone", _phone);
            await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", "lead_name", _name);

            // Construct conversion URL with parameters to reflect the completed state in address bar for Facebook Pixel & Ads URL-based tracking
            var queryParams = new List<string>();
            queryParams.Add($"scope={Uri.EscapeDataString(_activeScope)}");
            queryParams.Add($"area={_selectedArea}");
            queryParams.Add($"status={Uri.EscapeDataString(_buildingStatus)}");
            queryParams.Add($"tier={Uri.EscapeDataString(_finishQualityTier)}");
            if (_activeScope == "bathroom")
            {
                queryParams.Add($"bathrooms={_bathroomCount}");
            }
            queryParams.Add("proposalReady=true");
            queryParams.Add("leadSubmitted=true");

            if (!string.IsNullOrEmpty(UtmSource)) queryParams.Add($"utm_source={Uri.EscapeDataString(UtmSource)}");
            if (!string.IsNullOrEmpty(UtmMedium)) queryParams.Add($"utm_medium={Uri.EscapeDataString(UtmMedium)}");
            if (!string.IsNullOrEmpty(UtmCampaign)) queryParams.Add($"utm_campaign={Uri.EscapeDataString(UtmCampaign)}");
            if (!string.IsNullOrEmpty(UtmTerm)) queryParams.Add($"utm_term={Uri.EscapeDataString(UtmTerm)}");
            if (!string.IsNullOrEmpty(UtmContent)) queryParams.Add($"utm_content={Uri.EscapeDataString(UtmContent)}");

            var currentUri = new Uri(NavManager.Uri);
            var conversionUrl = $"{currentUri.AbsolutePath}?{string.Join("&", queryParams)}";

            var leadPayload = new
            {
                lead_id = lead.Id,
                email = _email,
                phone = _phone,
                name = _name,
                scope = _activeScope,
                area = _selectedArea,
                building_status = _buildingStatus,
                finish_tier = _finishQualityTier,
                price_min_eur = minEur,
                price_max_eur = maxEur,
                utm_source = UtmSource,
                utm_campaign = UtmCampaign,
                utm_medium = UtmMedium,
                conversion_url = conversionUrl
            };

            // Triggers window.trackLeadConversion which updates address bar URL, fires FB Pixel 'Lead' & custom events, GTM dataLayer, and PostHog
            await JSRuntime.InvokeVoidAsync("trackLeadConversion", conversionUrl, leadPayload);
        }
        catch { }
    }

    private bool _showAuthModal = false;

    private async Task ProceedToWizard()
    {
        bool isGuest = await CheckIsGuestAsync();
        if (AuthService != null && (!AuthService.IsAuthenticated || isGuest))
        {
            _showAuthModal = true;
            StateHasChanged();
        }
        else
        {
            await NavigateToWizardInternal();
        }
    }

    private void OnAuthConfirmationChanged(bool proceed)
    {
        _showAuthModal = false;
        if (proceed)
        {
            string targetUrl = "/job-wizard";
            var returnUrl = Uri.EscapeDataString(targetUrl);
            NavManager.NavigateTo($"/create-account?ReturnUrl={returnUrl}");
        }
    }

    private async Task NavigateToWizardInternal()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", "quick_estimator_scope", _activeScope);
            await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", "quick_estimator_area", _selectedArea.ToString());
            await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", "quick_estimator_status", _buildingStatus);
        }
        catch { }

        NavManager.NavigateTo("/job-wizard");
    }

    private async Task<bool> CheckIsGuestAsync()
    {
        try
        {
            if (AuthService == null) return false;
            var token = await AuthService.GetTokenAsync();
            if (string.IsNullOrEmpty(token)) return false;
            var handler = new System.IdentityModel.Tokens.Jwt.JwtSecurityTokenHandler();
            var jwtToken = handler.ReadJwtToken(token);
            var email = jwtToken.Claims.FirstOrDefault(c =>
                c.Type == "email" ||
                c.Type == "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress")?.Value;
            return email != null && email.EndsWith("@buildsmart.guest", StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            return false;
        }
    }
}
