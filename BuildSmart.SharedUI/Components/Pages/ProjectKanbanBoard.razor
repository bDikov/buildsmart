@page "/projects/{Id:guid}/kanban"
@page "/projects/{Id:guid}/board"
@using BuildSmart.Core.Application.DTOs
@using BuildSmart.Core.Domain.Enums
@using BuildSmart.SharedUI.Services
@using TaskStatus = BuildSmart.Core.Domain.Enums.TaskStatus
@inject BuildSmart.Core.Application.Interfaces.IProjectManagementService ProjectService
@inject BuildSmart.SharedUI.Services.IAuthService AuthService
@inject BuildSmart.SharedUI.Services.IAlertService AlertService
@inject BuildSmart.SharedUI.Services.IAdminPerspectiveService AdminPerspectiveService
@inject NavigationManager NavigationManager
@implements IDisposable

<div class="kanban-page-container">
    @if (IsLoading)
    {
        <div class="loading-state">
            <div class="spinner-border text-primary" role="status"></div>
            <p>Loading project workspace...</p>
        </div>
    }
    else if (BoardData == null)
    {
        <div class="error-state">
            <h3>Project Workspace Not Found</h3>
            <button class="btn-secondary" @onclick="GoBack">Back to Projects</button>
        </div>
    }
    else
    {
        <!-- Page Header & Workspace Nav -->
        <div class="page-header">
            <div class="header-main">
                <span class="project-badge">Project Workspace</span>
                <h1 class="project-title">@BoardData.ProjectTitle</h1>
                <p class="homeowner-subtitle">Homeowner: <strong>@BoardData.HomeownerName</strong></p>
            </div>

            <div class="header-actions d-flex align-items-center gap-3 flex-wrap">
                @if (IsAdminUser)
                {
                    <AdminDashboardSwitch />
                }

                <div class="project-status-box d-flex align-items-center gap-2 flex-wrap">
                    <div class="d-inline-flex align-items-center gap-1">
                        <span class="status-label">Project Status:</span>
                        <span class="status-pill status-@BoardData.ProjectStatus.ToString().ToLower()">@BoardData.ProjectStatus</span>
                        @if (CurrentUserRole == UserRoleTypes.Admin)
                        {
                            <button type="button" class="bs-pencil-edit-btn ms-1" @onclick="ToggleEditStatus" title="Edit Status">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 20h9"></path>
                                    <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                                </svg>
                            </button>

                            @if (_isEditingStatus)
                            {
                                <select class="status-select ms-2 bs-select-pill" value="@BoardData.ProjectStatus.ToString()" @onchange="PromptAdminStatusChange">
                                    <option value="Draft">Draft/Preview</option>
                                    <option value="UnderReview">Under Review</option>
                                    <option value="Active">Active</option>
                                    <option value="Completed">Completed</option>
                                    <option value="Archived">Archived</option>
                                </select>
                            }
                        }
                    </div>

                    @if (CurrentUserRole == UserRoleTypes.Admin)
                    {
                        <div class="markup-box ms-3 d-inline-flex align-items-center gap-1">
                            <span class="status-label me-1">Markup:</span>
                            <span class="status-pill" style="background: rgba(59, 130, 246, 0.12); color: var(--color-primary, #3b82f6); border: 1px solid rgba(59, 130, 246, 0.25); font-weight: 700; padding: 4px 10px; border-radius: 20px;">
                                @((BoardData.AdminMarkupPercentage).ToString("0.##"))%
                            </span>

                            <button type="button" class="bs-pencil-edit-btn ms-1" @onclick="ToggleEditMarkup" title="Edit Markup">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 20h9"></path>
                                    <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                                </svg>
                            </button>

                            @if (_isEditingMarkup)
                            {
                                <div class="d-inline-flex align-items-center ms-1">
                                    <input type="number" class="markup-input bs-select-pill" style="width: 75px; text-align: center; font-weight: 600;" 
                                           value="@_editingMarkupValue" @onchange="PromptAdminMarkupChange" min="0" max="200" step="1" />
                                    <span class="status-label ms-1">%</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <div class="navigation-tabs">
            <a class="nav-tab active" href="/projects/@Id/kanban">Work Board (Kanban)</a>
            <a class="nav-tab" href="/projects/@Id/payments">Payments & Financials</a>
            <a class="nav-tab" href="/project-detail?projectId=@Id">Scope & PDF Offer</a>
        </div>

        <!-- Admin Tradesman Category Assigner -->
        @if (CurrentUserRole == UserRoleTypes.Admin)
        {
            <div class="admin-tools-container">
                <BuildSmart.SharedUI.Components.Pages.Admin.AdminTradesmanAssigner
                    ProjectId="Id"
                    AdminUserId="CurrentUserId"
                    Sections="BoardData.CategorySections"
                    OnAssignmentsChanged="RefreshBoard" />
            </div>
        }

        <!-- Board View & Sort Controls Bar -->
        <div class="kanban-controls-bar d-flex align-items-center justify-content-between flex-wrap mb-3 gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="status-label fw-bold">View Layout:</span>
                <button class="bs-btn-sm @(BoardViewMode == "horizontal" ? "bs-btn-primary" : "bs-btn-secondary")" @onclick='() => BoardViewMode = "horizontal"'>
                    &#8596; Horizontal Swipe
                </button>
                <button class="bs-btn-sm @(BoardViewMode == "vertical" ? "bs-btn-primary" : "bs-btn-secondary")" @onclick='() => BoardViewMode = "vertical"'>
                    &#8597; Vertical Stack
                </button>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="status-label fw-bold">Sort Tasks:</span>
                <select class="status-select py-1 px-2" style="width: auto; font-size: 0.8rem;" value="@TaskSortOption" @onchange="OnSortOptionChanged">
                    <option value="Sequence">Custom Order (Sequence)</option>
                    <option value="Category">Trade Category (A-Z)</option>
                    <option value="PriceDesc">Price (High to Low)</option>
                    <option value="PriceAsc">Price (Low to High)</option>
                </select>
            </div>
        </div>

        <!-- Task Filters Toolbar -->
        <div class="kanban-filter-card bs-card mb-4 p-3 p-md-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="filter-icon-badge">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                        </svg>
                    </div>
                    <span class="filter-title fw-bold">@Loc["Kanban_FilterTitle"]</span>
                </div>
                
                <div class="d-flex align-items-center gap-2">
                    <span class="filter-count-badge">
                        @string.Format(Loc["Kanban_TaskCountFormat"], GetFilteredTaskCount(), GetTotalTaskCount())
                    </span>
                    @if (HasActiveFilters)
                    {
                        <button type="button" class="bs-btn-dark py-1 px-3 filter-reset-btn" @onclick="ResetFilters">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                                <path d="M3 3v5h5"></path>
                            </svg>
                            @Loc["Kanban_ResetFilters"]
                        </button>
                    }
                </div>
            </div>

            <div class="row g-2 g-md-3">
                <!-- Search Input with inline Icon & Clear Button -->
                <div class="col-12 col-md-5">
                    <div class="filter-input-wrapper">
                        <svg class="filter-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        <input type="text" 
                               class="bs-input filter-input filter-search-input" 
                               placeholder="@Loc["Kanban_SearchPlaceholder"]" 
                               value="@FilterSearchKeyword" 
                               @oninput="OnFilterSearchInput" />
                        @if (!string.IsNullOrEmpty(FilterSearchKeyword))
                        {
                            <button type="button" class="filter-clear-btn" @onclick="ClearSearchFilter" title="Clear search">
                                &times;
                            </button>
                        }
                    </div>
                </div>

                <!-- Trade Category Filter -->
                <div class="col-12 col-sm-6 col-md-3">
                    <div class="filter-select-wrapper">
                        <select class="bs-input filter-input filter-select" 
                                value="@FilterCategory" 
                                @onchange="OnFilterCategoryChange">
                            <option value="ALL">@Loc["Kanban_AllCategories"]</option>
                            @foreach (var cat in GetAvailableCategories())
                            {
                                <option value="@cat">@cat</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Assignee Filter -->
                <div class="col-12 col-sm-6 col-md-4">
                    <div class="filter-select-wrapper">
                        <select class="bs-input filter-input filter-select" 
                                value="@FilterAssignee" 
                                @onchange="OnFilterAssigneeChange">
                            <option value="ALL">@Loc["Kanban_AllAssignees"]</option>
                            <option value="UNASSIGNED">@Loc["Kanban_Unassigned"]</option>
                            @foreach (var tradesman in GetAvailableAssignees())
                            {
                                <option value="@tradesman">@tradesman</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- Active Filter Tags / Pills -->
            @if (HasActiveFilters)
            {
                <div class="active-filter-tags d-flex align-items-center flex-wrap gap-2 mt-3 pt-2">
                    <span class="active-tags-label text-muted" style="font-size: 0.75rem; font-weight: 600;">Active:</span>
                    
                    @if (!string.IsNullOrWhiteSpace(FilterSearchKeyword))
                    {
                        <span class="filter-pill" @onclick="ClearSearchFilter">
                            Search: "@FilterSearchKeyword"
                            <span class="pill-remove">&times;</span>
                        </span>
                    }

                    @if (FilterCategory != "ALL")
                    {
                        <span class="filter-pill" @onclick="ClearCategoryFilter">
                            Category: @FilterCategory
                            <span class="pill-remove">&times;</span>
                        </span>
                    }

                    @if (FilterAssignee != "ALL")
                    {
                        <span class="filter-pill" @onclick="ClearAssigneeFilter">
                            Assignee: @(FilterAssignee == "UNASSIGNED" ? Loc["Kanban_Unassigned"].ToString() : FilterAssignee)
                            <span class="pill-remove">&times;</span>
                        </span>
                    }
                </div>
            }
        </div>

        <!-- 4 Column Kanban Board -->
        <div class="kanban-board-grid layout-@BoardViewMode">
            <!-- Column 1: To Do -->
            <div class="kanban-column column-todo @(IsDragging && DraggedTask?.Status != TaskStatus.ToDo ? "drop-target-active" : "")"
                 ondragover="event.preventDefault(); if(event.dataTransfer) event.dataTransfer.dropEffect = 'move';"
                 ondragenter="event.preventDefault();"
                 @ondragover:preventDefault="true"
                 @ondragenter:preventDefault="true"
                 @ondrop="() => HandleDropOnColumn(TaskStatus.ToDo)">
                <div class="column-header"
                     ondragover="event.preventDefault(); if(event.dataTransfer) event.dataTransfer.dropEffect = 'move';"
                     ondragenter="event.preventDefault();">
                    <div class="column-header-left">
                        <h3 class="column-title">To Do</h3>
                        @if (CurrentUserRole == UserRoleTypes.Admin)
                        {
                            <button class="btn-add-task-header" title="Create New Task (Admin)" @onclick="() => IsCreateTaskModalOpen = true">
                                &plus;
                            </button>
                        }
                    </div>
                    <span class="count-badge">@GetTasksByStatus(TaskStatus.ToDo).Count</span>
                </div>
                <div class="column-body"
                     ondragover="event.preventDefault(); if(event.dataTransfer) event.dataTransfer.dropEffect = 'move';"
                     ondragenter="event.preventDefault();"
                     @ondragover:preventDefault="true"
                     @ondragenter:preventDefault="true"
                     @ondrop="() => HandleDropOnColumn(TaskStatus.ToDo)">
                    @foreach (var task in GetTasksByStatus(TaskStatus.ToDo))
                    {
                        @RenderTaskCard(task)
                    }

                    @if (CurrentUserRole == UserRoleTypes.Admin)
                    {
                        <button class="btn-add-task-column" @onclick="() => IsCreateTaskModalOpen = true">
                            + Add Task
                        </button>
                    }
                </div>
            </div>

            <!-- Column 2: In Progress -->
            <div class="kanban-column column-inprogress @(IsDragging && DraggedTask?.Status != TaskStatus.InProgress ? "drop-target-active" : "")"
                 ondragover="event.preventDefault(); if(event.dataTransfer) event.dataTransfer.dropEffect = 'move';"
                 ondragenter="event.preventDefault();"
                 @ondragover:preventDefault="true"
                 @ondragenter:preventDefault="true"
                 @ondrop="() => HandleDropOnColumn(TaskStatus.InProgress)">
                <div class="column-header"
                     ondragover="event.preventDefault(); if(event.dataTransfer) event.dataTransfer.dropEffect = 'move';"
                     ondragenter="event.preventDefault();">
                    <h3 class="column-title">In Progress</h3>
                    <span class="count-badge">@GetTasksByStatus(TaskStatus.InProgress).Count</span>
                </div>
                <div class="column-body"
                     ondragover="event.preventDefault(); if(event.dataTransfer) event.dataTransfer.dropEffect = 'move';"
                     ondragenter="event.preventDefault();"
                     @ondragover:preventDefault="true"
                     @ondragenter:preventDefault="true"
                     @ondrop="() => HandleDropOnColumn(TaskStatus.InProgress)">
                    @foreach (var task in GetTasksByStatus(TaskStatus.InProgress))
                    {
                        @RenderTaskCard(task)
                    }
                </div>
            </div>

            <!-- Column 3: Awaiting Approval -->
            <div class="kanban-column column-awaitingapproval @(IsDragging && DraggedTask?.Status != TaskStatus.AwaitingApproval ? "drop-target-active" : "")"
                 ondragover="event.preventDefault(); if(event.dataTransfer) event.dataTransfer.dropEffect = 'move';"
                 ondragenter="event.preventDefault();"
                 @ondragover:preventDefault="true"
                 @ondragenter:preventDefault="true"
                 @ondrop="() => HandleDropOnColumn(TaskStatus.AwaitingApproval)">
                <div class="column-header"
                     ondragover="event.preventDefault(); if(event.dataTransfer) event.dataTransfer.dropEffect = 'move';"
                     ondragenter="event.preventDefault();">
                    <h3 class="column-title">Awaiting Approval</h3>
                    <span class="count-badge highlight-warning">@GetTasksByStatus(TaskStatus.AwaitingApproval).Count</span>
                </div>
                <div class="column-body"
                     ondragover="event.preventDefault(); if(event.dataTransfer) event.dataTransfer.dropEffect = 'move';"
                     ondragenter="event.preventDefault();"
                     @ondragover:preventDefault="true"
                     @ondragenter:preventDefault="true"
                     @ondrop="() => HandleDropOnColumn(TaskStatus.AwaitingApproval)">
                    @foreach (var task in GetTasksByStatus(TaskStatus.AwaitingApproval))
                    {
                        @RenderTaskCard(task)
                    }
                </div>
            </div>

            <!-- Column 4: Done -->
            <div class="kanban-column column-done @(IsDragging && DraggedTask?.Status != TaskStatus.Done ? "drop-target-active" : "")"
                 ondragover="event.preventDefault(); if(event.dataTransfer) event.dataTransfer.dropEffect = 'move';"
                 ondragenter="event.preventDefault();"
                 @ondragover:preventDefault="true"
                 @ondragenter:preventDefault="true"
                 @ondrop="() => HandleDropOnColumn(TaskStatus.Done)">
                <div class="column-header"
                     ondragover="event.preventDefault(); if(event.dataTransfer) event.dataTransfer.dropEffect = 'move';"
                     ondragenter="event.preventDefault();">
                    <h3 class="column-title">Done</h3>
                    <span class="count-badge highlight-success">@GetTasksByStatus(TaskStatus.Done).Count</span>
                </div>
                <div class="column-body"
                     ondragover="event.preventDefault(); if(event.dataTransfer) event.dataTransfer.dropEffect = 'move';"
                     ondragenter="event.preventDefault();"
                     @ondragover:preventDefault="true"
                     @ondragenter:preventDefault="true"
                     @ondrop="() => HandleDropOnColumn(TaskStatus.Done)">
                    @foreach (var task in GetTasksByStatus(TaskStatus.Done))
                    {
                        @RenderTaskCard(task)
                    }
                </div>
            </div>
        </div>

        <!-- Task Detail Modal -->
        <BuildSmart.SharedUI.Components.TaskDetailModal
            IsOpen="SelectedTask != null"
            Task="SelectedTask"
            CurrentUserId="CurrentUserId"
            UserRole="CurrentUserRole"
            OnTaskUpdated="HandleTaskUpdated"
            OnClosed="() => SelectedTask = null" />

        <!-- Confirmation Modal for Task Deletion -->
        <BuildSmart.SharedUI.Components.ConfirmationModal
            IsOpen="TaskToDelete != null"
            Title="Delete Task"
            Message="@($"Are you sure you want to delete task '{TaskToDelete?.Title}'? This action cannot be undone.")"
            ConfirmText="Delete Task"
            IsDanger="true"
            OnConfirm="ConfirmDeleteTask"
            OnCancel="() => TaskToDelete = null" />

        <!-- Confirmation Modal for Status Change -->
        <BsConfirmationModal IsVisible="_showStatusConfirmModal"
                             Title="Confirm Status Change"
                             Message="@_statusConfirmMessage"
                             AcceptText="Yes"
                             CancelText="No"
                             OnConfirmationChanged="OnStatusConfirmationChanged" />

        <!-- Confirmation Modal for Markup Change -->
        <BsConfirmationModal IsVisible="_showMarkupConfirmModal"
                             Title="Confirm Markup Change"
                             Message="@_markupConfirmMessage"
                             AcceptText="Yes"
                             CancelText="No"
                             OnConfirmationChanged="OnMarkupConfirmationChanged" />

        <!-- Create Task Modal -->
        @if (BoardData != null)
        {
            <BuildSmart.SharedUI.Components.CreateTaskModal
                IsOpen="IsCreateTaskModalOpen"
                CategorySections="BoardData.CategorySections"
                OnSubmit="HandleCreateTask"
                OnClosed="() => IsCreateTaskModalOpen = false" />
        }
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private bool IsLoading { get; set; } = true;
    private ProjectKanbanBoardDto? BoardData { get; set; }
    private KanbanTaskCardDto? SelectedTask { get; set; }
    private bool IsCreateTaskModalOpen { get; set; }

    private async Task HandleCreateTask(BuildSmart.SharedUI.Components.CreateTaskModal.CreateTaskRequest req)
    {
        await ProjectService.CreateTaskAsync(req.JobPostId, req.Title, req.Description, req.EstimatedPrice, CurrentUserId);
        await RefreshBoard();
    }

    private Guid CurrentUserId { get; set; }
    private UserRoleTypes CurrentUserRole { get; set; } = UserRoleTypes.Homeowner;

    private KanbanTaskCardDto? DraggedTask { get; set; }
    private bool IsDragging { get; set; } = false;
    private Guid? DragOverTaskId { get; set; }

    private void HandleTaskDragEnter(KanbanTaskCardDto task)
    {
        if (IsDragging && DraggedTask != null && DraggedTask.TaskId != task.TaskId)
        {
            DragOverTaskId = task.TaskId;
            StateHasChanged();
        }
    }

    private void HandleTaskDragLeave(KanbanTaskCardDto task)
    {
        if (DragOverTaskId == task.TaskId)
        {
            DragOverTaskId = null;
            StateHasChanged();
        }
    }

    private string BoardViewMode { get; set; } = "horizontal";
    private string TaskSortOption { get; set; } = "Sequence";
    private string FilterSearchKeyword { get; set; } = string.Empty;
    private string FilterCategory { get; set; } = "ALL";
    private string FilterAssignee { get; set; } = "ALL";

    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(FilterSearchKeyword) || FilterCategory != "ALL" || FilterAssignee != "ALL";

    private void OnFilterSearchInput(ChangeEventArgs e)
    {
        FilterSearchKeyword = e.Value?.ToString() ?? string.Empty;
        StateHasChanged();
    }

    private void OnFilterCategoryChange(ChangeEventArgs e)
    {
        FilterCategory = e.Value?.ToString() ?? "ALL";
        StateHasChanged();
    }

    private void OnFilterAssigneeChange(ChangeEventArgs e)
    {
        FilterAssignee = e.Value?.ToString() ?? "ALL";
        StateHasChanged();
    }

    private void ClearSearchFilter()
    {
        FilterSearchKeyword = string.Empty;
        StateHasChanged();
    }

    private void ClearCategoryFilter()
    {
        FilterCategory = "ALL";
        StateHasChanged();
    }

    private void ClearAssigneeFilter()
    {
        FilterAssignee = "ALL";
        StateHasChanged();
    }

    private void ResetFilters()
    {
        FilterSearchKeyword = string.Empty;
        FilterCategory = "ALL";
        FilterAssignee = "ALL";
        StateHasChanged();
    }

    private IEnumerable<string> GetAvailableCategories()
    {
        if (BoardData == null) return Enumerable.Empty<string>();
        return BoardData.CategorySections
            .Select(s => s.CategoryName)
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .Distinct()
            .OrderBy(c => c);
    }

    private IEnumerable<string> GetAvailableAssignees()
    {
        if (BoardData == null) return Enumerable.Empty<string>();
        return BoardData.CategorySections
            .SelectMany(s => s.Tasks)
            .Select(t => t.AssignedTradesmanName)
            .Where(a => !string.IsNullOrWhiteSpace(a))
            .Select(a => a!)
            .Distinct()
            .OrderBy(a => a);
    }

    private int GetTotalTaskCount()
    {
        if (BoardData == null) return 0;
        return BoardData.CategorySections.Sum(s => s.Tasks.Count);
    }

    private int GetFilteredTaskCount()
    {
        if (BoardData == null) return 0;
        return GetTasksByStatus(TaskStatus.ToDo).Count +
               GetTasksByStatus(TaskStatus.InProgress).Count +
               GetTasksByStatus(TaskStatus.AwaitingApproval).Count +
               GetTasksByStatus(TaskStatus.Done).Count;
    }

    private List<KanbanTaskCardDto> GetTasksByStatus(TaskStatus status)
    {
        if (BoardData == null) return new List<KanbanTaskCardDto>();
        IEnumerable<KanbanTaskCardDto> tasks = BoardData.CategorySections
            .SelectMany(s => s.Tasks)
            .Where(t => t.Status == status);

        if (!string.IsNullOrWhiteSpace(FilterSearchKeyword))
        {
            var kw = FilterSearchKeyword.Trim();
            tasks = tasks.Where(t =>
                (t.Title != null && t.Title.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (t.CategoryName != null && t.CategoryName.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (t.AssignedTradesmanName != null && t.AssignedTradesmanName.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (t.Skus != null && t.Skus.Any(s => s.SkuTitle != null && s.SkuTitle.Contains(kw, StringComparison.OrdinalIgnoreCase)))
            );
        }

        if (!string.IsNullOrWhiteSpace(FilterCategory) && FilterCategory != "ALL")
        {
            tasks = tasks.Where(t => string.Equals(t.CategoryName, FilterCategory, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(FilterAssignee) && FilterAssignee != "ALL")
        {
            if (FilterAssignee == "UNASSIGNED")
            {
                tasks = tasks.Where(t => string.IsNullOrEmpty(t.AssignedTradesmanName));
            }
            else
            {
                tasks = tasks.Where(t => string.Equals(t.AssignedTradesmanName, FilterAssignee, StringComparison.OrdinalIgnoreCase));
            }
        }

        return TaskSortOption switch
        {
            "Category" => tasks.OrderBy(t => t.CategoryName).ThenBy(t => t.SequenceOrder).ToList(),
            "PriceDesc" => tasks.OrderByDescending(t => t.EstimatedPrice).ToList(),
            "PriceAsc" => tasks.OrderBy(t => t.EstimatedPrice).ToList(),
            _ => tasks.OrderBy(t => t.SequenceOrder).ToList()
        };
    }

    private void OnSortOptionChanged(ChangeEventArgs e)
    {
        TaskSortOption = e.Value?.ToString() ?? "Sequence";
        StateHasChanged();
    }

    private async Task MoveTaskUp(KanbanTaskCardDto task)
    {
        try
        {
            await ProjectService.ReorderTaskAsync(task.TaskId, -1, CurrentUserId);
            await RefreshBoard();
        }
        catch (Exception ex)
        {
            await AlertService.DisplayAlert("Reorder Error", ex.Message, "OK");
        }
    }

    private async Task MoveTaskDown(KanbanTaskCardDto task)
    {
        try
        {
            await ProjectService.ReorderTaskAsync(task.TaskId, 1, CurrentUserId);
            await RefreshBoard();
        }
        catch (Exception ex)
        {
            await AlertService.DisplayAlert("Reorder Error", ex.Message, "OK");
        }
    }

    private async Task HandleDropOnTask(KanbanTaskCardDto targetTask)
    {
        if (DraggedTask == null || DraggedTask.TaskId == targetTask.TaskId) return;
        var dragged = DraggedTask;
        IsDragging = false;
        DraggedTask = null;

        try
        {
            await ProjectService.MoveTaskBeforeTaskAsync(dragged.TaskId, targetTask.TaskId, CurrentUserId);
            await RefreshBoard();
        }
        catch (Exception ex)
        {
            await AlertService.DisplayAlert("Reorder Error", ex.Message, "OK");
        }
    }

    private bool IsAdminUser { get; set; }

    private void UpdateEffectiveRole()
    {
        if (!IsAdminUser) return;
        if (AdminPerspectiveService.CurrentPerspective == AdminPerspectiveMode.Homeowner)
        {
            CurrentUserRole = UserRoleTypes.Homeowner;
        }
        else if (AdminPerspectiveService.CurrentPerspective == AdminPerspectiveMode.Tradesman)
        {
            CurrentUserRole = UserRoleTypes.Tradesman;
        }
        else
        {
            CurrentUserRole = UserRoleTypes.Admin;
        }
    }

    private void OnPerspectiveSelectChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<AdminPerspectiveMode>(e.Value?.ToString(), true, out var mode))
        {
            AdminPerspectiveService.SetPerspective(mode);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        AdminPerspectiveService.PerspectiveChanged += OnAdminPerspectiveChanged;
        await LoadUserAndBoard();
    }

    private async void OnAdminPerspectiveChanged()
    {
        if (IsAdminUser)
        {
            UpdateEffectiveRole();
            await InvokeAsync(RefreshBoard);
        }
    }

    private async Task LoadUserAndBoard()
    {
        IsLoading = true;
        try
        {
            var token = await AuthService.GetTokenAsync();
            if (!string.IsNullOrEmpty(token))
            {
                var userId = AuthService.GetUserIdFromToken(token);
                if (userId.HasValue) CurrentUserId = userId.Value;

                var roleStr = AuthService.GetUserRoleFromToken(token);
                if (Enum.TryParse<UserRoleTypes>(roleStr, true, out var r))
                {
                    IsAdminUser = r == UserRoleTypes.Admin;
                    CurrentUserRole = r;
                    UpdateEffectiveRole();
                }
            }

            BoardData = await ProjectService.GetProjectKanbanBoardAsync(Id, CurrentUserId, CurrentUserRole);
        }
        catch (Exception ex)
        {
            await AlertService.DisplayAlert("Error Loading Kanban Board", ex.Message, "OK");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task RefreshBoard()
    {
        UpdateEffectiveRole();
        BoardData = await ProjectService.GetProjectKanbanBoardAsync(Id, CurrentUserId, CurrentUserRole);
        StateHasChanged();
    }

    public void Dispose()
    {
        AdminPerspectiveService.PerspectiveChanged -= OnAdminPerspectiveChanged;
    }

    private void OpenTaskDetails(KanbanTaskCardDto task)
    {
        SelectedTask = task;
    }

    private async Task HandleTaskUpdated()
    {
        await RefreshBoard();
        if (SelectedTask != null)
        {
            SelectedTask = BoardData?.CategorySections.SelectMany(s => s.Tasks).FirstOrDefault(t => t.TaskId == SelectedTask.TaskId);
        }
    }

    private bool _isEditingStatus = false;
    private bool _showStatusConfirmModal = false;
    private ProjectStatus? _pendingStatus;
    private string _statusConfirmMessage = string.Empty;

    private void ToggleEditStatus()
    {
        _isEditingStatus = !_isEditingStatus;
    }

    private void PromptAdminStatusChange(ChangeEventArgs e)
    {
        if (e.Value == null || !Enum.TryParse<ProjectStatus>(e.Value.ToString(), out var newStatus)) return;
        if (newStatus == BoardData?.ProjectStatus) return;

        _pendingStatus = newStatus;
        _statusConfirmMessage = $"Are you sure you want to change project status to '{newStatus}'?";
        _showStatusConfirmModal = true;
    }

    private async Task OnStatusConfirmationChanged(bool confirmed)
    {
        _showStatusConfirmModal = false;

        if (confirmed && _pendingStatus.HasValue)
        {
            try
            {
                await ProjectService.SetProjectStatusAsync(Id, _pendingStatus.Value, CurrentUserId);
                await RefreshBoard();
                _isEditingStatus = false;
            }
            catch (Exception ex)
            {
                await AlertService.DisplayAlert("Status Update Error", ex.Message, "OK");
            }
        }
        _pendingStatus = null;
    }

    private bool _isEditingMarkup = false;
    private bool _showMarkupConfirmModal = false;
    private decimal? _pendingMarkup;
    private decimal _editingMarkupValue;
    private string _markupConfirmMessage = string.Empty;

    private void ToggleEditMarkup()
    {
        _isEditingMarkup = !_isEditingMarkup;
        if (_isEditingMarkup && BoardData != null)
        {
            _editingMarkupValue = BoardData.AdminMarkupPercentage;
        }
    }

    private void PromptAdminMarkupChange(ChangeEventArgs e)
    {
        if (e.Value == null || !decimal.TryParse(e.Value.ToString(), out var newMarkup)) return;
        if (newMarkup == BoardData?.AdminMarkupPercentage) return;

        _pendingMarkup = newMarkup;
        _markupConfirmMessage = $"Are you sure you want to change project markup percentage to {newMarkup}%?";
        _showMarkupConfirmModal = true;
    }

    private async Task OnMarkupConfirmationChanged(bool confirmed)
    {
        _showMarkupConfirmModal = false;

        if (confirmed && _pendingMarkup.HasValue)
        {
            try
            {
                await ProjectService.UpdateProjectMarkupPercentageAsync(Id, _pendingMarkup.Value, CurrentUserId);
                await RefreshBoard();
                _isEditingMarkup = false;
            }
            catch (Exception ex)
            {
                await AlertService.DisplayAlert("Markup Error", ex.Message, "OK");
            }
        }
        _pendingMarkup = null;
    }

    private void HandleDragStart(DragEventArgs e, KanbanTaskCardDto task)
    {
        e.DataTransfer.EffectAllowed = "move";
        DraggedTask = task;
        IsDragging = true;
    }

    private void HandleDragEnd()
    {
        DraggedTask = null;
        IsDragging = false;
        DragOverTaskId = null;
    }

    private async Task HandleDropOnColumn(TaskStatus targetStatus)
    {
        if (DraggedTask == null || DraggedTask.Status == targetStatus)
        {
            IsDragging = false;
            return;
        }

        var taskToMove = DraggedTask;
        IsDragging = false;
        DraggedTask = null;

        try
        {
            await ProjectService.UpdateTaskStatusAsync(taskToMove.TaskId, targetStatus, CurrentUserId, null);
            await RefreshBoard();
        }
        catch (Exception ex)
        {
            await AlertService.DisplayAlert("Status Update Error", ex.Message, "OK");
        }
    }

    private async Task QuickChangeStatus(KanbanTaskCardDto task, string? newStatusStr)
    {
        if (string.IsNullOrEmpty(newStatusStr) || !Enum.TryParse<TaskStatus>(newStatusStr, out var newStatus))
            return;

        if (task.Status == newStatus) return;

        try
        {
            await ProjectService.UpdateTaskStatusAsync(task.TaskId, newStatus, CurrentUserId, null);
            await RefreshBoard();
        }
        catch (Exception ex)
        {
            await AlertService.DisplayAlert("Status Update Error", ex.Message, "OK");
        }
    }

    private KanbanTaskCardDto? TaskToDelete { get; set; }

    private void PromptDeleteTask(KanbanTaskCardDto task)
    {
        TaskToDelete = task;
    }

    private async Task ConfirmDeleteTask()
    {
        if (TaskToDelete == null) return;
        var task = TaskToDelete;
        TaskToDelete = null;

        try
        {
            await ProjectService.DeleteTaskAsync(task.TaskId, CurrentUserId);
            await RefreshBoard();
        }
        catch (Exception ex)
        {
            await AlertService.DisplayAlert("Delete Error", ex.Message, "OK");
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/projects");
    }

    private RenderFragment RenderTaskCard(KanbanTaskCardDto task) => __builder =>
    {
        bool isDraggable = CurrentUserRole == UserRoleTypes.Admin || CurrentUserRole == UserRoleTypes.Tradesman;
        bool isPending = task.CategoryStatus == ProjectCategoryStatus.Pending;

        <div class="task-card @(isPending ? "task-card-pending" : "") @(isDraggable ? "is-draggable" : "not-draggable") @(DragOverTaskId == task.TaskId ? "drop-target-hover" : "")"
             draggable="@isDraggable.ToString().ToLower()"
             @ondragstart="(e) => HandleDragStart(e, task)"
             @ondragend="HandleDragEnd"
             @ondragover:preventDefault="true"
             @ondragenter:preventDefault="true"
             @ondragenter="() => HandleTaskDragEnter(task)"
             @ondragleave="() => HandleTaskDragLeave(task)"
             @ondrop:stopPropagation="true"
             @ondrop="() => HandleDropOnTask(task)"
             @onclick="() => OpenTaskDetails(task)">
            @if (DragOverTaskId == task.TaskId)
            {
                <div class="drop-insertion-line"></div>
            }
            <div class="card-top-bar">
                <span class="card-category">
                    @task.CategoryName
                    @if (isPending)
                    {
                        <span class="badge-pending-activation ms-1" style="font-size: 0.7rem; padding: 1px 6px;">
                            @Loc["ProjectDetail_PendingActivation"]
                        </span>
                    }
                </span>
                @if (CurrentUserRole == UserRoleTypes.Tradesman)
                {
                    <span class="card-price @(isPending ? "price-pending" : "")" title="Negotiated Tradesman Payout Rate">Rate: €@task.DisplayPrice.ToString("F2")</span>
                }
                else if (CurrentUserRole == UserRoleTypes.Admin)
                {
                    <span class="card-price @(isPending ? "price-pending" : "")" title="Client Offer: €@task.EstimatedPrice.ToString("F2") | Tradesman Payout: €@task.TradesmanPrice.ToString("F2")">
                        Client: €@task.EstimatedPrice.ToString("F2") <small style="font-size: 0.75rem; opacity: 0.85;">(Payout: €@task.TradesmanPrice.ToString("F2"))</small>
                    </span>
                }
                else
                {
                    <span class="card-price @(isPending ? "price-pending" : "")">€@task.DisplayPrice.ToString("F2")</span>
                }
            </div>

            @if (CurrentUserRole == UserRoleTypes.Admin || CurrentUserRole == UserRoleTypes.Tradesman)
            {
                <div class="card-actions-bar" @onclick:stopPropagation="true">
                    <select class="quick-status-select" value="@task.Status.ToString()" @onchange="(e) => QuickChangeStatus(task, e.Value?.ToString())">
                        <option value="ToDo">To Do</option>
                        <option value="InProgress">In Progress</option>
                        <option value="AwaitingApproval">Awaiting Approval</option>
                        <option value="Done">Done</option>
                    </select>

                    <div class="vertical-reorder-btns d-inline-flex gap-1 ms-1">
                        <button class="btn-reorder-up" title="Move Up Vertically" @onclick="() => MoveTaskUp(task)">&#9650;</button>
                        <button class="btn-reorder-down" title="Move Down Vertically" @onclick="() => MoveTaskDown(task)">&#9660;</button>
                    </div>

                    @if (CurrentUserRole == UserRoleTypes.Admin)
                    {
                        <button class="btn-delete-task ms-auto" title="Delete Task (Admin)" @onclick="() => PromptDeleteTask(task)">
                            &times;
                        </button>
                    }
                </div>
            }
            else if (task.Status == TaskStatus.AwaitingApproval)
            {
                <div class="approval-action-badge">
                    <span>⚠️ Review & Approve Completion</span>
                </div>
            }

            <h4 class="card-title">@task.Title</h4>

            <div class="card-skus-preview">
                @foreach (var sku in task.Skus.Take(2))
                {
                    <div class="sku-pill">@sku.SkuTitle (@sku.Quantity @sku.Unit)</div>
                }
                @if (task.Skus.Count > 2)
                {
                    <div class="sku-more">+@(task.Skus.Count - 2) more items</div>
                }
            </div>

            <div class="card-footer">
                <span class="assignee-name">
                    <span class="avatar-icon">&#128100;</span>
                    @(task.AssignedTradesmanName ?? "Unassigned")
                </span>
                
                <span class="comments-count">
                    &#128172; @task.CommentCount
                </span>
            </div>
        </div>
    };
}

