@page "/projects/{Id:guid}/kanban"
@page "/projects/{Id:guid}/board"
@using BuildSmart.Core.Application.DTOs
@using BuildSmart.Core.Domain.Enums
@using TaskStatus = BuildSmart.Core.Domain.Enums.TaskStatus
@inject BuildSmart.Core.Application.Interfaces.IProjectManagementService ProjectService
@inject BuildSmart.SharedUI.Services.IAuthService AuthService
@inject BuildSmart.SharedUI.Services.IAlertService AlertService
@inject NavigationManager NavigationManager

<div class="kanban-page-container">
    @if (IsLoading)
    {
        <div class="loading-state">
            <div class="spinner-border text-primary" role="status"></div>
            <p>Loading project workspace...</p>
        </div>
    }
    else if (BoardData == null)
    {
        <div class="error-state">
            <h3>Project Workspace Not Found</h3>
            <button class="btn-secondary" @onclick="GoBack">Back to Projects</button>
        </div>
    }
    else
    {
        <!-- Page Header & Workspace Nav -->
        <div class="page-header">
            <div class="header-main">
                <span class="project-badge">Project Workspace</span>
                <h1 class="project-title">@BoardData.ProjectTitle</h1>
                <p class="homeowner-subtitle">Homeowner: <strong>@BoardData.HomeownerName</strong></p>
            </div>

            <div class="header-actions">
                <div class="project-status-box">
                    <span class="status-label">Project Status:</span>
                    <span class="status-pill status-@BoardData.ProjectStatus.ToString().ToLower()">@BoardData.ProjectStatus</span>
                    @if (CurrentUserRole == UserRoleTypes.Admin)
                    {
                        <div class="markup-box ms-3 d-inline-flex align-items-center">
                            <span class="status-label me-1">Markup:</span>
                            <input type="number" class="markup-input" style="width: 65px; padding: 2px 6px; border-radius: 4px; border: 1px solid var(--border-color); background: var(--bg-card); color: var(--text-primary); font-weight: 600;" 
                                   value="@BoardData.AdminMarkupPercentage" @onchange="OnAdminMarkupChange" min="0" max="200" step="1" />
                            <span class="status-label ms-1">%</span>
                        </div>

                        <select class="status-select ms-2" value="@BoardData.ProjectStatus.ToString()" @onchange="OnAdminStatusChange">
                            <option value="Draft">Draft/Preview</option>
                            <option value="UnderReview">Under Review</option>
                            <option value="Active">Active</option>
                            <option value="Completed">Completed</option>
                            <option value="Archived">Archived</option>
                        </select>
                    }
                </div>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <div class="navigation-tabs">
            <a class="nav-tab active" href="/projects/@Id/kanban">Work Board (Kanban)</a>
            <a class="nav-tab" href="/projects/@Id/payments">Payments & Financials</a>
            <a class="nav-tab" href="/project-detail?projectId=@Id">Scope & PDF Offer</a>
        </div>

        <!-- Admin Tradesman Category Assigner -->
        @if (CurrentUserRole == UserRoleTypes.Admin)
        {
            <div class="admin-tools-container">
                <BuildSmart.SharedUI.Components.Pages.Admin.AdminTradesmanAssigner
                    ProjectId="Id"
                    AdminUserId="CurrentUserId"
                    Sections="BoardData.CategorySections"
                    OnAssignmentsChanged="RefreshBoard" />
            </div>
        }

        <!-- 4 Column Kanban Board -->
        <div class="kanban-board-grid">
            <!-- Column 1: To Do -->
            <div class="kanban-column column-todo @(IsDragging && DraggedTask?.Status != TaskStatus.ToDo ? "drop-target-active" : "")"
                 ondragover="event.preventDefault(); if(event.dataTransfer) event.dataTransfer.dropEffect = 'move';"
                 ondragenter="event.preventDefault();"
                 @ondragover:preventDefault="true"
                 @ondragenter:preventDefault="true"
                 @ondrop="() => HandleDropOnColumn(TaskStatus.ToDo)">
                <div class="column-header"
                     ondragover="event.preventDefault(); if(event.dataTransfer) event.dataTransfer.dropEffect = 'move';"
                     ondragenter="event.preventDefault();">
                    <div class="column-header-left">
                        <h3 class="column-title">To Do</h3>
                        @if (CurrentUserRole == UserRoleTypes.Admin)
                        {
                            <button class="btn-add-task-header" title="Create New Task (Admin)" @onclick="() => IsCreateTaskModalOpen = true">
                                &plus;
                            </button>
                        }
                    </div>
                    <span class="count-badge">@GetTasksByStatus(TaskStatus.ToDo).Count</span>
                </div>
                <div class="column-body"
                     ondragover="event.preventDefault(); if(event.dataTransfer) event.dataTransfer.dropEffect = 'move';"
                     ondragenter="event.preventDefault();"
                     @ondragover:preventDefault="true"
                     @ondragenter:preventDefault="true"
                     @ondrop="() => HandleDropOnColumn(TaskStatus.ToDo)">
                    @foreach (var task in GetTasksByStatus(TaskStatus.ToDo))
                    {
                        @RenderTaskCard(task)
                    }

                    @if (CurrentUserRole == UserRoleTypes.Admin)
                    {
                        <button class="btn-add-task-column" @onclick="() => IsCreateTaskModalOpen = true">
                            + Add Task
                        </button>
                    }
                </div>
            </div>

            <!-- Column 2: In Progress -->
            <div class="kanban-column column-inprogress @(IsDragging && DraggedTask?.Status != TaskStatus.InProgress ? "drop-target-active" : "")"
                 ondragover="event.preventDefault(); if(event.dataTransfer) event.dataTransfer.dropEffect = 'move';"
                 ondragenter="event.preventDefault();"
                 @ondragover:preventDefault="true"
                 @ondragenter:preventDefault="true"
                 @ondrop="() => HandleDropOnColumn(TaskStatus.InProgress)">
                <div class="column-header"
                     ondragover="event.preventDefault(); if(event.dataTransfer) event.dataTransfer.dropEffect = 'move';"
                     ondragenter="event.preventDefault();">
                    <h3 class="column-title">In Progress</h3>
                    <span class="count-badge">@GetTasksByStatus(TaskStatus.InProgress).Count</span>
                </div>
                <div class="column-body"
                     ondragover="event.preventDefault(); if(event.dataTransfer) event.dataTransfer.dropEffect = 'move';"
                     ondragenter="event.preventDefault();"
                     @ondragover:preventDefault="true"
                     @ondragenter:preventDefault="true"
                     @ondrop="() => HandleDropOnColumn(TaskStatus.InProgress)">
                    @foreach (var task in GetTasksByStatus(TaskStatus.InProgress))
                    {
                        @RenderTaskCard(task)
                    }
                </div>
            </div>

            <!-- Column 3: Awaiting Approval -->
            <div class="kanban-column column-awaitingapproval @(IsDragging && DraggedTask?.Status != TaskStatus.AwaitingApproval ? "drop-target-active" : "")"
                 ondragover="event.preventDefault(); if(event.dataTransfer) event.dataTransfer.dropEffect = 'move';"
                 ondragenter="event.preventDefault();"
                 @ondragover:preventDefault="true"
                 @ondragenter:preventDefault="true"
                 @ondrop="() => HandleDropOnColumn(TaskStatus.AwaitingApproval)">
                <div class="column-header"
                     ondragover="event.preventDefault(); if(event.dataTransfer) event.dataTransfer.dropEffect = 'move';"
                     ondragenter="event.preventDefault();">
                    <h3 class="column-title">Awaiting Approval</h3>
                    <span class="count-badge highlight-warning">@GetTasksByStatus(TaskStatus.AwaitingApproval).Count</span>
                </div>
                <div class="column-body"
                     ondragover="event.preventDefault(); if(event.dataTransfer) event.dataTransfer.dropEffect = 'move';"
                     ondragenter="event.preventDefault();"
                     @ondragover:preventDefault="true"
                     @ondragenter:preventDefault="true"
                     @ondrop="() => HandleDropOnColumn(TaskStatus.AwaitingApproval)">
                    @foreach (var task in GetTasksByStatus(TaskStatus.AwaitingApproval))
                    {
                        @RenderTaskCard(task)
                    }
                </div>
            </div>

            <!-- Column 4: Done -->
            <div class="kanban-column column-done @(IsDragging && DraggedTask?.Status != TaskStatus.Done ? "drop-target-active" : "")"
                 ondragover="event.preventDefault(); if(event.dataTransfer) event.dataTransfer.dropEffect = 'move';"
                 ondragenter="event.preventDefault();"
                 @ondragover:preventDefault="true"
                 @ondragenter:preventDefault="true"
                 @ondrop="() => HandleDropOnColumn(TaskStatus.Done)">
                <div class="column-header"
                     ondragover="event.preventDefault(); if(event.dataTransfer) event.dataTransfer.dropEffect = 'move';"
                     ondragenter="event.preventDefault();">
                    <h3 class="column-title">Done</h3>
                    <span class="count-badge highlight-success">@GetTasksByStatus(TaskStatus.Done).Count</span>
                </div>
                <div class="column-body"
                     ondragover="event.preventDefault(); if(event.dataTransfer) event.dataTransfer.dropEffect = 'move';"
                     ondragenter="event.preventDefault();"
                     @ondragover:preventDefault="true"
                     @ondragenter:preventDefault="true"
                     @ondrop="() => HandleDropOnColumn(TaskStatus.Done)">
                    @foreach (var task in GetTasksByStatus(TaskStatus.Done))
                    {
                        @RenderTaskCard(task)
                    }
                </div>
            </div>
        </div>

        <!-- Task Detail Modal -->
        <BuildSmart.SharedUI.Components.TaskDetailModal
            IsOpen="SelectedTask != null"
            Task="SelectedTask"
            CurrentUserId="CurrentUserId"
            UserRole="CurrentUserRole"
            OnTaskUpdated="HandleTaskUpdated"
            OnClosed="() => SelectedTask = null" />

        <!-- Confirmation Modal for Task Deletion -->
        <BuildSmart.SharedUI.Components.ConfirmationModal
            IsOpen="TaskToDelete != null"
            Title="Delete Task"
            Message="@($"Are you sure you want to delete task '{TaskToDelete?.Title}'? This action cannot be undone.")"
            ConfirmText="Delete Task"
            IsDanger="true"
            OnConfirm="ConfirmDeleteTask"
            OnCancel="() => TaskToDelete = null" />

        <!-- Create Task Modal -->
        @if (BoardData != null)
        {
            <BuildSmart.SharedUI.Components.CreateTaskModal
                IsOpen="IsCreateTaskModalOpen"
                CategorySections="BoardData.CategorySections"
                OnSubmit="HandleCreateTask"
                OnClosed="() => IsCreateTaskModalOpen = false" />
        }
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private bool IsLoading { get; set; } = true;
    private ProjectKanbanBoardDto? BoardData { get; set; }
    private KanbanTaskCardDto? SelectedTask { get; set; }
    private bool IsCreateTaskModalOpen { get; set; }

    private async Task HandleCreateTask(BuildSmart.SharedUI.Components.CreateTaskModal.CreateTaskRequest req)
    {
        await ProjectService.CreateTaskAsync(req.JobPostId, req.Title, req.Description, req.EstimatedPrice, CurrentUserId);
        await RefreshBoard();
    }

    private Guid CurrentUserId { get; set; }
    private UserRoleTypes CurrentUserRole { get; set; } = UserRoleTypes.Homeowner;

    private KanbanTaskCardDto? DraggedTask { get; set; }
    private bool IsDragging { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserAndBoard();
    }

    private async Task LoadUserAndBoard()
    {
        IsLoading = true;
        try
        {
            var token = await AuthService.GetTokenAsync();
            if (!string.IsNullOrEmpty(token))
            {
                var userId = AuthService.GetUserIdFromToken(token);
                if (userId.HasValue) CurrentUserId = userId.Value;

                var roleStr = AuthService.GetUserRoleFromToken(token);
                if (Enum.TryParse<UserRoleTypes>(roleStr, true, out var r))
                {
                    CurrentUserRole = r;
                }
            }

            BoardData = await ProjectService.GetProjectKanbanBoardAsync(Id, CurrentUserId, CurrentUserRole);
        }
        catch (Exception ex)
        {
            await AlertService.DisplayAlert("Error Loading Kanban Board", ex.Message, "OK");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task RefreshBoard()
    {
        BoardData = await ProjectService.GetProjectKanbanBoardAsync(Id, CurrentUserId, CurrentUserRole);
        StateHasChanged();
    }

    private List<KanbanTaskCardDto> GetTasksByStatus(TaskStatus status)
    {
        if (BoardData == null) return new List<KanbanTaskCardDto>();
        return BoardData.CategorySections
            .SelectMany(s => s.Tasks)
            .Where(t => t.Status == status)
            .OrderBy(t => t.SequenceOrder)
            .ToList();
    }

    private void OpenTaskDetails(KanbanTaskCardDto task)
    {
        SelectedTask = task;
    }

    private async Task HandleTaskUpdated()
    {
        await RefreshBoard();
        if (SelectedTask != null)
        {
            SelectedTask = BoardData?.CategorySections.SelectMany(s => s.Tasks).FirstOrDefault(t => t.TaskId == SelectedTask.TaskId);
        }
    }

    private async Task OnAdminStatusChange(ChangeEventArgs e)
    {
        if (e.Value == null || !Enum.TryParse<ProjectStatus>(e.Value.ToString(), out var newStatus)) return;
        try
        {
            await ProjectService.SetProjectStatusAsync(Id, newStatus, CurrentUserId);
            await RefreshBoard();
            await AlertService.DisplayAlert("Status Updated", $"Project status changed to {newStatus}", "OK");
        }
        catch (Exception ex)
        {
            await AlertService.DisplayAlert("Status Update Error", ex.Message, "OK");
        }
    }

    private async Task OnAdminMarkupChange(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var newMarkup))
        {
            try
            {
                await ProjectService.UpdateProjectMarkupPercentageAsync(Id, newMarkup, CurrentUserId);
                await RefreshBoard();
            }
            catch (Exception ex)
            {
                await AlertService.DisplayAlert("Markup Error", ex.Message, "OK");
            }
        }
    }

    private void HandleDragStart(DragEventArgs e, KanbanTaskCardDto task)
    {
        e.DataTransfer.EffectAllowed = "move";
        DraggedTask = task;
        IsDragging = true;
    }

    private void HandleDragEnd()
    {
        DraggedTask = null;
        IsDragging = false;
    }

    private async Task HandleDropOnColumn(TaskStatus targetStatus)
    {
        if (DraggedTask == null || DraggedTask.Status == targetStatus)
        {
            IsDragging = false;
            return;
        }

        var taskToMove = DraggedTask;
        IsDragging = false;
        DraggedTask = null;

        try
        {
            await ProjectService.UpdateTaskStatusAsync(taskToMove.TaskId, targetStatus, CurrentUserId, null);
            await RefreshBoard();
        }
        catch (Exception ex)
        {
            await AlertService.DisplayAlert("Status Update Error", ex.Message, "OK");
        }
    }

    private async Task QuickChangeStatus(KanbanTaskCardDto task, string? newStatusStr)
    {
        if (string.IsNullOrEmpty(newStatusStr) || !Enum.TryParse<TaskStatus>(newStatusStr, out var newStatus))
            return;

        if (task.Status == newStatus) return;

        try
        {
            await ProjectService.UpdateTaskStatusAsync(task.TaskId, newStatus, CurrentUserId, null);
            await RefreshBoard();
        }
        catch (Exception ex)
        {
            await AlertService.DisplayAlert("Status Update Error", ex.Message, "OK");
        }
    }

    private KanbanTaskCardDto? TaskToDelete { get; set; }

    private void PromptDeleteTask(KanbanTaskCardDto task)
    {
        TaskToDelete = task;
    }

    private async Task ConfirmDeleteTask()
    {
        if (TaskToDelete == null) return;
        var task = TaskToDelete;
        TaskToDelete = null;

        try
        {
            await ProjectService.DeleteTaskAsync(task.TaskId, CurrentUserId);
            await RefreshBoard();
        }
        catch (Exception ex)
        {
            await AlertService.DisplayAlert("Delete Error", ex.Message, "OK");
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/projects");
    }

    private RenderFragment RenderTaskCard(KanbanTaskCardDto task) => __builder =>
    {
        bool isDraggable = CurrentUserRole == UserRoleTypes.Admin || CurrentUserRole == UserRoleTypes.Tradesman;

        <div class="task-card @(isDraggable ? "is-draggable" : "not-draggable")"
             draggable="@isDraggable.ToString().ToLower()"
             @ondragstart="(e) => HandleDragStart(e, task)"
             @ondragend="HandleDragEnd"
             @ondragover:preventDefault="true"
             @ondragenter:preventDefault="true"
             @onclick="() => OpenTaskDetails(task)">
            <div class="card-top-bar">
                <span class="card-category">@task.CategoryName</span>
                @if (CurrentUserRole == UserRoleTypes.Tradesman)
                {
                    <span class="card-price" title="Negotiated Tradesman Payout Rate">Rate: €@task.DisplayPrice.ToString("F2")</span>
                }
                else if (CurrentUserRole == UserRoleTypes.Admin)
                {
                    <span class="card-price" title="Client Offer: €@task.EstimatedPrice.ToString("F2") | Tradesman Payout: €@task.TradesmanPrice.ToString("F2")">
                        Client: €@task.EstimatedPrice.ToString("F2") <small style="font-size: 0.75rem; opacity: 0.85;">(Payout: €@task.TradesmanPrice.ToString("F2"))</small>
                    </span>
                }
                else
                {
                    <span class="card-price">€@task.DisplayPrice.ToString("F2")</span>
                }
            </div>

            @if (CurrentUserRole == UserRoleTypes.Admin || CurrentUserRole == UserRoleTypes.Tradesman)
            {
                <div class="card-actions-bar" @onclick:stopPropagation="true">
                    <select class="quick-status-select" value="@task.Status.ToString()" @onchange="(e) => QuickChangeStatus(task, e.Value?.ToString())">
                        <option value="ToDo">To Do</option>
                        <option value="InProgress">In Progress</option>
                        <option value="AwaitingApproval">Awaiting Approval</option>
                        <option value="Done">Done</option>
                    </select>

                    @if (CurrentUserRole == UserRoleTypes.Admin)
                    {
                        <button class="btn-delete-task" title="Delete Task (Admin)" @onclick="() => PromptDeleteTask(task)">
                            &times;
                        </button>
                    }
                </div>
            }
            else if (task.Status == TaskStatus.AwaitingApproval)
            {
                <div class="approval-action-badge">
                    <span>⚠️ Review & Approve Completion</span>
                </div>
            }

            <h4 class="card-title">@task.Title</h4>

            <div class="card-skus-preview">
                @foreach (var sku in task.Skus.Take(2))
                {
                    <div class="sku-pill">@sku.SkuTitle (@sku.Quantity @sku.Unit)</div>
                }
                @if (task.Skus.Count > 2)
                {
                    <div class="sku-more">+@(task.Skus.Count - 2) more items</div>
                }
            </div>

            <div class="card-footer">
                <span class="assignee-name">
                    <span class="avatar-icon">&#128100;</span>
                    @(task.AssignedTradesmanName ?? "Unassigned")
                </span>
                
                <span class="comments-count">
                    &#128172; @task.CommentCount
                </span>
            </div>
        </div>
    };
}

<style>
    .kanban-page-container {
        padding: 1.5rem;
        max-width: 1400px;
        margin: 0 auto;
        color: var(--text-primary, #ffffff);
    }
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1.5rem;
        gap: 1rem;
    }
    .header-main {
        min-width: 0;
        flex: 1 1 auto;
    }
    .project-badge {
        font-size: 0.75rem;
        text-transform: uppercase;
        color: var(--color-primary, #6366f1);
        font-weight: 600;
        letter-spacing: 0.05em;
    }
    .project-title {
        font: var(--font-h1, 700 2rem/1.2 'Inter', sans-serif);
        margin: 0.25rem 0;
        word-break: break-word;
        overflow-wrap: break-word;
    }
    .homeowner-subtitle {
        color: var(--text-secondary, #9ca3af);
        font-size: 0.9rem;
        word-break: break-word;
    }
    .project-status-box {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        background-color: var(--bg-card, #1e1e2d);
        padding: 0.6rem 1rem;
        border-radius: 8px;
        border: 1px solid var(--border-color, #2d2d3f);
        flex-wrap: wrap;
    }
    .status-label { font-size: 0.85rem; color: var(--text-secondary, #9ca3af); }
    .status-pill {
        padding: 0.2rem 0.6rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
    }
    .status-active { background: rgba(16, 185, 129, 0.2); color: #34d399; }
    .status-draft { background: rgba(156, 163, 175, 0.2); color: #9ca3af; }

    .status-select {
        background-color: var(--bg-surface, #14141f);
        color: var(--text-primary, #ffffff);
        border: 1px solid var(--border-color, #2d2d3f);
        border-radius: 4px;
        padding: 0.3rem 0.5rem;
        font-size: 0.8rem;
    }

    .navigation-tabs {
        display: flex;
        gap: 0.5rem;
        border-bottom: 1px solid var(--border-color, #2d2d3f);
        margin-bottom: 1.5rem;
        overflow-x: auto;
        white-space: nowrap;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }
    .navigation-tabs::-webkit-scrollbar {
        display: none;
    }
    .nav-tab {
        padding: 0.75rem 1rem;
        color: var(--text-secondary, #9ca3af);
        text-decoration: none;
        font-weight: 600;
        border-bottom: 2px solid transparent;
        flex-shrink: 0;
    }
    .nav-tab.active {
        color: var(--color-primary, #6366f1);
        border-bottom-color: var(--color-primary, #6366f1);
    }

    .admin-tools-container {
        margin-bottom: 1.5rem;
    }

    .kanban-board-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.25rem;
        align-items: start;
    }

    @@media (max-width: 900px) {
        .kanban-page-container {
            padding: 1rem;
        }
        .page-header {
            flex-direction: column;
            align-items: stretch;
            gap: 0.75rem;
        }
        .project-title {
            font-size: 1.4rem;
            line-height: 1.25;
        }
        .project-status-box {
            width: 100%;
            justify-content: flex-start;
        }
        .kanban-board-grid {
            display: flex;
            flex-wrap: nowrap;
            overflow-x: auto;
            overflow-y: hidden;
            scroll-snap-type: x mandatory;
            scroll-behavior: smooth;
            -webkit-overflow-scrolling: touch;
            gap: 1rem;
            padding-bottom: 1rem;
            margin-left: -1rem;
            margin-right: -1rem;
            padding-left: 1rem;
            padding-right: 1rem;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }
        .kanban-board-grid::-webkit-scrollbar {
            display: none;
        }
        .kanban-column {
            flex: 0 0 85vw;
            min-width: 280px;
            max-width: 320px;
            scroll-snap-align: center;
        }
    }

    .kanban-column {
        background-color: var(--bg-card-alt);
        border-radius: 10px;
        border: 1px solid var(--border-color);
        display: flex;
        flex-direction: column;
        min-height: 500px;
        overflow: hidden;
    }

    .column-header {
        padding: 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--border-color);
        background-color: var(--bg-card);
    }
    .column-header-left {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .btn-add-task-header {
        background-color: var(--color-primary);
        color: #ffffff;
        border: none;
        border-radius: 50%;
        width: 22px;
        height: 22px;
        font-size: 0.95rem;
        font-weight: 700;
        line-height: 1;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.15s, opacity 0.15s;
        padding: 0;
    }
    .btn-add-task-header:hover {
        transform: scale(1.1);
        opacity: 0.9;
    }
    .btn-add-task-column {
        background-color: transparent;
        border: 1px dashed var(--border-color);
        color: var(--color-primary);
        border-radius: 8px;
        padding: 0.6rem;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        width: 100%;
        text-align: center;
        margin-top: 0.5rem;
        transition: background-color 0.15s, border-color 0.15s;
    }
    .btn-add-task-column:hover {
        background-color: var(--bg-card);
        border-color: var(--color-primary);
    }
    .column-title {
        font: var(--font-h5, 600 1rem/1.3 'Inter', sans-serif);
        margin: 0;
        color: var(--text-primary);
