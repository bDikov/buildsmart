@page "/project-detail"
@page "/projects/{ProjectIdParam:guid}"
@using BuildSmart.SharedUI.ViewModels
@using BuildSmart.SharedUI.GraphQL
@using System.ComponentModel
@using BuildSmart.SharedUI.Components
@layout BuildSmart.SharedUI.Components.Layout.MainLayout
@implements IDisposable
@inject ProjectDetailViewModel ViewModel
@inject NavigationManager NavManager
@inject BuildSmart.SharedUI.Services.SignalRService SignalRService
@inject BuildSmart.SharedUI.GraphQL.State.BuildSmartApiClientStoreAccessor StoreAccessor
@inject IJSRuntime JSRuntime
@inject BuildSmart.SharedUI.Services.IAuthService AuthService

<ErrorBoundary>
    <ChildContent>
        <div class="project-detail-container">
            @if (!ViewModel.HasLoaded)
            {
                <div class="loading-state">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p>@Loc["ProjectDetail_Loading"]</p>
                </div>
            }
            else if (ViewModel.Project != null)
            {
                <!-- Header -->
                <div class="header-section">
                    <button class="back-btn" @onclick="GoBack">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="19" y1="12" x2="5" y2="12"></line>
                            <polyline points="12 19 5 12 12 5"></polyline>
                        </svg>
                    </button>
                    <div class="header-content">
                        <h2 class="page-title">@ViewModel.Project.Title</h2>
                        <span class="status-badge status-@(ViewModel.Project.Status.ToString().ToLower())">@GetProjectDisplayStatus()</span>
                        @if (ShouldShowConsultationBadge())
                        {
                            <span class="status-badge status-underreview ms-2" style="background-color: rgba(255, 152, 0, 0.15); color: #ff9800; border-color: transparent;">
                                @(IsBulgarian() ? "Заявена Консултация" : "Consultation Requested")
                            </span>
                        }
                    </div>
                </div>

                <ProjectOverviewCard 
                    Project="ViewModel.Project" 
                    IsMasterOfferReady="IsMasterOfferReady()" 
                    OnDownloadMasterOffer="DownloadMasterOffer" 
                    OnContinueDraft='() => NavManager.NavigateTo($"/job-wizard?projectId={ViewModel.Project.Id}")' />

                @if (ViewModel.HasAnyEstimatedPrices || IsGeneratingScope())
                {
                    <div class="overall-total-card @(IsGeneratingScope() ? "generating" : "") @(CanScrollToTasks() ? "interactive" : "") text-center mb-3" @onclick="HandleCardClick">
                        @if (IsGeneratingScope())
                        {
                            <div class="total-status-badge calculating">
                                <span class="status-dot"></span>
                                <span>@(IsBulgarian() ? "Изчисляване в реално време..." : "Calculating in real-time...")</span>
                            </div>
                            
                            @if (ViewModel.HasAnyEstimatedPrices)
                            {
                                <div class="overall-total-label">@Loc["GeneratedOffer_TotalValue"] @(IsBulgarian() ? "(останалите се изчисляват...)" : "(remaining are being calculated...)")</div>
                                <div class="price-display">
                                    <span class="price-currency">€</span>
                                    <span class="price-amount-integer">@GetFormattedIntegerPart(ViewModel.OverallTotalEstimatedPrice)</span>
                                    <span class="price-amount-decimal">@GetDecimalSeparator()@GetFormattedDecimalPart(ViewModel.OverallTotalEstimatedPrice)</span>
                                </div>
                            }
                            else
                            {
                                <div class="price-display loading-text">
                                    <span>@(IsBulgarian() ? "Подготовка..." : "Preparing...")</span>
                                </div>
                            }
                            
                            <p class="overall-total-desc mb-0">
                                @if (IsBulgarian())
                                {
                                    <span>Нашият AI строителен мениджър изготвя подробен Количествено-стойностен разчет. Можете да следите прогреса по-долу в реално време.</span>
                                }
                                else
                                {
                                    <span>Our AI construction manager is preparing a detailed Quantity-Cost estimate. You can track the progress below in real-time.</span>
                                }
                            </p>
                        }
                        else
                        {
                            <div class="total-status-badge ready">
                                <span class="status-dot"></span>
                                <span>@(IsBulgarian() ? "Готов индивидуален разчет" : "Individual Estimate Ready")</span>
                            </div>
                            
                            <div class="overall-total-label">@Loc["GeneratedOffer_TotalValue"]</div>
                            <div class="price-display">
                                <span class="price-currency">€</span>
                                <span class="price-amount-integer">@GetFormattedIntegerPart(ViewModel.OverallTotalEstimatedPrice)</span>
                                <span class="price-amount-decimal">@GetDecimalSeparator()@GetFormattedDecimalPart(ViewModel.OverallTotalEstimatedPrice)</span>
                            </div>
                            
                            <p class="overall-total-desc mb-0">
                                @if (IsBulgarian())
                                {
                                    <span>Вашият индивидуален ценови разчет е готов! Кликнете тук, за да разгледате разчета по категории, или изтеглете офертата от следващите стъпки по-долу.</span>
                                }
                                else
                                {
                                    <span>Your custom price estimate is ready! Click here to inspect the category breakdowns, or download the offer from the next steps below.</span>
                                }
                            </p>
                        }
                    </div>
                }

                <!-- Next Steps Component -->
                <ProjectNextStepsCard 
                    Project="ViewModel.Project"
                    OnSubmitToAdmin="SubmitProjectToAdmin"
                    OnDownloadMasterOffer="DownloadMasterOffer"
                    OnAskAdmin="AskAdminQuestion" />

                <h3 id="job-posts-section" class="section-title mt-4">@Loc["ProjectDetail_JobsTitle"]</h3>

                <div class="job-posts-list">
                    @if (ViewModel.JobPosts == null || !ViewModel.JobPosts.Any())
                    {
                        <p class="text-muted fst-italic">@Loc["ProjectDetail_NoJobs"]</p>
                    }
                    else
                    {
                        @foreach (var jobVm in ViewModel.JobPosts)
                        {
                            <JobPostCard 
                                JobVm="jobVm" 
                                IsAdmin="_isAdmin"
                                IsExpanded="_expandedJobs.Contains(jobVm.JobPost.Id)" 
                                OnToggleExpansion="() => ToggleJobExpansion(jobVm.JobPost.Id)" 
                                OnViewAuctionHub="() => ViewModel.ViewAuctionHubCommand.ExecuteAsync(jobVm.JobPost)"
                                OnViewAIOffer='() => NavManager.NavigateTo($"/GeneratedOfferPage?jobId={jobVm.JobPost.Id}")'
                                OnEditAnswers='() => NavManager.NavigateTo($"/job-wizard?projectId={ViewModel.Project.Id}&jobId={jobVm.JobPost.Id}&targetCategoryId={jobVm.JobPost.ServiceCategory.Id}")'
                                OnReviewScope="() => ViewModel.ReviewScopeCommand.ExecuteAsync(jobVm.JobPost)"
                                OnSubmitToAdmin="SubmitProjectToAdmin"
                                OnAskAdmin="AskAdminQuestion" />
                        }
                    }
                </div>
            }
        </div>
    </ChildContent>
    <ErrorContent>
        <div class="alert alert-danger m-3">
            <h4>Rendering Error</h4>
            <p>@context.Message</p>
        </div>
    </ErrorContent>
</ErrorBoundary>

@code {
    [SupplyParameterFromQuery]
    public Guid? ProjectId { get; set; }
    
    [Parameter]
    public Guid? ProjectIdParam { get; set; }

    [SupplyParameterFromQuery]
    public Guid? JobId { get; set; }

    private HashSet<Guid> _expandedJobs = new();

    private void ToggleJobExpansion(Guid jobId)
    {
        if (_expandedJobs.Contains(jobId))
            _expandedJobs.Remove(jobId);
        else
            _expandedJobs.Add(jobId);
            
        InvokeAsync(StateHasChanged);
    }

    private bool IsMasterOfferReady()
    {
        if (ViewModel.Project == null)
            return false;

        if (!ViewModel.Project.HasOfferPdf)
            return false;

        if (ViewModel.Project.JobPosts != null && ViewModel.Project.JobPosts.Any(jp => 
            jp.Status == JobPostStatus.Draft || 
            jp.Status == JobPostStatus.GeneratingScope || 
            jp.Status == JobPostStatus.Rejected))
        {
            return false;
        }

        return true;
    }
    
    private void DownloadMasterOffer()
    {
        if (ViewModel.Project != null)
        {
            var url = $"{ApiConfig.GetBaseUrl()}/api/offers/{ViewModel.Project.Id}/download";
            NavManager.NavigateTo(url, forceLoad: true);
        }
    }

    private void SubmitProjectToAdmin()
    {
        if (ViewModel.Project != null)
        {
            NavManager.NavigateTo($"/request-consultation?projectId={ViewModel.Project.Id}");
        }
    }

    private void AskAdminQuestion()
    {
        // TODO: Navigate to messaging/Q&A page or open a modal
        NavManager.NavigateTo($"/project-messages?projectId={ViewModel.Project?.Id}");
    }

    private bool _isAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        ViewModel.PropertyChanged += OnViewModelPropertyChanged;
        SignalRService.NotificationReceived += OnNotificationReceived;
        
        if (!ProjectId.HasValue && ProjectIdParam.HasValue)
        {
            ProjectId = ProjectIdParam.Value;
        }

        var query = new Dictionary<string, object>();
        if (ProjectId.HasValue) query["ProjectId"] = ProjectId.Value;
        if (JobId.HasValue) query["JobId"] = JobId.Value;
        
        ViewModel.ApplyQueryAttributes(query);

        try
        {
            var token = await AuthService.GetTokenAsync();
            var role = AuthService.GetUserRoleFromToken(token);
            _isAdmin = string.Equals(role, "Admin", StringComparison.OrdinalIgnoreCase) || 
                       string.Equals(role, "ADMIN", StringComparison.OrdinalIgnoreCase);
        }
        catch { }
    }

    private void OnNotificationReceived(string title, string msg, object? data)
    {
        if (ViewModel.Project == null) return;
        InvokeAsync(async () =>
        {
            try { StoreAccessor.OperationStore.Clear(); } catch { }
            await ViewModel.LoadProjectAsync(ViewModel.Project.Id);
            StateHasChanged();
        });
    }

    private void OnViewModelPropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private bool IsGeneratingScope()
    {
        if (ViewModel.Project?.JobPosts == null) return false;
        return ViewModel.Project.JobPosts.Any(jp => jp.Status == JobPostStatus.GeneratingScope);
    }

    private bool IsBulgarian()
    {
        return System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("bg", StringComparison.OrdinalIgnoreCase);
    }

    private string GetProjectDisplayStatus()
    {
        if (ViewModel.Project == null) return string.Empty;

        if (ViewModel.Project.Status == ProjectStatus.UnderReview)
        {
            var jobs = ViewModel.Project.JobPosts;
            if (jobs != null && jobs.Any())
            {
                if (jobs.Any(jp => jp.Status == JobPostStatus.Draft || jp.Status == JobPostStatus.GeneratingScope))
                {
                    return Loc["Status_GeneratingScope"];
                }
                
                if (jobs.Any(jp => jp.Status == JobPostStatus.WaitingForUserReview))
                {
                    return Loc["Status_WaitingForUserReview"];
                }
            }
        }

        return Loc[$"Status_{ViewModel.Project.Status}"];
    }

    private bool ShouldShowConsultationBadge()
    {
        if (ViewModel.Project == null) return false;
        if (ViewModel.Project.Status != ProjectStatus.UnderReview) return false;
        
        var jobs = ViewModel.Project.JobPosts;
        if (jobs == null || !jobs.Any()) return true;
        
        return !jobs.Any(jp => 
            jp.Status == JobPostStatus.WaitingForUserReview || 
            jp.Status == JobPostStatus.Draft || 
            jp.Status == JobPostStatus.GeneratingScope);
    }

    private async Task ScrollToJobPosts()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('job-posts-section')?.scrollIntoView({ behavior: 'smooth' })");
        }
        catch { }
    }

    private async Task ScrollToNextSteps()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('next-steps-section')?.scrollIntoView({ behavior: 'smooth' })");
        }
        catch { }
    }

    private string GetNextActionInlineText()
    {
        if (ViewModel.Project == null) return string.Empty;
        
        var isMasterOfferReady = IsMasterOfferReady();
        var draftJobs = ViewModel.Project.JobPosts?.Where(jp => jp.Status == JobPostStatus.Draft).ToList();
        
        if (isMasterOfferReady)
        {
            return IsBulgarian() ? "изтеглете официалната оферта в PDF" : "download the official PDF offer";
        }
        else if (draftJobs != null && draftJobs.Any())
        {
            return IsBulgarian() ? "попълнете оставащите въпросници" : "complete the remaining questionnaires";
        }
        else
        {
            return IsBulgarian() ? "изпратете проекта за консултация" : "submit the project for consultation";
        }
    }

    private string GetNextActionButtonText()
    {
        if (ViewModel.Project == null) return string.Empty;
        
        var isMasterOfferReady = IsMasterOfferReady();
        var draftJobs = ViewModel.Project.JobPosts?.Where(jp => jp.Status == JobPostStatus.Draft).ToList();
        
        if (isMasterOfferReady)
        {
            return IsBulgarian() ? "Изтеглете Офертата" : "Download Offer";
        }
        else if (draftJobs != null && draftJobs.Any())
        {
            return IsBulgarian() ? "Продължете Въпросника" : "Resume Questionnaire";
        }
        else
        {
            return IsBulgarian() ? "Изпратете за Преглед" : "Submit for Review";
        }
    }

    private string GetFormattedIntegerPart(decimal price)
    {
        var rounded = Math.Truncate(price);
        return rounded.ToString("N0", System.Globalization.CultureInfo.CurrentUICulture);
    }

    private string GetFormattedDecimalPart(decimal price)
    {
        var cents = Math.Round((price - Math.Truncate(price)) * 100);
        if (cents < 0) cents = -cents;
        return cents.ToString("00");
    }

    private string GetDecimalSeparator()
    {
        return System.Globalization.CultureInfo.CurrentUICulture.NumberFormat.NumberDecimalSeparator;
    }

    private bool CanScrollToTasks()
    {
        return !IsGeneratingScope() || ViewModel.HasAnyEstimatedPrices;
    }

    private async Task HandleCardClick()
    {
        if (CanScrollToTasks())
        {
            await ScrollToJobPosts();
        }
    }

    private void HandleNextAction()
    {
        if (ViewModel.Project == null) return;
        
        var isMasterOfferReady = IsMasterOfferReady();
        var draftJobs = ViewModel.Project.JobPosts?.Where(jp => jp.Status == JobPostStatus.Draft).ToList();
        
        if (isMasterOfferReady)
        {
            DownloadMasterOffer();
        }
        else if (draftJobs != null && draftJobs.Any())
        {
            var firstDraft = draftJobs.First();
            NavManager.NavigateTo($"/job-wizard?projectId={ViewModel.Project.Id}&jobId={firstDraft.Id}&targetCategoryId={firstDraft.ServiceCategory.Id}");
        }
        else
        {
            SubmitProjectToAdmin();
        }
    }

    private void GoBack()
    {
        NavManager.NavigateTo("/my-projects");
    }

    public void Dispose()
    {
        if (ViewModel != null)
        {
            ViewModel.PropertyChanged -= OnViewModelPropertyChanged;
            ViewModel.Dispose();
        }
        SignalRService.NotificationReceived -= OnNotificationReceived;
    }
}