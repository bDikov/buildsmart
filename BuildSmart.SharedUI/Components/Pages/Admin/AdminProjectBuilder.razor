@code {
    private bool IsLoading { get; set; } = true;
    private bool IsSubmitting { get; set; } = false;
    private string CreationMode { get; set; } = "TradesmanOffer";

    private List<UserLookupDto> Homeowners { get; set; } = new();
    private List<UserLookupDto> Tradesmen { get; set; } = new();
    private List<ServiceCategory> AvailableCategories { get; set; } = new();

    private Guid SelectedHomeownerId { get; set; } = Guid.Empty;
    private string SelectedOfferPresetKey { get; set; } = "lyulin";
    private Guid PresetTradesmanId { get; set; } = Guid.Empty;

    private string ProjectTitle { get; set; } = string.Empty;
    private string ProjectLocation { get; set; } = "с. Люлин, София";
    private string ProjectDescription { get; set; } = string.Empty;
    private decimal AdminMarkupPercentage { get; set; } = 20.0m;
    private List<Guid> SelectedCategoryIds { get; set; } = new();
    private Dictionary<Guid, Guid> CategoryTradesmanAssignments { get; set; } = new();
    private bool SetAsActiveDirectly { get; set; } = false;

    private List<CustomOfferPhaseDto> CurrentOfferPhases { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Homeowners = await ProjectService.GetHomeownersLookupAsync();
            Tradesmen = await ProjectService.GetTradesmenLookupAsync();
            AvailableCategories = await ProjectService.GetTradeCategoriesAsync();

            var matchedHomeowner = Homeowners.FirstOrDefault(h => h.Email != null && h.Email.Equals("h.hristovv00@gmail.com", StringComparison.OrdinalIgnoreCase));
            if (matchedHomeowner != null)
            {
                SelectedHomeownerId = matchedHomeowner.UserId;
            }
            else if (Homeowners.Any())
            {
                SelectedHomeownerId = Homeowners.First().UserId;
            }

            var matchedTradesman = Tradesmen.FirstOrDefault(t => t.Email != null && t.Email.Equals("buildcapitalpro@gmail.com", StringComparison.OrdinalIgnoreCase));
            if (matchedTradesman != null)
            {
                PresetTradesmanId = matchedTradesman.UserId;
            }
            else if (Tradesmen.Any())
            {
                PresetTradesmanId = Tradesmen.First().UserId;
            }

            LoadPresetData("lyulin");
        }
        catch (Exception ex)
        {
            await AlertService.DisplayAlert("Error Loading Data", ex.Message, "OK");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void SetMode(string mode)
    {
        CreationMode = mode;
        if (mode == "TradesmanOffer" && string.IsNullOrWhiteSpace(ProjectTitle))
        {
            LoadPresetData(SelectedOfferPresetKey);
        }
    }

    private async Task OnOfferPresetChanged(ChangeEventArgs e)
    {
        SelectedOfferPresetKey = e.Value?.ToString() ?? "lyulin";
        if (SelectedOfferPresetKey == "custom")
        {
            await LoadSavedCustomPresetAsync();
        }
        else
        {
            LoadPresetData(SelectedOfferPresetKey);
        }
    }

    private void LoadPresetData(string key)
    {
        if (key == "lyulin")
        {
            ProjectTitle = "Ремонт и боядисване на къща - с. Люлин";
            ProjectLocation = "с. Люлин, София";
            ProjectDescription = "Цялостна трансформация с изработка на бутикови интериорни обшивки от масивен дъб (състаряване, байцване и лакиране), подготовка, шпакловка, ремонт на пукнатини, частични електроуслуги и интериорно боядисване по оферта BUILD CAPITAL.";
            CurrentOfferPhases = GetLyulinOfferPreset();
        }
    }

    private decimal GetOfferPresetTotal()
    {
        return CurrentOfferPhases.SelectMany(p => p.Items).Sum(i => i.TotalEur);
    }

    private decimal GetMarkupAmountEur()
    {
        return Math.Round(GetOfferPresetTotal() * (AdminMarkupPercentage / 100.0m), 2);
    }

    private decimal GetHomeownerTotalEur()
    {
        return GetOfferPresetTotal() + GetMarkupAmountEur();
    }

    private void AddNewPhase()
    {
        var defaultCat = AvailableCategories.FirstOrDefault()?.Name ?? "Подготвителни работи";
        var newPhase = new CustomOfferPhaseDto
        {
            PhaseTitle = $"{CurrentOfferPhases.Count + 1}. Нова категория / фаза",
            CategoryName = defaultCat,
            Items = new List<CustomOfferItemDto>
            {
                new CustomOfferItemDto
                {
                    Title = "Нова строителна задача",
                    Description = "Описание на конкретните СМР дейности",
                    Unit = "м²",
                    Quantity = 1,
                    UnitPriceEur = 10.00m
                }
            }
        };
        CurrentOfferPhases.Add(newPhase);
    }

    private void RemovePhase(CustomOfferPhaseDto phase)
    {
        CurrentOfferPhases.Remove(phase);
    }

    private void MovePhaseUp(int index)
    {
        if (index > 0 && index < CurrentOfferPhases.Count)
        {
            var item = CurrentOfferPhases[index];
            CurrentOfferPhases.RemoveAt(index);
            CurrentOfferPhases.Insert(index - 1, item);
        }
    }

    private void MovePhaseDown(int index)
    {
        if (index >= 0 && index < CurrentOfferPhases.Count - 1)
        {
            var item = CurrentOfferPhases[index];
            CurrentOfferPhases.RemoveAt(index);
            CurrentOfferPhases.Insert(index + 1, item);
        }
    }

    private void AddTaskToPhase(CustomOfferPhaseDto phase)
    {
        phase.Items.Add(new CustomOfferItemDto
        {
            Title = "Нова задача",
            Description = "Описание на извършваната услуга",
            Unit = "м²",
            Quantity = 1,
            UnitPriceEur = 10.00m
        });
    }

    private void RemoveTask(CustomOfferPhaseDto phase, CustomOfferItemDto item)
    {
        phase.Items.Remove(item);
    }

    private async Task SaveCustomPresetAsync()
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(CurrentOfferPhases);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "buildsmart_admin_custom_offer_preset", json);
            SelectedOfferPresetKey = "custom";
            await AlertService.DisplayAlert("Preset Saved", "Custom offer preset configuration saved to local storage!", "OK");
        }
        catch (Exception ex)
        {
            await AlertService.DisplayAlert("Error", $"Could not save preset: {ex.Message}", "OK");
        }
    }

    private async Task LoadSavedCustomPresetAsync()
    {
        try
        {
            var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "buildsmart_admin_custom_offer_preset");
            if (!string.IsNullOrWhiteSpace(json))
            {
                var loaded = System.Text.Json.JsonSerializer.Deserialize<List<CustomOfferPhaseDto>>(json);
                if (loaded != null && loaded.Any())
                {
                    CurrentOfferPhases = loaded;
                    await AlertService.DisplayAlert("Preset Loaded", "Loaded custom offer preset successfully!", "OK");
                    return;
                }
            }
            await AlertService.DisplayAlert("No Saved Preset", "No custom preset found in local storage. Loaded default preset.", "OK");
            LoadPresetData("lyulin");
        }
        catch (Exception ex)
        {
            await AlertService.DisplayAlert("Error Loading Preset", ex.Message, "OK");
            LoadPresetData("lyulin");
        }
    }

    private void ResetToDefaultPreset()
    {
        SelectedOfferPresetKey = "lyulin";
        LoadPresetData("lyulin");
    }

    private string GetCategoryTradesman(Guid categoryId)
    {
        if (CategoryTradesmanAssignments.TryGetValue(categoryId, out var tradesmanId))
        {
            return tradesmanId.ToString();
        }
        return Guid.Empty.ToString();
    }

    private void SetCategoryTradesman(Guid categoryId, string? tradesmanIdStr)
    {
        if (Guid.TryParse(tradesmanIdStr, out var tradesmanId) && tradesmanId != Guid.Empty)
        {
            CategoryTradesmanAssignments[categoryId] = tradesmanId;
        }
        else
        {
            CategoryTradesmanAssignments.Remove(categoryId);
        }
    }

    private void ToggleCategory(Guid id)
    {
        if (SelectedCategoryIds.Contains(id))
        {
            SelectedCategoryIds.Remove(id);
            CategoryTradesmanAssignments.Remove(id);
        }
        else
        {
            SelectedCategoryIds.Add(id);
        }
    }

    private async Task CreateProject()
    {
        if (SelectedHomeownerId == Guid.Empty)
        {
            await AlertService.DisplayAlert("Validation Error", "Please select a Homeowner context.", "OK");
            return;
        }

        if (string.IsNullOrWhiteSpace(ProjectTitle))
        {
            await AlertService.DisplayAlert("Validation Error", "Please enter a project title.", "OK");
            return;
        }

        if (CreationMode == "Catalog" && !SelectedCategoryIds.Any())
        {
            await AlertService.DisplayAlert("Validation Error", "Please select at least one trade category.", "OK");
            return;
        }

        IsSubmitting = true;
        try
        {
            Guid projectId;

            if (CreationMode == "TradesmanOffer")
            {
                var tradesmanMap = new Dictionary<Guid, Guid>(CategoryTradesmanAssignments);
                if (PresetTradesmanId != Guid.Empty)
                {
                    tradesmanMap[Guid.Empty] = PresetTradesmanId;
                    foreach (var cat in AvailableCategories)
                    {
                        if (!tradesmanMap.ContainsKey(cat.Id))
                        {
                            tradesmanMap[cat.Id] = PresetTradesmanId;
                        }
                    }
                }

                projectId = await ProjectService.CreateProjectFromOfferTemplateAsync(
                    SelectedHomeownerId,
                    ProjectTitle,
                    ProjectDescription,
                    ProjectLocation,
                    tradesmanMap,
                    AdminMarkupPercentage,
                    CurrentOfferPhases,
                    SelectedCategoryIds);
            }
            else
            {
                projectId = await ProjectService.CreateProjectForUserAsync(
                    SelectedHomeownerId,
                    ProjectTitle,
                    ProjectDescription,
                    SelectedCategoryIds,
                    ProjectLocation,
                    CategoryTradesmanAssignments,
                    AdminMarkupPercentage);
            }

            if (SetAsActiveDirectly)
            {
                await ProjectService.SetProjectStatusAsync(projectId, ProjectStatus.Active, Guid.Empty);
            }

            await AlertService.DisplayAlert("Success", "Project created successfully with tradesmen assigned!", "OK");
            NavigationManager.NavigateTo($"/projects/{projectId}/kanban");
        }
        catch (Exception ex)
        {
            await AlertService.DisplayAlert("Creation Error", ex.Message, "OK");
        }
        finally
        {
            IsSubmitting = false;
        }
    }

