@page "/admin/projects/create"
@using BuildSmart.Core.Application.DTOs
@using BuildSmart.Core.Domain.Entities
@using BuildSmart.Core.Domain.Enums
@inject BuildSmart.Core.Application.Interfaces.IProjectManagementService ProjectService
@inject BuildSmart.SharedUI.Services.IAlertService AlertService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<div class="admin-builder-container">
    <div class="header-card">
        <h2 class="page-title">Admin Project Builder</h2>
        <p class="subtitle">Create and configure renovation projects on behalf of a specific Homeowner user.</p>
    </div>

    @if (IsLoading)
    {
        <div class="loading-box">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else
    {
        <!-- Mode Selection Tabs -->
        <div class="mode-tabs">
            <button class="mode-tab-btn @(CreationMode == "Catalog" ? "active" : "")" @onclick='() => SetMode("Catalog")'>
                Standard Category Catalog
            </button>
            <button class="mode-tab-btn @(CreationMode == "TradesmanOffer" ? "active" : "")" @onclick='() => SetMode("TradesmanOffer")'>
                Import Tradesman Offer Preset
            </button>
        </div>

        <div class="form-card">
            <!-- Homeowner Context -->
            <div class="form-group">
                <label class="form-label">Select Homeowner Context *</label>
                <select class="form-input" @bind="SelectedHomeownerId">
                    <option value="@Guid.Empty">-- Select Homeowner Account --</option>
                    @foreach (var user in Homeowners)
                    {
                        <option value="@user.UserId">@user.FullName (@user.Email)</option>
                    }
                </select>
            </div>

            @if (CreationMode == "TradesmanOffer")
            {
                <!-- Offer Preset Selection -->
                <div class="form-group">
                    <label class="form-label">Select Tradesman Offer Preset *</label>
                    <select class="form-input" value="@SelectedOfferPresetKey" @onchange="OnOfferPresetChanged">
                        <option value="lyulin">Ремонт, Мебели, Електро и Извозване — с. Люлин (Пълен пакет, €27,041.57 EUR base / €32,449.88 client total)</option>
                        <option value="custom">Запазен собствен шаблон / оферта (Custom Preset)</option>
                    </select>
                </div>

                <!-- Assigned Tradesman for Offer -->
                <div class="form-group">
                    <label class="form-label">Assign Tradesman to Project *</label>
                    <select class="form-input" @bind="PresetTradesmanId">
                        <option value="@Guid.Empty">-- Select Tradesman --</option>
                        @foreach (var t in Tradesmen)
                        {
                            <option value="@t.UserId">@t.FullName (@t.Email)</option>
                        }
                    </select>
                </div>
            }

            <div class="form-group">
                <label class="form-label">Project Title *</label>
                <input class="form-input" type="text" placeholder="e.g. Full Apartment Modern Renovation" @bind="ProjectTitle" />
            </div>

            <div class="form-group">
                <label class="form-label">Project Location</label>
                <input class="form-input" type="text" placeholder="e.g. Sofia, Center" @bind="ProjectLocation" />
            </div>

            <div class="form-group">
                <label class="form-label">General Description & Requirements</label>
                <textarea class="form-input" rows="3" placeholder="Describe the scope, client requirements and timeline..." @bind="ProjectDescription"></textarea>
            </div>

            <div class="form-group">
                <label class="form-label">Homeowner Markup Percentage (%)</label>
                <div class="d-flex align-items-center gap-2">
                    <input class="form-input" type="number" min="0" max="200" step="1" style="max-width: 140px; font-weight: 600;" @bind="AdminMarkupPercentage" />
                    <span class="text-muted" style="font-size: 0.85rem;">% (Homeowner Client Price = Tradesman Base Price + Markup %)</span>
                </div>
            </div>

            @if (CreationMode == "Catalog")
            {
                <div class="form-group">
                    <label class="form-label">Select Trade Categories & Assign Tradesmen *</label>
                    <div class="category-grid">
                        @foreach (var cat in AvailableCategories)
                        {
                            bool isSelected = SelectedCategoryIds.Contains(cat.Id);
                            <div class="category-card-item @(isSelected ? "selected-card" : "")">
                                <div class="category-checkbox-card @(isSelected ? "selected" : "")" @onclick="() => ToggleCategory(cat.Id)">
                                    <input type="checkbox" checked="@isSelected" @onclick:stopPropagation="true" @onchange="() => ToggleCategory(cat.Id)" />
                                    <span class="category-name">@cat.Name</span>
                                </div>

                                @if (isSelected)
                                {
                                    <div class="tradesman-select-box mt-2">
                                        <label class="form-sublabel">Assign Tradesman (Optional):</label>
                                        <select class="form-input form-input-sm" value="@GetCategoryTradesman(cat.Id)" @onchange="(e) => SetCategoryTradesman(cat.Id, e.Value?.ToString())">
                                            <option value="@Guid.Empty">-- Select Tradesman --</option>
                                            @foreach (var t in Tradesmen)
                                            {
                                                <option value="@t.UserId">@t.FullName (@t.Email)</option>
                                            }
                                        </select>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <!-- Interactive Predefined Work Board Setup -->
                <div class="offer-preview-card">
                    <div class="offer-preview-header">
                        <div class="header-titles">
                            <span class="offer-title">Predefined Work Board Setup</span>
                            <p class="subtitle mb-0" style="font-size: 0.85rem;">
                                Fully configure categories, add custom tasks, adjust units, quantities and base prices before generating the project.
                            </p>
                        </div>
                        <div class="header-actions">
                            <button type="button" class="btn-preset-action" @onclick="AddNewPhase">
                                + Add Category / Phase
                            </button>
                            <button type="button" class="btn-preset-action btn-secondary" @onclick="SaveCustomPresetAsync">
                                Save Custom Preset
                            </button>
                            <button type="button" class="btn-preset-action btn-outline" @onclick="ResetToDefaultPreset">
                                Reset Default Preset
                            </button>
                        </div>
                    </div>

                    <!-- Live Financial Summary Metrics -->
                    <div class="financial-summary-bar">
                        <div class="summary-card">
                            <span class="summary-label">Tradesman Base Total</span>
                            <span class="summary-amount">€@GetOfferPresetTotal().ToString("N2")</span>
                        </div>
                        <div class="summary-card">
                            <span class="summary-label">Admin Markup (@AdminMarkupPercentage%)</span>
                            <span class="summary-amount text-success">+€@GetMarkupAmountEur().ToString("N2")</span>
                        </div>
                        <div class="summary-card highlight">
                            <span class="summary-label">Homeowner Client Offer Total</span>
                            <span class="summary-amount">€@GetHomeownerTotalEur().ToString("N2")</span>
                        </div>
                    </div>

                    <div class="offer-phases-list">
                        @for (int pIdx = 0; pIdx < CurrentOfferPhases.Count; pIdx++)
                        {
                            var phaseIndex = pIdx;
                            var phase = CurrentOfferPhases[phaseIndex];
                            <div class="phase-editor-card mb-3">
                                <div class="phase-editor-header">
                                    <div class="phase-header-left">
                                        <span class="phase-badge">Phase @(phaseIndex + 1)</span>
                                        <input class="form-input phase-title-input" type="text" @bind="phase.PhaseTitle" placeholder="Phase Title (e.g. 1. Хамалски услуги)" />
                                    </div>
                                    <div class="phase-header-right">
                                        <select class="form-input form-input-sm phase-cat-select" @bind="phase.CategoryName">
                                            <option value="">-- System Category Mapping --</option>
                                            @foreach (var cat in AvailableCategories)
                                            {
                                                <option value="@cat.Name">@cat.Name</option>
                                            }
                                        </select>
                                        <div class="phase-reorder-btns">
                                            <button type="button" class="btn-icon" disabled="@(phaseIndex == 0)" @onclick="() => MovePhaseUp(phaseIndex)" title="Move Up">↑</button>
                                            <button type="button" class="btn-icon" disabled="@(phaseIndex == CurrentOfferPhases.Count - 1)" @onclick="() => MovePhaseDown(phaseIndex)" title="Move Down">↓</button>
                                        </div>
                                        <button type="button" class="btn-icon btn-danger" @onclick="() => RemovePhase(phase)" title="Delete Phase">✕</button>
                                    </div>
                                </div>

                                <div class="phase-items-editor">
                                    <div class="items-table-header">
                                        <div class="col-task-info">Task Title & Details</div>
                                        <div class="col-unit">Unit</div>
                                        <div class="col-qty">Quantity</div>
                                        <div class="col-price">Base Price (€)</div>
                                        <div class="col-subtotal">Subtotal (€)</div>
                                        <div class="col-action"></div>
                                    </div>

                                    @foreach (var item in phase.Items)
                                    {
                                        <div class="item-editor-row">
                                            <div class="col-task-info">
                                                <input class="form-input form-input-sm task-title-input" type="text" @bind="item.Title" placeholder="Task Title (e.g. Шпакловане)" />
                                                <input class="form-input form-input-sm task-desc-input" type="text" @bind="item.Description" placeholder="Task Details / Description" />
                                            </div>
                                            <div class="col-unit">
                                                <input class="form-input form-input-sm text-center" type="text" list="units-list" @bind="item.Unit" placeholder="м²" />
                                            </div>
                                            <div class="col-qty">
                                                <input class="form-input form-input-sm text-right" type="number" step="0.1" min="0" @bind="item.Quantity" />
                                            </div>
                                            <div class="col-price">
                                                <input class="form-input form-input-sm text-right" type="number" step="0.01" min="0" @bind="item.UnitPriceEur" />
                                            </div>
                                            <div class="col-subtotal">
                                                <span class="item-subtotal-val">€@item.TotalEur.ToString("N2")</span>
                                            </div>
                                            <div class="col-action">
                                                <button type="button" class="btn-icon-sm btn-danger" @onclick="() => RemoveTask(phase, item)" title="Remove Task">✕</button>
                                            </div>
                                        </div>
                                    }

                                    <div class="add-task-bar">
                                        <button type="button" class="btn-add-task" @onclick="() => AddTaskToPhase(phase)">
                                            + Add Task to @(string.IsNullOrWhiteSpace(phase.CategoryName) ? "Phase" : phase.CategoryName)
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="add-phase-bottom-bar">
                            <button type="button" class="btn-add-phase-large" @onclick="AddNewPhase">
                                + Add Work Category / Phase
                            </button>
                        </div>
                    </div>
                </div>

                <datalist id="units-list">
                    <option value="м²" />
                    <option value="бр" />
                    <option value="лм" />
                    <option value="услуга" />
                    <option value="курс" />
                    <option value="контейнер" />
                    <option value="кг" />
                    <option value="комплект" />
                    <option value="м" />
                </datalist>

                <!-- Additional Trade Categories for Predefined Offer -->
                <div class="form-group mt-4">
                    <label class="form-label">Include Additional Trade Categories (Optional)</label>
                    <p class="subtitle" style="margin-bottom: 0.75rem;">Select extra trade categories to append to this predefined project offer even if they weren't in the initial preset:</p>
                    <div class="category-grid">
                        @foreach (var cat in AvailableCategories)
                        {
                            bool isSelected = SelectedCategoryIds.Contains(cat.Id);
                            <div class="category-card-item @(isSelected ? "selected-card" : "")">
                                <div class="category-checkbox-card @(isSelected ? "selected" : "")" @onclick="() => ToggleCategory(cat.Id)">
                                    <input type="checkbox" checked="@isSelected" @onclick:stopPropagation="true" @onchange="() => ToggleCategory(cat.Id)" />
                                    <span class="category-name">@cat.Name</span>
                                </div>

                                @if (isSelected)
                                {
                                    <div class="tradesman-select-box mt-2">
                                        <label class="form-sublabel">Assign Tradesman (Optional):</label>
                                        <select class="form-input form-input-sm" value="@GetCategoryTradesman(cat.Id)" @onchange="(e) => SetCategoryTradesman(cat.Id, e.Value?.ToString())">
                                            <option value="@Guid.Empty">-- Select Tradesman --</option>
                                            @foreach (var t in Tradesmen)
                                            {
                                                <option value="@t.UserId">@t.FullName (@t.Email)</option>
                                            }
                                        </select>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="form-group">
                <label class="form-label">Initial Project Status</label>
                <div class="status-options">
                    <label class="radio-label">
                        <input type="radio" name="projectStatus" value="Draft" checked="@(!SetAsActiveDirectly)" @onchange="() => SetAsActiveDirectly = false" />
                        Preview / Draft
                    </label>
                    <label class="radio-label">
                        <input type="radio" name="projectStatus" value="Active" checked="@SetAsActiveDirectly" @onchange="() => SetAsActiveDirectly = true" />
                        Active (Enables Work Board immediately)
                    </label>
                </div>
            </div>

            <div class="form-actions">
                <button class="btn-submit-project" @onclick="CreateProject" disabled="@IsSubmitting">
                    @(IsSubmitting ? "Creating Project..." : (CreationMode == "TradesmanOffer" ? "Import & Create Project" : "Create Project"))
                </button>
            </div>
        </div>
    }
</div>

<style>
    .admin-builder-container {
        max-width: 1200px;
        margin: 2rem auto;
        padding: 0 1rem;
        color: var(--text-primary);
    }
    .header-card {
        margin-bottom: 1.5rem;
    }
    .page-title {
        font: var(--font-h2, 700 1.75rem/1.3 'Inter', sans-serif);
        color: var(--text-primary);
    }
    .subtitle {
        color: var(--text-muted);
        font-size: 0.95rem;
        margin-top: 0.25rem;
    }
    .mode-tabs {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }
    .mode-tab-btn {
        background-color: var(--bg-card-alt);
        color: var(--text-muted);
        border: 1px solid var(--border-color);
        padding: 0.65rem 1.25rem;
        border-radius: 8px 8px 0 0;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .mode-tab-btn.active {
        background-color: var(--bg-card);
        color: var(--color-primary);
        border-bottom-color: var(--bg-card);
    }
    .form-card {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 1.75rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        box-shadow: var(--shadow-sm, 0 1px 3px rgba(0,0,0,0.05));
    }
    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .form-label {
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--text-primary);
    }
    .form-input {
        background-color: var(--bg-card-alt);
        color: var(--text-primary);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 0.65rem 0.85rem;
        font-size: 0.9rem;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
        width: 100%;
        box-sizing: border-box;
    }
    .form-input:focus {
        border-color: var(--color-primary);
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
    }
    .form-input::placeholder {
        color: var(--text-muted);
        opacity: 0.7;
    }
    select.form-input option {
        background-color: var(--bg-card);
        color: var(--text-primary);
    }
    .form-sublabel {
        font-size: 0.8rem;
        color: var(--text-muted);
        font-weight: 500;
        margin-bottom: 0.25rem;
        display: block;
    }
    .form-input-sm {
        padding: 0.45rem 0.65rem;
        font-size: 0.85rem;
    }
    .category-card-item {
        background-color: var(--bg-card-alt);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 0.85rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        transition: all 0.2s ease;
    }
    .category-card-item.selected-card {
        border-color: var(--color-primary);
        background-color: rgba(99, 102, 241, 0.05);
    }
    .category-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 0.75rem;
    }
    .category-checkbox-card {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        cursor: pointer;
    }
    .category-checkbox-card.selected {
        border-color: var(--color-primary);
    }
    .category-name {
        color: var(--text-primary);
        font-weight: 600;
        font-size: 0.95rem;
    }
    .offer-preview-card {
        background-color: var(--bg-card-alt);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 1.5rem;
        margin-top: 0.5rem;
    }
    .offer-preview-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 1rem;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 1rem;
        margin-bottom: 1.25rem;
    }
    .offer-title {
        font-weight: 700;
        font-size: 1.1rem;
        color: var(--text-primary);
    }
    .header-actions {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }
    .btn-preset-action {
        background-color: var(--color-primary);
        color: #ffffff;
        border: none;
        padding: 0.5rem 0.9rem;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.2s;
    }
    .btn-preset-action:hover {
        opacity: 0.9;
    }
    .btn-preset-action.btn-secondary {
        background-color: var(--bg-card);
        color: var(--text-primary);
        border: 1px solid var(--border-color);
    }
    .btn-preset-action.btn-outline {
        background-color: transparent;
        color: var(--text-muted);
        border: 1px solid var(--border-color);
    }
    .financial-summary-bar {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }
    .summary-card {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 0.85rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }
    .summary-card.highlight {
        border-color: var(--color-primary);
        background-color: rgba(99, 102, 241, 0.08);
    }
    .summary-label {
        font-size: 0.8rem;
        color: var(--text-muted);
        font-weight: 500;
    }
    .summary-amount {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--text-primary);
    }
    .summary-card.highlight .summary-amount {
        color: var(--color-primary);
    }
    .phase-editor-card {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 1.25rem;
    }
    .phase-editor-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1.25rem;
        flex-wrap: wrap;
    }
    .phase-header-left {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex: 1;
        min-width: 280px;
    }
    .phase-badge {
        background-color: var(--bg-card-alt);
        color: var(--color-primary);
        font-size: 0.75rem;
        font-weight: 700;
        padding: 0.4rem 0.75rem;
        border-radius: 6px;
        border: 1px solid var(--border-color);
        white-space: nowrap;
    }
    .phase-title-input {
        font-weight: 600;
        font-size: 0.95rem;
        background-color: var(--bg-card-alt);
    }
    .phase-header-right {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .phase-cat-select {
        min-width: 200px;
        height: 38px;
    }
    .phase-reorder-btns {
        display: flex;
        gap: 0.25rem;
    }
    .btn-icon {
        background: var(--bg-card-alt);
        border: 1px solid var(--border-color);
        color: var(--text-primary);
        width: 36px;
        height: 36px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 0.9rem;
        font-weight: 600;
    }
    .btn-icon:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }
    .btn-icon.btn-danger {
        color: #ef4444;
        border-color: rgba(239, 68, 68, 0.3);
    }
    .btn-icon.btn-danger:hover {
        background-color: rgba(239, 68, 68, 0.1);
    }
    .btn-icon-sm {
        background: transparent;
        border: none;
        color: var(--text-muted);
        cursor: pointer;
        padding: 0.3rem 0.5rem;
        border-radius: 4px;
        font-size: 0.9rem;
    }
    .btn-icon-sm.btn-danger:hover {
        color: #ef4444;
        background-color: rgba(239, 68, 68, 0.15);
    }
    .items-table-header {
        display: grid;
        grid-template-columns: 4fr 1.1fr 1fr 1.2fr 1.2fr 40px;
        gap: 0.75rem;
        align-items: center;
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding-bottom: 0.6rem;
        border-bottom: 1px solid var(--border-color);
        margin-bottom: 0.75rem;
    }
    .item-editor-row {
        display: grid;
        grid-template-columns: 4fr 1.1fr 1fr 1.2fr 1.2fr 40px;
        gap: 0.75rem;
        align-items: flex-start;
        padding: 0.65rem 0;
        border-bottom: 1px dashed var(--border-color);
    }
    .col-task-info {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        width: 100%;
    }
    .task-title-input {
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--text-primary);
        background-color: var(--bg-card-alt);
    }
    .task-desc-input {
        font-size: 0.8rem;
        color: var(--text-primary);
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        opacity: 0.85;
    }
    .col-unit, .col-qty, .col-price, .col-subtotal, .col-action {
        display: flex;
        align-items: center;
        height: 36px;
    }
    .col-subtotal {
        justify-content: flex-end;
    }
    .col-action {
        justify-content: center;
    }
    .item-subtotal-val {
        font-weight: 700;
        font-size: 0.92rem;
        color: var(--text-primary);
    }
    .add-task-bar {
        margin-top: 1rem;
    }
    .btn-add-task {
        background-color: transparent;
        color: var(--color-primary);
        border: 1px dashed var(--color-primary);
        padding: 0.5rem 1rem;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        width: 100%;
        transition: background-color 0.2s;
    }
    .btn-add-task:hover {
