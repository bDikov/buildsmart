@page "/admin-projects"
@using BuildSmart.SharedUI.ViewModels.Admin
@using BuildSmart.SharedUI.GraphQL
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin, ADMIN, admin")]
@inject AdminProjectsViewModel ViewModel
@inject NavigationManager NavManager
@inject IBuildSmartApiClient ApiClient
@inject IJSRuntime JSRuntime
@implements IDisposable
@inject BuildSmart.SharedUI.Services.SignalRService SignalRService
@inject BuildSmart.SharedUI.GraphQL.State.BuildSmartApiClientStoreAccessor StoreAccessor
@inject BuildSmart.Core.Application.Interfaces.IProjectManagementService ProjectService

<div class="admin-container">
    <div class="header-section d-flex justify-content-between align-items-center">
        <div class="title-group">
            <h1 class="page-title">All Projects</h1>
            <p class="page-subtitle">View and search all projects across the platform.</p>
        </div>
        <a href="/admin/projects/create" class="bs-btn-primary" style="text-decoration: none; padding: 10px 18px; display: inline-flex; align-items: center; gap: 8px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
            + Create Project as User
        </a>
    </div>

    <!-- Search & Filters -->
    <div class="bs-card search-card mb-4">
        <div class="search-layout">
            <div class="flex-grow-1">
                <input type="text" class="bs-input search-input" @bind="ViewModel.SearchQuery" @bind:event="oninput" @onkeyup="HandleSearchEnter" placeholder="Search by Project Title, ID, Homeowner Email, or Name..." />
            </div>
            <button class="bs-btn-primary" @onclick="TriggerSearch">
                Search
            </button>
            <button class="bs-btn-secondary" @onclick="ClearSearch">
                Clear
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="bs-card mb-4" style="background-color: rgba(244, 67, 54, 0.1); border: 1px solid #F44336;">
            <h4 class="text-danger mb-1">Search Error</h4>
            <p class="text-danger mb-0" style="font-size: 14px;">@ErrorMessage</p>
        </div>
    }

    @if (ViewModel.IsBusy && ViewModel.Projects.Count == 0)
    {
        <div class="loading-state">
            <div class="spinner-border text-primary" role="status"></div>
            <p>Loading projects...</p>
        </div>
    }
    else if (ViewModel.Projects.Count == 0)
    {
        <div class="empty-state bs-card">
            <div class="empty-icon">📁</div>
            <h3>No Projects Found</h3>
            <p>Adjust your search criteria or wait for new projects.</p>
        </div>
    }
    else
    {
        <div class="projects-list">
            @foreach (var project in ViewModel.Projects)
            {
                <div class="bs-card project-card mb-3">
                    <div class="project-header">
                        <div class="project-info">
                            <h3 class="project-title">@project.Title</h3>
                            <span class="project-owner">Owner: @(project.Homeowner?.FirstName ?? "Unknown") @(project.Homeowner?.LastName ?? "") (@(project.Homeowner?.Email ?? "No Email"))</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            @if (project.HasOfferPdf)
                            {
                                <span class="offer-status-badge ready" style="padding: 3px 8px; border-radius: 12px; font-size: 11px; font-weight: 700; background: rgba(16, 185, 129, 0.15); color: var(--color-success);" title="PDF offer is compiled and saved in DB">🟢 PDF Ready</span>
                            }
                            else
                            {
                                <span class="offer-status-badge pending" style="padding: 3px 8px; border-radius: 12px; font-size: 11px; font-weight: 700; background: rgba(255, 193, 7, 0.15); color: var(--color-warning);" title="PDF offer will compile on demand when downloaded">🟡 PDF Pending</span>
                            }
                            <span class="status-badge @project.Status.ToString().ToLower()">@Loc[$"Status_{project.Status}"]</span>
                            <button class="bs-btn-text text-danger p-0" title="Delete Project" @onclick="() => HandleDeleteProject(project.Id, project.Title)">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            </button>
                        </div>
                    </div>
                    
                    <hr class="divider" />
                    @{
                        bool isExpanded = _expandedProjects.Contains(project.Id);
                        string descText = string.IsNullOrEmpty(project.Description) ? "No description provided." : project.Description;
                        bool isLongDesc = descText?.Length > 120;
                    }
                    <div class="project-desc-container">
                        <p class="project-desc @(isExpanded ? "expanded" : "collapsed")">@descText</p>
                        @if (isLongDesc)
                        {
                            <button type="button" class="bs-btn-text p-0 mt-1" style="font-size: 13px; font-weight: 600; color: var(--color-primary); background: transparent; border: none; cursor: pointer;" @onclick:stopPropagation="true" @onclick="() => ToggleProjectDescription(project.Id)">
                                @(isExpanded ? "View Less" : "View More")
                            </button>
                        }
                    </div>
                    
                    <div class="jobs-list mt-3 d-flex flex-wrap gap-2">
                        <button class="bs-btn-primary btn-sm" @onclick='() => NavManager.NavigateTo($"/projects/{project.Id}/kanban")'>
                            📋 Work Board
                        </button>
                        <button class="bs-btn-secondary btn-sm" @onclick='() => NavManager.NavigateTo($"/projects/{project.Id}/payments")'>
                            💳 Payments
                        </button>
                        <button class="bs-btn-secondary btn-sm" @onclick='() => NavManager.NavigateTo($"/admin-job-review")'>
                            View Attached Jobs in Reviews
                        </button>
                        <button class="bs-btn-secondary btn-sm" @onclick='() => NavManager.NavigateTo($"/project-messages?projectId={project.Id}")'>
                            Chat with Homeowner
                        </button>
                        @if (project.HasOfferPdf)
                        {
                            <a class="bs-btn-primary btn-sm" href="@($"{ApiConfig.GetBaseUrl()}/api/offers/{project.Id}/download")" target="_blank" download style="text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                                📄 Download PDF Offer
                            </a>
                        }
                        else
                        {
                            <a class="bs-btn-primary btn-sm" href="@($"{ApiConfig.GetBaseUrl()}/api/offers/{project.Id}/download")" target="_blank" download style="text-decoration: none; display: inline-flex; align-items: center; gap: 6px; background-color: #f59e0b; border-color: #d97706; color: #ffffff;">
                                ⚡ Generate & Download PDF
                            </a>
                        }
                        <a class="bs-btn-secondary btn-sm" href="@($"{ApiConfig.GetBaseUrl()}/api/offers/{project.Id}/download?force=true")" target="_blank" download style="text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                            🔄 Regenerate & Download PDF
                        </a>
                        <button class="bs-btn-primary btn-sm" style="background-color: var(--color-primary);" @onclick="() => OpenAddCategoryModal(project.Id)">
                            + Add Trade Category
                        </button>
                    </div>
                </div>
            }
        </div>
    }

    @if (ShowAddCategoryModal)
    {
        <div class="modal-overlay" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); display: flex; align-items: center; justify-content: center; z-index: 1000;">
            <div class="modal-card bs-card" style="width: 100%; max-width: 480px; padding: 24px; background: var(--bg-card); border-radius: 12px; border: 1px solid var(--border-color);">
                <h3 style="margin-top: 0; margin-bottom: 12px; color: var(--text-primary);">Add Trade Category to Project</h3>
                <p style="font-size: 13px; color: var(--text-muted); margin-bottom: 20px;">Select a trade category work package to append to this project with default SKUs.</p>
                
                <div class="mb-3">
                    <label class="form-label" style="display: block; font-weight: 600; font-size: 13px; margin-bottom: 6px; color: var(--text-primary);">Trade Category *</label>
                    <select class="bs-input" style="width: 100%;" @bind="SelectedCategoryId">
                        <option value="@Guid.Empty">-- Select Category --</option>
                        @foreach (var cat in AvailableCategories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    </select>
                </div>

                <div class="mb-4">
                    <label class="form-label" style="display: block; font-weight: 600; font-size: 13px; margin-bottom: 6px; color: var(--text-primary);">Assign Tradesman (Optional)</label>
                    <select class="bs-input" style="width: 100%;" @bind="SelectedTradesmanId">
                        <option value="@Guid.Empty">-- Select Tradesman --</option>
                        @foreach (var t in TradesmenLookup)
                        {
                            <option value="@t.UserId">@t.FullName (@t.Email)</option>
                        }
                    </select>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <button class="bs-btn-secondary" @onclick="CloseAddCategoryModal" disabled="@IsSubmittingCategory">Cancel</button>
                    <button class="bs-btn-primary" @onclick="ConfirmAddCategory" disabled="@(IsSubmittingCategory || SelectedCategoryId == Guid.Empty)">
                        @(IsSubmittingCategory ? "Adding..." : "Add Category")
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .admin-container {
        padding: 40px 20px;
        max-width: 1000px;
        margin: 0 auto;
        min-height: 100vh;
    }

    .header-section {
        margin-bottom: 30px;
    }

    .page-title {
        font-size: 32px;
        font-weight: 800;
        margin: 0 0 4px 0;
        color: var(--text-primary);
        letter-spacing: -0.5px;
    }

    .page-subtitle {
        color: var(--text-muted);
        font-size: 14px;
        margin: 0;
    }

    .search-card {
        padding: 20px;
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
    }

    .search-layout {
        display: flex;
        flex-wrap: wrap; /* CRITICAL: Allow wrapping on mobile */
        gap: 15px;
        align-items: center;
    }

    .search-input {
        width: 100%;
        padding: 12px 16px;
        background-color: var(--bg-card-alt);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        color: var(--text-primary);
        font-size: 15px;
        outline: none;
    }

    .search-input:focus {
        border-color: var(--color-primary);
    }

    .loading-state, .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 80px 40px;
    }

    .empty-icon {
        font-size: 48px;
        margin-bottom: 16px;
    }

    .projects-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .project-card {
        padding: 20px;
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
    }

    .project-header {
        display: flex;
        flex-wrap: wrap; /* CRITICAL: Allow wrapping on mobile */
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
    }

    .project-info {
        flex: 1;
        min-width: 0; /* CRITICAL: Allow text to wrap/truncate */
    }

    .project-title {
        font-size: 18px;
        font-weight: 700;
        margin: 0 0 4px 0;
        word-break: break-word; /* Prevent text overflow */
        overflow-wrap: break-word;
    }

    .project-owner {
        font-size: 12px;
        color: var(--text-muted);
    }

    .project-desc-container {
        margin-bottom: 0;
    }

    .project-desc {
        font-size: 14px;
        color: var(--text-primary);
        margin: 0;
        white-space: pre-wrap;
    }

    .project-desc.collapsed {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .divider {
        border: 0;
        border-top: 1px solid var(--border-color);
        margin: 15px 0;
    }

    .sub-heading {
        font-size: 13px;
        font-weight: 700;
        color: var(--text-muted);
        margin-bottom: 10px;
    }

    .jobs-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .job-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--bg-card-alt);
        padding: 8px 12px;
        border-radius: 6px;
        border: 1px solid var(--border-color);
    }

    .status-badge {
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        background: var(--bg-card-alt);
        border: 1px solid var(--border-color);
        color: var(--text-primary);
    }
    .status-badge.underreview { background: rgba(255, 193, 7, 0.15); color: var(--color-warning); border-color: transparent; }
    .status-badge.active { background: rgba(16, 185, 129, 0.15); color: var(--color-success); border-color: transparent; }
</style>

@code {
    private string? ErrorMessage;
    private HashSet<Guid> _expandedProjects = new HashSet<Guid>();

    private void ToggleProjectDescription(Guid projectId)
    {
        if (_expandedProjects.Contains(projectId))
            _expandedProjects.Remove(projectId);
        else
            _expandedProjects.Add(projectId);
    }

    protected override async Task OnInitializedAsync()
    {
        SignalRService.NotificationReceived += OnNotificationReceived;
        if (ViewModel.Projects.Count == 0)
        {
            await TriggerSearch();
        }
    }

    private void OnNotificationReceived(string title, string msg, object? data)
    {
        InvokeAsync(async () =>
        {
            try { StoreAccessor.OperationStore.Clear(); } catch { }
            await TriggerSearch();
            StateHasChanged();
        });
    }

    private async Task HandleSearchEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await TriggerSearch();
        }
    }

    private async Task TriggerSearch()
    {
        ErrorMessage = null;
        try
        {
            await ViewModel.LoadProjectsCommand.ExecuteAsync(null);
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private async Task ClearSearch()
    {
        ViewModel.SearchQuery = string.Empty;
        await TriggerSearch();
    }

    private async Task HandleDeleteProject(Guid projectId, string title)
    {
        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to permanently delete the project '{title}' and all its jobs?");
        if (confirm)
        {
            try
            {
                await ApiClient.DeleteProject.ExecuteAsync(projectId);
                await ViewModel.LoadProjectsCommand.ExecuteAsync(null);
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Failed to delete project: {ex.Message}");
            }
        }
    }

    private async Task HandleDeleteJob(Guid jobId, string title)
    {
        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to permanently delete the job '{title}'?");
        if (confirm)
        {
            try
            {
                await ApiClient.DeleteJobPost.ExecuteAsync(jobId);
                await ViewModel.LoadProjectsCommand.ExecuteAsync(null);
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Failed to delete job: {ex.Message}");
            }
        }
    }

    private bool ShowAddCategoryModal = false;
    private bool IsSubmittingCategory = false;
    private Guid SelectedTargetProjectId = Guid.Empty;
    private Guid SelectedCategoryId = Guid.Empty;
    private Guid SelectedTradesmanId = Guid.Empty;
    private List<BuildSmart.Core.Domain.Entities.ServiceCategory> AvailableCategories = new();
    private List<BuildSmart.Core.Application.DTOs.UserLookupDto> TradesmenLookup = new();

    private async Task OpenAddCategoryModal(Guid projectId)
    {
        SelectedTargetProjectId = projectId;
        SelectedCategoryId = Guid.Empty;
        SelectedTradesmanId = Guid.Empty;
        
        try
        {
            AvailableCategories = await ProjectService.GetTradeCategoriesAsync();
            TradesmenLookup = await ProjectService.GetTradesmenLookupAsync();
            ShowAddCategoryModal = true;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Failed to load categories: {ex.Message}");
        }
    }

    private void CloseAddCategoryModal()
    {
        ShowAddCategoryModal = false;
        SelectedTargetProjectId = Guid.Empty;
        SelectedCategoryId = Guid.Empty;
        SelectedTradesmanId = Guid.Empty;
    }

    private async Task ConfirmAddCategory()
    {
        if (SelectedTargetProjectId == Guid.Empty || SelectedCategoryId == Guid.Empty)
            return;

        IsSubmittingCategory = true;
        try
        {
            await ProjectService.AddCategoryToProjectAsync(
                SelectedTargetProjectId, 
                SelectedCategoryId, 
                SelectedTradesmanId != Guid.Empty ? SelectedTradesmanId : null);

            await JSRuntime.InvokeVoidAsync("alert", "Category added successfully to project!");
            CloseAddCategoryModal();
            await TriggerSearch();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error adding category: {ex.Message}");
        }
        finally
        {
            IsSubmittingCategory = false;
        }
    }

    private async Task HandleRegenerateOffer(Guid projectId)
    {
        try
        {
            var result = await ApiClient.AdminRegenerateOffer.ExecuteAsync(projectId);
            if (result.Errors?.Count > 0)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Error: " + result.Errors[0].Message);
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Offer PDF invalidated! Click '⚡ Generate & Download PDF' to generate and view your fresh PDF offer.");
                await TriggerSearch();
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Error: " + ex.Message);
        }
    }

    public void Dispose()
    {
        SignalRService.NotificationReceived -= OnNotificationReceived;
    }
}