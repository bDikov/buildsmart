    private async Task<string> ProcessUploadedFileAsync(Microsoft.AspNetCore.Components.Forms.IBrowserFile file)
    {
        using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
        using var ms = new System.IO.MemoryStream();
        await stream.CopyToAsync(ms);
        var buffer = ms.ToArray();

        string? uploadedUrl = null;
        try
        {
            using var uploadMs = new System.IO.MemoryStream(buffer);
            uploadedUrl = await FileService.UploadAdminImageAsync(uploadMs, file.Name);
        }
        catch {}

        if (!string.IsNullOrEmpty(uploadedUrl))
        {
            return uploadedUrl;
        }

        var base64 = Convert.ToBase64String(buffer);
        var format = string.IsNullOrWhiteSpace(file.ContentType) ? "image/png" : file.ContentType;
        return $"data:{format};base64,{base64}";
    }

    private async Task HandleIconFileUpload(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                var iconResult = await ProcessUploadedFileAsync(file);
                SelectIconFromPicker(iconResult);
                await ShowToastMessage("Custom icon image uploaded successfully!", "success");
            }
        }
        catch (Exception ex)
        {
            await ShowToastMessage($"File upload failed: {ex.Message}", "danger");
        }
    }

