@page "/admin/spider-net"
@using BuildSmart.SharedUI.Services
@using Microsoft.AspNetCore.Authorization
@using System.Text.Json
@attribute [Authorize(Roles = "Admin, ADMIN, admin")]
@inject IQuestionManagementApiClient ApiClient
@inject IJSRuntime JSRuntime
@inject NavigationManager NavManager

<div class="admin-container">
    <div class="header-section">
        <div class="title-group">
            <h1 class="page-title">Spider-Net Manager</h1>
            <p class="page-subtitle">Visualize and edit questions, formulas, SKU linkages, and Vis-Network dependency maps.</p>
        </div>
        <div class="header-actions">
            <button class="bs-btn-secondary" @onclick="LoadDataAsync">
                🔄 Refresh Data
            </button>
            <button class="bs-btn-primary" @onclick="OpenAddQuestionModal">
                ➕ New Question
            </button>
            <button class="bs-btn-primary ml-2" @onclick="OpenAddFormulaModal">
                ➕ New Formula
            </button>
            <button class="bs-btn-primary ml-2" @onclick="OpenAddSkuModal">
                ➕ New SKU
            </button>
        </div>
    </div>

    <!-- Error/Success Alerts -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-success">@statusMessage</div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <!-- Category & Question Filters -->
    <div class="filter-section mb-3" style="display: flex; flex-wrap: wrap; align-items: center; gap: 20px; background: rgba(255, 255, 255, 0.03); padding: 12px 18px; border-radius: 8px; border: 1px solid var(--border-color);">
        <div style="display: flex; align-items: center; gap: 10px;">
            <span style="font-weight: 700; font-size: 14px; color: var(--text-muted);">Filter Category:</span>
            <select class="bs-select" style="max-width: 320px;" @onchange="OnCategoryFilterChanged">
                <option value="All">All Categories</option>
                @foreach (var cat in filterCategories)
                {
                    <option value="@cat.Id">@cat.Name</option>
                }
            </select>
        </div>
        <div style="display: flex; align-items: center; gap: 10px;">
            <span style="font-weight: 700; font-size: 14px; color: var(--text-muted);">Focus Question:</span>
            <select class="bs-select" style="max-width: 400px;" @onchange="OnQuestionFilterChanged" value="@selectedQuestionFilter">
                <option value="All">Show All Questions in Category</option>
                @foreach (var q in GetFilteredQuestionsForDropdown())
                {
                    <option value="@q.Id">[@q.QuestionCode] @(q.Text.Length > 50 ? q.Text.Substring(0, 47) + "..." : q.Text)</option>
                }
            </select>
        </div>
    </div>

    <!-- Tabs -->
    <div class="tabs-container">
        <button class="tab-button @(activeTab == "graph" ? "active" : "")" @onclick='() => SetActiveTab("graph")'>🕸️ Graph Map</button>
        <button class="tab-button @(activeTab == "questions" ? "active" : "")" @onclick='() => SetActiveTab("questions")'>❓ Questions (@GetFilteredQuestions().Count())</button>
        <button class="tab-button @(activeTab == "formulas" ? "active" : "")" @onclick='() => SetActiveTab("formulas")'>🧮 Formulas (@formulas.Count)</button>
        <button class="tab-button @(activeTab == "skus" ? "active" : "")" @onclick='() => SetActiveTab("skus")'>🏷️ SKUs (@GetFilteredSkus().Count())</button>
        <button class="tab-button @(activeTab == "simulation" ? "active" : "")" @onclick='() => SetActiveTab("simulation")'>🧪 Run Simulation</button>
        <button class="tab-button @(activeTab == "sync" ? "active" : "")" @onclick='() => SetActiveTab("sync")'>💾 Import/Export</button>
    </div>

    <div class="manager-body">
        <div class="main-content-panel">
            <!-- GRAPH VIEW -->
            <div class="tab-content @(activeTab == "graph" ? "show" : "hidden")">
                <div class="graph-wrapper bs-card">
                    <div @ref="graphContainer" class="graph-container"></div>
                    <div class="graph-legend">
                        <span class="legend-item"><span class="legend-dot legend-question"></span> Question Node</span>
                        <span class="legend-item"><span class="legend-dot legend-formula"></span> Formula Node</span>
                        <span class="legend-item"><span class="legend-dot legend-sku"></span> SKU Node</span>
                    </div>
                </div>
            </div>

            <!-- QUESTIONS VIEW -->
            <div class="tab-content @(activeTab == "questions" ? "show" : "hidden")">
                <div class="grid-layout">
                    @foreach (var q in GetFilteredQuestions())
                    {
                        <div class="bs-card item-card @(selectedQuestion?.Id == q.Id ? "highlighted" : "")" @onclick="() => SelectQuestion(q)">
                            <div class="card-header">
                                <span class="badge badge-question">@q.QuestionCode</span>
                                <span class="badge bg-dark">Order: @q.DisplayOrder</span>
                            </div>
                            <h3 class="card-title">@q.Text</h3>
                            <p class="card-desc">Type: <strong>@q.Type</strong> | Required: <strong>@(q.IsRequired ? "Yes" : "No")</strong></p>
                            @if (!string.IsNullOrEmpty(q.HintText))
                            {
                                <p class="help-text">💡 @q.HintText</p>
                            }
                            <div class="card-links">
                                🔗 Skus: <span class="link-count">@q.SkuIds.Count</span> | Formulas: <span class="link-count">@q.FormulaIds.Count</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- FORMULAS VIEW -->
            <div class="tab-content @(activeTab == "formulas" ? "show" : "hidden")">
                <div class="grid-layout">
                    @foreach (var f in formulas)
                    {
                        <div class="bs-card item-card @(selectedFormula?.Id == f.Id ? "highlighted" : "")" @onclick="() => SelectFormula(f)">
                            <div class="card-header">
                                <span class="badge badge-formula">@f.Name</span>
                            </div>
                            <h3 class="card-title">@f.Description</h3>
                            <code class="formula-code">@f.Expression</code>
                        </div>
                    }
                </div>
            </div>

            <!-- SKUS VIEW -->
            <div class="tab-content @(activeTab == "skus" ? "show" : "hidden")">
                <div class="grid-layout">
                    @foreach (var s in GetFilteredSkus())
                    {
                        <div class="bs-card item-card @(selectedSku?.Id == s.Id ? "highlighted" : "")" @onclick="() => SelectSku(s)">
                            <div class="card-header">
                                <span class="badge badge-sku">@s.SkuCode</span>
                                <span class="badge bg-dark">@s.UnitType</span>
                            </div>
                            <h3 class="card-title">@s.Name</h3>
                            <p class="card-desc">@s.Description</p>
                            <div class="card-meta" style="font-weight: 700; color: var(--accent-color); margin-top: 8px;">Base Price: @s.BasePrice lv.</div>
                        </div>
                    }
                </div>
            </div>

            <!-- SIMULATION VIEW -->
            <div class="tab-content @(activeTab == "simulation" ? "show" : "hidden")">
                <div class="simulation-panel bs-card">
                    <h2>Execute Offer Simulation</h2>
                    <p class="help-text">Select the questions you want to activate, fill out mock answers, and run the calculation engine.</p>
                    
                    <div class="sim-columns">
                        <div class="sim-left">
                            <h3>1. Select Questions to Answer</h3>
                            <div class="checkbox-list">
                                @foreach (var q in questions)
                                {
                                    <label class="checkbox-item">
                                        <input type="checkbox" @onchange='(e) => ToggleSimQuestion(q.Id, e.Value)' checked="@simSelectedQuestionIds.Contains(q.Id)" />
                                        <span><strong>@q.QuestionCode</strong> (@q.Text)</span>
                                    </label>
                                }
                            </div>
                        </div>
                        <div class="sim-right">
                            <h3>2. Fill Out Mock Answers</h3>
                            <div class="answers-form">
                                @foreach (var qId in simSelectedQuestionIds)
                                {
                                    var question = questions.FirstOrDefault(q => q.Id == qId);
                                    if (question == null) continue;

                                    <div class="form-group">
                                        <label>@question.Text (@question.QuestionCode)</label>
                                        @if (question.Type == "boolean" || question.Type == "bool")
                                        {
                                            <select class="bs-select" @onchange='(e) => UpdateSimAnswer(question.QuestionCode, e.Value?.ToString() == "true")'>
                                                <option value="false">No / False</option>
                                                <option value="true">Yes / True</option>
                                            </select>
                                        }
                                        else if (question.Type == "choice" && !string.IsNullOrEmpty(question.OptionsJson))
                                        {
                                            var opts = DeserializeOptions(question.OptionsJson);
                                            <select class="bs-select" @onchange='(e) => UpdateSimAnswer(question.QuestionCode, e.Value?.ToString())'>
                                                <option value="">-- Choose Option --</option>
                                                @foreach (var opt in opts)
                                                {
                                                    <option value="@opt">@opt</option>
                                                }
                                            </select>
                                        }
                                        else if (question.Type == "number")
                                        {
                                            <input type="number" class="bs-input" placeholder="Enter numeric value" @onchange='(e) => UpdateSimAnswer(question.QuestionCode, decimal.TryParse(e.Value?.ToString(), out var v) ? v : 0m)' />
                                        }
                                        else
                                        {
                                            <input type="text" class="bs-input" placeholder="Enter text value" @onchange='(e) => UpdateSimAnswer(question.QuestionCode, e.Value?.ToString())' />
                                        }
                                    </div>
                                }
                                @if (simSelectedQuestionIds.Count == 0)
                                {
                                    <p class="help-text text-center">Select questions from the left to start answering.</p>
                                }
                            </div>
                            
                            <button class="bs-btn-primary w-100 mt-4" @onclick="RunSimulationAsync" disabled="@(simSelectedQuestionIds.Count == 0)">
                                ⚡ Run Calculations
                            </button>
                        </div>
                    </div>

                    <!-- Simulation Result -->
                    @if (simulationResult != null)
                    {
                        <div class="simulation-results mt-5">
                            <h3>Calculation Results</h3>
                            <div class="results-meta">
                                <div class="total-price-badge">
                                    Grand Total: <span>@simulationResult.TotalPrice.ToString("C2")</span>
                                </div>
                            </div>

                            @if (simulationResult.Warnings.Count > 0)
                            {
                                <div class="alert alert-warning mt-3">
                                    <strong>Warnings:</strong>
                                    <ul>
                                        @foreach (var warning in simulationResult.Warnings)
                                        {
                                            <li>@warning</li>
                                        }
                                    </ul>
                                </div>
                            }

                            <table class="results-table mt-3">
                                <thead>
                                    <tr>
                                        <th>SKU Code</th>
                                        <th>Task Title</th>
                                        <th>Calculated Qty</th>
                                        <th>Unit</th>
                                        <th>Base Price</th>
                                        <th>Total Price</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var task in simulationResult.Tasks)
                                    {
                                        <tr>
                                            <td><code>@task.SkuCode</code></td>
                                            <td>@task.Title</td>
                                            <td>@task.Quantity.ToString("F2")</td>
                                            <td>@task.UnitType</td>
                                            <td>@task.BasePrice.ToString("C2")</td>
                                            <td class="font-weight-bold">@task.TotalPrice.ToString("C2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <!-- IMPORT/EXPORT VIEW -->
            <div class="tab-content @(activeTab == "sync" ? "show" : "hidden")">
                <div class="sync-panel bs-card">
                    <h2>Import/Export Spider-Net Configuration</h2>
                    <p class="help-text">Backup or restore all questions, visibility logic, formulas, and connections in one JSON block.</p>
                    
                    <div class="form-group mt-3">
                        <label>Configuration JSON</label>
                        <textarea class="bs-input code-textarea" rows="12" @bind="syncJson" placeholder="Paste your backup JSON here..."></textarea>
                    </div>

                    <div class="sync-actions mt-3">
                        <button class="bs-btn-secondary" @onclick="ExportDataAsync">Export Configuration</button>
                        <button class="bs-btn-primary ml-2" @onclick="ImportDataAsync">Import & Sync Schema</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT SIDE DETAILS DRAWER -->
        <div class="details-panel bs-card">
            @if (selectedQuestion != null)
            {
                <div class="drawer-header">
                    <h2>Edit Question</h2>
                    <button class="remove-btn text-danger" @onclick="() => DeleteQuestionAsync(selectedQuestion.Id)">🗑️ Delete</button>
                </div>
                <div class="drawer-body">
                    <div class="form-group">
                        <label>Question Code (Unique Variable Name)</label>
                        <input type="text" class="bs-input" @bind="selectedQuestion.QuestionCode" />
                    </div>
                    <div class="form-group">
                        <label>Display Text</label>
                        <textarea class="bs-input" @bind="selectedQuestion.Text" rows="2"></textarea>
                    </div>
                    <div class="form-group">
                        <label>Input Type</label>
                        <select class="bs-select" @bind="selectedQuestion.Type">
                            <option value="text">Text Input</option>
                            <option value="number">Number Input</option>
                            <option value="boolean">Boolean Switch (Yes/No)</option>
                            <option value="choice">Single-Choice Dropdown</option>
                            <option value="multiselect">Multi-Choice Checklist</option>
                        </select>
                    </div>
                    <div class="form-group checkbox-row">
                        <label>Is Field Required?</label>
                        <input type="checkbox" @bind="selectedQuestion.IsRequired" />
                    </div>
                    <div class="form-group">
                        <label>Hint/Tooltip Text</label>
                        <input type="text" class="bs-input" @bind="selectedQuestion.HintText" />
                    </div>
                    <div class="form-group">
                        <label>Display Order (Sorting)</label>
                        <input type="number" class="bs-input" @bind="selectedQuestion.DisplayOrder" />
                    </div>
                    
                    <div class="form-group">
                        <label>Parent Question (Visibility Trigger)</label>
                        <select class="bs-select" @bind="selectedQuestion.ParentQuestionId">
                            <option value="">-- None (Always Visible) --</option>
                            @foreach (var group in questions
                                .Where(x => x.Id != selectedQuestion.Id)
                                .GroupBy(q => q.ServiceCategoryId))
                            {
                                var categoryName = group.Key == null 
                                    ? "Global Questions" 
                                    : (graphData.Nodes.FirstOrDefault(n => n.Id == group.First().Id.ToString())?.Category ?? "Other Category");
                                    
                                <optgroup label="@categoryName">
                                    @foreach (var q in group)
                                    {
                                        <option value="@q.Id">[@q.QuestionCode] @(q.Text.Length > 55 ? q.Text.Substring(0, 52) + "..." : q.Text)</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>

                    @if (selectedQuestion.ParentQuestionId.HasValue && selectedQuestion.ParentQuestionId.Value != Guid.Empty)
                    {
                        var parentQ = questions.FirstOrDefault(q => q.Id == selectedQuestion.ParentQuestionId.Value);
                        if (parentQ != null)
                        {
                            @if (parentQ.Type == "choice" || parentQ.Type == "multiselect")
                            {
                                var parentOptions = new List<string>();
                                try
                                {
                                    parentOptions = string.IsNullOrEmpty(parentQ.OptionsJson) 
                                        ? new List<string>() 
                                        : System.Text.Json.JsonSerializer.Deserialize<List<string>>(parentQ.OptionsJson) ?? new List<string>();
                                }
                                catch {}

                                <div class="form-group mb-3" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); border-radius: 8px; padding: 12px;">
                                    <span style="font-size: 12px; font-weight: 700; color: var(--text-muted); display: block; margin-bottom: 8px;">Triggering Parent Options:</span>
                                    @if (parentOptions.Count == 0)
                                    {
                                        <p class="help-text text-warning" style="margin: 0; font-size: 12px;">💡 Parent question has no options configured yet.</p>
                                    }
                                    @foreach (var opt in parentOptions)
                                    {
                                        <label class="checkbox-item" style="margin-bottom: 6px; display: flex; align-items: center; gap: 8px; user-select: none;">
                                            <input type="checkbox" checked="@IsParentOptionSelected(opt)" @onchange='(e) => ToggleParentOption(opt, e.Value)' />
                                            <span style="color: #ffffff; font-size: 13px;">@opt</span>
                                        </label>
                                    }
                                </div>
                            }
                            else if (parentQ.Type == "boolean")
                            {
                                <div class="form-group mb-3" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); border-radius: 8px; padding: 12px;">
                                    <span style="font-size: 12px; font-weight: 700; color: var(--text-muted); display: block; margin-bottom: 8px;">Triggering Parent Options:</span>
                                    <label class="checkbox-item" style="margin-bottom: 6px; display: flex; align-items: center; gap: 8px; user-select: none;">
                                        <input type="checkbox" checked='@IsParentOptionSelected("True")' @onchange='(e) => ToggleParentOption("True", e.Value)' />
                                        <span style="color: #ffffff; font-size: 13px;">Yes / Checked (True)</span>
                                    </label>
                                    <label class="checkbox-item" style="display: flex; align-items: center; gap: 8px; user-select: none;">
                                        <input type="checkbox" checked='@IsParentOptionSelected("False")' @onchange='(e) => ToggleParentOption("False", e.Value)' />
                                        <span style="color: #ffffff; font-size: 13px;">No / Unchecked (False)</span>
                                    </label>
                                </div>
                            }
                        }
                    }

                    <div class="form-group">
                        <label>Parent Value Condition (e.g. 'Yes' or 'Апартамент')</label>
                        <input type="text" class="bs-input" @bind="selectedQuestion.VisibilityCondition" placeholder="Visibility Condition Value" />
                    </div>
                    @if (selectedQuestion.Type == "choice" || selectedQuestion.Type == "multiselect")
                    {
                        <div class="form-group" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); border-radius: 8px; padding: 12px; margin-bottom: 16px;">
                            <label style="font-weight: 700; color: var(--text-muted); font-size: 13px; display: block; margin-bottom: 8px;">Choice Options List:</label>
                            
                            @{
                                var currentOpts = GetQuestionOptionsList(selectedQuestion);
                            }
                            
                            @if (currentOpts.Count == 0)
                            {
                                <p class="help-text" style="color: var(--text-muted); font-size: 12px; margin: 0 0 10px 0;">No options configured yet.</p>
                            }
                            else
                            {
                                <div style="display: flex; flex-direction: column; gap: 6px; margin-bottom: 10px;">
                                    @foreach (var opt in currentOpts)
                                    {
                                        <div style="display: flex; align-items: center; justify-content: space-between; background: #16171a; padding: 6px 12px; border-radius: 6px; border: 1px solid var(--border-color);">
                                            <span style="font-size: 13px; color: #ffffff;">@opt</span>
                                            <button type="button" class="btn-link text-danger" style="background: transparent; border: none; cursor: pointer; padding: 0; font-size: 14px;" @onclick="() => RemoveOptionFromQuestion(selectedQuestion, opt)">❌</button>
                                        </div>
                                    }
                                </div>
                            }
                            
                            <div style="display: flex; gap: 8px;">
                                <input type="text" class="bs-input" style="flex: 1; padding: 6px 10px; font-size: 13px;" placeholder="Add new option..." @bind="newOptionBuffer" />
                                <button type="button" class="bs-btn-primary" style="padding: 6px 12px; font-size: 13px;" @onclick="() => AddOptionToQuestion(selectedQuestion)">➕ Add</button>
                            </div>
                        </div>
                    }

                    <div class="form-group">
                        <label>Choice Options JSON Array (for choice/multiselect)</label>
                        <textarea class="bs-input" @bind="selectedQuestion.OptionsJson" rows="2" placeholder='["Option 1", "Option 2"]'></textarea>
                    </div>

                    <!-- LINK MANAGEMENT -->
                    <div class="links-section mt-4">
                        <h3>Sku & Formula Connections</h3>
                        <p class="help-text">Link this question to formulas and SKUs to route answers into price calculations.</p>
                        
                        <div class="link-scroller">
                            <strong>Formula Links:</strong>
                            <div class="checkbox-list mt-1">
                                @foreach (var f in formulas)
                                {
                                    <label class="checkbox-item">
                                        <input type="checkbox" @onchange='(e) => ToggleFormulaLink(f.Id, e.Value)' checked="@selectedQuestion.FormulaIds.Contains(f.Id)" />
                                        <span>@f.Name</span>
                                    </label>
                                }
                            </div>
                        </div>

                        <div class="link-scroller mt-3">
                            <strong>SKU Links:</strong>
                            <div class="checkbox-list mt-1">
                                @foreach (var s in availableSkus)
                                {
                                    <label class="checkbox-item">
                                        <input type="checkbox" @onchange='(e) => ToggleSkuLink(s.Id, e.Value)' checked="@selectedQuestion.SkuIds.Contains(s.Id)" />
                                        <span>@s.SkuCode (@s.Name)</span>
                                    </label>
                                }
                            </div>
                        </div>
                    </div>

                    <button class="bs-btn-primary w-100 mt-4" @onclick="SaveQuestionAsync">
                        💾 Save Question Details
                    </button>
                </div>
            }
            else if (selectedFormula != null)
            {
                <div class="drawer-header">
                    <h2>Edit Formula</h2>
                    <button class="remove-btn text-danger" @onclick="() => DeleteFormulaAsync(selectedFormula.Id)">🗑️ Delete</button>
                </div>
                <div class="drawer-body">
                    <div class="form-group">
                        <label>Formula Variable Name (e.g. wall_area_calc)</label>
                        <input type="text" class="bs-input" @bind="selectedFormula.Name" />
                    </div>
                    <div class="form-group">
                        <label>Description</label>
                        <input type="text" class="bs-input" @bind="selectedFormula.Description" />
                    </div>
                    <div class="form-group">
                        <label>NCalc Expression (e.g. global_total_sqm * 2.8)</label>
                        <textarea class="bs-input code-textarea" @bind="selectedFormula.Expression" rows="3"></textarea>
                    </div>

                    <button class="bs-btn-primary w-100 mt-4" @onclick="SaveFormulaAsync">
                        💾 Save Formula
                    </button>
                </div>
            }
            else if (selectedSku != null)
            {
                <div class="drawer-header">
                    <h2>Edit SKU</h2>
                    <button class="remove-btn text-danger" @onclick="() => DeleteSkuAsync(selectedSku.Id)">🗑️ Delete</button>
                </div>
                <div class="drawer-body">
                    <div class="form-group">
                        <label>SKU Code (e.g. ELEC-001)</label>
                        <input type="text" class="bs-input" @bind="selectedSku.SkuCode" />
                    </div>
                    <div class="form-group">
                        <label>Service Category</label>
                        <select class="bs-select" @bind="selectedSku.ServiceCategoryId">
                            @foreach (var cat in serviceCategories)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Name / Label</label>
                        <input type="text" class="bs-input" @bind="selectedSku.Name" />
                    </div>
                    <div class="form-group">
                        <label>Description</label>
                        <textarea class="bs-input" @bind="selectedSku.Description" rows="2"></textarea>
                    </div>
                    <div class="form-group">
                        <label>Base Price (lv.)</label>
                        <input type="number" class="bs-input" @bind="selectedSku.BasePrice" step="0.01" />
                    </div>
                    <div class="form-group">
                        <label>Unit Type (e.g. pcs, sqm, lm)</label>
                        <input type="text" class="bs-input" @bind="selectedSku.UnitType" />
                    </div>
                    <div class="form-group">
                        <label>Calculation Formula (NCalc Expression)</label>
                        <textarea class="bs-input code-textarea" @bind="selectedSku.CalculationFormula" rows="3" placeholder="e.g. if(Contains(paint_finish_level, 'Q5'), global_total_sqm * 2.5, 0)"></textarea>
                    </div>

                    <button class="bs-btn-primary w-100 mt-4" @onclick="SaveSkuAsync">
                        💾 Save SKU Details
                    </button>
                </div>
            }
            else if (selectedEdge != null)
            {
                <div class="drawer-header">
                    <h2>Edit Link Condition</h2>
                </div>
                <div class="drawer-body">
                    <div class="form-group">
                        <label>From Node (Question)</label>
                        <input type="text" class="bs-input" readonly value="@GetNodeLabel(selectedEdge.From)" />
                    </div>
                    <div class="form-group">
                        <label>To Node (@(selectedEdge.Type == "question-to-sku" ? "SKU" : "Question"))</label>
                        <input type="text" class="bs-input" readonly value="@GetNodeLabel(selectedEdge.To)" />
                    </div>
                    <div class="form-group">
                        <label>Link Type</label>
                        <input type="text" class="bs-input" readonly value="@(selectedEdge.Type == "question-to-sku" ? "SKU Activation Condition" : "Question Visibility Condition")" />
                    </div>
                    <div class="form-group">
                        <label>Condition Value / Trigger Options</label>
                        @if (selectedEdgeFromQuestion != null && (selectedEdgeFromQuestion.Type == "choice" || selectedEdgeFromQuestion.Type == "multiselect"))
                        {
                            var optionsList = new List<string>();
                            try
                            {
                                optionsList = string.IsNullOrEmpty(selectedEdgeFromQuestion.OptionsJson) 
                                    ? new List<string>() 
                                    : System.Text.Json.JsonSerializer.Deserialize<List<string>>(selectedEdgeFromQuestion.OptionsJson) ?? new List<string>();
                            }
                            catch {}

                            @if (optionsList.Count == 0)
                            {
                                <p class="help-text text-warning">💡 Question has no options configured yet.</p>
                            }
                            else
                            {
                                <div class="checkbox-list mt-1" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); border-radius: 8px; padding: 12px; max-height: 200px; overflow-y: auto;">
                                    @foreach (var opt in optionsList)
                                    {
                                        <label class="checkbox-item" style="margin-bottom: 6px; display: flex; align-items: center; gap: 8px; user-select: none;">
                                            <input type="checkbox" checked="@IsEdgeOptionSelected(opt)" @onchange='(e) => ToggleEdgeOption(opt, e.Value)' />
                                            <span style="color: #ffffff; font-size: 13px;">@opt</span>
                                        </label>
                                    }
                                </div>
                            }
                        }
                        else if (selectedEdgeFromQuestion != null && selectedEdgeFromQuestion.Type == "boolean")
                        {
                            <div class="checkbox-list mt-1" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); border-radius: 8px; padding: 12px;">
                                <label class="checkbox-item" style="margin-bottom: 6px; display: flex; align-items: center; gap: 8px; user-select: none;">
                                    <input type="checkbox" checked='@IsEdgeOptionSelected("True")' @onchange='(e) => ToggleEdgeOption("True", e.Value)' />
                                    <span style="color: #ffffff; font-size: 13px;">Yes / Checked (True)</span>
                                </label>
                                <label class="checkbox-item" style="margin-bottom: 6px; display: flex; align-items: center; gap: 8px; user-select: none;">
                                    <input type="checkbox" checked='@IsEdgeOptionSelected("False")' @onchange='(e) => ToggleEdgeOption("False", e.Value)' />
                                    <span style="color: #ffffff; font-size: 13px;">No / Unchecked (False)</span>
                                </label>
                            </div>
                        }
                        else
                        {
                            <input type="text" class="bs-input" @bind="edgeConditionBuffer" />
                        }
                        <p class="help-text">
                            @if (selectedEdge.Type == "question-to-sku")
                            {
                                <span>💡 This will update the triggering options inside the SKU's formula (e.g. `paint_scope contains 'Стандартен'`).</span>
                            }
                            else
                            {
                                <span>💡 This will update the triggering parent options for the question's visibility.</span>
                            }
                        </p>
                    </div>

                    <button class="bs-btn-primary w-100 mt-4" @onclick="SaveEdgeConditionAsync">
                        💾 Save Link Condition
                    </button>
                </div>
            }
            else
            {
                <div class="empty-state text-center mt-5">
                    <p class="help-text">Click a node in the graph map or select an item from the lists to view and edit details here.</p>
                </div>
            }
        </div>
    </div>
</div>

