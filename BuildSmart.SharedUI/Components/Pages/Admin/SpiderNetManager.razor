    }

    private string UpdateFormulaCondition(string formula, string questionCode, string newValue)
    {
        if (string.IsNullOrEmpty(formula))
            return $"if(Contains({questionCode}, '{newValue}'), 0, 0)"; // Fallback structure

        if (!formula.StartsWith("if(", StringComparison.OrdinalIgnoreCase))
        {
            // If it's a static calculation, wrap it in a conditional or if-then
            return $"if(Contains({questionCode}, '{newValue}'), {formula}, 0)";
        }

        int firstComma = FindFirstTopLevelComma(formula, 3);
        if (firstComma <= 3) return formula;

        string conditionPart = formula.Substring(3, firstComma - 3).Trim();
        string remainingPart = formula.Substring(firstComma);

        string newConditionPart = conditionPart;
        if (conditionPart.Contains("Contains"))
        {
            var regex = new System.Text.RegularExpressions.Regex(@"Contains\(\s*" + System.Text.RegularExpressions.Regex.Escape(questionCode) + @"\s*,\s*['""](.*?)['""]\s*\)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            if (regex.IsMatch(conditionPart))
            {
                newConditionPart = regex.Replace(conditionPart, $"Contains({questionCode}, '{newValue}')");
            }
            else
            {
                newConditionPart = $"Contains({questionCode}, '{newValue}')";
            }
        }
        else if (conditionPart.Contains("=="))
        {
            var regex = new System.Text.RegularExpressions.Regex(System.Text.RegularExpressions.Regex.Escape(questionCode) + @"\s*==\s*['""](.*?)['""]", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            if (regex.IsMatch(conditionPart))
            {
                newConditionPart = regex.Replace(conditionPart, $"{questionCode} == '{newValue}'");
            }
            else
            {
                newConditionPart = $"{questionCode} == '{newValue}'";
            }
        }
        else
        {
            newConditionPart = $"Contains({questionCode}, '{newValue}')";
        }

        return $"if({newConditionPart}{remainingPart}";
    }

    private int FindFirstTopLevelComma(string str, int startIndex)
    {
        int parenDepth = 0;
        for (int i = startIndex; i < str.Length; i++)
        {
            char c = str[i];
            if (c == '(') parenDepth++;
            else if (c == ')') parenDepth--;
            else if (c == ',' && parenDepth == 0)
            {
                return i;
            }
        }
        return -1;
    }

