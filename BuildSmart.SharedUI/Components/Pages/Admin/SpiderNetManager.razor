@code {
    private string activeTab = "graph";
    private List<QuestionDto> questions = new();
    private List<FormulaDto> formulas = new();
    private List<ServiceCategoryDto> serviceCategories = new();
    private List<ServiceSkuDto> availableSkus = new();
    private QuestionGraphDto graphData = new();
    private string selectedCategoryFilter = "All";
    private string selectedQuestionFilter = "All";
    private List<(string Id, string Name)> filterCategories = new();
    private string newOptionBuffer = "";

    // Toast Notification variables
    private string? toastMessage;
    private string toastType = "success";
    private bool showToast = false;

    private QuestionDto? selectedQuestion;
    private FormulaDto? selectedFormula;
    private ServiceSkuDto? selectedSku;
    private GraphEdgeDto? selectedEdge;
    private QuestionDto? selectedEdgeFromQuestion;
    private string edgeConditionBuffer = "";

    private ElementReference graphContainer;
    private IJSObjectReference? module;
    private DotNetObjectReference<SpiderNetManager>? dotNetHelper;

    private string statusMessage = "";
    private string errorMessage = "";
    private string syncJson = "";

    // Simulation fields
    private List<Guid> simSelectedQuestionIds = new();
    private Dictionary<string, object> simAnswers = new();
    private OfferSimulationResultDto? simulationResult;

    protected override async Task OnInitializedAsync()
    {
        dotNetHelper = DotNetObjectReference.Create(this);
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/BuildSmart.SharedUI/Components/Pages/Admin/SpiderNetManager.razor.js");
            await RenderGraphAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            questions = await ApiClient.GetQuestionsAsync();
            formulas = await ApiClient.GetFormulasAsync();
            graphData = await ApiClient.GetQuestionGraphAsync();
            serviceCategories = await ApiClient.GetServiceCategoriesAsync();

            // Fetch fully populated SKUs from the database via GraphQL for each category
            availableSkus.Clear();
            foreach (var cat in serviceCategories)
            {
                var skus = await ApiClient.GetServiceSkusByCategoryAsync(cat.Id);
                availableSkus.AddRange(skus);
            }

            // Extract unique categories from questions to build filter list
            var categoryGroups = questions
                .GroupBy(q => q.ServiceCategoryId)
                .Select(g => new { 
                    Id = g.Key?.ToString() ?? "Global", 
                    Name = g.Key == null ? "Global Questions" : (graphData.Nodes.FirstOrDefault(n => n.Id == g.First().Id.ToString())?.Category ?? "Other Category")
                })
                .ToList();

            filterCategories = categoryGroups.Select(cg => (cg.Id, cg.Name)).ToList();

            statusMessage = "Data successfully loaded from database.";
            errorMessage = "";
            StateHasChanged();

            await RenderGraphAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
        }
    }

    private async Task SetActiveTab(string tab)
    {
        activeTab = tab;
        selectedQuestion = null;
        selectedFormula = null;
        selectedSku = null;
        if (tab == "graph")
        {
            await Task.Delay(50); // Let UI render container div first
            await RenderGraphAsync();
        }
    }

    private async Task OnCategoryFilterChanged(ChangeEventArgs e)
    {
        selectedCategoryFilter = e.Value?.ToString() ?? "All";
        selectedQuestionFilter = "All";
        await RenderGraphAsync();
    }

    private async Task OnQuestionFilterChanged(ChangeEventArgs e)
    {
        selectedQuestionFilter = e.Value?.ToString() ?? "All";
        await RenderGraphAsync();
    }

    private IEnumerable<QuestionDto> GetFilteredQuestionsForDropdown()
    {
        return GetFilteredQuestions();
    }

    private IEnumerable<QuestionDto> GetFilteredQuestions()
    {
        if (selectedCategoryFilter == "All") return questions;
        if (selectedCategoryFilter == "Global") return questions.Where(q => q.ServiceCategoryId == null);
        return questions.Where(q => q.ServiceCategoryId?.ToString() == selectedCategoryFilter);
    }

    private async Task RenderGraphAsync()
    {
        if (module != null && graphContainer.Id != null)
        {
            var filteredQuestions = GetFilteredQuestions().ToList();

            if (selectedQuestionFilter != "All")
            {
                var targetQ = questions.FirstOrDefault(q => q.Id.ToString() == selectedQuestionFilter);
                if (targetQ != null)
                {
                    // Show only this question, its parent question, its child questions
                    var relatedQuestionIds = new HashSet<Guid> { targetQ.Id };
                    if (targetQ.ParentQuestionId.HasValue)
                    {
                        relatedQuestionIds.Add(targetQ.ParentQuestionId.Value);
                    }
                    
                    var childrenIds = questions
                        .Where(q => q.ParentQuestionId == targetQ.Id)
                        .Select(q => q.Id);
                    foreach (var cid in childrenIds)
                    {
                        relatedQuestionIds.Add(cid);
                    }

                    filteredQuestions = questions.Where(q => relatedQuestionIds.Contains(q.Id)).ToList();
                }
            }

            var questionIds = filteredQuestions.Select(q => q.Id.ToString()).ToHashSet();

            // Find SKUs and Formulas connected to the filtered questions
            var skuIdsToKeep = new HashSet<string>();
            var formulaIdsToKeep = new HashSet<string>();
            if (selectedQuestionFilter != "All")
            {
                var targetQ = questions.FirstOrDefault(q => q.Id.ToString() == selectedQuestionFilter);
                if (targetQ != null)
                {
                    skuIdsToKeep = targetQ.SkuIds.Select(id => id.ToString()).ToHashSet();
                    formulaIdsToKeep = targetQ.FormulaIds.Select(id => id.ToString()).ToHashSet();
                }
            }
            else
            {
                skuIdsToKeep = filteredQuestions.SelectMany(q => q.SkuIds).Select(id => id.ToString()).ToHashSet();
                formulaIdsToKeep = filteredQuestions.SelectMany(q => q.FormulaIds).Select(id => id.ToString()).ToHashSet();
            }

            // Filter graph nodes
            var filteredNodes = graphData.Nodes.Where(n => 
                (n.Type == "question" && questionIds.Contains(n.Id)) ||
                (n.Type == "sku" && skuIdsToKeep.Contains(n.Id)) ||
                (n.Type == "formula" && formulaIdsToKeep.Contains(n.Id))
            ).ToList();

            var nodeIdsToKeep = filteredNodes.Select(n => n.Id).ToHashSet();

            // Filter graph edges connecting these nodes
            var filteredEdges = graphData.Edges.Where(e => 
                nodeIdsToKeep.Contains(e.From) && nodeIdsToKeep.Contains(e.To)
            ).ToList();

            var nodes = filteredNodes.Select(n => new
            {
                id = n.Id,
                label = n.Label,
                group = n.Type,
                color = n.Type == "question" ? (n.Id == selectedQuestionFilter ? "#e91e63" : "#512bd4") : (n.Type == "formula" ? "#ffc107" : "#00bcd4")
            }).ToList();

            var edges = filteredEdges.Select(e => new
            {
                id = $"{e.From}_{e.To}",
                from = e.From,
                to = e.To,
                arrows = "to",
                label = e.Label,
                dashes = !string.IsNullOrEmpty(e.Label)
            }).ToList();

            await module.InvokeVoidAsync("initializeGraph", graphContainer, nodes, edges, dotNetHelper);
        }
    }

    [JSInvokable]
    public void OnNodeSelected(string nodeId)
    {
        selectedQuestion = null;
        selectedFormula = null;
        selectedSku = null;
        selectedEdge = null;
        selectedEdgeFromQuestion = null;

        var matchingNode = graphData.Nodes.FirstOrDefault(n => n.Id == nodeId);
        if (matchingNode != null)
        {
            if (matchingNode.Type == "question")
            {
                selectedQuestion = questions.FirstOrDefault(q => q.Id.ToString() == nodeId);
            }
            else if (matchingNode.Type == "formula")
            {
                selectedFormula = formulas.FirstOrDefault(f => f.Id.ToString() == nodeId);
            }
            else if (matchingNode.Type == "sku")
            {
                selectedSku = availableSkus.FirstOrDefault(s => s.Id.ToString() == nodeId);
            }
        }
        StateHasChanged();
    }

    [JSInvokable]
    public void OnEdgeSelected(string edgeId)
    {
        selectedQuestion = null;
        selectedFormula = null;
        selectedSku = null;
        selectedEdge = null;
        selectedEdgeFromQuestion = null;

        var parts = edgeId.Split('_');
        if (parts.Length == 2)
        {
            var fromId = parts[0];
            var toId = parts[1];

            selectedEdge = graphData.Edges.FirstOrDefault(e => e.From == fromId && e.To == toId);
            if (selectedEdge != null)
            {
                selectedEdgeFromQuestion = questions.FirstOrDefault(q => q.Id.ToString() == selectedEdge.From);
                if (selectedEdge.Type == "question-to-question")
                {
                    var destQ = questions.FirstOrDefault(q => q.Id.ToString() == selectedEdge.To);
                    edgeConditionBuffer = destQ?.VisibilityCondition ?? "";
                }
                else if (selectedEdge.Type == "question-to-sku")
                {
                    edgeConditionBuffer = selectedEdge.Label ?? "";
                }
                else
                {
                    edgeConditionBuffer = "";
                }
            }
        }
        StateHasChanged();
    }

    [JSInvokable]
    public void OnDeselectAll()
    {
        selectedQuestion = null;
        selectedFormula = null;
        selectedSku = null;
        selectedEdge = null;
        selectedEdgeFromQuestion = null;
        StateHasChanged();
    }

    private bool IsEdgeOptionSelected(string option)
    {
        if (string.IsNullOrEmpty(edgeConditionBuffer))
            return false;

        var selected = edgeConditionBuffer.Split('|').Select(s => s.Trim()).ToHashSet();
        return selected.Contains(option);
    }

    private void ToggleEdgeOption(string option, object? isChecked)
    {
        var check = isChecked is bool b && b;
        var selected = string.IsNullOrEmpty(edgeConditionBuffer)
            ? new List<string>()
            : edgeConditionBuffer.Split('|').Select(s => s.Trim()).ToList();

        if (check)
        {
            if (!selected.Contains(option))
                selected.Add(option);
        }
        else
        {
            selected.Remove(option);
        }

        edgeConditionBuffer = string.Join(" | ", selected);
        StateHasChanged();
    }

    private string GetNodeLabel(string nodeId)
    {
        var matchingNode = graphData.Nodes.FirstOrDefault(n => n.Id == nodeId);
        if (matchingNode != null)
        {
            if (matchingNode.Type == "question")
            {
                var q = questions.FirstOrDefault(x => x.Id.ToString() == nodeId);
                if (q != null)
                {
                    return $"[{q.QuestionCode}] {q.Text}";
                }
            }
            else if (matchingNode.Type == "sku")
            {
                var s = availableSkus.FirstOrDefault(x => x.Id.ToString() == nodeId);
                if (s != null)
                {
                    return $"[{s.SkuCode}] {s.Name}";
                }
            }
            else if (matchingNode.Type == "formula")
            {
                var f = formulas.FirstOrDefault(x => x.Id.ToString() == nodeId);
                if (f != null)
                {
                    return $"[{f.Name}] {f.Description}";
                }
            }
            return $"{matchingNode.Label} ({matchingNode.Type})";
        }
        return nodeId;
    }

    private async Task SaveEdgeConditionAsync()
    {
        if (selectedEdge == null) return;

        try
        {
            if (selectedEdge.Type == "question-to-question")
            {
                var destQ = questions.FirstOrDefault(q => q.Id.ToString() == selectedEdge.To);
                if (destQ != null)
                {
                    destQ.VisibilityCondition = edgeConditionBuffer;
                    var result = await ApiClient.UpdateQuestionAsync(destQ);
                    await ShowToastMessage("Question visibility trigger successfully updated.", "success");
                    await LoadDataAsync();
                }
            }
            else if (selectedEdge.Type == "question-to-sku")
            {
                var fromQ = questions.FirstOrDefault(q => q.Id.ToString() == selectedEdge.From);
                var toSku = availableSkus.FirstOrDefault(s => s.Id.ToString() == selectedEdge.To);
                if (fromQ != null && toSku != null)
                {
                    // Rebuild calculation formula
                    string updatedFormula = UpdateFormulaCondition(toSku.CalculationFormula, fromQ.QuestionCode, edgeConditionBuffer);
                    toSku.CalculationFormula = updatedFormula;
                    
                    var result = await ApiClient.UpdateServiceSkuAsync(toSku);
                    await ShowToastMessage("SKU condition formula successfully updated.", "success");
                    await LoadDataAsync();
                }
            }
        }
        catch (Exception ex)
        {
            await ShowToastMessage($"Error saving link condition: {ex.Message}", "danger");
        }
    }

    private string UpdateFormulaCondition(string formula, string questionCode, string newValue)
    {
        if (string.IsNullOrEmpty(formula))
            return $"if(Contains({questionCode}, '{newValue}'), 0, 0)"; // Fallback structure

        if (!formula.StartsWith("if(", StringComparison.OrdinalIgnoreCase))
        {
            // If it's a static calculation, wrap it in a conditional or if-then
            return $"if(Contains({questionCode}, '{newValue}'), {formula}, 0)";
        }

        int firstComma = FindFirstTopLevelComma(formula, 3);
        if (firstComma <= 3) return formula;

        string conditionPart = formula.Substring(3, firstComma - 3).Trim();
        string remainingPart = formula.Substring(firstComma);

        string newConditionPart = conditionPart;
        if (conditionPart.Contains("Contains"))
        {
            var regex = new System.Text.RegularExpressions.Regex(@"Contains\(\s*" + System.Text.RegularExpressions.Regex.Escape(questionCode) + @"\s*,\s*['""](.*?)['""]\s*\)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            if (regex.IsMatch(conditionPart))
            {
                newConditionPart = regex.Replace(conditionPart, $"Contains({questionCode}, '{newValue}')");
            }
            else
            {
                newConditionPart = $"Contains({questionCode}, '{newValue}')";
            }
        }
        else if (conditionPart.Contains("=="))
        {
            var regex = new System.Text.RegularExpressions.Regex(System.Text.RegularExpressions.Regex.Escape(questionCode) + @"\s*==\s*['""](.*?)['""]", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            if (regex.IsMatch(conditionPart))
            {
                newConditionPart = regex.Replace(conditionPart, $"{questionCode} == '{newValue}'");
            }
            else
            {
                newConditionPart = $"{questionCode} == '{newValue}'";
            }
        }
        else
        {
            newConditionPart = $"Contains({questionCode}, '{newValue}')";
        }

        return $"if({newConditionPart}{remainingPart}";
    }

    private int FindFirstTopLevelComma(string str, int startIndex)
    {
        int parenDepth = 0;
        for (int i = startIndex; i < str.Length; i++)
        {
            char c = str[i];
            if (c == '(') parenDepth++;
            else if (c == ')') parenDepth--;
            else if (c == ',' && parenDepth == 0)
            {
                return i;
            }
        }
        return -1;
    }

