    private async Task ImportDataAsync()
    {
        importLogLines.Clear();
        if (string.IsNullOrWhiteSpace(syncJson))
        {
            errorMessage = "Please paste a valid JSON configuration first.";
            LogError(errorMessage);
            return;
        }

        LogInfo("Initiating transactional schema sync on the server...");

        try
        {
            var result = await ApiClient.ImportSpiderNetConfigAsync(syncJson);
            
            // Render all logs returned by the server
            foreach (var line in result.LogLines)
            {
                importLogLines.Add(line);
            }

            if (result.Success)
            {
                statusMessage = "Configuration successfully imported and synchronized transactionally!";
                errorMessage = "";
                await LoadDataAsync();
                await ShowToastMessage(statusMessage, "success");
            }
            else
            {
                errorMessage = $"Import failed: {result.ErrorMessage}";
                LogError($"Transactional sync failed: {result.ErrorMessage}");
                await ShowToastMessage(errorMessage, "danger");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Import communication failed: {ex.Message}";
            LogError($"FATAL API COMMUNICATION EXCEPTION: {ex.Message}");
            await ShowToastMessage(errorMessage, "danger");
        }
    }

    private bool IsParentOptionSelected(string option)
    {
        if (selectedQuestion == null || string.IsNullOrEmpty(selectedQuestion.VisibilityCondition))
            return false;

        var selected = selectedQuestion.VisibilityCondition
            .Split('|')
            .Select(s => s.Trim())
            .ToHashSet();

        return selected.Contains(option);
    }

    private void ToggleParentOption(string option, object? isChecked)
    {
        if (selectedQuestion == null) return;

        var selected = string.IsNullOrEmpty(selectedQuestion.VisibilityCondition)
            ? new List<string>()
            : selectedQuestion.VisibilityCondition.Split('|').Select(s => s.Trim()).ToList();

        bool check = isChecked is bool b && b;

        if (check)
        {
            if (!selected.Contains(option))
            {
                selected.Add(option);
            }
        }
        else
        {
            selected.Remove(option);
        }

        selectedQuestion.VisibilityCondition = selected.Count > 0 ? string.Join(" | ", selected) : "";
    }
    public class AdminQuestionOption
    {
        public string Text { get; set; } = string.Empty;
        public string Icon { get; set; } = string.Empty;
        public string Swatch { get; set; } = string.Empty;
    }

    private List<AdminQuestionOption> GetRichQuestionOptionsList(QuestionDto q)
    {
        var list = new List<AdminQuestionOption>();
        if (string.IsNullOrEmpty(q.OptionsJson)) return list;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(q.OptionsJson);
            if (doc.RootElement.ValueKind == System.Text.Json.JsonValueKind.Array)
            {
                foreach (var el in doc.RootElement.EnumerateArray())
                {
                    if (el.ValueKind == System.Text.Json.JsonValueKind.Object)
                    {
                        var opt = new AdminQuestionOption();
                        if (el.TryGetProperty("text", out var tProp)) opt.Text = tProp.GetString() ?? "";
                        if (el.TryGetProperty("icon", out var iProp)) opt.Icon = iProp.GetString() ?? "";
                        if (el.TryGetProperty("swatch", out var sProp)) opt.Swatch = sProp.GetString() ?? "";
                        list.Add(opt);
                    }
                    else if (el.ValueKind == System.Text.Json.JsonValueKind.String)
                    {
                        list.Add(new AdminQuestionOption { Text = el.GetString() ?? "" });
                    }
                }
            }
        }
        catch
        {
            var rawList = GetQuestionOptionsList(q);
            list.AddRange(rawList.Select(r => new AdminQuestionOption { Text = r }));
        }
        return list;
    }

    private void SaveRichOptionsToQuestion(QuestionDto q, List<AdminQuestionOption> list)
    {
        if (list.Count == 0)
        {
            q.OptionsJson = "";
            return;
        }

        bool hasIconsOrSwatches = list.Any(o => !string.IsNullOrEmpty(o.Icon) || !string.IsNullOrEmpty(o.Swatch));
        if (hasIconsOrSwatches)
        {
            var serializedList = list.Select(o => new
            {
                text = o.Text,
                icon = string.IsNullOrEmpty(o.Icon) ? null : o.Icon,
                swatch = string.IsNullOrEmpty(o.Swatch) ? null : o.Swatch
            }).ToList();
            q.OptionsJson = System.Text.Json.JsonSerializer.Serialize(serializedList);
        }
        else
        {
            var stringList = list.Select(o => o.Text).ToList();
            q.OptionsJson = System.Text.Json.JsonSerializer.Serialize(stringList);
        }
    }

    private void AddRichOptionToQuestion(QuestionDto q)
    {
        if (string.IsNullOrWhiteSpace(newOptionBuffer)) return;
        var list = GetRichQuestionOptionsList(q);
        list.Add(new AdminQuestionOption { Text = newOptionBuffer.Trim(), Icon = newOptionIconBuffer.Trim() });
        SaveRichOptionsToQuestion(q, list);
        newOptionBuffer = "";
        newOptionIconBuffer = "";
    }

    private void UpdateRichOptionText(QuestionDto q, AdminQuestionOption opt, string newText)
    {
        var list = GetRichQuestionOptionsList(q);
        var target = list.FirstOrDefault(o => o.Text == opt.Text);
        if (target != null)
        {
            target.Text = newText.Trim();
            SaveRichOptionsToQuestion(q, list);
