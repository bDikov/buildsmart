@page "/admin/spider-net"
@using BuildSmart.SharedUI.Services
@using BuildSmart.SharedUI.Components.Common
@using BuildSmart.SharedUI.GraphQL
@using MediaAssetDto = BuildSmart.Core.Application.DTOs.MediaAssetDto
@using Microsoft.AspNetCore.Authorization
@using System.Text.Json
@attribute [Authorize(Roles = "Admin, ADMIN, admin")]
@inject IQuestionManagementApiClient ApiClient
@inject IFileService FileService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavManager

<div class="admin-container">
    <div class="header-section">
        <div class="title-group">
            <h1 class="page-title">Spider-Net Manager</h1>
            <p class="page-subtitle">Visualize and edit questions, formulas, SKU linkages, and Vis-Network dependency maps.</p>
        </div>
        <div class="header-actions">
            <button class="bs-btn-secondary" @onclick="LoadDataAsync">
                🔄 Refresh Data
            </button>
            <button class="bs-btn-primary" @onclick="OpenAddQuestionModal">
                ➕ New Question
            </button>
            <button class="bs-btn-primary ml-2" @onclick="OpenAddFormulaModal">
                ➕ New Formula
            </button>
            <button class="bs-btn-primary ml-2" @onclick="OpenAddSkuModal">
                ➕ New SKU
            </button>
            <button class="bs-btn-primary ml-2" @onclick="OpenAddCategoryModal">
                ➕ New Category
            </button>
        </div>
    </div>

    <!-- Error/Success Alerts -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-success">@statusMessage</div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <!-- Category & Question Filters -->
    <div class="filter-section mb-3" style="display: flex; flex-wrap: wrap; align-items: center; gap: 20px; background: rgba(255, 255, 255, 0.03); padding: 12px 18px; border-radius: 8px; border: 1px solid var(--border-color);">
        <div style="display: flex; align-items: center; gap: 10px;">
            <span style="font-weight: 700; font-size: 14px; color: var(--text-muted);">Filter Category:</span>
            <select class="bs-select" style="max-width: 320px;" @onchange="OnCategoryFilterChanged">
                <option value="All">All Categories</option>
                @foreach (var cat in filterCategories)
                {
                    <option value="@cat.Id">@cat.Name</option>
                }
            </select>
        </div>
        <div style="display: flex; align-items: center; gap: 10px;">
            <span style="font-weight: 700; font-size: 14px; color: var(--text-muted);">Focus Question:</span>
            <select class="bs-select" style="max-width: 400px;" @onchange="OnQuestionFilterChanged" value="@selectedQuestionFilter">
                <option value="All">Show All Questions in Category</option>
                @foreach (var q in GetFilteredQuestionsForDropdown())
                {
                    <option value="@q.Id">[@q.QuestionCode] @(q.Text.Length > 50 ? q.Text.Substring(0, 47) + "..." : q.Text)</option>
                }
            </select>
        </div>
        <div style="display: flex; align-items: center; gap: 10px; flex: 1; min-width: 250px;">
            <span style="font-weight: 700; font-size: 14px; color: var(--text-muted);">Search:</span>
            <input type="text" class="bs-input" style="padding: 6px 10px; font-size: 13px;" placeholder="Search questions by code/text..." value="@questionSearchText" @oninput="OnQuestionSearchInput" />
        </div>
    </div>

    <!-- Tabs -->
    <div class="tabs-container">
        <button class="tab-button @(activeTab == "graph" ? "active" : "")" @onclick='() => SetActiveTab("graph")'>🕸️ Graph Map</button>
        <button class="tab-button @(activeTab == "questions" ? "active" : "")" @onclick='() => SetActiveTab("questions")'>❓ Questions (@GetFilteredQuestions().Count())</button>
        <button class="tab-button @(activeTab == "formulas" ? "active" : "")" @onclick='() => SetActiveTab("formulas")'>🧮 Formulas (@formulas.Count)</button>
        <button class="tab-button @(activeTab == "skus" ? "active" : "")" @onclick='() => SetActiveTab("skus")'>🏷️ SKUs (@GetFilteredSkus().Count())</button>
        <button class="tab-button @(activeTab == "simulation" ? "active" : "")" @onclick='() => SetActiveTab("simulation")'>🧪 Run Simulation</button>
        <button class="tab-button @(activeTab == "sync" ? "active" : "")" @onclick='() => SetActiveTab("sync")'>💾 Import/Export</button>
        <button class="tab-button @(activeTab == "categories" ? "active" : "")" @onclick='() => SetActiveTab("categories")'>📁 Categories (@serviceCategories.Count)</button>
    </div>

    <div class="manager-body">
        <div class="main-content-panel">
            <!-- GRAPH VIEW -->
            <div class="tab-content @(activeTab == "graph" ? "show" : "hidden")">
                <div class="graph-wrapper bs-card">
                    <div @ref="graphContainer" class="graph-container"></div>
                    <div class="graph-legend">
                        <span class="legend-item"><span class="legend-dot legend-question"></span> Question Node</span>
                        <span class="legend-item"><span class="legend-dot legend-formula"></span> Formula Node</span>
                        <span class="legend-item"><span class="legend-dot legend-sku"></span> SKU Node</span>
                    </div>
                </div>
            </div>

            <!-- QUESTIONS VIEW -->
            <div class="tab-content @(activeTab == "questions" ? "show" : "hidden")">
                <div class="grid-layout">
                    @foreach (var q in GetFilteredQuestions())
                    {
                        <div class="bs-card item-card @(selectedQuestion?.Id == q.Id ? "highlighted" : "")" @onclick="() => SelectQuestion(q)">
                            <div class="card-header">
                                <span class="badge badge-question">@q.QuestionCode</span>
                                <span class="badge bg-dark">Order: @q.DisplayOrder</span>
                            </div>
                            <h3 class="card-title">@q.Text</h3>
                            <p class="card-desc">Type: <strong>@q.Type</strong> | Required: <strong>@(q.IsRequired ? "Yes" : "No")</strong></p>
                            @if (!string.IsNullOrEmpty(q.HintText))
                            {
                                <p class="help-text">💡 @q.HintText</p>
                            }
                            <div class="card-links">
                                🔗 Skus: <span class="link-count">@q.SkuIds.Count</span> | Formulas: <span class="link-count">@q.FormulaIds.Count</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- FORMULAS VIEW -->
            <div class="tab-content @(activeTab == "formulas" ? "show" : "hidden")">
                <div class="grid-layout">
                    @foreach (var f in formulas)
                    {
                        <div class="bs-card item-card @(selectedFormula?.Id == f.Id ? "highlighted" : "")" @onclick="() => SelectFormula(f)">
                            <div class="card-header">
                                <span class="badge badge-formula">@f.Name</span>
                            </div>
                            <h3 class="card-title">@f.Description</h3>
                            <code class="formula-code">@f.Expression</code>
                        </div>
                    }
                </div>
            </div>

            <!-- SKUS VIEW -->
            <div class="tab-content @(activeTab == "skus" ? "show" : "hidden")">
                <div class="grid-layout">
                    @foreach (var s in GetFilteredSkus())
                    {
                        <div class="bs-card item-card @(selectedSku?.Id == s.Id ? "highlighted" : "")" @onclick="() => SelectSku(s)">
                            <div class="card-header">
                                <span class="badge badge-sku">@s.SkuCode</span>
                                <span class="badge bg-dark">@s.UnitType</span>
                            </div>
                            <h3 class="card-title">@s.Name</h3>
                            <p class="card-desc">@s.Description</p>
                            <div class="card-meta" style="font-weight: 700; color: var(--accent-color); margin-top: 8px;">Base Price: @s.BasePrice lv.</div>
                        </div>
                    }
                </div>
            </div>

            <!-- CATEGORIES VIEW -->
            <div class="tab-content @(activeTab == "categories" ? "show" : "hidden")">
                <div class="grid-layout">
                    @foreach (var c in serviceCategories)
                    {
                        <div class="bs-card item-card @(selectedCategory?.Id == c.Id ? "highlighted" : "")" @onclick="() => SelectCategory(c)">
                            <div class="card-header">
                                <span class="badge @(c.IsGlobal ? "badge-formula" : "badge-sku")">@(c.IsGlobal ? "Global" : "Specific")</span>
                                <span class="badge bg-dark">@(string.IsNullOrEmpty(c.Status) ? "Draft" : c.Status)</span>
                            </div>
                            <h3 class="card-title">@c.Name</h3>
                            <p class="card-desc">@c.Description</p>
                        </div>
                    }
                </div>
            </div>

            <!-- SIMULATION VIEW -->
            <div class="tab-content @(activeTab == "simulation" ? "show" : "hidden")">
                <div class="simulation-panel bs-card">
                    <h2>Execute Offer Simulation</h2>
                    <p class="help-text">Select the questions you want to activate, fill out mock answers, and run the calculation engine.</p>
                    
                    <div class="sim-columns">
                        <div class="sim-left">
                            <h3>1. Select Questions to Answer</h3>
                            <div class="checkbox-list">
                                @foreach (var q in questions)
                                {
                                    <label class="checkbox-item">
                                        <input type="checkbox" @onchange='(e) => ToggleSimQuestion(q.Id, e.Value)' checked="@simSelectedQuestionIds.Contains(q.Id)" />
                                        <span><strong>@q.QuestionCode</strong> (@q.Text)</span>
                                    </label>
                                }
                            </div>
                        </div>
                        <div class="sim-right">
                            <h3>2. Fill Out Mock Answers</h3>
                            <div class="answers-form">
                                @foreach (var qId in simSelectedQuestionIds)
                                {
                                    var question = questions.FirstOrDefault(q => q.Id == qId);
                                    if (question == null) continue;

                                    <div class="form-group">
                                        <label>@question.Text (@question.QuestionCode)</label>
                                        @if (question.Type == "boolean" || question.Type == "bool")
                                        {
                                            <select class="bs-select" @onchange='(e) => UpdateSimAnswer(question.QuestionCode, e.Value?.ToString() == "true")'>
                                                <option value="false">No / False</option>
                                                <option value="true">Yes / True</option>
                                            </select>
                                        }
                                        else if (question.Type == "choice" && !string.IsNullOrEmpty(question.OptionsJson))
                                        {
                                            var opts = DeserializeOptions(question.OptionsJson);
                                            <select class="bs-select" @onchange='(e) => UpdateSimAnswer(question.QuestionCode, e.Value?.ToString())'>
                                                <option value="">-- Choose Option --</option>
                                                @foreach (var opt in opts)
                                                {
                                                    <option value="@opt">@opt</option>
                                                }
                                            </select>
                                        }
                                        else if (question.Type == "number")
                                        {
                                            <input type="number" class="bs-input" placeholder="Enter numeric value" @onchange='(e) => UpdateSimAnswer(question.QuestionCode, decimal.TryParse(e.Value?.ToString(), out var v) ? v : 0m)' />
                                        }
                                        else
                                        {
                                            <input type="text" class="bs-input" placeholder="Enter text value" @onchange='(e) => UpdateSimAnswer(question.QuestionCode, e.Value?.ToString())' />
                                        }
                                    </div>
                                }
                                @if (simSelectedQuestionIds.Count == 0)
                                {
                                    <p class="help-text text-center">Select questions from the left to start answering.</p>
                                }
                            </div>
                            
                            <button class="bs-btn-primary w-100 mt-4" @onclick="RunSimulationAsync" disabled="@(simSelectedQuestionIds.Count == 0)">
                                ⚡ Run Calculations
                            </button>
                        </div>
                    </div>

                    <!-- Simulation Result -->
                    @if (simulationResult != null)
                    {
                        <div class="simulation-results mt-5">
                            <h3>Calculation Results</h3>
                            <div class="results-meta">
                                <div class="total-price-badge">
                                    Grand Total: <span>@simulationResult.TotalPrice.ToString("C2")</span>
                                </div>
                            </div>

                            @if (simulationResult.Warnings.Count > 0)
                            {
                                <div class="alert alert-warning mt-3">
                                    <strong>Warnings:</strong>
                                    <ul>
                                        @foreach (var warning in simulationResult.Warnings)
                                        {
                                            <li>@warning</li>
                                        }
                                    </ul>
                                </div>
                            }

                            <table class="results-table mt-3">
                                <thead>
                                    <tr>
                                        <th>SKU Code</th>
                                        <th>Task Title</th>
                                        <th>Calculated Qty</th>
                                        <th>Unit</th>
                                        <th>Base Price</th>
                                        <th>Total Price</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var task in simulationResult.Tasks)
                                    {
                                        <tr>
                                            <td><code>@task.SkuCode</code></td>
                                            <td>@task.Title</td>
                                            <td>@task.Quantity.ToString("F2")</td>
                                            <td>@task.UnitType</td>
                                            <td>@task.BasePrice.ToString("C2")</td>
                                            <td class="font-weight-bold">@task.TotalPrice.ToString("C2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <!-- IMPORT/EXPORT VIEW -->
            <div class="tab-content @(activeTab == "sync" ? "show" : "hidden")">
                <div class="sync-panel bs-card">
                    <h2>Import/Export Spider-Net Configuration</h2>
                    <p class="help-text">Backup or restore all questions, visibility logic, formulas, and connections in one JSON block.</p>
                    
                    <div class="form-group mt-3">
                        <label>Configuration JSON</label>
                        <textarea class="bs-input code-textarea" rows="12" @bind="syncJson" placeholder="Paste your backup JSON here..."></textarea>
                    </div>

                    <div class="sync-actions mt-3">
                        <button class="bs-btn-secondary" @onclick="ExportDataAsync">Export Configuration</button>
                        <button class="bs-btn-primary ml-2" @onclick="ImportDataAsync">Import & Sync Schema</button>
                    </div>

                    @if (importLogLines.Any())
                    {
                        <div class="form-group mt-4">
                            <label style="font-weight: 600; color: var(--text-muted); display: block; margin-bottom: 8px;">Import Activity Log</label>
                            <div class="bs-input log-display" style="background-color: #11141e; color: #a9b2c3; font-family: monospace; font-size: 12px; max-height: 250px; overflow-y: auto; padding: 12px; border-radius: 6px; border: 1px solid var(--border-color); line-height: 1.6;">
                                @foreach (var line in importLogLines)
                                {
                                    var color = "#a9b2c3";
                                    if (line.Contains("[ERROR]")) color = "#f87171";
                                    else if (line.Contains("[WARNING]")) color = "#fbbf24";
                                    else if (line.Contains("[SUCCESS]")) color = "#34d399";
                                    else if (line.Contains("[INFO]")) color = "#60a5fa";
                                    
                                    <div style="color: @color; white-space: pre-wrap; margin-bottom: 3px;">@line</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- RIGHT SIDE DETAILS DRAWER -->
        <div class="details-panel bs-card">
            @if (selectedQuestion != null)
            {
                <div class="drawer-header">
                    <h2>Edit Question</h2>
                    <button class="remove-btn text-danger" @onclick="() => DeleteQuestionAsync(selectedQuestion.Id)">🗑️ Delete</button>
                </div>
                <div class="drawer-body">
                    <div class="form-group">
                        <label>Question Code (Unique Variable Name)</label>
                        <input type="text" class="bs-input" @bind="selectedQuestion.QuestionCode" />
                    </div>
                    <div class="form-group">
                        <label>Display Text (Bulgarian)</label>
                        <textarea class="bs-input" @bind="selectedQuestion.Text" rows="2"></textarea>
                    </div>
                    <div class="form-group" style="margin-top: 12px;">
                        <label>Display Text (English)</label>
                        <textarea class="bs-input" @bind="selectedQuestion.EnglishText" rows="2" placeholder="e.g. What is the property type?"></textarea>
                    </div>
                    <div class="form-group">
                        <label>Input Type</label>
                        <select class="bs-select" @bind="selectedQuestion.Type">
                            <option value="text">Text Input</option>
                            <option value="number">Number Input</option>
                            <option value="boolean">Boolean Switch (Yes/No)</option>
                            <option value="choice">Single-Choice Dropdown</option>
                            <option value="multiselect">Multi-Choice Checklist</option>
                        </select>
                    </div>
                    <div class="form-group checkbox-row">
                        <label>Is Field Required?</label>
                        <input type="checkbox" @bind="selectedQuestion.IsRequired" />
                    </div>
                    <div class="form-group">
                        <label>Hint/Tooltip Text (Bulgarian)</label>
                        <input type="text" class="bs-input" @bind="selectedQuestion.HintText" />
                    </div>
                    <div class="form-group" style="margin-top: 12px;">
                        <label>Hint/Tooltip Text (English)</label>
                        <input type="text" class="bs-input" @bind="selectedQuestion.EnglishHint" placeholder="English translation of the hint" />
                    </div>
                    <div class="form-group">
                        <label>Display Order (Sorting)</label>
                        <input type="number" class="bs-input" @bind="selectedQuestion.DisplayOrder" />
                    </div>
                    
                    <div class="form-group">
                        <label>Parent Question (Visibility Trigger)</label>
                        <select class="bs-select" @bind="selectedQuestion.ParentQuestionId">
                            <option value="">-- None (Always Visible) --</option>
                            @foreach (var group in questions
                                .Where(x => x.Id != selectedQuestion.Id)
                                .GroupBy(q => q.ServiceCategoryId))
                            {
                                var categoryName = group.Key == null 
                                    ? "Global Questions" 
                                    : (graphData.Nodes.FirstOrDefault(n => n.Id == group.First().Id.ToString())?.Category ?? "Other Category");
                                    
                                <optgroup label="@categoryName">
                                    @foreach (var q in group)
                                    {
                                        <option value="@q.Id">[@q.QuestionCode] @(q.Text.Length > 55 ? q.Text.Substring(0, 52) + "..." : q.Text)</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>

                    @if (selectedQuestion.ParentQuestionId.HasValue && selectedQuestion.ParentQuestionId.Value != Guid.Empty)
                    {
                        var parentQ = questions.FirstOrDefault(q => q.Id == selectedQuestion.ParentQuestionId.Value);
                        if (parentQ != null)
                        {
                            @if (parentQ.Type == "choice" || parentQ.Type == "multiselect")
                            {
                                var parentOptions = new List<string>();
                                try
                                {
                                    parentOptions = string.IsNullOrEmpty(parentQ.OptionsJson) 
                                        ? new List<string>() 
                                        : System.Text.Json.JsonSerializer.Deserialize<List<string>>(parentQ.OptionsJson) ?? new List<string>();
                                }
                                catch {}

                                <div class="form-group mb-3" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); border-radius: 8px; padding: 12px;">
                                    <span style="font-size: 12px; font-weight: 700; color: var(--text-muted); display: block; margin-bottom: 8px;">Triggering Parent Options:</span>
                                    @if (parentOptions.Count == 0)
                                    {
                                        <p class="help-text text-warning" style="margin: 0; font-size: 12px;">💡 Parent question has no options configured yet.</p>
                                    }
                                    @foreach (var opt in parentOptions)
                                    {
                                        <label class="checkbox-item" style="margin-bottom: 6px; display: flex; align-items: center; gap: 8px; user-select: none;">
                                            <input type="checkbox" checked="@IsParentOptionSelected(opt)" @onchange='(e) => ToggleParentOption(opt, e.Value)' />
                                            <span style="color: #ffffff; font-size: 13px;">@opt</span>
                                        </label>
                                    }
                                </div>
                            }
                            else if (parentQ.Type == "boolean")
                            {
                                <div class="form-group mb-3" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); border-radius: 8px; padding: 12px;">
                                    <span style="font-size: 12px; font-weight: 700; color: var(--text-muted); display: block; margin-bottom: 8px;">Triggering Parent Options:</span>
                                    <label class="checkbox-item" style="margin-bottom: 6px; display: flex; align-items: center; gap: 8px; user-select: none;">
                                        <input type="checkbox" checked='@IsParentOptionSelected("True")' @onchange='(e) => ToggleParentOption("True", e.Value)' />
                                        <span style="color: #ffffff; font-size: 13px;">Yes / Checked (True)</span>
                                    </label>
                                    <label class="checkbox-item" style="display: flex; align-items: center; gap: 8px; user-select: none;">
                                        <input type="checkbox" checked='@IsParentOptionSelected("False")' @onchange='(e) => ToggleParentOption("False", e.Value)' />
                                        <span style="color: #ffffff; font-size: 13px;">No / Unchecked (False)</span>
                                    </label>
                                </div>
                            }
                        }
                    }

                    <div class="form-group">
                        <label>Parent Value Condition (e.g. 'Yes' or 'Апартамент')</label>
                        <input type="text" class="bs-input" @bind="selectedQuestion.VisibilityCondition" placeholder="Visibility Condition Value" />
                    </div>
                    @if (selectedQuestion.Type == "choice" || selectedQuestion.Type == "multiselect")
                    {
                        <div class="form-group" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); border-radius: 8px; padding: 12px; margin-bottom: 16px;">
                            <label style="font-weight: 700; color: var(--text-muted); font-size: 13px; display: block; margin-bottom: 8px;">Choice Options & Icon Manager:</label>
                            
                            @{
                                var richOpts = GetRichQuestionOptionsList(selectedQuestion);
                            }
                            
                            @if (richOpts.Count == 0)
                            {
                                <p class="help-text" style="color: var(--text-muted); font-size: 12px; margin: 0 0 10px 0;">No options configured yet.</p>
                            }
                            else
                            {
                                <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px;">
                                    @foreach (var opt in richOpts)
                                    {
                                        <div style="display: flex; align-items: center; gap: 8px; background: #16171a; padding: 8px 12px; border-radius: 6px; border: 1px solid var(--border-color); flex-wrap: wrap;">
                                            <input type="text" class="bs-input" style="flex: 1; min-width: 120px; padding: 4px 8px; font-size: 13px;" value="@opt.Text" placeholder="Option title..." @onchange="@(e => UpdateRichOptionText(selectedQuestion, opt, e.Value?.ToString() ?? ""))" />
                                            
                                            <input type="text" class="bs-input" style="width: 140px; padding: 4px 8px; font-size: 12px;" value="@opt.Icon" placeholder="Icon key or URL..." @onchange="@(e => UpdateRichOptionIcon(selectedQuestion, opt, e.Value?.ToString() ?? ""))" />

                                            <button type="button" class="bs-btn-secondary" style="padding: 4px 8px; font-size: 12px; white-space: nowrap;" @onclick="() => OpenIconPickerForOption(selectedQuestion, opt)">🎨 Browse / Upload</button>

                                            <button type="button" class="btn-link text-danger" style="background: transparent; border: none; cursor: pointer; padding: 2px 6px; font-size: 14px;" @onclick="() => RemoveRichOptionFromQuestion(selectedQuestion, opt)">❌</button>
                                        </div>
                                    }
                                </div>
                            }
                            
                            <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                                <input type="text" class="bs-input" style="flex: 1; min-width: 130px; padding: 6px 10px; font-size: 13px;" placeholder="Add option text..." @bind="newOptionBuffer" />
                                <input type="text" class="bs-input" style="width: 140px; padding: 6px 10px; font-size: 12px;" placeholder="Icon URL or key..." @bind="newOptionIconBuffer" />
                                <button type="button" class="bs-btn-secondary" style="padding: 6px 10px; font-size: 12px; white-space: nowrap;" @onclick="() => OpenIconPickerForNewOption()">🎨 Browse / Upload</button>
                                <button type="button" class="bs-btn-primary" style="padding: 6px 12px; font-size: 13px;" @onclick="() => AddRichOptionToQuestion(selectedQuestion)">➕ Add Option</button>
                            </div>
                        </div>
                    }

                    <div class="form-group">
                        <label>Choice Options JSON Array (for choice/multiselect)</label>
                        <textarea class="bs-input" @bind="selectedQuestion.OptionsJson" rows="2" placeholder='["Option 1", "Option 2"]'></textarea>
                    </div>

                    <!-- LINK MANAGEMENT -->
                    <div class="links-section mt-4">
                        <h3>Sku & Formula Connections</h3>
                        <p class="help-text">Link this question to formulas and SKUs to route answers into price calculations.</p>
                        
                        <div class="link-scroller">
                            <strong>Formula Links:</strong>
                            <div class="checkbox-list mt-1">
                                @foreach (var f in formulas)
                                {
                                    <label class="checkbox-item">
                                        <input type="checkbox" @onchange='(e) => ToggleFormulaLink(f.Id, e.Value)' checked="@selectedQuestion.FormulaIds.Contains(f.Id)" />
                                        <span>@f.Name</span>
                                    </label>
                                }
                            </div>
                        </div>

                        <div class="link-scroller mt-3">
                            <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 10px;">
                                <strong>SKU Links:</strong>
                                <div style="display: flex; gap: 8px;">
                                    <input type="text" class="bs-input" style="flex: 1; padding: 6px 10px; font-size: 13px;" placeholder="Search SKUs by code/name..." @bind="skuLinkSearchText" @bind:event="oninput" />
                                    <select class="bs-select" style="max-width: 150px; padding: 6px; font-size: 13px;" @bind="skuLinkCategoryFilter">
                                        <option value="All">All Trades</option>
                                        @foreach (var cat in serviceCategories)
                                        {
                                            <option value="@cat.Id">@cat.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="checkbox-list mt-1" style="max-height: 250px; overflow-y: auto; border: 1px solid var(--border-color); padding: 8px; border-radius: 6px;">
                                @foreach (var s in GetFilteredSkusForLinking())
                                {
                                    <label class="checkbox-item" style="margin-bottom: 6px; display: flex; align-items: center; gap: 8px; user-select: none;">
                                        <input type="checkbox" @onchange='(e) => ToggleSkuLink(s.Id, e.Value)' checked="@selectedQuestion.SkuIds.Contains(s.Id)" />
                                        <span style="font-size: 13px; color: #ffffff;">@s.SkuCode (@s.Name)</span>
                                    </label>
                                }
                            </div>
                        </div>
                    </div>

                    <button class="bs-btn-primary w-100 mt-4" @onclick="SaveQuestionAsync">
                        💾 Save Question Details
                    </button>
                </div>
            }
            else if (selectedFormula != null)
            {
                <div class="drawer-header">
                    <h2>Edit Formula</h2>
                    <button class="remove-btn text-danger" @onclick="() => DeleteFormulaAsync(selectedFormula.Id)">🗑️ Delete</button>
                </div>
                <div class="drawer-body">
                    <div class="form-group">
                        <label>Formula Variable Name (e.g. wall_area_calc)</label>
                        <input type="text" class="bs-input" @bind="selectedFormula.Name" />
                    </div>
                    <div class="form-group">
                        <label>Description</label>
                        <input type="text" class="bs-input" @bind="selectedFormula.Description" />
                    </div>
                    <div class="form-group">
                        <label>NCalc Expression (e.g. global_total_sqm * 2.8)</label>
                        <textarea class="bs-input code-textarea" @bind="selectedFormula.Expression" rows="3"></textarea>
                    </div>

                    <button class="bs-btn-primary w-100 mt-4" @onclick="SaveFormulaAsync">
                        💾 Save Formula
                    </button>
                </div>
            }
            else if (selectedSku != null)
            {
                <div class="drawer-header">
                    <h2>Edit SKU</h2>
                    <button class="remove-btn text-danger" @onclick="() => DeleteSkuAsync(selectedSku.Id)">🗑️ Delete</button>
                </div>
                <div class="drawer-body">
                    <div class="form-group">
                        <label>SKU Code (e.g. ELEC-001)</label>
                        <input type="text" class="bs-input" @bind="selectedSku.SkuCode" />
                    </div>
                    <div class="form-group">
                        <label>Service Category</label>
                        <select class="bs-select" @bind="selectedSku.ServiceCategoryId">
                            @foreach (var cat in serviceCategories)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Name (Bulgarian)</label>
                        <input type="text" class="bs-input" @bind="selectedSku.Name" />
                    </div>
                    <div class="form-group" style="margin-top: 12px;">
                        <label>Name (English)</label>
                        <input type="text" class="bs-input" @bind="selectedSku.EnglishName" placeholder="e.g. Plumbing Installation" />
                    </div>
                    <div class="form-group" style="margin-top: 12px;">
                        <label>Description (Bulgarian)</label>
                        <textarea class="bs-input" @bind="selectedSku.Description" rows="2"></textarea>
                    </div>
                    <div class="form-group" style="margin-top: 12px;">
                        <label>Description (English)</label>
                        <textarea class="bs-input" @bind="selectedSku.EnglishDescription" rows="2" placeholder="e.g. Detailed description in English"></textarea>
                    </div>
                    <div class="form-group">
                        <label>Base Price (lv.)</label>
                        <input type="number" class="bs-input" @bind="selectedSku.BasePrice" step="0.01" />
                    </div>
                    <div class="form-group">
                        <label>Unit Type (e.g. pcs, sqm, lm)</label>
                        <input type="text" class="bs-input" @bind="selectedSku.UnitType" />
                    </div>
                    <div class="form-group">
                        <label>Calculation Formula (NCalc Expression)</label>
                        <textarea class="bs-input code-textarea" @bind="selectedSku.CalculationFormula" rows="3" placeholder="e.g. if(Contains(paint_finish_level, 'Q5'), global_total_sqm * 2.5, 0)"></textarea>
                    </div>

                    <button class="bs-btn-primary w-100 mt-4" @onclick="SaveSkuAsync">
                        💾 Save SKU Details
                    </button>
                </div>
            }
            else if (selectedCategory != null)
            {
                <div class="drawer-header">
                    <h2>Edit Category</h2>
                    <button class="remove-btn text-danger" @onclick="() => DeleteCategoryAsync(selectedCategory.Id)">🗑️ Delete</button>
                </div>
                <div class="drawer-body">
                    <div class="form-group">
                        <label>Category Name (Bulgarian)</label>
                        <input type="text" class="bs-input" @bind="selectedCategory.Name" />
                    </div>
                    <div class="form-group" style="margin-top: 12px;">
                        <label>Category Name (English)</label>
                        <input type="text" class="bs-input" @bind="englishName" placeholder="e.g. Painting and Plastering" />
                    </div>
                    <div class="form-group" style="margin-top: 12px;">
                        <label>Category Trade Icon (Wizard Card)</label>
                        <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 8px;">
                            <input type="text" class="bs-input" style="flex: 1;" placeholder="Icon key or URL..." @bind="selectedCategoryIcon" />
                            <button type="button" class="bs-btn-secondary" style="padding: 6px 12px; font-size: 13px; white-space: nowrap;" @onclick="() => OpenIconPickerForCategory()">🎨 Browse Icons</button>
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.02); padding: 8px 12px; border-radius: 8px; border: 1px solid var(--border-color);">
                            <span style="font-size: 12px; color: var(--text-muted); font-weight: 600;">📁 Upload Image:</span>
                            <InputFile OnChange="HandleCategoryIconUpload" accept="image/*" class="bs-input" style="padding: 4px 8px; font-size: 12px; flex: 1;" />
                        </div>
                    </div>
                    <div class="form-group" style="margin-top: 12px;">
                        <label>Description</label>
                        <textarea class="bs-input" @bind="selectedCategory.Description" rows="2"></textarea>
                    </div>
                    <div class="form-group checkbox-row" style="margin-top: 12px; margin-bottom: 12px;">
                        <label for="chkGlobalCat" style="margin-bottom: 0; user-select: none; cursor: pointer;">Is Global Category (Wizard Setup)</label>
                        <label class="switch">
                            <input type="checkbox" @bind="selectedCategory.IsGlobal" id="chkGlobalCat" />
                            <span class="slider"></span>
                        </label>
                    </div>
                    <div class="form-group checkbox-row" style="margin-top: 12px; margin-bottom: 12px;">
                        <label for="chkProjDetailsCat" style="margin-bottom: 0; user-select: none; cursor: pointer;">Is Project Details (System Category - Hidden from Wizard)</label>
                        <label class="switch">
                            <input type="checkbox" @bind="isProjectDetails" id="chkProjDetailsCat" />
                            <span class="slider"></span>
                        </label>
                    </div>
                    <div class="form-group">
                        <label>Status</label>
                        <select class="bs-select" @bind="selectedCategory.Status">
                            <option value="ACTIVE">Active</option>
                            <option value="DRAFT">Draft</option>
                            <option value="ARCHIVED">Archived</option>
                        </select>
                    </div>

                    @if (editingTemplateQuestion != null)
                    {
                        <div style="border: 1px solid var(--border-color); padding: 12px; border-radius: 8px; margin-top: 16px; background-color: rgba(255,255,255,0.02);">
                            <h4 style="margin-top: 0; color: var(--accent-color);">
                                @(isEditingNewTemplateQuestion ? "➕ Add Question" : "✏️ Edit Question")
                            </h4>
                            
                            <div class="form-group">
                                <label>Question ID (e.g. wall_height)</label>
                                <input type="text" class="bs-input" @bind="editingTemplateQuestion.Id" placeholder="Use lowercase and underscores" readonly="@(!isEditingNewTemplateQuestion)" />
                            </div>
                            
                            <div class="form-group">
                                <label>Type</label>
                                <select class="bs-select" @bind="editingTemplateQuestion.Type">
                                    <option value="text">Text Input</option>
                                    <option value="number">Number Input</option>
                                    <option value="choice">Single Choice Dropdown</option>
                                    <option value="multiselect">Multi-select Checklist</option>
                                    <option value="boolean">Yes / No Switch</option>
                                </select>
                            </div>
                            
                            <div class="form-group">
                                <label>Question Text (Bulgarian)</label>
                                <input type="text" class="bs-input" @bind="editingTemplateQuestion.TextBg" placeholder="Каква е квадратурата?" />
                            </div>

                            <div class="form-group">
                                <label>Question Text (English)</label>
                                <input type="text" class="bs-input" @bind="editingTemplateQuestion.TextEn" placeholder="What is the square footage?" />
                            </div>

                            <div class="form-group checkbox-row" style="margin-top: 12px; margin-bottom: 12px;">
                                <label for="chkReqTemplateQ" style="margin-bottom: 0; user-select: none; cursor: pointer;">Mandatory / Required Field</label>
                                <label class="switch">
                                    <input type="checkbox" @bind="editingTemplateQuestion.Required" id="chkReqTemplateQ" />
                                    <span class="slider"></span>
                                </label>
                            </div>

                            @if (editingTemplateQuestion.Type == "choice" || editingTemplateQuestion.Type == "multiselect")
                            {
                                <div class="form-group">
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                                        <label style="margin-bottom: 0;">Options (One per line)</label>
                                        <div class="lang-toggle-container" style="display: inline-flex; background: rgba(0,0,0,0.25); border-radius: 6px; padding: 2px; border: 1px solid var(--border-color);">
                                            <button type="button" class="lang-toggle-btn @(editingOptionsLanguage == "bg" ? "active" : "")" 
                                                    style="padding: 2px 8px; font-size: 0.75rem; font-weight: 600; border: none; border-radius: 4px; cursor: pointer; transition: all 0.2s; background: @(editingOptionsLanguage == "bg" ? "var(--accent-color)" : "transparent"); color: @(editingOptionsLanguage == "bg" ? "#fff" : "var(--text-muted)");"
                                                    @onclick='() => editingOptionsLanguage = "bg"'>BG</button>
                                            <button type="button" class="lang-toggle-btn @(editingOptionsLanguage == "en" ? "active" : "")" 
                                                    style="padding: 2px 8px; font-size: 0.75rem; font-weight: 600; border: none; border-radius: 4px; cursor: pointer; transition: all 0.2s; background: @(editingOptionsLanguage == "en" ? "var(--accent-color)" : "transparent"); color: @(editingOptionsLanguage == "en" ? "#fff" : "var(--text-muted)");"
                                                    @onclick='() => editingOptionsLanguage = "en"'>EN</button>
                                        </div>
                                    </div>
                                    @if (editingOptionsLanguage == "bg")
                                    {
                                        <textarea class="bs-input" @bind="bgOptionsString" rows="4" placeholder="Option 1&#10;Option 2&#10;Option 3"></textarea>
                                    }
                                    else
                                    {
                                        <textarea class="bs-input" @bind="enOptionsString" rows="4" placeholder="English translation (Line 1 translates Line 1 BG)"></textarea>
                                    }
                                </div>
                            }

                            <div class="form-group" style="border-top: 1px dashed var(--border-color); padding-top: 8px; margin-top: 12px;">
                                <label style="font-weight: 600; color: var(--text-muted);">Conditional Visibility (Optional)</label>
                            </div>

                            <div class="form-group">
                                <label>Depends On Question ID</label>
                                <input type="text" class="bs-input" @bind="editingTemplateQuestion.DependsOn" placeholder="e.g. global_property_type" />
                            </div>

                            <div class="form-group">
                                <label>Depends On Value</label>
                                <input type="text" class="bs-input" @bind="editingTemplateQuestion.DependsOnValue" placeholder="e.g. Апартамент" />
                            </div>

                            <div style="display: flex; gap: 8px; margin-top: 16px;">
                                <button type="button" class="bs-btn-primary" style="flex: 1;" @onclick="ApplyTemplateQuestionChanges">✔️ Apply</button>
                                <button type="button" class="bs-btn-secondary" @onclick="() => editingTemplateQuestion = null">❌ Cancel</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div style="margin-top: 20px; border-top: 1px solid var(--border-color); padding-top: 16px;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                                <h3 style="margin: 0; font-size: 1.1rem; color: var(--text-color);">❓ Questions in Category</h3>
                                <button type="button" class="bs-btn-secondary" style="padding: 4px 8px; font-size: 0.85rem;" @onclick="StartAddTemplateQuestion">➕ Add Question</button>
                            </div>

                            <div style="max-height: 250px; overflow-y: auto; border: 1px solid var(--border-color); border-radius: 6px; padding: 4px; background: rgba(0,0,0,0.15);">
                                @if (categoryQuestions.Count == 0)
                                {
                                    <div style="padding: 12px; text-align: center; color: var(--text-muted); font-style: italic;">No questions defined yet.</div>
                                }
                                else
                                {
                                    @foreach (var q in categoryQuestions)
                                    {
                                        var matchedQ = questions.FirstOrDefault(x => x.QuestionCode == q.Id);
                                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 8px; border-bottom: 1px solid rgba(255,255,255,0.05); gap: 8px;">
                                            <div style="flex: 1; min-width: 0; cursor: pointer;" @onclick="() => { if (matchedQ != null) SelectQuestion(matchedQ); }" title="Click to edit full question connections and translations">
                                                <div style="font-weight: 600; font-size: 0.85rem; color: var(--accent-color); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-decoration: underline;">
                                                    [@q.Id] (@q.Type)
                                                </div>
                                                <div style="font-size: 0.8rem; color: var(--text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                    @q.TextBg
                                                </div>
                                            </div>
                                            <div style="display: flex; gap: 4px;">
                                                <button type="button" class="bs-btn-secondary" style="padding: 2px 6px; font-size: 0.75rem;" @onclick="() => StartEditTemplateQuestion(q)">✏️</button>
                                                <button type="button" class="bs-btn-secondary" style="padding: 2px 6px; font-size: 0.75rem; color: var(--danger-color);" @onclick="() => RemoveTemplateQuestion(q)">❌</button>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>

                        <div class="form-group" style="margin-top: 16px;">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <label style="font-size: 13px; font-weight: 700; color: var(--text-muted);">Raw JSON Template Structure</label>
                                <label style="font-size: 0.8rem; display: flex; align-items: center; gap: 8px; cursor: pointer; user-select: none;">
                                    <span>Show Raw Code</span>
                                    <label class="switch" style="transform: scale(0.8); transform-origin: right;">
                                        <input type="checkbox" @bind="showRawJsonTemplate" />
                                        <span class="slider"></span>
                                    </label>
                                </label>
                            </div>
                            @if (showRawJsonTemplate)
                            {
                                <textarea class="bs-input code-textarea" value="@selectedCategory.TemplateStructure" @oninput="OnRawJsonTemplateChanged" rows="8" placeholder="e.g. { &quot;questions&quot;: [] }"></textarea>
                            }
                        </div>
                    }

                    <button class="bs-btn-primary w-100 mt-4" @onclick="SaveCategoryDetailsAsync">
                        💾 Save Category Details
                    </button>
                </div>
            }
            else if (selectedEdge != null)
            {
                <div class="drawer-header">
                    <h2>Edit Link Condition</h2>
                </div>
                <div class="drawer-body">
                    <div class="form-group">
                        <label>From Node (Question)</label>
                        <input type="text" class="bs-input" readonly value="@GetNodeLabel(selectedEdge.From)" />
                    </div>
                    <div class="form-group">
                        <label>To Node (@(selectedEdge.Type == "question-to-sku" ? "SKU" : "Question"))</label>
                        <input type="text" class="bs-input" readonly value="@GetNodeLabel(selectedEdge.To)" />
                    </div>
                    <div class="form-group">
                        <label>Link Type</label>
                        <input type="text" class="bs-input" readonly value="@(selectedEdge.Type == "question-to-sku" ? "SKU Activation Condition" : "Question Visibility Condition")" />
                    </div>
                    <div class="form-group">
                        <label>Condition Value / Trigger Options</label>
                        @if (selectedEdgeFromQuestion != null && (selectedEdgeFromQuestion.Type == "choice" || selectedEdgeFromQuestion.Type == "multiselect"))
                        {
                            var optionsList = new List<string>();
                            try
                            {
                                optionsList = string.IsNullOrEmpty(selectedEdgeFromQuestion.OptionsJson) 
                                    ? new List<string>() 
                                    : System.Text.Json.JsonSerializer.Deserialize<List<string>>(selectedEdgeFromQuestion.OptionsJson) ?? new List<string>();
                            }
                            catch {}

                            @if (optionsList.Count == 0)
                            {
                                <p class="help-text text-warning">💡 Question has no options configured yet.</p>
                            }
                            else
                            {
                                <div class="checkbox-list mt-1" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); border-radius: 8px; padding: 12px; max-height: 200px; overflow-y: auto;">
                                    @foreach (var opt in optionsList)
                                    {
                                        <label class="checkbox-item" style="margin-bottom: 6px; display: flex; align-items: center; gap: 8px; user-select: none;">
                                            <input type="checkbox" checked="@IsEdgeOptionSelected(opt)" @onchange='(e) => ToggleEdgeOption(opt, e.Value)' />
                                            <span style="color: #ffffff; font-size: 13px;">@opt</span>
                                        </label>
                                    }
                                </div>
                            }
                        }
                        else if (selectedEdgeFromQuestion != null && selectedEdgeFromQuestion.Type == "boolean")
                        {
                            <div class="checkbox-list mt-1" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); border-radius: 8px; padding: 12px;">
                                <label class="checkbox-item" style="margin-bottom: 6px; display: flex; align-items: center; gap: 8px; user-select: none;">
                                    <input type="checkbox" checked='@IsEdgeOptionSelected("True")' @onchange='(e) => ToggleEdgeOption("True", e.Value)' />
                                    <span style="color: #ffffff; font-size: 13px;">Yes / Checked (True)</span>
                                </label>
                                <label class="checkbox-item" style="margin-bottom: 6px; display: flex; align-items: center; gap: 8px; user-select: none;">
                                    <input type="checkbox" checked='@IsEdgeOptionSelected("False")' @onchange='(e) => ToggleEdgeOption("False", e.Value)' />
                                    <span style="color: #ffffff; font-size: 13px;">No / Unchecked (False)</span>
                                </label>
                            </div>
                        }
                        else
                        {
                            <input type="text" class="bs-input" @bind="edgeConditionBuffer" />
                        }
                        <p class="help-text">
                            @if (selectedEdge.Type == "question-to-sku")
                            {
                                <span>💡 This will update the triggering options inside the SKU's formula (e.g. `paint_scope contains 'Стандартен'`).</span>
                            }
                            else
                            {
                                <span>💡 This will update the triggering parent options for the question's visibility.</span>
                            }
                        </p>
                    </div>

                    <button class="bs-btn-primary w-100 mt-4" @onclick="SaveEdgeConditionAsync">
                        💾 Save Link Condition
                    </button>
                </div>
            }
            else
            {
                <div class="empty-state text-center mt-5">
                    <p class="help-text">Click a node in the graph map or select an item from the lists to view and edit details here.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- FLOATING TOAST SYSTEM -->
@if (showToast)
{
    <div class="bs-toast @toastType">
        <div class="toast-icon">
            @if (toastType == "success")
            {
                <span>✔️</span>
            }
            else
            {
                <span>❌</span>
            }
        </div>
        <div class="toast-content">
            <div class="toast-title">@(toastType == "success" ? "Success" : "Error")</div>
            <div class="toast-body">@toastMessage</div>
        </div>
        <button class="toast-close" @onclick="() => showToast = false">×</button>
    </div>
}

<!-- SEARCHABLE ICON & IMAGE LIBRARY MODAL -->
<MediaPickerModal 
    IsOpen="showMediaPickerForIcon" 
    InitialFolder="categories" 
    AllowedType="image" 
    OnAssetSelected="HandleMediaAssetPickedForIcon" 
    OnClose="() => showMediaPickerForIcon = false" />

@if (showIconPickerModal)
{
    <div class="bs-modal-overlay" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8); backdrop-filter: blur(8px); z-index: 99999; display: flex; align-items: center; justify-content: center; padding: 20px; box-sizing: border-box; overflow-y: auto; -webkit-overflow-scrolling: touch;">
        <div class="bs-modal-content bs-card" style="width: 100%; max-width: 720px; max-height: calc(100vh - 40px); max-height: calc(100dvh - 40px); margin: auto; box-sizing: border-box; display: flex; flex-direction: column; background: #16171a; border: 1px solid var(--border-color); border-radius: 16px; box-shadow: 0 20px 50px rgba(0,0,0,0.6); overflow: hidden;">
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; border-bottom: 1px solid var(--border-color);">
                <h3 style="margin: 0; font-size: 18px; font-weight: 700; color: #ffffff; display: flex; align-items: center; gap: 8px;">
                    Icon &amp; Image Library
                </h3>
                <button type="button" style="background: none; border: none; color: var(--text-muted); font-size: 24px; cursor: pointer;" @onclick="CloseIconPickerModal">×</button>
            </div>
            
            <div style="padding: 16px 20px; border-bottom: 1px solid var(--border-color); background: rgba(255,255,255,0.02);">
                <div style="display: flex; gap: 10px; align-items: center; margin-bottom: 12px;">
                    <input type="text" class="bs-input" style="flex: 1; padding: 8px 12px; font-size: 14px;" placeholder="Search icons by keyword..." @bind="iconPickerSearch" @bind:event="oninput" />
                    <button type="button" class="bs-btn-secondary" style="padding: 8px 16px; font-size: 13px; white-space: nowrap;" @onclick="() => showMediaPickerForIcon = true">
                        Media Library (R2)
                    </button>
                </div>
                
                <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                    <span style="font-size: 12px; color: var(--text-muted); font-weight: 600;">Upload Custom File:</span>
                    <InputFile OnChange="HandleIconFileUpload" accept="image/png,image/jpeg,image/svg+xml,image/webp" style="display: none;" id="iconFileInput" />
                    <label for="iconFileInput" class="bs-btn-primary" style="padding: 6px 14px; font-size: 12px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; margin: 0; border-radius: 6px;">
                        Upload PNG/SVG/WebP
                    </label>
                </div>
            </div>

            <div style="flex: 1; overflow-y: auto; padding: 20px; display: grid; grid-template-columns: repeat(auto-fill, minmax(95px, 1fr)); gap: 12px;">
                @foreach (var icon in GetFilteredLibraryIcons())
                {
