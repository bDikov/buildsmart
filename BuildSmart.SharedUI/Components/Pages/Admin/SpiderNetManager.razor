    private List<string> GetQuestionOptionsList(QuestionDto q)
    {
        if (string.IsNullOrEmpty(q.OptionsJson)) return new List<string>();
        try
        {
            return System.Text.Json.JsonSerializer.Deserialize<List<string>>(q.OptionsJson) ?? new List<string>();
        }
        catch
        {
            return new List<string>();
        }
    }

    private System.Threading.CancellationTokenSource? toastCts;
    private async Task ShowToastMessage(string message, string type = "success")
    {
        toastCts?.Cancel();
        toastCts = new System.Threading.CancellationTokenSource();
        var token = toastCts.Token;

        toastMessage = message;
        toastType = type;
        showToast = true;
        StateHasChanged();

        try
        {
            await Task.Delay(3000, token);
            showToast = false;
            StateHasChanged();
        }
        catch (TaskCanceledException) {}
    }

    private List<TemplateQuestionModel> ParseTemplateQuestions(string? json)
    {
        var list = new List<TemplateQuestionModel>();
        if (string.IsNullOrWhiteSpace(json)) return list;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            if (doc.RootElement.TryGetProperty("questions", out var questionsElement) && questionsElement.ValueKind == System.Text.Json.JsonValueKind.Array)
            {
                foreach (var q in questionsElement.EnumerateArray())
                {
                    var model = new TemplateQuestionModel();
                    if (q.TryGetProperty("id", out var idProp)) model.Id = idProp.GetString() ?? string.Empty;
                    if (q.TryGetProperty("type", out var typeProp)) model.Type = typeProp.GetString() ?? "text";
                    if (q.TryGetProperty("required", out var reqProp))
                    {
                        model.Required = reqProp.ValueKind == System.Text.Json.JsonValueKind.True || reqProp.ValueKind == System.Text.Json.JsonValueKind.False 
                            ? reqProp.GetBoolean() 
                            : (reqProp.ValueKind == System.Text.Json.JsonValueKind.String && bool.TryParse(reqProp.GetString(), out var rb) && rb);
                    }
                    
                    // Parse text (string or localized object)
                    if (q.TryGetProperty("text", out var textProp))
                    {
                        if (textProp.ValueKind == System.Text.Json.JsonValueKind.Object)
                        {
                            if (textProp.TryGetProperty("bg", out var bgProp)) model.TextBg = bgProp.GetString() ?? string.Empty;
                            if (textProp.TryGetProperty("en", out var enProp)) model.TextEn = enProp.GetString() ?? string.Empty;
                        }
                        else
                        {
                            model.TextBg = textProp.GetString() ?? string.Empty;
                            model.TextEn = textProp.GetString() ?? string.Empty;
                        }
                    }

                    // Parse options
                    if (q.TryGetProperty("options", out var optsProp) && optsProp.ValueKind == System.Text.Json.JsonValueKind.Array)
                    {
                        foreach (var opt in optsProp.EnumerateArray())
                        {
                            model.Options.Add(opt.GetString() ?? string.Empty);
                        }
                    }

                    // Parse dependsOn / dependsOnValue
                    if (q.TryGetProperty("dependsOn", out var depProp)) model.DependsOn = depProp.GetString();
                    if (q.TryGetProperty("dependsOnValue", out var depValProp)) model.DependsOnValue = depValProp.GetString();

                    list.Add(model);
                }
            }
        }
        catch {}
        return list;
    }

    private string SerializeTemplateQuestions(List<TemplateQuestionModel> models)
    {
        var obj = new
        {
            icon = string.IsNullOrWhiteSpace(selectedCategoryIcon) ? null : selectedCategoryIcon,
            isProjectDetails = isProjectDetails ? (bool?)true : null,
            questions = models.Select(m => new
            {
                id = m.Id,
                text = new { bg = m.TextBg, en = m.TextEn },
                type = m.Type,
                required = m.Required,
                options = m.Options.Count > 0 ? m.Options : null,
                dependsOn = string.IsNullOrEmpty(m.DependsOn) ? null : m.DependsOn,
                dependsOnValue = string.IsNullOrEmpty(m.DependsOnValue) ? null : m.DependsOnValue
            }).ToList()
        };
        return System.Text.Json.JsonSerializer.Serialize(obj, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
    }

    private void StartAddTemplateQuestion()
    {
        editingTemplateQuestion = new TemplateQuestionModel
        {
            Id = "new_question_id",
            Type = "text",
            Required = false
        };
        isEditingNewTemplateQuestion = true;
        editingOptionsLanguage = "bg";
        bgOptionsString = "";
        enOptionsString = "";
    }

    private void StartEditTemplateQuestion(TemplateQuestionModel q)
    {
        editingTemplateQuestion = new TemplateQuestionModel
        {
            Id = q.Id,
            Type = q.Type,
            TextBg = q.TextBg,
            TextEn = q.TextEn,
            Required = q.Required,
            Options = new List<string>(q.Options),
            DependsOn = q.DependsOn,
            DependsOnValue = q.DependsOnValue
        };
        isEditingNewTemplateQuestion = false;
        editingOptionsLanguage = "bg";
        bgOptionsString = string.Join("\n", q.Options);

        var enList = new List<string>();
        foreach (var opt in q.Options)
        {
            if (englishTranslations.TryGetValue(opt, out var val))
            {
                enList.Add(val);
            }
            else
            {
                enList.Add("");
            }
        }
        enOptionsString = string.Join("\n", enList);
    }

    private async Task ApplyTemplateQuestionChanges()
    {
        if (editingTemplateQuestion == null || selectedCategory == null) return;

        // Clean options from buffer
        var bgOptions = bgOptionsString
            .Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(o => o.Trim())
            .Where(o => !string.IsNullOrEmpty(o))
            .ToList();

        editingTemplateQuestion.Options = bgOptions;

        // Save English translations
        var enOptions = enOptionsString
            .Split(new[] { '\r', '\n' })
            .Select(o => o.Trim())
            .ToList();

        for (int i = 0; i < bgOptions.Count; i++)
        {
            var key = bgOptions[i];
            var val = i < enOptions.Count ? enOptions[i] : "";

            if (!string.IsNullOrWhiteSpace(val))
            {
                await ApiClient.UpdateTranslationAsync(key, "en", val);
                englishTranslations[key] = val;
            }
        }

        if (isEditingNewTemplateQuestion)
        {
            // Add if ID doesn't exist
            if (!categoryQuestions.Any(q => q.Id.Equals(editingTemplateQuestion.Id, StringComparison.OrdinalIgnoreCase)))
            {
                categoryQuestions.Add(editingTemplateQuestion);
            }
        }
        else
        {
            // Replace matching ID
            var idx = categoryQuestions.FindIndex(q => q.Id.Equals(editingTemplateQuestion.Id, StringComparison.OrdinalIgnoreCase));
            if (idx >= 0)
            {
                categoryQuestions[idx] = editingTemplateQuestion;
            }
        }

        // Serialize and update raw JSON string
        selectedCategory.TemplateStructure = SerializeTemplateQuestions(categoryQuestions);
        editingTemplateQuestion = null;
    }

    private void RemoveTemplateQuestion(TemplateQuestionModel q)
    {
        if (selectedCategory == null) return;
        categoryQuestions.Remove(q);
        selectedCategory.TemplateStructure = SerializeTemplateQuestions(categoryQuestions);
    }

    private void OnRawJsonTemplateChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "{}";
        if (selectedCategory != null)
        {
            selectedCategory.TemplateStructure = raw;
        }
        categoryQuestions = ParseTemplateQuestions(raw);
        
        isProjectDetails = false;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(raw);
            if (doc.RootElement.TryGetProperty("isProjectDetails", out var ipdProp))
            {
                isProjectDetails = ipdProp.GetBoolean();
            }
        }
        catch {}
    }

