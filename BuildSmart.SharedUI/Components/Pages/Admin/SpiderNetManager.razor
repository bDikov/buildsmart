        if (categoryObj != null)
        {
            return availableSkus.Where(s => s.ServiceCategoryId == categoryObj.Id || s.Name.Equals(categoryObj.Name, StringComparison.OrdinalIgnoreCase));
        }
        
        if (selectedCategoryFilter == "Global")
        {
            return availableSkus.Where(s => s.ServiceCategoryId == Guid.Empty || s.Name.Equals("Global Questions", StringComparison.OrdinalIgnoreCase));
        }
        
        return availableSkus;
