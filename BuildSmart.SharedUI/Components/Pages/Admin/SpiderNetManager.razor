    private DotNetObjectReference<SpiderNetManager>? dotNetHelper;

    private string statusMessage = "";
    private string errorMessage = "";
    private string syncJson = "";
    private List<string> importLogLines = new();

    private void LogInfo(string msg)
    {
        importLogLines.Add($"[INFO] {DateTime.Now:HH:mm:ss} - {msg}");
        StateHasChanged();
    }
    
    private void LogSuccess(string msg)
    {
        importLogLines.Add($"[SUCCESS] {DateTime.Now:HH:mm:ss} - {msg}");
