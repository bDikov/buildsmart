    private IEnumerable<ServiceSkuDto> GetFilteredSkusForLinking()
    {
        IEnumerable<ServiceSkuDto> result = availableSkus;
        
        if (skuLinkCategoryFilter != "All")
        {
            result = result.Where(s => s.ServiceCategoryId.ToString() == skuLinkCategoryFilter);
        }
        
        if (!string.IsNullOrWhiteSpace(skuLinkSearchText))
        {
            var search = skuLinkSearchText.Trim().ToLower();
            result = result.Where(s => s.SkuCode.ToLower().Contains(search) || s.Name.ToLower().Contains(search));
        }
        
        return result.OrderBy(s => s.SkuCode);
    }

