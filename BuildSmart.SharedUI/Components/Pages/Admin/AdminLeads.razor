    private async Task OpenClientProposalView(CalculatorLead lead, LeadCustomizationInfo info)
    {
        var scope = string.IsNullOrWhiteSpace(lead.Scope) ? "full" : lead.Scope;
        var url = $"/renovation-estimator?scope={scope}&area={lead.SelectedArea}&status={lead.BuildingStatus}&tier={lead.QualityTier}&bathrooms={lead.BathroomCount}&proposalReady=true";
