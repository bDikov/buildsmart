    private void CloseDossierModal()
    {
        _selectedLead = null;
        _isEditingAttribution = false;
        _editNotes = string.Empty;
        _editIsContacted = false;
        _isSavingNotes = false;
        _notesSaveSuccess = false;
        _notesErrorMessage = null;
    }

    private async Task ToggleLeadContacted(CalculatorLead lead)
    {
        try
        {
            lead.IsContacted = !lead.IsContacted;
            lead.ContactedAt = lead.IsContacted ? DateTime.UtcNow : null;
            await LeadRepository.UpdateLeadAsync(lead);
            ShowToast(Loc["Admin_Leads_StatusUpdated"]);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating contact status: {ex.Message}");
        }
    }

    private async Task SaveCrmNotesAsync()
    {
        if (_selectedLead == null) return;
        _isSavingNotes = true;
        _notesSaveSuccess = false;
        _notesErrorMessage = null;
        StateHasChanged();

        try
        {
            _selectedLead.AdminNotes = string.IsNullOrWhiteSpace(_editNotes) ? null : _editNotes.Trim();
            if (_editIsContacted && !_selectedLead.IsContacted)
            {
                _selectedLead.ContactedAt = DateTime.UtcNow;
            }
            else if (!_editIsContacted)
            {
                _selectedLead.ContactedAt = null;
            }
            _selectedLead.IsContacted = _editIsContacted;

            await LeadRepository.UpdateLeadAsync(_selectedLead);

            _notesSaveSuccess = true;
            ShowToast(Loc["Admin_Leads_NotesSaved"]);
            StateHasChanged();

            await Task.Delay(2500);
            _notesSaveSuccess = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving CRM notes: {ex.Message}");
            _notesErrorMessage = ex.Message;
            StateHasChanged();
        }
        finally
        {
            _isSavingNotes = false;
            StateHasChanged();
        }
    }

    private void ToggleAttributionEdit()
    {
        _isEditingAttribution = !_isEditingAttribution;
        if (_selectedLead != null && _isEditingAttribution)
        {
            _editSource = _selectedLead.UtmSource ?? string.Empty;
            _editMedium = _selectedLead.UtmMedium ?? string.Empty;
            _editCampaign = _selectedLead.UtmCampaign ?? string.Empty;
