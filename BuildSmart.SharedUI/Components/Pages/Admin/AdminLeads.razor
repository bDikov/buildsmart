        StateHasChanged();

        try
        {
            if (!_editIsContacted)
            {
                // Clear evaluation and meeting/follow-up when marked uncontacted
                _editCallOutcome = null;
                _editProspectRating = null;
                _editMeetingStatus = "None";
                _editMeetingDate = null;
                _editMeetingNotes = string.Empty;
                _editReadyTimeline = string.Empty;
                _editReadyCustomTimeline = string.Empty;
                _editFollowUpDate = null;

                _selectedLead.CallOutcome = null;
                _selectedLead.ProspectRating = null;
                _selectedLead.MeetingStatus = null;
                _selectedLead.MeetingDate = null;
                _selectedLead.MeetingNotes = null;
                _selectedLead.ReadyToStartTimeline = null;
                _selectedLead.FollowUpDate = null;
                _selectedLead.FollowUpReminderSent = false;
            }
            else
            {
                // 1. Update typed lead entity properties
                _selectedLead.CallOutcome = _editCallOutcome;
                _selectedLead.ProspectRating = _editProspectRating;
                _selectedLead.MeetingStatus = _editMeetingStatus == "None" ? null : _editMeetingStatus;
                _selectedLead.MeetingDate = _editMeetingDate.HasValue
                    ? DateTime.SpecifyKind(_editMeetingDate.Value, DateTimeKind.Utc)
                    : null;
                _selectedLead.MeetingNotes = string.IsNullOrWhiteSpace(_editMeetingNotes) ? null : _editMeetingNotes.Trim();

                string? finalTimeline = null;
                if (_editReadyTimeline == "custom")
                {
                    finalTimeline = string.IsNullOrWhiteSpace(_editReadyCustomTimeline) ? "custom" : $"custom:{_editReadyCustomTimeline.Trim()}";
                }
                else if (!string.IsNullOrWhiteSpace(_editReadyTimeline))
                {
                    finalTimeline = _editReadyTimeline;
                }
                _selectedLead.ReadyToStartTimeline = finalTimeline;

                var utcFollowUp = _editFollowUpDate.HasValue
                    ? DateTime.SpecifyKind(_editFollowUpDate.Value, DateTimeKind.Utc)
                    : (DateTime?)null;

                if (_selectedLead.FollowUpDate != utcFollowUp)
                {
                    _selectedLead.FollowUpReminderSent = false;
                }
                _selectedLead.FollowUpDate = utcFollowUp;
            }

            // 2. Dual-Safety / Backward-Compatibility: serialize [CRM_META] into AdminNotes
            var rawNotes = _selectedLead.AdminNotes ?? string.Empty;
            string configPart = string.Empty;
            const string configMarker = "[CONFIG]:";
            int cfgIdx = rawNotes.IndexOf(configMarker, StringComparison.OrdinalIgnoreCase);
            if (cfgIdx >= 0)
            {
                int endOfLine = rawNotes.IndexOf('\n', cfgIdx);
                configPart = endOfLine >= 0 ? rawNotes.Substring(cfgIdx, endOfLine - cfgIdx) : rawNotes.Substring(cfgIdx);
            }

            string summaryPart = string.Empty;
            const string sumMarker = "[SUMMARY]:";
            int sIdx = rawNotes.IndexOf(sumMarker, StringComparison.OrdinalIgnoreCase);
            if (sIdx >= 0)
            {
                int endOfLine = rawNotes.IndexOf('\n', sIdx);
                summaryPart = endOfLine >= 0 ? rawNotes.Substring(sIdx, endOfLine - sIdx) : rawNotes.Substring(sIdx);
            }
            else if (rawNotes.StartsWith("[Клиентът"))
            {
                int endOfLine = rawNotes.IndexOf('\n');
                summaryPart = endOfLine >= 0 ? rawNotes.Substring(0, endOfLine) : rawNotes;
            }

            var crmMetaObj = new
            {
                callOutcome = _selectedLead.CallOutcome,
                prospectRating = _selectedLead.ProspectRating,
                meetingStatus = _selectedLead.MeetingStatus,
                meetingDate = _selectedLead.MeetingDate?.ToString("o"),
                meetingNotes = _selectedLead.MeetingNotes,
                readyTimeline = _selectedLead.ReadyToStartTimeline,
                followUpDate = _selectedLead.FollowUpDate?.ToString("yyyy-MM-dd")
            };
            string crmMetaJson = System.Text.Json.JsonSerializer.Serialize(crmMetaObj);

            var sb = new System.Text.StringBuilder();
            if (!string.IsNullOrWhiteSpace(configPart)) sb.AppendLine(configPart.Trim());
            if (!string.IsNullOrWhiteSpace(summaryPart)) sb.AppendLine(summaryPart.Trim());
            sb.AppendLine($"[CRM_META]:{crmMetaJson}");
            if (!string.IsNullOrWhiteSpace(_editNotes))
            {
                sb.AppendLine("[CRM_NOTES]:");
                sb.Append(_editNotes.Trim());
            }

            _selectedLead.AdminNotes = sb.Length > 0 ? sb.ToString().Trim() : null;

            if (_editIsContacted && !_selectedLead.IsContacted)
            {
                _selectedLead.ContactedAt = DateTime.UtcNow;
            }
            else if (!_editIsContacted)
            {
                _selectedLead.ContactedAt = null;
            }
            _selectedLead.IsContacted = _editIsContacted;

            await LeadRepository.UpdateLeadAsync(_selectedLead);
            CalculateKpiMetrics();

            _notesSaveSuccess = true;
            ShowToast(Loc["Admin_Leads_NotesSaved"]);
            StateHasChanged();

            await Task.Delay(2500);
            _notesSaveSuccess = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving CRM notes: {ex.Message}");
            _notesErrorMessage = ex.InnerException?.Message ?? ex.Message;
            StateHasChanged();
        }
        finally
        {
            _isSavingNotes = false;
            StateHasChanged();
        }
    }

