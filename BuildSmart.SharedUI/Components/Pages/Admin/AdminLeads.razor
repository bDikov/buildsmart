            {
                query = query.Where(l => l.CallOutcome == "Pointless");
            }
            else if (_prospectOutcomeFilter == "unrated")
            {
                query = query.Where(l => string.IsNullOrEmpty(l.CallOutcome) && !l.ProspectRating.HasValue);
            }

            // Prospect Rating Filter
            if (_prospectRatingFilter == "high")
            {
                query = query.Where(l => l.ProspectRating.HasValue && l.ProspectRating.Value >= 8);
            }
            else if (_prospectRatingFilter == "medium")
            {
                query = query.Where(l => l.ProspectRating.HasValue && l.ProspectRating.Value >= 5 && l.ProspectRating.Value <= 7);
            }
            else if (_prospectRatingFilter == "low")
            {
                query = query.Where(l => l.ProspectRating.HasValue && l.ProspectRating.Value <= 4);
            }
            else if (_prospectRatingFilter == "unrated")
            {
                query = query.Where(l => !l.ProspectRating.HasValue);
            }

            // Meeting Filter
            if (_meetingFilter == "requested")
            {
                query = query.Where(l => l.MeetingStatus == "Requested");
            }
            else if (_meetingFilter == "scheduled")
            {
                query = query.Where(l => l.MeetingStatus == "Scheduled" || (l.MeetingDate.HasValue && l.MeetingDate.Value >= now));
            }
            else if (_meetingFilter == "completed")
            {
                query = query.Where(l => l.MeetingStatus == "Completed");
            }
            else if (_meetingFilter == "none")
            {
                query = query.Where(l => string.IsNullOrEmpty(l.MeetingStatus) || l.MeetingStatus == "None");
            }

            // Follow-up Reminder Filter
            if (_followUpFilter == "overdue")
            {
                query = query.Where(l => l.FollowUpDate.HasValue && l.FollowUpDate.Value.Date < now.Date);
            }
            else if (_followUpFilter == "today")
            {
                query = query.Where(l => l.FollowUpDate.HasValue && l.FollowUpDate.Value.Date == now.Date);
            }
            else if (_followUpFilter == "upcoming")
            {
                var nextWeek = now.Date.AddDays(7);
                query = query.Where(l => l.FollowUpDate.HasValue && l.FollowUpDate.Value.Date > now.Date && l.FollowUpDate.Value.Date <= nextWeek);
            }
            else if (_followUpFilter == "none")
            {
                query = query.Where(l => !l.FollowUpDate.HasValue);
            }

            // Text Search Filter (includes Name, Email, Phone, Campaign, Source, Area, CRM Notes, Meeting Notes, and Timelines)
            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var q = _searchQuery.Trim().ToLowerInvariant();
