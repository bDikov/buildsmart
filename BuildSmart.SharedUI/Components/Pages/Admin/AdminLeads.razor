                "followup" => _sortDescending ? query.OrderByDescending(l => l.FollowUpDate ?? DateTime.MinValue) : query.OrderBy(l => l.FollowUpDate ?? DateTime.MinValue),
                _ => _sortDescending ? query.OrderByDescending(l => l.CreatedAt) : query.OrderBy(l => l.CreatedAt)
