        }
    }

    // CSV Export
    private async Task ExportToCsv()
    {
        try
        {
            var leads = FilteredAndSortedLeads;
            var sb = new System.Text.StringBuilder();

            // UTF-8 BOM for Excel Cyrillic support
            sb.Append('\uFEFF');

            sb.AppendLine("SubmittedAt,Name,Email,Phone,Scope,SelectedAreaM2,BuildingStatus,QualityTier,IncludeFurniture,IncludeEquipment,Bathrooms,MinPriceEur,MaxPriceEur,MinPriceBgn,MaxPriceBgn,EstimatedDays,EmailVerificationStatus,IsEmailVerified,IsContacted,ContactedAt,ProspectRating,CallOutcome,MeetingStatus,MeetingDate,ReadyToStartTimeline,FollowUpDate,MeetingNotes,AdminNotes,UtmSource,UtmMedium,UtmCampaign,UtmTerm,UtmContent");

            foreach (var l in leads)
            {
                var name = SanitizeCsvField(l.Name);
                var email = SanitizeCsvField(l.Email);
                var phone = SanitizeCsvField(l.Phone);
                var campaign = SanitizeCsvField(l.UtmCampaign);
                var source = SanitizeCsvField(l.UtmSource);
                var medium = SanitizeCsvField(l.UtmMedium);
                var term = SanitizeCsvField(l.UtmTerm);
                var content = SanitizeCsvField(l.UtmContent);
                var notes = SanitizeCsvField(l.AdminNotes);
                var contactedAtStr = l.ContactedAt.HasValue ? l.ContactedAt.Value.ToString("yyyy-MM-dd HH:mm:ss") : "";
                var prospectRating = l.ProspectRating.HasValue ? l.ProspectRating.Value.ToString() : "";
                var callOutcome = SanitizeCsvField(l.CallOutcome);
                var meetingStatus = SanitizeCsvField(l.MeetingStatus);
                var meetingDateStr = l.MeetingDate.HasValue ? l.MeetingDate.Value.ToString("yyyy-MM-dd HH:mm") : "";
                var readyTimeline = SanitizeCsvField(l.ReadyToStartTimeline);
                var followUpDateStr = l.FollowUpDate.HasValue ? l.FollowUpDate.Value.ToString("yyyy-MM-dd") : "";
                var meetingNotes = SanitizeCsvField(l.MeetingNotes);

                sb.AppendLine($"\"{l.CreatedAt:yyyy-MM-dd HH:mm:ss}\",\"{name}\",\"{email}\",\"{phone}\",\"{l.Scope}\",{l.SelectedArea},\"{l.BuildingStatus}\",\"{l.QualityTier}\",{l.IncludeFurniture},{l.IncludeEquipment},{l.BathroomCount},{l.MinPriceEur:F2},{l.MaxPriceEur:F2},{l.MinPriceBgn:F2},{l.MaxPriceBgn:F2},{l.EstimatedDays},\"{l.VerificationStatus}\",{l.IsEmailVerified},{l.IsContacted},\"{contactedAtStr}\",{prospectRating},\"{callOutcome}\",\"{meetingStatus}\",\"{meetingDateStr}\",\"{readyTimeline}\",\"{followUpDateStr}\",\"{meetingNotes}\",\"{notes}\",\"{source}\",\"{medium}\",\"{campaign}\",\"{term}\",\"{content}\"");
            }

            var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
            var base64 = Convert.ToBase64String(bytes);
            var filename = $"buildsmart_leads_{DateTime.UtcNow:yyyyMMdd_HHmm}.csv";
            await JSRuntime.InvokeVoidAsync("eval", $"const a = document.createElement('a'); a.href = 'data:text/csv;charset=utf-8;base64,{base64}'; a.download = '{filename}'; a.click();");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error exporting leads CSV: {ex.Message}");
        }
    }

    private static string SanitizeCsvField(string? value)
    {
        if (string.IsNullOrEmpty(value)) return "";
        var cleaned = value.Replace("\"", "\"\"");
        if (cleaned.StartsWith("=") || cleaned.StartsWith("+") || cleaned.StartsWith("-") || cleaned.StartsWith("@"))
        {
            cleaned = "'" + cleaned;
        }
        return cleaned;
    }

