    private List<CalculatorLead> _allLeads = new();
    private bool _isLoading = true;
    private string _searchQuery = string.Empty;

    // Filters
    private string _dateRangeFilter = "all"; // all, today, yesterday, 7days, 30days
    private string _sourceFilter = "all";    // all, facebook, google, direct, exit_intent
    private string _scopeFilter = "all";     // all, bathroom, full, exit_intent
    private string _verificationFilter = "all"; // all, valid, flagged
    private string _contactStatusFilter = "all"; // all, new, spoken

    // Sorting
    private string _sortColumn = "date"; // date, name, price, area, source, status
    private bool _sortDescending = true;

    // Pagination
    private int _currentPage = 1;
    private int _pageSize = 25;

    // Modal States
    private CalculatorLead? _selectedLead = null;
    private CalculatorLead? _leadToDelete = null;

    // CRM Notes & Contact State in Modal
    private string _editNotes = string.Empty;
    private bool _editIsContacted = false;

    // Attribution Edit Mode
    private bool _isEditingAttribution = false;
    private string _editSource = string.Empty;
    private string _editMedium = string.Empty;
    private string _editCampaign = string.Empty;

    // Toast Notice
    private string? _toastMessage = null;

    // Background Auto-Refresh Timer
    private System.Threading.Timer? _autoRefreshTimer = null;

    // Aggregated KPI metrics
    private int _leadsTodayCount = 0;
    private int _leadsThisWeekCount = 0;
    private int _facebookLeadsCount = 0;
    private int _googleLeadsCount = 0;
    private decimal _totalPipelineEur = 0m;
    private decimal _totalPipelineBgn = 0m;

    protected override async Task OnInitializedAsync()
    {
        await RefreshLeadsAsync();

        _autoRefreshTimer = new System.Threading.Timer(async _ =>
        {
            try
            {
                await InvokeAsync(async () =>
                {
                    // Silent background sync without triggering full-page loading spinner
                    var leads = await LeadRepository.GetLeadsAsync();
                    if (leads != null)
                    {
                        _allLeads = leads;
                        CalculateKpiMetrics();
                        StateHasChanged();
                    }
                });
            }
            catch { }
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    public void Dispose()
    {
        _autoRefreshTimer?.Dispose();
    }

    private async Task RefreshLeadsAsync()
    {
        _isLoading = true;
        try
        {
            var leads = await LeadRepository.GetLeadsAsync();
            _allLeads = leads ?? new List<CalculatorLead>();
            CalculateKpiMetrics();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading leads: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void CalculateKpiMetrics()
    {
        var now = DateTime.UtcNow;
        var todayStart = new DateTime(now.Year, now.Month, now.Day, 0, 0, 0, DateTimeKind.Utc);
        var sevenDaysAgo = now.AddDays(-7);

        _leadsTodayCount = _allLeads.Count(l => l.CreatedAt >= todayStart);
        _leadsThisWeekCount = _allLeads.Count(l => l.CreatedAt >= sevenDaysAgo);

        _facebookLeadsCount = _allLeads.Count(l => IsFacebookSource(l.UtmSource));
        _googleLeadsCount = _allLeads.Count(l => IsGoogleSource(l.UtmSource));

        _totalPipelineEur = _allLeads.Sum(l => l.MaxPriceEur > 0 ? l.MaxPriceEur : (l.MaxPriceBgn > 0 ? Math.Round(l.MaxPriceBgn / 1.95583m, 2) : 0m));
        _totalPipelineBgn = _allLeads.Sum(l => l.MaxPriceBgn > 0 ? l.MaxPriceBgn : (l.MaxPriceEur > 0 ? Math.Round(l.MaxPriceEur * 1.95583m, 0) : 0m));
    }

    private bool IsFacebookSource(string? source)
    {
        if (string.IsNullOrWhiteSpace(source)) return false;
        var s = source.Trim().ToLowerInvariant();
        return s.Contains("facebook") || s == "fb" || s.Contains("instagram") || s == "meta";
    }

    private bool IsGoogleSource(string? source)
    {
        if (string.IsNullOrWhiteSpace(source)) return false;
        var s = source.Trim().ToLowerInvariant();
        return s.Contains("google") || s == "gads";
    }

    private void SetSourceFilter(string source)
    {
        _sourceFilter = source;
        _currentPage = 1;
    }

    private void ResetFilters()
    {
        _searchQuery = string.Empty;
        _dateRangeFilter = "all";
        _sourceFilter = "all";
        _scopeFilter = "all";
        _verificationFilter = "all";
        _contactStatusFilter = "all";
        _currentPage = 1;
    }

    private void ToggleSort(string column)
    {
        if (_sortColumn == column)
        {
            _sortDescending = !_sortDescending;
        }
        else
        {
            _sortColumn = column;
            _sortDescending = true;
        }
    }

    private List<CalculatorLead> FilteredAndSortedLeads
    {
        get
        {
            var query = _allLeads.AsEnumerable();

            // Date Range Filter
            var now = DateTime.UtcNow;
            if (_dateRangeFilter == "today")
            {
                var todayStart = new DateTime(now.Year, now.Month, now.Day, 0, 0, 0, DateTimeKind.Utc);
                query = query.Where(l => l.CreatedAt >= todayStart);
            }
            else if (_dateRangeFilter == "yesterday")
            {
                var yesterdayStart = new DateTime(now.Year, now.Month, now.Day, 0, 0, 0, DateTimeKind.Utc).AddDays(-1);
                var todayStart = new DateTime(now.Year, now.Month, now.Day, 0, 0, 0, DateTimeKind.Utc);
                query = query.Where(l => l.CreatedAt >= yesterdayStart && l.CreatedAt < todayStart);
            }
            else if (_dateRangeFilter == "7days")
            {
                var cutoff = now.AddDays(-7);
                query = query.Where(l => l.CreatedAt >= cutoff);
            }
            else if (_dateRangeFilter == "30days")
            {
                var cutoff = now.AddDays(-30);
                query = query.Where(l => l.CreatedAt >= cutoff);
            }

            // Contact Status Filter (Spoken to / New)
            if (_contactStatusFilter == "new")
            {
                query = query.Where(l => !l.IsContacted);
            }
            else if (_contactStatusFilter == "spoken")
            {
                query = query.Where(l => l.IsContacted);
            }

            // Traffic Source Filter
            if (_sourceFilter == "facebook")
            {
                query = query.Where(l => IsFacebookSource(l.UtmSource));
            }
            else if (_sourceFilter == "google")
            {
                query = query.Where(l => IsGoogleSource(l.UtmSource));
            }
            else if (_sourceFilter == "direct")
            {
                query = query.Where(l => string.IsNullOrEmpty(l.UtmSource) && l.Scope != "exit_intent_lead");
            }
            else if (_sourceFilter == "exit_intent")
            {
                query = query.Where(l => l.Scope == "exit_intent_lead");
            }

            // Scope Filter
            if (_scopeFilter == "bathroom")
            {
                query = query.Where(l => l.Scope == "bathroom");
            }
            else if (_scopeFilter == "full")
            {
                query = query.Where(l => l.Scope == "full" || (l.Scope != "exit_intent_lead" && l.Scope != "bathroom"));
            }
            else if (_scopeFilter == "exit_intent")
            {
                query = query.Where(l => l.Scope == "exit_intent_lead");
            }

            // Verification Filter
            if (_verificationFilter == "valid")
            {
                query = query.Where(l => l.VerificationStatus == "Valid" || l.IsEmailVerified);
            }
            else if (_verificationFilter == "flagged")
            {
                query = query.Where(l => l.VerificationStatus != "Valid" && !l.IsEmailVerified);
            }

            // Text Search Filter (includes Name, Email, Phone, Campaign, Source, Area, and CRM Notes)
            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var q = _searchQuery.Trim().ToLowerInvariant();
                var qDigits = new string(q.Where(char.IsDigit).ToArray());

                query = query.Where(l =>
                    (l.Name != null && l.Name.ToLowerInvariant().Contains(q)) ||
                    (l.Email != null && l.Email.ToLowerInvariant().Contains(q)) ||
                    (l.Phone != null && (l.Phone.ToLowerInvariant().Contains(q) || (!string.IsNullOrEmpty(qDigits) && new string(l.Phone.Where(char.IsDigit).ToArray()).Contains(qDigits)))) ||
                    (l.UtmCampaign != null && l.UtmCampaign.ToLowerInvariant().Contains(q)) ||
                    (l.UtmSource != null && l.UtmSource.ToLowerInvariant().Contains(q)) ||
                    (l.AdminNotes != null && l.AdminNotes.ToLowerInvariant().Contains(q)) ||
                    l.SelectedArea.ToString().Contains(q)
                );
            }

            // Sorting
            query = _sortColumn switch
            {
                "name" => _sortDescending ? query.OrderByDescending(l => l.Name ?? "") : query.OrderBy(l => l.Name ?? ""),
                "price" => _sortDescending ? query.OrderByDescending(l => l.MaxPriceEur) : query.OrderBy(l => l.MaxPriceEur),
                "area" => _sortDescending ? query.OrderByDescending(l => l.SelectedArea) : query.OrderBy(l => l.SelectedArea),
                "source" => _sortDescending ? query.OrderByDescending(l => l.UtmSource ?? "") : query.OrderBy(l => l.UtmSource ?? ""),
                "status" => _sortDescending ? query.OrderByDescending(l => l.IsContacted) : query.OrderBy(l => l.IsContacted),
                _ => _sortDescending ? query.OrderByDescending(l => l.CreatedAt) : query.OrderBy(l => l.CreatedAt)
            };

            return query.ToList();
        }
    }

    // Pagination Calculation
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredAndSortedLeads.Count / (double)_pageSize));
    private int PaginationStart => FilteredAndSortedLeads.Count == 0 ? 0 : ((_currentPage - 1) * _pageSize) + 1;
    private int PaginationEnd => Math.Min(_currentPage * _pageSize, FilteredAndSortedLeads.Count);

    private List<CalculatorLead> PagedLeads
    {
        get
        {
            var list = FilteredAndSortedLeads;
            if (_currentPage > TotalPages) _currentPage = TotalPages;
            return list.Skip((_currentPage - 1) * _pageSize).Take(_pageSize).ToList();
        }
    }

    private void PrevPage()
    {
        if (_currentPage > 1) _currentPage--;
    }

    private void NextPage()
    {
        if (_currentPage < TotalPages) _currentPage++;
    }

    // WhatsApp Link Formatter
    private string GetWhatsAppUrl(string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone)) return "#";
        var digits = new string(phone.Where(char.IsDigit).ToArray());
        if (digits.StartsWith("0"))
        {
            digits = "359" + digits.Substring(1);
        }
        else if (!digits.StartsWith("359") && digits.Length == 9)
        {
            digits = "359" + digits;
        }
        return $"https://wa.me/{digits}";
    }

