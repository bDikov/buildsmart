    private async Task CopyWhatsAppSummaryAsync(CalculatorLead lead, LeadCustomizationInfo info)
    {
        var name = string.IsNullOrWhiteSpace(lead.Name) ? "Клиент" : lead.Name.Trim();
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"Здравейте, {name}!");
        sb.AppendLine($"Във връзка с Вашата оферта за ремонт на апартамент ({lead.SelectedArea} кв.м, ниво {lead.QualityTier?.ToUpper()}):");
        sb.AppendLine();
        sb.AppendLine($"• Първоначална прогнозна стойност: €{info.InitialMinEur:N0} – €{info.InitialMaxEur:N0}");
        sb.AppendLine($"• Актуализирана стойност: €{lead.MinPriceEur:N0} – €{lead.MaxPriceEur:N0} ({lead.MinPriceBgn:N0} – {lead.MaxPriceBgn:N0} лв.)");
        if (info.SavedMaxEur > 0)
        {
            sb.AppendLine($"• Спестени от промяна на обхвата: €{info.SavedMaxEur:N0}");
        }
        sb.AppendLine();

        if (info.ExcludedProcessIds.Any())
        {
            sb.AppendLine("Изключени СМР пера от обхвата:");
            var allCats = GetAdminCategories();
            foreach (var cat in allCats)
            {
                var excludedInCat = cat.Processes.Where(p => info.ExcludedProcessIds.Contains(p.Id)).ToList();
                if (excludedInCat.Count == cat.Processes.Count)
                {
                    sb.AppendLine($"- {Loc[cat.TitleKey]}: Цялата категория е изключена");
                }
                else if (excludedInCat.Any())
                {
                    var procNames = excludedInCat.Select(p => Loc[p.TitleKey]);
                    sb.AppendLine($"- {Loc[cat.TitleKey]}: {string.Join(", ", procNames)}");
                }
            }
            sb.AppendLine();
        }

        var scope = string.IsNullOrWhiteSpace(lead.Scope) ? "full" : lead.Scope;
        var proposalUrl = $"{NavManager.BaseUri}renovation-estimator?scope={scope}&area={lead.SelectedArea}&status={lead.BuildingStatus}&tier={lead.QualityTier}&bathrooms={lead.BathroomCount}&proposalReady=true";
        if (info.ExcludedProcessIds.Any())
        {
            proposalUrl += $"&excluded={string.Join(",", info.ExcludedProcessIds)}";
        }
        sb.AppendLine($"Линк към интерактивната Ви оферта: {proposalUrl}");

        await CopyToClipboard(sb.ToString(), Loc["Admin_Leads_CopiedSuccess"]);
    }

    public class LeadCustomizationInfo
    {
        public bool HasCustomization { get; set; }
        public List<string> ExcludedProcessIds { get; set; } = new();
        public decimal InitialMinEur { get; set; }
        public decimal InitialMaxEur { get; set; }
        public decimal CustomizedMinEur { get; set; }
        public decimal CustomizedMaxEur { get; set; }
        public decimal SavedMinEur { get; set; }
        public decimal SavedMaxEur { get; set; }
        public string SummaryText { get; set; } = string.Empty;
        public string CrmNotesText { get; set; } = string.Empty;
    }

    private static LeadCustomizationInfo ParseCustomizationInfo(CalculatorLead lead)
    {
        var info = new LeadCustomizationInfo
        {
            CustomizedMinEur = lead.MinPriceEur,
            CustomizedMaxEur = lead.MaxPriceEur
        };

        if (string.IsNullOrWhiteSpace(lead.AdminNotes))
        {
            info.InitialMinEur = lead.MinPriceEur;
            info.InitialMaxEur = lead.MaxPriceEur;
            return info;
        }

        var notes = lead.AdminNotes;

        // Parse [CONFIG]:{...}
        const string configMarker = "[CONFIG]:";
        int configIdx = notes.IndexOf(configMarker, StringComparison.OrdinalIgnoreCase);
        if (configIdx >= 0)
        {
            int endOfLine = notes.IndexOf('\n', configIdx);
            string json = endOfLine >= 0
                ? notes.Substring(configIdx + configMarker.Length, endOfLine - (configIdx + configMarker.Length)).Trim()
                : notes.Substring(configIdx + configMarker.Length).Trim();

            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(json);
                var root = doc.RootElement;
                if (root.TryGetProperty("excludedProcessIds", out var idsEl) && idsEl.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    foreach (var item in idsEl.EnumerateArray())
                    {
                        var id = item.GetString();
                        if (!string.IsNullOrEmpty(id)) info.ExcludedProcessIds.Add(id);
                    }
                }
                if (root.TryGetProperty("initialMinEur", out var imin)) info.InitialMinEur = imin.GetDecimal();
                if (root.TryGetProperty("initialMaxEur", out var imax)) info.InitialMaxEur = imax.GetDecimal();
                if (root.TryGetProperty("customizedMinEur", out var cmin)) info.CustomizedMinEur = cmin.GetDecimal();
                if (root.TryGetProperty("customizedMaxEur", out var cmax)) info.CustomizedMaxEur = cmax.GetDecimal();
                if (root.TryGetProperty("savedMinEur", out var smin)) info.SavedMinEur = smin.GetDecimal();
                if (root.TryGetProperty("savedMaxEur", out var smax)) info.SavedMaxEur = smax.GetDecimal();

                info.HasCustomization = info.ExcludedProcessIds.Count > 0;
            }
            catch { }
        }
        else if (notes.Contains("[Клиентът коригира офертата]") || notes.Contains("Изключени пера:"))
        {
            info.HasCustomization = true;
        }

        // Parse [CRM_META]:{...} for dual safety fallback
        const string crmMetaMarker = "[CRM_META]:";
        int crmMetaIdx = notes.IndexOf(crmMetaMarker, StringComparison.OrdinalIgnoreCase);
        if (crmMetaIdx >= 0)
        {
            int endOfLine = notes.IndexOf('\n', crmMetaIdx);
            string metaJson = endOfLine >= 0
                ? notes.Substring(crmMetaIdx + crmMetaMarker.Length, endOfLine - (crmMetaIdx + crmMetaMarker.Length)).Trim()
                : notes.Substring(crmMetaIdx + crmMetaMarker.Length).Trim();
            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(metaJson);
                var root = doc.RootElement;
                if (string.IsNullOrEmpty(lead.CallOutcome) && root.TryGetProperty("callOutcome", out var coProp) && coProp.ValueKind == System.Text.Json.JsonValueKind.String)
                    lead.CallOutcome = coProp.GetString();
                if (!lead.ProspectRating.HasValue && root.TryGetProperty("prospectRating", out var prProp) && prProp.ValueKind == System.Text.Json.JsonValueKind.Number)
                    lead.ProspectRating = prProp.GetInt32();
                if (string.IsNullOrEmpty(lead.MeetingStatus) && root.TryGetProperty("meetingStatus", out var msProp) && msProp.ValueKind == System.Text.Json.JsonValueKind.String)
                    lead.MeetingStatus = msProp.GetString();
                if (!lead.MeetingDate.HasValue && root.TryGetProperty("meetingDate", out var mdProp) && mdProp.ValueKind == System.Text.Json.JsonValueKind.String && DateTime.TryParse(mdProp.GetString(), out var parsedMd))
                    lead.MeetingDate = parsedMd;
                if (string.IsNullOrEmpty(lead.MeetingNotes) && root.TryGetProperty("meetingNotes", out var mnProp) && mnProp.ValueKind == System.Text.Json.JsonValueKind.String)
                    lead.MeetingNotes = mnProp.GetString();
                if (string.IsNullOrEmpty(lead.ReadyToStartTimeline) && root.TryGetProperty("readyTimeline", out var rtProp) && rtProp.ValueKind == System.Text.Json.JsonValueKind.String)
                    lead.ReadyToStartTimeline = rtProp.GetString();
                if (!lead.FollowUpDate.HasValue && root.TryGetProperty("followUpDate", out var fuProp) && fuProp.ValueKind == System.Text.Json.JsonValueKind.String && DateTime.TryParse(fuProp.GetString(), out var parsedFu))
                    lead.FollowUpDate = parsedFu;
            }
            catch { }
        }

        // Parse [SUMMARY]:...
        const string summaryMarker = "[SUMMARY]:";
        int sumIdx = notes.IndexOf(summaryMarker, StringComparison.OrdinalIgnoreCase);
        if (sumIdx >= 0)
        {
            int nextMarker = notes.IndexOf("[CRM_META]:", sumIdx, StringComparison.OrdinalIgnoreCase);
            if (nextMarker < 0) nextMarker = notes.IndexOf("[CRM_NOTES]:", sumIdx, StringComparison.OrdinalIgnoreCase);
            info.SummaryText = nextMarker >= 0
                ? notes.Substring(sumIdx + summaryMarker.Length, nextMarker - (sumIdx + summaryMarker.Length)).Trim()
                : notes.Substring(sumIdx + summaryMarker.Length).Trim();
        }
        else if (notes.StartsWith("[Клиентът"))
        {
            int endOfLine = notes.IndexOf('\n');
            info.SummaryText = endOfLine >= 0 ? notes.Substring(0, endOfLine) : notes;
        }

        // Parse [CRM_NOTES]:...
        const string crmMarker = "[CRM_NOTES]:";
        int crmIdx = notes.IndexOf(crmMarker, StringComparison.OrdinalIgnoreCase);
        if (crmIdx >= 0)
        {
            info.CrmNotesText = notes.Substring(crmIdx + crmMarker.Length).Trim();
        }
        else if (!notes.StartsWith("[CONFIG]:") && !notes.StartsWith("[SUMMARY]:") && !notes.StartsWith("[CRM_META]:") && !notes.StartsWith("[Клиентът"))
        {
            info.CrmNotesText = notes.Trim();
        }

        if (info.InitialMaxEur == 0 && lead.MaxPriceEur > 0)
        {
            info.InitialMinEur = lead.MinPriceEur;
            info.InitialMaxEur = lead.MaxPriceEur;
        }

        return info;
    }

