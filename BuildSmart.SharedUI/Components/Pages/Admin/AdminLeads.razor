    private async Task SaveAttributionChanges()
    {
        if (_selectedLead == null) return;

        try
        {
            _selectedLead.UtmSource = string.IsNullOrWhiteSpace(_editSource) ? null : _editSource.Trim();
            _selectedLead.UtmMedium = string.IsNullOrWhiteSpace(_editMedium) ? null : _editMedium.Trim();
