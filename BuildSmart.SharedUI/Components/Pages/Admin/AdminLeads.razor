            else if (_prospectOutcomeFilter == "possible")
            {
                query = query.Where(l => l.CallOutcome == "Possible");
            }
            else if (_prospectOutcomeFilter == "reserved")
            {
                query = query.Where(l => l.CallOutcome == "Reserved");
            }
