                    (l.AdminNotes != null && l.AdminNotes.ToLowerInvariant().Contains(q)) ||
                    (l.MeetingNotes != null && l.MeetingNotes.ToLowerInvariant().Contains(q)) ||
                    (l.ReadyToStartTimeline != null && l.ReadyToStartTimeline.ToLowerInvariant().Contains(q)) ||
                    (l.CallOutcome != null && l.CallOutcome.ToLowerInvariant().Contains(q)) ||
                    l.SelectedArea.ToString().Contains(q)
