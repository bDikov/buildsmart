    // Delete Operations
    private void PromptDeleteLead(CalculatorLead lead)
    {
        _leadToDelete = lead;
    }

    private void CancelDeleteLead()
    {
        _leadToDelete = null;
    }

    private async Task ExecuteDeleteLeadAsync()
    {
        if (_leadToDelete == null) return;

        try
        {
            var id = _leadToDelete.Id;
            await LeadRepository.DeleteLeadAsync(id);
            _allLeads.RemoveAll(l => l.Id == id);
            if (_selectedLead?.Id == id) _selectedLead = null;
            _leadToDelete = null;
            CalculateKpiMetrics();
            ShowToast("Lead deleted successfully");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting lead: {ex.Message}");
        }
    }

    // CSV Export
    private async Task ExportToCsv()
    {
        try
        {
            var leads = FilteredAndSortedLeads;
            var sb = new System.Text.StringBuilder();

            // UTF-8 BOM for Excel Cyrillic support
            sb.Append('\uFEFF');

            sb.AppendLine("SubmittedAt,Name,Email,Phone,Scope,SelectedAreaM2,BuildingStatus,QualityTier,IncludeFurniture,IncludeEquipment,Bathrooms,MinPriceEur,MaxPriceEur,MinPriceBgn,MaxPriceBgn,EstimatedDays,EmailVerificationStatus,IsEmailVerified,IsContacted,ContactedAt,AdminNotes,UtmSource,UtmMedium,UtmCampaign,UtmTerm,UtmContent");

            foreach (var l in leads)
            {
                var name = SanitizeCsvField(l.Name);
                var email = SanitizeCsvField(l.Email);
                var phone = SanitizeCsvField(l.Phone);
                var campaign = SanitizeCsvField(l.UtmCampaign);
                var source = SanitizeCsvField(l.UtmSource);
                var medium = SanitizeCsvField(l.UtmMedium);
                var term = SanitizeCsvField(l.UtmTerm);
                var content = SanitizeCsvField(l.UtmContent);
                var notes = SanitizeCsvField(l.AdminNotes);
                var contactedAtStr = l.ContactedAt.HasValue ? l.ContactedAt.Value.ToString("yyyy-MM-dd HH:mm:ss") : "";

                sb.AppendLine($"\"{l.CreatedAt:yyyy-MM-dd HH:mm:ss}\",\"{name}\",\"{email}\",\"{phone}\",\"{l.Scope}\",{l.SelectedArea},\"{l.BuildingStatus}\",\"{l.QualityTier}\",{l.IncludeFurniture},{l.IncludeEquipment},{l.BathroomCount},{l.MinPriceEur:F2},{l.MaxPriceEur:F2},{l.MinPriceBgn:F2},{l.MaxPriceBgn:F2},{l.EstimatedDays},\"{l.VerificationStatus}\",{l.IsEmailVerified},{l.IsContacted},\"{contactedAtStr}\",\"{notes}\",\"{source}\",\"{medium}\",\"{campaign}\",\"{term}\",\"{content}\"");
            }

            var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
            var base64 = Convert.ToBase64String(bytes);
            var filename = $"buildsmart_leads_{DateTime.UtcNow:yyyyMMdd_HHmm}.csv";
            await JSRuntime.InvokeVoidAsync("eval", $"const a = document.createElement('a'); a.href = 'data:text/csv;charset=utf-8;base64,{base64}'; a.download = '{filename}'; a.click();");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error exporting leads CSV: {ex.Message}");
        }
    }

    private static string SanitizeCsvField(string? value)
    {
        if (string.IsNullOrEmpty(value)) return "";
        var cleaned = value.Replace("\"", "\"\"");
        if (cleaned.StartsWith("=") || cleaned.StartsWith("+") || cleaned.StartsWith("-") || cleaned.StartsWith("@"))
        {
            cleaned = "'" + cleaned;
        }
        return cleaned;
    }
