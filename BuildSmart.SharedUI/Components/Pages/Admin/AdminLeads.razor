    // Pagination Calculation
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredAndSortedLeads.Count / (double)_pageSize));
    private int PaginationStart => FilteredAndSortedLeads.Count == 0 ? 0 : ((_currentPage - 1) * _pageSize) + 1;
    private int PaginationEnd => Math.Min(_currentPage * _pageSize, FilteredAndSortedLeads.Count);

    private List<CalculatorLead> PagedLeads
    {
        get
        {
            var list = FilteredAndSortedLeads;
            if (_currentPage > TotalPages) _currentPage = TotalPages;
            return list.Skip((_currentPage - 1) * _pageSize).Take(_pageSize).ToList();
        }
    }

    private void PrevPage()
    {
        if (_currentPage > 1) _currentPage--;
    }

    private void NextPage()
    {
        if (_currentPage < TotalPages) _currentPage++;
    }

    // WhatsApp Link Formatter
    private string GetWhatsAppUrl(string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone)) return "#";
        var digits = new string(phone.Where(char.IsDigit).ToArray());
        if (digits.StartsWith("0"))
        {
            digits = "359" + digits.Substring(1);
        }
        else if (!digits.StartsWith("359") && digits.Length == 9)
        {
            digits = "359" + digits;
        }
        return $"https://wa.me/{digits}";
    }

