@page "/admin/landing-page"
@using BuildSmart.SharedUI.Services
@using BuildSmart.SharedUI.GraphQL
@using Microsoft.AspNetCore.Authorization
@using System.Text.Json
@using Microsoft.Extensions.Localization
@attribute [Authorize(Roles = "Admin, ADMIN, admin")]
@inject IStringLocalizer<BuildSmart.SharedUI.Resources.AppResources> Loc
@inject IBuildSmartApiClient ApiClient
@inject IJSRuntime JSRuntime
@inject NavigationManager NavManager
@inject BuildSmart.Core.Application.Interfaces.ILocalizationCacheService CacheService

<div class="admin-container" style="padding: 24px; max-width: 1200px; margin: 0 auto; color: var(--text-color, #ffffff); font-family: 'Outfit', sans-serif;">
    
    <!-- Page Header -->
    <div class="header-section" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; border-bottom: 1px solid rgba(255, 255, 255, 0.1); padding-bottom: 20px;">
        <div class="title-group">
            <h1 class="page-title" style="font-size: 2.2rem; font-weight: 700; margin: 0; background: linear-gradient(135deg, #10b981 0%, #3b82f6 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Landing Page Rules Workflow</h1>
            <p class="page-subtitle" style="color: #9ca3af; margin: 4px 0 0 0; font-size: 1rem;">Configure the landing page copywriting and buttons using automation-style IF ➔ THEN workflow blocks.</p>
        </div>
        <div class="header-actions" style="display: flex; gap: 12px;">
            <button class="bs-btn-secondary" @onclick='() => NavManager.NavigateTo("/admin/localization")' style="display: inline-flex; align-items: center; gap: 8px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); color: #fff; padding: 10px 18px; border-radius: 8px; cursor: pointer; transition: all 0.2s;">
                🔙 Translations List
            </button>
            <button class="bs-btn-secondary" @onclick="ResetToDefaultsAsync" style="display: inline-flex; align-items: center; gap: 8px; background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.2); color: #f87171; padding: 10px 18px; border-radius: 8px; cursor: pointer; transition: all 0.2s;">
                🚨 Reset Defaults
            </button>
            <button class="bs-btn-primary" @onclick="SaveChangesAsync" style="display: inline-flex; align-items: center; gap: 8px; background: #10b981; border: none; color: #fff; padding: 10px 22px; border-radius: 8px; cursor: pointer; font-weight: 600; transition: all 0.2s;" disabled="@isSaving">
                @if (isSaving)
                {
                    <span>Saving...</span>
                }
                else
                {
                    <span>💾 Save Flow</span>
                }
            </button>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-success" style="background: rgba(16, 185, 129, 0.15); border: 1px solid #10b981; color: #34d399; padding: 12px; border-radius: 8px; margin-bottom: 20px;">
            @statusMessage
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" style="background: rgba(239, 68, 68, 0.15); border: 1px solid #ef4444; color: #f87171; padding: 12px; border-radius: 8px; margin-bottom: 20px;">
            @errorMessage
        </div>
    }

    @if (isLoading)
    {
        <div style="display: flex; flex-direction: column; align-items: center; padding: 80px 0; justify-content: center; gap: 16px;">
            <div style="width: 48px; height: 48px; border: 4px solid rgba(255, 255, 255, 0.1); border-top-color: #10b981; border-radius: 50%; animation: spin 1s linear infinite;"></div>
            <span style="color: #9ca3af; font-size: 1.1rem;">Loading automation workflow...</span>
        </div>
    }
    else
    {
        <!-- Visual Flow Connector Container -->
        <div class="workflow-container" style="position: relative; display: flex; flex-direction: column; gap: 40px; padding-left: 30px; border-left: 3px dashed rgba(255, 255, 255, 0.1); margin-left: 15px; margin-bottom: 30px;">
            
            @for (int i = 0; i < ruleEditors.Count; i++)
            {
                var index = i;
                var r = ruleEditors[index];
                
                <!-- Rule Wrapper -->
                <div class="workflow-node" style="position: relative;">
                    
                    <!-- Connector Dot -->
                    <div style="position: absolute; left: -39px; top: 22px; width: 15px; height: 15px; border-radius: 50%; background: #3b82f6; border: 3px solid var(--bg-surface, #0f172a); box-shadow: 0 0 10px rgba(59, 130, 246, 0.5);"></div>

                    <!-- Flow Card Block -->
                    <div class="flow-card" style="background: rgba(255, 255, 255, 0.02); border: 2px solid @(selectedRuleIndex == index ? "#3b82f6" : "rgba(255, 255, 255, 0.08)"); border-radius: 16px; padding: 20px; transition: all 0.2s;" @onclick="() => selectedRuleIndex = index">
                        
                        <!-- Flow Card Action Header -->
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; padding-bottom: 10px; border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <span style="background: rgba(59, 130, 246, 0.15); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3); padding: 4px 10px; border-radius: 12px; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.5px;">STEP @(index + 1)</span>
                                <span style="color: #9ca3af; font-size: 0.85rem;">(First matching rule wins)</span>
                            </div>
                            <div style="display: flex; gap: 6px;">
                                <button class="action-btn" @onclick="() => MoveRuleUp(index)" disabled="@(index == 0)" title="Move Up" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); color: #fff; width: 28px; height: 28px; border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 0.8rem;">▲</button>
                                <button class="action-btn" @onclick="() => MoveRuleDown(index)" disabled="@(index == ruleEditors.Count - 1)" title="Move Down" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); color: #fff; width: 28px; height: 28px; border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 0.8rem;">▼</button>
                                <button class="action-btn" @onclick="() => DeleteRule(index)" title="Delete Rule" style="background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.2); color: #f87171; width: 28px; height: 28px; border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 0.8rem;">🗑️</button>
                            </div>
                        </div>

                        <!-- 1. IF BLOCK (Trigger / Condition) -->
                        <div class="if-block" style="background: rgba(245, 158, 11, 0.03); border: 1px solid rgba(245, 158, 11, 0.15); border-radius: 12px; padding: 16px; margin-bottom: 20px;">
                            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
                                <span style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: #fff; padding: 3px 10px; border-radius: 6px; font-weight: 800; font-size: 0.8rem;">IF</span>
                                <span style="font-weight: 600; font-size: 0.95rem; color: #f59e0b;">User State condition is met:</span>
                            </div>
                            
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                                <div>
                                    <label style="display: block; font-size: 0.8rem; color: #9ca3af; margin-bottom: 4px;">Select Predefined Condition</label>
                                    <select class="bs-select" @onchange="(e) => OnConditionTypeChanged(r, e.Value?.ToString())" style="width: 100%; padding: 8px 12px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.1); border-radius: 6px; color: #fff; outline: none; font-size: 0.9rem;">
                                        <option value="Guest" selected="@(r.ConditionType == "Guest")">Guest / Anonymous Visitor (isGuest)</option>
                                        <option value="NoProjects" selected="@(r.ConditionType == "NoProjects")">Logged in with 0 projects (!isGuest &amp;&amp; !hasProjects)</option>
                                        <option value="DraftProject" selected="@(r.ConditionType == "DraftProject")">Logged in with a Draft project (hasDraftProject)</option>
                                        <option value="ActiveProject" selected="@(r.ConditionType == "ActiveProject")">Logged in with 1+ Active Projects but no consultation (hasActiveProject)</option>
                                        <option value="HasProjects" selected="@(r.ConditionType == "HasProjects")">Logged in with active projects fallback (hasProjects)</option>
                                        <option value="Custom" selected="@(r.ConditionType == "Custom")">✏️ Custom automation expression...</option>
                                    </select>
                                </div>
                                <div>
                                    @if (r.ConditionType == "Custom")
                                    {
                                        <label style="display: block; font-size: 0.8rem; color: #9ca3af; margin-bottom: 4px;">Expression Logic</label>
                                        <input type="text" @bind="r.CustomCondition" placeholder="e.g. isHomeowner && !hasProjects" style="width: 100%; padding: 8px 12px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.1); border-radius: 6px; color: #fff; outline: none; font-family: monospace; font-size: 0.9rem;" />
                                    }
                                    else
                                    {
                                        <label style="display: block; font-size: 0.8rem; color: #9ca3af; margin-bottom: 4px;">Expression Logic</label>
                                        <div style="padding: 8px 12px; background: rgba(255, 255, 255, 0.01); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 6px; font-size: 0.85rem; color: #f59e0b; font-family: monospace;">
                                            @r.ResolvedCondition
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- 2. THEN BLOCK (Action / Copywriting) -->
                        <div class="then-block" style="background: rgba(16, 185, 129, 0.02); border: 1px solid rgba(16, 185, 129, 0.15); border-radius: 12px; padding: 16px;">
                            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
                                <span style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #fff; padding: 3px 10px; border-radius: 6px; font-weight: 800; font-size: 0.8rem;">THEN</span>
                                <span style="font-weight: 600; font-size: 0.95rem; color: #10b981;">Display this localized copy and execute redirect:</span>
                            </div>

                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 16px;">
                                <!-- BULGARIAN TRANSLATION -->
                                <div style="background: rgba(0,0,0,0.1); border: 1px solid rgba(255,255,255,0.03); border-radius: 8px; padding: 14px;">
                                    <div style="font-weight: 600; font-size: 0.85rem; color: #10b981; margin-bottom: 10px;">🇧🇬 Bulgarian (bg)</div>
                                    
                                    <div style="margin-bottom: 10px;">
                                        <label style="display: block; font-size: 0.75rem; color: #9ca3af; margin-bottom: 3px;">Title Header</label>
                                        <input type="text" @bind="r.TitleBg" style="width: 100%; padding: 8px 10px; background: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.06); border-radius: 5px; color: #fff; outline: none; font-size: 0.85rem;" />
                                    </div>
                                    
                                    <div style="margin-bottom: 10px;">
                                        <label style="display: block; font-size: 0.75rem; color: #9ca3af; margin-bottom: 3px;">Subtitle Description</label>
                                        <textarea @bind="r.SubtitleBg" rows="2" style="width: 100%; padding: 8px 10px; background: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.06); border-radius: 5px; color: #fff; outline: none; font-size: 0.85rem; resize: vertical;"></textarea>
                                    </div>

                                    <div>
                                        <label style="display: block; font-size: 0.75rem; color: #9ca3af; margin-bottom: 3px;">Button Label (CTA)</label>
                                        <input type="text" @bind="r.CtaBg" style="width: 100%; padding: 8px 10px; background: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.06); border-radius: 5px; color: #fff; outline: none; font-size: 0.85rem;" />
                                    </div>
                                </div>

                                <!-- ENGLISH TRANSLATION -->
                                <div style="background: rgba(0,0,0,0.1); border: 1px solid rgba(255,255,255,0.03); border-radius: 8px; padding: 14px;">
                                    <div style="font-weight: 600; font-size: 0.85rem; color: #3b82f6; margin-bottom: 10px;">🇬🇧 English (en)</div>

                                    <div style="margin-bottom: 10px;">
                                        <label style="display: block; font-size: 0.75rem; color: #9ca3af; margin-bottom: 3px;">Title Header</label>
                                        <input type="text" @bind="r.TitleEn" style="width: 100%; padding: 8px 10px; background: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.06); border-radius: 5px; color: #fff; outline: none; font-size: 0.85rem;" />
                                    </div>

                                    <div style="margin-bottom: 10px;">
                                        <label style="display: block; font-size: 0.75rem; color: #9ca3af; margin-bottom: 3px;">Subtitle Description</label>
                                        <textarea @bind="r.SubtitleEn" rows="2" style="width: 100%; padding: 8px 10px; background: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.06); border-radius: 5px; color: #fff; outline: none; font-size: 0.85rem; resize: vertical;"></textarea>
                                    </div>

                                    <div>
                                        <label style="display: block; font-size: 0.75rem; color: #9ca3af; margin-bottom: 3px;">Button Label (CTA)</label>
                                        <input type="text" @bind="r.CtaEn" style="width: 100%; padding: 8px 10px; background: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.06); border-radius: 5px; color: #fff; outline: none; font-size: 0.85rem;" />
                                    </div>
                                </div>
                            </div>

                            <!-- Redirect URL Action & Extras -->
                            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 20px; border-top: 1px solid rgba(255, 255, 255, 0.04); padding-top: 14px; margin-top: 14px;">
                                <div>
                                    <label style="display: block; font-size: 0.8rem; color: #9ca3af; margin-bottom: 4px; font-weight: 500;">Button Destination Route / URL</label>
                                    <input type="text" @bind="r.CtaAction" style="width: 100%; padding: 8px 12px; background: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.1); border-radius: 6px; color: #fff; outline: none; font-family: monospace; font-size: 0.85rem;" />
                                    <div style="color: #64748b; font-size: 0.7rem; margin-top: 4px;">
                                        Supports placeholders: <code style="color: #60a5fa;">{DraftProjectId}</code> or <code style="color: #60a5fa;">{ActiveProjectId}</code>. Use <code style="color: #10b981;">/create-account?ReturnUrl=/job-wizard</code> for guests.
                                    </div>
                                </div>
                                <div style="display: flex; align-items: center; padding-left: 10px;">
                                    <label style="display: inline-flex; align-items: center; gap: 8px; cursor: pointer; font-size: 0.85rem; color: #fff;">
                                        <input type="checkbox" @bind="r.ShowLoginPrompt" style="width: 16px; height: 16px; cursor: pointer;" />
                                        <span>Show guest sign-in link underneath</span>
                                    </label>
                                </div>
                            </div>

                        </div>

                    </div>
                </div>
            }

        </div>

        <!-- Bottom Actions -->
        <div style="display: flex; justify-content: center; gap: 16px; margin-bottom: 60px; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 24px;">
            <button class="bs-btn-primary" @onclick="AddNewRule" style="display: inline-flex; align-items: center; gap: 8px; background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.25); color: #60a5fa; padding: 12px 30px; border-radius: 30px; cursor: pointer; font-weight: 600; transition: all 0.2s;">
                ➕ Add Workflow Rule (Step)
            </button>
            <button class="bs-btn-primary" @onclick="SaveChangesAsync" style="display: inline-flex; align-items: center; gap: 8px; background: #10b981; border: none; color: #fff; padding: 12px 36px; border-radius: 30px; cursor: pointer; font-weight: 700; box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3); transition: all 0.2s;" disabled="@isSaving">
                @if (isSaving)
                {
                    <span>Saving Flow...</span>
                }
                else
                {
                    <span>💾 Save Copywriting Flow</span>
                }
            </button>
        </div>
    }
</div>

<style>
    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
    .flow-card:hover {
        background-color: rgba(255, 255, 255, 0.035) !important;
        border-color: rgba(255, 255, 255, 0.15) !important;
    }
    .action-btn:hover:not(:disabled) {
        background-color: rgba(255, 255, 255, 0.15) !important;
    }
    .action-btn:disabled {
        opacity: 0.3;
        cursor: not-allowed;
    }
</style>

@code {
    private List<RuleEditorModel> ruleEditors = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private int selectedRuleIndex = -1;
    private string statusMessage = string.Empty;
    private string errorMessage = string.Empty;

    private List<LocalizationResourceDto> allLocalizationResources = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        statusMessage = string.Empty;
        errorMessage = string.Empty;
        selectedRuleIndex = 0;

        try
        {
            var result = await ApiClient.GetAllLocalizationResources.ExecuteAsync();
            if (result.Errors.Count > 0)
            {
                errorMessage = $"Error: {result.Errors[0].Message}";
                return;
            }

            if (result.Data?.AllLocalizationResources != null)
            {
                // Map to list
                allLocalizationResources = result.Data.AllLocalizationResources
                    .Select(r => new LocalizationResourceDto { Key = r.Key, Culture = r.Culture, Value = r.Value })
                    .ToList();

                // Find copywriting rules key
                var rulesEntry = allLocalizationResources.FirstOrDefault(r => r.Key == "LandingPage_CopywritingRules" && r.Culture == "en");
                if (rulesEntry != null && !string.IsNullOrEmpty(rulesEntry.Value))
                {
                    ParseRulesJson(rulesEntry.Value);
                }
                else
                {
                    ParseRulesJson(GetFallbackDefaultRulesJson());
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Exception loading rules workflow: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ParseRulesJson(string json)
    {
        try
        {
            var rules = JsonSerializer.Deserialize<List<LandingPageCopyRuleDto>>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            ruleEditors.Clear();

            if (rules != null)
            {
                int ruleCounter = 1;
                foreach (var rule in rules)
                {
                    var editor = new RuleEditorModel
                    {
                        ResolvedCondition = rule.Condition,
                        CtaAction = rule.CtaAction,
                        ShowLoginPrompt = rule.ShowLoginPrompt,
                        TitleKey = rule.TitleKey,
                        SubtitleKey = rule.SubtitleKey,
                        CtaKey = rule.CtaKey
                    };

                    // Map condition type
                    if (rule.Condition == "isGuest") editor.ConditionType = "Guest";
                    else if (rule.Condition == "!isGuest && !hasProjects") editor.ConditionType = "NoProjects";
                    else if (rule.Condition == "hasDraftProject") editor.ConditionType = "DraftProject";
                    else if (rule.Condition == "hasActiveProject") editor.ConditionType = "ActiveProject";
                    else if (rule.Condition == "hasProjects") editor.ConditionType = "HasProjects";
                    else
                    {
                        editor.ConditionType = "Custom";
                        editor.CustomCondition = rule.Condition;
                    }

                    // Resolve translations from cache lists
                    editor.TitleEn = GetValueFromCache(rule.TitleKey, "en");
                    editor.TitleBg = GetValueFromCache(rule.TitleKey, "bg");
                    editor.SubtitleEn = GetValueFromCache(rule.SubtitleKey, "en");
                    editor.SubtitleBg = GetValueFromCache(rule.SubtitleKey, "bg");
                    editor.CtaEn = GetValueFromCache(rule.CtaKey, "en");
                    editor.CtaBg = GetValueFromCache(rule.CtaKey, "bg");

                    ruleEditors.Add(editor);
                    ruleCounter++;
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error parsing rules configuration: {ex.Message}";
        }
    }

    private string GetValueFromCache(string key, string culture)
    {
        if (string.IsNullOrEmpty(key)) return string.Empty;
        var match = allLocalizationResources.FirstOrDefault(r => r.Key.Equals(key, StringComparison.OrdinalIgnoreCase) && r.Culture.Equals(culture, StringComparison.OrdinalIgnoreCase));
        return match?.Value ?? string.Empty;
    }

    private string GetFriendlyConditionName(string type)
    {
        return type switch
        {
            "Guest" => "IF Visitor is Guest (Not logged in)",
            "NoProjects" => "IF Logged in, 0 Projects created",
            "DraftProject" => "IF Incomplete Draft exists",
            "ActiveProject" => "IF Active Project exists (no consultation)",
            "HasProjects" => "IF User has active projects",
            "Custom" => "IF Custom Automation condition matches",
            _ => "Copywriting Rule step"
        };
    }

    private void OnConditionTypeChanged(RuleEditorModel model, string? type)
    {
        if (string.IsNullOrEmpty(type)) return;
        model.ConditionType = type;
        
        // Resolve expression immediately in preview
        model.ResolvedCondition = type switch
        {
            "Guest" => "isGuest",
            "NoProjects" => "!isGuest && !hasProjects",
            "DraftProject" => "hasDraftProject",
            "ActiveProject" => "hasActiveProject",
            "HasProjects" => "hasProjects",
            "Custom" => model.CustomCondition,
            _ => "isGuest"
        };
    }

    private void AddNewRule()
    {
        var randomSuffix = Guid.NewGuid().ToString().Substring(0, 4);
        var editor = new RuleEditorModel
        {
            ConditionType = "Custom",
            CustomCondition = "isGuest && hasProjects",
            ResolvedCondition = "isGuest && hasProjects",
            TitleKey = $"Feed_HeroTitle_Custom_{randomSuffix}",
            SubtitleKey = $"Feed_HeroSubtitle_Custom_{randomSuffix}",
            CtaKey = $"Feed_HeroCta_Custom_{randomSuffix}",
            TitleEn = "New Rule Title",
            TitleBg = "Ново заглавие на правилото",
            SubtitleEn = "New Rule Subtitle Description",
            SubtitleBg = "Ново подзаглавие описание на правилото",
            CtaEn = "Click Here",
            CtaBg = "Кликнете тук",
            CtaAction = "/job-wizard",
            ShowLoginPrompt = false
        };
        ruleEditors.Add(editor);
        selectedRuleIndex = ruleEditors.Count - 1;
    }

    private void DeleteRule(int index)
    {
        if (index >= 0 && index < ruleEditors.Count)
        {
            ruleEditors.RemoveAt(index);
            selectedRuleIndex = ruleEditors.Count - 1;
        }
    }

    private void MoveRuleUp(int index)
    {
        if (index > 0 && index < ruleEditors.Count)
        {
            var item = ruleEditors[index];
            ruleEditors.RemoveAt(index);
            ruleEditors.Insert(index - 1, item);
            selectedRuleIndex = index - 1;
        }
    }

    private void MoveRuleDown(int index)
    {
        if (index >= 0 && index < ruleEditors.Count - 1)
        {
            var item = ruleEditors[index];
            ruleEditors.RemoveAt(index);
            ruleEditors.Insert(index + 1, item);
            selectedRuleIndex = index + 1;
        }
    }

    private async Task ResetToDefaultsAsync()
    {
        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to reset all landing page rules and translations to default values? Any unsaved edits will be lost.");
        if (confirm)
        {
            ParseRulesJson(GetFallbackDefaultRulesJson());
            statusMessage = "Reset to default flow! Click 'Save Flow' to commit your changes.";
        }
    }

    private async Task SaveChangesAsync()
    {
        isSaving = true;
        statusMessage = string.Empty;
        errorMessage = string.Empty;

        try
        {
            // 1. Resolve keys and conditions
            var outputRules = new List<LandingPageCopyRuleDto>();
            int ruleCounter = 1;

            foreach (var r in ruleEditors)
            {
                if (string.IsNullOrEmpty(r.TitleKey)) r.TitleKey = $"Feed_HeroTitle_Custom_{ruleCounter}";
                if (string.IsNullOrEmpty(r.SubtitleKey)) r.SubtitleKey = $"Feed_HeroSubtitle_Custom_{ruleCounter}";
                if (string.IsNullOrEmpty(r.CtaKey)) r.CtaKey = $"Feed_HeroCta_Custom_{ruleCounter}";

                r.ResolvedCondition = (r.ConditionType switch
                {
                    "Guest" => "isGuest",
                    "NoProjects" => "!isGuest && !hasProjects",
                    "DraftProject" => "hasDraftProject",
                    "ActiveProject" => "hasActiveProject",
                    "HasProjects" => "hasProjects",
                    "Custom" => r.CustomCondition,
                    _ => "isGuest"
                }) ?? "isGuest";

                outputRules.Add(new LandingPageCopyRuleDto
                {
                    Condition = r.ResolvedCondition ?? "isGuest",
                    TitleKey = r.TitleKey ?? string.Empty,
                    SubtitleKey = r.SubtitleKey ?? string.Empty,
                    CtaKey = r.CtaKey ?? string.Empty,
                    CtaAction = r.CtaAction ?? string.Empty,
                    ShowLoginPrompt = r.ShowLoginPrompt
                });

                // Save localization text values into the database strings table
                await SaveLocalizationKeyAsync(r.TitleKey, r.TitleEn, r.TitleBg);
                await SaveLocalizationKeyAsync(r.SubtitleKey, r.SubtitleEn, r.SubtitleBg);
                await SaveLocalizationKeyAsync(r.CtaKey, r.CtaEn, r.CtaBg);

                ruleCounter++;
            }

            // 2. Serialize final JSON list
            var rulesJson = JsonSerializer.Serialize(outputRules, new JsonSerializerOptions { WriteIndented = true });
            
            // 3. Save JSON rule configurations in DB localizer
            await SaveLocalizationKeyAsync("LandingPage_CopywritingRules", rulesJson, rulesJson);

            statusMessage = "Copywriting workflow rules and translations saved to the database successfully! Refreshing localizer cache...";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save rules workflow: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SaveLocalizationKeyAsync(string key, string? enValue, string? bgValue)
    {
        var safeEn = (enValue ?? string.Empty).Trim();
        var safeBg = (bgValue ?? string.Empty).Trim();

        var enInput = new UpdateLocalizationInput
        {
            Key = key,
            Culture = "en",
            Value = safeEn
        };
        var enResult = await ApiClient.UpdateLocalizationString.ExecuteAsync(enInput);

        var bgInput = new UpdateLocalizationInput
        {
            Key = key,
            Culture = "bg",
            Value = safeBg
        };
        var bgResult = await ApiClient.UpdateLocalizationString.ExecuteAsync(bgInput);

        if (enResult.Errors.Count > 0 || bgResult.Errors.Count > 0)
        {
            var msg = $"Error updating key '{key}'.";
            if (enResult.Errors.Count > 0) msg += $" [EN]: {enResult.Errors[0].Message}";
            if (bgResult.Errors.Count > 0) msg += $" [BG]: {bgResult.Errors[0].Message}";
            throw new Exception(msg);
        }

        // Set locally in Singleton cache immediately to override memory state for instant client-side UI updates
        CacheService.Set(key, "en", safeEn);
        CacheService.Set(key, "bg", safeBg);
    }

