        {
            await TriggerSearch();
        }
    }

    private void OpenMarkdownModal()
    {
        modalError = null;
        previewData = null;
        selectedFileName = null;
        targetClientName = string.Empty;
        targetSiteAddress = string.Empty;
        targetProjectTitle = string.Empty;
        targetAssignTo = "admin";
        isMarkdownModalOpen = true;
    }

    private void CloseMarkdownModal()
    {
        isMarkdownModalOpen = false;
        previewData = null;
        modalError = null;
    }

    private void ResetPreview()
    {
        previewData = null;
        modalError = null;
    }

    private void OnClientNameInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        targetClientName = e.Value?.ToString() ?? string.Empty;
        if ((string.IsNullOrWhiteSpace(targetAssignTo) || targetAssignTo.Equals("admin", StringComparison.OrdinalIgnoreCase)) &&
            !string.IsNullOrWhiteSpace(targetClientName) &&
            !targetClientName.Equals("Възложител", StringComparison.OrdinalIgnoreCase) &&
            !targetClientName.Equals("Уважаеми Клиент", StringComparison.OrdinalIgnoreCase))
        {
            targetAssignTo = targetClientName;
        }
    }

    private void OnAssignToInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        targetAssignTo = e.Value?.ToString() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(targetClientName) ||
            targetClientName.Equals("Възложител", StringComparison.OrdinalIgnoreCase) ||
            targetClientName.Equals("Уважаеми Клиент", StringComparison.OrdinalIgnoreCase))
        {
            if (!string.IsNullOrWhiteSpace(targetAssignTo) && !targetAssignTo.Equals("admin", StringComparison.OrdinalIgnoreCase))
            {
                targetClientName = targetAssignTo;
            }
        }
    }

