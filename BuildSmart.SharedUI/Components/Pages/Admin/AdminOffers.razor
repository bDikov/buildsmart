@page "/admin-offers"
@using BuildSmart.SharedUI.GraphQL
@using BuildSmart.SharedUI.ViewModels.Admin
@using BuildSmart.SharedUI.Services
@using System.Net.Http.Headers
@inject AdminProjectsViewModel ViewModel
@inject NavigationManager NavManager
@inject IAuthService AuthService

<div class="page-container">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h2 class="page-title mb-0">Project Offers</h2>
        <button class="bs-btn-primary" @onclick="OpenMarkdownModal" style="display: inline-flex; align-items: center; gap: 8px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>
            @Loc["AdminOffers_NewMarkdownOffer"]
        </button>
    </div>

    <!-- Search & Filters -->
    <div class="bs-card search-card mb-4">
        <div class="search-layout">
            <div class="flex-grow-1">
                <input type="text" class="bs-input search-input" @bind="ViewModel.SearchQuery" @bind:event="oninput" @onkeyup="HandleSearchEnter" placeholder="Search by Project Title, ID, Homeowner Email..." />
            </div>
            <button class="bs-btn-primary" @onclick="TriggerSearch">
                Search
            </button>
            <button class="bs-btn-secondary" @onclick="ClearSearch">
                Clear
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="bs-card mb-4" style="background-color: var(--color-danger-bg, rgba(239, 68, 68, 0.1)); border: 1px solid var(--color-danger);">
            <h4 class="text-danger mb-1">Search Error</h4>
            <p class="text-danger mb-0" style="font-size: 14px;">@ErrorMessage</p>
        </div>
    }

    @if (ViewModel.IsBusy && ViewModel.Projects.Count == 0)
    {
        <div class="loading-state">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        if (ViewModel.Projects.Count == 0)
        {
            <div class="empty-state">
                <h4 class="text-muted">No projects found</h4>
                <p class="text-muted">There are currently no projects matching your search.</p>
            </div>
        }
        else
        {
            <div class="projects-grid">
                @foreach (var project in ViewModel.Projects)
                {
                    <div class="bs-card project-card">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="project-info">
                                <h3 class="project-title">@project.Title</h3>
                                <p class="project-meta">ID: @project.Id.ToString().Substring(0, 8) • Created: @project.CreatedAt.ToString("MMM dd, yyyy")</p>
                                <p class="project-homeowner">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                    @project.Homeowner.FirstName @project.Homeowner.LastName (@project.Homeowner.Email)
                                </p>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                @if (project.HasOfferPdf)
                                {
                                    <span class="offer-status-badge ready" style="padding: 3px 8px; border-radius: 12px; font-size: 11px; font-weight: 700; background: var(--color-success-bg, rgba(16, 185, 129, 0.15)); color: var(--color-success);" title="PDF offer is compiled and saved in DB">PDF Ready</span>
                                }
                                else
                                {
                                    <span class="offer-status-badge pending" style="padding: 3px 8px; border-radius: 12px; font-size: 11px; font-weight: 700; background: var(--color-warning-bg, rgba(255, 193, 7, 0.15)); color: var(--color-warning);" title="PDF offer will compile on demand when downloaded">PDF Pending</span>
                                }
                                <span class="status-badge @project.Status.ToString().ToLower()">@Loc[$"Status_{project.Status}"]</span>
                            </div>
                        </div>
                        
                        <hr class="divider" />
                        <p class="project-desc">@project.Description</p>
                        
                        <div class="jobs-list mt-3">
                            @if (project.HasOfferPdf)
                            {
                                <a class="bs-btn-primary btn-sm mb-2" href="@($"{ApiConfig.GetBaseUrl()}/api/offers/{project.Id}/download")" target="_blank" download style="text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                                    Download PDF Offer
                                </a>
                            }
                            else
                            {
                                <a class="bs-btn-primary btn-sm mb-2" style="background-color: var(--color-warning); border-color: var(--color-warning); color: var(--color-primary-contrast, #ffffff); text-decoration: none; display: inline-flex; align-items: center; gap: 6px;" href="@($"{ApiConfig.GetBaseUrl()}/api/offers/{project.Id}/download")" target="_blank" download>
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                                    Generate & Download PDF
                                </a>
                            }

                            <a class="bs-btn-secondary btn-sm mb-2" href="@($"{ApiConfig.GetBaseUrl()}/api/offers/{project.Id}/download?force=true")" target="_blank" download style="text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 2v6h6M21.5 22v-6h-6M21.34 15.57a10 10 0 1 0-1.57 6.43l3.5-3.5"/></svg>
                                Regenerate & Download PDF
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    }

    <!-- Modal: New BoQ / КСС Offer from Markdown -->
    @if (isMarkdownModalOpen)
    {
        <div class="modal-backdrop" style="position: fixed; inset: 0; background: var(--bg-overlay, rgba(0, 0, 0, 0.7)); z-index: 1050; display: flex; align-items: center; justify-content: center; padding: 20px;">
            <div class="bs-card modal-content-card" style="width: 100%; max-width: 960px; max-height: 90vh; overflow-y: auto; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 28px; box-shadow: var(--elevation-24dp, 0 20px 25px -5px rgba(0,0,0,0.5));">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="h4 mb-0" style="color: var(--text-primary); font-weight: 700;">@Loc["AdminOffers_ModalTitle"]</h3>
                    <button class="bs-btn-secondary btn-sm" @onclick="CloseMarkdownModal" style="padding: 4px 10px; display: inline-flex; align-items: center; gap: 4px;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                        @Loc["AdminOffers_Close"]
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(modalError))
                {
                    <div class="p-3 mb-3" style="background: var(--color-danger-bg, rgba(239, 68, 68, 0.1)); border: 1px solid var(--color-danger); border-radius: 8px;">
                        <p class="text-danger mb-0" style="font-size: 14px; font-weight: 600;">@modalError</p>
                    </div>
                }

                @if (previewData == null)
                {
                    <!-- Step 1: Input Markdown -->
                    <p style="color: var(--text-muted); font-size: 14px; margin-bottom: 16px;">
                        @Loc["AdminOffers_Step1Desc"]
                    </p>

                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <label class="form-label mb-1" style="font-size: 12px; font-weight: 600; color: var(--text-muted);">
                                @Loc["AdminOffers_ClientLabel"]
                            </label>
                            <input type="text" class="bs-input" value="@targetClientName" @oninput="OnClientNameInput" placeholder="@Loc["AdminOffers_ClientPlaceholder"]" style="width: 100%; font-size: 13px;" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label mb-1" style="font-size: 12px; font-weight: 600; color: var(--text-muted);">
                                @Loc["AdminOffers_AssignToLabel"]
                            </label>
                            <input type="text" class="bs-input" value="@targetAssignTo" @oninput="OnAssignToInput" placeholder="admin" style="width: 100%; font-size: 13px;" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label mb-1" style="font-size: 12px; font-weight: 600; color: var(--text-muted);">
                                @Loc["AdminOffers_SiteLocationLabel"]
                            </label>
                            <input type="text" class="bs-input" @bind="targetSiteAddress" @bind:event="oninput" placeholder="@Loc["AdminOffers_SiteLocationPlaceholder"]" style="width: 100%; font-size: 13px;" />
                        </div>
                    </div>

                    <div class="d-flex gap-2 mb-3 flex-wrap align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <label class="bs-btn-secondary btn-sm mb-0" style="cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                                @Loc["AdminOffers_SelectFile"]
                                <InputFile OnChange="HandleFileSelected" accept=".md,.markdown,.txt" style="display: none;" />
                            </label>
                            @if (!string.IsNullOrEmpty(selectedFileName))
                            {
                                <span style="font-size: 13px; color: var(--color-primary); font-weight: 600;">@selectedFileName</span>
                            }
                        </div>
                        <button class="bs-btn-secondary btn-sm" @onclick="LoadSampleMarkdown">
                            @Loc["AdminOffers_LoadSample"]
                        </button>
                    </div>

                    <div class="mb-4">
                        <textarea class="bs-input" rows="14" @bind="markdownInput" placeholder="@Loc["AdminOffers_TextareaPlaceholder"]" style="font-family: monospace; font-size: 13px; line-height: 1.5; width: 100%;"></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button class="bs-btn-secondary" @onclick="CloseMarkdownModal" disabled="@isProcessingMarkdown">@Loc["AdminOffers_Cancel"]</button>
                        <button class="bs-btn-primary" @onclick="PreviewMarkdownAsync" disabled="@(isProcessingMarkdown || string.IsNullOrWhiteSpace(markdownInput))" style="display: inline-flex; align-items: center; gap: 6px;">
                            @if (isProcessingMarkdown)
                            {
                                <span class="spinner-border spinner-border-sm" role="status"></span>
                                <span>@Loc["AdminOffers_Processing"]</span>
                            }
                            else
                            {
                                <span>@Loc["AdminOffers_PreviewAndValidate"]</span>
                            }
                        </button>
                    </div>
                }
                else
                {
                    <!-- Step 2: Interactive Preview -->
                    <div class="p-3 mb-4" style="background: var(--bg-card-alt); border: 1px solid var(--border-color); border-radius: 8px;">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                            <span style="font-size: 13px; font-weight: 700; color: var(--text-primary); text-transform: uppercase; letter-spacing: 0.5px;">
                                @Loc["AdminOffers_ProposalRequisites"]
                            </span>
                            @if (previewData.IsValid)
                            {
                                <span style="padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: 700; background: var(--color-success-bg, rgba(16, 185, 129, 0.15)); color: var(--color-success);">
                                    @string.Format(Loc["AdminOffers_ReadyForImport"], previewData.MatchedSkuCount, previewData.CustomItemCount, previewData.TotalItemCount)
                                </span>
                            }
                            else
                            {
                                <span style="padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: 700; background: var(--color-danger-bg, rgba(239, 68, 68, 0.15)); color: var(--color-danger);">
                                    @string.Format(Loc["AdminOffers_UnrecognizedWithoutPrice"], previewData.TotalItemCount - previewData.MatchedSkuCount - previewData.CustomItemCount, previewData.TotalItemCount)
                                </span>
                            }
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-md-6">
                                <label class="form-label mb-1" style="font-size: 12px; font-weight: 600; color: var(--text-muted);">
                                    @Loc["AdminOffers_ClientLabel"]
                                </label>
                                <input type="text" class="bs-input" value="@targetClientName" @oninput="OnClientNameInput" placeholder="@Loc["AdminOffers_ClientPlaceholder"]" style="width: 100%; font-size: 13px; font-weight: 600;" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label mb-1" style="font-size: 12px; font-weight: 600; color: var(--text-muted);">
                                    @Loc["AdminOffers_SiteLocationLabel"]
                                </label>
                                <input type="text" class="bs-input" @bind="targetSiteAddress" @bind:event="oninput" placeholder="@Loc["AdminOffers_SiteLocationPlaceholder"]" style="width: 100%; font-size: 13px;" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label mb-1" style="font-size: 12px; font-weight: 600; color: var(--text-muted);">
                                    @Loc["AdminOffers_ProjectTitleLabel"]
                                </label>
                                <input type="text" class="bs-input" @bind="targetProjectTitle" @bind:event="oninput" placeholder="@Loc["AdminOffers_ProjectTitlePlaceholder"]" style="width: 100%; font-size: 13px;" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label mb-1" style="font-size: 12px; font-weight: 600; color: var(--text-muted);">
                                    @Loc["AdminOffers_AssignToLabel"]
                                </label>
                                <input type="text" class="bs-input" value="@targetAssignTo" @oninput="OnAssignToInput" placeholder="admin" style="width: 100%; font-size: 13px;" />
                            </div>
                        </div>

                        @if (previewData.ValidationMessages.Any())
                        {
                            <div class="mt-3 p-2" style="background: var(--color-danger-bg, rgba(239, 68, 68, 0.08)); border-left: 3px solid var(--color-danger); border-radius: 4px;">
                                @foreach (var msg in previewData.ValidationMessages)
                                {
                                    <div style="font-size: 12px; color: var(--color-danger);">• @msg</div>
                                }
                            </div>
                        }
                    </div>

                    @if (previewData.Parameters != null && (!string.IsNullOrEmpty(previewData.Parameters.Location) || !string.IsNullOrEmpty(previewData.Parameters.TotalArea)))
                    {
                        <div class="mb-3 p-3" style="background: var(--bg-card-alt); border: 1px solid var(--border-color); border-radius: 8px; font-size: 13px;">
                            <div style="font-weight: 700; color: var(--text-primary); margin-bottom: 8px;">@Loc["AdminOffers_SiteParameters"]</div>
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                                @if (!string.IsNullOrEmpty(previewData.Parameters.Location))
                                {
                                    <div style="grid-column: span 2;"><span style="color: var(--text-muted);">@Loc["AdminOffers_ParamLocation"]</span> <strong>@previewData.Parameters.Location</strong></div>
                                }
                                @if (!string.IsNullOrEmpty(previewData.Parameters.PropertyCondition))
                                {
                                    <div style="grid-column: span 2;"><span style="color: var(--text-muted);">@Loc["AdminOffers_ParamCondition"]</span> @previewData.Parameters.PropertyCondition</div>
                                }
                                @if (!string.IsNullOrEmpty(previewData.Parameters.TotalArea))
                                {
                                    <div><span style="color: var(--text-muted);">@Loc["AdminOffers_ParamArea"]</span> <strong>@previewData.Parameters.TotalArea</strong></div>
                                }
                                @if (!string.IsNullOrEmpty(previewData.Parameters.ExecutionTimeline))
                                {
                                    <div><span style="color: var(--text-muted);">@Loc["AdminOffers_ParamTimeline"]</span> <strong>@previewData.Parameters.ExecutionTimeline</strong></div>
                                }
                                @if (!string.IsNullOrEmpty(previewData.Parameters.QualityLevel))
                                {
                                    <div><span style="color: var(--text-muted);">@Loc["AdminOffers_ParamQuality"]</span> <strong>@previewData.Parameters.QualityLevel</strong></div>
                                }
                                @if (!string.IsNullOrEmpty(previewData.Parameters.Warranty))
                                {
                                    <div><span style="color: var(--text-muted);">@Loc["AdminOffers_ParamWarranty"]</span> <strong>@previewData.Parameters.Warranty</strong></div>
                                }
                                @if (!string.IsNullOrEmpty(previewData.Parameters.PaymentTerms))
                                {
                                    <div style="grid-column: span 2;"><span style="color: var(--text-muted);">@Loc["AdminOffers_ParamPayment"]</span> <strong>@previewData.Parameters.PaymentTerms</strong></div>
                                }
                            </div>
                        </div>
                    }

                    @if (previewData.InvestmentBreakdown != null && previewData.InvestmentBreakdown.Any())
                    {
                        <div class="mb-3 p-3" style="background: var(--bg-card-alt); border: 1px solid var(--border-color); border-radius: 8px; font-size: 13px;">
                            <div style="font-weight: 700; color: var(--text-primary); margin-bottom: 8px;">@Loc["AdminOffers_InvestmentStructure"]</div>
                            <table class="table table-sm mb-1" style="font-size: 12px; color: var(--text-primary);">
                                <thead>
                                    <tr style="color: var(--text-muted); border-bottom: 1px solid var(--border-color);">
                                        <th>@Loc["AdminOffers_ColComponent"]</th>
                                        <th style="text-align: center; width: 60px;">@Loc["AdminOffers_ColShare"]</th>
                                        <th style="text-align: right; width: 140px;">EUR</th>
                                        <th style="text-align: right; width: 140px;">BGN</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var comp in previewData.InvestmentBreakdown)
                                    {
                                        <tr>
                                            <td style="font-weight: 600;">@comp.Name</td>
                                            <td style="text-align: center; font-weight: 700;">@comp.SharePercentage</td>
                                            <td style="text-align: right; font-family: monospace; font-weight: 600;">@comp.AmountEurRange</td>
                                            <td style="text-align: right; font-family: monospace; color: var(--text-muted);">@comp.AmountBgnRange</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            @if (!string.IsNullOrEmpty(previewData.AveragePricePerSqm))
                            {
                                <div style="text-align: right; font-size: 11px; color: var(--text-muted); font-style: italic;">@previewData.AveragePricePerSqm</div>
                            }
                        </div>
                    }

                    <!-- Breakdown Table -->
                    <div class="mb-4">
                        @foreach (var sec in previewData.Sections)
                        {
                            <div class="mb-3">
                                <h5 class="h6 mb-2" style="color: var(--color-primary); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">
                                    @string.Format(Loc["AdminOffers_SectionTitle"], sec.CategoryName)
                                </h5>
                                <div class="table-responsive">
                                    <table class="table table-sm" style="color: var(--text-primary); border-color: var(--border-color); font-size: 13px;">
                                        <thead>
                                            <tr style="border-bottom: 2px solid var(--border-color); color: var(--text-muted);">
                                                <th style="width: 40px; text-align: center;">@Loc["AdminOffers_ColIndex"]</th>
                                                <th>@Loc["AdminOffers_ColItemDesc"]</th>
                                                <th style="width: 80px; text-align: center;">@Loc["AdminOffers_ColUnit"]</th>
                                                <th style="width: 90px; text-align: right;">@Loc["AdminOffers_ColQuantity"]</th>
                                                <th style="width: 155px; text-align: right;">@Loc["AdminOffers_ColUnitPrice"]</th>
                                                <th style="width: 155px; text-align: right;">@Loc["AdminOffers_ColTotal"]</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in sec.Items)
                                            {
                                                <tr style="border-bottom: 1px solid var(--border-color);">
                                                    <td style="text-align: center; color: var(--text-muted); font-family: monospace;">@item.Index</td>
                                                    <td>
                                                        <div style="font-weight: 600;">@item.Title</div>
                                                        @if (item.IsSkuRecognized && !string.IsNullOrEmpty(item.SkuCode))
                                                        {
                                                            <span style="font-size: 11px; color: var(--text-muted); font-family: monospace;">SKU: @item.SkuCode</span>
                                                        }
                                                        else if (item.IsCustomPrice)
                                                        {
                                                            <span class="badge" style="background: var(--color-primary-bg, rgba(59, 130, 246, 0.15)); color: var(--color-primary); font-size: 11px; border: 1px solid var(--border-color);">@Loc["AdminOffers_CustomPriceBadge"]</span>
                                                        }
                                                        @if (item.SubItems != null && item.SubItems.Any())
                                                        {
                                                            <ul style="margin: 4px 0 0 16px; padding: 0; font-size: 11px; color: var(--text-muted);">
                                                                @foreach (var sub in item.SubItems)
                                                                {
                                                                    <li>@sub</li>
                                                                }
                                                            </ul>
                                                        }
                                                        @if (!string.IsNullOrEmpty(item.ValidationMessage))
                                                        {
                                                            <div style="font-size: 11px; color: var(--color-danger); margin-top: 2px;">• @item.ValidationMessage</div>
                                                        }
                                                    </td>
                                                    <td style="text-align: center; color: var(--text-muted);">@item.Unit</td>
                                                    <td style="text-align: right; font-family: monospace;">@item.Quantity.ToString("N2")</td>
                                                    <td style="text-align: right; font-family: monospace;">
                                                        <input type="text"
                                                               class="bs-input"
                                                               style="text-align: right; width: 140px; padding: 2px 6px; font-size: 13px; font-family: monospace; display: inline-block; background: var(--bg-card); color: var(--text-primary); border: 1px solid var(--border-color); border-radius: 4px;"
                                                               value="@GetItemPriceInput(item)"
                                                               @onchange="(e) => OnItemPriceChanged(item, sec, e.Value?.ToString())"
                                                               title="@Loc["AdminOffers_EditPriceTitle"]" />
                                                    </td>
                                                    <td style="text-align: right; font-family: monospace; font-weight: 600;">
                                                        @if (!string.IsNullOrWhiteSpace(item.PriceRangeText))
                                                        {
                                                            @if (item.Quantity == 1)
                                                            {
                                                                <span>@item.PriceRangeText</span>
                                                            }
                                                            else if (item.MinUnitPriceEur.HasValue && item.MaxUnitPriceEur.HasValue)
                                                            {
                                                                <span>€@((item.MinUnitPriceEur.Value * item.Quantity).ToString("N0")) – @((item.MaxUnitPriceEur.Value * item.Quantity).ToString("N0"))</span>
                                                            }
                                                            else
                                                            {
                                                                <span>@item.PriceRangeText</span>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <span>€@item.TotalEur.ToString("N2")</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr style="border-top: 1px solid var(--border-color); font-weight: 700;">
                                                <td colspan="5" style="text-align: right; padding-top: 8px;">@string.Format(Loc["AdminOffers_SubtotalForSection"], sec.CategoryName)</td>
                                                <td style="text-align: right; font-family: monospace; padding-top: 8px;">
                                                    @if (!string.IsNullOrWhiteSpace(sec.SubtotalRangeText))
                                                    {
                                                        <span>@sec.SubtotalRangeText</span>
                                                    }
                                                    else if (sec.SubtotalEur == 0m && !string.IsNullOrWhiteSpace(previewData.GrandTotalRangeText))
                                                    {
                                                        <span>@previewData.GrandTotalRangeText</span>
                                                    }
                                                    else
                                                    {
                                                        <span>€@sec.SubtotalEur.ToString("N2")</span>
                                                    }
                                                </td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Grand Total Banner -->
                    <div class="p-3 mb-4 d-flex justify-content-between align-items-center" style="background: var(--color-success-bg, rgba(16, 185, 129, 0.1)); border: 1px solid var(--color-success); border-radius: 8px;">
                        <span style="font-size: 16px; font-weight: 700; color: var(--text-primary);">@Loc["AdminOffers_GrandTotalLabel"]</span>
                        <div style="text-align: right;">
                            @if (!string.IsNullOrWhiteSpace(previewData.GrandTotalRangeText))
                            {
                                <span style="font-size: 20px; font-weight: 800; color: var(--color-success);">@previewData.GrandTotalRangeText</span>
                                @if (!string.IsNullOrWhiteSpace(previewData.GrandTotalBgnRangeText))
                                {
                                    <span style="font-size: 14px; color: var(--text-muted); margin-left: 6px;">(@previewData.GrandTotalBgnRangeText)</span>
                                }
                            }
                            else
                            {
                                <span style="font-size: 20px; font-weight: 800; color: var(--color-success);">€@previewData.GrandTotalEur.ToString("N2")</span>
                                <span style="font-size: 14px; color: var(--text-muted); margin-left: 6px;">(@previewData.GrandTotalBgn.ToString("N2") лв.)</span>
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-between gap-2">
                        <button class="bs-btn-secondary" @onclick="ResetPreview" disabled="@isProcessingMarkdown" style="display: inline-flex; align-items: center; gap: 6px;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                            @Loc["AdminOffers_BackToEdit"]
                        </button>
                        <button class="bs-btn-primary" @onclick="ConfirmAndImportAsync" disabled="@isProcessingMarkdown" style="display: inline-flex; align-items: center; gap: 6px;">
                            @if (isProcessingMarkdown)
                            {
                                <span class="spinner-border spinner-border-sm" role="status"></span>
                                <span>@Loc["AdminOffers_GeneratingPdf"]</span>
                            }
                            else
                            {
                                <span>@Loc["AdminOffers_ConfirmAndGeneratePdf"]</span>
                            }
                        </button>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private string? ErrorMessage;

    // Markdown Import Modal State
    private bool isMarkdownModalOpen = false;
    private string markdownInput = string.Empty;
    private string? selectedFileName;
    private bool isProcessingMarkdown = false;
    private string? modalError;
    private BuildSmart.Core.Application.DTOs.OfferPreviewDto? previewData;

    private string targetClientName = string.Empty;
    private string targetSiteAddress = string.Empty;
    private string targetProjectTitle = string.Empty;
    private string targetAssignTo = "admin";

    [Inject]
    public IBuildSmartApiClient ApiClient { get; set; } = null!;

    [Inject]
    public IJSRuntime JSRuntime { get; set; } = null!;

    [Inject]
    public HttpClient Http { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
