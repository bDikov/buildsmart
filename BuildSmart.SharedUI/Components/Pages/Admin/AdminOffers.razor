    private async Task HandleRegenerateOffer(Guid projectId)
    {
        StateHasChanged();
        
        try
        {
            var result = await ApiClient.AdminRegenerateOffer.ExecuteAsync(projectId);
            if (result.Errors?.Count > 0)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Error: " + result.Errors[0].Message);
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Offer cache invalidated! Click 'Generate & Download PDF' to view your fresh PDF offer.");
                await TriggerSearch();
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Error: " + ex.Message);
        }
        finally
        {
            StateHasChanged();
        }
    }

    private string GetItemPriceInput(BuildSmart.Core.Application.DTOs.OfferPreviewItemDto item)
    {
        if (!string.IsNullOrWhiteSpace(item.PriceRangeText))
        {
            return item.PriceRangeText;
        }
        return item.EffectiveUnitPriceEur > 0 ? item.EffectiveUnitPriceEur.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : string.Empty;
    }

    private static decimal? ParseInputNumber(string? input)
    {
        if (string.IsNullOrWhiteSpace(input)) return null;
        var s = System.Text.RegularExpressions.Regex.Replace(input, @"[^\d.,\s]", "").Trim();
        if (string.IsNullOrWhiteSpace(s)) return null;
        s = System.Text.RegularExpressions.Regex.Replace(s, @"\s+", "");

        if (s.Contains(',') && s.Contains('.'))
        {
            if (s.IndexOf(',') < s.IndexOf('.')) s = s.Replace(",", "");
            else s = s.Replace(".", "").Replace(",", ".");
        }
        else if (s.Contains(','))
        {
            var commaIdx = s.LastIndexOf(',');
            if (s.Length - commaIdx - 1 == 3 && commaIdx > 0) s = s.Replace(",", "");
            else s = s.Replace(",", ".");
        }
        else if (s.Contains('.'))
        {
            var dotIdx = s.LastIndexOf('.');
            if (s.Length - dotIdx - 1 == 3 && dotIdx > 0 && !s.Substring(0, dotIdx).Contains('.')) s = s.Replace(".", "");
        }

        if (decimal.TryParse(s, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var val))
        {
            return val;
        }
        return null;
    }

    private void OnItemPriceChanged(BuildSmart.Core.Application.DTOs.OfferPreviewItemDto item, BuildSmart.Core.Application.DTOs.OfferPreviewSectionDto section, string? rawInput)
    {
        if (string.IsNullOrWhiteSpace(rawInput)) return;
        rawInput = rawInput.Trim();

        var rangeMatch = System.Text.RegularExpressions.Regex.Match(rawInput, @"(?:€|EUR)?\s*([0-9\s.,]+)\s*[-–—]\s*(?:€|EUR)?\s*([0-9\s.,]+)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (rangeMatch.Success)
        {
            var minVal = ParseInputNumber(rangeMatch.Groups[1].Value);
            var maxVal = ParseInputNumber(rangeMatch.Groups[2].Value);

            if (minVal.HasValue && maxVal.HasValue)
            {
                decimal mi = minVal.Value;
                decimal ma = maxVal.Value;
                if (mi > ma)
                {
                    var tmp = mi;
                    mi = ma;
                    ma = tmp;
                }

                decimal avg = Math.Round((mi + ma) / 2m, 2);
                item.MinUnitPriceEur = mi;
                item.MaxUnitPriceEur = ma;
                item.EffectiveUnitPriceEur = avg;
                item.BaseUnitPriceEur = avg;
                item.PriceRangeText = $"€ {mi:N0} – {ma:N0}";
                item.TotalEur = Math.Round(item.Quantity * avg, 2);
                item.IsCustomPrice = true;
                if (!string.IsNullOrEmpty(item.ValidationMessage) && previewData != null)
                {
                    previewData.ValidationMessages.Remove(item.ValidationMessage);
                    item.ValidationMessage = null;
                }
            }
        }
        else
        {
            var singleVal = ParseInputNumber(rawInput);
            if (singleVal.HasValue)
            {
                item.MinUnitPriceEur = null;
                item.MaxUnitPriceEur = null;
                item.PriceRangeText = null;
                item.EffectiveUnitPriceEur = singleVal.Value;
                item.BaseUnitPriceEur = singleVal.Value;
                item.TotalEur = Math.Round(item.Quantity * singleVal.Value, 2);
                item.IsCustomPrice = true;
                if (!string.IsNullOrEmpty(item.ValidationMessage) && previewData != null)
                {
                    previewData.ValidationMessages.Remove(item.ValidationMessage);
                    item.ValidationMessage = null;
                }
            }
        }

        RecalculatePreviewTotals();
    }

    private void RecalculatePreviewTotals()
    {
        if (previewData == null) return;

        decimal grandTotal = 0m;
        decimal grandMin = 0m;
        decimal grandMax = 0m;
        bool anyRange = false;

        foreach (var sec in previewData.Sections)
        {
            decimal secTotal = 0m;
            decimal secMin = 0m;
            decimal secMax = 0m;
            bool secAnyRange = false;

            foreach (var it in sec.Items)
            {
                secTotal += it.TotalEur;
                if (it.MinUnitPriceEur.HasValue && it.MaxUnitPriceEur.HasValue && it.MaxUnitPriceEur.Value > it.MinUnitPriceEur.Value)
                {
                    secMin += it.MinUnitPriceEur.Value * it.Quantity;
                    secMax += it.MaxUnitPriceEur.Value * it.Quantity;
                    secAnyRange = true;
                }
                else
                {
                    secMin += it.TotalEur;
                    secMax += it.TotalEur;
                }
            }

            sec.SubtotalEur = secTotal;
            if (secAnyRange && secMax > secMin)
            {
                sec.SubtotalRangeText = $"€ {secMin:N0} – € {secMax:N0}";
            }
            else
            {
                sec.SubtotalRangeText = null;
            }

            grandTotal += secTotal;
            grandMin += secMin;
            grandMax += secMax;
            if (secAnyRange) anyRange = true;
        }

        previewData.GrandTotalEur = grandTotal;

        if (anyRange && grandMax > grandMin)
        {
            previewData.GrandTotalMinEur = grandMin;
            previewData.GrandTotalMaxEur = grandMax;
            previewData.GrandTotalRangeText = $"€ {grandMin:N0} – € {grandMax:N0}";
            previewData.GrandTotalBgnRangeText = $"{Math.Round(grandMin * 1.95583m, 0):N0} – {Math.Round(grandMax * 1.95583m, 0):N0} лв.";

            if (previewData.InvestmentBreakdown != null && previewData.InvestmentBreakdown.Any())
            {
                foreach (var comp in previewData.InvestmentBreakdown)
                {
                    var match = System.Text.RegularExpressions.Regex.Match(comp.SharePercentage, @"(\d+)");
                    if (match.Success && decimal.TryParse(match.Groups[1].Value, out var pct))
                    {
                        decimal share = pct / 100m;
                        decimal cMin = Math.Round(grandMin * share, 0);
                        decimal cMax = Math.Round(grandMax * share, 0);
                        comp.AmountEurRange = $"€ {cMin:N0} – € {cMax:N0}";
                        comp.AmountBgnRange = $"{Math.Round(cMin * 1.95583m, 0):N0} – {Math.Round(cMax * 1.95583m, 0):N0} лв.";
                    }
                }
            }

            if (previewData.Parameters != null && !string.IsNullOrWhiteSpace(previewData.Parameters.TotalArea))
            {
                var areaMatch = System.Text.RegularExpressions.Regex.Match(previewData.Parameters.TotalArea, @"([\d\.,]+)");
                if (areaMatch.Success && decimal.TryParse(areaMatch.Groups[1].Value.Replace(',', '.'), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var area) && area > 0)
                {
                    decimal minPerSqm = Math.Round(grandMin / area, 0);
                    decimal maxPerSqm = Math.Round(grandMax / area, 0);
                    decimal minBgnPerSqm = Math.Round(minPerSqm * 1.95583m, 0);
                    decimal maxBgnPerSqm = Math.Round(maxPerSqm * 1.95583m, 0);
                    previewData.AveragePricePerSqm = $"Средна цена: {minPerSqm:N0} – {maxPerSqm:N0} €/m² ({minBgnPerSqm:N0} – {maxBgnPerSqm:N0} лв./m²)";
                }
            }
        }
        else
        {
            previewData.GrandTotalRangeText = null;
            previewData.GrandTotalBgnRangeText = null;
        }

        previewData.IsValid = previewData.Sections.SelectMany(s => s.Items).All(i => string.IsNullOrEmpty(i.ValidationMessage));
        StateHasChanged();
    }
}
