    private async Task HandleFileSelected(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        selectedFileName = file.Name;
        modalError = null;
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var reader = new System.IO.StreamReader(stream);
            markdownInput = await reader.ReadToEndAsync();
            await PreviewMarkdownAsync();
        }
        catch (Exception ex)
        {
            modalError = string.Format(Loc["AdminOffers_FileReadError"], ex.Message);
        }
    }

    private async Task PreviewMarkdownAsync()
    {
        if (string.IsNullOrWhiteSpace(markdownInput)) return;

        isProcessingMarkdown = true;
        modalError = null;
        StateHasChanged();

        try
        {
            var requestUrl = $"{ApiConfig.GetBaseUrl()}/api/offers/preview-markdown";
            var payload = new
            {
                MarkdownContent = markdownInput,
                ClientName = string.IsNullOrWhiteSpace(targetClientName) ? null : targetClientName,
                SiteAddress = string.IsNullOrWhiteSpace(targetSiteAddress) ? null : targetSiteAddress,
                ProjectTitle = string.IsNullOrWhiteSpace(targetProjectTitle) ? null : targetProjectTitle,
                AssignTo = string.IsNullOrWhiteSpace(targetAssignTo) ? null : targetAssignTo
            };

            var token = await AuthService.GetTokenAsync();
            using var request = new HttpRequestMessage(HttpMethod.Post, requestUrl);
            if (!string.IsNullOrWhiteSpace(token))
            {
                request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }
            request.Content = JsonContent.Create(payload);
            var response = await Http.SendAsync(request);
            
            if (response.IsSuccessStatusCode)
            {
                previewData = await response.Content.ReadFromJsonAsync<BuildSmart.Core.Application.DTOs.OfferPreviewDto>();
                if (previewData != null)
                {
                    if (string.IsNullOrWhiteSpace(targetClientName) || targetClientName == "Уважаеми Клиент" || targetClientName == "Възложител")
                    {
                        if (!string.IsNullOrWhiteSpace(previewData.ClientName) && 
                            !previewData.ClientName.Equals("Уважаеми Клиент", StringComparison.OrdinalIgnoreCase) &&
                            !previewData.ClientName.Equals("Възложител", StringComparison.OrdinalIgnoreCase))
                        {
                            targetClientName = previewData.ClientName;
                        }
                        else if (!string.IsNullOrWhiteSpace(previewData.AssignTo) && !previewData.AssignTo.Equals("admin", StringComparison.OrdinalIgnoreCase))
                        {
                            targetClientName = previewData.AssignTo;
                        }
                        else
                        {
                            targetClientName = string.Empty;
                        }
                    }
                    if (string.IsNullOrWhiteSpace(targetSiteAddress))
                    {
                        targetSiteAddress = !string.IsNullOrWhiteSpace(previewData.SiteAddress) ? previewData.SiteAddress : (previewData.Parameters?.Location ?? string.Empty);
                    }
                    if (string.IsNullOrWhiteSpace(targetProjectTitle))
                    {
                        targetProjectTitle = previewData.ProjectTitle;
                    }
                    if (string.IsNullOrWhiteSpace(targetAssignTo) || targetAssignTo.Equals("admin", StringComparison.OrdinalIgnoreCase))
                    {
                        if (!string.IsNullOrWhiteSpace(previewData.AssignTo) && !previewData.AssignTo.Equals("admin", StringComparison.OrdinalIgnoreCase))
                        {
                            targetAssignTo = previewData.AssignTo;
                        }
                        else if (!string.IsNullOrWhiteSpace(targetClientName) && !targetClientName.Equals("Възложител", StringComparison.OrdinalIgnoreCase))
                        {
                            targetAssignTo = targetClientName;
                        }
                    }
                }
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                modalError = string.Format(Loc["AdminOffers_ValidationFailed"], err);
            }
        }
        catch (Exception ex)
        {
            modalError = string.Format(Loc["AdminOffers_CommunicationError"], ex.Message);
        }
        finally
        {
            isProcessingMarkdown = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmAndImportAsync()
    {
        if (string.IsNullOrWhiteSpace(markdownInput)) return;

        isProcessingMarkdown = true;
        modalError = null;
        StateHasChanged();

        try
        {
            var overrides = previewData?.Sections
                .SelectMany(s => s.Items)
                .Select(i => new BuildSmart.Core.Application.DTOs.MarkdownOfferItemOverride
                {
                    Index = i.Index,
                    SkuCode = i.SkuCode,
                    Title = i.Title,
                    Quantity = i.Quantity,
                    UnitPriceEur = i.EffectiveUnitPriceEur,
                    PriceRangeText = i.PriceRangeText,
                    MinUnitPriceEur = i.MinUnitPriceEur,
                    MaxUnitPriceEur = i.MaxUnitPriceEur,
                    TotalEur = i.TotalEur
                }).ToList();

            string effectiveClientName = targetClientName?.Trim() ?? string.Empty;
            string effectiveAssignTo = targetAssignTo?.Trim() ?? string.Empty;

            if (string.IsNullOrWhiteSpace(effectiveClientName) || effectiveClientName.Equals("Възложител", StringComparison.OrdinalIgnoreCase) || effectiveClientName.Equals("Уважаеми Клиент", StringComparison.OrdinalIgnoreCase))
            {
                if (!string.IsNullOrWhiteSpace(effectiveAssignTo) && !effectiveAssignTo.Equals("admin", StringComparison.OrdinalIgnoreCase))
                {
                    effectiveClientName = effectiveAssignTo;
                }
            }
            if (string.IsNullOrWhiteSpace(effectiveAssignTo) || effectiveAssignTo.Equals("admin", StringComparison.OrdinalIgnoreCase))
            {
                if (!string.IsNullOrWhiteSpace(effectiveClientName) && !effectiveClientName.Equals("Възложител", StringComparison.OrdinalIgnoreCase) && !effectiveClientName.Equals("Уважаеми Клиент", StringComparison.OrdinalIgnoreCase))
                {
                    effectiveAssignTo = effectiveClientName;
                }
            }

            var requestUrl = $"{ApiConfig.GetBaseUrl()}/api/offers/import-markdown";
            var payload = new
            {
                MarkdownContent = markdownInput,
                ClientName = effectiveClientName,
                SiteAddress = targetSiteAddress,
                ProjectTitle = targetProjectTitle,
                AssignTo = effectiveAssignTo,
                ItemOverrides = overrides
            };

            var token = await AuthService.GetTokenAsync();
            using var request = new HttpRequestMessage(HttpMethod.Post, requestUrl);
            if (!string.IsNullOrWhiteSpace(token))
            {
                request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }
            request.Content = JsonContent.Create(payload);
            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                CloseMarkdownModal();
                await TriggerSearch();
                await JSRuntime.InvokeVoidAsync("alert", Loc["AdminOffers_ImportSuccessAlert"].Value);
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                string errorDetail = err;
                try
                {
                    using var doc = System.Text.Json.JsonDocument.Parse(err);
                    if (doc.RootElement.TryGetProperty("error", out var errorProp))
                    {
                        errorDetail = errorProp.GetString() ?? err;
                    }
                    else if (doc.RootElement.TryGetProperty("Error", out var errorPropUpper))
                    {
                        errorDetail = errorPropUpper.GetString() ?? err;
                    }
                }
                catch
                {
                    // use raw err
                }
                modalError = string.Format(Loc["AdminOffers_CreateError"], errorDetail);
            }
        }
        catch (Exception ex)
        {
            modalError = string.Format(Loc["AdminOffers_CreateError"], ex.Message);
        }
        finally
        {
            isProcessingMarkdown = false;
            StateHasChanged();
        }
    }

    private async Task HandleSearchEnter(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
