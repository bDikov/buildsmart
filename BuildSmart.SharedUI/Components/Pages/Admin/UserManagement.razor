@page "/user-management"
@using BuildSmart.SharedUI.ViewModels.Admin
@using BuildSmart.SharedUI.GraphQL
@using BuildSmart.SharedUI.Services
@using Microsoft.AspNetCore.Authorization
@using System.Collections.Specialized
@attribute [Authorize(Roles = "Admin, ADMIN, admin")]
@inject UserManagementViewModel ViewModel
@inject NavigationManager NavManager
@inject SignalRService SignalRService
@inject IBuildSmartApiClient ApiClient
@implements IDisposable

<div class="admin-container">
    <div class="header-section">
        <div class="title-group">
            <h1 class="page-title">User Management</h1>
            <p class="page-subtitle">Manage system users, roles, and access.</p>
        </div>
        <div class="action-group" style="display: flex; gap: 16px; align-items: center;">
            <div class="filter-wrapper" style="display: flex; align-items: center; gap: 8px;">
                <span style="color: var(--text-muted); font-size: 14px; font-weight: 500;">Status:</span>
                <select class="bs-input form-select form-select-sm w-auto" 
                        style="border-radius: 8px; font-weight: bold; background-color: var(--bg-card-alt); color: var(--text-primary); border: 1px solid var(--border-color); padding: 8px 12px; cursor: pointer;" 
                        @bind="selectedStatusFilter">
                    <option value="All">All Statuses</option>
                    <option value="Online">Online</option>
                    <option value="RecentlyOnline">Recently Online</option>
                    <option value="Offline">Offline</option>
                </select>
            </div>
            <button class="bs-btn-secondary" @onclick="() => ViewModel.LoadUsersCommand.ExecuteAsync(null)">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
                Refresh
            </button>
        </div>
    </div>

    @if (ViewModel.IsBusy && ViewModel.Users.Count == 0)
    {
        <div class="loading-state">
            <div class="spinner-border text-primary" role="status"></div>
            <p>Loading users...</p>
        </div>
    }
    else if (ViewModel.IsEmpty)
    {
        <div class="empty-state bs-card">
            <div class="empty-icon">👥</div>
            <h3>No Users Found</h3>
            <p>There are currently no users in the system.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="bs-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in GetFilteredUsers())
                    {
                        <tr>
                            <td class="font-weight-bold">@user.FirstName @user.LastName</td>
                            <td>@user.Email</td>
                            <td>
                                <span class="role-badge @user.Role.ToString().ToLower()">@user.Role</span>
                            </td>
                            <td>
                                @{
                                    var activeStatus = GetUserStatus(user.Id, user.ActiveStatus);
                                }
                                <span class="status-badge @activeStatus.ToString().ToLower()">
                                    <span class="status-dot"></span>
                                    @GetStatusLabel(user.Id, activeStatus, user.LastSeenAt)
                                </span>
                            </td>
                            <td>
                                @if (user.Role == UserRoleTypes.Homeowner)
                                {
                                    @if (loadingChatUserIds.Contains(user.Id))
                                    {
                                        <span class="spinner-border spinner-border-sm text-primary" role="status" style="margin: 0 12px; display: inline-block; vertical-align: middle;"></span>
                                    }
                                    else
                                    {
                                        <button class="bs-btn-text" style="color: var(--color-primary); margin-right: 8px;" @onclick="() => StartChatAsync(user.Id, user.FirstName, user.LastName)">
                                            Chat
                                        </button>
                                    }
                                }
                                <button class="bs-btn-text" @onclick='() => NavManager.NavigateTo($"/user-edit?userId={user.Id}")'>
                                    Edit
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .admin-container {
        padding: 40px 20px;
        max-width: 1200px;
        margin: 0 auto;
        min-height: 100vh;
    }

    .header-section {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 40px;
        gap: 20px;
    }

    .page-title {
        font-size: 38px;
        font-weight: 800;
        margin: 0 0 8px 0;
        color: var(--text-primary);
        letter-spacing: -0.5px;
    }

    .page-subtitle {
        color: var(--text-muted);
        font-size: 16px;
        margin: 0;
    }

    .loading-state, .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 80px 40px;
    }

    .empty-icon {
        font-size: 64px;
        margin-bottom: 24px;
    }

    .bs-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        background-color: var(--bg-card);
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid var(--border-color);
    }

    .bs-table th, .bs-table td {
        padding: 16px 24px;
        text-align: left;
        border-bottom: 1px solid var(--border-color);
        color: var(--text-primary);
    }

    .bs-table th {
        background-color: rgba(0, 0, 0, 0.2);
        font-weight: 600;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--text-muted);
    }

    .bs-table tbody tr:last-child td {
        border-bottom: none;
    }

    .bs-table tbody tr:hover {
        background-color: var(--bg-card-alt);
    }

    .role-badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        background: rgba(255,255,255,0.1);
    }

    .role-badge.admin {
        background: rgba(244, 67, 54, 0.15);
        color: #F44336;
    }

    .role-badge.homeowner {
        background: rgba(33, 150, 243, 0.15);
        color: #2196F3;
    }

    .role-badge.tradesman {
        background: rgba(76, 175, 80, 0.15);
        color: #4CAF50;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
    }

    .status-badge.online {
        background: rgba(76, 175, 80, 0.15);
