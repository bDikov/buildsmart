    .bs-btn-text {
        background: transparent;
        border: none;
        color: var(--color-primary);
        font-weight: 600;
        cursor: pointer;
        padding: 8px 12px;
        border-radius: 6px;
        transition: background 0.2s;
    }

    .bs-btn-text:hover {
        background: rgba(255,255,255,0.05);
    }
</style>

@code {
    private string selectedStatusFilter = "All";
    private Dictionary<string, UserActiveStatus> userStatuses = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, DateTimeOffset> localLastSeenTimes = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        if (ViewModel.Users.Count == 0)
        {
            await ViewModel.LoadUsersCommand.ExecuteAsync(null);
        }

        InitializeUserStatuses();

        ViewModel.Users.CollectionChanged += OnUsersCollectionChanged;
        SignalRService.UserPresenceChanged += OnUserPresenceChanged;

        try
        {
            await SignalRService.ConnectAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error connecting to SignalR presence: {ex.Message}");
        }
    }

    private void OnUsersCollectionChanged(object? sender, NotifyCollectionChangedEventArgs e)
    {
        InvokeAsync(() =>
        {
            InitializeUserStatuses();
            StateHasChanged();
        });
    }

    private void InitializeUserStatuses()
    {
        foreach (var user in ViewModel.Users)
        {
            userStatuses[user.Id] = user.ActiveStatus;
        }

        // Clean up removed keys
        var currentIds = ViewModel.Users.Select(u => u.Id).ToHashSet();
        foreach (var key in userStatuses.Keys.ToList())
        {
            if (!currentIds.Contains(key))
            {
                userStatuses.Remove(key);
                localLastSeenTimes.Remove(key);
            }
        }
    }

    private void OnUserPresenceChanged(string userId, bool isOnline)
    {
        InvokeAsync(async () =>
        {
            if (userStatuses.ContainsKey(userId))
            {
                userStatuses[userId] = isOnline ? UserActiveStatus.Online : UserActiveStatus.RecentlyOnline;
                
                if (!isOnline)
                {
                    localLastSeenTimes[userId] = DateTimeOffset.UtcNow;
                }

                StateHasChanged();
            }
            else
            {
                // New user connected (registered or logged in) - reload the full user list
                await ViewModel.LoadUsersCommand.ExecuteAsync(null);
            }
        });
    }

    private UserActiveStatus GetUserStatus(string userId, UserActiveStatus fallbackStatus)
    {
        if (userStatuses.TryGetValue(userId, out var status))
        {
            return status;
        }
        return fallbackStatus;
    }

    private string GetStatusLabel(string userId, UserActiveStatus status, DateTimeOffset? originalLastSeenAt)
    {
        if (status == UserActiveStatus.Online)
        {
            return "Online";
        }

        DateTimeOffset? lastSeen = originalLastSeenAt;
        if (localLastSeenTimes.TryGetValue(userId, out var localTime))
        {
            lastSeen = localTime;
        }

        if (lastSeen == null)
        {
            return "Offline";
        }

        var timeSince = DateTimeOffset.UtcNow - lastSeen.Value;
        if (timeSince.TotalSeconds < 60)
        {
            return "Just now";
        }
        if (timeSince.TotalMinutes < 60)
        {
            int minutes = (int)timeSince.TotalMinutes;
            return $"{minutes} {(minutes == 1 ? "min" : "mins")} ago";
        }
        if (timeSince.TotalHours < 24)
        {
            int hours = (int)timeSince.TotalHours;
            return $"{hours} {(hours == 1 ? "hour" : "hours")} ago";
        }
        int days = (int)timeSince.TotalDays;
        return $"{days} {(days == 1 ? "day" : "days")} ago";
    }

    private IEnumerable<IGetUsers_Users> GetFilteredUsers()
    {
        if (selectedStatusFilter == "All")
        {
            return ViewModel.Users;
        }

        return ViewModel.Users.Where(u =>
        {
            var status = GetUserStatus(u.Id, u.ActiveStatus);
            return status.ToString().Equals(selectedStatusFilter, StringComparison.OrdinalIgnoreCase);
        });
    }

    private HashSet<string> loadingChatUserIds = new();

    private async Task StartChatAsync(string userId, string firstName, string lastName)
    {
        if (loadingChatUserIds.Contains(userId)) return;

        loadingChatUserIds.Add(userId);
        StateHasChanged();

        try
        {
            var userGuid = Guid.Parse(userId);
            var filter = new ProjectFilterInput
            {
                HomeownerId = new UuidOperationFilterInput
                {
                    Eq = userGuid
                }
            };

            var result = await ApiClient.GetAllProjects.ExecuteAsync(filter, null);
            if (result.Errors.Count == 0 && result.Data?.AllProjects != null && result.Data.AllProjects.Any())
            {
                // Open the first active project's chat
                var project = result.Data.AllProjects.First();
                NavManager.NavigateTo($"/project-messages?projectId={project.Id}");
            }
            else
            {
                // Create a new support project/chat
                var title = $"Support - {firstName} {lastName}";
                var description = "Default support chat room.";
                var createResult = await ApiClient.CreateProject.ExecuteAsync(userGuid, title, description, "en");
                if (createResult.Errors.Count == 0 && createResult.Data?.CreateProject != null)
                {
                    NavManager.NavigateTo($"/project-messages?projectId={createResult.Data.CreateProject.Id}");
                }
                else
                {
                    var errMsg = createResult.Errors.FirstOrDefault()?.Message ?? "Failed to create support chat.";
                    await AppServiceLocator.Alerts.DisplayAlert("Error", errMsg, "OK");
                }
            }
        }
        catch (Exception ex)
        {
            await AppServiceLocator.Alerts.DisplayAlert("Error", ex.Message, "OK");
        }
        finally
        {
            loadingChatUserIds.Remove(userId);
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        ViewModel.Users.CollectionChanged -= OnUsersCollectionChanged;
        SignalRService.UserPresenceChanged -= OnUserPresenceChanged;
    }
}
