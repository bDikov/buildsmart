@page "/admin-support-chats"
@using BuildSmart.SharedUI.GraphQL
@using BuildSmart.SharedUI.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin, ADMIN, admin")]
@layout BuildSmart.SharedUI.Components.Layout.MainLayout
@inject IBuildSmartApiClient ApiClient
@inject NavigationManager NavManager
@inject SignalRService SignalRService
@implements IAsyncDisposable
@inject IStringLocalizer<BuildSmart.SharedUI.Resources.AppResources> Loc

<div class="messenger-chats-container">
    <!-- Messenger Header -->
    <div class="messenger-header">
        <h1 class="messenger-title">Chats</h1>
        <div class="search-bar">
            <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" placeholder="Search chats by name, project, or email..." @bind="SearchQuery" @bind:event="oninput" />
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="messenger-loading">
            <div class="spinner-border text-primary" role="status"></div>
            <p>Loading chats...</p>
        </div>
    }
    else
    {
        <!-- Active Status Row -->
        <div class="active-users-row">
            <div class="active-user-item">
                <div class="avatar-container active-now">
                    <span class="avatar-initials">+</span>
                </div>
                <span class="active-user-name">Your Story</span>
            </div>
            @foreach (var chat in GetFilteredChats().Take(5))
            {
                <div class="active-user-item" @onclick="() => OpenChat(chat.ProjectId)">
                    <div class="avatar-container active-now bg-primary-subtle">
                        <span class="avatar-initials">@chat.HomeownerName[0]</span>
                        <span class="online-indicator @(chat.IsHomeownerOnline ? "" : "offline")"></span>
                    </div>
                    <span class="active-user-name text-truncate">@chat.HomeownerName.Split(' ')[0]</span>
                </div>
            }
        </div>

        @if (_searchResults.Any())
        {
            <div class="section-header">All Homeowners</div>
            <div class="search-results-section">
                @foreach (var user in _searchResults)
                {
                    var isExpanded = _expandedHomeownerIds.Contains(user.Id);
                    <div class="homeowner-row">
                        <div class="homeowner-header-row" @onclick="() => OnHomeownerClickedAsync(user.Id, user.FirstName, user.LastName)">
                            <div class="avatar-container bg-primary-subtle">
                                <span class="avatar-initials">@user.FirstName[0]</span>
                                <span class="online-indicator @(user.IsOnline ? "" : "offline")"></span>
                            </div>
                            <div class="homeowner-info">
                                <span class="homeowner-name">@user.FirstName @user.LastName</span>
                                <span class="homeowner-email">@user.Email</span>
                            </div>
                            <div class="expand-icon @(isExpanded ? "expanded" : "")">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="6 9 12 15 18 9"></polyline>
                                </svg>
                            </div>
                        </div>

                        @if (isExpanded)
                        {
                            <div class="homeowner-projects-container">
                                @if (!_homeownerProjects.ContainsKey(user.Id))
                                {
                                    <p class="text-muted">Loading projects...</p>
                                }
                                else
                                {
                                    var projects = _homeownerProjects[user.Id];
                                    @if (!projects.Any())
                                    {
                                        <button class="create-project-btn" @onclick="() => CreateSupportProjectAndChatAsync(user.Id, user.FirstName, user.LastName)" disabled="@_isCreatingProject">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line>
                                            </svg>
                                            Create Support Project & Chat
                                        </button>
                                    }
                                    else
                                    {
                                        <div class="projects-title">Choose Project:</div>
                                        @foreach (var proj in projects)
                                        {
                                            <div class="project-item-row" @onclick="() => OpenChat(proj.Id)">
                                                <span class="project-item-title">@proj.Title</span>
                                                <span class="project-item-status badge bg-secondary">@proj.Status</span>
                                            </div>
                                        }
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }

        <div class="section-header">Active Chats</div>

        <!-- Chats List -->
        <div class="chats-list">
            @if (GetFilteredChats().Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon">💬</div>
                    <h3>No Active Chats</h3>
                    <p>No homeowner support messages match your query.</p>
                </div>
            }
            else
            {
                @foreach (var chat in GetFilteredChats())
                {
                    <div class="chat-row" @onclick="() => OpenChat(chat.ProjectId)">
                        <div class="avatar-container bg-secondary-subtle">
                            <span class="avatar-initials">@chat.HomeownerName[0]</span>
                            <span class="online-indicator @(chat.IsHomeownerOnline ? "" : "offline")"></span>
                        </div>
                        <div class="chat-details">
                            <div class="chat-details-header">
                                <span class="chat-user-name">
                                    @chat.HomeownerName
                                    @if (!string.IsNullOrEmpty(chat.HomeownerEmail))
                                    {
                                        <span class="text-muted ms-1 fw-normal" style="font-size: 0.8em;">(@chat.HomeownerEmail)</span>
                                    }
                                </span>
                                @if (chat.LatestMessageTime.HasValue)
                                {
                                    <span class="chat-time-stamp" data-utc="@chat.LatestMessageTime?.ToString("o")">@FormatTime(chat.LatestMessageTime.Value)</span>
                                }
                            </div>
                            <div class="chat-message-preview-row">
                                <span class="chat-project-tag">@chat.ProjectTitle</span>
                                <span class="chat-message-dot">•</span>
                                <span class="chat-message-preview">@chat.LatestMessageText</span>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>
