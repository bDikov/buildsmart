                using var streamContent = new StreamContent(rawStream);
                streamContent.Headers.ContentLength = file.Size;
                var contentTypeHeader = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType;
                streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(contentTypeHeader);

                using var uploadClient = new HttpClient();
                uploadClient.Timeout = TimeSpan.FromMinutes(30);

                var r2Response = await uploadClient.PutAsync(preSignedUrl, streamContent);
                if (r2Response.IsSuccessStatusCode)
                {
                    var uri = new Uri(preSignedUrl);
                    var path = uri.AbsolutePath.TrimStart('/');
                    var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
                    var r2Key = segments.Length > 1 ? string.Join('/', segments.Skip(1)) : path;

                    var regResult = await ApiClient.RegisterUploadedMedia.ExecuteAsync(
                        folderId: null,
                        r2Key: r2Key,
                        fileName: file.Name,
                        contentType: file.ContentType ?? "application/octet-stream",
                        sizeBytes: file.Size,
                        width: null,
                        height: null,
                        durationSeconds: null);

                    if (regResult.Errors.Count == 0 && regResult.Data?.RegisterUploadedMedia != null)
                    {
                        return regResult.Data.RegisterUploadedMedia.PublicUrl;
                    }

                    return $"https://pub-7c580f96b011420fb7163dccc8051790.r2.dev/{r2Key}";
                }
                else
                {
                    var errBody = await r2Response.Content.ReadAsStringAsync();
                    throw new Exception($"Cloudflare R2 error ({(int)r2Response.StatusCode}): {errBody}");
                }
            }
            else if (urlResult.Errors.Count > 0)
            {
