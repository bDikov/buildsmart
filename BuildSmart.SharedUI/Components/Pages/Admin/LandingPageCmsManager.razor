@page "/admin/landing-pages"
@using BuildSmart.SharedUI.GraphQL
@using BuildSmart.Core.Domain.Entities
@using BuildSmart.Core.Application.DTOs
@using BuildSmart.SharedUI.Components.Common
@using BuildSmart.SharedUI.Components.Pages.Landing
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Localization
@using BuildSmart.SharedUI.Resources
@using System.Text.Json
@using System.Net.Http.Json
@attribute [Authorize(Roles = "Admin, ADMIN, admin")]
@inject BuildSmartApiClient ApiClient
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<AppResources> Loc
@inject NavigationManager NavManager
@inject BuildSmart.SharedUI.Services.IFileService FileService

<div class="admin-page">
    <div class="header-section">
        <div class="title-group">
            <h1 class="page-title">@Loc["Cms_LandingPagesTitle"]</h1>
            <p class="page-subtitle">@Loc["Cms_LandingPagesSubtitle"]</p>
        </div>
        <div class="header-action-group">
            <button class="bs-btn-secondary" @onclick='() => NavManager.NavigateTo("/admin/media-library")'>
                @Loc["Media_LibraryTitle"]
            </button>
            <button class="bs-btn-primary" @onclick="CreateNewLandingPage">
                @Loc["Cms_CreateLandingPage"]
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="status-alert @(_isError ? "error" : "success")">
            @_statusMessage
        </div>
    }

    @if (_isLoading)
    {
        <div class="loading-state">@Loc["Common_Loading"]</div>
    }
    else
    {
        <div class="cms-grid">
            <!-- Sidebar Table / List of Landing Pages -->
            <div class="bs-card list-card">
                <h3 class="card-section-title">@Loc["Cms_PagesList"]</h3>
                <div class="pages-list">
                    @foreach (var p in _landingPages)
                    {
                        <div class="page-item @(_selectedPage?.Id == p.Id ? "active" : "")" @onclick="() => SelectPage(p)">
                            <div class="page-info">
                                <span class="page-slug">/@p.Slug</span>
                                <span class="page-title-text">@(string.IsNullOrEmpty(p.TitleBg) ? p.Slug : p.TitleBg)</span>
                            </div>
                            <span class="status-badge @(p.IsPublished ? "published" : "draft")">
                                @(p.IsPublished ? Loc["Cms_Published"] : Loc["Cms_Draft"])
                            </span>
                        </div>
                    }
                </div>
            </div>

            <!-- Main Editor Form -->
            @if (_selectedPage != null)
            {
                <div class="bs-card editor-card">
                    <div class="editor-header">
                        <h2>@Loc["Cms_EditPageHeader"] (/@_selectedPage.Slug)</h2>
                        <div class="editor-actions">
                            <button class="bs-btn-secondary" @onclick="() => PreviewPage(_selectedPage.Slug)">
                                @Loc["Cms_Preview"]
                            </button>
                            <button class="bs-btn-danger" @onclick="DeleteSelectedPage">
                                @Loc["Cms_Delete"]
                            </button>
                            <button class="bs-btn-primary" @onclick="SaveSelectedPage" disabled="@_isSaving">
                                @(_isSaving ? Loc["Cms_Saving"] : Loc["Cms_Save"])
                            </button>
                        </div>
                    </div>

                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label">@Loc["Cms_Slug"] *</label>
                            <input type="text" class="bs-input" @bind="_selectedPage.Slug" placeholder="remont-na-apartament-sofia" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">@Loc["Cms_PageType"]</label>
                            <select class="bs-input" @bind="_selectedPage.PageType">
                                <option value="apartment">Apartment</option>
                                <option value="bathroom">Bathroom</option>
                                <option value="finishing">Finishing</option>
                                <option value="mep">MEP Services</option>
                                <option value="custom">Custom</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="form-label">@Loc["Cms_TitleBg"] *</label>
                            <input type="text" class="bs-input" @bind="_selectedPage.TitleBg" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">@Loc["Cms_TitleEn"] *</label>
                            <input type="text" class="bs-input" @bind="_selectedPage.TitleEn" />
                        </div>

                        <div class="form-group span-2">
                            <label class="form-label">@Loc["Cms_SubtitleBg"]</label>
                            <textarea class="bs-input textarea" @bind="_selectedPage.SubtitleBg"></textarea>
                        </div>

                        <div class="form-group span-2">
                            <label class="form-label">@Loc["Cms_SubtitleEn"]</label>
                            <textarea class="bs-input textarea" @bind="_selectedPage.SubtitleEn"></textarea>
                        </div>

                        <!-- Hero Picture & Hero Video Pickers with Media Library -->
                        <div class="media-section span-2">
                            <h3 class="section-subtitle">@Loc["Cms_HeroMediaHeader"] (Legacy Fallback)</h3>
                            <div class="media-grid">
                                <!-- Hero Image Picker -->
                                <div class="media-box">
                                    <label class="form-label">@Loc["Cms_HeroImageUrl"]</label>
                                    <div class="input-with-upload">
                                        <input type="text" class="bs-input" @bind="_selectedPage.HeroImageUrl" placeholder="https://..." />
                                        <button type="button" class="bs-btn-secondary" @onclick='() => OpenMediaPickerForTarget("hero-image")'>Pick Library</button>
                                        <label class="bs-btn-upload">
                                            <span>Upload</span>
                                            <InputFile OnChange="UploadHeroImage" accept="image/*" style="display:none;" />
                                        </label>
                                    </div>
                                    @if (!string.IsNullOrEmpty(_selectedPage.HeroImageUrl))
                                    {
                                        <div class="media-preview">
                                            <img src="@_selectedPage.HeroImageUrl" alt="Hero Preview" />
                                            <button class="remove-btn" @onclick="() => _selectedPage.HeroImageUrl = string.Empty">Clear</button>
                                        </div>
                                    }
                                </div>

                                <!-- Hero Video Picker -->
                                <div class="media-box">
                                    <label class="form-label">@Loc["Cms_HeroVideoUrl"]</label>
                                    <div class="input-with-upload">
                                        <input type="text" class="bs-input" @bind="_selectedPage.HeroVideoUrl" placeholder="https://...mp4" />
                                        <button type="button" class="bs-btn-secondary" @onclick='() => OpenMediaPickerForTarget("hero-video")'>Pick Library</button>
                                        <label class="bs-btn-upload">
                                            <span>Upload</span>
                                            <InputFile OnChange="UploadHeroVideo" accept="video/mp4,video/webm,video/*" style="display:none;" />
                                        </label>
                                    </div>
                                    @if (!string.IsNullOrEmpty(_selectedPage.HeroVideoUrl))
                                    {
                                        <div class="media-preview">
                                            <video src="@_selectedPage.HeroVideoUrl" controls muted style="max-height: 120px; width: 100%; object-fit: cover;"></video>
                                            <button class="remove-btn" @onclick="() => _selectedPage.HeroVideoUrl = string.Empty">Clear</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Top Hero Media Carousel Management -->
                        <div class="media-section span-2">
                            <div class="section-header-flex">
                                <div>
                                    <h3 class="section-subtitle">Top Hero Media Carousel (Multi-slide Video/Image Showcase)</h3>
                                    <p class="text-muted extra-small" style="margin: 4px 0 0 0; font-size: 0.8rem;">
                                        Manage multiple images and videos that display in the interactive hero carousel on live landing pages.
                                    </p>
                                </div>
                                <div class="gallery-upload-actions">
                                    <button type="button" class="bs-btn-secondary" @onclick='() => OpenMediaPickerForTarget("hero-carousel-add")'>Pick Library</button>
                                    <label class="bs-btn-upload-primary">
                                        <span>+ Upload Slide</span>
                                        <InputFile OnChange="UploadHeroCarouselFile" accept="image/*,video/*" style="display:none;" />
                                    </label>
                                    <button type="button" class="bs-btn-secondary" @onclick="AddEmptyHeroCarouselItem">+ Add URL Slide</button>
                                </div>
                            </div>

                            @if (_heroCarouselItems.Count == 0)
                            {
                                <div class="empty-media-box">No carousel slides added yet. Pick from Media Library or click "+ Upload Slide".</div>
                            }
                            else
                            {
                                <div class="gallery-items-grid">
                                    @for (int i = 0; i < _heroCarouselItems.Count; i++)
                                    {
                                        var index = i;
                                        var item = _heroCarouselItems[index];
                                        <div class="gallery-card">
                                            <div class="card-media-preview">
                                                @if (item.Type == "video")
                                                {
                                                    @if (!string.IsNullOrEmpty(item.Url))
                                                    {
                                                        <video src="@item.Url" controls muted class="card-media-element"></video>
                                                    }
                                                    else
                                                    {
                                                        <div class="placeholder-media">MP4 Video</div>
                                                    }
                                                }
                                                else
                                                {
                                                    @if (!string.IsNullOrEmpty(item.Url))
                                                    {
                                                        <img src="@item.Url" alt="Slide" class="card-media-element" />
                                                    }
                                                    else
                                                    {
                                                        <div class="placeholder-media">Image</div>
                                                    }
                                                }
                                                <div class="card-media-actions">
                                                    <button type="button" class="icon-btn" title="Move Up" disabled="@(index == 0)" @onclick="() => MoveHeroCarouselItemUp(index)">▲</button>
                                                    <button type="button" class="icon-btn" title="Move Down" disabled="@(index == _heroCarouselItems.Count - 1)" @onclick="() => MoveHeroCarouselItemDown(index)">▼</button>
                                                    <button type="button" class="icon-btn danger" title="Remove" @onclick="() => RemoveHeroCarouselItem(index)">✕ Remove</button>
                                                </div>
                                            </div>

                                            <div class="card-inputs">
                                                <div class="form-group">
                                                    <label class="form-label">Type</label>
                                                    <select class="bs-input form-select-sm" @bind="item.Type">
                                                        <option value="image">Image (Picture)</option>
                                                        <option value="video">Video (MP4)</option>
                                                    </select>
                                                </div>

                                                <div class="form-group">
                                                    <label class="form-label">Media URL</label>
                                                    <div class="input-with-upload">
                                                        <input type="text" class="bs-input" @bind="item.Url" placeholder="https://..." />
                                                        <button type="button" class="bs-btn-secondary" style="padding: 4px 8px; font-size: 0.75rem;" @onclick='() => OpenMediaPickerForTarget($"hero-carousel-item-{index}")'>Library</button>
                                                        <label class="bs-btn-upload" style="padding: 4px 8px; font-size: 0.75rem;">
                                                            <span>Upload</span>
                                                            <InputFile OnChange="@(e => UploadHeroCarouselItemFile(e, index))" accept="image/*,video/*" style="display:none;" />
                                                        </label>
                                                    </div>
                                                </div>

                                                <div class="form-group">
                                                    <label class="form-label">Caption (Bulgarian)</label>
                                                    <input type="text" class="bs-input" @bind="item.CaptionBg" placeholder="напр. Цялостен луксозен ремонт" />
                                                </div>

                                                <div class="form-group">
                                                    <label class="form-label">Caption (English)</label>
                                                    <input type="text" class="bs-input" @bind="item.CaptionEn" placeholder="e.g. Turnkey Luxury Renovation" />
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Interactive Media Gallery Management -->
                        <div class="media-section span-2">
                            <div class="section-header-flex">
                                <h3 class="section-subtitle">Pictures &amp; Videos Showcase Gallery</h3>
                                <div class="gallery-upload-actions">
                                    <button type="button" class="bs-btn-secondary" @onclick='() => OpenMediaPickerForTarget("gallery-add")'>Pick Library</button>
                                    <label class="bs-btn-upload-primary">
                                        <span>+ Upload Media</span>
                                        <InputFile OnChange="UploadGalleryFile" accept="image/*,video/*" style="display:none;" />
                                    </label>
                                    <button type="button" class="bs-btn-secondary" @onclick="AddEmptyGalleryItem">+ Add URL Item</button>
                                </div>
                            </div>

                            @if (_galleryItems.Count == 0)
                            {
                                <div class="empty-media-box">No pictures or videos added yet. Pick from Media Library or click "+ Upload Media".</div>
                            }
                            else
                            {
                                <div class="gallery-items-grid">
                                    @for (int i = 0; i < _galleryItems.Count; i++)
                                    {
                                        var index = i;
                                        var item = _galleryItems[index];
                                        <div class="gallery-card">
                                            <div class="card-media-preview">
                                                @if (item.Type == "video")
                                                {
                                                    @if (!string.IsNullOrEmpty(item.Url))
                                                    {
                                                        <video src="@item.Url" controls muted class="card-media-element"></video>
                                                    }
                                                    else
                                                    {
                                                        <div class="placeholder-media">MP4 Video</div>
                                                    }
                                                }
                                                else
                                                {
                                                    @if (!string.IsNullOrEmpty(item.Url))
                                                    {
                                                        <img src="@item.Url" alt="Gallery item" class="card-media-element" />
                                                    }
                                                    else
                                                    {
                                                        <div class="placeholder-media">Image</div>
                                                    }
                                                }
                                                <div class="card-media-actions">
                                                    <button type="button" class="icon-btn" disabled="@(index == 0)" @onclick="() => MoveGalleryItemUp(index)" title="Move Up">▲</button>
                                                    <button type="button" class="icon-btn" disabled="@(index == _galleryItems.Count - 1)" @onclick="() => MoveGalleryItemDown(index)" title="Move Down">▼</button>
                                                    <button type="button" class="icon-btn danger" @onclick="() => RemoveGalleryItem(index)" title="Delete">Remove</button>
                                                </div>
                                            </div>

                                            <div class="card-inputs">
                                                <div class="form-group">
                                                    <label class="form-label">Type</label>
                                                    <select class="bs-input form-select-sm" @bind="item.Type">
                                                        <option value="image">Image (Picture)</option>
                                                        <option value="video">Video (MP4)</option>
                                                    </select>
                                                </div>

                                                <div class="form-group">
                                                    <label class="form-label">Media URL</label>
                                                    <div class="input-with-upload">
                                                        <input type="text" class="bs-input" @bind="item.Url" placeholder="https://..." />
                                                        <button type="button" class="bs-btn-secondary" style="padding:4px 8px; font-size:0.75rem;" @onclick='() => OpenMediaPickerForTarget("gallery-item-" + index)'>Library</button>
                                                        <label class="bs-btn-upload" style="padding: 4px 8px; font-size: 0.75rem;">
                                                            <span>Upload</span>
                                                            <InputFile OnChange="@(e => UploadGalleryItemFile(e, index))" accept="image/*,video/*" style="display:none;" />
                                                        </label>
                                                    </div>
                                                </div>

                                                <div class="form-group">
                                                    <label class="form-label">Title / Caption (Bulgarian)</label>
                                                    <input type="text" class="bs-input" @bind="item.CaptionBg" placeholder="напр. Ремонт на тристаен апартамент" />
                                                </div>

                                                <div class="form-group">
                                                    <label class="form-label">Title / Caption (English)</label>
                                                    <input type="text" class="bs-input" @bind="item.CaptionEn" placeholder="e.g. 3-Room Apartment Renovation" />
                                                </div>

                                                <div class="form-group">
                                                    <label class="form-label">Location (BG)</label>
                                                    <input type="text" class="bs-input" @bind="item.LocationBg" placeholder="напр. София, кв. Лозенец" />
                                                </div>

                                                <div class="form-group">
                                                    <label class="form-label">Duration (BG)</label>
                                                    <input type="text" class="bs-input" @bind="item.DurationBg" placeholder="напр. 42 работни дни" />
                                                </div>

                                                <div class="form-group span-2">
                                                    <label class="form-label">Budget (BG)</label>
                                                    <input type="text" class="bs-input" @bind="item.BudgetBg" placeholder="напр. 34,800 лв. (€17,793)" />
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Interactive Features & Benefits Manager -->
                        <div class="media-section span-2">
                            <div class="section-header-flex">
                                <h3 class="section-subtitle">Features &amp; Benefits Cards</h3>
                                <button type="button" class="bs-btn-secondary" @onclick="AddFeatureItem">+ Add Feature Card</button>
                            </div>

                            <div class="features-list-grid">
                                @for (int i = 0; i < _featureItems.Count; i++)
                                {
                                    var index = i;
                                    var feature = _featureItems[index];
                                    <div class="feature-card">
                                        <div class="feature-card-header">
                                            <span>Feature #@(index + 1)</span>
                                            <button type="button" class="bs-btn-danger" style="padding: 4px 10px; font-size: 0.8rem;" @onclick="() => RemoveFeatureItem(index)">Remove</button>
                                        </div>

                                        <div class="form-grid">
                                            <div class="form-group">
                                                <label class="form-label">Icon</label>
                                                <select class="bs-input" @bind="feature.Icon">
                                                    <option value="shield">Shield (Security)</option>
                                                    <option value="lock">Lock (Fixed Price)</option>
                                                    <option value="clock">Clock (Fast Estimate)</option>
                                                    <option value="droplet">Droplet (Waterproofing)</option>
                                                    <option value="sparkles">Sparkles (Finishing)</option>
                                                    <option value="zap">Zap (Electrical)</option>
                                                </select>
                                            </div>

                                            <div class="form-group">
                                                <label class="form-label">Title (BG)</label>
                                                <input type="text" class="bs-input" @bind="feature.TitleBg" />
                                            </div>

                                            <div class="form-group">
                                                <label class="form-label">Title (EN)</label>
                                                <input type="text" class="bs-input" @bind="feature.TitleEn" />
                                            </div>

                                            <div class="form-group span-2">
                                                <label class="form-label">Description (BG)</label>
                                                <input type="text" class="bs-input" @bind="feature.DescBg" />
                                            </div>

                                            <div class="form-group span-2">
                                                <label class="form-label">Description (EN)</label>
                                                <input type="text" class="bs-input" @bind="feature.DescEn" />
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- CTA & Publication -->
                        <div class="form-group">
                            <label class="form-label">@Loc["Cms_CtaTextBg"]</label>
                            <input type="text" class="bs-input" @bind="_selectedPage.CtaTextBg" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">@Loc["Cms_CtaTextEn"]</label>
                            <input type="text" class="bs-input" @bind="_selectedPage.CtaTextEn" />
                        </div>

                        <div class="form-group span-2">
                            <label class="form-label">@Loc["Cms_CtaLink"]</label>
                            <input type="text" class="bs-input" @bind="_selectedPage.CtaLink" />
                        </div>

                        <div class="form-group span-2">
                            <label class="checkbox-label">
                                <input type="checkbox" @bind="_selectedPage.IsPublished" />
                                <span>@Loc["Cms_IsPublishedLabel"]</span>
                            </label>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- REUSABLE MEDIA PICKER MODAL -->
<MediaPickerModal 
    IsOpen="_showMediaPickerModal" 
    InitialFolder="@(_selectedPage != null ? $"landing-pages/{_selectedPage.Slug}" : "landing-pages")" 
    AllowedType="@_pickerAllowedType" 
    OnAssetSelected="OnPickerAssetSelected" 
    OnClose="() => _showMediaPickerModal = false" />

<style>
.admin-page {
    padding: 24px;
    max-width: 1300px;
    margin: 0 auto;
}

.header-section {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 16px;
}

.header-action-group {
    display: flex;
    gap: 12px;
}

.page-title {
    font: var(--font-h4);
    color: var(--text-primary);
    margin: 0;
}

.page-subtitle {
    font: var(--font-body-1);
    color: var(--text-muted);
    margin: 4px 0 0 0;
}

.status-alert {
    padding: 12px 18px;
    border-radius: 12px;
    margin-bottom: 20px;
    font: var(--font-body-1);
}

.status-alert.success {
    background: var(--bg-card-alt);
    border: 1px solid var(--color-success);
    color: var(--color-success);
}

.status-alert.error {
    background: var(--bg-card-alt);
    border: 1px solid var(--color-danger);
    color: var(--color-danger);
}

.loading-state {
    font: var(--font-body-1);
    color: var(--text-muted);
    text-align: center;
    padding: 40px;
}

.cms-grid {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 24px;
}

@@media (max-width: 900px) {
    .cms-grid {
        grid-template-columns: 1fr;
    }
}

.bs-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 20px;
    padding: 24px;
    box-shadow: var(--shadow-main);
}

.card-section-title {
    font: var(--font-h5);
    color: var(--text-primary);
    margin: 0 0 16px 0;
}

.pages-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.page-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 14px;
    border-radius: 12px;
    background: var(--bg-card-alt);
    border: 1px solid var(--border-color);
    cursor: pointer;
    transition: background 0.2s ease;
}

.page-item:hover, .page-item.active {
    border-color: var(--color-primary);
}

.page-info {
    display: flex;
    flex-direction: column;
}

.page-slug {
    font: var(--font-h3);
    color: var(--text-primary);
}

.page-title-text {
    font: var(--font-body-1);
    color: var(--text-muted);
    font-size: 0.85rem;
}

.status-badge {
    padding: 4px 8px;
    border-radius: 6px;
    font: var(--font-h3);
    font-size: 0.75rem;
    text-transform: uppercase;
}

.status-badge.published {
    background: var(--bg-card);
    color: var(--color-success);
    border: 1px solid var(--color-success);
}

.status-badge.draft {
    background: var(--bg-card);
    color: var(--text-muted);
    border: 1px solid var(--border-color);
}

.editor-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 16px;
}

.editor-header h2 {
    font: var(--font-h5);
    color: var(--text-primary);
    margin: 0;
}

.editor-actions {
    display: flex;
    gap: 10px;
}

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}

.span-2 {
    grid-column: span 2;
}

@@media (max-width: 600px) {
    .form-grid {
        grid-template-columns: 1fr;
    }
    .span-2 {
        grid-column: span 1;
    }
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.form-label {
    font: var(--font-h3);
    color: var(--text-primary);
}

.bs-input {
    background: var(--bg-card-alt);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 10px 14px;
    font: var(--font-body-1);
    color: var(--text-primary);
    outline: none;
    transition: border-color 0.2s ease;
}

.bs-input:focus {
