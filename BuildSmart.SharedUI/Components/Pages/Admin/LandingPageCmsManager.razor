            var isVideo = e.File.ContentType.StartsWith("video", StringComparison.OrdinalIgnoreCase);
            _heroCarouselItems[index].Url = url;
            _heroCarouselItems[index].Type = isVideo ? "video" : "image";
            _statusMessage = "Slide media uploaded successfully!";
            _isError = false;
        }
    }

    private async Task UploadGalleryItemFile(InputFileChangeEventArgs e, int index)
    {
        if (_selectedPage == null || e.File == null || index < 0 || index >= _galleryItems.Count) return;
        _statusMessage = "Uploading gallery media...";
        var url = await UploadFileToServerAsync(e.File);
        if (!string.IsNullOrEmpty(url))
        {
            var isVideo = e.File.ContentType.StartsWith("video", StringComparison.OrdinalIgnoreCase);
            _galleryItems[index].Url = url;
            _galleryItems[index].Type = isVideo ? "video" : "image";
            _statusMessage = "Gallery media uploaded successfully!";
            _isError = false;
        }
    }

    private void MoveGalleryItemUp(int index)
    {
        if (index > 0)
        {
            var item = _galleryItems[index];
            _galleryItems.RemoveAt(index);
            _galleryItems.Insert(index - 1, item);
        }
    }

    private void MoveGalleryItemDown(int index)
    {
        if (index < _galleryItems.Count - 1)
        {
            var item = _galleryItems[index];
            _galleryItems.RemoveAt(index);
            _galleryItems.Insert(index + 1, item);
        }
    }

    private void AddFeatureItem()
    {
        _featureItems.Add(new FeatureItemModel
        {
            Icon = "shield"
        });
    }

    private void RemoveFeatureItem(int index)
    {
        if (index >= 0 && index < _featureItems.Count)
        {
            _featureItems.RemoveAt(index);
        }
    }

    private async Task SaveSelectedPage()
    {
        if (_selectedPage == null) return;

        _isSaving = true;
        _statusMessage = null;
        _isError = false;

        try
        {
            var combinedMedia = new List<MediaGalleryItemModel>();
            combinedMedia.AddRange(_heroCarouselItems.Select(h => new MediaGalleryItemModel
            {
                Url = h.Url,
                Type = h.Type,
                CaptionBg = h.CaptionBg,
                CaptionEn = h.CaptionEn,
                Order = h.Order,
                Section = "hero"
            }));
            combinedMedia.AddRange(_galleryItems.Select(g =>
            {
                g.Section = "gallery";
                return g;
            }));

            _selectedPage.MediaGalleryJson = JsonSerializer.Serialize(combinedMedia);
            _selectedPage.FeaturesJson = JsonSerializer.Serialize(_featureItems);

            // Sync fallback hero image and video from the first carousel items if available
            var firstVideo = _heroCarouselItems.FirstOrDefault(i => i.Type == "video");
            if (firstVideo != null && !string.IsNullOrWhiteSpace(firstVideo.Url))
            {
                _selectedPage.HeroVideoUrl = firstVideo.Url;
            }
            var firstImage = _heroCarouselItems.FirstOrDefault(i => i.Type == "image");
            if (firstImage != null && !string.IsNullOrWhiteSpace(firstImage.Url))
            {
                _selectedPage.HeroImageUrl = firstImage.Url;
            }

            var input = new LandingPageInput
            {
                Id = _selectedPage.Id,
                Slug = _selectedPage.Slug,
                PageType = _selectedPage.PageType,
                TitleBg = _selectedPage.TitleBg,
                TitleEn = _selectedPage.TitleEn,
                SubtitleBg = _selectedPage.SubtitleBg,
                SubtitleEn = _selectedPage.SubtitleEn,
                BadgeBg = _selectedPage.BadgeBg,
                BadgeEn = _selectedPage.BadgeEn,
                HeroImageUrl = _selectedPage.HeroImageUrl,
                HeroVideoUrl = _selectedPage.HeroVideoUrl,
                MediaGalleryJson = _selectedPage.MediaGalleryJson,
                FeaturesJson = _selectedPage.FeaturesJson,
                CtaTextBg = _selectedPage.CtaTextBg,
                CtaTextEn = _selectedPage.CtaTextEn,
                CtaLink = _selectedPage.CtaLink,
                IsPublished = _selectedPage.IsPublished
            };

            var result = await ApiClient.UpsertLandingPage.ExecuteAsync(input);
            if (result.Errors.Count == 0)
            {
                _statusMessage = "Landing page saved successfully!";
                await LoadLandingPages();
            }
            else
            {
                _statusMessage = "Save failed: " + string.Join(", ", result.Errors.Select(e => e.Message));
                _isError = true;
            }
        }
        catch (Exception ex)
        {
            _statusMessage = "Error saving page: " + ex.Message;
            _isError = true;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteSelectedPage()
    {
        if (_selectedPage == null) return;

        _statusMessage = null;
        _isError = false;

        try
        {
            var result = await ApiClient.DeleteLandingPage.ExecuteAsync(_selectedPage.Id);
            if (result.Errors.Count == 0 && result.Data?.DeleteLandingPage == true)
            {
                _statusMessage = "Landing page deleted successfully.";
                _selectedPage = null;
                await LoadLandingPages();
            }
            else
            {
                _statusMessage = "Delete failed.";
                _isError = true;
            }
        }
        catch (Exception ex)
        {
            _statusMessage = "Error deleting page: " + ex.Message;
            _isError = true;
        }
    }
}
