@page "/job-wizard"
@using BuildSmart.SharedUI.ViewModels
@using static BuildSmart.SharedUI.ViewModels.JobWizardViewModel
@using System.ComponentModel
@using Microsoft.AspNetCore.Components.Web
@layout BuildSmart.SharedUI.Components.Layout.MainLayout
@implements IAsyncDisposable
@inject JobWizardViewModel ViewModel
@inject IJSRuntime JSRuntime
@inject NavigationManager NavManager


<style>
    /* Prevent horizontal scrollbars during swipe without triggering the 'auto' vertical scrollbar bug */
    body, html, .page, .main-content, .content {
        overflow-x: clip !important;
        overflow-y: visible !important;
    }

    /* Dynamic Horizontal Step Progress Bar */
    .bs-wizard-horizontal-steps {
        position: relative;
        width: 100%;
        margin-top: 20px;
        margin-bottom: 25px;
        padding: 0 5px;
    }

    .bs-horizontal-step-line {
        position: absolute;
        top: 18px;
        left: 30px;
        right: 30px;
        height: 3px;
        background-color: var(--border-color);
        z-index: 1;
        border-radius: 2px;
    }

    .bs-horizontal-step-line-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--color-primary), var(--color-primary-hover, #703fed));
        border-radius: 2px;
        transition: width 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        box-shadow: 0 0 10px rgba(110, 63, 243, 0.4);
    }

    .bs-horizontal-step-items {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        z-index: 2;
    }

    .bs-horizontal-step-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        flex: 1;
        text-align: center;
    }

    .bs-step-circle {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 14px;
        transition: all 0.3s ease;
        background-color: var(--bg-card);
        border: 2px solid var(--border-color);
        color: var(--text-muted);
    }

    .bs-horizontal-step-item.completed .bs-step-circle {
        background-color: var(--color-primary);
        border-color: var(--color-primary);
        color: #ffffff;
        box-shadow: 0 0 10px rgba(110, 63, 243, 0.3);
    }

    .bs-horizontal-step-item.active .bs-step-circle {
        background-color: var(--bg-card);
        border-color: var(--color-primary);
        color: var(--text-primary);
        box-shadow: 0 0 0 3px rgba(110, 63, 243, 0.2), 0 0 14px rgba(110, 63, 243, 0.4);
        transform: scale(1.06);
    }

    .bs-step-label {
        font-size: 12px;
        font-weight: 600;
        color: var(--text-muted);
        max-width: 90px;
        line-height: 1.2;
        transition: color 0.3s ease;
        word-wrap: break-word;
    }

    .bs-horizontal-step-item.active .bs-step-label {
        color: var(--text-primary);
        font-weight: 700;
    }

    .bs-horizontal-step-item.completed .bs-step-label {
        color: var(--text-secondary);
    }

    /* Segmented Control Buttons */
    .bs-segmented-control {
        display: flex;
        gap: 10px;
        width: 100%;
        flex-wrap: wrap;
    }

    .bs-segmented-btn {
        flex: 1;
        min-width: 80px;
        padding: 12px 16px;
        background-color: var(--bg-card-alt);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        color: var(--text-primary);
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .bs-segmented-btn:hover {
        border-color: var(--color-primary);
        background-color: var(--border-color);
    }

    .bs-segmented-btn.active {
        background-color: var(--color-primary);
        border-color: var(--color-primary);
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(110, 63, 243, 0.35);
    }

    /* Custom Checkbox Card Rows */
    .bs-checkbox-container {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .bs-checkbox-row {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 18px;
        background-color: var(--bg-card-alt);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s ease;
        user-select: none;
    }

    .bs-checkbox-row:hover {
        border-color: var(--color-primary);
    }

    .bs-checkbox-row.checked {
        background-color: rgba(110, 63, 243, 0.08);
        border-color: var(--color-primary);
    }

    .bs-custom-checkbox {
        width: 22px;
        height: 22px;
        border: 2px solid var(--border-color);
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        background-color: transparent;
        color: transparent;
        flex-shrink: 0;
    }

    .bs-checkbox-row.checked .bs-custom-checkbox {
        background-color: var(--color-primary);
        border-color: var(--color-primary);
        color: #ffffff;
        box-shadow: 0 2px 8px rgba(110, 63, 243, 0.4);
    }

    .bs-checkbox-label {
        color: var(--text-primary);
        font-size: 15px;
        font-weight: 500;
    }
</style>


<ErrorBoundary>
    <ChildContent>
        @if (ViewModel == null || !ViewModel.WizardSteps.Any())
        {
            <div class="d-flex justify-content-center align-items-center" style="min-height: 200px;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">@Loc["JobWizard_Loading"]</span>
                </div>
            </div>
        }
        else if (ViewModel.IsOfferBuilding)
        {
            <div class="container py-5 text-center d-flex justify-content-center align-items-center" style="min-height: 80vh;">
                <div class="bs-card p-5 mx-auto" style="max-width: 600px; border-radius: 16px; border: 1px solid var(--border-color); background-color: var(--bg-card);">
                    <div class="mb-4 d-flex justify-content-center">
                        <div class="offer-building-loader">
                            <div class="spinner-grow text-primary" role="status" style="width: 3rem; height: 3rem; background-color: var(--color-primary);">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </div>
                    <h3 class="h3 fw-bold mb-3" style="color: var(--text-primary); font-family: var(--font-heading);">@Loc["JobWizard_OfferBuilding_Title"]</h3>
                    <p class="text-secondary mb-4" style="font-size: 1.1rem; line-height: 1.6;">
                        @Loc["JobWizard_OfferBuilding_Message"]
                    </p>
                    <p class="text-muted mb-5" style="font-size: 0.95rem;">
                        @Loc["JobWizard_OfferBuilding_SubMessage"]
                    </p>
                    <button class="bs-btn-primary w-100 fw-bold" @onclick='() => NavigateToProjectDetails()'>
                        @Loc["JobWizard_GoToProjects"]
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="container py-4" style="position: relative; min-height: 80vh; user-select: none; -webkit-user-select: none;">
                
                <!-- Progress Bar & Trust Badges (Unified Block) -->
                <BuildSmart.SharedUI.Components.ProgressCard 
                    Title="@Loc["JobWizard_YourProgress"]" 
                    ProgressPercentage="@ViewModel.ProgressPercentage" 
                    StepText="@string.Format(Loc["JobWizard_StepText"], ViewModel.CurrentStepNumber, ViewModel.TotalSteps)" 
                    SubtitleText="@GetSubtitleText()" />

                <!-- Dynamic Horizontal Step Progress Bar -->
                @if (ViewModel.WizardSteps != null && ViewModel.WizardSteps.Count > 1)
                {
                    <div class="bs-wizard-horizontal-steps mb-4">
                        <div class="bs-horizontal-step-line">
                            <div class="bs-horizontal-step-line-fill" style="width: @(GetStepProgressPercentage())%;"></div>
                        </div>
                        <div class="bs-horizontal-step-items">
                            @for (int i = 0; i < ViewModel.WizardSteps.Count; i++)
                            {
                                var stepIdx = i;
                                var step = ViewModel.WizardSteps[stepIdx];
                                var isCompleted = stepIdx < ViewModel.CurrentStep;
                                var isActive = stepIdx == ViewModel.CurrentStep;
                                
                                <div class="bs-horizontal-step-item @(isActive ? "active" : (isCompleted ? "completed" : "pending"))">
                                    <div class="bs-step-circle">
                                        @if (isCompleted)
                                        {
                                            <svg class="bs-check-icon" viewBox="0 0 24 24" width="16" height="16">
                                                <path fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" d="M20 6L9 17l-5-5" />
                                            </svg>
                                        }
                                        else
                                        {
                                            <span>@(stepIdx + 1)</span>
                                        }
                                    </div>
                                    <span class="bs-step-label">@step.Title</span>
                                </div>
                            }
                        </div>
                    </div>
                }


                <!-- Swipe Hint Lottie -->
                @if (!_hasUserSwiped && ViewModel.CurrentStepNumber == 1 && !ViewModel.HasProjects)
                {
                    <div class="swipe-hint-overlay">
                        <lottie-player src="https://lottie.host/809fccbe-d886-4f49-9f79-e58f000b9573/1G0eRIn1R3.json" background="transparent" speed="1" style="width: 150px; height: 150px;" loop autoplay></lottie-player>
                    </div>
                }

                <div class="card-stack-wrapper" style="position: relative; width: 100%;">
                    @if (ViewModel.CurrentStepNumber < ViewModel.TotalSteps)
                    {
                        <!-- Background stacked cards for Figma depth effect -->
                        <div class="bs-card" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; transform: translateY(14px) scale(0.96); opacity: 0.5; z-index: 1; pointer-events: none; transition: all 0.3s ease; margin-bottom: 0; box-shadow: 0 8px 32px rgba(0,0,0,0.05);"></div>
                        @if (ViewModel.CurrentStepNumber < ViewModel.TotalSteps - 1)
                        {
                            <div class="bs-card" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; transform: translateY(28px) scale(0.92); opacity: 0.24; z-index: 0; pointer-events: none; transition: all 0.3s ease; margin-bottom: 0; box-shadow: 0 8px 32px rgba(0,0,0,0.05);"></div>
                        }
                    }

                    <div @ref="_swipeCardContainer" class="@_transitionClass" style="width: 100%; @GetSwipeStyle(); position: relative; z-index: 2;">
                        <!-- Step 0: Basic Info (now Project Details) -->
                        @if (ViewModel.IsInfoStepVisible)
                        {
                            <div class="bs-card p-4">
                                <h3 class="h4 fw-bold mb-4" style="font-family: var(--font-heading); color: var(--text-primary);">@ViewModel.CurrentStepTitle</h3>

                                @if (ViewModel.Questions != null)
                                {
                                    @foreach (var q in ViewModel.Questions)
                                    {
                                        @if (q.IsVisible)
                                        {
                                            <div class="mb-4 question-field @(q.HasError ? "has-error" : "")">
                                                <div class="fw-bold text-uppercase" style="font-size: 0.75rem; color: var(--color-primary);">@q.CategoryName</div>
                                                <label class="form-label fw-bold mb-2 @(q.HasError ? "text-danger" : "")" style="color: @(q.HasError ? "var(--color-danger, #dc3545)" : "var(--text-primary)");">
                                                    @Loc[q.Text]
                                                    @if (q.IsRequired)
                                                    {
                                                        <span class="text-danger ms-1">*</span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(q.HintText))
                                                    {
                                                        <span class="ms-2" style="cursor: pointer; color: var(--color-primary);" title="@Loc[q.HintText]">(?)</span>
                                                    }
                                                </label>

                                                @if (q.IsText)
                                                {
                                                    <input type="text" class="bs-input @(q.HasError ? "border border-danger" : "")" placeholder="@Loc["JobWizard_TypeAnswerHere"]" @bind="q.Answer" @bind:event="oninput" />
                                                }
                                                else if (q.IsNumber)
                                                {
                                                    <input type="number" min="0" class="bs-input @(q.HasError ? "border border-danger" : "")" placeholder="0" @bind="q.Answer" />
                                                }
                                                else if (q.IsChoice && q.Options != null)
                                                {
                                                    @if (q.Options.Count <= 3)
                                                    {
                                                        <div class="bs-segmented-control mt-2">
                                                            @for (int idx = 0; idx < q.Options.Count; idx++)
                                                            {
                                                                var index = idx;
                                                                var optValue = q.RawOptions.Count > index ? q.RawOptions[index] : q.Options[index];
                                                                var optText = q.Options[index];
                                                                <button type="button" class="bs-segmented-btn @(q.Answer == optValue ? "active" : "")" @onclick="@(() => q.Answer = optValue)">
                                                                    @optText
                                                                </button>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <BuildSmart.SharedUI.Components.BsDropdown 
                                                             TValue="string" 
                                                             Options="q.RawOptions" 
                                                             DisplayOptions="q.Options" 
                                                             TranslateOptions="false" @bind-Value="q.Answer" 
                                                             Placeholder="@Loc["JobWizard_SelectOption"]" />
                                                    }
                                                }
                                                else if (q.IsMultiSelect && q.Options != null)
                                                {
                                                    <div class="bs-checkbox-container mt-2">
                                                        @for (int idx = 0; idx < q.Options.Count; idx++)
                                                         {
                                                             var index = idx;
                                                             var opt = q.Options[index];
                                                             var isChecked = q.IsOptionSelected(index);
                                                             <div class="bs-checkbox-row @(isChecked ? "checked" : "")" @onclick="@(() => q.ToggleMultiSelectOption(index, !isChecked))">
                                                                 <div class="bs-custom-checkbox">
                                                                     @if (isChecked)
                                                                     {
                                                                         <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                                                             <polyline points="20 6 9 17 4 12"></polyline>
                                                                         </svg>
                                                                     }
                                                                 </div>
                                                                 <span class="bs-checkbox-label">@opt</span>
                                                             </div>
                                                         }
                                                    </div>
                                                }
                                                else if (q.IsBoolean)
                                                {
                                                    <div class="bs-segmented-control mt-2">
                                                        <button type="button" class="bs-segmented-btn @(q.BoolAnswer == true ? "active" : "")" @onclick="@(() => q.BoolAnswer = true)">
                                                            @Loc["JobWizard_Yes"]
                                                        </button>
                                                        <button type="button" class="bs-segmented-btn @(q.BoolAnswer == false ? "active" : "")" @onclick="@(() => q.BoolAnswer = false)">
                                                            @Loc["JobWizard_No"]
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                }

                                <button class="bs-btn-primary mt-3 w-100 fw-bold" disabled="@ViewModel.IsBusy" @onclick="HandleInfoStepSubmit">
                                    @Loc["JobWizard_SaveAndViewOffer"]
                                </button>
                            </div>
                        }

                        <!-- Step 1: Category Selection -->
                        @if (ViewModel.IsCategoryStepVisible)
                        {
                            <BuildSmart.SharedUI.Components.CategorySelector 
                                Categories="ViewModel.SelectableCategories" 
                                HasError="ViewModel.CategorySelectionHasError"
                                IsBusy="ViewModel.IsBusy"
                                NextButtonText="@Loc[ViewModel.NextButtonText]"
                                OnNextClicked="HandleNextClick" />
                        }

                        <!-- Dynamic Questions Step -->
                        @if (ViewModel.IsQuestionStepVisible)
                        {
                            <div class="bs-card p-4">
                                @if (ViewModel.Questions != null)
                                {
                                    @foreach (var q in ViewModel.Questions)
                                    {
                                        @if (q.IsVisible)
                                        {
                                            <div class="mb-4 question-field @(q.HasError ? "has-error" : "")">
                                                <div class="fw-bold text-uppercase" style="font-size: 0.75rem; color: var(--color-primary);">@q.CategoryName</div>
                                                <label class="form-label fw-bold mb-2 @(q.HasError ? "text-danger" : "")" style="color: @(q.HasError ? "var(--color-danger, #dc3545)" : "var(--text-primary)");">
                                                    @Loc[q.Text]
                                                    @if (q.IsRequired)
                                                    {
                                                        <span class="text-danger ms-1">*</span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(q.HintText))
                                                    {
                                                        <span class="ms-2" style="cursor: pointer; color: var(--color-primary);" title="@Loc[q.HintText]">(?)</span>
                                                    }
                                                </label>

                                                @if (q.IsText)
                                                {
                                                    <input type="text" class="bs-input @(q.HasError ? "border border-danger" : "")" placeholder="@Loc["JobWizard_TypeAnswerHere"]" @bind="q.Answer" @bind:event="oninput" />
                                                }
                                                else if (q.IsNumber)
                                                {
                                                    <input type="number" min="0" class="bs-input @(q.HasError ? "border border-danger" : "")" placeholder="0" @bind="q.Answer" />
                                                }
                                                else if (q.IsChoice && q.Options != null)
                                                {
                                                    @if (q.Options.Count <= 3)
                                                    {
                                                        <div class="bs-segmented-control mt-2">
                                                            @for (int idx = 0; idx < q.Options.Count; idx++)
                                                            {
                                                                var index = idx;
                                                                var optValue = q.RawOptions.Count > index ? q.RawOptions[index] : q.Options[index];
                                                                var optText = q.Options[index];
                                                                <button type="button" class="bs-segmented-btn @(q.Answer == optValue ? "active" : "")" @onclick="@(() => q.Answer = optValue)">
                                                                    @optText
                                                                </button>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <BuildSmart.SharedUI.Components.BsDropdown 
                                                             TValue="string" 
                                                             Options="q.RawOptions" 
                                                             DisplayOptions="q.Options" 
                                                             TranslateOptions="false" @bind-Value="q.Answer" 
                                                             Placeholder="@Loc["JobWizard_SelectOption"]" />
                                                    }
                                                }
                                                else if (q.IsMultiSelect && q.Options != null)
                                                {
                                                    <div class="bs-checkbox-container mt-2">
                                                        @for (int idx = 0; idx < q.Options.Count; idx++)
                                                         {
                                                             var index = idx;
                                                             var opt = q.Options[index];
                                                             var isChecked = q.IsOptionSelected(index);
                                                             <div class="bs-checkbox-row @(isChecked ? "checked" : "")" @onclick="@(() => q.ToggleMultiSelectOption(index, !isChecked))">
                                                                 <div class="bs-custom-checkbox">
                                                                     @if (isChecked)
                                                                     {
                                                                         <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                                                             <polyline points="20 6 9 17 4 12"></polyline>
                                                                         </svg>
                                                                     }
                                                                 </div>
                                                                 <span class="bs-checkbox-label">@opt</span>
                                                             </div>
                                                         }
                                                    </div>
                                                }
                                                else if (q.IsBoolean)
                                                {
                                                    <div class="bs-segmented-control mt-2">
                                                        <button type="button" class="bs-segmented-btn @(q.BoolAnswer == true ? "active" : "")" @onclick="@(() => q.BoolAnswer = true)">
                                                            @Loc["JobWizard_Yes"]
                                                        </button>
                                                        <button type="button" class="bs-segmented-btn @(q.BoolAnswer == false ? "active" : "")" @onclick="@(() => q.BoolAnswer = false)">
                                                            @Loc["JobWizard_No"]
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                }

                                <div class="d-flex flex-column gap-3 mt-4">
                                    <button class="bs-btn-primary w-100 fw-bold" disabled="@ViewModel.IsBusy" @onclick="HandleNextClick">
                                        @Loc[ViewModel.NextButtonText]
                                    </button>
                                    
                                     @if (!ViewModel.IsEditing || ViewModel.CurrentStep > 0)
                                     {
                                         <button class="bs-btn-dark w-100 fw-bold" style="background-color: transparent; border: 1px solid var(--border-color); color: var(--text-primary);" disabled="@ViewModel.IsBusy" @onclick="HandlePreviousClick">
                                             @Loc["JobWizard_Back"]
                                         </button>
                                     }
                                </div>
                            </div>
                        }

                        <!-- Review Step -->
                        @if (ViewModel.IsReviewStepVisible)
                        {
                            <div class="bs-card p-4">
                                <h3 class="h4 fw-bold mb-4" style="font-family: var(--font-heading); color: var(--text-primary);">@Loc["JobWizard_ReviewSubmit"]</h3>
                                
                                <div class="mb-3">
                                    <span class="fw-bold text-secondary">@Loc["JobWizard_TitleLabel"]</span>
                                    <div style="font-size: 1.1rem; margin-top: 5px; color: var(--text-primary);">@ViewModel.ProjectTitle</div>
                                </div>

                                <div class="mb-3">
                                    <span class="fw-bold text-secondary">@Loc["JobWizard_SelectedCategoriesLabel"]</span>
                                    <ul class="list-unstyled mb-0 mt-2" style="padding-left: 15px; color: var(--color-primary);">
                                        @if (ViewModel.SelectableCategories != null)
                                        {
                                            @foreach (var cat in ViewModel.SelectableCategories.Where(c => c.IsSelected))
                                            {
                                                <li style="margin-bottom: 5px;">&bull; @(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.StartsWith("en", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrEmpty(cat.Category?.EnglishName) ? cat.Category.EnglishName : cat.Category?.Name)</li>
                                            }
                                        }
                                    </ul>
                                </div>

                                <div class="mb-3 mt-4">
                                    <span class="fw-bold text-secondary">@Loc["JobWizard_JobDetailsLabel"]</span>
                                    <div class="p-3 rounded mt-2" style="background-color: var(--bg-card-alt); max-height: 250px; overflow-y: auto; border: 1px solid var(--border-color);">
                                        @if (ViewModel.AnswersList != null)
                                        {
                                            @foreach (var ans in ViewModel.AnswersList)
                                            {
                                                <div class="mb-3">
                                                    <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 2px;">@ans.Key</div>
                                                    <div class="fw-bold" style="font-size: 0.95rem; color: var(--text-primary);">@ans.Value</div>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>

                                <div class="d-flex flex-column gap-3 mt-4">
                                    <button class="bs-btn-primary w-100 fw-bold" disabled="@ViewModel.IsBusy" @onclick="HandleSubmitProject">
                                        @Loc["JobWizard_PostProject"]
                                    </button>
                                    
                                    <button class="bs-btn-dark w-100 fw-bold" style="background-color: transparent; border: 1px solid var(--border-color); color: var(--text-primary);" disabled="@ViewModel.IsBusy" @onclick="HandlePreviousClick">
                                        @Loc["JobWizard_Back"]
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>

            </div>

            <!-- Floating Back Button -->
            @if (ViewModel.CurrentStepNumber > 1 && ViewModel.WizardSteps[ViewModel.CurrentStep].Type != WizardStepType.Info)
            {
                <button class="bs-btn-floating-back" @onclick="HandlePreviousClick" aria-label="Go Back">
                    <svg viewBox="0 0 24 24">
                        <path d="M15 18l-6-6 6-6" />
                    </svg>
                </button>
            }
        }
    </ChildContent>
    <ErrorContent>
        <div class="alert alert-danger m-3">
            <h4>@Loc["JobWizard_ErrorRendering"]</h4>
            <p>@context.Message</p>
            <pre style="font-size: 10px; overflow-x: auto;">@context.StackTrace</pre>
        </div>
    </ErrorContent>
</ErrorBoundary>

@code {
    private void NavigateToProjectDetails()
    {
        if (ViewModel.CurrentProjectId.HasValue)
        {
            NavManager.NavigateTo($"/project-detail?projectId={ViewModel.CurrentProjectId.Value}");
        }
        else
        {
            NavManager.NavigateTo("/my-projects");
        }
    }

    private async Task HandleSubmitProject()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("posthog.capture", "ai_estimate_generated");
            await JSRuntime.InvokeVoidAsync("pushToDataLayer", "project_submitted", new { projectId = ViewModel.CurrentProjectId });
        }
        catch { }

        await ViewModel.SubmitProject();
    }

    [SupplyParameterFromQuery] public Guid? ProjectId { get; set; }
    [SupplyParameterFromQuery] public Guid? JobId { get; set; }
    [SupplyParameterFromQuery] public Guid? TargetCategoryId { get; set; }

    private int _previousStepNumber;
    private string _transitionClass = "";
    private double? _touchStartX;
    private bool _hasUserSwiped = false;
    
    // Tinder-like swipe state
    private double _currentSwipeX = 0;
    private double _currentSwipeRotation = 0;
    private string _swipeTransition = "none";
    private bool _isSwiping = false;
    private DateTime? _touchStartTime;
    private CancellationTokenSource? _wiggleCts;
    private bool _isWiggling = false;

    // JS Interop
    private IJSObjectReference? _module;
    private DotNetObjectReference<JobWizard>? _objRef;
    private ElementReference _swipeCardContainer;

    private string GetSwipeStyle()
    {
        if (_currentSwipeX == 0 && _currentSwipeRotation == 0 && string.IsNullOrEmpty(_swipeTransition))
            return "touch-action: pan-y;";
            
        return $"transition: {_swipeTransition}; transform: translateX({_currentSwipeX}px) rotate({_currentSwipeRotation}deg); touch-action: pan-y; transform-origin: 50% 100%;";
    }

    [CascadingParameter(Name = "LanguageCode")]
    public string LanguageCode { get; set; } = "en";

    protected override void OnInitialized()
    {
        if (ViewModel != null)
        {
            _previousStepNumber = ViewModel.CurrentStepNumber;
            ViewModel.PropertyChanged += OnViewModelPropertyChanged;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try 
            {
                _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/BuildSmart.SharedUI/Components/Pages/JobWizard.razor.js");
                _objRef = DotNetObjectReference.Create(this);
                await _module.InvokeVoidAsync("initializeSwipe", _swipeCardContainer, _objRef);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading JS: {ex.Message}");
            }

            try
            {
                await JSRuntime.InvokeVoidAsync("posthog.capture", "wizard_started");
            }
            catch { }

            // Give the UI a moment to settle, then wiggle the first card
            _wiggleCts = new CancellationTokenSource();
            _ = PlayWiggleAnimation(_wiggleCts.Token);
        }
    }

    [JSInvokable]
    public void NotifyInteraction()
    {
        _wiggleCts?.Cancel();
    }

    [JSInvokable]
    public async Task ProcessSwipeEndFromJS(double deltaX, double velocity, double currentX, double currentRot)
    {
        // First, sync our Blazor state with exactly where the JS left the card,
        // so our CSS transition starts from the correct position.
        _currentSwipeX = currentX;
        _currentSwipeRotation = currentRot;
        _swipeTransition = "none";
        await InvokeAsync(StateHasChanged);

        // Accept a swipe if they dragged far enough OR if they flicked it quickly
        bool isSwipeLeft = deltaX < -80 || (deltaX < -30 && velocity > 0.5);
        bool isSwipeRight = deltaX > 80 || (deltaX > 30 && velocity > 0.5);

        bool isReviewOrInfo = ViewModel.WizardSteps[ViewModel.CurrentStep].Type == WizardStepType.Review ||
                              ViewModel.WizardSteps[ViewModel.CurrentStep].Type == WizardStepType.Info;

        if (isSwipeLeft && !isReviewOrInfo && ViewModel.GoToNextStepCommand.CanExecute(null)) // Swiped left -> Next
        {
            if (!ViewModel.ValidateCurrentStep())
            {
                // Validation failed! Snap back immediately and show errors with a bouncy spring
                if (_module != null && _swipeCardContainer.Id != null) 
                    await _module.InvokeVoidAsync("resetSwipeStyle", _swipeCardContainer);

                _swipeTransition = "transform 0.6s cubic-bezier(0.2, 1.2, 0.3, 1)";
                _currentSwipeX = 0;
                _currentSwipeRotation = 0;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(600); // let animation finish
                _swipeTransition = "none";
                await InvokeAsync(StateHasChanged);
                await ScrollToElement();
                return;
            }

            _hasUserSwiped = true;
            if (_module != null && _swipeCardContainer.Id != null) 
                await _module.InvokeVoidAsync("resetSwipeStyle", _swipeCardContainer);

            // Fluid fly-away
            _swipeTransition = "transform 0.35s cubic-bezier(0.1, 0.7, 0.1, 1)";
            _currentSwipeX = -1200; // Fly offscreen left
            _currentSwipeRotation = -15;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(300); // Let it fly away just enough
            
            ViewModel.GoToNextStepCommand.Execute(null);
        }
        else if (isSwipeRight && ViewModel.CurrentStepNumber > 1 && ViewModel.WizardSteps[ViewModel.CurrentStep].Type != WizardStepType.Info && ViewModel.GoToPreviousStepCommand.CanExecute(null))
        {
            // Allow swiping right to go back, but only if not editing single job and NOT on the very first step
            _hasUserSwiped = true;
            if (_module != null && _swipeCardContainer.Id != null) 
                await _module.InvokeVoidAsync("resetSwipeStyle", _swipeCardContainer);

            _swipeTransition = "transform 0.35s cubic-bezier(0.1, 0.7, 0.1, 1)";
            _currentSwipeX = 1200; // Fly offscreen right
            _currentSwipeRotation = 15;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(300);
            
            ViewModel.GoToPreviousStepCommand.Execute(null);
        }
        else
        {
            if (_module != null && _swipeCardContainer.Id != null) 
                await _module.InvokeVoidAsync("resetSwipeStyle", _swipeCardContainer);

            // Not swiped far enough (or trying to swipe wrong way on step 1), snap back with a bouncy "spring" feel
            _swipeTransition = "transform 0.5s cubic-bezier(0.2, 1.2, 0.3, 1)";
            _currentSwipeX = 0;
            _currentSwipeRotation = 0;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(500); // let animation finish
            _swipeTransition = "none";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PlayWiggleAnimation(CancellationToken token)
    {
        try
        {
            await Task.Delay(1500, token); // Wait for the user to read the first screen

            while (!token.IsCancellationRequested)
            {
                if (_hasUserSwiped || ViewModel == null || ViewModel.CurrentStepNumber != 1) return;
                
                _isWiggling = true;
                
                // Wiggle Right
                // Use a smooth ease-in-out curve (Material standard) so it 'hangs' naturally at the peak of the swing.
                _swipeTransition = "transform 0.7s cubic-bezier(0.4, 0, 0.2, 1)";
                _currentSwipeX = 90;
                _currentSwipeRotation = 6;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(650, token); // Let it reach the peak smoothly

                // Swing Left
                _swipeTransition = "transform 0.8s cubic-bezier(0.4, 0, 0.2, 1)";
                _currentSwipeX = -90;
                _currentSwipeRotation = -6;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(750, token);

                // Swing Right (medium)
                _swipeTransition = "transform 0.7s cubic-bezier(0.4, 0, 0.2, 1)";
                _currentSwipeX = 50;
                _currentSwipeRotation = 3;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(650, token);

                // Swing Left (small)
                _swipeTransition = "transform 0.6s cubic-bezier(0.4, 0, 0.2, 1)";
                _currentSwipeX = -20;
                _currentSwipeRotation = -1;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(550, token);

                // Settle gently back to center
                _swipeTransition = "transform 0.5s cubic-bezier(0.4, 0, 0.2, 1)";
                _currentSwipeX = 0;
                _currentSwipeRotation = 0;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(500, token);

                _swipeTransition = "none";
                await InvokeAsync(StateHasChanged);
                
                _isWiggling = false;
                
                // Wait for a few seconds before playing the animation again
                await Task.Delay(4000, token);
            }
        }
        catch (TaskCanceledException)
        {
            // User touched the screen, cancel the animation and let their finger take over
            if (_isWiggling)
            {
                 _swipeTransition = "none";
                 // Don't reset X and Rotation here, let HandleTouchMove manage it
            }
        }
        finally
        {
            _isWiggling = false;
        }
    }

    protected override void OnParametersSet()
    {
        if (ViewModel != null)
        {
            ViewModel.ActiveLanguageCode = LanguageCode;

            var queryParams = new Dictionary<string, object>();
            if (ProjectId.HasValue) queryParams["ProjectId"] = ProjectId.Value;
            if (JobId.HasValue) queryParams["JobPostId"] = JobId.Value;
            if (TargetCategoryId.HasValue) queryParams["TargetCategoryId"] = TargetCategoryId.Value;
            
            ViewModel.ApplyQueryAttributes(queryParams);
        }
    }

    private async void OnViewModelPropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        if (e.PropertyName == nameof(ViewModel.CurrentStepNumber))
        {
            // Reset swipe transform for incoming card so CSS keyframes can take over
            _currentSwipeX = 0;
            _currentSwipeRotation = 0;
            _swipeTransition = "none";
            
            if (ViewModel.CurrentStepNumber > _previousStepNumber)
            {
                _transitionClass = "slide-enter-right";
                try
                {
                    var completedStepIdx = _previousStepNumber - 1;
                    if (ViewModel.WizardSteps != null && completedStepIdx >= 0 && completedStepIdx < ViewModel.WizardSteps.Count)
                    {
                        var step = ViewModel.WizardSteps[completedStepIdx];
                        await JSRuntime.InvokeVoidAsync("posthog.capture", "wizard_step_completed", new { stepIndex = completedStepIdx, stepName = step.Title ?? step.Type.ToString() });
                    }
                }
                catch { }
            }
            else if (ViewModel.CurrentStepNumber < _previousStepNumber)
            {
                _transitionClass = "slide-enter-left";
            }
            _previousStepNumber = ViewModel.CurrentStepNumber;
            
            // Force re-render to apply transition
            await InvokeAsync(StateHasChanged);
            await ScrollToElement();
        }
        else
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleNextClick()
    {
        _hasUserSwiped = true; // Hide hint if they manually click next

        if (!ViewModel.ValidateCurrentStep())
        {
            await InvokeAsync(StateHasChanged); // Force render of validation errors
            await ScrollToElement();
            return; 
        }

        if (ViewModel.GoToNextStepCommand.CanExecute(null))
        {
            _swipeTransition = "transform 0.35s cubic-bezier(0.1, 0.7, 0.1, 1)";
            _currentSwipeX = -1200; // Fly left
            _currentSwipeRotation = -15;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(300);
            
            ViewModel.GoToNextStepCommand.Execute(null);
        }
    }

    private async Task HandlePreviousClick()
    {
        if (ViewModel.CurrentStepNumber <= 1 || ViewModel.WizardSteps[ViewModel.CurrentStep].Type == WizardStepType.Info) return;

        _hasUserSwiped = true; // Hide hint if they manually click back
        if (ViewModel.GoToPreviousStepCommand.CanExecute(null))
        {
            _swipeTransition = "transform 0.35s cubic-bezier(0.1, 0.7, 0.1, 1)";
            _currentSwipeX = 1200; // Fly right
            _currentSwipeRotation = 15;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(300);
            
            ViewModel.GoToPreviousStepCommand.Execute(null);
        }
    }

    private async Task HandleInfoStepSubmit()
    {
        _hasUserSwiped = true; // Hide hint if they manually click next
        if (ViewModel.SaveProjectDetailsCommand.CanExecute(null))
        {
            _swipeTransition = "transform 0.35s cubic-bezier(0.1, 0.7, 0.1, 1)";
            _currentSwipeX = -1200; // Fly left
            _currentSwipeRotation = -15;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(300);
            
            await ViewModel.SaveProjectDetailsCommand.ExecuteAsync(null);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (ViewModel != null)
        {
            try { await ViewModel.SaveDraftAsync(); } catch { }
            ViewModel.PropertyChanged -= OnViewModelPropertyChanged;
        }

        _wiggleCts?.Cancel();
        _wiggleCts?.Dispose();
        _objRef?.Dispose();
        if (_module != null)
        {
            try { await _module.DisposeAsync(); } catch { }
        }
    }

    private string GetSubtitleText()
    {
        if (ViewModel.IsReviewStepVisible) return Loc["JobWizard_ReviewSubtitle"];
        return ViewModel.CurrentStepTitle;
    }

    private double GetStepProgressPercentage()
    {
        if (ViewModel == null || ViewModel.TotalSteps <= 1) return 0;
        double progress = ((double)ViewModel.CurrentStep / (ViewModel.TotalSteps - 1)) * 100.0;
        return Math.Max(0, Math.Min(100, progress));
    }

    private async Task ScrollToElement()
    {

        try
        {
            if (_module != null)
            {
                bool hasErrors = ViewModel.Questions?.Any(q => q.IsVisible && q.HasError) == true;
                if (hasErrors)
                {
                    await _module.InvokeVoidAsync("scrollToFirstError", _swipeCardContainer);
                }
                else
                {
                    await _module.InvokeVoidAsync("scrollToElement", _swipeCardContainer);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error scrolling to element: {ex.Message}");
        }
    }
}