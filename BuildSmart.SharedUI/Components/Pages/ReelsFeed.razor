@page "/reels/{TradesmanId}"
@using BuildSmart.SharedUI.GraphQL
@inject IJSRuntime JSRuntime
@inject BuildSmartApiClient ApiClient
@implements IAsyncDisposable

<div class="reels-page-container">
    <div class="close-btn-container">
        <button class="back-btn" @onclick="GoBack">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
        </button>
    </div>

    @if (isLoading)
    {
        <div class="loading-state" style="color: white; margin-top: 50px; text-align: center;">Loading Reels...</div>
    }
    else if (Reels.Count == 0)
    {
        <div class="empty-state" style="color: white; margin-top: 50px; text-align: center;">No videos available for this tradesman.</div>
    }
    else
    {
        <div id="reels-feed-container" class="reels-feed-container">
            @foreach (var reel in Reels)
            {
                var isRendered = Math.Abs(Reels.IndexOf(reel) - CurrentIndex) <= 1; // Rule of 3 (prev, current, next)

                <div class="reel-wrapper" id="@reel.Id" data-video-id="@reel.Id">
                    @if (isRendered)
                    {
                        <video class="reel-video" 
                               loop 
                               muted="false" 
                               playsinline 
                               preload="auto"
                               poster="@reel.ImageUrl">
                            @if (!string.IsNullOrEmpty(reel.MobileVideoUrl))
                            {
                                <source src="@reel.MobileVideoUrl" media="(max-width: 768px)" type="video/mp4" />
                            }
                            <source src="@reel.VideoUrl" type="video/mp4" />
                        </video>
                    }
                    else
                    {
                        <div class="video-placeholder"></div>
                    }

                    <!-- Overlay UI -->
                    <div class="reel-overlay">
                        <div class="reel-info">
                            <h3 class="reel-title">@reel.Title</h3>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .reels-page-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: #000;
        z-index: 1000; /* Full screen overlay */
    }

    .reels-feed-container {
        width: 100%;
        height: 100%;
        overflow-y: scroll;
        scroll-snap-type: y mandatory;
        /* Hide scrollbar for clean look */
        -ms-overflow-style: none;  
        scrollbar-width: none;  
    }

    .reels-feed-container::-webkit-scrollbar { 
        display: none; 
    }

    .reel-wrapper {
        width: 100%;
        height: 100%; /* Important: Must match parent for snap to work */
        scroll-snap-align: start;
        scroll-snap-stop: always;
        position: relative;
        background-color: #111;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .reel-video {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .video-placeholder {
        width: 100%;
        height: 100%;
        background-color: #222; /* Mock while unmounted */
    }

    .reel-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        padding: 20px;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0) 100%);
        pointer-events: none; /* Let clicks pass through to video */
    }

    .reel-info {
        flex: 1;
        color: white;
        margin-right: 20px;
    }

    .reel-title {
        font-family: var(--font-primary, sans-serif);
        font-size: 16px;
        font-weight: 500;
        margin: 0 0 10px 0;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.5);
    }

    .reel-actions {
        display: flex;
        flex-direction: column;
        gap: 20px;
        pointer-events: auto; /* Re-enable clicks on buttons */
    }

    .action-btn {
        background: transparent;
        border: none;
        color: white;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 5px;
        cursor: pointer;
    }

    .action-btn .icon {
        font-size: 28px;
        filter: drop-shadow(1px 1px 2px rgba(0,0,0,0.5));
    }

    .action-btn .count {
        font-size: 13px;
        font-weight: 500;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.5);
    }
</style>

@code {
    [Parameter]
    public string TradesmanId { get; set; } = string.Empty;

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    public class ReelModel
    {
        public string Id { get; set; } = "";
        public string VideoUrl { get; set; } = "";
        public string? MobileVideoUrl { get; set; }
        public string? ImageUrl { get; set; }
        public string Title { get; set; } = "";
    }

    private List<ReelModel> Reels = new();
    private int CurrentIndex = 0;
    private bool isLoading = true;
    private DotNetObjectReference<ReelsFeed>? _objRef;
    private bool _isJsInitialized = false;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        
        try
        {
            var result = await ApiClient.GetTradesmanProfiles.ExecuteAsync();
            if (result.Errors.Count == 0 && result.Data?.TradesmanProfiles != null)
            {
                var profile = result.Data.TradesmanProfiles.FirstOrDefault(p => p.User.Id.ToString() == TradesmanId || p.Id.ToString() == TradesmanId);
                if (profile?.Media != null)
                {
                    Reels = profile.Media.Select(m => new ReelModel
                    {
                        Id = m.Id.ToString(),
                        VideoUrl = m.VideoUrl,
                        MobileVideoUrl = m.MobileVideoUrl,
                        ImageUrl = m.ImageUrl,
                        Title = "Tradesman Portfolio"
                    }).ToList();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }
        finally
        {
            isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!isLoading && Reels.Any())
        {
            if (firstRender || !_isJsInitialized)
            {
                _objRef = DotNetObjectReference.Create(this);
                await JSRuntime.InvokeVoidAsync("reelsObserver.initialize", _objRef, "reels-feed-container");
                _isJsInitialized = true;
            }
            ObserveAll();
        }
    }

    private void ObserveAll()
    {
        if (!_isJsInitialized) return;
        
        foreach (var reel in Reels)
        {
            JSRuntime.InvokeVoidAsync("reelsObserver.observeVideo", reel.Id);
        }
    }

    [JSInvokable]
    public void OnVideoVisible(string videoId)
    {
        var newIndex = Reels.FindIndex(r => r.Id == videoId);
        if (newIndex != -1 && newIndex != CurrentIndex)
        {
            CurrentIndex = newIndex;
            InvokeAsync(StateHasChanged);
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo($"/tradesman-profile?TradesmanId={TradesmanId}");
    }

    public async ValueTask DisposeAsync()
    {
        if (_isJsInitialized)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("reelsObserver.dispose");
            }
            catch { /* Ignore if JS interop is already disconnected */ }
        }
        _objRef?.Dispose();
    }
}