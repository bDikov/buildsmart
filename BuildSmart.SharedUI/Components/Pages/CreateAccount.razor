@page "/create-account"
@using BuildSmart.SharedUI.ViewModels
@attribute [AllowAnonymous]
@layout BuildSmart.SharedUI.Components.Layout.BlankLayout
@inject CreateAccountPageViewModel ViewModel
@inject Microsoft.AspNetCore.Components.NavigationManager NavManager

<div class="register-container">
    <div class="register-card bs-card">
        
        <div class="logo-block">
            <div class="logo-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                </svg>
            </div>
            <span class="logo-text">BuildSmart</span>
        </div>

        <h2 class="register-title">@Loc["CreateAccount_Title"]</h2>

        <form @onsubmit="HandleSubmit" class="register-form">
            <div class="form-row">
                <div class="form-group flex-fill">
                    <label for="firstName" class="form-label">@Loc["CreateAccount_FirstName"]</label>
                    <input type="text" class="bs-input register-input" id="firstName" @bind="ViewModel.FirstName" />
                </div>

                <div class="form-group flex-fill">
                    <label for="lastName" class="form-label">@Loc["CreateAccount_LastName"]</label>
                    <input type="text" class="bs-input register-input" id="lastName" @bind="ViewModel.LastName" />
                </div>
            </div>

            <div class="form-group">
                <label for="email" class="form-label">@Loc["CreateAccount_Email"]</label>
                <input type="email" class="bs-input register-input" id="email" @bind="ViewModel.Email" />
            </div>

            <div class="form-group">
                <label for="phoneNumber" class="form-label">@Loc["CreateAccount_PhoneNumber"]</label>
                <input type="tel" class="bs-input register-input" id="phoneNumber" placeholder="e.g. 0888123456" @bind="ViewModel.PhoneNumber" />
            </div>

            <div class="form-group">
                <label for="password" class="form-label">@Loc["CreateAccount_Password"]</label>
                <input type="password" class="bs-input register-input" id="password" @bind="ViewModel.Password" />
            </div>

            <div class="form-checkbox-group">
                <input type="checkbox" class="bs-checkbox" id="agreeToTerms" @bind="ViewModel.AgreeToTerms" />
                <label for="agreeToTerms" class="checkbox-label">
                    @if (System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName.Equals("bg", StringComparison.OrdinalIgnoreCase))
                    {
                        <span>Съгласявам се с <a href="/terms" target="_blank" class="legal-link">Общите условия</a> и се запознах с <a href="/privacy" target="_blank" class="legal-link">Политиката за поверителност</a>.</span>
                    }
                    else
                    {
                        <span>I agree to the <a href="/terms" target="_blank" class="legal-link">Terms and Conditions</a> and acknowledge the <a href="/privacy" target="_blank" class="legal-link">Privacy Policy</a>.</span>
                    }
                </label>
            </div>

            <button class="bs-btn-primary register-btn w-100" type="submit">
                @Loc["CreateAccount_CreateButton"]
            </button>
            
            <div class="login-prompt">
                <span>@Loc["CreateAccount_AlreadyHaveAccount"] <a href="#" @onclick='() => NavManager.NavigateTo("/login")' @onclick:preventDefault>@Loc["CreateAccount_LogIn"]</a></span>
            </div>
        </form>

    </div>
</div>

<style>
    .register-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100dvh;
        background-color: var(--bg-page);
        font-family: var(--font-primary);
        margin: 0;
        padding: 0;
    }

    .register-card {
        width: 100%;
        max-width: 500px;
        padding: 40px;
        display: flex;
        flex-direction: column;
        gap: 25px;
        box-sizing: border-box;
    }

    .register-form {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .form-row {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    @@media (min-width: 481px) {
        .form-row {
            flex-direction: row;
        }
    }

    @@media (max-width: 480px) {
        .register-container {
            align-items: flex-start;
        }
        .register-card {
            min-height: 100dvh;
            padding: 20px 20px 40px 20px;
            justify-content: flex-start;
            border-radius: 0;
            border: none;
            box-shadow: none;
            margin: 0;
            max-width: 100%;
        }
        .register-title {
            margin-top: 0; /* Remove top margin since logo is there now */
        }
    }

    .logo-block {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin-bottom: 10px;
        margin-top: 10px;
    }

    .logo-icon {
        width: 40px;
        height: 40px;
        background-color: var(--text-primary);
        border-radius: 4px;
        display: flex;
        justify-content: center;
        align-items: center;
        color: var(--bg-card);
    }

    .logo-text {
        font-family: var(--font-heading);
        font-size: 24px;
        font-weight: 700;
        color: var(--text-primary);
        letter-spacing: -0.5px;
    }

    .register-title {
        color: var(--text-primary);
        font-size: 24px;
        font-weight: 600;
        margin: 0;
        text-align: center;
        font-family: var(--font-heading);
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .form-label {
        color: var(--text-primary);
        font-size: 14px;
        font-weight: 600;
        opacity: 0.9;
    }

    .register-input {
        height: 52px;
        padding: 0 15px;
    }

    .register-btn {
        height: 56px;
        font-weight: 600;
        font-size: 18px;
        margin-top: 10px;
    }

    .login-prompt {
        text-align: center;
        margin-top: 10px;
    }

    .login-prompt span {
        color: var(--text-primary);
        font-size: 15px;
        font-weight: 500;
    }

    .login-prompt a {
        color: var(--color-primary);
        font-weight: 600;
        text-decoration: none;
    }

    .login-prompt a:hover {
        text-decoration: underline;
    }

    .form-checkbox-group {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-top: 5px;
        margin-bottom: 5px;
    }

    .bs-checkbox {
        width: 18px;
        height: 18px;
        accent-color: var(--color-primary);
        cursor: pointer;
        border-radius: 4px;
        border: 1px solid var(--border-color);
        margin-top: 2px;
        flex-shrink: 0;
    }

    .checkbox-label {
        font-size: 14px;
        color: var(--text-primary);
        line-height: 1.4;
        cursor: pointer;
        user-select: none;
    }

    .legal-link {
        color: var(--color-primary);
        font-weight: 600;
        text-decoration: none;
    }

    .legal-link:hover {
        text-decoration: underline;
    }
</style>

@code {
    private async Task HandleSubmit()
    {
        await ViewModel.CreateAccountCommand.ExecuteAsync(null);
    }
}

