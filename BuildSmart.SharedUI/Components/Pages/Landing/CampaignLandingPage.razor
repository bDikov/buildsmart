@page "/remont-na-apartament-sofia"
@page "/remont-na-banya"
@page "/dovarshetelni-raboti"
@page "/el-i-vik-uslugi"
@page "/landing/{CampaignSlug}"
@attribute [AllowAnonymous]
@layout BuildSmart.SharedUI.Components.Layout.BlankLayout
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@using BuildSmart.SharedUI.GraphQL
@using System.Text.Json
@using BuildSmart.SharedUI.ViewModels
@using BuildSmart.SharedUI.Services
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<BuildSmart.SharedUI.Resources.AppResources> Loc
@inject BuildSmartApiClient ApiClient
@inject BuildSmart.SharedUI.Services.IAuthService AuthService
@inject FeedPageViewModel ViewModel

<PageTitle>@GetTitle() | BuildSmart.bg</PageTitle>

<HeadContent>
    <meta name="description" content="@GetMetaDescription()" />
    <meta name="keywords" content="@GetKeywords()" />
    <meta property="og:title" content="@GetTitle()" />
    <meta property="og:description" content="@GetMetaDescription()" />
    <meta property="og:type" content="website" />
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "HomeAndConstructionBusiness",
      "name": "BuildSmart Bulgaria",
      "description": "@GetMetaDescription()",
      "url": "https://buildsmart.bg",
      "telephone": "+359888888888",
      "address": {
        "@@type": "PostalAddress",
        "addressLocality": "Sofia",
        "addressCountry": "BG"
      },
      "priceRange": "$$",
      "areaServed": "Sofia",
      "knowsAbout": ["Ремонт на апартаменти", "Ремонт на баня", "Довършителни работи", "Шпакловка и боядисване", "Ел и ВиК услуги"]
    }
    </script>
</HeadContent>

<div class="interio-page-wrapper">
    <!-- Interio Navigation Bar -->
    <header class="interio-header">
        <div class="header-container">
            <a href="/" class="brand-logo" @onclick='() => NavManager.NavigateTo("/", forceLoad: true)' @onclick:preventDefault>
                <div class="logo-icon-emerald">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                    </svg>
                </div>
                <span class="logo-text">BuildSmart</span>
            </a>

            <nav class="header-nav d-none d-md-flex">
                <button type="button" class="nav-link border-0 bg-transparent" @onclick='() => ScrollToSection("process")'>@Loc["Lander_Nav_HowItWorks"]</button>
                <button type="button" class="nav-link border-0 bg-transparent" @onclick='() => ScrollToSection("why-us")'>@Loc["Lander_Nav_WhyUs"]</button>
                <button type="button" class="nav-link border-0 bg-transparent" @onclick='() => ScrollToSection("prices")'>@Loc["Lander_Nav_Pricing"]</button>
                <button type="button" class="nav-link border-0 bg-transparent" @onclick='() => ScrollToSection("guarantees")'>@Loc["Lander_Nav_Guarantees"]</button>
                <button type="button" class="nav-link border-0 bg-transparent" @onclick='() => ScrollToSection("proof")'>@Loc["Lander_Nav_Projects"]</button>
                <button type="button" class="nav-link border-0 bg-transparent" @onclick='() => ScrollToSection("faq")'>@Loc["Lander_Nav_Faq"]</button>
            </nav>

            <div class="header-actions">
                <div class="bs-lang-toggle-wrapper position-relative d-inline-block">
                    <button type="button" class="btn btn-sm d-flex align-items-center gap-1 border py-1.5 px-2.5 rounded-3" @onclick="ToggleLanguageDropdown" style="background: var(--bg-card-alt); border-color: var(--border-color) !important; color: var(--text-primary); font-size: 0.85rem; font-weight: 700;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="2" y1="12" x2="22" y2="12"></line>
                            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                        </svg>
                        <span>@(_currentCulture?.ToUpper() ?? "BG")</span>
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="transform: @(_isLangOpen ? "rotate(180deg)" : "rotate(0deg)"); transition: transform 0.2s ease;">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </button>
                    @if (_isLangOpen)
                    {
                        <div class="bs-lang-menu position-absolute end-0 mt-1 p-1 rounded-3 shadow-sm" style="background: var(--bg-card); border: 1px solid var(--border-color); min-width: 130px; z-index: 1050;">
                            <button type="button" class="w-100 border-0 bg-transparent text-start py-1.5 px-2 rounded d-flex align-items-center justify-content-between" @onclick='() => SwitchLanguageAsync("bg")' style="color: var(--text-primary); font-size: 0.85rem; font-weight: 600;">
                                <span>Български</span>
                                @if (_currentCulture == "bg") { <span>✓</span> }
                            </button>
                            <button type="button" class="w-100 border-0 bg-transparent text-start py-1.5 px-2 rounded d-flex align-items-center justify-content-between" @onclick='() => SwitchLanguageAsync("en")' style="color: var(--text-primary); font-size: 0.85rem; font-weight: 600;">
                                <span>English</span>
                                @if (_currentCulture == "en") { <span>✓</span> }
                            </button>
                        </div>
                    }
                </div>

                <button type="button" class="header-phone-btn d-none d-sm-inline-flex border-0" @onclick="CopyPhoneToClipboard" title="Копирай телефон">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                    </svg>
                    <span>@(_isPhoneCopied ? Loc["Lander_PhoneCopiedNotice"] : Loc["Support_PhoneNumber"])</span>
                </button>
                <button class="bs-btn-primary" @onclick="HandleHeroCtaClick">
                    <span>@Loc["Lander_Nav_AiCalculator"]</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Interio Split Hero Section -->
    <section class="interio-hero-section">
        <div class="hero-grid-container">
            <div class="hero-text-col">
                <div class="emerald-badge">
                    <span class="pulse-dot"></span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                    @Loc["Lander_OfficialOfferTag"]
                </div>
                <h1 class="hero-headline">@GetTitle()</h1>
                <p class="hero-subtext">@GetSubtitle()</p>

                <!-- Checkmark List -->
                <ul class="hero-check-list">
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>@Loc["Lander_HeroFeature1"]</span>
                    </li>
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>@Loc["Lander_HeroFeature2"]</span>
                    </li>
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>@Loc["Lander_HeroFeature3"]</span>
                    </li>
                </ul>

                <!-- Hero Action Buttons -->
                <div class="hero-cta-group">
                    <button class="bs-btn-primary py-3 px-4" @onclick="HandleHeroCtaClick">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                        </svg>
                        <span>@Loc["Lander_CalculateOnlineBtn"]</span>
                    </button>
                    <button type="button" class="interio-btn-secondary border-0" @onclick="CopyPhoneToClipboard">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                        </svg>
                        <span>@(_isPhoneCopied ? Loc["Lander_PhoneCopiedNotice"] : $"{Loc["MobileCRO_CallPrompt"]}: {Loc["Support_PhoneNumber"]}")</span>
                    </button>
                </div>
            </div>

            <!-- Interio Hero Showcase (Dynamic Hero Carousel with Backwards Compatibility) -->
            <div class="hero-img-col">
                <HeroCarousel Items="_carouselItems"
                              FallbackImageUrl="@GetHeroImageUrl()"
                              FallbackVideoUrl="@(_cmsPage?.HeroVideoUrl)"
                              RatingBadgeText="@Loc["Lander_RatingBadge"]" />
            </div>
        </div>
    </section>

    <!-- Trust Guarantee & Why Us Bar Integration -->
    <section id="why-us" class="interio-section-wrapper">
        <section id="guarantees">
            <TrustGuaranteeBar />
        </section>
    </section>

    <!-- Interio Emerald 3-Step Process Banner -->
    <section id="process" class="interio-process-banner">
        <div class="banner-container">
            <div class="process-header">
                <h2>@Loc["Lander_ProcessTitle"]</h2>
                <p>@Loc["Lander_ProcessSubtitle"]</p>
            </div>

            <div class="process-grid">
                <div class="process-card">
                    <div class="step-num">01</div>
                    <h3>@Loc["Lander_Step1Title"]</h3>
                    <p>@Loc["Lander_Step1Desc"]</p>
                </div>
                <div class="process-card">
                    <div class="step-num">02</div>
                    <h3>@Loc["Lander_Step2Title"]</h3>
                    <p>@Loc["Lander_Step2Desc"]</p>
                </div>
                <div class="process-card">
                    <div class="step-num">03</div>
                    <h3>@Loc["Lander_Step3Title"]</h3>
                    <p>@Loc["Lander_Step3Desc"]</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Real Project Portfolio Section (Dynamically Bound to CMS Showcase Gallery) -->
    <section id="proof" class="interio-section-wrapper proof-section">
        <div class="section-title-box">
            <h2>@Loc["Lander_PortfolioTitle"]</h2>
            <p>@Loc["Lander_PortfolioSubtitle"]</p>
        </div>

        <div class="portfolio-grid">
            @if (_galleryItems.Any())
            {
                @for (int gIdx = 0; gIdx < _galleryItems.Count; gIdx++)
                {
                    var mediaIndex = gIdx;
                    var media = _galleryItems[mediaIndex];
                    <div class="portfolio-card">
                        <div class="card-img-wrapper" @onclick="() => OpenGalleryLightbox(mediaIndex)" style="cursor: pointer;" title="Click to view full size">
                            @if (media.Type == "video")
                            {
                                <video src="@media.Url" playsinline preload="metadata" class="portfolio-img"></video>
                                <span class="portfolio-tag video-tag">VIDEO</span>
                            }
                            else
                            {
                                <img src="@media.Url" alt="@media.CaptionBg" class="portfolio-img" />
                                <span class="portfolio-tag">@Loc["Lander_Nav_Projects"] 2026</span>
                            }
                            <div class="portfolio-expand-badge">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path>
                                </svg>
                            </div>
                        </div>
                        <div class="card-content">
                            @if (!string.IsNullOrEmpty(media.LocationBg))
                            {
                                <div class="card-location">@media.LocationBg</div>
                            }
                            <h3>@(string.IsNullOrEmpty(media.CaptionBg) ? Loc["Lander_Nav_Projects"] : media.CaptionBg)</h3>
                            @if (!string.IsNullOrEmpty(media.DurationBg) || !string.IsNullOrEmpty(media.BudgetBg))
                            {
                                <div class="card-meta">
                                    @if (!string.IsNullOrEmpty(media.DurationBg))
                                    {
                                        <div class="meta-item"><strong>@Loc["Offer_TimelineLabel"]:</strong> @media.DurationBg</div>
                                    }
                                    @if (!string.IsNullOrEmpty(media.BudgetBg))
                                    {
                                        <div class="meta-item price"><strong>@Loc["Offers_EstPrice"]:</strong> @media.BudgetBg</div>
                                    }
                                </div>
                            }
                            <button class="bs-btn-primary card-btn" @onclick="HandleCreateProjectClick">@Loc["Lander_SeeSimilarOffer"]</button>
                        </div>
                    </div>
                }
            }
            else
            {
                <!-- Default Fallback Cards -->
                <div class="portfolio-card">
                    <div class="card-img-wrapper">
                        <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=800&q=80" alt="Full apartment renovation" class="portfolio-img" />
                        <span class="portfolio-tag">2026</span>
                    </div>
                    <div class="card-content">
                        <div class="card-location">София, кв. Манастирски Ливади</div>
                        <h3>Цялостен ремонт на тристаен апартамент (88 кв.м)</h3>
                        <div class="card-meta">
                            <div class="meta-item"><strong>@Loc["Offer_TimelineLabel"]:</strong> 42 работни дни</div>
                            <div class="meta-item price"><strong>@Loc["Offers_EstPrice"]:</strong> 34,800 лв. (€17,793)</div>
                        </div>
                        <button class="bs-btn-primary card-btn" @onclick="HandleCreateProjectClick">@Loc["Lander_SeeSimilarOffer"]</button>
                    </div>
                </div>

                <div class="portfolio-card">
                    <div class="card-img-wrapper">
                        <img src="https://images.unsplash.com/photo-1584622650111-993a426fbf0a?auto=format&fit=crop&w=800&q=80" alt="Luxury bathroom renovation" class="portfolio-img" />
                        <span class="portfolio-tag">2026</span>
                    </div>
                    <div class="card-content">
                        <div class="card-location">София, кв. Лозенец</div>
                        <h3>Модерен ремонт на баня с крупноформатен гранитогрес (6 кв.м)</h3>
                        <div class="card-meta">
                            <div class="meta-item"><strong>@Loc["Offer_TimelineLabel"]:</strong> 11 работни дни</div>
                            <div class="meta-item price"><strong>@Loc["Offers_EstPrice"]:</strong> 7,450 лв. (€3,809)</div>
                        </div>
                        <button class="bs-btn-primary card-btn" @onclick="HandleCreateProjectClick">@Loc["Lander_SeeSimilarOffer"]</button>
                    </div>
                </div>

                <div class="portfolio-card">
                    <div class="card-img-wrapper">
                        <img src="https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&w=800&q=80" alt="Finishing works" class="portfolio-img" />
                        <span class="portfolio-tag">2026</span>
                    </div>
                    <div class="card-content">
                        <div class="card-location">София, кв. Младост 4</div>
                        <h3>Шпакловка, боядисване и гипсокартон на нов апартамент (65 кв.м)</h3>
                        <div class="card-meta">
                            <div class="meta-item"><strong>@Loc["Offer_TimelineLabel"]:</strong> 18 работни дни</div>
                            <div class="meta-item price"><strong>@Loc["Offers_EstPrice"]:</strong> 14,200 лв. (€7,260)</div>
                        </div>
                        <button class="bs-btn-primary card-btn" @onclick="HandleCreateProjectClick">@Loc["Lander_SeeSimilarOffer"]</button>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Interactive SEO Price Table Section -->
    <section id="prices" class="interio-section-wrapper">
        <SeoPriceTable SelectedCategory="@GetCategoryFilter()" />
    </section>

    <!-- Financing CTA Banner -->
    <section class="interio-cta-banner">
        <div class="cta-banner-content">
            <h2>@Loc["Lander_FinancingTitle"]</h2>
            <p>@Loc["Lander_FinancingSub"]</p>
            <button class="bs-btn-primary cta-banner-btn py-3 px-5" @onclick="HandleCreateProjectClick">@Loc["Lander_CalculateNowBtn"]</button>
        </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="interio-section-wrapper faq-section">
        <div class="section-title-box">
            <h2>@Loc["Lander_FaqTitle"]</h2>
            <p>@Loc["Lander_FaqSubtitle"]</p>
        </div>
        <div class="faq-accordion-grid">
            <div class="faq-card shadow-sm">
                <h3>@Loc["Lander_FaqQ1"]</h3>
                <p>@Loc["Lander_FaqA1"]</p>
            </div>
            <div class="faq-card shadow-sm">
                <h3>@Loc["Lander_FaqQ2"]</h3>
                <p>@Loc["Lander_FaqA2"]</p>
            </div>
            <div class="faq-card shadow-sm">
                <h3>@Loc["Lander_FaqQ3"]</h3>
                <p>@Loc["Lander_FaqA3"]</p>
            </div>
            <div class="faq-card shadow-sm">
                <h3>@Loc["Lander_FaqQ4"]</h3>
                <p>@Loc["Lander_FaqA4"]</p>
            </div>
        </div>
    </section>

    <!-- Interio Footer -->
    <footer class="interio-footer">
        <div class="footer-container">
            <div class="footer-col brand-col">
                <div class="brand-logo">
                    <div class="logo-icon-emerald small">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                        </svg>
                    </div>
                    <span class="logo-text">BuildSmart</span>
                </div>
                <p class="footer-desc">@Loc["Lander_FooterDesc"]</p>
            </div>

            <div class="footer-col">
                <h4>@Loc["Lander_FooterServices"]</h4>
                <ul>
                    <li><a href="/remont-na-apartament-sofia" @onclick='() => NavManager.NavigateTo("/remont-na-apartament-sofia", forceLoad: true)' @onclick:preventDefault>@Loc["Lander_Nav_Projects"]</a></li>
                    <li><a href="/remont-na-banya" @onclick='() => NavManager.NavigateTo("/remont-na-banya", forceLoad: true)' @onclick:preventDefault>@Loc["Lander_Nav_Pricing"]</a></li>
                    <li><a href="/dovarshetelni-raboti" @onclick='() => NavManager.NavigateTo("/dovarshetelni-raboti", forceLoad: true)' @onclick:preventDefault>@Loc["Lander_Nav_Guarantees"]</a></li>
                    <li><a href="/el-i-vik-uslugi" @onclick='() => NavManager.NavigateTo("/el-i-vik-uslugi", forceLoad: true)' @onclick:preventDefault>@Loc["Lander_Nav_HowItWorks"]</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>@Loc["Lander_FooterContacts"]</h4>
                <ul>
                    <li>София, България</li>
                    <li>Тел: @Loc["Support_PhoneNumber"]</li>
                    <li>Email: info@buildsmart.bg</li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            <p>&copy; @DateTime.Now.Year BuildSmart Bulgaria. @Loc["Lander_FooterRights"]</p>
        </div>
    </footer>

    <!-- Auth Prompt Confirmation Modal (Feed Style) -->
    <BsConfirmationModal IsVisible="_showAuthModal"
                         Title="@Loc["Feed_AuthAlert_Title"]"
                         Message="@Loc["Feed_AuthAlert_Message"]"
                         AcceptText="@Loc["Feed_AuthAlert_Accept"]"
                         CancelText="@Loc["Feed_AuthAlert_Cancel"]"
                         OnConfirmationChanged="OnAuthConfirmationChanged" />

    <!-- Global Exit Intent Lead Capture Modal -->
    <ExitIntentModal />

    <!-- GALLERY FULLSCREEN LIGHTBOX MODAL -->
    @if (_isGalleryLightboxOpen && _galleryItems.Count > 0)
    {
        var currentItem = _galleryItems[Math.Clamp(_galleryLightboxIndex, 0, _galleryItems.Count - 1)];
        var isVid = string.Equals(currentItem.Type, "video", StringComparison.OrdinalIgnoreCase);
        var caption = IsEnglish ? (!string.IsNullOrEmpty(currentItem.CaptionEn) ? currentItem.CaptionEn : currentItem.CaptionBg) : currentItem.CaptionBg;

        <div class="hero-lightbox-backdrop" @onclick="CloseGalleryLightbox">
            <div class="hero-lightbox-header" @onclick:stopPropagation="true">
                <div class="lightbox-info-group">
                    @if (_galleryItems.Count > 1)
                    {
                        <span class="lightbox-counter">@(_galleryLightboxIndex + 1) / @_galleryItems.Count</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(caption))
                    {
                        <span class="lightbox-title">@caption</span>
                    }
                </div>
                <button type="button" class="lightbox-close-btn" @onclick="CloseGalleryLightbox" aria-label="Exit full size">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <div class="hero-lightbox-body">
                @if (_galleryItems.Count > 1)
                {
                    <button type="button" class="lightbox-arrow-btn prev-arrow" @onclick="PrevGalleryLightbox" @onclick:stopPropagation="true" aria-label="Previous">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                    </button>
                }

                <div class="lightbox-media-container" @onclick:stopPropagation="true">
                    @if (isVid)
                    {
                        <video src="@currentItem.Url"
                               controls
                               autoplay
                               playsinline
                               class="lightbox-media-element" />
                    }
                    else
                    {
                        <img src="@currentItem.Url"
                             alt="@(caption ?? "Full size preview")"
                             class="lightbox-media-element" />
                    }
                </div>

                @if (_galleryItems.Count > 1)
                {
                    <button type="button" class="lightbox-arrow-btn next-arrow" @onclick="NextGalleryLightbox" @onclick:stopPropagation="true" aria-label="Next">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </button>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(caption))
            {
                <div class="hero-lightbox-caption-bar" @onclick:stopPropagation="true">
