    private LandingPageCopyRule? _activeRule;
    private bool _isGuest = true;
    private bool _showAuthModal = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (ViewModel != null)
            {
                await ViewModel.LoadFeedCommand.ExecuteAsync(null);
            }
            _isGuest = AuthService == null || !AuthService.IsAuthenticated || await CheckIsGuestAsync();
        }
        catch { }
    }

    private void ResolveActiveCopyRule()
    {
        _activeRule = null;
        if (!BuildSmart.SharedUI.ApiConfig.LandingPage_EnableDynamicTitles) return;

        try
        {
            var json = Loc["LandingPage_CopywritingRules"];
            var rules = LandingPageRuleEvaluator.ParseRules(json);
            bool hasProjectsVal = ViewModel?.HasProjects == true;
            bool hasDraftVal = ViewModel?.LatestDraftProjectId.HasValue == true;
            bool hasActiveVal = ViewModel?.LatestActiveProjectId.HasValue == true;

            foreach (var rule in rules)
            {
                if (LandingPageRuleEvaluator.EvaluateCondition(
                    rule.Condition, 
                    _isGuest, 
                    hasProjectsVal, 
                    ViewModel?.IsTradesman == true, 
                    ViewModel?.IsHomeowner == true,
                    hasDraftVal,
                    hasActiveVal))
                {
                    _activeRule = rule;
                    break;
                }
            }
        }
        catch { }
    }

    private void HandleHeroCtaClick()
    {
        ResolveActiveCopyRule();

        if (_activeRule != null && !string.IsNullOrEmpty(_activeRule.CtaAction) && !_isGuest && !_activeRule.CtaAction.Contains("/job-wizard") && !_activeRule.CtaAction.Contains("/create-account"))
        {
            var route = _activeRule.CtaAction;
            if (route.Contains("{DraftProjectId}"))
            {
                route = route.Replace("{DraftProjectId}", ViewModel?.LatestDraftProjectId?.ToString() ?? string.Empty);
            }
            if (route.Contains("{ActiveProjectId}"))
            {
                route = route.Replace("{ActiveProjectId}", ViewModel?.LatestActiveProjectId?.ToString() ?? string.Empty);
            }

            NavManager.NavigateTo(route);
        }
        else
        {
            NavigateToWizard();
        }
    }

