        try
        {
            await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('{elementId}')?.scrollIntoView({{ behavior: 'smooth', block: 'start' }})");
        }
        catch { }
    }

    private async Task CopyPhoneToClipboard()
    {
        try
        {
            var number = Loc["Support_PhoneNumber"].Value;
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", number);
            _isPhoneCopied = true;
            StateHasChanged();
            await Task.Delay(3000);
            _isPhoneCopied = false;
            StateHasChanged();
        }
        catch { }
    }

    private void NavigateToEstimator()
    {
        HandleHeroCtaClick();
    }
}
