    private string _currentCulture => System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    private bool _isLangOpen = false;

    private void ToggleLanguageDropdown() => _isLangOpen = !_isLangOpen;

    private async Task SwitchLanguageAsync(string lang)
    {
        _isLangOpen = false;
        if (_currentCulture == lang) return;

        try
        {
            var cookieValue = $"c={lang}|uic={lang}";
            await JSRuntime.InvokeVoidAsync("setCookie", ".AspNetCore.Culture", cookieValue, 365);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "preferred_language", lang);

            var culture = new System.Globalization.CultureInfo(lang);
            System.Globalization.CultureInfo.CurrentCulture = culture;
            System.Globalization.CultureInfo.CurrentUICulture = culture;

            if (AuthService != null && AuthService.IsAuthenticated)
            {
                try { await ApiClient.UpdateUserLanguage.ExecuteAsync(lang); } catch { }
            }
        }
        catch { }

        NavManager.NavigateTo(NavManager.Uri, forceLoad: true);
    }
