                    _isGuest, 
                    hasProjectsVal, 
                    ViewModel?.IsTradesman == true, 
                    ViewModel?.IsHomeowner == true,
                    hasDraftVal,
                    hasActiveVal))
                {
                    _activeRule = rule;
                    break;
