            if (targetSlug.StartsWith("landing/"))
            {
                targetSlug = CampaignSlug ?? targetSlug.Replace("landing/", "");
            }

            var res = await ApiClient.GetLandingPageBySlug.ExecuteAsync(targetSlug);
            if (res.Errors.Count == 0 && res.Data?.LandingPageBySlug != null)
            {
                _cmsPage = res.Data.LandingPageBySlug;
                
                if (!string.IsNullOrEmpty(_cmsPage.MediaGalleryJson))
                {
                    try
                    {
                        var jsonOptions = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                        var allMedia = JsonSerializer.Deserialize<List<MediaGalleryItemModel>>(_cmsPage.MediaGalleryJson, jsonOptions) ?? new();
                        _galleryItems = allMedia.Where(m => !string.Equals(m.Section, "hero", StringComparison.OrdinalIgnoreCase)).ToList();
                        _carouselItems = allMedia.Where(m => string.Equals(m.Section, "hero", StringComparison.OrdinalIgnoreCase)).Select(m => new HeroCarousel.HeroCarouselItemModel
                        {
                            Url = m.Url,
                            Type = string.IsNullOrWhiteSpace(m.Type) ? (m.Url.EndsWith(".mp4", StringComparison.OrdinalIgnoreCase) || m.Url.EndsWith(".webm", StringComparison.OrdinalIgnoreCase) ? "video" : "image") : m.Type,
                            CaptionBg = m.CaptionBg,
                            CaptionEn = m.CaptionEn,
                            Order = m.Order
                        }).ToList();
                    }
                    catch
                    {
                        _galleryItems = new();
                        _carouselItems = new();
                    }
                }
                else
                {
                    _galleryItems = new();
                    _carouselItems = new();
                }
            }
        }
        catch
        {
            // Silently fall back to default resource content
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var currentUrl = NavManager.Uri;
                await JSRuntime.InvokeVoidAsync("posthog.capture", "campaign_landing_viewed", new
                {
                    slug = GetSlug(),
                    url = currentUrl
                });
            }
            catch
            {
                // Silently ignore JS analytics interop errors
            }
        }
    }

    private string GetSlug()
    {
        var relativePath = NavManager.ToBaseRelativePath(NavManager.Uri).ToLowerInvariant();
        if (relativePath.Contains("remont-na-apartament-sofia")) return "apartment-sofia";
        if (relativePath.Contains("remont-na-banya")) return "bathroom-sofia";
        if (relativePath.Contains("dovarshetelni-raboti")) return "finishing-sofia";
        if (relativePath.Contains("el-i-vik-uslugi")) return "mep-sofia";
        return CampaignSlug?.ToLowerInvariant() ?? "general";
    }

