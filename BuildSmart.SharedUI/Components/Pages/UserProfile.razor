@page "/user-profile"
@using BuildSmart.SharedUI.ViewModels
@using BuildSmart.SharedUI.Components
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<BuildSmart.SharedUI.Resources.AppResources> Loc
@inject UserProfileViewModel ViewModel
@using BuildSmart.SharedUI.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject INavigationBridge NavigationBridge
@inject BuildSmart.SharedUI.GraphQL.State.BuildSmartApiClientStoreAccessor StoreAccessor

<div class="profile-page-container">
	<div class="header-section">
		<h2 class="page-title">@Loc["UserProfile_PageTitle"]</h2>
	</div>

	@if (ViewModel.IsBusy && string.IsNullOrEmpty(ViewModel.FirstName))
	{
		<div class="loading-state">
			<p>@Loc["UserProfile_Loading"]</p>
		</div>
	}
	else
	{
		<div class="profile-layout">
			<!-- The beautiful Profile Card we generated from Figma -->
			<div class="profile-sidebar">
			    <ProfileCard ViewModel="ViewModel" OnEditProfileClicked="OpenEditModal" OnMoreClicked="OpenSettingsModal" />
			    
			    <div class="legal-policies-card bs-card">
			        <h4 class="legal-card-title">@Loc["Profile_LegalSectionTitle"]</h4>
			        <div class="legal-card-links">
			            <a href="/terms" class="legal-card-link">
			                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
			                    <polyline points="14 2 14 8 20 8"></polyline>
			                    <line x1="16" y1="13" x2="8" y2="13"></line>
			                    <line x1="16" y1="17" x2="8" y2="17"></line>
			                    <polyline points="10 9 9 9 8 9"></polyline>
			                </svg>
			                <span>@Loc["Profile_TermsLink"]</span>
			            </a>
			            <a href="/privacy" class="legal-card-link">
			                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
			                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
			                </svg>
			                <span>@Loc["Profile_PrivacyLink"]</span>
			            </a>
			            
			            <button type="button" class="legal-card-link logout-link-mobile" @onclick="ShowLogoutConfirmation" style="background: var(--bg-card-alt); border: 1px solid var(--border-color); width: 100%; text-align: left; cursor: pointer; box-sizing: border-box; font-family: inherit;">
			                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="rgb(255, 107, 107)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
			                    <polyline points="16 17 21 12 16 7"></polyline>
			                    <line x1="21" y1="12" x2="9" y2="12"></line>
			                </svg>
			                <span style="color: rgb(255, 107, 107); font-weight: bold;">@(System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "bg" ? "Изход" : "Log Out")</span>
			            </button>
			        </div>
			    </div>
			</div>
		</div>

		<!-- Edit Details Modal -->
		@if (_showEditModal)
		{
			<div class="modal-overlay" @onclick="CloseEditModal">
				<div class="modal-content bs-card" @onclick:stopPropagation="true">
					<div class="modal-header">
						<h3>@Loc["UserProfile_EditDetails"]</h3>
						<button class="close-btn" @onclick="CloseEditModal">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M18 6L6 18M6 6l12 12" />
							</svg>
						</button>
					</div>

					<div class="modal-body">
						<div class="form-group">
							<label>@Loc["UserProfile_Email"]</label>
							<input class="bs-input" type="email" value="@ViewModel.Email" readonly />
						</div>
						<div class="form-group">
							<label>@Loc["UserProfile_PhoneNumber"]</label>
							<input class="bs-input" type="tel" @bind="ViewModel.PhoneNumber" />
						</div>
						<div class="form-group">
							<label>@Loc["UserProfile_Location"]</label>
							<input class="bs-input" @bind="ViewModel.Location" />
						</div>

						<div class="modal-actions">
							<button class="bs-btn-primary w-100" @onclick="SaveAndCloseModal">
								@Loc["UserProfile_SaveChanges"]
							</button>
						</div>
					</div>
				</div>
			</div>
		}

		<!-- Settings Modal -->
		@if (_showSettingsModal)
		{
			<div class="modal-overlay" @onclick="CloseSettingsModal">
				<div class="modal-content settings-modal-content" @onclick:stopPropagation="true">
					<ProfileSettingsMenu />
				</div>
			</div>
		}
	}
	<!-- Logout Confirmation Modal -->
	<BsConfirmationModal IsVisible="_showLogoutModal"
						 Title="@Loc["MainLayout_LogoutAlert_Title"]"
						 Message="@Loc["MainLayout_LogoutAlert_Message"]"
						 AcceptText="@Loc["MainLayout_LogoutAlert_Accept"]"
						 CancelText="@Loc["MainLayout_LogoutAlert_Cancel"]"
						 OnConfirmationChanged="OnLogoutConfirmationChanged" />
</div>

<style>
	.profile-page-container {
		padding: 40px 20px;
		font-family: var(--font-primary);
		max-width: 1000px;
		margin: 0 auto;
	}

	.header-section {
		margin-bottom: 40px;
		text-align: center;
	}

	.page-title {
		font-family: var(--font-heading);
		color: var(--text-primary);
		font-size: 32px;
		margin: 0;
	}

	.loading-state {
		text-align: center;
		padding: 50px 20px;
	}

	.profile-layout {
		display: flex;
		justify-content: center;
		gap: 40px;
		align-items: start;
		flex-wrap: wrap;
	}

	/* Modal Styles */
	.modal-overlay {
		position: fixed;
		top: 0;
		left: 0;
		width: 100vw;
		height: 100vh;
		background-color: rgba(0, 0, 0, 0.6);
		display: flex;
		justify-content: center;
		align-items: center;
		z-index: 1000;
		backdrop-filter: blur(4px);
	}

	.modal-content {
		width: 100%;
		max-width: 480px;
		max-height: 90vh; /* Keeps the modal within the viewport */
		overflow-y: auto; /* Adds scrolling for small screens */
		padding: 32px;
		display: flex;
		flex-direction: column;
		gap: 20px;
		box-sizing: border-box;
	}

	.settings-modal-content {
		background: transparent;
		box-shadow: none;
		align-items: center;
		padding: 0;
		max-width: 380px;
	}

	.modal-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 10px;
	}

		.modal-header h3 {
			margin: 0;
			font-size: 24px;
			color: var(--text-primary);
		}

	.close-btn {
		background: transparent;
		border: none;
		color: var(--text-secondary);
		cursor: pointer;
		padding: 4px;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: color 0.2s ease;
	}

		.close-btn:hover {
			color: var(--color-primary);
		}

	.modal-body {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

		.form-group label {
			color: var(--text-secondary);
			font-weight: 500;
			font-size: 14px;
		}

	.modal-actions {
		display: flex;
		flex-direction: column;
		gap: 12px;
		margin-top: 15px;
	}

	.w-100 {
		width: 100%;
	}

	.profile-sidebar {
		display: flex;
		flex-direction: column;
		gap: 24px;
		width: 100%;
		max-width: 540px;
		align-items: center;
	}

	.legal-policies-card {
		width: 100%;
		padding: 24px 30px;
		box-sizing: border-box;
		border-radius: 24px;
		background-color: var(--bg-card);
		border: 1px solid var(--border-color);
		box-shadow: var(--shadow-main);
		display: flex;
		flex-direction: column;
		gap: 16px;
		transition: background-color 0.3s ease, box-shadow 0.3s ease;
	}

	.legal-card-title {
		font-family: var(--font-heading);
		font-size: 18px;
		font-weight: 700;
		color: var(--text-primary);
		margin: 0;
	}

	.legal-card-links {
		display: flex;
		flex-direction: column;
		gap: 12px;
		width: 100%;
	}

	.legal-card-link {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 12px 16px;
		border-radius: 12px;
		background-color: var(--bg-card-alt);
		border: 1px solid var(--border-color);
		color: var(--text-primary);
		font-size: 15px;
		font-weight: 600;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.legal-card-link:hover {
		background-color: var(--bg-page);
		transform: translateX(4px);
		box-shadow: var(--elevation-01dp);
	}

	.legal-card-link svg {
		color: var(--text-secondary);
		opacity: 0.8;
	}

	.logout-link-mobile {
		display: none;
	}

	@@media (max-width: 992px) {
		.logout-link-mobile {
			display: flex !important;
		}
	}
</style>

@code {
	private bool _showEditModal = false;
	private bool _showSettingsModal = false;

	protected override async Task OnInitializedAsync()
	{
		if (string.IsNullOrEmpty(ViewModel.FirstName))
		{
			// Execute the load command if data isn't present
			await ViewModel.LoadProfileCommand.ExecuteAsync(null);
		}
	}

	private void OpenEditModal()
	{
		_showEditModal = true;
	}

	private void CloseEditModal()
	{
		_showEditModal = false;
	}

	private void OpenSettingsModal()
	{
		_showSettingsModal = true;
	}

	private void CloseSettingsModal()
	{
		_showSettingsModal = false;
	}

	private async Task SaveAndCloseModal()
	{
		await ViewModel.SaveProfileCommand.ExecuteAsync(null);
		_showEditModal = false;
	}

	private bool _showLogoutModal = false;

	private void ShowLogoutConfirmation()
	{
		_showLogoutModal = true;
	}

	private async Task OnLogoutConfirmationChanged(bool confirmed)
	{
		_showLogoutModal = false;
		if (confirmed)
		{
			await LogoutAsync();
		}
	}

	private async Task LogoutAsync()
	{
		try 
		{ 
			StoreAccessor.OperationStore.Clear(); 
		} 
		catch { }

		await AuthService.ClearTokenAsync();
		
		if (AuthStateProvider is MauiAuthenticationStateProvider mauiProvider)
		{
			mauiProvider.NotifyAuthenticationStateChanged();
		}
		
		await BuildSmart.SharedUI.MauiMocks.MainThread.InvokeOnMainThreadAsync(() =>
		{
			NavigationBridge.NavigateToAsync("//LoginPage");
		});
	}
}
