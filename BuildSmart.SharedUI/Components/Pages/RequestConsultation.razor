@page "/request-consultation"
@using BuildSmart.SharedUI.GraphQL
@using BuildSmart.SharedUI.Services
@using Microsoft.Extensions.Localization
@layout BuildSmart.SharedUI.Components.Layout.MainLayout
@inject IBuildSmartApiClient ApiClient
@inject NavigationManager NavManager
@inject IStringLocalizer<BuildSmart.SharedUI.Resources.AppResources> Loc

<div class="container py-4">
    <div class="request-consultation-container">
        @if (IsLoading && Project == null)
        {
            <div class="d-flex justify-content-center align-items-center" style="min-height: 300px;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">@Loc["ProjectDetail_Loading"]</span>
                </div>
            </div>
        }
        else if (IsSuccess)
        {
            <div class="bs-card success-container p-5" style="border-radius: 16px; border-top: 4px solid var(--color-success);">
                <div class="success-icon-wrapper">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </div>
                <h2 class="h3 fw-bold mb-3" style="color: var(--text-primary);">@Loc["Consultation_SuccessTitle"]</h2>
                <p class="mb-4 text-muted" style="max-width: 480px; font-size: 1.05rem; line-height: 1.6;">
                    @Loc["Consultation_SuccessDesc"]
                </p>
                
                <div class="mb-5 p-3 text-start w-100" style="background-color: var(--bg-card-alt); border-radius: 12px; border: 1px solid var(--border-color);">
                    <div class="mb-2" style="font-size: 0.95rem;">
                        <span class="text-muted">@Loc["Consultation_Date"]:</span> 
                        <strong class="ms-1" style="color: var(--text-primary);">@PreferredDate.ToString("dd.MM.yyyy")</strong>
                    </div>
                    <div class="mb-2" style="font-size: 0.95rem;">
                        <span class="text-muted">@Loc["Consultation_TimeSlot"]:</span> 
                        <strong class="ms-1" style="color: var(--text-primary);">
                            @(SelectedTimeSlot == "Morning" ? Loc["Consultation_Morning"] : SelectedTimeSlot == "Afternoon" ? Loc["Consultation_Afternoon"] : Loc["Consultation_LateAfternoon"])
                        </strong>
                    </div>
                    <div class="mb-2" style="font-size: 0.95rem;">
                        <span class="text-muted">@Loc["Consultation_ContactMethod"]:</span> 
                        <strong class="ms-1" style="color: var(--text-primary);">
                            @(SelectedContactMethod == "Phone" ? Loc["Consultation_Phone"] : SelectedContactMethod == "Video" ? Loc["Consultation_Video"] : Loc["Consultation_Email"])
                        </strong>
                        @if ((SelectedContactMethod == "Phone" || SelectedContactMethod == "Video") && !string.IsNullOrEmpty(PhoneNumber))
                        {
                            <span class="text-muted ms-2">(@PhoneNumber)</span>
                        }
                    </div>
                    <div class="mb-0" style="font-size: 0.95rem;">
                        <span class="text-muted">@Loc["Consultation_Address"]:</span> 
                        <strong class="ms-1" style="color: var(--text-primary);">@(string.IsNullOrWhiteSpace(Address) ? "-" : Address)</strong>
                    </div>
                </div>
                
                <button class="bs-btn-primary px-5 py-2 fw-bold" @onclick="GoBackToProject">
                    @Loc["Consultation_SuccessBtn"]
                </button>
            </div>
        }
        else
        {
            <!-- Header -->
            <div class="mb-4 d-flex align-items-center gap-3">
                <button class="back-btn" @onclick="GoBackToProject" style="background: transparent; border: none; padding: 0; color: var(--text-primary); cursor: pointer;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                </button>
                <div>
                    <h2 class="h3 fw-bold mb-1" style="color: var(--text-primary);">@Loc["Consultation_Title"]</h2>
                    <p class="text-muted mb-0" style="font-size: 0.95rem;">@Loc["Consultation_Subtitle"]</p>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger mb-4">
                    @ErrorMessage
                </div>
            }

            @if (Project != null)
            {
                <div class="bs-card p-4 mb-4" style="border-radius: 12px; background-color: var(--bg-card);">
                    <div class="mb-4">
                        <span class="text-muted uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Проект</span>
                        <h3 class="h4 fw-bold mt-1 mb-2" style="color: var(--text-primary);">@Project.Title</h3>
                        @if (Project.JobPosts != null && Project.JobPosts.Any())
                        {
                            <div class="d-flex flex-wrap gap-2 mt-2">
                                @foreach (var job in Project.JobPosts)
                                {
                                    <span class="badge bg-light text-dark border px-3 py-2" style="font-size: 0.85rem; border-radius: 8px;">
                                        @job.ServiceCategory.Name
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    <hr style="border-color: var(--border-color); opacity: 0.5;" />

                    <!-- Form -->
                    <div class="mt-4">
                        <!-- Date -->
                        <div class="mb-4">
                            <label class="form-label fw-bold mb-2" style="color: var(--text-primary); font-size: 0.95rem;">@Loc["Consultation_Date"]</label>
                            <input type="date" class="form-control bs-input" @bind="PreferredDate" min="@MinDate.ToString("yyyy-MM-dd")" style="border-radius: 8px; font-size: 1rem; padding: 10px 14px;" />
                        </div>

                        <!-- Time Slot -->
                        <div class="mb-4">
                            <label class="form-label fw-bold mb-2" style="color: var(--text-primary); font-size: 0.95rem;">@Loc["Consultation_TimeSlot"]</label>
                            <div class="slots-grid">
                                <div class="slot-pill @(SelectedTimeSlot == "Morning" ? "active" : "")" @onclick='() => SelectedTimeSlot = "Morning"'>
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
                                        <circle cx="12" cy="12" r="4"></circle>
                                    </svg>
                                    <span>@Loc["Consultation_Morning"]</span>
                                </div>
                                <div class="slot-pill @(SelectedTimeSlot == "Afternoon" ? "active" : "")" @onclick='() => SelectedTimeSlot = "Afternoon"'>
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
                                        <path d="M12 8a4 4 0 1 1 0 8 4 4 0 0 1 0-8z"></path>
                                    </svg>
                                    <span>@Loc["Consultation_Afternoon"]</span>
                                </div>
                                <div class="slot-pill @(SelectedTimeSlot == "LateAfternoon" ? "active" : "")" @onclick='() => SelectedTimeSlot = "LateAfternoon"'>
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M17 18a5 5 0 0 0-10 0"></path>
                                        <line x1="12" y1="9" x2="12" y2="2"></line>
                                        <line x1="4.22" y1="10.22" x2="5.64" y2="11.64"></line>
                                        <line x1="1" y1="18" x2="3" y2="18"></line>
                                        <line x1="21" y1="18" x2="23" y2="18"></line>
                                        <line x1="18.36" y1="11.64" x2="19.78" y2="10.22"></line>
                                        <line x1="23" y1="22" x2="1" y2="22"></line>
                                        <polyline points="8 6 12 2 16 6"></polyline>
                                    </svg>
                                    <span>@Loc["Consultation_LateAfternoon"]</span>
                                </div>
                            </div>
                        </div>

                        <!-- Contact Method -->
                        <div class="mb-4">
                            <label class="form-label fw-bold mb-2" style="color: var(--text-primary); font-size: 0.95rem;">@Loc["Consultation_ContactMethod"]</label>
                            <div class="slots-grid">
                                <div class="slot-pill @(SelectedContactMethod == "Phone" ? "active" : "")" @onclick='() => SelectedContactMethod = "Phone"'>
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                                    </svg>
                                    <span>@Loc["Consultation_Phone"]</span>
                                </div>
                                <div class="slot-pill @(SelectedContactMethod == "Video" ? "active" : "")" @onclick='() => SelectedContactMethod = "Video"'>
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M23 7l-7 5 7 5V7z"></path>
                                        <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                                    </svg>
                                    <span>@Loc["Consultation_Video"]</span>
                                </div>
                                <div class="slot-pill @(SelectedContactMethod == "Email" ? "active" : "")" @onclick='() => SelectedContactMethod = "Email"'>
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                        <polyline points="22,6 12,13 2,6"></polyline>
                                    </svg>
                                    <span>@Loc["Consultation_Email"]</span>
                                </div>
                            </div>
                        </div>

                        <!-- Phone input if applicable -->
                        @if (SelectedContactMethod == "Phone" || SelectedContactMethod == "Video")
                        {
                            <div class="mb-4">
                                <label class="form-label fw-bold mb-2" style="color: var(--text-primary); font-size: 0.95rem;">@Loc["Consultation_PhoneLabel"]</label>
                                <input type="tel" class="form-control bs-input" @bind="PhoneNumber" placeholder="e.g. +359 888 888 888" style="border-radius: 8px; font-size: 1rem; padding: 10px 14px;" />
                                @if (ShowPhoneError)
                                {
                                    <div class="text-danger mt-1" style="font-size: 0.85rem;">Моля въведете телефон за връзка.</div>
                                }
                            </div>
                        }

                        <!-- Address & Google Map -->
                        <div class="mb-4">
                            <label class="form-label fw-bold mb-2" style="color: var(--text-primary); font-size: 0.95rem;">@Loc["Consultation_Address"]</label>
                            <input type="text" class="form-control bs-input" @bind="Address" @bind:event="oninput" placeholder="@Loc["Consultation_AddressPlaceholder"]" style="border-radius: 8px; font-size: 1rem; padding: 10px 14px;" />
                            <span class="form-text text-muted" style="font-size: 0.8rem; color: var(--text-secondary);">@Loc["Consultation_AddressHelp"]</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Address))
                        {
                            <div class="mb-4" style="border-radius: 12px; overflow: hidden; border: 1px solid var(--border-color); box-shadow: 0px 4px 12px rgba(0,0,0,0.05); transition: all 0.3s ease;">
                                <iframe
                                    width="100%"
                                    height="300"
                                    style="border:0;"
                                    loading="lazy"
                                    allowfullscreen
                                    src="https://maps.google.com/maps?q=@(Uri.EscapeDataString(Address))&t=&z=15&ie=UTF8&iwloc=&output=embed">
                                </iframe>
                            </div>
                        }

                        <!-- Notes -->
                        <div class="mb-4">
                            <label class="form-label fw-bold mb-2" style="color: var(--text-primary); font-size: 0.95rem;">@Loc["Consultation_Notes"]</label>
                            <textarea class="form-control bs-input" rows="3" @bind="Notes" placeholder="@Loc["Consultation_NotesPlaceholder"]" style="border-radius: 8px; font-size: 0.95rem; padding: 10px 14px; min-height: 100px;"></textarea>
                        </div>
                    </div>
                </div>

                <!-- Footer buttons -->
                <div class="d-flex gap-3 justify-content-end align-items-center">
                    <button class="bs-btn-dark px-4 py-2" @onclick="GoBackToProject" disabled="@IsSubmitting">
                        @Loc["Consultation_Cancel"]
                    </button>
                    <button class="bs-btn-primary px-4 py-2 fw-bold d-flex align-items-center gap-2" @onclick="SubmitRequest" disabled="@IsSubmitting">
                        @if (IsSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        @Loc["Consultation_Submit"]
                    </button>
                </div>
            }
        }
    </div>
</div>

<style>
    .request-consultation-container {
        max-width: 680px;
        margin: 0 auto;
    }
    
    .slots-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }
    
    @@media (max-width: 576px) {
        .slots-grid {
            grid-template-columns: 1fr;
        }
    }
    
    .slot-pill {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 16px;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        background-color: var(--bg-card);
        color: var(--text-secondary);
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
    }
    
    .slot-pill:hover {
        border-color: var(--color-primary);
        color: var(--text-primary);
        transform: translateY(-2px);
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.05);
    }
    
    .slot-pill.active {
        border-color: var(--color-success);
        background-color: rgba(76, 175, 80, 0.08);
        color: var(--color-success);
        font-weight: 600;
    }
    
    .success-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 40px 20px;
    }
    
    .success-icon-wrapper {
        width: 80px;
        height: 80px;
        background-color: rgba(76, 175, 80, 0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 24px;
        color: var(--color-success);
        animation: scaleIn 0.5s ease-out;
    }
    
    @@keyframes scaleIn {
        0% { transform: scale(0); opacity: 0; }
        100% { transform: scale(1); opacity: 1; }
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "projectId")]
    public Guid ProjectId { get; set; }

    private IProjectDetails? Project { get; set; }
    private bool IsLoading { get; set; } = false;
    private bool IsSubmitting { get; set; } = false;
    private bool IsSuccess { get; set; } = false;
    private string? ErrorMessage { get; set; }

    private DateTime PreferredDate { get; set; } = DateTime.Today.AddDays(1);
    private DateTime MinDate { get; set; } = DateTime.Today.AddDays(1);
    private string SelectedTimeSlot { get; set; } = "Morning";
    private string SelectedContactMethod { get; set; } = "Phone";
    private string PhoneNumber { get; set; } = string.Empty;
    private string Address { get; set; } = string.Empty;
    private string Notes { get; set; } = string.Empty;
    private bool ShowPhoneError { get; set; } = false;

    protected override async Task OnParametersSetAsync()
    {
        if (ProjectId != Guid.Empty)
        {
            IsLoading = true;
            ErrorMessage = null;
            try
            {
                var result = await ApiClient.GetProjectById.ExecuteAsync(ProjectId);
                if (result.Errors.Count > 0)
                {
                    ErrorMessage = result.Errors[0].Message;
                }
                else if (result.Data?.ProjectById != null)
                {
                    Project = result.Data.ProjectById;
                    if (Project.JobPosts != null && Project.JobPosts.Any())
                    {
                        Address = Project.JobPosts.FirstOrDefault(jp => !string.IsNullOrEmpty(jp.Location))?.Location ?? string.Empty;
                    }
                }
                else
                {
                    ErrorMessage = "Project not found.";
                }
            }
            catch (Exception ex)
            {
                ErrorMessage = $"Failed to load project details: {ex.Message}";
            }
            finally
            {
                IsLoading = false;
            }
        }
    }

    private void GoBackToProject()
    {
        NavManager.NavigateTo($"/project-detail?projectId={ProjectId}");
    }

    private async Task SubmitRequest()
    {
        if (Project == null) return;

        ShowPhoneError = false;
        ErrorMessage = null;

        // Validation
        if ((SelectedContactMethod == "Phone" || SelectedContactMethod == "Video") && string.IsNullOrWhiteSpace(PhoneNumber))
        {
            ShowPhoneError = true;
            return;
        }

        IsSubmitting = true;
        try
        {
            // Transition all WaitingForUserReview job posts to WaitingForAdminReview
            var jobsToApprove = Project.JobPosts
                .Where(jp => jp.Status == JobPostStatus.WaitingForUserReview)
                .ToList();

            foreach (var job in jobsToApprove)
            {
                // Call ApproveJobScope mutation
                var result = await ApiClient.ApproveJobScope.ExecuteAsync(job.Id, string.Empty);
                if (result.Errors.Count > 0)
                {
                    ErrorMessage = $"Failed to submit '{job.ServiceCategory.Name}': {result.Errors[0].Message}";
                    return;
                }
            }

            // Post system message in the chat
            var slotText = SelectedTimeSlot == "Morning" ? Loc["Consultation_Morning"].Value : SelectedTimeSlot == "Afternoon" ? Loc["Consultation_Afternoon"].Value : Loc["Consultation_LateAfternoon"].Value;
            var contactText = SelectedContactMethod == "Phone" ? Loc["Consultation_Phone"].Value : SelectedContactMethod == "Video" ? Loc["Consultation_Video"].Value : Loc["Consultation_Email"].Value;
            var addressText = string.IsNullOrWhiteSpace(Address) ? "-" : Address;
            var notesText = string.IsNullOrWhiteSpace(Notes) ? "-" : Notes;
            
            var labelProject = "Проект";
            var labelDate = Loc["Consultation_Date"].Value;
            var labelSlot = Loc["Consultation_TimeSlot"].Value;
            var labelContact = Loc["Consultation_ContactMethod"].Value;
            var labelPhone = Loc["Consultation_PhoneLabel"].Value;
            var labelAddress = Loc["Consultation_Address"].Value;
            var labelNotes = Loc["Consultation_Notes"].Value;
            var labelTitle = "Нова заявка за консултация";

            if (Loc["Consultation_Title"].Value.Contains("Request"))
            {
                labelProject = "Project";
                labelTitle = "New Consultation Request";
            }

            var summaryMessage = $"📅 **{labelTitle}**\n" +
                                 $"• **{labelProject}:** {Project.Title}\n" +
                                 $"• **{labelDate}:** {PreferredDate:dd.MM.yyyy}\n" +
                                 $"• **{labelSlot}:** {slotText}\n" +
                                 $"• **{labelContact}:** {contactText}\n" +
                                 (string.IsNullOrWhiteSpace(PhoneNumber) ? "" : $"• **{labelPhone}:** {PhoneNumber}\n") +
                                 $"• **{labelAddress}:** {addressText}\n" +
                                 $"• **{labelNotes}:** {notesText}";

            var chatResult = await ApiClient.SendProjectMessage.ExecuteAsync(ProjectId, summaryMessage);
            if (chatResult.Errors.Count > 0)
            {
                Console.WriteLine($"[RequestConsultation] Warning: Failed to send chat message: {chatResult.Errors[0].Message}");
            }
            
            IsSuccess = true;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"System error during submission: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }
}
