    .btn-secondary:hover { background-color: var(--bg-card); }

    .btn-primary-sm, .btn-danger-sm, .btn-secondary-sm { padding: 0.4rem 0.8rem; border-radius: 4px; font-size: 0.8rem; font-weight: 600; cursor: pointer; border: none; }
