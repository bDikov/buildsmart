@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public KanbanTaskCardDto? Task { get; set; }
    [Parameter] public Guid CurrentUserId { get; set; }
    [Parameter] public UserRoleTypes UserRole { get; set; }
    [Parameter] public EventCallback OnTaskUpdated { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private string NewCommentText { get; set; } = string.Empty;
    private bool IsRejecting { get; set; } = false;
    private string RejectionReason { get; set; } = string.Empty;

    private bool IsEditing { get; set; } = false;
    private bool IsSubmitting { get; set; } = false;
    private string EditTitle { get; set; } = string.Empty;
    private string EditDescription { get; set; } = string.Empty;
    private decimal EditEstimatedPrice { get; set; }
    private List<TaskSkuEditDto> EditableSkus { get; set; } = new();

    private void EnableEditMode()
    {
        if (Task == null) return;
        EditTitle = Task.Title;
        EditDescription = Task.Description;
        EditEstimatedPrice = Task.Skus.Any() ? Math.Round(Task.Skus.Sum(s => s.SubtotalEur), 2) : Task.EstimatedPrice;
        EditableSkus = Task.Skus.Select(s => new TaskSkuEditDto
        {
            SkuId = s.SkuId,
            SkuCode = s.SkuCode,
            SkuTitle = s.SkuTitle,
            Quantity = s.Quantity,
            Unit = s.Unit,
            BasePriceBgn = s.BasePriceBgn
        }).ToList();
        IsEditing = true;
    }

    private void CancelEdit()
    {
        IsEditing = false;
    }

    private void AddNewSkuRow()
    {
        EditableSkus.Add(new TaskSkuEditDto
        {
            SkuCode = $"SKU-{Guid.NewGuid().ToString()[..4].ToUpper()}",
            SkuTitle = "New Material / Labor Item",
            Quantity = 10,
            Unit = "m²",
            BasePriceBgn = 20m
        });
        RecalculateTotals();
    }

    private void RemoveSkuRow(TaskSkuEditDto item)
    {
        EditableSkus.Remove(item);
        RecalculateTotals();
    }

    private void RecalculateTotals()
    {
        EditEstimatedPrice = Math.Round(EditableSkus.Sum(s => (s.BasePriceBgn / 1.95583m) * s.Quantity), 2);
    }

    private async Task SaveTaskChanges()
    {
        if (Task == null) return;
        if (string.IsNullOrWhiteSpace(EditTitle))
        {
            await AlertService.DisplayAlert("Validation Error", "Task title cannot be empty.", "OK");
            return;
        }

        IsSubmitting = true;
        try
        {
            await ProjectService.UpdateTaskDetailsAndSkusAsync(
                Task.TaskId,
                EditTitle,
                EditDescription,
                EditEstimatedPrice,
                EditableSkus,
                CurrentUserId);

            IsEditing = false;
            await OnTaskUpdated.InvokeAsync();
            await AlertService.DisplayAlert("Task Saved", "Task details and SKU breakdown updated successfully.", "OK");
        }
        catch (Exception ex)
        {
            await AlertService.DisplayAlert("Save Error", ex.Message, "OK");
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task Close()
    {
        IsEditing = false;
        IsRejecting = false;
        RejectionReason = string.Empty;
        await OnClosed.InvokeAsync();
    }

    private string GetStatusText(TaskStatus status)
    {
        return status switch
        {
            TaskStatus.ToDo => "To Do",
            TaskStatus.InProgress => "In Progress",
            TaskStatus.AwaitingApproval => "Awaiting Approval",
            TaskStatus.Done => "Done",
            _ => status.ToString()
        };
    }

    private async Task ChangeStatus(TaskStatus newStatus)
    {
        if (Task == null) return;
        try
        {
            await ProjectService.UpdateTaskStatusAsync(Task.TaskId, newStatus, CurrentUserId, null);
            await OnTaskUpdated.InvokeAsync();
        }
        catch (Exception ex)
        {
            await AlertService.DisplayAlert("Status Error", ex.Message, "OK");
        }
    }

    private void PromptRejection()
    {
        IsRejecting = true;
    }

    private async Task ConfirmRejection()
    {
        if (Task == null || string.IsNullOrWhiteSpace(RejectionReason)) return;

        try
        {
            await ProjectService.UpdateTaskStatusAsync(Task.TaskId, TaskStatus.InProgress, CurrentUserId, RejectionReason);
            IsRejecting = false;
            RejectionReason = string.Empty;
            await OnTaskUpdated.InvokeAsync();
        }
        catch (Exception ex)
        {
            await AlertService.DisplayAlert("Rejection Error", ex.Message, "OK");
        }
    }

    private async Task PostComment()
    {
        if (Task == null || string.IsNullOrWhiteSpace(NewCommentText)) return;

        try
        {
            await ProjectService.AddTaskCommentAsync(Task.TaskId, CurrentUserId, NewCommentText, null);
            NewCommentText = string.Empty;
            await OnTaskUpdated.InvokeAsync();
        }
        catch (Exception ex)
        {
            await AlertService.DisplayAlert("Comment Error", ex.Message, "OK");
        }
    }
}
