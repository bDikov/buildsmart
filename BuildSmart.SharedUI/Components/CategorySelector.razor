@using BuildSmart.SharedUI.ViewModels

<div class="bs-card category-card">
    <h3 class="category-header @(HasError ? "text-danger" : "")">@Loc["JobWizard_CategoryLabel"]</h3>
    
    <div class="category-list mb-4">
        @if (Categories != null)
        {
            @foreach (var cat in Categories)
            {
                var catName = LanguageCode.StartsWith("bg", StringComparison.OrdinalIgnoreCase) 
                    ? (string.IsNullOrEmpty(cat.Category?.Name) ? cat.Category?.EnglishName : cat.Category?.Name) 
                    : (!string.IsNullOrEmpty(cat.Category?.EnglishName) ? cat.Category.EnglishName : cat.Category?.Name);

                <div class="bs-category-item-card @(cat.IsSelected ? "selected" : "")" @onclick="@(() => cat.IsSelected = !cat.IsSelected)">
                    <div class="bs-category-icon-box">
                        <BuildSmart.SharedUI.Components.BsIcon TextFallback="@catName" Size="24" />
                    </div>
                    <span class="bs-category-title">@catName</span>
                    <div class="bs-category-badge">
                        @if (cat.IsSelected)
                        {
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        }
                    </div>
                </div>
            }
        }
    </div>

    <button class="bs-btn-primary w-100 fw-bold" disabled="@IsBusy" @onclick="OnNextClicked">
        @NextButtonText
    </button>
</div>

<style>
    .category-card {
        padding: 30px;
        font-family: var(--font-primary);
    }
    
    .category-header {
        font-family: var(--font-heading);
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 25px;
        color: var(--text-primary);
    }
    
    .category-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    
    .bs-category-item-card {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 14px 20px;
        background-color: var(--bg-card-alt);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.2s ease;
        user-select: none;
    }

    .bs-category-item-card:hover {
        border-color: var(--color-primary);
    }
    
    .bs-category-item-card.selected {
        background-color: rgba(110, 63, 243, 0.08);
        border-color: var(--color-primary);
        box-shadow: 0 4px 12px rgba(110, 63, 243, 0.15);
    }

    .bs-category-icon-box {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-primary);
        flex-shrink: 0;
    }

    .bs-category-item-card.selected .bs-category-icon-box {
        background-color: var(--color-primary);
        border-color: var(--color-primary);
        color: #ffffff;
    }
    
    .bs-category-title {
        font-family: var(--font-primary);
        font-size: 16px;
        font-weight: 600;
        margin: 0;
        color: var(--text-primary);
        flex: 1;
    }

    .bs-category-badge {
        width: 22px;
        height: 22px;
        border: 2px solid var(--border-color);
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        background-color: transparent;
        color: transparent;
        flex-shrink: 0;
    }

    .bs-category-item-card.selected .bs-category-badge {
        background-color: var(--color-primary);
        border-color: var(--color-primary);
        color: #ffffff;
    }
</style>

@code {
    [CascadingParameter(Name = "LanguageCode")]
    public string LanguageCode { get; set; } = "en";

    [Parameter, EditorRequired]
    public IEnumerable<SelectableCategoryViewModel> Categories { get; set; } = default!;

    [Parameter]
    public bool HasError { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public string NextButtonText { get; set; } = "Next";

    [Parameter]
    public EventCallback OnNextClicked { get; set; }
}
