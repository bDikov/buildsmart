@using BuildSmart.SharedUI.GraphQL
@inject NavigationManager NavManager
@inject IBuildSmartApiClient ApiClient
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<BuildSmart.SharedUI.Resources.AppResources> Loc
@inject IJSRuntime JSRuntime

<div class="menu-container">
    <div class="menu-header mb-3 px-3">
        <h4 class="fw-bold" style="color: var(--text-primary);">@Loc["Settings_Title"]</h4>
    </div>

    <!-- Language Selector -->
    <div class="menu-item-row">
        <div class="d-flex align-items-center gap-3">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            <span class="fw-bold" style="color: var(--text-primary);">@Loc["Settings_Language"]</span>
        </div>
        <select class="bs-input form-select form-select-sm w-auto" style="border-radius: 8px; font-weight: bold; background-color: var(--bg-card-alt);" value="@_currentLang" @onchange="ChangeLanguage">
            <option value="en">English</option>
            <option value="bg">Български</option>
        </select>
    </div>

    <!-- Theme Selector -->
    <div class="menu-item-row">
        <div class="d-flex align-items-center gap-3">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <span class="fw-bold" style="color: var(--text-primary);">@Loc["Settings_Theme"]</span>
        </div>
        <select class="bs-input form-select form-select-sm w-auto" style="border-radius: 8px; font-weight: bold; background-color: var(--bg-card-alt);" value="@_currentTheme" @onchange="ChangeTheme">
            <option value="system">@Loc["Settings_SystemDefault"]</option>
            <option value="light">@Loc["Settings_Light"]</option>
            <option value="dark">@Loc["Settings_Dark"]</option>
            <option value="colorful">@Loc["Settings_Colorful"]</option>
        </select>
    </div>

    @if (_userRole == "Admin")
    {
        <!-- Email Notification for Chat messages -->
        <div class="menu-item-row">
            <div class="d-flex align-items-center gap-3">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                    <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                <span class="fw-bold" style="color: var(--text-primary); font-size: 14px;">
                    @(System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "bg" ? "Имейл известия за чат" : "Email notifications for chat")
                </span>
            </div>
            <div class="form-check form-switch m-0 d-flex align-items-center">
                <input class="form-check-input" type="checkbox" role="switch" checked="@_emailOnNewChatMessage" @onchange="ToggleEmailOnChat" style="cursor: pointer; width: 36px; height: 18px;" />
            </div>
        </div>
    }
    else if (_userRole == "Homeowner")
    {
        <!-- Email Notification for Offer ready -->
        <div class="menu-item-row">
            <div class="d-flex align-items-center gap-3">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                    <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                <span class="fw-bold" style="color: var(--text-primary); font-size: 14px;">
                    @(System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "bg" ? "Имейл при готова оферта" : "Email when offer is ready")
                </span>
            </div>
            <div class="form-check form-switch m-0 d-flex align-items-center">
                <input class="form-check-input" type="checkbox" role="switch" checked="@_emailOnOfferReady" @onchange="ToggleEmailOnOffer" style="cursor: pointer; width: 36px; height: 18px;" />
            </div>
        </div>
    }

    <hr style="border-color: var(--border-color); margin: 15px 0;" />

    <a href="/faq" class="menu-item-link">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
        <span>@Loc["Settings_FAQ"]</span>
    </a>
    <a href="/terms" class="menu-item-link">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
        <span>@Loc["Settings_Terms"]</span>
    </a>
</div>

<style>
    .menu-container {
        background-color: var(--bg-card);
        border-radius: 20px;
        width: 350px;
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        box-sizing: border-box;
        font-family: var(--font-primary);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    }

    .menu-item-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        border-radius: 12px;
        background-color: var(--bg-page);
    }

    .menu-item-link {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 12px 16px;
        border-radius: 12px;
        color: var(--text-primary);
        text-decoration: none;
        transition: background-color 0.2s;
        font-weight: 500;
    }

    .menu-item-link:hover {
        background-color: var(--bg-card-alt);
        color: var(--color-primary);
    }

    .menu-item-link svg {
        color: var(--text-muted);
        transition: color 0.2s;
    }

    .menu-item-link:hover svg {
        color: var(--color-primary);
    }
</style>

@code {
    private string _currentLang = "en";
    private string _currentTheme = "system";
    private string _userRole = string.Empty;
    private bool _emailOnOfferReady = true;
    private bool _emailOnNewChatMessage = false;

    protected override async Task OnInitializedAsync()
    {
        _currentLang = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
        
        try
        {
            var userResult = await ApiClient.GetCurrentUser.ExecuteAsync();
            if (userResult.Data?.CurrentUser != null)
            {
                var user = userResult.Data.CurrentUser;
                _currentTheme = user.PreferredTheme ?? "system";
                _userRole = user.Role.ToString();
                _emailOnOfferReady = user.EmailOnOfferReady;
                _emailOnNewChatMessage = user.EmailOnNewChatMessage;
            }
        }
        catch (Exception)
        {
            // Ignore API fetch errors on init, rely on local defaults
        }
    }

    private async Task ToggleEmailOnChat(ChangeEventArgs e)
    {
        _emailOnNewChatMessage = (bool)(e.Value ?? false);
        try
        {
            await ApiClient.UpdateUserEmailNotifications.ExecuteAsync(_emailOnOfferReady, _emailOnNewChatMessage);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Settings] Failed to update email notifications: {ex.Message}");
        }
    }

    private async Task ToggleEmailOnOffer(ChangeEventArgs e)
    {
        _emailOnOfferReady = (bool)(e.Value ?? true);
        try
        {
            await ApiClient.UpdateUserEmailNotifications.ExecuteAsync(_emailOnOfferReady, _emailOnNewChatMessage);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Settings] Failed to update email notifications: {ex.Message}");
        }
    }

    private async Task ChangeLanguage(ChangeEventArgs e)
    {
        var lang = e.Value?.ToString() ?? "en";
        
        try
        {
            await ApiClient.UpdateUserLanguage.ExecuteAsync(lang);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Settings] Failed to update language on server: {ex.Message}");
        }

        var cookieValue = $"c={lang}|uic={lang}";
        await JSRuntime.InvokeVoidAsync("setCookie", ".AspNetCore.Culture", cookieValue, 365);

        // Store language persistently in localStorage
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "preferred_language", lang);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Settings] Failed to save preferred language to localStorage: {ex.Message}");
        }

        // Store language persistently in MAUI Preferences via reflection if running in MAUI
        try
        {
            var preferencesType = Type.GetType("Microsoft.Maui.Storage.Preferences, Microsoft.Maui");
            if (preferencesType != null)
            {
                var defaultProperty = preferencesType.GetProperty("Default");
                if (defaultProperty != null)
                {
                    var defaultPreferences = defaultProperty.GetValue(null);
                    if (defaultPreferences != null)
                    {
                        var setMethod = defaultPreferences.GetType().GetMethod("Set", new[] { typeof(string), typeof(string) });
                        if (setMethod != null)
                        {
                            setMethod.Invoke(defaultPreferences, new object[] { "preferred_language", lang });
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Settings] Failed to save preferred language to MAUI Preferences: {ex.Message}");
        }

        var culture = new System.Globalization.CultureInfo(lang);
        System.Globalization.CultureInfo.CurrentCulture = culture;
        System.Globalization.CultureInfo.CurrentUICulture = culture;
        System.Globalization.CultureInfo.DefaultThreadCurrentCulture = culture;
        System.Globalization.CultureInfo.DefaultThreadCurrentUICulture = culture;
        System.Threading.Thread.CurrentThread.CurrentCulture = culture;
        System.Threading.Thread.CurrentThread.CurrentUICulture = culture;

        NavManager.NavigateTo(NavManager.Uri, forceLoad: true);
    }

    private async Task ChangeTheme(ChangeEventArgs e)
    {
        var theme = e.Value?.ToString() ?? "system";
        _currentTheme = theme;
        
        try
        {
            await ApiClient.UpdateUserTheme.ExecuteAsync(theme);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Settings] Failed to update theme on server: {ex.Message}");
        }

        // Apply the new theme to the root element immediately using JS Interop
        await JSRuntime.InvokeVoidAsync("document.documentElement.setAttribute", "data-theme", theme);
        
        await JSRuntime.InvokeVoidAsync("setCookie", "user_theme", theme, 365);
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "user_theme", theme);
        }
        catch (Exception) { }
    }
}
