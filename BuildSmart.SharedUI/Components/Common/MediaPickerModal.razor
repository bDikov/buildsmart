@using BuildSmart.SharedUI.GraphQL
@using BuildSmart.Core.Domain.Entities
@using BuildSmart.Core.Application.DTOs
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Localization
@using BuildSmart.SharedUI.Resources
@using System.Net.Http.Json
@inject BuildSmartApiClient ApiClient
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<AppResources> Loc

@if (IsOpen)
{
    <div class="bs-media-picker-backdrop" @onclick="HandleClose">
        <div class="bs-media-picker-modal" @onclick:stopPropagation="true">
            <!-- Modal Header -->
            <div class="picker-header">
                <div class="header-titles">
                    <h2 class="modal-title">@Loc["Media_PickerTitle"]</h2>
                    <div class="breadcrumb-trail">
                        <button type="button" class="crumb-btn @(_currentFolder == null ? "active" : "")" @onclick="() => NavigateToFolder(null)">
                            @Loc["Media_RootFolder"]
                        </button>
                        @foreach (var crumb in _breadcrumbs)
                        {
                            <span class="crumb-separator">/</span>
                            <button type="button" class="crumb-btn @(_currentFolder?.Id == crumb.Id ? "active" : "")" @onclick="() => NavigateToFolder(crumb)">
                                @crumb.Name
                            </button>
                        }
                    </div>
                </div>
                <button type="button" class="picker-close-btn" @onclick="HandleClose" aria-label="Close">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <!-- Toolbar / Filters -->
            <div class="picker-toolbar">
                <div class="search-box">
                    <input type="text" class="bs-input" placeholder="@Loc["Media_SearchPlaceholder"]" @bind="_searchTerm" @bind:event="oninput" @bind:after="OnSearchChanged" />
                </div>
                <div class="type-filter">
                    <select class="bs-input" @bind="_selectedType" @bind:after="LoadAssets">
                        <option value="all">@Loc["Media_FilterAll"]</option>
                        <option value="image">@Loc["Media_FilterImages"]</option>
                        <option value="video">@Loc["Media_FilterVideos"]</option>
                    </select>
                </div>
                <div class="upload-trigger">
                    <label class="bs-btn-upload-picker">
                        <span>@Loc["Media_UploadFiles"]</span>
                        <InputFile OnChange="HandleDirectUpload" multiple accept="@GetAcceptAttribute()" style="display:none;" />
                    </label>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_uploadStatus))
            {
                <div class="upload-status-alert @(_isUploadError ? "error" : "success")">
                    @_uploadStatus
                </div>
            }

            <!-- Subfolders Bar -->
            @if (_currentSubFolders.Count > 0)
            {
                <div class="subfolders-bar">
                    @foreach (var sub in _currentSubFolders)
                    {
                        <button type="button" class="folder-chip" @onclick="() => NavigateToFolder(sub)">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                            </svg>
                            <span>@sub.Name</span>
                            @if (sub.ItemCount > 0)
                            {
                                <span class="chip-count">@sub.ItemCount</span>
                            }
                        </button>
                    }
                </div>
            }

            <!-- Asset Grid Body -->
            <div class="picker-body">
                @if (_isLoading)
                {
                    <div class="picker-loading">@Loc["Common_Loading"]</div>
                }
                else if (_assets.Count == 0)
                {
                    <div class="picker-empty">
                        <p>@Loc["Media_NoAssets"]</p>
                        <label class="bs-btn-upload-picker">
                            <span>@Loc["Media_BrowseFiles"]</span>
                            <InputFile OnChange="HandleDirectUpload" multiple accept="@GetAcceptAttribute()" style="display:none;" />
                        </label>
                    </div>
                }
                else
                {
                    <div class="assets-grid">
                        @foreach (var asset in _assets)
                        {
                            <div class="asset-card @(_selectedAsset?.Id == asset.Id ? "selected" : "")" @onclick="() => SelectAsset(asset)">
                                <div class="card-thumb-wrap">
                                    @if (asset.MediaType == "video")
                                    {
                                        @if (!string.IsNullOrEmpty(asset.ThumbnailUrl))
                                        {
                                            <img src="@asset.ThumbnailUrl" alt="@asset.FileName" class="thumb-img" />
                                        }
                                        else
                                        {
                                            <video src="@(asset.PublicUrl)#t=0.5" preload="metadata" muted playsinline class="thumb-img" style="object-fit:cover; pointer-events:none;"></video>
                                        }
                                        <span class="type-badge video">MP4</span>
                                    }
                                    else
                                    {
                                        <img src="@(!string.IsNullOrEmpty(asset.ThumbnailUrl) ? asset.ThumbnailUrl : asset.PublicUrl)" alt="@asset.FileName" class="thumb-img" />
                                        <span class="type-badge image">IMG</span>
                                    }
                                </div>

                                <div class="card-meta">
                                    <span class="file-name" title="@asset.FileName">@asset.FileName</span>
                                    <div class="file-submeta">
                                        @if (asset.Width.HasValue && asset.Height.HasValue)
                                        {
                                            <span class="meta-item">@asset.Width x @asset.Height</span>
                                        }
                                        @if (asset.SizeBytes > 0)
                                        {
                                            <span class="meta-item">@FormatBytes(asset.SizeBytes)</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Footer -->
            <div class="picker-footer">
                <div class="footer-info">
                    @if (_selectedAsset != null)
                    {
                        <span class="selected-name">@_selectedAsset.FileName</span>
                    }
                </div>
                <div class="footer-actions">
                    <button type="button" class="bs-btn-secondary" @onclick="HandleClose">
                        @Loc["Common_Cancel"]
                    </button>
                    <button type="button" class="bs-btn-primary" disabled="@(_selectedAsset == null)" @onclick="ConfirmSelection">
                        @Loc["Media_SelectMedia"]
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string? InitialFolder { get; set; }
    [Parameter] public string AllowedType { get; set; } = "all";
    [Parameter] public EventCallback<MediaAssetDto> OnAssetSelected { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private bool _isLoading = false;
    private bool _isUploadError = false;
    private string? _uploadStatus;
    private string _searchTerm = string.Empty;
    private string _selectedType = "all";

    private MediaFolderDto? _currentFolder;
    private List<MediaFolderDto> _allFolders = new();
    private List<MediaFolderDto> _currentSubFolders = new();
    private List<MediaFolderDto> _breadcrumbs = new();
    private List<MediaAssetDto> _assets = new();
    private MediaAssetDto? _selectedAsset;

    private bool _prevIsOpen = false;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !_prevIsOpen)
        {
            _prevIsOpen = true;
            _selectedType = AllowedType ?? "all";
            _selectedAsset = null;
            _uploadStatus = null;
            await InitializePicker();
        }
        else if (!IsOpen && _prevIsOpen)
        {
            _prevIsOpen = false;
        }
    }

    private async Task InitializePicker()
    {
        _isLoading = true;
        try
        {
            await LoadAllFolders();

            if (!string.IsNullOrWhiteSpace(InitialFolder))
            {
                var clean = InitialFolder.Trim().Replace('\\', '/');
                if (!clean.StartsWith('/')) clean = "/" + clean;
                var match = _allFolders.FirstOrDefault(f => string.Equals(f.FullPath, clean, StringComparison.OrdinalIgnoreCase));
                if (match != null)
                {
                    NavigateToFolder(match);
                    return;
                }
            }

            NavigateToFolder(null);
        }
        catch (Exception ex)
        {
            _uploadStatus = ex.Message;
            _isUploadError = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadAllFolders()
    {
        var result = await ApiClient.GetMediaFolders.ExecuteAsync(null);
        if (result.Errors.Count == 0 && result.Data?.MediaFolders != null)
        {
            _allFolders = result.Data.MediaFolders.Select(f => new MediaFolderDto
            {
                Id = f.Id,
                ParentId = f.ParentId,
                Name = f.Name,
                Slug = f.Slug,
                FullPath = f.FullPath,
                IsSystem = f.IsSystem,
                ItemCount = f.ItemCount,
                SubFolderCount = f.SubFolderCount,
                CreatedAt = f.CreatedAt.UtcDateTime,
                UpdatedAt = f.UpdatedAt.UtcDateTime
            }).ToList();
        }
    }

    private async Task NavigateToFolder(MediaFolderDto? folder)
    {
        _currentFolder = folder;
        _selectedAsset = null;

        // Build breadcrumbs
        _breadcrumbs.Clear();
        if (folder != null)
        {
            var pathParts = folder.FullPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
            string acc = "";
            foreach (var part in pathParts)
            {
                acc += "/" + part;
                var found = _allFolders.FirstOrDefault(f => string.Equals(f.FullPath, acc, StringComparison.OrdinalIgnoreCase));
                if (found != null) _breadcrumbs.Add(found);
            }
        }

        // Subfolders
        if (folder == null)
        {
            _currentSubFolders = _allFolders.Where(f => f.ParentId == null).ToList();
        }
        else
        {
            _currentSubFolders = _allFolders.Where(f => f.ParentId == folder.Id).ToList();
        }

        await LoadAssets();
    }

    private async Task LoadAssets()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            var typeParam = _selectedType == "all" ? null : _selectedType;
            var searchParam = string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm.Trim();

            var result = await ApiClient.GetMediaAssets.ExecuteAsync(
                folderId: _currentFolder?.Id,
                mediaType: typeParam,
                searchTerm: searchParam,
                skip: 0,
                take: 100);

            if (result.Errors.Count == 0 && result.Data?.MediaAssets?.Items != null)
            {
                _assets = result.Data.MediaAssets.Items.Select(a => new MediaAssetDto
                {
                    Id = a.Id,
                    FolderId = a.FolderId,
                    FolderPath = a.FolderPath,
                    FileName = a.FileName,
                    R2Key = a.R2Key,
                    PublicUrl = a.PublicUrl,
                    ThumbnailUrl = a.ThumbnailUrl,
                    MediaType = a.MediaType,
                    ContentType = a.ContentType,
                    SizeBytes = a.SizeBytes,
                    Width = a.Width,
                    Height = a.Height,
                    DurationSeconds = a.DurationSeconds,
                    AltTextBg = a.AltTextBg,
                    AltTextEn = a.AltTextEn,
                    CreatedAt = a.CreatedAt.UtcDateTime,
                    UpdatedAt = a.UpdatedAt.UtcDateTime
                }).ToList();
            }
            else
            {
                _assets = new List<MediaAssetDto>();
                if (result.Errors.Count > 0)
                {
                    _uploadStatus = string.Join(", ", result.Errors.Select(e => e.Message));
                    _isUploadError = true;
                }
            }
        }
        catch (Exception ex)
        {
            _uploadStatus = ex.Message;
            _isUploadError = true;
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnSearchChanged()
    {
        _ = LoadAssets();
    }

    private void SelectAsset(MediaAssetDto asset)
    {
        _selectedAsset = asset;
    }

    private async Task ConfirmSelection()
    {
        if (_selectedAsset != null)
        {
            await OnAssetSelected.InvokeAsync(_selectedAsset);
        }
    }

    private async Task HandleClose()
    {
        await OnClose.InvokeAsync();
    }

    private async Task HandleDirectUpload(InputFileChangeEventArgs e)
    {
        _uploadStatus = Loc["Media_Uploading"];
        _isUploadError = false;

        try
        {
            var targetFolderPath = _currentFolder != null ? _currentFolder.FullPath : "/general";
            var files = e.GetMultipleFiles(10).ToList();
            var fileBuffers = new List<(string Name, string ContentType, long Size, byte[] Data)>();

            // Read all streams immediately while the DOM element is active
            foreach (var file in files)
            {
                using var rawStream = file.OpenReadStream(maxAllowedSize: 500 * 1024 * 1024);
                using var ms = new MemoryStream();
                await rawStream.CopyToAsync(ms);
                fileBuffers.Add((file.Name, file.ContentType ?? "application/octet-stream", file.Size, ms.ToArray()));
            }

            foreach (var fileData in fileBuffers)
            {
                // 1. Request presigned upload URL for Cloudflare R2
                var presignedResult = await ApiClient.RequestFolderUploadUrl.ExecuteAsync(
                    folderPath: targetFolderPath,
                    fileName: fileData.Name,
                    contentType: fileData.ContentType);

                if (presignedResult.Errors.Count == 0 && !string.IsNullOrEmpty(presignedResult.Data?.RequestFolderUploadUrl))
                {
                    var preSignedUrl = presignedResult.Data.RequestFolderUploadUrl;
                    using var streamContent = new ByteArrayContent(fileData.Data);
                    streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(string.IsNullOrWhiteSpace(fileData.ContentType) ? "application/octet-stream" : fileData.ContentType);

                    using var uploadClient = new HttpClient();
                    uploadClient.Timeout = TimeSpan.FromMinutes(30);

                    var r2Response = await uploadClient.PutAsync(preSignedUrl, streamContent);
                    if (r2Response.IsSuccessStatusCode)
                    {
                        var uri = new Uri(preSignedUrl);
                        var r2Key = uri.AbsolutePath.TrimStart('/');

                        var regResult = await ApiClient.RegisterUploadedMedia.ExecuteAsync(
                            folderId: _currentFolder?.Id,
                            r2Key: r2Key,
                            fileName: fileData.Name,
                            contentType: fileData.ContentType,
                            sizeBytes: fileData.Size,
                            width: null,
                            height: null,
                            durationSeconds: null);

                        if (regResult.Errors.Count == 0 && regResult.Data?.RegisterUploadedMedia != null)
                        {
                            var reg = regResult.Data.RegisterUploadedMedia;
                            _selectedAsset = new MediaAssetDto
                            {
                                Id = reg.Id,
                                FolderId = reg.FolderId,
                                FolderPath = reg.FolderPath,
                                FileName = reg.FileName,
                                R2Key = reg.R2Key,
                                PublicUrl = reg.PublicUrl,
                                ThumbnailUrl = reg.ThumbnailUrl,
                                MediaType = reg.MediaType,
                                ContentType = reg.ContentType,
                                SizeBytes = reg.SizeBytes,
                                Width = reg.Width,
                                Height = reg.Height,
                                DurationSeconds = reg.DurationSeconds,
                                AltTextBg = reg.AltTextBg,
                                AltTextEn = reg.AltTextEn,
                                CreatedAt = reg.CreatedAt.UtcDateTime,
                                UpdatedAt = reg.UpdatedAt.UtcDateTime
                            };
                        }
                    }
                }
            }

            _uploadStatus = Loc["Media_UploadSuccess"];
            _isUploadError = false;
            await LoadAssets();
        }
        catch (Exception ex)
        {
            _uploadStatus = Loc["Media_UploadError"] + ": " + ex.Message;
            _isUploadError = true;
        }
    }

    private string GetAcceptAttribute()
    {
        if (AllowedType == "image") return "image/*";
        if (AllowedType == "video") return "video/mp4,video/webm,video/*";
        return "image/*,video/*";
    }

    private static string FormatBytes(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len /= 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }
}

<style>
.bs-media-picker-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10000;
    padding: 20px;
    box-sizing: border-box;
}

.bs-media-picker-modal {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 20px;
    width: 100%;
    max-width: 1100px;
    height: 85vh;
    max-height: 850px;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-main);
    overflow: hidden;
}

.picker-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 24px;
    border-bottom: 1px solid var(--border-color);
}

.modal-title {
    font: var(--font-h5);
    color: var(--text-primary);
    margin: 0;
}

.breadcrumb-trail {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    font: var(--font-body-2);
}

.crumb-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    font: var(--font-body-2);
    cursor: pointer;
    padding: 0;
}

.crumb-btn:hover, .crumb-btn.active {
    color: var(--color-primary);
}

.crumb-separator {
    color: var(--text-muted);
}

.picker-close-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    border-radius: 8px;
    transition: background 0.2s ease, color 0.2s ease;
}

.picker-close-btn:hover {
    background: var(--bg-card-alt);
    color: var(--text-primary);
}

.picker-toolbar {
    display: flex;
    gap: 12px;
    padding: 14px 24px;
    border-bottom: 1px solid var(--border-color);
    background: var(--bg-card-alt);
    align-items: center;
}

.search-box {
    flex: 1;
}

.type-filter select {
    min-width: 140px;
}

.bs-btn-upload-picker {
    background: var(--color-primary);
    color: #ffffff;
    padding: 10px 18px;
    border-radius: 12px;
    cursor: pointer;
    font: var(--font-h6);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    transition: opacity 0.2s ease;
}

.bs-btn-upload-picker:hover {
    opacity: 0.9;
}

.upload-status-alert {
    padding: 10px 24px;
    font: var(--font-body-2);
}

.upload-status-alert.success {
    background: var(--bg-card);
    border-bottom: 1px solid var(--color-success);
    color: var(--color-success);
}

.upload-status-alert.error {
    background: var(--bg-card);
    border-bottom: 1px solid var(--color-danger);
    color: var(--color-danger);
}

.subfolders-bar {
    display: flex;
    gap: 8px;
    padding: 10px 24px;
    background: var(--bg-card);
    border-bottom: 1px solid var(--border-color);
    overflow-x: auto;
}

.folder-chip {
    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--bg-card-alt);
    border: 1px solid var(--border-color);
    padding: 6px 12px;
    border-radius: 20px;
    font: var(--font-body-2);
    color: var(--text-primary);
    cursor: pointer;
    white-space: nowrap;
    transition: border-color 0.2s ease;
}

.folder-chip:hover {
    border-color: var(--color-primary);
}

.chip-count {
    background: var(--bg-card);
    padding: 2px 6px;
    border-radius: 10px;
    font-size: 0.75rem;
    color: var(--text-muted);
}

.picker-body {
    flex: 1;
    overflow-y: auto;
    padding: 20px 24px;
}

.picker-loading, .picker-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 250px;
    color: var(--text-muted);
    font: var(--font-body-1);
    gap: 16px;
}

.assets-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 16px;
}

.asset-card {
    background: var(--bg-card-alt);
    border: 1px solid var(--border-color);
    border-radius: 14px;
    overflow: hidden;
    cursor: pointer;
    transition: border-color 0.2s ease, transform 0.2s ease;
    display: flex;
    flex-direction: column;
}

.asset-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
}

.asset-card.selected {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 2px var(--color-primary);
}

.card-thumb-wrap {
    height: 120px;
    background: var(--bg-card);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.video-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
}

.type-badge {
    position: absolute;
    top: 6px;
    right: 6px;
    padding: 2px 6px;
    border-radius: 4px;
    font: var(--font-h6);
    font-size: 0.65rem;
    text-transform: uppercase;
}

.type-badge.image {
    background: rgba(0, 0, 0, 0.6);
    color: #ffffff;
}

.type-badge.video {
    background: var(--color-primary);
    color: #ffffff;
}

.card-meta {
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.file-name {
    font: var(--font-h6);
    color: var(--text-primary);
    font-size: 0.85rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.file-submeta {
    display: flex;
    justify-content: space-between;
    font: var(--font-body-2);
    color: var(--text-muted);
    font-size: 0.75rem;
}

.picker-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 24px;
    border-top: 1px solid var(--border-color);
    background: var(--bg-card-alt);
}

.selected-name {
    font: var(--font-h6);
    color: var(--text-primary);
}

.footer-actions {
    display: flex;
    gap: 10px;
}
</style>
