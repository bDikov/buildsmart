@inherits LayoutComponentBase
@implements IDisposable
@using BuildSmart.SharedUI.Services
@using BuildSmart.SharedUI.GraphQL
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using StrawberryShake
@inject IStringLocalizer<BuildSmart.SharedUI.Resources.AppResources> Loc
@inject INavigationBridge NavigationBridge
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject IBlazorNavigationRegistry NavigationRegistry
@inject IBuildSmartApiClient ApiClient
@inject IJSRuntime JSRuntime
@inject SignalRService SignalRService
@inject BuildSmart.SharedUI.GraphQL.State.BuildSmartApiClientStoreAccessor StoreAccessor
@inject IAdminPerspectiveService AdminPerspectiveService

<div class="page">
    <!-- Mobile Header -->
    <div class="mobile-header">
        @if (!_isGuest)
        {
            <div class="logo-block" @onclick='() => HandleFeedNavigation()'>
                <div class="logo-icon" style="width: 32px; height: 32px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                    </svg>
                </div>
                <span class="logo-text" style="font-size: 16px;">BuildSmart</span>
            </div>
        }
        else
        {
            <div class="logo-block" @onclick='() => HandleFeedNavigation()' style="cursor: pointer;">
                <div class="logo-icon" style="width: 32px; height: 32px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                    </svg>
                </div>
                <span class="logo-text" style="font-size: 16px;">BuildSmart Support</span>
            </div>
        }
        
        <div style="display: flex; align-items: center; gap: 8px;">
            <!-- Language Switcher Dropdown -->
            @if (IsGuestUser)
            {
                <div class="bs-lang-dropdown-wrapper" style="position: relative; display: inline-block; z-index: 1050;">
                    <button type="button" class="btn btn-sm d-flex align-items-center justify-content-center py-1 px-2" @onclick="ToggleLangDropdown" @onclick:stopPropagation="true" style="font: var(--font-h3); border-radius: 12px; background: transparent; border: 1px solid var(--border-color); color: var(--text-primary); gap: 4px; height: 32px; transition: all 0.2s ease;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="2" y1="12" x2="22" y2="12"></line>
                            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                        </svg>
                        <span>@(_currentLang?.ToUpper() ?? "BG")</span>
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-left: 2px; transition: transform 0.2s ease; transform: @(_isLangDropdownOpen ? "rotate(180deg)" : "rotate(0deg)")">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </button>
                    @if (_isLangDropdownOpen)
                    {
                        <div class="bs-dropdown-menu" style="position: absolute; right: 0; top: 38px; background: var(--bg-card, #ffffff); border: 1px solid var(--border-color, #e2e8f0); border-radius: 12px; min-width: 140px; box-shadow: var(--shadow-lg, 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)); padding: 6px; display: flex; flex-direction: column; gap: 4px;">
                            <button type="button" class="bs-dropdown-item @(_currentLang == "bg" ? "active" : "")" @onclick='() => SelectLanguageAsync("bg")' @onclick:stopPropagation="true" style="display: flex; align-items: center; justify-content: space-between; border: none; background: transparent; padding: 8px 12px; font: var(--font-h3); color: var(--text-primary); border-radius: 8px; cursor: pointer; text-align: left; transition: background-color 0.15s ease;">
                                <span>Български</span>
                                @if (_currentLang == "bg")
                                {
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-primary, #3b82f6);"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                }
                            </button>
                            <button type="button" class="bs-dropdown-item @(_currentLang == "en" ? "active" : "")" @onclick='() => SelectLanguageAsync("en")' @onclick:stopPropagation="true" style="display: flex; align-items: center; justify-content: space-between; border: none; background: transparent; padding: 8px 12px; font: var(--font-h3); color: var(--text-primary); border-radius: 8px; cursor: pointer; text-align: left; transition: background-color 0.15s ease;">
                                <span>English</span>
                                @if (_currentLang == "en")
                                {
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-primary, #3b82f6);"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                }
                            </button>
                        </div>
                    }
                </div>
            }

            @if (AuthService.IsAuthenticated && !_isGuest)
            {
                <a class="notification-bell mobile-bell" href="/notifications">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                    </svg>
                    @if (_hasUnreadNotifications)
                    {
                        <span class="bell-unread-dot"></span>
                    }
                </a>
            }
            else
            {
                <button type="button" class="btn btn-sm d-flex align-items-center gap-1 py-1 px-2" @onclick="HandleExitClick" @onclick:preventDefault="true" style="font-size: 0.8rem; border-radius: 12px; font-weight: 600; background: transparent; border: 1px solid var(--color-primary, #111111); color: var(--color-primary, #111111);">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                        <polyline points="10 17 15 12 10 7"></polyline>
                        <line x1="15" y1="12" x2="3" y2="12"></line>
                    </svg>
                    @(_currentLang == "bg" ? "Вход" : "Log In")
                </button>
            }
        </div>
    </div>

    @if (!IsGuestUser)
    {
        <div class="sidebar-overlay @(_isSidebarOpen ? "open" : "")" @onclick="CloseSidebar"></div>

        <div class="sidebar shadow-sm @(_isSidebarOpen ? "open" : "")">
        <div class="sidebar-header">
            <div class="logo-block" @onclick='() => HandleFeedNavigation()'>
                <div class="logo-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                    </svg>
                </div>
                <span class="logo-text">BuildSmart</span>
            </div>
        </div>

        <div class="nav flex-column sidebar-nav">
            
            <!-- Standard Blazor Links -->
            <a class="nav-item-dark @(IsActivePage("/feed") || IsActivePage("/") ? "active" : "")" href="feed" @onclick="CloseSidebar">
                <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                @Loc["Nav_Marketplace"]
            </a>
            <a class="nav-item-dark @(IsActivePage("/blog") ? "active" : "")" href="blog" @onclick="CloseSidebar">
                <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                </svg>
                @Loc["Blog_Title"]
            </a>

            <!-- Role-based Native XAML Bridges & Blazor Pages -->
            <AuthorizeView Roles="Homeowner, HOMEOWNER, homeowner, Tradesman, TRADESMAN, tradesman, Admin, ADMIN, admin">
                @if (!_isGuest)
                {
                    <a class="nav-item-dark @(IsActivePage("/my-projects") ? "active" : "")" href="/my-projects" @onclick="CloseSidebar">
                        <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                        @Loc["Nav_MyProjects"]
                    </a>
                }
            </AuthorizeView>
            <AuthorizeView Roles="Homeowner, HOMEOWNER, homeowner, Tradesman, TRADESMAN, tradesman, Admin, ADMIN, admin">
                <AuthorizeView Roles="Homeowner, HOMEOWNER, homeowner, Tradesman, TRADESMAN, tradesman" Context="innerContext">
                    @if (!_isGuest)
                    {
                        <a class="nav-item-dark @(IsActivePage("/project-messages") && !IsActivePage("/admin-support-chats") ? "active" : "")" @onclick="NavigateToChat" style="position: relative; display: flex; align-items: center; cursor: pointer;">
                            <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                            </svg>
                            @Loc["Nav_Chat"]
                            @if (_hasUnreadChatMessages)
                            {
                                <span class="sidebar-chat-unread-badge"></span>
                            }
                        </a>
                    }
                </AuthorizeView>
            </AuthorizeView>

            <AuthorizeView Roles="Admin, ADMIN, admin">
                <div class="sidebar-section-label">
                    @Loc["Nav_AdminSection"]
                </div>
                <a class="nav-item-dark @(IsActivePage("/admin-projects") ? "active" : "")" href="/admin-projects" @onclick="CloseSidebar">
                    <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                    @Loc["Admin_AllProjects"]
                </a>
                <a class="nav-item-dark @(IsActivePage("/admin/projects/create") ? "active" : "")" href="/admin/projects/create" @onclick="CloseSidebar">
                    <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                    @Loc["Admin_CreateProject"]
                </a>
                <a class="nav-item-dark @(IsActivePage("/admin/spider-net") ? "active" : "")" href="/admin/spider-net" @onclick="CloseSidebar">
                    <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                    @Loc["Nav_Categories"]
                </a>
                <a class="nav-item-dark @(IsActivePage("/admin/landing-pages") ? "active" : "")" href="/admin/landing-pages" @onclick="CloseSidebar">
                    <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                    @Loc["Nav_LandingPages"]
                </a>
                <a class="nav-item-dark @(IsActivePage("/admin/media-library") ? "active" : "")" href="/admin/media-library" @onclick="CloseSidebar">
                    <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                    @Loc["Media_LibraryTitle"]
                </a>
                <a class="nav-item-dark @(IsActivePage("/admin/leads") ? "active" : "")" href="/admin/leads" @onclick="CloseSidebar">
                    <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    @Loc["Nav_Leads"]
                </a>
                <a class="nav-item-dark @(IsActivePage("/admin/reporting") ? "active" : "")" href="/admin/reporting" @onclick="CloseSidebar">
                    <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                    @Loc["Nav_Reporting"]
                </a>
                <a class="nav-item-dark @(IsActivePage("/user-management") ? "active" : "")" href="/user-management" @onclick="CloseSidebar">
                    <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    @Loc["Nav_Users"]
                </a>
                <a class="nav-item-dark @(IsActivePage("/admin-support-chats") ? "active" : "")" href="/admin-support-chats" @onclick="CloseSidebar" style="position: relative; display: flex; align-items: center;">
                    <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                    @Loc["Nav_SupportChat"]
                    @if (_hasUnreadChatMessages)
                    {
                        <span class="sidebar-chat-unread-badge"></span>
                    }
                </a>
                <a class="nav-item-dark @(IsActivePage("/admin-offers") ? "active" : "")" href="/admin-offers" @onclick="CloseSidebar">
                    <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    @Loc["Nav_PdfOffers"]
                </a>
                <a class="nav-item-dark @(IsActivePage("/admin-video-upload") ? "active" : "")" href="/admin-video-upload" @onclick="CloseSidebar">
                    <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
                    @Loc["Nav_VideoUpload"]
                </a>
                <a class="nav-item-dark @(IsActivePage("/admin/blog") ? "active" : "")" href="/admin/blog" @onclick="CloseSidebar">
                    <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                    @Loc["Admin_BlogManager"]
                </a>
                <a class="nav-item-dark @(IsActivePage("/admin/localization") ? "active" : "")" href="/admin/localization" @onclick="CloseSidebar">
                    <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                    @Loc["Nav_Localization"]
                </a>
            </AuthorizeView>

            @if (IsGuestUser)
            {
                <a class="nav-item-dark @(IsActivePage("/project-messages") && IsActivePage("/admin-support-chats") ? "active" : "")" @onclick="HandleSupportChatClick" style="cursor: pointer; position: relative;">
                    <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                    </svg>
                    @Loc["Nav_SupportChat"]
                    @if (_isStartingChat)
                    {
                        <span class="spinner-border spinner-border-sm ms-2" role="status" aria-hidden="true" style="width: 12px; height: 12px; border-width: 2px; vertical-align: middle;"></span>
                    }
                </a>
            }

        </div>

        @if (IsGuestUser)
        {
            <div class="sidebar-lang-container" style="padding: 16px; border-top: 1px solid var(--border-color); position: relative; z-index: 1040;">
                <div class="sidebar-lang-switcher" @onclick="ToggleLangDropdown" @onclick:stopPropagation="true" style="display: flex; align-items: center; justify-content: space-between; font: var(--font-h3); color: var(--text-secondary); cursor: pointer;">
                    <span>@Loc["Settings_Language"]</span>
                    <button type="button" class="btn btn-sm d-flex align-items-center gap-1 py-1 px-2" style="border-radius: 12px; font: var(--font-h3); background: var(--bg-card-alt); border: 1px solid var(--border-color); color: var(--text-primary);">
                        <span>@(_currentLang == "bg" ? Loc["MainLayout_LangBG"] : Loc["MainLayout_LangEN"])</span>
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="transition: transform 0.2s ease; transform: @(_isLangDropdownOpen ? "rotate(180deg)" : "rotate(0deg)")">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </button>
                </div>
                @if (_isLangDropdownOpen)
                {
                    <div class="bs-dropdown-menu sidebar-lang-dropdown" style="margin-top: 8px; background: var(--bg-card, #ffffff); border: 1px solid var(--border-color, #e2e8f0); border-radius: 12px; box-shadow: var(--shadow-md, 0 4px 6px -1px rgba(0, 0, 0, 0.1)); padding: 6px; display: flex; flex-direction: column; gap: 4px; width: 100%; box-sizing: border-box;">
                        <button type="button" class="bs-dropdown-item @(_currentLang == "bg" ? "active" : "")" @onclick='() => SelectLanguageAsync("bg")' @onclick:stopPropagation="true" style="display: flex; align-items: center; justify-content: space-between; border: none; background: transparent; padding: 8px 12px; font: var(--font-h3); color: var(--text-primary); border-radius: 8px; cursor: pointer; text-align: left; transition: background-color 0.15s ease; width: 100%;">
                            <span>Български</span>
                            @if (_currentLang == "bg")
                            {
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-primary, #3b82f6);"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            }
                        </button>
                        <button type="button" class="bs-dropdown-item @(_currentLang == "en" ? "active" : "")" @onclick='() => SelectLanguageAsync("en")' @onclick:stopPropagation="true" style="display: flex; align-items: center; justify-content: space-between; border: none; background: transparent; padding: 8px 12px; font: var(--font-h3); color: var(--text-primary); border-radius: 8px; cursor: pointer; text-align: left; transition: background-color 0.15s ease; width: 100%;">
                            <span>English</span>
                            @if (_currentLang == "en")
                            {
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-primary, #3b82f6);"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            }
                        </button>
                    </div>
                }
            </div>
        }

        <div class="sidebar-account" @onclick="HandleSidebarAccountClick" style="@(IsGuestUser ? "cursor: pointer;" : "")">
            @if (AuthService.IsAuthenticated && !_isGuest)
            {
                <a href="/user-profile" class="account-info" @onclick="CloseSidebar" @onclick:stopPropagation="true" style="text-decoration: none; cursor: pointer;">
                    <div class="account-avatar" style="overflow: hidden;">
                        @if (!string.IsNullOrEmpty(_userProfilePictureUrl))
                        {
                            <img src="@_userProfilePictureUrl" alt="Profile" style="width: 100%; height: 100%; object-fit: cover;" />
                        }
                        else
                        {
                            <!-- Generic user icon -->
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        }
                    </div>
                    <div class="account-details">
                        <span class="account-name">@(_userName ?? "BuildSmart User")</span>
                        <span class="account-email">@(_userEmail ?? "user@buildsmart.com")</span>
                    </div>
                </a>
            }
            else
            {
                <div class="account-info">
                    <div class="account-avatar" style="overflow: hidden;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    </div>
                    <div class="account-details">
                        <span class="account-name">@(_isGuest ? "Guest Support" : (_currentLang == "bg" ? "Гост" : "Guest"))</span>
                    </div>
                </div>
            }
            <button type="button" class="logout-btn @(IsGuestUser ? "login-mode" : "")" @onclick="HandleExitClick" @onclick:stopPropagation="true" @onclick:preventDefault="true" title="@(IsGuestUser ? (_currentLang == "bg" ? "Вход" : "Log In") : (_currentLang == "bg" ? "Изход" : "Logout"))">
                @if (IsGuestUser)
                {
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                        <polyline points="10 17 15 12 10 7"></polyline>
                        <line x1="15" y1="12" x2="3" y2="12"></line>
                    </svg>
                }
                else
                {
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                }
            </button>
        </div>
    </div>
    }

    <main class="main-content @(IsGuestUser ? "guest-layout" : "")">
        <div class="top-app-bar desktop-top-bar">
            @if (IsGuestUser)
            {
                <div class="logo-block" @onclick='() => HandleFeedNavigation()' style="cursor: pointer; display: flex; align-items: center; gap: 10px;">
                    <div class="logo-icon" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                        </svg>
                    </div>
                    <span class="logo-text" style="font-size: 18px; font-weight: 600;">BuildSmart</span>
                </div>
            }
            <div class="spacer"></div>
            @if (AuthService.IsAuthenticated && !_isGuest)
            {
                <a class="notification-bell desktop-notification-bell" href="/notifications">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                    </svg>
                    @if (_hasUnreadNotifications)
                    {
                        <span class="bell-unread-dot"></span>
                    }
                </a>
            }
            else if (IsGuestUser)
            {
                <div style="display: flex; align-items: center; gap: 16px;">
                    <!-- Language Switcher Dropdown -->
                    <div class="bs-lang-dropdown-wrapper" style="position: relative; display: inline-block; z-index: 1050;">
                        <button type="button" class="btn btn-sm d-flex align-items-center justify-content-center py-1 px-3" @onclick="ToggleLangDropdown" @onclick:stopPropagation="true" style="font: var(--font-h3); border-radius: 12px; background: transparent; border: 1px solid var(--border-color); color: var(--text-primary); gap: 6px; height: 38px; transition: all 0.2s ease;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="2" y1="12" x2="22" y2="12"></line>
                                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                            </svg>
                            <span>@(_currentLang?.ToUpper() ?? "BG")</span>
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-left: 2px; transition: transform 0.2s ease; transform: @(_isLangDropdownOpen ? "rotate(180deg)" : "rotate(0deg)")">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </button>
                        @if (_isLangDropdownOpen)
                        {
                            <div class="bs-dropdown-menu" style="position: absolute; right: 0; top: 44px; background: var(--bg-card, #ffffff); border: 1px solid var(--border-color, #e2e8f0); border-radius: 12px; min-width: 140px; box-shadow: var(--shadow-lg, 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)); padding: 6px; display: flex; flex-direction: column; gap: 4px;">
                                <button type="button" class="bs-dropdown-item @(_currentLang == "bg" ? "active" : "")" @onclick='() => SelectLanguageAsync("bg")' @onclick:stopPropagation="true" style="display: flex; align-items: center; justify-content: space-between; border: none; background: transparent; padding: 8px 12px; font: var(--font-h3); color: var(--text-primary); border-radius: 8px; cursor: pointer; text-align: left; transition: background-color 0.15s ease;">
                                    <span>Български</span>
                                    @if (_currentLang == "bg")
                                    {
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-primary, #3b82f6);"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                    }
                                </button>
                                <button type="button" class="bs-dropdown-item @(_currentLang == "en" ? "active" : "")" @onclick='() => SelectLanguageAsync("en")' @onclick:stopPropagation="true" style="display: flex; align-items: center; justify-content: space-between; border: none; background: transparent; padding: 8px 12px; font: var(--font-h3); color: var(--text-primary); border-radius: 8px; cursor: pointer; text-align: left; transition: background-color 0.15s ease;">
                                    <span>English</span>
                                    @if (_currentLang == "en")
                                    {
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-primary, #3b82f6);"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                    }
                                </button>
                            </div>
                        }
                    </div>

                    <button type="button" class="btn btn-sm d-flex align-items-center gap-2 py-2 px-3" @onclick="HandleExitClick" @onclick:preventDefault="true" style="font-size: 0.9rem; border-radius: 12px; font-weight: 600; background: transparent; border: 1.5px solid var(--color-primary); color: var(--color-primary); transition: all 0.2s ease; height: 38px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                            <polyline points="10 17 15 12 10 7"></polyline>
                            <line x1="15" y1="12" x2="3" y2="12"></line>
                        </svg>
                        @Loc["Login_LogInButton"]
                    </button>
                </div>
            }
        </div>
        <article class="content px-4 py-3">
            <CascadingValue Value="@_currentLang" Name="LanguageCode">
                @Body
            </CascadingValue>
        </article>
    </main>

    <!-- Bottom Mobile Navigation Bar -->
    <div class="mobile-bottom-nav">
        <a class="bottom-nav-item @(IsActivePage("/feed") || IsActivePage("/") ? "active" : "")" @onclick='() => HandleFeedNavigation()'>
            <svg class="bottom-nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            <span class="bottom-nav-text">@Loc["Nav_Marketplace"]</span>
        </a>
        @if (!_isGuest)
        {
            <a class="bottom-nav-item @(IsActivePage("/my-projects") ? "active" : "")" @onclick='() => Navigate("/my-projects")'>
                <svg class="bottom-nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                </svg>
                <span class="bottom-nav-text">@Loc["Nav_MyProjects"]</span>
            </a>
        }
        <a class="bottom-nav-item @(IsChatActive() ? "active" : "")" @onclick="HandleSupportChatClick" style="position: relative;">
            <svg class="bottom-nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
            @if (_hasUnreadChatMessages && !_isGuest)
            {
                <span class="chat-unread-dot"></span>
            }
            <span class="bottom-nav-text">@(_isGuest ? (_currentLang == "bg" ? "Чат" : "Chat") : Loc["Nav_Chat"])</span>
        </a>
        @if (!_isGuest)
        {
            <a class="bottom-nav-item @(IsActivePage("/user-profile") ? "active" : "")" @onclick='() => Navigate("/user-profile")'>
                <svg class="bottom-nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3"></circle>
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                </svg>
                <span class="bottom-nav-text">@Loc["Settings_Title"]</span>
            </a>
        }
    </div>
    <!-- Auth Prompt Modal -->
    <BsConfirmationModal IsVisible="_showAuthModal"
                         Title="@Loc["Feed_AuthAlert_Title"]"
                         Message="@Loc["Feed_AuthAlert_Message"]"
                         AcceptText="@Loc["Feed_AuthAlert_Accept"]"
                         CancelText="@Loc["Feed_AuthAlert_Cancel"]"
                         OnConfirmationChanged="OnAuthConfirmationChanged" />

    <!-- Logout Confirmation Modal -->
    <BsConfirmationModal IsVisible="_showLogoutModal"
                         Title="@Loc["MainLayout_LogoutAlert_Title"]"
                         Message="@Loc["MainLayout_LogoutAlert_Message"]"
                         AcceptText="@Loc["MainLayout_LogoutAlert_Accept"]"
                         CancelText="@Loc["MainLayout_LogoutAlert_Cancel"]"
                         OnConfirmationChanged="OnLogoutConfirmationChanged" />

    @if (!IsActivePage("/project-messages") && !IsActivePage("/admin-support-chats"))
    {
        <!-- Desktop Floating Chat Button -->
        <button class="bs-floating-chat-btn" @onclick="HandleSupportChatClick" title="@(_currentLang == "bg" ? "Чат за поддръжка" : "Support Chat")">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
            @if (_isStartingChat)
            {
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="width: 14px; height: 14px; border-width: 2px; position: absolute; top: 12px; right: 12px;"></span>
            }
        </button>

        <!-- Floating Phone Call Button & Tooltip -->
        <div class="bs-floating-phone-wrapper">
            @if (_showPhoneTooltip)
            {
                <div class="bs-phone-tooltip shadow-sm">
                    <a href="tel:@Loc["Support_PhoneNumber"]" class="bs-phone-number-link">
                        @Loc["Support_PhoneNumber"]
                    </a>
                    <button class="bs-phone-copy-btn" @onclick="CopyPhoneToClipboard" title="Копирай номера">
                        @if (_isPhoneCopied)
                        {
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        }
                        else
                        {
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                            </svg>
                        }
                    </button>
                </div>
            }
            <button class="bs-floating-phone-btn @(_showPhoneTooltip ? "active" : "")" @onclick="TogglePhoneTooltip" title="@Loc["MobileCRO_CallPrompt"]">
                <svg width="24" height="24" viewBox="0 0 24 24">
                    <path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.57a1.003 1.003 0 0 0-1.01.24l-2.2 2.2a15.045 15.045 0 0 1-6.59-6.59l2.2-2.2c.28-.28.36-.67.25-1.02A11.36 11.36 0 0 1 8.5 4c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1 0 9.39 7.61 17 17 17 .55 0 1-.45 1-1v-3.5c0-.55-.45-1-1-1z" fill="currentColor" />
                    <path d="M14.05 2a9 9 0 0 1 8 7.94" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="bs-phone-wave-outer"></path>
                    <path d="M14.05 6a5 5 0 0 1 4 4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="bs-phone-wave-inner"></path>
                </svg>
            </button>
        </div>
    }

    <!-- Site-wide Exit Intent Lead Capture Modal -->
    <ExitIntentModal />
</div>

<style>
    .sidebar {
        background-color: var(--bg-card);
        border-right: 1px solid var(--border-color);
        height: 100vh;
        width: 312px;
        position: fixed;
        top: 0;
        left: 0;
        display: flex;
        flex-direction: column;
        color: var(--text-primary);
        font-family: 'Inter', var(--font-primary);
        z-index: 100;
        transition: transform 0.3s ease;
    }

    .sidebar-header {
        padding: 24px 16px;
    }

    .logo-block {
        display: flex;
        align-items: center;
        gap: 12px;
        cursor: pointer;
        user-select: none;
        transition: opacity 0.2s ease;
    }

    .logo-block:hover {
        opacity: 0.85;
    }

    .logo-icon {
        width: 40px;
        height: 40px;
        background-color: var(--text-primary);
        color: var(--bg-card);
        border-radius: 4px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .logo-text {
        font-size: 18px;
        font-weight: 600;
        color: var(--text-primary);
    }

    .sidebar-search {
        margin: 0 16px 24px 16px;
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 6px;
        height: 40px;
        display: flex;
        align-items: center;
        padding: 0 12px;
        gap: 12px;
    }

    .search-icon {
        color: var(--text-muted);
    }

    .search-input {
        background: transparent;
        border: none;
        color: var(--text-primary);
        font-size: 16px;
        width: 100%;
        outline: none;
    }

    .search-input::placeholder {
        color: var(--text-muted);
    }

    .sidebar-section-label {
        padding: 16px 12px 6px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
        color: var(--text-muted);
        text-transform: uppercase;
        user-select: none;
    }

    .sidebar-nav {
        padding: 0 16px 32px 16px;
        flex: 1 1 0%;
        min-height: 0;
        display: flex;
        flex-direction: column;
        flex-wrap: nowrap;
        overflow-y: auto;
        overflow-x: hidden;
        scrollbar-width: thin;
        scrollbar-color: var(--border-color) transparent;
    }

    .sidebar-nav::-webkit-scrollbar {
        width: 6px;
    }

    .sidebar-nav::-webkit-scrollbar-track {
        background: transparent;
    }

    .sidebar-nav::-webkit-scrollbar-thumb {
        background-color: var(--border-color);
        border-radius: 6px;
    }

    .sidebar-nav::-webkit-scrollbar-thumb:hover {
        background-color: var(--text-muted);
    }

    .nav-item-dark {
        width: 100%;
        min-width: 100%;
        box-sizing: border-box;
        flex-shrink: 0;
        height: 40px;
        border-radius: 4px;
        display: flex;
        align-items: center;
        padding: 0 12px;
        cursor: pointer;
        color: var(--text-secondary);
        text-decoration: none;
        transition: background-color 0.2s ease, color 0.2s ease;
        font-size: 14px;
        font-weight: 500;
        gap: 12px;
        margin-bottom: 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .nav-item-dark:hover, .nav-item-dark:focus {
        background-color: var(--bg-card-alt);
        color: var(--text-primary);
    }

    .nav-item-dark:active {
        background-color: var(--color-primary);
        color: var(--bg-card);
    }

    .nav-item-dark.active {
        background-color: var(--color-primary) !important;
        color: var(--bg-card) !important;
    }

    .nav-item-dark.active .nav-icon {
        color: var(--bg-card) !important;
        opacity: 1;
    }

    .nav-icon {
        opacity: 0.8;
    }

    .nav-item-header {
        color: var(--text-muted);
        font-size: 14px;
        font-weight: 600;
        padding: 16px 12px 8px 12px;
    }

    .sidebar-account {
        padding: 24px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-top: 1px solid var(--border-color);
        background-color: var(--bg-card);
    }

    .account-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .account-avatar {
        width: 40px;
        height: 40px;
        background-color: var(--bg-card-alt);
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        color: var(--text-muted);
    }

    .account-details {
        display: flex;
        flex-direction: column;
    }

    .account-name {
        font-size: 14px;
        font-weight: 600;
        color: var(--text-primary);
    }

    .account-email {
        font-size: 12px;
        color: var(--text-muted);
    }

    .logout-btn {
        background: transparent;
        border: none;
        color: var(--text-muted);
        cursor: pointer;
        padding: 8px;
        border-radius: 4px;
        display: flex;
        justify-content: center;
        align-items: center;
        transition: color 0.2s ease, background-color 0.2s ease;
    }

    .logout-btn:hover {
        color: rgb(255, 107, 107);
        background-color: rgba(255, 107, 107, 0.1);
    }

    .logout-btn.login-mode:hover {
        color: #3b82f6;
        background-color: rgba(59, 130, 246, 0.1);
    }

    .main-content {
        margin-left: 312px;
        width: calc(100% - 312px);
        background-color: var(--bg-page);
        min-height: 100vh;
        transition: margin-left 0.3s ease, width 0.3s ease, background-color 0.3s ease;
        padding-top: 0;
    }

    .main-content.guest-layout {
        margin-left: 0;
        width: 100%;
        transition: none;
    }

    .main-content-unauth {
        width: 100%;
        background-color: var(--bg-page);
        min-height: 100vh;
        padding-top: 0;
    }

    .top-app-bar {
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        padding: 0 24px;
        background-color: var(--bg-page); /* Solid background to hide content scrolling under it */
        position: sticky; /* Keep it visible at the top while scrolling */
        top: 0;
        z-index: 90;
    }

    .spacer {
        flex-grow: 1;
    }

    .notification-bell {
        color: var(--text-primary);
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        transition: background-color 0.2s ease;
    }

    .bell-unread-dot {
        position: absolute;
        top: 6px;
        right: 6px;
        width: 8px;
        height: 8px;
        background-color: #FF3B30;
        border-radius: 50%;
        border: 1.5px solid var(--bg-card);
    }

    .notification-bell:hover {
        background-color: var(--bg-card-alt);
    }

    /* Mobile Responsive Styles */
    @@media (max-width: 992px) {
        .top-app-bar {
            display: none !important;
        }
        
        .sidebar {
            transform: translateX(-100%);
            box-shadow: 5px 0 15px rgba(0, 0, 0, 0.5);
        }

        .sidebar.open {
            transform: translateX(0);
        }

        .main-content {
            margin-left: 0;
            width: 100%;
            padding-top: 60px; /* Space for fixed mobile header */
            padding-bottom: calc(74px + env(safe-area-inset-bottom, 0px)); /* Space for bottom sticky menu + safe area */
        }

        .mobile-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 16px;
            height: 60px;
