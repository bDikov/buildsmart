@code {
    private bool _isSidebarOpen = false;
    private string _currentLang = "bg";
    private bool _isLoading = true;
    private string? _userName;
    private string? _userEmail;
    private string? _userProfilePictureUrl;
    private bool _hasUnreadNotifications = false;
    private bool _hasUnreadChatMessages = false;
    private bool _isGuest = false;
    private Guid? _supportProjectId;
    private bool _hasProjects = false;

    private static bool _hasAttemptedLanguageSync = false;

    private async Task<bool> CheckIsGuestFromTokenAsync()
    {
        try
        {
            var token = await AuthService.GetTokenAsync();
            if (string.IsNullOrEmpty(token)) return false;
            
            var handler = new System.IdentityModel.Tokens.Jwt.JwtSecurityTokenHandler();
            var jwtToken = handler.ReadJwtToken(token);
            
            var email = jwtToken.Claims.FirstOrDefault(c => 
                c.Type == "email" || 
                c.Type == "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress")?.Value;
                
            return email != null && email.EndsWith("@buildsmart.guest", StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            return false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        AppServiceLocator.ToastAction = async (message, type, actionUrl) =>
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("window.showBuildSmartToast", message, type, actionUrl);
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"[MainLayout] Toast invoke failed: {ex.Message}");
            }
        };

        SignalRService.NotificationReceived += OnNotificationReceived;
        SignalRService.NotificationsStateChanged += OnNotificationsStateChanged;
        SignalRService.ProjectMessageReceived += OnProjectMessageReceived;
        NavManager.LocationChanged += OnLocationChanged;

        NavigationRegistry.CurrentManager = NavManager;
        if (!string.IsNullOrEmpty(NavigationRegistry.PendingRoute))
        {
            var pending = NavigationRegistry.PendingRoute;
            NavigationRegistry.PendingRoute = null;
            NavManager.NavigateTo(pending);
        }
        NavigationRegistry.GoBackAction = async () =>
        {
            await JSRuntime.InvokeVoidAsync("window.history.back");
        };

        // Determine guest status from token synchronously (without network requests)
        _isGuest = await CheckIsGuestFromTokenAsync();
        if (_isGuest)
        {
            // Parse projectId from current URL query parameters synchronously
            var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
            if (query.TryGetValue("projectId", out var projIdStr) && Guid.TryParse(projIdStr, out var parsedId))
            {
                _supportProjectId = parsedId;
            }
            EnforceGuestRestrictions();
        }
        
        await LoadUnreadStatusAsync();
        await LoadProjectsStatusAsync();
        
        try
        {
            var userResult = await ApiClient.GetCurrentUser.ExecuteAsync();
            if (userResult.Data?.CurrentUser != null)
            {
                var user = userResult.Data.CurrentUser;
                _userName = $"{user.FirstName} {user.LastName}";
                _userEmail = user.Email;
                _userProfilePictureUrl = user.ProfilePictureUrl;
                _isGuest = _userEmail != null && _userEmail.EndsWith("@buildsmart.guest", StringComparison.OrdinalIgnoreCase);
                
                if (_isGuest)
                {
                    var projectsResult = await ApiClient.GetMyProjects.ExecuteAsync();
                    if (projectsResult.Errors.Count == 0 && projectsResult.Data?.MyProjects != null)
                    {
                        var supportProj = projectsResult.Data.MyProjects.FirstOrDefault(p => p.Title == "Support Chat");
                        if (supportProj != null)
                        {
                            _supportProjectId = supportProj.Id;
                        }
                    }
                    EnforceGuestRestrictions();
                }
                
                _ = SignalRService.ConnectAsync();
                
                var preferredLang = user.PreferredLanguage;
                var currentCulture = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
                
                if (!string.IsNullOrEmpty(preferredLang) && preferredLang != currentCulture && !_hasAttemptedLanguageSync)
                {
                    // We defer the force reload to OnAfterRenderAsync where we can safely set the cookie via JSInterop
                    _currentLang = preferredLang;
                }
                else
                {
                    _currentLang = currentCulture;
                }
            }
            else
            {
                _currentLang = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Error loading user profile: {ex.Message}");
            _currentLang = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
        }
        finally
        {
            _isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!string.IsNullOrEmpty(ApiConfig.ClarityProjectId))
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("initializeClarity", ApiConfig.ClarityProjectId);
                }
                catch (Exception)
                {
                    // Prevent errors in testing or pre-rendering from breaking execution
                }
            }

            if (!string.IsNullOrEmpty(ApiConfig.PostHogApiKey))
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("initializePostHog", ApiConfig.PostHogApiKey, ApiConfig.PostHogApiHost);
                }
                catch (Exception)
                {
                    // Prevent errors in testing or pre-rendering from breaking execution
                }
            }

            // Load preferred language from localStorage first to apply it instantly
            try
            {
                var savedLang = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "preferred_language");
                if (!string.IsNullOrEmpty(savedLang))
                {
                    var culture = new System.Globalization.CultureInfo(savedLang);
                    System.Globalization.CultureInfo.CurrentCulture = culture;
                    System.Globalization.CultureInfo.CurrentUICulture = culture;
                    System.Globalization.CultureInfo.DefaultThreadCurrentCulture = culture;
                    System.Globalization.CultureInfo.DefaultThreadCurrentUICulture = culture;
                    System.Threading.Thread.CurrentThread.CurrentCulture = culture;
                    System.Threading.Thread.CurrentThread.CurrentUICulture = culture;
                    _currentLang = savedLang;
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[MainLayout] Failed to load language from localStorage: {ex.Message}");
            }

            try
            {
                var userResult = await ApiClient.GetCurrentUser.ExecuteAsync();
                if (userResult.Data?.CurrentUser != null)
                {
                    if (!string.IsNullOrEmpty(userResult.Data.CurrentUser.PreferredTheme))
                    {
                        var theme = userResult.Data.CurrentUser.PreferredTheme;
                        if (theme != "system")
                        {
                            await JSRuntime.InvokeVoidAsync("document.documentElement.setAttribute", "data-theme", theme);
                        }
                        
                        await JSRuntime.InvokeVoidAsync("setCookie", "user_theme", theme, 365);
                    }

                    var preferredLang = userResult.Data.CurrentUser.PreferredLanguage;
                    var currentCulture = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
                    
                    if (!string.IsNullOrEmpty(preferredLang) && preferredLang != currentCulture)
                    {
                        var culture = new System.Globalization.CultureInfo(preferredLang);
                        System.Globalization.CultureInfo.CurrentCulture = culture;
                        System.Globalization.CultureInfo.CurrentUICulture = culture;
                        System.Globalization.CultureInfo.DefaultThreadCurrentCulture = culture;
                        System.Globalization.CultureInfo.DefaultThreadCurrentUICulture = culture;
                        System.Threading.Thread.CurrentThread.CurrentCulture = culture;
                        System.Threading.Thread.CurrentThread.CurrentUICulture = culture;
                        _currentLang = preferredLang;
                        
                        var cookieValue = $"c={preferredLang}|uic={preferredLang}";
                        await JSRuntime.InvokeVoidAsync("setCookie", ".AspNetCore.Culture", cookieValue, 365);
                        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "preferred_language", preferredLang);

                        // Save to MAUI Preferences via reflection if running in MAUI
                        try
                        {
                            var preferencesType = Type.GetType("Microsoft.Maui.Storage.Preferences, Microsoft.Maui");
                            if (preferencesType != null)
                            {
                                var defaultProperty = preferencesType.GetProperty("Default");
                                if (defaultProperty != null)
                                {
                                    var defaultPreferences = defaultProperty.GetValue(null);
                                    if (defaultPreferences != null)
                                    {
                                        var setMethod = defaultPreferences.GetType().GetMethod("Set", new[] { typeof(string), typeof(string) });
                                        if (setMethod != null)
                                        {
                                            setMethod.Invoke(defaultPreferences, new object[] { "preferred_language", preferredLang });
                                        }
                                    }
                                }
                            }
                        }
                        catch (Exception ex)
                        {
                            Console.WriteLine($"[MainLayout] Failed to save database preference to MAUI Preferences: {ex.Message}");
                        }

                        // Force reload to apply language startup-wide
                        NavManager.NavigateTo(NavManager.Uri, forceLoad: true);
                    }
                }
            }
            catch (Exception)
            {
                // Ignore errors during initial theme load
            }
        }
    }

    private void ToggleSidebar()
    {
        _isSidebarOpen = !_isSidebarOpen;
    }

    private void CloseSidebar()
    {
        _isSidebarOpen = false;
    }

    private bool _showAuthModal = false;
    private bool _showLogoutModal = false;
    private string? _pendingNavigationRoute;

    private void Navigate(string route)
    {
        CloseSidebar();
        
        bool isRestricted = route.Contains("/my-projects") || 
                            route.Contains("/user-profile") || 
                            route.Contains("/job-wizard");
                            
        if (isRestricted && AuthService != null && !AuthService.IsAuthenticated)
        {
            _pendingNavigationRoute = route;
            _showAuthModal = true;
            StateHasChanged();
            return;
        }

        NavigationBridge.NavigateToAsync(route);
    }

    private void OnAuthConfirmationChanged(bool proceed)
    {
        _showAuthModal = false;
        if (proceed && !string.IsNullOrEmpty(_pendingNavigationRoute))
        {
            NavigationBridge.NavigateToAsync(_pendingNavigationRoute);
        }
        _pendingNavigationRoute = null;
        StateHasChanged();
    }

    private void ShowLogoutConfirmation()
    {
        CloseSidebar();
        _showLogoutModal = true;
        StateHasChanged();
    }

    private async Task OnLogoutConfirmationChanged(bool confirmed)
    {
        _showLogoutModal = false;
        if (confirmed)
        {
            await LogoutAsync();
        }
        StateHasChanged();
    }

    private async Task LogoutAsync()
    {
        // 1. Clear StrawberryShake GraphQL cache
        try 
        { 
            StoreAccessor.OperationStore.Clear(); 
        } 
        catch { }

        // 2. Clear Auth Session Token
        await AuthService.ClearTokenAsync();
        
        // Notify the Blazor authentication system that the user is now anonymous
        if (AuthStateProvider is MauiAuthenticationStateProvider mauiProvider)
        {
            mauiProvider.NotifyAuthenticationStateChanged();
        }
        
        await BuildSmart.SharedUI.MauiMocks.MainThread.InvokeOnMainThreadAsync(() =>
        {
            NavigationBridge.NavigateToAsync("//LoginPage");
        });
    }

    private async Task LoadUnreadStatusAsync()
    {
        try
        {
            try { StoreAccessor.OperationStore.Clear(); } catch { }
            var result = await ApiClient.GetMyNotifications.ExecuteAsync();
            if (result.Errors.Count == 0 && result.Data?.MyNotifications != null)
            {
                _hasUnreadNotifications = result.Data.MyNotifications.Any(n => !n.IsRead);
                _hasUnreadChatMessages = result.Data.MyNotifications.Any(n => !n.IsRead && n.RelatedEntityType == "Project");
            }
        }
        catch { }
    }

    private async Task LoadProjectsStatusAsync()
    {
        try
        {
            var result = await ApiClient.GetMyProjects.ExecuteAsync();
            if (result.Errors.Count == 0 && result.Data?.MyProjects != null)
            {
                _hasProjects = result.Data.MyProjects.Any(p => p.Title != "Support Chat");
            }
            else
            {
                _hasProjects = false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Error loading project status: {ex.Message}");
            _hasProjects = false;
        }
    }

    private void OnNotificationReceived(string title, string msg, object? data)
    {
        InvokeAsync(async () =>
        {
            await LoadUnreadStatusAsync();
            await LoadProjectsStatusAsync();
            StateHasChanged();
        });
    }

    private void OnNotificationsStateChanged()
    {
        InvokeAsync(async () =>
        {
            await LoadUnreadStatusAsync();
            await LoadProjectsStatusAsync();
            StateHasChanged();
        });
    }

    private void OnProjectMessageReceived(System.Text.Json.JsonElement payload)
    {
        InvokeAsync(async () =>
        {
            await LoadUnreadStatusAsync();
            await LoadProjectsStatusAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        AppServiceLocator.ToastAction = null;
        SignalRService.NotificationReceived -= OnNotificationReceived;
        SignalRService.NotificationsStateChanged -= OnNotificationsStateChanged;
        SignalRService.ProjectMessageReceived -= OnProjectMessageReceived;
        NavManager.LocationChanged -= OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        EnforceGuestRestrictions();
        InvokeAsync(async () =>
        {
            await LoadUnreadStatusAsync();
            await LoadProjectsStatusAsync();
            StateHasChanged();
        });
    }

    private void EnforceGuestRestrictions()
    {
        if (_isGuest)
        {
            try
            {
                var relative = NavManager.ToBaseRelativePath(NavManager.Uri);
                var path = relative.Split('?')[0].Trim('/');
                
                if (path.Equals("login", StringComparison.OrdinalIgnoreCase) || path.Equals("create-account", StringComparison.OrdinalIgnoreCase))
                {
                    // Clean up guest session and let the login/register page load normally
                    _isGuest = false;
                    _supportProjectId = null;
                    _userEmail = null;
                    _userName = null;
                    _userProfilePictureUrl = null;
                    
                    // Run async logout tasks in background
                    _ = Task.Run(async () =>
                    {
                        await AuthService.ClearTokenAsync();
                        if (AuthStateProvider is MauiAuthenticationStateProvider mauiProvider)
                        {
                            mauiProvider.NotifyAuthenticationStateChanged();
                        }
                    });
                    return;
                }
                
                bool isAllowedPage = path.Equals("privacy", StringComparison.OrdinalIgnoreCase) ||
                                     path.Equals("terms", StringComparison.OrdinalIgnoreCase) ||
                                     path.Equals("project-messages", StringComparison.OrdinalIgnoreCase);
                                     
                if (!isAllowedPage)
                {
                    if (_supportProjectId.HasValue)
                    {
                        NavManager.NavigateTo($"/project-messages?projectId={_supportProjectId.Value}");
                    }
                    else
                    {
                        NavManager.NavigateTo("/project-messages");
                    }
                }
                else if (path.Equals("project-messages", StringComparison.OrdinalIgnoreCase) && !_supportProjectId.HasValue)
                {
                    // Check if we can parse the projectId from URL query parameters synchronously
                    var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
                    var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
                    if (query.TryGetValue("projectId", out var projIdStr) && Guid.TryParse(projIdStr, out var parsedId))
                    {
                        _supportProjectId = parsedId;
                    }
                }
                else if (path.Equals("project-messages", StringComparison.OrdinalIgnoreCase) && _supportProjectId.HasValue)
                {
                    // If they are on the chat page but the URL doesn't have the correct projectId query parameter, redirect them to the correct one
                    var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
                    var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
                    if (!query.TryGetValue("projectId", out var projIdStr) || !Guid.TryParse(projIdStr, out var parsedId) || parsedId != _supportProjectId.Value)
                    {
                        NavManager.NavigateTo($"/project-messages?projectId={_supportProjectId.Value}");
                    }
                }
            }
            catch { }
        }
    }

    private bool IsActivePage(string route)
    {
        try
        {
            var relative = NavManager.ToBaseRelativePath(NavManager.Uri);
            var path = relative.Split('?')[0].Trim('/');
            return path.Equals(route.Trim('/'), StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            return false;
        }
    }

    private bool IsChatActive()
    {
        return IsActivePage("/project-messages") || IsActivePage("/admin-support-chats");
    }

    private async Task NavigateToChat()
    {
        CloseSidebar();
        
        bool isAdmin = false;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            isAdmin = user.IsInRole("Admin") || user.IsInRole("ADMIN") || user.IsInRole("admin");
        }
        catch { }

        if (isAdmin)
        {
            NavigationBridge.NavigateToAsync("/admin-support-chats");
            return;
        }

        try
        {
            Guid? targetProjectId = null;
            try
            {
                var notesResult = await ApiClient.GetMyNotifications.ExecuteAsync();
                if (notesResult.Errors.Count == 0 && notesResult.Data?.MyNotifications != null)
                {
                    // 1. Try to find the latest unread project chat notification
                    var unreadChat = notesResult.Data.MyNotifications
                        .Where(n => !n.IsRead && n.RelatedEntityType == "Project" && n.RelatedEntityId.HasValue)
                        .OrderByDescending(n => n.CreatedAt)
                        .FirstOrDefault();

                    if (unreadChat != null)
                    {
                        targetProjectId = unreadChat.RelatedEntityId;
                    }
                    else
                    {
                        // 2. Fallback to any past project chat notifications (including read ones) to find the most recently active chat
                        var anyChat = notesResult.Data.MyNotifications
                            .Where(n => n.RelatedEntityType == "Project" && n.RelatedEntityId.HasValue)
                            .OrderByDescending(n => n.CreatedAt)
                            .FirstOrDefault();

                        if (anyChat != null)
                        {
                            targetProjectId = anyChat.RelatedEntityId;
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[MainLayout] Error checking notifications for chat navigation: {ex.Message}");
            }

            var result = await ApiClient.GetMyProjects.ExecuteAsync();
            if (result.Errors.Count == 0 && result.Data?.MyProjects != null)
            {
                var projects = result.Data.MyProjects;
                
                // Find all projects that could have a chat room (excluding "Support Chat" which is for anonymous guests)
                var actualProjects = projects.Where(p => p.Title != "Support Chat").ToList();
                if (actualProjects.Any())
                {
                    // 1. If targetProjectId from notifications exists and is in projects, navigate to it
                    if (targetProjectId.HasValue && actualProjects.Any(p => p.Id == targetProjectId.Value))
                    {
                        NavigationBridge.NavigateToAsync($"/project-messages?projectId={targetProjectId.Value}");
                        return;
                    }

                    // 2. Otherwise, look for any support project that starts with "Support - "
                    var supportChat = actualProjects.FirstOrDefault(p => p.Title.StartsWith("Support - "));
                    if (supportChat != null)
                    {
                        NavigationBridge.NavigateToAsync($"/project-messages?projectId={supportChat.Id}");
                        return;
                    }

                    // 3. Fallback: navigate to the user's most recently created project
                    var latestProject = actualProjects.OrderByDescending(p => p.CreatedAt).First();
                    NavigationBridge.NavigateToAsync($"/project-messages?projectId={latestProject.Id}");
                    return;
                }
            }

            // Fallback: If no projects started, redirect to my projects list
            NavigationBridge.NavigateToAsync("/my-projects");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Error in NavigateToChat: {ex.Message}");
            NavigationBridge.NavigateToAsync("/my-projects");
        }
    }
}


