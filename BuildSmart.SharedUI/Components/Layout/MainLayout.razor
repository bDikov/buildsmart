    private void Navigate(string route)
    {
        CloseSidebar();
        
        bool isRestricted = route.Contains("/user-profile") || 
                            route.Contains("/job-wizard");
                            
        bool isMyProjects = route.Contains("/my-projects");

        bool needsLogin = false;
        if (AuthService != null && !route.StartsWith("/login", StringComparison.OrdinalIgnoreCase))
        {
            if (!AuthService.IsAuthenticated && (isRestricted || isMyProjects))
            {
                needsLogin = true;
            }
            else if (_isGuest && isRestricted)
            {
                needsLogin = true;
            }
        }
                            
        if (needsLogin)
        {
            _pendingNavigationRoute = route;
            _showAuthModal = true;
            StateHasChanged();
            return;
        }

        NavigationBridge.NavigateToAsync(route);
    }

