        AdminPerspectiveService.PerspectiveChanged += OnAdminPerspectiveChanged;
    }

    private void OnAdminPerspectiveChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task<bool> CheckIsGuestFromTokenAsync()
    {
        try
        {
            var token = await AuthService.GetTokenAsync();
            if (string.IsNullOrEmpty(token)) return false;
            
            var handler = new System.IdentityModel.Tokens.Jwt.JwtSecurityTokenHandler();
            var jwtToken = handler.ReadJwtToken(token);
            
            var email = jwtToken.Claims.FirstOrDefault(c => 
                c.Type == "email" || 
                c.Type == "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress")?.Value;
                
            return email != null && email.EndsWith("@buildsmart.guest", StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            return false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        AppServiceLocator.ToastAction = async (message, type, actionUrl) =>
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("window.showBuildSmartToast", message, type, actionUrl);
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"[MainLayout] Toast invoke failed: {ex.Message}");
            }
        };

        SignalRService.NotificationReceived += OnNotificationReceived;
        SignalRService.NotificationsStateChanged += OnNotificationsStateChanged;
        SignalRService.ProjectMessageReceived += OnProjectMessageReceived;
        NavManager.LocationChanged += OnLocationChanged;

        NavigationRegistry.CurrentManager = NavManager;
        if (!string.IsNullOrEmpty(NavigationRegistry.PendingRoute))
        {
            var pending = NavigationRegistry.PendingRoute;
            NavigationRegistry.PendingRoute = null;
            NavManager.NavigateTo(pending);
        }
        NavigationRegistry.GoBackAction = async () =>
        {
            await JSRuntime.InvokeVoidAsync("window.history.back");
        };

        // Determine guest status from token synchronously (without network requests)
        _isGuest = await CheckIsGuestFromTokenAsync();
        if (_isGuest)
        {
            // Parse projectId from current URL query parameters synchronously
            var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
            if (query.TryGetValue("projectId", out var projIdStr) && Guid.TryParse(projIdStr, out var parsedId))
            {
                _supportProjectId = parsedId;
            }
            EnforceGuestRestrictions();
        }
        
        await LoadUnreadStatusAsync();
        await LoadProjectsStatusAsync();
        
        try
        {
            var userResult = await ApiClient.GetCurrentUser.ExecuteAsync();
            if (userResult.Data?.CurrentUser != null)
            {
                var user = userResult.Data.CurrentUser;
                _userName = $"{user.FirstName} {user.LastName}";
                _userEmail = user.Email;
                _userProfilePictureUrl = user.ProfilePictureUrl;
                _isGuest = _userEmail != null && _userEmail.EndsWith("@buildsmart.guest", StringComparison.OrdinalIgnoreCase);
                
                if (_isGuest)
                {
                    var projectsResult = await ApiClient.GetMyProjects.ExecuteAsync();
                    if (projectsResult.Errors.Count == 0 && projectsResult.Data?.MyProjects != null)
                    {
                        var supportProj = projectsResult.Data.MyProjects.FirstOrDefault(p => p.Title == "Support Chat");
                        if (supportProj != null)
                        {
                            _supportProjectId = supportProj.Id;
                        }
                    }
                    EnforceGuestRestrictions();
                }
                
                _ = SignalRService.ConnectAsync();
                
                var preferredLang = user.PreferredLanguage;
                var currentCulture = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
                
                if (!string.IsNullOrEmpty(preferredLang) && preferredLang != currentCulture && !_hasAttemptedLanguageSync)
                {
                    // We defer the force reload to OnAfterRenderAsync where we can safely set the cookie via JSInterop
                    _currentLang = preferredLang;
                }
                else
                {
                    _currentLang = currentCulture;
                }
            }
            else
            {
                _currentLang = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Error loading user profile: {ex.Message}");
            _currentLang = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
        }
        finally
        {
            _isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!string.IsNullOrEmpty(ApiConfig.ClarityProjectId))
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("initializeClarity", ApiConfig.ClarityProjectId);
                }
                catch (Exception)
                {
                    // Prevent errors in testing or pre-rendering from breaking execution
                }
            }

            if (!string.IsNullOrEmpty(ApiConfig.GoogleTagManagerId))
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("initializeGTM", ApiConfig.GoogleTagManagerId);
                }
                catch (Exception)
                {
                    // Prevent errors in testing or pre-rendering from breaking execution
                }
            }

            if (!string.IsNullOrEmpty(ApiConfig.PostHogApiKey))
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("initializePostHog", ApiConfig.PostHogApiKey, ApiConfig.PostHogApiHost);
                }
                catch (Exception)
                {
                    // Prevent errors in testing or pre-rendering from breaking execution
                }
            }

            // Load preferred language from localStorage first to apply it instantly
            try
            {
                var savedLang = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "preferred_language");
                if (!string.IsNullOrEmpty(savedLang))
                {
                    var culture = new System.Globalization.CultureInfo(savedLang);
                    System.Globalization.CultureInfo.CurrentCulture = culture;
                    System.Globalization.CultureInfo.CurrentUICulture = culture;
                    System.Globalization.CultureInfo.DefaultThreadCurrentCulture = culture;
                    System.Globalization.CultureInfo.DefaultThreadCurrentUICulture = culture;
                    System.Threading.Thread.CurrentThread.CurrentCulture = culture;
                    System.Threading.Thread.CurrentThread.CurrentUICulture = culture;
                    _currentLang = savedLang;
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[MainLayout] Failed to load language from localStorage: {ex.Message}");
            }

            try
            {
                var userResult = await ApiClient.GetCurrentUser.ExecuteAsync();
                if (userResult.Data?.CurrentUser != null)
                {
                    // Identify user in PostHog
                    if (!string.IsNullOrEmpty(ApiConfig.PostHogApiKey))
                    {
                        try
                        {
                            var user = userResult.Data.CurrentUser;
                            var userId = user.Id.ToString();
                            var email = user.Email;
                            var name = $"{user.FirstName} {user.LastName}";
                            
                            var properties = new Dictionary<string, object>();
                            if (!string.IsNullOrEmpty(email)) properties["email"] = email;
