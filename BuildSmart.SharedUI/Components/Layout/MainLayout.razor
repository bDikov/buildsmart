    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        EnforceGuestRestrictions();
        InvokeAsync(async () =>
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("reelsObserver.closeTheaterMode");
            }
            catch { }
            await LoadUnreadStatusAsync();
            await LoadProjectsStatusAsync();
            StateHasChanged();
        });
    }

    private void EnforceGuestRestrictions()
    {
        if (_isGuest)
        {
            try
            {
                var relative = NavManager.ToBaseRelativePath(NavManager.Uri);
                var path = relative.Split('?')[0].Trim('/');
                
                if (path.Equals("login", StringComparison.OrdinalIgnoreCase) || path.Equals("create-account", StringComparison.OrdinalIgnoreCase))
                {
                    // Clean up guest session and let the login/register page load normally
                    _isGuest = false;
                    _supportProjectId = null;
                    _userEmail = null;
                    _userName = null;
                    _userProfilePictureUrl = null;
                    
                    // Run async logout tasks in background
                    _ = Task.Run(async () =>
                    {
                        await AuthService.ClearTokenAsync();
                        if (AuthStateProvider is MauiAuthenticationStateProvider mauiProvider)
                        {
                            mauiProvider.NotifyAuthenticationStateChanged();
                        }
                    });
                    return;
                }
                
                bool isAllowedPage = path.Equals("privacy", StringComparison.OrdinalIgnoreCase) ||
                                     path.Equals("terms", StringComparison.OrdinalIgnoreCase) ||
                                     path.Equals("project-messages", StringComparison.OrdinalIgnoreCase) ||
                                     path.Equals("feed", StringComparison.OrdinalIgnoreCase) ||
                                     path.Equals("my-projects", StringComparison.OrdinalIgnoreCase) ||
                                     path.Equals("project-detail", StringComparison.OrdinalIgnoreCase) ||
                                     string.IsNullOrEmpty(path);
                                     
                if (!isAllowedPage)
                {
                    if (path.Equals("job-wizard", StringComparison.OrdinalIgnoreCase) || path.Equals("user-profile", StringComparison.OrdinalIgnoreCase))
                    {
                        var returnUrl = Uri.EscapeDataString("/" + relative);
                        NavManager.NavigateTo($"/login?ReturnUrl={returnUrl}");
                    }
                    else if (_supportProjectId.HasValue)
                    {
                        NavManager.NavigateTo($"/project-messages?projectId={_supportProjectId.Value}");
                    }
                    else
                    {
                        NavManager.NavigateTo("/project-messages");
                    }
                }
                else if (path.Equals("project-messages", StringComparison.OrdinalIgnoreCase) && !_supportProjectId.HasValue)
                {
                    // Check if we can parse the projectId from URL query parameters synchronously
                    var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
                    var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
                    if (query.TryGetValue("projectId", out var projIdStr) && Guid.TryParse(projIdStr, out var parsedId))
                    {
                        _supportProjectId = parsedId;
                    }
                }
                else if (path.Equals("project-messages", StringComparison.OrdinalIgnoreCase) && _supportProjectId.HasValue)
                {
                    // If they are on the chat page but the URL doesn't have the correct projectId query parameter, redirect them to the correct one
                    var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
                    var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
                    if (!query.TryGetValue("projectId", out var projIdStr) || !Guid.TryParse(projIdStr, out var parsedId) || parsedId != _supportProjectId.Value)
                    {
                        NavManager.NavigateTo($"/project-messages?projectId={_supportProjectId.Value}");
                    }
                }
            }
            catch { }
        }
    }

    private bool IsActivePage(string route)
    {
        try
        {
            var relative = NavManager.ToBaseRelativePath(NavManager.Uri);
            var path = relative.Split('?')[0].Trim('/');
            
            // In Blazor Hybrid (MAUI), paths might be prefixed with "index.html"
            if (path.StartsWith("index.html/", StringComparison.OrdinalIgnoreCase))
            {
                path = path.Substring("index.html/".Length);
            }
            else if (path.Equals("index.html", StringComparison.OrdinalIgnoreCase))
            {
                path = "";
            }
            
            return path.Equals(route.Trim('/'), StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            return false;
        }
    }

    private bool IsChatActive()
    {
        return IsActivePage("/project-messages") || IsActivePage("/admin-support-chats");
    }

    private async Task NavigateToChat()
    {
        CloseSidebar();
        
        bool isAdmin = false;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            isAdmin = user.IsInRole("Admin") || user.IsInRole("ADMIN") || user.IsInRole("admin");
        }
        catch { }

        if (isAdmin)
        {
            NavigationBridge.NavigateToAsync("/admin-support-chats");
            return;
        }

        try
        {
            Guid? targetProjectId = null;
            try
            {
                var notesResult = await ApiClient.GetMyNotifications.ExecuteAsync();
                if (notesResult.Errors.Count == 0 && notesResult.Data?.MyNotifications != null)
                {
                    // 1. Try to find the latest unread project chat notification
                    var unreadChat = notesResult.Data.MyNotifications
                        .Where(n => !n.IsRead && n.RelatedEntityType == "Project" && n.RelatedEntityId.HasValue)
                        .OrderByDescending(n => n.CreatedAt)
                        .FirstOrDefault();

                    if (unreadChat != null)
                    {
                        targetProjectId = unreadChat.RelatedEntityId;
                    }
                    else
                    {
                        // 2. Fallback to any past project chat notifications (including read ones) to find the most recently active chat
                        var anyChat = notesResult.Data.MyNotifications
                            .Where(n => n.RelatedEntityType == "Project" && n.RelatedEntityId.HasValue)
                            .OrderByDescending(n => n.CreatedAt)
                            .FirstOrDefault();

                        if (anyChat != null)
                        {
                            targetProjectId = anyChat.RelatedEntityId;
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[MainLayout] Error checking notifications for chat navigation: {ex.Message}");
            }

            // If we have a target project ID from notifications, navigate to it directly (works for both Homeowners and Tradesmen!)
            if (targetProjectId.HasValue)
            {
                NavigationBridge.NavigateToAsync($"/project-messages?projectId={targetProjectId.Value}");
                return;
            }

            var result = await ApiClient.GetMyProjects.ExecuteAsync();
            if (result.Errors.Count == 0 && result.Data?.MyProjects != null)
            {
                var projects = result.Data.MyProjects;
                
                // Find all projects that could have a chat room (excluding "Support Chat" which is for anonymous guests)
                var actualProjects = projects.Where(p => p.Title != "Support Chat").ToList();
                if (actualProjects.Any())
                {
                    // 1. Look for any support project that starts with "Support - "
                    var supportChat = actualProjects.FirstOrDefault(p => p.Title.StartsWith("Support - "));
                    if (supportChat != null)
                    {
                        NavigationBridge.NavigateToAsync($"/project-messages?projectId={supportChat.Id}");
                        return;
                    }

                    // 2. Fallback: navigate to the user's most recently created project
                    var latestProject = actualProjects.OrderByDescending(p => p.CreatedAt).First();
                    NavigationBridge.NavigateToAsync($"/project-messages?projectId={latestProject.Id}");
                    return;
                }
            }

            // Fallback: If no projects started, redirect to projects page
            NavigationBridge.NavigateToAsync("/my-projects");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Error in NavigateToChat: {ex.Message}");
            NavigationBridge.NavigateToAsync("/my-projects");
        }
    }

    private async Task NavigateToSupportChatForAuthenticatedUser()
    {
        if (_isStartingChat) return;
        _isStartingChat = true;
        StateHasChanged();

        try
        {
            var projectsResult = await ApiClient.GetMyProjects.ExecuteAsync();
            if (projectsResult.Errors.Count == 0 && projectsResult.Data?.MyProjects != null)
            {
                var projects = projectsResult.Data.MyProjects;
                
                // Find any support project that starts with "Support - " or is exactly "Support Chat"
                var supportChat = projects.FirstOrDefault(p => p.Title.StartsWith("Support - ") || p.Title == "Support Chat");
                if (supportChat != null)
                {
                    _isStartingChat = false;
                    StateHasChanged();
                    NavigationBridge.NavigateToAsync($"/project-messages?projectId={supportChat.Id}");
                    return;
                }
            }

            // Create a new support project for this authenticated user
            var userResult = await ApiClient.GetCurrentUser.ExecuteAsync();
            if (userResult.Errors.Count == 0 && userResult.Data?.CurrentUser != null)
            {
                var user = userResult.Data.CurrentUser;
                var currentUserId = Guid.Parse(user.Id);
                var title = $"Support - {user.FirstName} {user.LastName}";
                var desc = $"Support session for {user.FirstName} {user.LastName} ({user.Email})";
                var lang = _currentLang ?? "bg";

                var createResult = await ApiClient.CreateProject.ExecuteAsync(currentUserId, title, desc, lang);
                if (createResult.Errors.Count == 0 && createResult.Data?.CreateProject != null)
                {
                    var newProject = createResult.Data.CreateProject;
                    _isStartingChat = false;
                    StateHasChanged();
                    NavigationBridge.NavigateToAsync($"/project-messages?projectId={newProject.Id}");
                    return;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Error creating support chat: {ex.Message}");
        }

        _isStartingChat = false;
        StateHasChanged();
        
        // Fallback: go to latest project
        await NavigateToChat();
    }

    private async Task HandleSupportChatClick()
    {
        CloseSidebar();

        // 1. If already a guest with a support project, go directly to it
        if (_isGuest && _supportProjectId.HasValue)
        {
            NavManager.NavigateTo($"/project-messages?projectId={_supportProjectId.Value}");
            return;
        }

        // 2. If admin, go to admin support board
        bool isAdmin = false;
        bool isAuthenticated = false;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            isAuthenticated = user.Identity?.IsAuthenticated == true;
            isAdmin = user.IsInRole("Admin") || user.IsInRole("ADMIN") || user.IsInRole("admin");
        }
        catch { }

        if (isAdmin)
        {
            NavigationBridge.NavigateToAsync("/admin-support-chats");
            return;
        }

        // 3. If authenticated regular user, navigate to support chat or create one
        if (isAuthenticated)
        {
            await NavigateToSupportChatForAuthenticatedUser();
            return;
        }

        // 4. Otherwise, start an anonymous support chat session (guest)
        if (_isStartingChat) return;
        _isStartingChat = true;
        StateHasChanged();

        try
        {
            var result = await ApiClient.StartAnonymousSupportChat.ExecuteAsync();
            if (result.Errors.Count == 0 && result.Data?.StartAnonymousSupportChat != null)
            {
                var payload = result.Data.StartAnonymousSupportChat;
                await AuthService.SaveTokenAsync(payload.Token);
                NavManager.NavigateTo($"/project-messages?projectId={payload.ProjectId}", forceLoad: true);
            }
            else
            {
                var error = result.Errors.FirstOrDefault()?.Message ?? "Failed to start support chat.";
                System.Diagnostics.Debug.WriteLine($"[MainLayout] Error starting chat: {error}");
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[MainLayout] Exception starting chat: {ex.Message}");
        }
        finally
        {
            _isStartingChat = false;
            StateHasChanged();
        }
    }

    private void ToggleLangDropdown()
    {
        _isLangDropdownOpen = !_isLangDropdownOpen;
    }

    private async Task SelectLanguageAsync(string lang)
    {
        _isLangDropdownOpen = false;
        if (_currentLang == lang) return;
        
        _currentLang = lang;
        
        try
        {
            var cookieValue = $"c={lang}|uic={lang}";
            await JSRuntime.InvokeVoidAsync("setCookie", ".AspNetCore.Culture", cookieValue, 365);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "preferred_language", lang);
            
            var culture = new System.Globalization.CultureInfo(lang);
            System.Globalization.CultureInfo.CurrentCulture = culture;
            System.Globalization.CultureInfo.CurrentUICulture = culture;
            System.Globalization.CultureInfo.DefaultThreadCurrentCulture = culture;
            System.Globalization.CultureInfo.DefaultThreadCurrentUICulture = culture;
            System.Threading.Thread.CurrentThread.CurrentCulture = culture;
            System.Threading.Thread.CurrentThread.CurrentUICulture = culture;

            if (AuthService.IsAuthenticated)
            {
                await ApiClient.UpdateUserLanguage.ExecuteAsync(lang);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Failed to switch language: {ex.Message}");
        }

        NavManager.NavigateTo(NavManager.Uri, forceLoad: true);
    }

