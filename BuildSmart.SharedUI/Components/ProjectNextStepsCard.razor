@using BuildSmart.SharedUI.GraphQL
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime

@if (Project != null)
{
    bool hasJobWaitingForUserReview = Project.JobPosts != null && Project.JobPosts.Any(j => j.Status == JobPostStatus.WaitingForUserReview);
    bool isMasterOfferReady = Project.HasOfferPdf && Project.JobPosts != null && Project.JobPosts.Any() &&
        !Project.JobPosts.Any(jp => 
            jp.Status == JobPostStatus.Draft || 
            jp.Status == JobPostStatus.GeneratingScope || 
            jp.Status == JobPostStatus.Rejected);
    bool showSubmitCard = (Project.Status != ProjectStatus.UnderReview) || hasJobWaitingForUserReview;
    bool isSubmitCardActive = isMasterOfferReady;

    @if (Project.JobPosts != null && Project.JobPosts.Any())
    {
        <h3 id="next-steps-section" class="section-title mt-4">@Loc["ProjectDetail_NextSteps_Title"]</h3>
        
        <div class="next-steps-grid">
            @if (isMasterOfferReady)
            {
                <!-- Download Offer Card -->
                <div class="bs-card next-step-card" style="border-left: 4px solid var(--color-primary);">
                     <div class="d-flex flex-column align-items-center text-center">
                        <h4 class="fw-bold mb-2" style="color: var(--text-primary); font-size: 1.25rem;">@Loc["ProjectDetail_NextSteps_DownloadTitle"]</h4>
                        <p class="mb-4" style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.5;">
                            @Loc["ProjectDetail_NextSteps_DownloadDesc"]
                        </p>
                        <div class="mt-auto w-100">
                            <button class="bs-btn-primary w-100 py-2" style="background-color: var(--color-primary);" @onclick="async () => await OnDownloadMasterOffer.InvokeAsync()">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                    <polyline points="7 10 12 15 17 10"></polyline>
                                    <line x1="12" y1="15" x2="12" y2="3"></line>
                                </svg>
                                @Loc["ProjectDetail_NextSteps_DownloadBtn"]
                            </button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                var draftJobs = Project.JobPosts.Where(jp => jp.Status == JobPostStatus.Draft).ToList();
                @if (draftJobs.Any())
                {
                    <!-- Incomplete Questionnaire Card -->
                    <div class="bs-card next-step-card" style="border-left: 4px solid var(--color-warning);">
                        <div class="d-flex flex-column align-items-center text-center">
                            <h4 class="fw-bold mb-2" style="color: var(--text-primary); font-size: 1.25rem;">@Loc["ProjectDetail_NextSteps_IncompleteTitle"]</h4>
                            <p class="mb-4" style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.5;">
                                @string.Format(Loc["ProjectDetail_NextSteps_IncompleteDesc"], string.Join(", ", draftJobs.Select(j => j.ServiceCategory.Name)))
                            </p>
                            <div class="mt-auto w-100">
                                @{
                                    var firstDraft = draftJobs.First();
                                }
                                <button class="bs-btn-primary w-100 py-2" style="background-color: var(--color-warning); border-color: var(--color-warning);" @onclick='() => NavManager.NavigateTo($"/job-wizard?projectId={Project.Id}&jobId={firstDraft.Id}&targetCategoryId={firstDraft.ServiceCategory.Id}")'>
                                    @Loc["ProjectDetail_NextSteps_IncompleteBtn"]
                                </button>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Generating Scope Card -->
                    <div class="bs-card next-step-card" style="border-left: 4px solid var(--color-primary);">
                        <div class="d-flex flex-column align-items-center text-center">
                            <h4 class="fw-bold mb-2" style="color: var(--text-primary); font-size: 1.25rem;">@Loc["ProjectDetail_NextSteps_GeneratingTitle"]</h4>
                            <p class="mb-4" style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.5;">
                                @Loc["ProjectDetail_NextSteps_GeneratingDesc"]
                            </p>
                            <div class="mt-auto w-100">
                                <button class="bs-btn-dark w-100 py-2" @onclick="ScrollToJobsSection">
                                    @Loc["ProjectDetail_NextSteps_GeneratingBtn"]
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }

            @if (showSubmitCard)
            {
                <!-- Submit to Admin Card -->
                <div class="bs-card next-step-card @(isSubmitCardActive ? "highlighted-cta" : "")" 
                     style="border-left: 4px solid var(--color-success); @(!isSubmitCardActive ? "opacity: 0.65; cursor: not-allowed;" : "")">
                    <div class="d-flex flex-column align-items-center text-center h-100">
                        <h4 class="fw-bold mb-2 @(isSubmitCardActive ? "cta-title-featured" : "")" 
                            style="color: var(--text-primary); font-size: @(isSubmitCardActive ? "1.45rem" : "1.25rem");">
                            @Loc["ProjectDetail_NextSteps_SubmitTitle"]
                            @if (!isSubmitCardActive)
                            {
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ms-2 text-muted" style="vertical-align: middle;">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                            }
                        </h4>
                        <p class="mb-4" style="color: var(--text-secondary); font-size: @(isSubmitCardActive ? "1.02rem" : "0.95rem"); line-height: 1.5;">
                            @Loc["ProjectDetail_NextSteps_SubmitDesc"]
                        </p>
                        <div class="mt-auto w-100">
                            <button class="@(isSubmitCardActive ? "highlighted-cta-btn" : "bs-btn-primary") w-100 py-2" 
                                    disabled="@(!isSubmitCardActive)" 
                                    @onclick="async () => await OnSubmitToAdmin.InvokeAsync()">
                                <span class="d-flex align-items-center justify-content-center gap-2">
                                    @if (isSubmitCardActive)
                                    {
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="button-icon me-1">
                                            <line x1="22" y1="2" x2="11" y2="13"></line>
                                            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                        </svg>
                                    }
                                    @Loc["ProjectDetail_NextSteps_SubmitBtn"]
                                </span>
                            </button>
                        </div>
                    </div>
                </div>
            }
            
            @if (Project.Status == ProjectStatus.UnderReview)
            {
                <!-- Ask Admin Card -->
                <div class="bs-card next-step-card" style="border-left: 4px solid var(--color-warning);">
                    <div class="d-flex flex-column align-items-center text-center">
                        <h4 class="fw-bold mb-2" style="color: var(--text-primary); font-size: 1.25rem;">@Loc["ProjectDetail_NextSteps_AskTitle"]</h4>
                        <p class="mb-4" style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.5;">
                            @Loc["ProjectDetail_NextSteps_AskDesc"]
                        </p>
                        <div class="mt-auto w-100">
                            <button class="bs-btn-dark w-100 py-2" @onclick="async () => await OnAskAdmin.InvokeAsync()">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2">
                                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                                </svg>
                                @Loc["ProjectDetail_NextSteps_AskBtn"]
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

<style>
    /* Theme-aware variables for shadows */
    :root {
        --bs-next-step-shadow: 0px 2px 20px rgba(0, 0, 0, 0.04);
        --bs-next-step-hover-shadow: 0px 8px 24px rgba(0, 0, 0, 0.08);
    }
    
    :root[data-theme='dark'] {
        --bs-next-step-shadow: none;
        --bs-next-step-hover-shadow: none;
    }

    .next-steps-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
        margin-bottom: 24px;
    }
    
    .next-step-card {
        border-radius: 12px;
        border: 1px solid var(--border-color);
        box-shadow: var(--bs-next-step-shadow);
        padding: 24px;
        display: flex;
        flex-direction: column;
        height: 100%;
        margin-bottom: 0 !important; /* override bs-card mb-4 if needed */
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        box-sizing: border-box;
        background-color: var(--bg-card);
    }

    .next-step-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--bs-next-step-hover-shadow);
        background-color: var(--bg-card-alt);
    }

    /* Mobile Carousel Layout */
    @@media (max-width: 768px) {
        .next-steps-grid {
            display: flex;
            flex-wrap: nowrap;
            overflow-x: auto;
            overflow-y: hidden;
            scroll-snap-type: x mandatory;
            scroll-behavior: smooth;
            -webkit-overflow-scrolling: touch;
            padding-bottom: 12px;
            margin-right: -16px; /* Negate parent padding for full bleed */
            margin-left: -16px;
            padding-left: 16px;
            padding-right: 16px;
        }
        
        .next-step-card {
            flex: 0 0 85%;
            scroll-snap-align: center;
        }
        
        .next-step-card:hover {
            transform: none; /* Disable lift on mobile to avoid layout shifts on touch */
        }
        
        /* Add a fake element at the end so the last card doesn't snap to the left edge */
        .next-steps-grid::after {
            content: '';
            flex: 0 0 1px;
        }
        
        /* Hide scrollbar for cleaner look */
        .next-steps-grid::-webkit-scrollbar {
            display: none;
        }
        .next-steps-grid {
            -ms-overflow-style: none;  /* IE and Edge */
            scrollbar-width: none;  /* Firefox */
    }

    @@keyframes bump-card {
        0% {
            transform: scale(1.03);
            box-shadow: 0 10px 28px rgba(16, 185, 129, 0.08), var(--bs-next-step-shadow);
        }
        15% {
            transform: scale(1.05);
            box-shadow: 0 14px 36px rgba(16, 185, 129, 0.16), var(--bs-next-step-shadow);
        }
        30% {
            transform: scale(1.03);
            box-shadow: 0 10px 28px rgba(16, 185, 129, 0.08), var(--bs-next-step-shadow);
        }
        45% {
            transform: scale(1.05);
            box-shadow: 0 14px 36px rgba(16, 185, 129, 0.16), var(--bs-next-step-shadow);
        }
        60%, 100% {
            transform: scale(1.03);
            box-shadow: 0 10px 28px rgba(16, 185, 129, 0.08), var(--bs-next-step-shadow);
        }
    }

    .next-step-card.highlighted-cta {
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.05) 0%, rgba(5, 150, 105, 0.1) 100%) !important;
        border: 1px solid rgba(16, 185, 129, 0.4) !important;
        box-shadow: 0 10px 28px rgba(16, 185, 129, 0.08), var(--bs-next-step-shadow) !important;
        padding: 34px 24px !important;
        border-left: 4px solid var(--color-success) !important;
        transition: border-color 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease !important;
        z-index: 2; /* make sure it stands slightly above neighboring cards */
        animation: bump-card 4s infinite ease-in-out;
    }
    
    [data-theme='dark'] .next-step-card.highlighted-cta {
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, rgba(5, 150, 105, 0.15) 100%) !important;
        border-color: rgba(16, 185, 129, 0.5) !important;
        box-shadow: 0 14px 36px rgba(16, 185, 129, 0.15), var(--bs-next-step-shadow) !important;
    }
    
    .next-step-card.highlighted-cta:hover {
        transform: scale(1.06) translateY(-4px) !important;
        border-color: rgba(16, 185, 129, 0.6) !important;
        box-shadow: 0 18px 40px rgba(16, 185, 129, 0.22), var(--bs-next-step-shadow) !important;
        background-color: transparent !important;
        animation: none !important;
    }

    .cta-title-featured {
        background: linear-gradient(120deg, var(--text-primary) 0%, var(--color-success) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 800 !important;
        letter-spacing: -0.02em;
    }

    .highlighted-cta-btn {
        background-color: var(--color-success) !important;
        border: none !important;
        color: #fff !important;
        font-size: 0.9rem !important;
        font-weight: 700 !important;
        padding: 15px 30px !important;
        border-radius: 12px !important;
        box-shadow: 0 5px 15px rgba(16, 185, 129, 0.25) !important;
        transition: all 0.25s ease !important;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        cursor: pointer;
    }
    
    .highlighted-cta-btn:hover {
        background-color: #059669 !important;
        transform: translateY(-2px);
        box-shadow: 0 8px 22px rgba(16, 185, 129, 0.35) !important;
    }

    .highlighted-cta-btn .button-icon {
        transition: transform 0.25s ease;
    }

    .highlighted-cta-btn:hover .button-icon {
        transform: translate(2px, -2px);
    }
</style>

@code {
    [Parameter, EditorRequired]
    public IProjectDetails Project { get; set; } = default!;

    [Parameter]
    public EventCallback OnSubmitToAdmin { get; set; }

    [Parameter]
    public EventCallback OnDownloadMasterOffer { get; set; }

    [Parameter]
    public EventCallback OnAskAdmin { get; set; }

    private async Task ScrollToJobsSection()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('job-posts-section')?.scrollIntoView({ behavior: 'smooth' })");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to scroll: {ex.Message}");
        }
    }
}