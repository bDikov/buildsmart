@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Authorization
@using BuildSmart.Core.Application.Interfaces
@inject IStringLocalizer<BuildSmart.SharedUI.Resources.AppResources> Loc
@inject IJSRuntime JSRuntime
@inject ICalculatorLeadRepository LeadRepository
@inject AuthenticationStateProvider AuthStateProvider
@inject Microsoft.AspNetCore.Components.NavigationManager NavManager
@inject BuildSmart.SharedUI.Services.IAuthService AuthService
@implements IAsyncDisposable

@if (IsEnabled && _isVisible && !_isAuthenticated)
{
    <div class="bs-interio-modal-overlay" @onclick="CloseModal">
        <div class="bs-interio-modal-card" @onclick:stopPropagation="true">
            <button class="bs-interio-modal-close" @onclick="CloseModal" aria-label="Затвори">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>

            <div class="modal-badge-wrapper">
                <span class="modal-badge">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                    </svg>
                    @Loc["ExitIntent_Badge"]
                </span>
            </div>

            <h3 class="modal-title">@Loc["ExitIntent_Title"]</h3>
            <p class="modal-subtitle">@Loc["ExitIntent_Subtitle"]</p>

            @if (_isSubmitted)
            {
                <div class="modal-success-alert">
                    <div class="success-icon-wrapper">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2.5">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                    </div>
                    <span class="success-msg-text">@Loc["ExitIntent_SuccessMsg"]</span>
                    <button type="button" class="bs-interio-close-btn" @onclick="CloseModal">@Loc["ExitIntent_CloseBtn"]</button>
                </div>
            }
            else
            {
                <!-- Social Quick Access Buttons -->
                <div class="d-flex flex-column gap-2 mb-3">
                    <button type="button" class="google-btn border-0" @onclick="HandleGoogleSocialAccess">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                        </svg>
                        <span>@Loc["Login_GoogleButton"]</span>
                    </button>
                    @if (ApiConfig.EnableFacebookLogin)
                    {
                        <button type="button" class="facebook-btn border-0" @onclick="HandleFacebookSocialAccess">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                            </svg>
                            <span>@Loc["Login_FacebookButton"]</span>
                        </button>
                    }
                </div>

                <!-- Divider -->
                <div class="d-flex align-items-center gap-2 mb-3">
                    <div class="flex-grow-1" style="border-top: 1px solid var(--border-color);"></div>
                    <span class="extra-small text-muted text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.5px;">@Loc["Lander_SocialOrManualDivider"]</span>
                    <div class="flex-grow-1" style="border-top: 1px solid var(--border-color);"></div>
                </div>

                <EditForm Model="_leadModel" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <div class="modal-form-grid">
                        <div class="form-group">
                            <label class="form-label">@Loc["ExitIntent_NameLabel"]</label>
                            <InputText @bind-Value="_leadModel.Name" class="form-control bs-interio-input" placeholder="Ivan Ivanov" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">@Loc["ExitIntent_PhoneLabel"]</label>
                            <InputText @bind-Value="_leadModel.Phone" class="form-control bs-interio-input" placeholder="0888 123 456" />
                        </div>
                        <div class="form-group span-2">
                            <label class="form-label">@Loc["ExitIntent_EmailLabel"]</label>
                            <InputText @bind-Value="_leadModel.Email" class="form-control bs-interio-input" placeholder="ivan@example.com" />
                        </div>
                        <div class="form-group span-2">
                            <label class="form-label">@Loc["ExitIntent_AreaLabel"]</label>
                            <InputNumber @bind-Value="_leadModel.PropertyArea" class="form-control bs-interio-input" placeholder="75" />
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="form-error-msg">@_errorMessage</div>
                    }

                    <button type="submit" class="bs-interio-submit-btn" disabled="@_isSubmitting">
                        @if (_isSubmitting)
                        {
                            <span>@Loc["ExitIntent_SendingBtn"]</span>
                        }
                        else
                        {
                            <span>@Loc["ExitIntent_SubmitBtn"]</span>
                        }
                    </button>
                </EditForm>
            }
        </div>
    </div>
}

<style>
.google-btn {
    background-color: var(--bg-card-alt);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
    width: 100%;
    box-sizing: border-box;
}

.facebook-btn {
    background-color: var(--color-primary);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
    width: 100%;
    box-sizing: border-box;
}

.google-btn:hover {
    background-color: var(--border-color);
    color: var(--text-primary);
    transform: translateY(-1px);
}

.facebook-btn:hover {
    background-color: var(--color-primary-hover);
    transform: translateY(-1px);
}

.bs-interio-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    box-sizing: border-box;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    animation: fadeIn 0.25s ease;
}

.bs-interio-modal-card {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 24px;
    padding: 36px;
    max-width: 540px;
    width: 100%;
    max-height: calc(100vh - 40px);
    max-height: calc(100dvh - 40px);
    overflow-y: auto;
    margin: auto;
    box-sizing: border-box;
    box-shadow: var(--shadow-main);
    animation: slideUp 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.bs-interio-modal-close {
    position: absolute;
    top: 20px;
    right: 20px;
    background: var(--bg-card-alt);
    border: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
}

.bs-interio-modal-close:hover {
    background: var(--border-color);
    color: var(--text-primary);
}

.modal-badge-wrapper {
    margin-bottom: 14px;
}

.modal-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--bg-card-alt);
    color: var(--color-primary);
    border: 1px solid var(--border-color);
    padding: 5px 14px;
    border-radius: 20px;
    font: var(--font-h3);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.modal-title {
    font: var(--font-h4);
    color: var(--text-primary);
    margin: 0 0 8px 0;
    line-height: 1.25;
}

.modal-subtitle {
    font: var(--font-body-1);
    color: var(--text-muted);
    margin: 0 0 24px 0;
    line-height: 1.45;
}

.modal-form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 24px;
}

.span-2 {
    grid-column: span 2;
}

@@media (max-width: 576px) {
    .modal-form-grid {
        grid-template-columns: 1fr;
        gap: 12px;
    }
    .span-2 {
        grid-column: span 1;
    }
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.form-label {
    font: var(--font-h3);
    color: var(--text-primary);
}

.bs-interio-input {
    background-color: var(--bg-card-alt) !important;
    border: 1px solid var(--border-color) !important;
    border-radius: 12px !important;
    padding: 12px 14px !important;
    font: var(--font-body-1) !important;
    color: var(--text-primary) !important;
    outline: none !important;
    transition: border-color 0.2s ease, box-shadow 0.2s ease !important;
}

.bs-interio-input::placeholder {
    color: var(--text-muted) !important;
    opacity: 0.8;
}

.bs-interio-input:focus {
    border-color: var(--color-primary) !important;
    box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.1) !important;
    background-color: var(--bg-card) !important;
}

.form-error-msg {
    color: var(--color-danger);
    font: var(--font-h3);
    margin-bottom: 14px;
}

.bs-interio-submit-btn {
    width: 100%;
    background: var(--gradient-primary);
    color: #ffffff !important;
    border: none;
    border-radius: 14px;
    padding: 16px;
    font: var(--font-h6);
    cursor: pointer;
    box-shadow: var(--shadow-main);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.bs-interio-submit-btn:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
}

.modal-success-alert {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 20px 0;
    text-align: center;
}

.success-icon-wrapper {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--bg-card-alt);
    display: flex;
    align-items: center;
    justify-content: center;
}

.success-msg-text {
    font: var(--font-body-1);
    color: var(--text-primary);
}

.bs-interio-close-btn {
    background: var(--bg-card-alt);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 10px 24px;
    font: var(--font-h3);
    cursor: pointer;
    transition: background 0.2s ease;
}

.bs-interio-close-btn:hover {
    background: var(--border-color);
}

@@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@@keyframes slideUp {
    from { transform: translateY(20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
}
</style>

@code {
    [Parameter]
    public bool IsEnabled { get; set; } = ApiConfig.EnableExitIntentModal;

    private bool _isVisible = false;
    private bool _hasTriggered = false;
    private bool _isSubmitting = false;
    private bool _isSubmitted = false;
    private bool _isAuthenticated = false;
    private string? _errorMessage;
    private DotNetObjectReference<ExitIntentModal>? _objectRef;

    private LeadFormModel _leadModel = new LeadFormModel();

    public class LeadFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public int? PropertyArea { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            _isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
        }
        catch
        {
            _isAuthenticated = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && IsEnabled && !_isAuthenticated)
        {
            try
            {
                _objectRef = DotNetObjectReference.Create(this);
                await JSRuntime.InvokeVoidAsync("eval", @"
                    window.initExitIntentListener = function(dotnetRef) {
                        let triggered = false;
                        document.addEventListener('mouseleave', function(e) {
                            if (e.clientY <= 0 && !triggered) {
                                triggered = true;
                                dotnetRef.invokeMethodAsync('ShowExitModal');
                            }
                        });
                    };
                ");
                await JSRuntime.InvokeVoidAsync("window.initExitIntentListener", _objectRef);
            }
            catch
            {
                // Silently ignore JS interop errors
            }
        }
    }

    [JSInvokable]
    public void ShowExitModal()
    {
        if (IsEnabled && !_hasTriggered && !_isAuthenticated)
        {
            _hasTriggered = true;
            _isVisible = true;
            StateHasChanged();
        }
    }

    private void CloseModal()
    {
        _isVisible = false;
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_leadModel.Name) || string.IsNullOrWhiteSpace(_leadModel.Phone) || string.IsNullOrWhiteSpace(_leadModel.Email))
        {
            _errorMessage = "Моля, попълнете име, телефон и имейл.";
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            var lead = new BuildSmart.Core.Domain.Entities.CalculatorLead
            {
                Id = Guid.NewGuid(),
                Name = _leadModel.Name.Trim(),
                Phone = _leadModel.Phone.Trim(),
                Email = _leadModel.Email.Trim(),
                SelectedArea = _leadModel.PropertyArea ?? 0,
                Scope = "exit_intent_lead",
                BuildingStatus = "bds",
                QualityTier = "standard",
                IsEmailVerified = true,
                VerificationStatus = "Valid",
                CreatedAt = DateTime.UtcNow
            };

            try
            {
                await LeadRepository.AddLeadAsync(lead);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error saving ExitIntent lead: {ex.Message}");
            }

            _isSubmitted = true;

            // Track PostHog event safely
            try
            {
                await JSRuntime.InvokeVoidAsync("posthog.capture", "exit_intent_lead_submitted", new
                {
                    area = _leadModel.PropertyArea ?? 0,
                    email = _leadModel.Email,
                    phone = _leadModel.Phone
                });
            }
            catch
            {
                // JS interop safety wrapper
            }
        }
        catch (Exception)
        {
            _errorMessage = "Възникна грешка при изпращане. Моля, опитайте отново.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void HandleGoogleSocialAccess()
    {
        var area = (_leadModel.PropertyArea.HasValue && _leadModel.PropertyArea.Value > 0) ? _leadModel.PropertyArea.Value : 75;
        var returnDest = $"/renovation-estimator?area={area}&proposalReady=true";
        var returnUrl = Uri.EscapeDataString(returnDest);
        NavManager.NavigateTo($"/create-account?ReturnUrl={returnUrl}");
    }

    private void HandleFacebookSocialAccess()
    {
        var area = (_leadModel.PropertyArea.HasValue && _leadModel.PropertyArea.Value > 0) ? _leadModel.PropertyArea.Value : 75;
        var returnDest = $"/renovation-estimator?area={area}&proposalReady=true";
        var returnUrl = Uri.EscapeDataString(returnDest);
        NavManager.NavigateTo($"/create-account?ReturnUrl={returnUrl}");
    }

    public async ValueTask DisposeAsync()
    {
        _objectRef?.Dispose();
        await Task.CompletedTask;
    }
}
