@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Authorization
@using BuildSmart.Core.Application.Interfaces
@inject IStringLocalizer<BuildSmart.SharedUI.Resources.AppResources> Loc
@inject IJSRuntime JSRuntime
@inject ICalculatorLeadRepository LeadRepository
@inject AuthenticationStateProvider AuthStateProvider
@implements IAsyncDisposable

@if (IsEnabled && _isVisible && !_isAuthenticated)
{
    <div class="bs-interio-modal-overlay" @onclick="CloseModal">
        <div class="bs-interio-modal-card" @onclick:stopPropagation="true">
            <button class="bs-interio-modal-close" @onclick="CloseModal" aria-label="Затвори">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>

            <div class="modal-badge-wrapper">
                <span class="modal-badge">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                    </svg>
                    Бърза оферта
                </span>
            </div>

            <h3 class="modal-title">Не бързайте! Получете примерен бюджет за 10 секунди</h3>
            <p class="modal-subtitle">Въведете квадратурата си и нашият екип ще Ви изпрати ориентировъчна оферта по имейл и телефон.</p>

            @if (_isSubmitted)
            {
                <div class="modal-success-alert">
                    <div class="success-icon-wrapper">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2.5">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                    </div>
                    <span class="success-msg-text">Благодарим Ви! Вашата заявка за оферта бе получена успешно. Наш специалист ще се свърже с Вас скоро.</span>
                    <button type="button" class="bs-interio-close-btn" @onclick="CloseModal">Затвори</button>
                </div>
            }
            else
            {
                <EditForm Model="_leadModel" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <div class="modal-form-grid">
                        <div class="form-group">
                            <label class="form-label">Вашето Име *</label>
                            <InputText @bind-Value="_leadModel.Name" class="form-control bs-interio-input" placeholder="Ivan Ivanov" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Телефон за връзка *</label>
                            <InputText @bind-Value="_leadModel.Phone" class="form-control bs-interio-input" placeholder="0888 123 456" />
                        </div>
                        <div class="form-group span-2">
                            <label class="form-label">Имейл адрес *</label>
                            <InputText @bind-Value="_leadModel.Email" class="form-control bs-interio-input" placeholder="ivan@example.com" />
                        </div>
                        <div class="form-group span-2">
                            <label class="form-label">Площ на имота (кв.м)</label>
                            <InputNumber @bind-Value="_leadModel.PropertyArea" class="form-control bs-interio-input" placeholder="75" />
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="form-error-msg">@_errorMessage</div>
                    }

                    <button type="submit" class="bs-interio-submit-btn" disabled="@_isSubmitting">
                        @if (_isSubmitting)
                        {
                            <span>Изпращане...</span>
                        }
                        else
                        {
                            <span>Изпрати заявка за оферта</span>
                        }
                    </button>
                </EditForm>
            }
        </div>
    </div>
}

<style>
.bs-interio-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    animation: fadeIn 0.25s ease;
}

.bs-interio-modal-card {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 24px;
    padding: 36px;
    max-width: 540px;
    width: 100%;
    box-shadow: var(--shadow-main);
    animation: slideUp 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.bs-interio-modal-close {
    position: absolute;
    top: 20px;
    right: 20px;
    background: var(--bg-card-alt);
    border: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
}

.bs-interio-modal-close:hover {
    background: var(--border-color);
    color: var(--text-primary);
}

.modal-badge-wrapper {
    margin-bottom: 14px;
}

.modal-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--bg-card-alt);
    color: var(--color-primary);
    border: 1px solid var(--border-color);
    padding: 5px 14px;
    border-radius: 20px;
    font: var(--font-h3);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.modal-title {
    font: var(--font-h4);
    color: var(--text-primary);
    margin: 0 0 8px 0;
    line-height: 1.25;
}

.modal-subtitle {
    font: var(--font-body-1);
    color: var(--text-muted);
    margin: 0 0 24px 0;
    line-height: 1.45;
}

.modal-form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 24px;
}

.span-2 {
    grid-column: span 2;
}

@@media (max-width: 576px) {
    .modal-form-grid {
        grid-template-columns: 1fr;
        gap: 12px;
    }
    .span-2 {
        grid-column: span 1;
    }
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.form-label {
    font: var(--font-h3);
    color: var(--text-primary);
}

.bs-interio-input {
    background-color: var(--bg-card-alt) !important;
    border: 1px solid var(--border-color) !important;
    border-radius: 12px !important;
    padding: 12px 14px !important;
    font: var(--font-body-1) !important;
    color: var(--text-primary) !important;
    outline: none !important;
    transition: border-color 0.2s ease, box-shadow 0.2s ease !important;
}

.bs-interio-input::placeholder {
    color: var(--text-muted) !important;
    opacity: 0.8;
}

.bs-interio-input:focus {
    border-color: var(--color-primary) !important;
    box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.1) !important;
    background-color: var(--bg-card) !important;
}

.form-error-msg {
    color: var(--color-danger);
    font: var(--font-h3);
    margin-bottom: 14px;
}

.bs-interio-submit-btn {
    width: 100%;
    background: var(--gradient-primary);
    color: #ffffff !important;
    border: none;
    border-radius: 14px;
    padding: 16px;
    font: var(--font-h6);
    cursor: pointer;
    box-shadow: var(--shadow-main);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.bs-interio-submit-btn:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
}

.modal-success-alert {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 20px 0;
    text-align: center;
}

.success-icon-wrapper {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--bg-card-alt);
    display: flex;
    align-items: center;
    justify-content: center;
}

.success-msg-text {
    font: var(--font-body-1);
    color: var(--text-primary);
}

.bs-interio-close-btn {
    background: var(--bg-card-alt);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 10px 24px;
    font: var(--font-h3);
    cursor: pointer;
    transition: background 0.2s ease;
}

.bs-interio-close-btn:hover {
    background: var(--border-color);
}

@@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@@keyframes slideUp {
    from { transform: translateY(20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
}
</style>

@code {
    [Parameter]
    public bool IsEnabled { get; set; } = false;

    private bool _isVisible = false;
    private bool _hasTriggered = false;
    private bool _isSubmitting = false;
    private bool _isSubmitted = false;
    private bool _isAuthenticated = false;
    private string? _errorMessage;
    private DotNetObjectReference<ExitIntentModal>? _objectRef;

    private LeadFormModel _leadModel = new LeadFormModel();

    public class LeadFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public int PropertyArea { get; set; } = 75;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            _isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
        }
        catch
        {
            _isAuthenticated = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && IsEnabled && !_isAuthenticated)
        {
            try
            {
                _objectRef = DotNetObjectReference.Create(this);
                await JSRuntime.InvokeVoidAsync("eval", @"
                    window.initExitIntentListener = function(dotnetRef) {
                        let triggered = false;
                        document.addEventListener('mouseleave', function(e) {
                            if (e.clientY <= 0 && !triggered) {
                                triggered = true;
                                dotnetRef.invokeMethodAsync('ShowExitModal');
                            }
                        });
                    };
                ");
                await JSRuntime.InvokeVoidAsync("window.initExitIntentListener", _objectRef);
            }
            catch
            {
                // Silently ignore JS interop errors
            }
        }
    }

    [JSInvokable]
    public void ShowExitModal()
    {
        if (IsEnabled && !_hasTriggered && !_isAuthenticated)
        {
            _hasTriggered = true;
            _isVisible = true;
            StateHasChanged();
        }
    }

    private void CloseModal()
    {
        _isVisible = false;
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_leadModel.Name) || string.IsNullOrWhiteSpace(_leadModel.Phone) || string.IsNullOrWhiteSpace(_leadModel.Email))
        {
            _errorMessage = "Моля, попълнете име, телефон и имейл.";
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            var lead = new BuildSmart.Core.Domain.Entities.CalculatorLead
            {
                Id = Guid.NewGuid(),
                Name = _leadModel.Name,
                Phone = _leadModel.Phone,
                Email = _leadModel.Email,
                SelectedArea = _leadModel.PropertyArea,
                Scope = "exit_intent_lead",
                BuildingStatus = "bds",
                QualityTier = "standard",
                CreatedAt = DateTime.UtcNow
            };

            try
            {
                await LeadRepository.AddLeadAsync(lead);
            }
            catch
            {
                // Soft fallback if DB repository is offline in WASM client mode
            }

            _isSubmitted = true;

            // Track PostHog event safely
            try
            {
                await JSRuntime.InvokeVoidAsync("posthog.capture", "exit_intent_lead_submitted", new
                {
                    area = _leadModel.PropertyArea,
                    email = _leadModel.Email,
                    phone = _leadModel.Phone
                });
            }
            catch
            {
                // JS interop safety wrapper
            }
        }
        catch (Exception)
        {
            _errorMessage = "Възникна грешка при изпращане. Моля, опитайте отново.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _objectRef?.Dispose();
        await Task.CompletedTask;
    }
}
