@using BuildSmart.SharedUI.GraphQL

<div class="overview-card bs-card mb-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start mb-3 gap-3">
        <h3 class="section-title mb-0" style="color: var(--color-primary);">@Loc["ProjectDetail_Overview"]</h3>
    </div>
    <div class="project-description mt-3">
        @{
            var descriptionText = string.IsNullOrEmpty(Project?.GeneralSummary) ? Project?.Description : Project?.GeneralSummary;
            if (!string.IsNullOrEmpty(descriptionText))
            {
                if (_isExpanded || descriptionText.Length <= 200)
                {
                    @descriptionText
                }
                else
                {
                    @(descriptionText.Substring(0, 200) + "...")
                }

                if (descriptionText.Length > 200)
                {
                    <div class="mt-2 text-end">
                        <button type="button" class="btn btn-link p-0 text-decoration-none" style="color: var(--color-primary); font-weight: 500;" @onclick="ToggleDescription">
                            @(_isExpanded ? Loc["ProjectDetail_ViewLess", "View Less"] : Loc["ProjectDetail_ViewMore", "View More"])
                        </button>
                    </div>
                }
            }
        }
    </div>
    
    @if (Project?.Status == ProjectStatus.Draft)
    {
        <div class="mt-4">
            <button class="bs-btn-primary w-100" @onclick="async () => await OnContinueDraft.InvokeAsync()">
                @Loc["ProjectDetail_ContinueDraft"]
            </button>
        </div>
    }
</div>

@code {
    private bool _isExpanded = false;

    private void ToggleDescription()
    {
        _isExpanded = !_isExpanded;
    }

    [Parameter, EditorRequired]
    public IProjectDetails Project { get; set; } = default!;

    [Parameter]
    public bool IsMasterOfferReady { get; set; }

    [Parameter]
    public EventCallback OnDownloadMasterOffer { get; set; }

    [Parameter]
    public EventCallback OnContinueDraft { get; set; }
}