@implements IDisposable

<div class="bs-trust-badges-container">
    <!-- Desktop View (Side-by-side) -->
    <div class="bs-badges-desktop">
        <div class="bs-badge-card bs-card">
            <div class="bs-badge-icon-wrapper">
                <svg viewBox="0 0 24 24" class="bs-badge-icon-svg">
                    <defs>
                        <linearGradient id="shieldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="var(--color-primary)" />
                            <stop offset="100%" stop-color="var(--color-secondary, #a855f7)" />
                        </linearGradient>
                    </defs>
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" fill="url(#shieldGrad)" />
                    <path d="M9 11l2 2 4-4" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                </svg>
            </div>
            <div class="bs-badge-info">
                <h4 class="bs-badge-title">@Loc["TrustBadge_Guarantee_Title"]</h4>
                <p class="bs-badge-desc">@Loc["TrustBadge_Guarantee_Desc"]</p>
            </div>
        </div>

        <div class="bs-badge-card bs-card">
            <div class="bs-badge-icon-wrapper">
                <svg viewBox="0 0 24 24" class="bs-badge-icon-svg">
                    <defs>
                        <linearGradient id="lockGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#10b981" />
                            <stop offset="100%" stop-color="#06b6d4" />
                        </linearGradient>
                    </defs>
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2" fill="url(#lockGrad)" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" stroke="url(#lockGrad)" stroke-width="3" fill="none" stroke-linecap="round" />
                    <circle cx="12" cy="16" r="1.5" fill="#ffffff" />
                </svg>
            </div>
            <div class="bs-badge-info">
                <h4 class="bs-badge-title">@Loc["TrustBadge_Secure_Title"]</h4>
                <p class="bs-badge-desc">@Loc["TrustBadge_Secure_Desc"]</p>
            </div>
        </div>

        <div class="bs-badge-card bs-card">
            <div class="bs-badge-icon-wrapper logo-style-wrapper">
                <svg viewBox="0 0 24 24" class="bs-badge-icon-svg" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                </svg>
            </div>
            <div class="bs-badge-info">
                <h4 class="bs-badge-title">@Loc["TrustBadge_PriceLock_Title"]</h4>
                <p class="bs-badge-desc">@Loc["TrustBadge_PriceLock_Desc"]</p>
            </div>
        </div>
    </div>

    <!-- Mobile Carousel -->
    <div class="bs-badges-mobile">
        <div class="bs-carousel-track" style="transform: translateX(-@(_activeIndex * 100)%);">
            <!-- Slide 1 -->
            <div class="bs-carousel-slide">
                <div class="bs-badge-card bs-card">
                    <div class="bs-badge-icon-wrapper">
                        <svg viewBox="0 0 24 24" class="bs-badge-icon-svg">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" fill="url(#shieldGrad)" />
                            <path d="M9 11l2 2 4-4" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                        </svg>
                    </div>
                    <div class="bs-badge-info">
                        <h4 class="bs-badge-title">@Loc["TrustBadge_Guarantee_Title"]</h4>
                        <p class="bs-badge-desc">@Loc["TrustBadge_Guarantee_Desc"]</p>
                    </div>
                </div>
            </div>

            <!-- Slide 2 -->
            <div class="bs-carousel-slide">
                <div class="bs-badge-card bs-card">
                    <div class="bs-badge-icon-wrapper">
                        <svg viewBox="0 0 24 24" class="bs-badge-icon-svg">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" fill="url(#lockGrad)" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" stroke="url(#lockGrad)" stroke-width="3" fill="none" stroke-linecap="round" />
                            <circle cx="12" cy="16" r="1.5" fill="#ffffff" />
                        </svg>
                    </div>
                    <div class="bs-badge-info">
                        <h4 class="bs-badge-title">@Loc["TrustBadge_Secure_Title"]</h4>
                        <p class="bs-badge-desc">@Loc["TrustBadge_Secure_Desc"]</p>
                    </div>
                </div>
            </div>

            <!-- Slide 3 -->
            <div class="bs-carousel-slide">
                <div class="bs-badge-card bs-card">
                    <div class="bs-badge-icon-wrapper logo-style-wrapper">
                        <svg viewBox="0 0 24 24" class="bs-badge-icon-svg" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                        </svg>
                    </div>
                    <div class="bs-badge-info">
                        <h4 class="bs-badge-title">@Loc["TrustBadge_PriceLock_Title"]</h4>
                        <p class="bs-badge-desc">@Loc["TrustBadge_PriceLock_Desc"]</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Dot Indicators -->
        <div class="bs-carousel-dots">
            <span class="bs-dot @(_activeIndex == 0 ? "active" : "")" @onclick="() => SetActiveSlide(0)"></span>
            <span class="bs-dot @(_activeIndex == 1 ? "active" : "")" @onclick="() => SetActiveSlide(1)"></span>
            <span class="bs-dot @(_activeIndex == 2 ? "active" : "")" @onclick="() => SetActiveSlide(2)"></span>
        </div>
    </div>
</div>

<style>
    .bs-trust-badges-container {
        width: 100%;
        height: 100%;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    /* Desktop View */
    .bs-badges-desktop {
        display: flex;
        flex-direction: row;
        gap: 12px;
        width: 100%;
        height: 100%;
        align-items: stretch;
    }

    .bs-badge-card {
        flex: 1;
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        box-shadow: var(--shadow-main);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        min-width: 0;
        height: 100%;
    }

    .bs-badge-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.06);
    }

    .bs-badge-icon-wrapper {
        flex-shrink: 0;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background-color: var(--bg-card-alt);
    }

    .logo-style-wrapper {
        background-color: var(--color-primary) !important;
        color: #ffffff !important;
        box-shadow: 0 3px 8px rgba(99, 102, 241, 0.25);
    }

    .bs-badge-icon-svg {
        width: 26px;
        height: 26px;
        display: block;
    }

    .bs-badge-info {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

    .bs-badge-title {
        font-family: var(--font-heading);
        font-size: 13px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .bs-badge-desc {
        font-family: var(--font-primary);
        font-size: 11px;
        font-weight: 400;
        color: var(--text-secondary);
        margin: 0;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Mobile View */
    .bs-badges-mobile {
        display: none;
        position: relative;
        width: 100%;
        overflow: hidden;
    }

    .bs-carousel-track {
        display: flex;
        width: 100%;
        transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .bs-carousel-slide {
        flex: 0 0 100%;
        width: 100%;
        box-sizing: border-box;
        padding: 4px;
    }

    .bs-carousel-dots {
        display: flex;
        justify-content: center;
        gap: 6px;
        margin-top: 8px;
    }

    .bs-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background-color: var(--border-color);
        cursor: pointer;
        transition: background-color 0.2s ease, transform 0.2s ease;
    }

    .bs-dot.active {
        background-color: var(--color-primary);
        transform: scale(1.2);
    }

    /* Responsive Queries */
    @@media (max-width: 992px) {
        .bs-badges-desktop {
            display: none;
        }

        .bs-badges-mobile {
            display: block;
        }
    }

    /* Guard: Auto-hide badges on mobile when viewport height is too small to avoid pushing content */
    @@media (max-width: 992px) and (max-height: 720px) {
        .bs-trust-badges-container {
            display: none;
        }
    }
</style>

@code {
    private int _activeIndex = 0;
    private System.Threading.Timer? _carouselTimer;

    protected override void OnInitialized()
    {
        StartTimer();
    }

    private void StartTimer()
    {
        _carouselTimer?.Dispose();
        _carouselTimer = new System.Threading.Timer(_ => 
        {
            _activeIndex = (_activeIndex + 1) % 3;
            InvokeAsync(StateHasChanged);
        }, null, 5000, 5000);
    }

    private void SetActiveSlide(int index)
    {
        _activeIndex = index;
        StartTimer();
    }

    public void Dispose()
    {
        _carouselTimer?.Dispose();
    }
}
