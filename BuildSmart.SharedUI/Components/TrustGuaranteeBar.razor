@using Microsoft.Extensions.Localization
@inject IStringLocalizer<BuildSmart.SharedUI.Resources.AppResources> Loc

<div class="bs-interio-guarantee-bar">
    <div class="guarantee-item">
        <div class="guarantee-icon-wrapper emerald">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <path d="M9 12l2 2 4-4"></path>
            </svg>
        </div>
        <div class="guarantee-text">
            <strong>@Loc["Trust_AdvanceTitle"]</strong>
            <span>@Loc["Trust_AdvanceDesc"]</span>
        </div>
    </div>

    <div class="guarantee-item">
        <div class="guarantee-icon-wrapper teal">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
        </div>
        <div class="guarantee-text">
            <strong>@Loc["Trust_ContractTitle"]</strong>
            <span>@Loc["Trust_ContractDesc"]</span>
        </div>
    </div>

    <div class="guarantee-item">
        <div class="guarantee-icon-wrapper mint">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
        </div>
        <div class="guarantee-text">
            <strong>@Loc["Trust_TimelineTitle"]</strong>
            <span>@Loc["Trust_TimelineDesc"]</span>
        </div>
    </div>

    <div class="guarantee-item">
        <div class="guarantee-icon-wrapper dark-teal">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
        </div>
        <div class="guarantee-text">
            <strong>@Loc["Trust_TransparentTitle"]</strong>
            <span>@Loc["Trust_TransparentDesc"]</span>
        </div>
    </div>
</div>

<style>
.bs-interio-guarantee-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 20px;
    padding: 22px 28px;
    margin: 28px 0;
    box-shadow: var(--shadow-main);
}

.guarantee-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 10px;
    border-radius: 14px;
    transition: transform 0.2s ease;
}

.guarantee-item:hover {
    transform: translateY(-2px);
}

.guarantee-icon-wrapper {
    width: 48px;
    height: 48px;
    min-width: 48px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-card-alt);
    color: var(--color-primary);
    border: 1px solid var(--border-color);
}

.guarantee-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.guarantee-text strong {
    font: var(--font-body-1);
    color: var(--text-primary);
    line-height: 1.25;
}

.guarantee-text span {
    font: var(--font-h3);
    color: var(--text-muted);
    line-height: 1.35;
}
</style>
