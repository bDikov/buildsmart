@code {
    [Parameter]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public string? TextFallback { get; set; }

    [Parameter]
    public int Size { get; set; } = 22;

    [Parameter]
    public string Class { get; set; } = string.Empty;

    [Parameter]
    public string Style { get; set; } = string.Empty;

    private static bool IsImageUrl(string val)
    {
        if (string.IsNullOrWhiteSpace(val)) return false;
        var v = val.Trim().ToLowerInvariant();
        return v.StartsWith("http://") || 
               v.StartsWith("https://") || 
               v.StartsWith("data:image/") || 
               v.StartsWith("/") || 
               v.StartsWith("uploads/") || 
               v.StartsWith("images/") || 
               v.EndsWith(".png") || 
               v.EndsWith(".svg") || 
               v.EndsWith(".jpg") || 
               v.EndsWith(".jpeg") || 
               v.EndsWith(".webp") ||
               v.EndsWith(".gif");
    }

    private static string ResolveImageUrl(string url)
    {
        if (string.IsNullOrWhiteSpace(url)) return url;
        var trimmed = url.Trim();
        if (trimmed.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            trimmed.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            trimmed.StartsWith("data:image/", StringComparison.OrdinalIgnoreCase))
        {
            return trimmed;
        }

        var baseUrl = ApiConfig.GetBaseUrl().TrimEnd('/');
        if (trimmed.StartsWith("/"))
        {
            return $"{baseUrl}{trimmed}";
        }
        return $"{baseUrl}/{trimmed}";
    }

    private string ResolvedIconKey
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(Name)) return NormalizeKey(Name);
            if (!string.IsNullOrWhiteSpace(TextFallback)) return ResolveFromText(TextFallback);
            return "house";
        }
    }

    private static string NormalizeKey(string key)
    {
        if (IsImageUrl(key)) return key.Trim();

        var k = key.ToLowerInvariant().Trim();
        if (k.Contains("paint") || k.Contains("боя") || k.Contains("шпакл")) return "paint-roller";
        if (k.Contains("plumb") || k.Contains("вик") || k.Contains("вода")) return "water-drop";
        if (k.Contains("elec") || k.Contains("ел") || k.Contains("ток")) return "lightning";
        if (k.Contains("wall") || k.Contains("сухо") || k.Contains("картон")) return "wall";
        if (k.Contains("tile") || k.Contains("плоч") || k.Contains("настилк")) return "tile";
        if (k.Contains("hammer") || k.Contains("кърт")) return "hammer";
        if (k.Contains("sofa") || k.Contains("хол") || k.Contains("всекидневна")) return "sofa";
        if (k.Contains("bed") || k.Contains("спалн")) return "bed";
        if (k.Contains("door") || k.Contains("коридор") || k.Contains("антре") || k.Contains("врати")) return "door";
        if (k.Contains("house") || k.Contains("всички")) return "house";
        if (k.Contains("drill") || k.Contains("бормаши")) return "drill";
        if (k.Contains("wrench") || k.Contains("инструмент")) return "wrench";
        if (k.Contains("truck") || k.Contains("транспорт") || k.Contains("извоз")) return "truck";
        if (k.Contains("window") || k.Contains("прозор")) return "window";
        if (k.Contains("roof") || k.Contains("покрив")) return "roof";
        if (k.Contains("fence") || k.Contains("ограда")) return "fence";
        if (k.Contains("kitchen") || k.Contains("кухн")) return "kitchen";
        if (k.Contains("bath") || k.Contains("баня")) return "bath";
        if (k.Contains("lock") || k.Contains("заключ")) return "lock";
        if (k.Contains("solar") || k.Contains("слънч")) return "sun-solar";
        if (k.Contains("garden") || k.Contains("градин") || k.Contains("двор")) return "tree-garden";
        if (k.Contains("hvac") || k.Contains("отопл") || k.Contains("климат")) return "flame-hvac";
        if (k.Contains("measure") || k.Contains("мер")) return "ruler-measure";
        return k;
    }

    private static string ResolveFromText(string text)
    {
        if (IsImageUrl(text)) return text.Trim();

        var t = text.ToLowerInvariant();
        if (t.Contains("всички") || t.Contains("all rooms")) return "house";
        if (t.Contains("хол") || t.Contains("всекидневна") || t.Contains("living")) return "sofa";
        if (t.Contains("спалн") || t.Contains("bedroom")) return "bed";
        if (t.Contains("коридор") || t.Contains("антре") || t.Contains("hallway") || t.Contains("врати")) return "door";
        if (t.Contains("таван") || t.Contains("ceiling") || t.Contains("боя") || t.Contains("шпакл")) return "paint-roller";
        if (t.Contains("вик") || t.Contains("вода") || t.Contains("plumb")) return "water-drop";
        if (t.Contains("ел") || t.Contains("електрич") || t.Contains("elec")) return "lightning";
        if (t.Contains("плоч") || t.Contains("настилк") || t.Contains("tile")) return "tile";
        if (t.Contains("кърт") || t.Contains("извоз") || t.Contains("demol")) return "hammer";
        if (t.Contains("сухо") || t.Contains("картон") || t.Contains("drywall")) return "wall";
        if (t.Contains("покрив") || t.Contains("roof")) return "roof";
        if (t.Contains("прозор") || t.Contains("window")) return "window";
        if (t.Contains("баня") || t.Contains("bath")) return "bath";
        if (t.Contains("кухн") || t.Contains("kitchen")) return "kitchen";
        return "house";
    }
}
