@namespace BuildSmart.SharedUI.Components
@using BuildSmart.SharedUI.Services

@if (IsImageUrl(ResolvedIconKey))
{
    <img src="@ResolveImageUrl(ResolvedIconKey)" class="bs-icon-img @Class" style="width: @(Size)px; height: @(Size)px; object-fit: contain; @Style" alt="icon" />
}
else if (!string.IsNullOrEmpty(ResolvedIconKey))
{
    <span class="bs-icon-wrapper @Class" style="@Style">
        @switch (ResolvedIconKey)
        {
            case "paint-roller":
            case "painting":
                <svg viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="3" width="16" height="6" rx="2" />
                    <path d="M18 6h2a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-6v8a2 2 0 0 1-2 2h-2" />
                </svg>
                break;

            case "water-drop":
            case "plumbing":
                <svg viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" />
                </svg>
                break;

            case "lightning":
            case "electrical":
                <svg viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                </svg>
                break;

            case "wall":
            case "drywall":
