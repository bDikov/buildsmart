                    <path d="M8 2v20M16 2v20M8 6h8M8 11h8M8 16h8" />
                </svg>
                break;

            case "bucket":
                <svg viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 9h16l-2 11H6L4 9z" />
                    <path d="M12 2a5 5 0 0 0-5 5h10a5 5 0 0 0-5-5z" />
                </svg>
                break;

            case "brush":
                <svg viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2l4 4L7 17H3v-4L14 2z" />
                    <path d="M18 13v5a2 2 0 0 1-2 2H8" />
                </svg>
                break;

            case "plug":
                <svg viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22v-5M9 8V2M15 8V2M6 8h12v5a6 6 0 0 1-12 0V8z" />
                </svg>
                break;

            case "bulb":
                <svg viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2z" />
                </svg>
