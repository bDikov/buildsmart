                    <path d="M12 15a3 3 0 0 0 3 3h3a3 3 0 0 0-3-3v-3" />
                    <path d="M9 12a3 3 0 0 0-3 3v3a3 3 0 0 0 3-3h3" />
                    <path d="M15 12a3 3 0 0 0 3-3V6a3 3 0 0 0-3 3h-3" />
                </svg>
