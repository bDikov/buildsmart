@namespace BuildSmart.SharedUI.Components

@if (!string.IsNullOrEmpty(ResolvedIconKey))
{
    <span class="bs-icon-wrapper @Class" style="@Style">
        @switch (ResolvedIconKey)
        {
            case "paint-roller":
            case "painting":
                <svg viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="3" width="16" height="6" rx="2" />
                    <path d="M18 6h2a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-6v8a2 2 0 0 1-2 2h-2" />
                </svg>
                break;

            case "water-drop":
            case "plumbing":
                <svg viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" />
                </svg>
                break;

            case "lightning":
            case "electrical":
                <svg viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                </svg>
                break;

            case "wall":
            case "drywall":
                <svg viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" />
                    <line x1="3" y1="9" x2="21" y2="9" />
                    <line x1="3" y1="15" x2="21" y2="15" />
                    <line x1="12" y1="3" x2="12" y2="9" />
                    <line x1="8" y1="9" x2="8" y2="15" />
                    <line x1="16" y1="9" x2="16" y2="15" />
                    <line x1="12" y1="15" x2="12" y2="21" />
                </svg>
                break;

            case "tile":
            case "tiling":
                <svg viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" />
                    <line x1="3" y1="12" x2="21" y2="12" />
                    <line x1="12" y1="3" x2="12" y2="21" />
                </svg>
                break;

            case "hammer":
            case "demolition":
                <svg viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 12l-8.5 8.5a2.12 2.12 0 0 1-3-3L12 9" />
                    <path d="M17.64 3.64a2.5 2.5 0 0 1 3.54 3.54l-2.83 2.83-3.54-3.54 2.83-2.83z" />
                </svg>
                break;

            case "sofa":
            case "living-room":
                <svg viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 11V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v5" />
                    <path d="M2 11h20v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-6z" />
                    <path d="M6 19v2" />
                    <path d="M18 19v2" />
                </svg>
                break;

            case "bed":
            case "bedroom":
                <svg viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 4v16" />
                    <path d="M2 8h18a2 2 0 0 1 2 2v10" />
                    <path d="M2 17h20" />
                    <path d="M6 8v3" />
                </svg>
                break;

            case "door":
            case "hallway":
                <svg viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 20V6a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v14" />
                    <circle cx="14" cy="12" r="1" fill="currentColor" />
                </svg>
                break;

            case "house":
            case "all-rooms":
                <svg viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                    <polyline points="9 22 9 12 15 12 15 22" />
                </svg>
                break;

            default:
                <svg viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9" />
                    <line x1="12" y1="8" x2="12" y2="12" />
                    <line x1="12" y1="16" x2="12.01" y2="16" />
                </svg>
                break;
        }
    </span>
}

@code {
    [Parameter]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public string? TextFallback { get; set; }

    [Parameter]
    public int Size { get; set; } = 22;

    [Parameter]
    public string Class { get; set; } = string.Empty;

    [Parameter]
    public string Style { get; set; } = string.Empty;

    private string ResolvedIconKey
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(Name)) return NormalizeKey(Name);
            if (!string.IsNullOrWhiteSpace(TextFallback)) return ResolveFromText(TextFallback);
            return "house";
        }
    }

    private static string NormalizeKey(string key)
    {
        var k = key.ToLowerInvariant().Trim();
        if (k.Contains("paint") || k.Contains("боя") || k.Contains("шпакл")) return "paint-roller";
        if (k.Contains("plumb") || k.Contains("вик") || k.Contains("вода")) return "water-drop";
        if (k.Contains("elec") || k.Contains("ел") || k.Contains("ток")) return "lightning";
        if (k.Contains("wall") || k.Contains("сухо") || k.Contains("картон")) return "wall";
        if (k.Contains("tile") || k.Contains("плоч") || k.Contains("настилк")) return "tile";
        if (k.Contains("hammer") || k.Contains("кърт")) return "hammer";
        if (k.Contains("sofa") || k.Contains("хол") || k.Contains("всекидневна")) return "sofa";
        if (k.Contains("bed") || k.Contains("спалн")) return "bed";
        if (k.Contains("door") || k.Contains("коридор") || k.Contains("антре") || k.Contains("врати")) return "door";
        if (k.Contains("house") || k.Contains("всички")) return "house";
        return k;
    }

    private static string ResolveFromText(string text)
    {
        var t = text.ToLowerInvariant();
        if (t.Contains("всички") || t.Contains("all rooms")) return "house";
        if (t.Contains("хол") || t.Contains("всекидневна") || t.Contains("living")) return "sofa";
        if (t.Contains("спалн") || t.Contains("bedroom")) return "bed";
        if (t.Contains("коридор") || t.Contains("антре") || t.Contains("hallway") || t.Contains("врати")) return "door";
        if (t.Contains("таван") || t.Contains("ceiling") || t.Contains("боя") || t.Contains("шпакл")) return "paint-roller";
        if (t.Contains("вик") || t.Contains("вода") || t.Contains("plumb")) return "water-drop";
        if (t.Contains("ел") || t.Contains("електрич") || t.Contains("elec")) return "lightning";
        if (t.Contains("плоч") || t.Contains("настилк") || t.Contains("tile")) return "tile";
        if (t.Contains("кърт") || t.Contains("извоз") || t.Contains("demol")) return "hammer";
        if (t.Contains("сухо") || t.Contains("картон") || t.Contains("drywall")) return "wall";
        return "house";
    }
}
