@using Microsoft.Extensions.Localization
@inject IStringLocalizer<BuildSmart.SharedUI.Resources.AppResources> Loc
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime

<div class="bs-floating-actions">
    <!-- Direct Phone Call Button -->
    <button type="button" class="action-btn call-btn @(_isPhoneCopied ? "btn-success" : "")" @onclick="CopyPhoneToClipboard" title="@Loc["FloatingActions_Call"]" aria-label="@Loc["FloatingActions_AriaCall"]">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <span class="btn-tooltip">@(_isPhoneCopied ? Loc["Lander_PhoneCopiedNotice"] : Loc["FloatingActions_Call"])</span>
    </button>

    <!-- AI Calculator Fast Action Button -->
    <button type="button" class="action-btn wizard-btn" @onclick="NavigateToEstimator" title="@Loc["FloatingActions_Calculator"]" aria-label="@Loc["FloatingActions_AriaCalc"]">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
        <span class="btn-tooltip">@Loc["FloatingActions_Calculator"]</span>
    </button>

    <!-- Support Chat Button -->
    <button type="button" class="action-btn chat-btn" @onclick='() => NavManager.NavigateTo("/chat")' title="@Loc["FloatingActions_Viber"]" aria-label="@Loc["FloatingActions_AriaViber"]">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
        </svg>
        <span class="btn-tooltip">@Loc["FloatingActions_Viber"]</span>
    </button>
</div>

<style>
.bs-floating-actions {
    position: fixed;
    bottom: 28px;
    right: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: center;
    z-index: 9999;
}

.action-btn {
    position: relative;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-on-primary, #ffffff) !important;
    border: none;
    outline: none;
    box-shadow: var(--shadow-main, 0 8px 24px rgba(0, 0, 0, 0.25));
    transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.25s ease;
    cursor: pointer;
    text-decoration: none;
}

.action-btn:hover {
    transform: scale(1.12);
    box-shadow: var(--shadow-hover, 0 12px 30px rgba(0, 0, 0, 0.35));
}

.call-btn {
    background: var(--color-success);
}

.wizard-btn {
    background: var(--color-primary);
}

.chat-btn {
    background: var(--color-primary-dark);
}

.btn-tooltip {
    position: absolute;
    right: 64px;
    background: var(--bg-card);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    padding: 6px 12px;
    border-radius: 8px;
    font: var(--font-h3);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transform: translateX(10px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    box-shadow: var(--shadow-main);
}

.action-btn:hover .btn-tooltip {
    opacity: 1;
    transform: translateX(0);
}

@@media (max-width: 576px) {
    .bs-floating-actions {
        bottom: 20px;
        right: 16px;
        gap: 10px;
    }
    .action-btn {
        width: 48px;
        height: 48px;
    }
    .btn-tooltip {
        display: none;
    }
}
</style>

@code {
    private bool _isPhoneCopied = false;

    private async Task CopyPhoneToClipboard()
    {
        try
        {
            var number = Loc["Support_PhoneNumber"].Value;
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", number);
            _isPhoneCopied = true;
            StateHasChanged();
            await Task.Delay(3000);
            _isPhoneCopied = false;
            StateHasChanged();
        }
        catch { }
    }

    private void NavigateToEstimator()
    {
        NavManager.NavigateTo("/job-wizard");
    }
}
