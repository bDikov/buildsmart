@using BuildSmart.SharedUI.GraphQL
@using BuildSmart.SharedUI.ViewModels
@using Markdig

<div class="job-card bs-card @(JobVm.JobPost.CategoryStatus == ProjectCategoryStatus.Pending ? "task-card-pending" : "")">
    <div class="job-header" style="cursor: pointer;" @onclick="ToggleBreakdownExpanded">
        <h4 class="job-title">
        @(JobVm.JobPost.Title == JobVm.JobPost.ServiceCategory.Name
            ? (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.StartsWith("en", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrEmpty(JobVm.JobPost.ServiceCategory.EnglishName) ? JobVm.JobPost.ServiceCategory.EnglishName : JobVm.JobPost.Title)
            : JobVm.JobPost.Title)
    </h4>
        <div class="job-header-sub">
            <div class="job-category-status">
                @if (JobVm.JobPost.Title != JobVm.JobPost.ServiceCategory.Name)
                {
                    <span class="job-category">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.StartsWith("en", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrEmpty(JobVm.JobPost.ServiceCategory.EnglishName) ? JobVm.JobPost.ServiceCategory.EnglishName : JobVm.JobPost.ServiceCategory.Name)</span>
                }
                <span class="job-status status-@(JobVm.JobPost.Status.ToString().ToLower()) m-0">@Loc[$"Status_{JobVm.JobPost.Status}"]</span>
                
                @if (IsAdmin)
                {
                    <div class="category-status-selector d-inline-flex align-items-center gap-1 ms-2" @onclick:stopPropagation="true">
                        <span class="text-muted" style="font-size: 0.75rem; font-weight: 600;">Cat Status:</span>
                        <select class="bs-select py-1 px-2" style="font-size: 0.8rem; width: auto; font-weight: 600; border-radius: 6px;" value="@JobVm.JobPost.CategoryStatus.ToString()" @onchange="ChangeCategoryStatus">
                            <option value="Draft">Draft</option>
                            <option value="Pending">Pending</option>
                            <option value="Active">Active</option>
                        </select>
                    </div>
                }
                else if (JobVm.JobPost.CategoryStatus == ProjectCategoryStatus.Pending)
                {
                    <span class="badge-pending-activation ms-2">
                        @Loc["ProjectDetail_PendingActivation"]
                    </span>
                }
            </div>
            @if (JobVm.TotalEstimatedPrice > 0)
            {
                <button type="button" class="price-toggle-badge" @onclick="ToggleBreakdownExpanded" @onclick:stopPropagation="true">
                    @Loc["GeneratedOffer_TotalValue"]: €@JobVm.TotalEstimatedPrice.ToString("F2")
                    @if (JobVm.JobPost.CategoryStatus == ProjectCategoryStatus.Pending)
                    {
                        <span class="ms-1 font-weight-bold" style="color: var(--color-warning);">(@Loc["ProjectDetail_PendingActivation"])</span>
                    }
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="transition: transform 0.2s; transform: @(_breakdownExpanded ? "rotate(180deg)" : "rotate(0deg)")">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </button>
            }
        </div>
    </div>

    @if (JobVm.Tasks != null && JobVm.Tasks.Any())
    {
        @if (_breakdownExpanded)
        {
            <div class="d-flex flex-column gap-4 mt-3 mb-3">
                @if (JobVm.JobPost.CategoryStatus == ProjectCategoryStatus.Pending)
                {
                    <div class="pending-package-disclaimer">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-warning)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;">
                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                            <line x1="12" y1="9" x2="12" y2="13"></line>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                        <div>
                            @Loc["ProjectDetail_PendingCategoryDisclaimer"]
                        </div>
                    </div>
                }

                @foreach (var task in JobVm.Tasks)
                {
                    var isPending = JobVm.JobPost.CategoryStatus == ProjectCategoryStatus.Pending;
                    <div class="bs-card p-4 @(isPending ? "task-card-pending" : "")" style="border-radius: 12px; @(!isPending ? "border-left: 4px solid var(--color-success); border-top: 1px solid var(--border-color); border-right: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color);" : "")">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h4 class="h5 fw-bold mb-0" style="color: var(--text-primary);">@task.Title</h4>
                            <span class="fw-bold @(isPending ? "price-pending" : "")" style="@(!isPending ? "color: var(--color-success);" : "") font-size: 1.1rem;">
                                @string.Format(Loc["GeneratedOffer_TotalTaskCost"], task.EstimatedPrice.ToString("F2"))
                                @if (isPending)
                                {
                                    <span style="font-size: 0.85rem; font-weight: normal;" class="ms-1">(@Loc["ProjectDetail_PendingActivation"])</span>
                                }
                            </span>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(task.Description))
                        {
                            <p class="mb-4" style="font-size: 0.95rem; color: var(--text-muted);">@task.Description</p>
                        }

                        @if (task.SkuItems != null && task.SkuItems.Count > 0)
                        {
                            <hr style="border-color: var(--border-color); opacity: 0.5;" />
                            <h6 class="fw-bold mb-3" style="color: var(--color-primary);">@Loc["GeneratedOffer_BillableSKUs"]</h6>

                            <div class="d-flex flex-column gap-3">
                                @foreach (var sku in task.SkuItems)
                                {
                                    <div class="d-flex justify-content-between align-items-center p-3" style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; flex-wrap: wrap; gap: 10px;">
                                        <div class="d-flex align-items-center gap-3" style="min-width: 0; flex: 1;">
                                            <div style="min-width: 0; flex: 1;">
                                                <div class="fw-bold" style="color: var(--text-primary); font-size: 0.95rem; word-break: break-word; overflow-wrap: break-word;">
                                                    @(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.StartsWith("en", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrEmpty(sku.ServiceSku.EnglishName) ? sku.ServiceSku.EnglishName : sku.ServiceSku.Name)
                                                </div>
                                                <div style="color: var(--text-muted); font-size: 0.8rem; word-break: break-word; overflow-wrap: break-word;">
                                                    @{
                                                        var isEn = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.StartsWith("en", StringComparison.OrdinalIgnoreCase);
                                                        var unitRaw = isEn && !string.IsNullOrEmpty(sku.ServiceSku.EnglishUnitType) ? sku.ServiceSku.EnglishUnitType : sku.ServiceSku.UnitType;
                                                        var unit = GetLocalizedUnitType(unitRaw, isEn);
                                                        var qty = (sku.ServiceSku.BasePrice > 0 ? (sku.EstimatedPrice / sku.ServiceSku.BasePrice) : sku.Quantity).ToString("0.##");
                                                    }
                                                    @qty @unit × €@sku.ServiceSku.BasePrice.ToString("F2") / @unit
                                                </div>
                                            </div>
                                        </div>
                                        <span class="fw-bold @(isPending ? "price-pending" : "")" style="@(!isPending ? "color: var(--color-success);" : "") flex-shrink: 0;">
                                            €@sku.EstimatedPrice.ToString("F2")
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                <div class="d-flex justify-content-center">
                    <button class="bs-btn-dark btn-sm w-100 w-sm-auto mb-2" @onclick="ToggleBreakdownExpanded" @onclick:stopPropagation="true">
                        @Loc["GeneratedOffer_HideTaskBreakdowns"]
                    </button>
                </div>
            </div>
        }
    }
    else
    {
        @if (!string.IsNullOrEmpty(JobVm.JobPost.Description) && JobVm.JobPost.Description != JobVm.JobPost.Title && JobVm.JobPost.Description != JobVm.JobPost.ServiceCategory.Name)
        {
            <div class="job-description mt-3 mb-3">
                @JobVm.JobPost.Description
            </div>
        }
    }

    <!-- Action Buttons -->
    <div class="d-flex flex-column gap-2 mt-4">
        @if (JobVm.JobPost.Bids != null && JobVm.JobPost.Bids.Any())
        {
            <button class="bs-btn-primary w-100" @onclick="async () => await OnViewAuctionHub.InvokeAsync()">
                @string.Format(Loc["ProjectDetail_ViewOffersCount"], JobVm.JobPost.Bids.Count)
            </button>
        }
        else if (JobVm.JobPost.Status == JobPostStatus.Open)
        {
            <button class="bs-btn-dark w-100" @onclick="async () => await OnViewAuctionHub.InvokeAsync()">
                @Loc["ProjectDetail_ViewAuctionZero"]
            </button>
        }
        
        @if (JobVm.JobPost.Status == JobPostStatus.GeneratingScope)
        {
            <div class="d-flex justify-content-center mt-2">
                <button class="bs-btn-primary w-100 py-2" disabled>
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    @Loc["JobWizard_OfferBuilding_Title"]
                </button>
            </div>
        }

        @if (JobVm.JobPost.Status == JobPostStatus.Draft)
        {
            <div class="d-flex justify-content-center mt-2">
                <button class="bs-btn-primary w-100 py-2" @onclick="async () => await OnEditAnswers.InvokeAsync()">@Loc["ProjectDetail_ContinueDraft"]</button>
            </div>
        }

        @if (IsAdmin)
        {
            <div class="d-flex justify-content-center mt-2">
                <button class="bs-btn-secondary w-100 py-2" @onclick="async () => await OnReviewScope.InvokeAsync()">
                    🛠️ Edit Task Breakdown
                </button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public JobPostViewModel JobVm { get; set; } = default!;

    [Parameter]
    public bool IsExpanded { get; set; }

    [Parameter]
    public bool IsAdmin { get; set; }

    [Parameter]
    public EventCallback OnToggleExpansion { get; set; }

    [Parameter]
    public EventCallback OnViewAuctionHub { get; set; }

    [Parameter]
    public EventCallback OnViewAIOffer { get; set; }

    [Parameter]
    public EventCallback OnEditAnswers { get; set; }

    [Parameter]
    public EventCallback OnSubmitToAdmin { get; set; }

    [Parameter]
    public EventCallback OnAskAdmin { get; set; }

    [Parameter]
    public EventCallback OnReviewScope { get; set; }

    [Parameter]
    public EventCallback<ProjectCategoryStatus> OnCategoryStatusChanged { get; set; }

    private bool _breakdownExpanded = false;

    private void ToggleBreakdownExpanded()
    {
        _breakdownExpanded = !_breakdownExpanded;
        StateHasChanged();
    }

    private async Task ChangeCategoryStatus(ChangeEventArgs e)
    {
        if (e.Value != null && Enum.TryParse<ProjectCategoryStatus>(e.Value.ToString(), out var newStatus))
        {
            if (OnCategoryStatusChanged.HasDelegate)
            {
                await OnCategoryStatusChanged.InvokeAsync(newStatus);
            }
        }
    }

    private string GetLocalizedUnitType(string? unit, bool isEn)
    {
        if (string.IsNullOrEmpty(unit)) return "";
        var cleanUnit = unit.Trim().ToLower();
        if (isEn)
        {
            return cleanUnit switch
            {
                "sqm" => "sq.m.",
                "pcs" => "pcs",
                "lm" => "lm",
                "m" => "m",
                "trip" => "trip",
                "m3" => "m³",
                _ => cleanUnit
            };
        }
        else
        {
            return cleanUnit switch
            {
                "sqm" => "кв.м.",
                "pcs" => "бр.",
                "lm" => "л.м.",
                "m" => "м.",
                "trip" => "курс",
                "m3" => "куб.м.",
                _ => cleanUnit
            };
        }
    }
}
