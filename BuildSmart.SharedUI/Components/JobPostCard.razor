@using BuildSmart.SharedUI.GraphQL
@using BuildSmart.SharedUI.ViewModels
@using Markdig

<div class="job-card bs-card">
    <div class="job-header" style="cursor: pointer;" @onclick="ToggleBreakdownExpanded">
        <h4 class="job-title">@JobVm.JobPost.Title</h4>
        <div class="job-header-sub">
            <div class="job-category-status">
                @if (JobVm.JobPost.Title != JobVm.JobPost.ServiceCategory.Name)
                {
                    <span class="job-category">@JobVm.JobPost.ServiceCategory.Name</span>
                }
                <span class="job-status status-@(JobVm.JobPost.Status.ToString().ToLower()) m-0">@Loc[$"Status_{JobVm.JobPost.Status}"]</span>
            </div>
            @if (JobVm.TotalEstimatedPrice > 0)
            {
                <button type="button" class="price-toggle-badge" @onclick="ToggleBreakdownExpanded" @onclick:stopPropagation="true">
                    @Loc["GeneratedOffer_TotalValue"]: €@JobVm.TotalEstimatedPrice.ToString("F2")
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="transition: transform 0.2s; transform: @(_breakdownExpanded ? "rotate(180deg)" : "rotate(0deg)")">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </button>
            }
        </div>
    </div>

    @if (JobVm.Tasks != null && JobVm.Tasks.Any())
    {
        @if (_breakdownExpanded)
        {
            <div class="d-flex flex-column gap-4 mt-3 mb-3">
                @foreach (var task in JobVm.Tasks)
                {
                    <div class="bs-card p-4" style="border-radius: 12px; border-left: 4px solid var(--color-success); border-top: 1px solid var(--border-color); border-right: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color);">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h4 class="h5 fw-bold mb-0" style="color: var(--text-primary);">@task.Title</h4>
                            <span class="fw-bold" style="color: var(--color-success); font-size: 1.1rem;">
                                @string.Format(Loc["GeneratedOffer_TotalTaskCost"], task.EstimatedPrice.ToString("F2"))
                            </span>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(task.Description))
                        {
                            <p class="mb-4" style="font-size: 0.95rem; color: var(--text-muted);">@task.Description</p>
                        }

                        <hr style="border-color: var(--border-color); opacity: 0.5;" />
                        <h6 class="fw-bold mb-3" style="color: var(--color-primary);">@Loc["GeneratedOffer_BillableSKUs"]</h6>

                        @if (task.SkuItems != null && task.SkuItems.Count > 0)
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var sku in task.SkuItems)
                                {
                                    <div class="d-flex justify-content-between align-items-center p-3" style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; flex-wrap: wrap; gap: 10px;">
                                        <div class="d-flex align-items-center gap-3" style="min-width: 0; flex: 1;">
                                            <div style="min-width: 0; flex: 1;">
                                                <div class="fw-bold" style="color: var(--text-primary); font-size: 0.95rem; word-break: break-word; overflow-wrap: break-word;">@sku.ServiceSku.Name</div>
                                                <div style="color: var(--text-muted); font-size: 0.8rem; word-break: break-word; overflow-wrap: break-word;">
                                                    @sku.Quantity @(sku.ServiceSku.UnitType.ToString().ToLower()) × €@sku.ServiceSku.BasePrice.ToString("F2") / @(sku.ServiceSku.UnitType.ToString().ToLower())
                                                </div>
                                            </div>
                                        </div>
                                        <span class="fw-bold" style="color: var(--color-success); flex-shrink: 0;">
                                            €@sku.EstimatedPrice.ToString("F2")
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 0;">@Loc["GeneratedOffer_NoSKUs"]</p>
                        }
                    </div>
                }


                <div class="d-flex justify-content-center">
                    <button class="bs-btn-dark btn-sm w-100 w-sm-auto mb-2" @onclick="ToggleBreakdownExpanded" @onclick:stopPropagation="true">
                        @Loc["GeneratedOffer_HideTaskBreakdowns"]
                    </button>
                </div>
            </div>
        }
    }
    else
    {
        @if (!string.IsNullOrEmpty(JobVm.JobPost.Description) && JobVm.JobPost.Description != JobVm.JobPost.Title && JobVm.JobPost.Description != JobVm.JobPost.ServiceCategory.Name)
        {
            <div class="job-description mt-3 mb-3">
                @JobVm.JobPost.Description
            </div>
        }
    }

    <!-- Action Buttons -->
    <div class="d-flex flex-column gap-2 mt-4">
        @if (JobVm.JobPost.Bids != null && JobVm.JobPost.Bids.Any())
        {
            <button class="bs-btn-primary w-100" @onclick="async () => await OnViewAuctionHub.InvokeAsync()">
                @string.Format(Loc["ProjectDetail_ViewOffersCount"], JobVm.JobPost.Bids.Count)
            </button>
        }
        else if (JobVm.JobPost.Status == JobPostStatus.Open)
        {
            <button class="bs-btn-dark w-100" @onclick="async () => await OnViewAuctionHub.InvokeAsync()">
                @Loc["ProjectDetail_ViewAuctionZero"]
            </button>
        }
        
        @if (JobVm.JobPost.Status == JobPostStatus.GeneratingScope)
        {
            <div class="d-flex justify-content-center mt-2">
                <button class="bs-btn-primary w-100 py-2" disabled>
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    @Loc["JobWizard_OfferBuilding_Title"]
                </button>
            </div>
        }

        @if (JobVm.JobPost.Status == JobPostStatus.Draft)
        {
            <div class="d-flex justify-content-center mt-2">
                <button class="bs-btn-primary w-100 py-2" @onclick="async () => await OnEditAnswers.InvokeAsync()">@Loc["ProjectDetail_ContinueDraft"]</button>
            </div>
        }

        @if (IsAdmin)
        {
            <div class="d-flex justify-content-center mt-2">
                <button class="bs-btn-secondary w-100 py-2" @onclick="async () => await OnReviewScope.InvokeAsync()">
                    🛠️ Edit Task Breakdown
                </button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public JobPostViewModel JobVm { get; set; } = default!;

    [Parameter]
    public bool IsExpanded { get; set; }

    [Parameter]
    public bool IsAdmin { get; set; }

    [Parameter]
    public EventCallback OnToggleExpansion { get; set; }

    [Parameter]
    public EventCallback OnViewAuctionHub { get; set; }

    [Parameter]
    public EventCallback OnViewAIOffer { get; set; }

    [Parameter]
    public EventCallback OnEditAnswers { get; set; }

    [Parameter]
    public EventCallback OnSubmitToAdmin { get; set; }

    [Parameter]
    public EventCallback OnAskAdmin { get; set; }

    [Parameter]
    public EventCallback OnReviewScope { get; set; }

    private bool _breakdownExpanded = false;

    private void ToggleBreakdownExpanded()
    {
        _breakdownExpanded = !_breakdownExpanded;
        StateHasChanged();
    }
}
