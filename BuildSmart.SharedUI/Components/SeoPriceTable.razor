@using Microsoft.Extensions.Localization
@inject IStringLocalizer<BuildSmart.SharedUI.Resources.AppResources> Loc
@inject NavigationManager NavManager

<div class="bs-interio-price-table-card">
    <div class="table-header-banner">
        <h3 class="table-title">@Loc["PriceTable_Title"]</h3>
        <p class="table-subtitle">@Loc["PriceTable_Subtitle"]</p>
    </div>

    <div class="table-responsive-wrapper">
        <table class="bs-interio-price-table">
            <thead>
                <tr>
                    <th class="th-service">@Loc["PriceTable_ColService"]</th>
                    <th class="th-unit">@Loc["PriceTable_ColUnit"]</th>
                    <th class="th-price">@Loc["PriceTable_ColPriceBgn"]</th>
                    <th class="th-price">@Loc["PriceTable_ColPriceEur"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in GetPriceItems())
                {
                    @if (item.IsCategoryHeader)
                    {
                        <tr class="category-row">
                            <td colspan="4" class="category-header-cell">
                                <span class="category-badge">@item.ServiceName</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr class="item-row">
                            <td class="service-name-cell">
                                <span class="service-title">@item.ServiceName</span>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <span class="service-desc">@item.Description</span>
                                }
                            </td>
                            <td class="unit-cell">@item.Unit</td>
                            <td class="price-bgn-cell">@item.PriceBgn.ToString("F2") лв.</td>
                            <td class="price-eur-cell">€@FormatEur(item.PriceBgn)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="table-footer-cta">
        <button class="bs-interio-cta-btn" @onclick="NavigateToWizard">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
            <span>@Loc["PriceTable_Cta"]</span>
        </button>
    </div>
</div>

<style>
.bs-interio-price-table-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 24px;
    padding: 32px;
    margin: 36px 0;
    box-shadow: var(--shadow-main);
    width: 100%;
}

.table-header-banner {
    margin-bottom: 24px;
    text-align: left;
}

.table-title {
    font: var(--font-h4);
    color: var(--text-primary);
    margin: 0 0 6px 0;
    letter-spacing: -0.4px;
}

.table-subtitle {
    font: var(--font-body-1);
    color: var(--text-muted);
    margin: 0;
}

.table-responsive-wrapper {
    overflow-x: auto;
    border-radius: 16px;
    border: 1px solid var(--border-color);
}

.bs-interio-price-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
}

.bs-interio-price-table thead {
    background: var(--color-primary);
}

.bs-interio-price-table th {
    color: #ffffff !important;
    font: var(--font-h3);
    padding: 16px 20px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
}

.th-service { width: 50%; }
.th-unit { width: 15%; }
.th-price { width: 17.5%; }

.bs-interio-price-table td {
    padding: 15px 20px;
    border-bottom: 1px solid var(--border-color);
    font: var(--font-body-1);
    color: var(--text-primary);
    vertical-align: middle;
}

.category-row {
    background: var(--bg-card-alt);
}

.category-header-cell {
    padding: 12px 20px !important;
}

.category-badge {
    display: inline-block;
    background: var(--gradient-primary);
    color: #ffffff !important;
    font: var(--font-h3);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 5px 14px;
    border-radius: 8px;
    box-shadow: var(--elevation-02dp);
}

.item-row:hover {
    background: var(--bg-card-alt);
}

.service-name-cell {
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.service-title {
    font: var(--font-body-1);
    color: var(--text-primary);
}

.service-desc {
    font: var(--font-h3);
    color: var(--text-muted);
}

.unit-cell {
    font: var(--font-body-1);
    color: var(--text-secondary);
    white-space: nowrap;
}

.price-bgn-cell {
    font: var(--font-body-1);
    color: var(--text-primary);
    white-space: nowrap;
}

.price-eur-cell {
    font: var(--font-body-1);
    color: var(--color-success);
    white-space: nowrap;
}

.table-footer-cta {
    margin-top: 28px;
    display: flex;
    justify-content: center;
}

.bs-interio-cta-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: var(--gradient-primary);
    color: #ffffff !important;
    border: none;
    border-radius: 14px;
    padding: 16px 36px;
    font: var(--font-h6);
    cursor: pointer;
    box-shadow: var(--shadow-main);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    width: 100%;
    max-width: 600px;
}

.bs-interio-cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
}
</style>

@code {
    [Parameter]
    public string? SelectedCategory { get; set; }

    private void NavigateToWizard()
    {
        NavManager.NavigateTo("/renovation-estimator");
    }

    private string FormatEur(decimal bgnPrice)
    {
        return Math.Round(bgnPrice / 1.95583m, 2).ToString("F2");
    }

    private class PriceItem
    {
        public string ServiceName { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Unit { get; set; } = string.Empty;
        public decimal PriceBgn { get; set; }
        public bool IsCategoryHeader { get; set; }
    }

    private List<PriceItem> GetPriceItems()
    {
        var items = new List<PriceItem>
        {
            new PriceItem { ServiceName = "1. Къртене, Чистене и Извозване (Demolition)", IsCategoryHeader = true },
            new PriceItem { ServiceName = "Къртене на фаянс и теракот", Description = "Демонтаж на стари плочки в баня/кухня", Unit = "кв.м", PriceBgn = 12.50m },
            new PriceItem { ServiceName = "Къртене на тухлени стени", Description = "Премахване на преградни стени", Unit = "кв.м", PriceBgn = 22.00m },
            new PriceItem { ServiceName = "Извозване на строителни отпадъци", Description = "Товарене и контейнер до депо", Unit = "курс", PriceBgn = 140.00m },

            new PriceItem { ServiceName = "2. Шпакловка, Мазилка и Гипсокартон (Plastering & Drywall)", IsCategoryHeader = true },
            new PriceItem { ServiceName = "Гипсова мазилка по стени", Description = "Изравнителна мазилка по нивелация", Unit = "кв.м", PriceBgn = 18.50m },
            new PriceItem { ServiceName = "Фино шпакловане с Шитрок / Sheetrock", Description = "2 ръце за огледален завършек", Unit = "кв.м", PriceBgn = 9.50m },
            new PriceItem { ServiceName = "Окачен таван от гипсокартон", Description = "Конструкция Knauf с 12.5мм плоскост", Unit = "кв.м", PriceBgn = 38.00m },

            new PriceItem { ServiceName = "3. Баня & Лепене на Плочки (Tiling & Waterproofing)", IsCategoryHeader = true },
            new PriceItem { ServiceName = "Еластична двукомпонентна хидроизолация", Description = "Нанасяне на 2 ръце с хидроизолационна лента", Unit = "кв.м", PriceBgn = 16.00m },
            new PriceItem { ServiceName = "Лепене на фаянс и теракот (60x60 см)", Description = "Полагане с висок клас лепило C2TE", Unit = "кв.м", PriceBgn = 42.00m },
            new PriceItem { ServiceName = "Лепене на крупноформатен гранитогрес (60x120 см)", Description = "С рязане под 45 градуса (жоли)", Unit = "кв.м", PriceBgn = 58.00m },

            new PriceItem { ServiceName = "4. Боядисване и Настилки (Painting & Flooring)", IsCategoryHeader = true },
            new PriceItem { ServiceName = "Боядисване с латекс (2 ръце)", Description = "Висококачествен миещ се латекс", Unit = "кв.м", PriceBgn = 7.50m },
            new PriceItem { ServiceName = "Полагане на ламиниран паркет", Description = "Включително подложка и первази", Unit = "кв.м", PriceBgn = 9.00m },

            new PriceItem { ServiceName = "5. Електро и ВиК Инсталации (MEP Services)", IsCategoryHeader = true },
            new PriceItem { ServiceName = "Изграждане на нова ел. точка (ключ/контакт)", Description = "Окабеляване и конзолна кутия", Unit = "бр.", PriceBgn = 24.00m },
            new PriceItem { ServiceName = "Изграждане на ВиК точка (водопровод и канал)", Description = "Полипропиленови тръби PPR и PVC", Unit = "бр.", PriceBgn = 55.00m }
        };

        if (!string.IsNullOrEmpty(SelectedCategory))
        {
            var categoryLower = SelectedCategory.ToLowerInvariant();
            if (categoryLower.Contains("banya") || categoryLower.Contains("bathroom"))
            {
                items = items.Where(i => i.ServiceName.Contains("3.") || i.ServiceName.Contains("хидроизолация") || i.ServiceName.Contains("фаянс") || i.ServiceName.Contains("гранитогрес") || i.IsCategoryHeader && i.ServiceName.Contains("3.")).ToList();
            }
            else if (categoryLower.Contains("dovarshetelni") || categoryLower.Contains("finishing"))
            {
                items = items.Where(i => i.ServiceName.Contains("2.") || i.ServiceName.Contains("4.") || i.IsCategoryHeader && (i.ServiceName.Contains("2.") || i.ServiceName.Contains("4."))).ToList();
            }
            else if (categoryLower.Contains("mep") || categoryLower.Contains("el") || categoryLower.Contains("vik"))
            {
                items = items.Where(i => i.ServiceName.Contains("5.") || i.ServiceName.Contains("ел.") || i.ServiceName.Contains("ВиК") || i.IsCategoryHeader && i.ServiceName.Contains("5.")).ToList();
            }
        }

        return items;
    }
}
