@using Microsoft.Extensions.Localization
@inject IStringLocalizer<BuildSmart.SharedUI.Resources.AppResources> Loc
@inject NavigationManager NavManager

<div class="bs-interio-price-table-card">
    <div class="table-header-banner">
        <h3 class="table-title">@Loc["PriceTable_Title"]</h3>
        <p class="table-subtitle">@Loc["PriceTable_Subtitle"]</p>
    </div>

    <div class="table-responsive-wrapper">
        <table class="bs-interio-price-table">
            <thead>
                <tr>
                    <th class="th-service">@Loc["PriceTable_ColService"]</th>
                    <th class="th-unit">@Loc["PriceTable_ColUnit"]</th>
                    <th class="th-price">@Loc["PriceTable_ColPriceBgn"]</th>
                    <th class="th-price">@Loc["PriceTable_ColPriceEur"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in GetPriceItems())
                {
                    @if (item.IsCategoryHeader)
                    {
                        <tr class="category-row">
                            <td colspan="4" class="category-header-cell">
                                <span class="category-badge">@item.ServiceName</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr class="item-row">
                            <td class="service-name-cell">
                                <span class="service-title">@item.ServiceName</span>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <span class="service-desc">@item.Description</span>
                                }
                            </td>
                            <td class="unit-cell">@item.Unit</td>
                            <td class="price-bgn-cell">@item.PriceBgn.ToString("F2") @(IsEnglish ? "BGN" : "лв.")</td>
                            <td class="price-eur-cell">€@FormatEur(item.PriceBgn)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="table-footer-cta">
        <button class="bs-interio-cta-btn" @onclick="NavigateToWizard">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
            <span>@Loc["PriceTable_Cta"]</span>
        </button>
    </div>
</div>

<style>
.bs-interio-price-table-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 24px;
    padding: 32px;
    margin: 36px 0;
    box-shadow: var(--shadow-main);
    width: 100%;
}

.table-header-banner {
    margin-bottom: 24px;
    text-align: left;
}

.table-title {
    font: var(--font-h4);
    color: var(--text-primary);
    margin: 0 0 6px 0;
    letter-spacing: -0.4px;
}

.table-subtitle {
    font: var(--font-body-1);
    color: var(--text-muted);
    margin: 0;
}

.table-responsive-wrapper {
    overflow-x: auto;
    border-radius: 16px;
    border: 1px solid var(--border-color);
}

.bs-interio-price-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font: var(--font-body-1);
}

.bs-interio-price-table th {
    background: var(--color-primary);
    color: #ffffff;
    padding: 16px 20px;
    font: var(--font-h3);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.th-service { width: 50%; }
.th-unit { width: 15%; }
.th-price { width: 17.5%; }

.bs-interio-price-table td {
    padding: 16px 20px;
    border-bottom: 1px solid var(--border-color);
    vertical-align: middle;
}

.category-row {
    background: var(--bg-card-alt);
}

.category-header-cell {
    padding: 12px 20px !important;
}

.category-badge {
    font: var(--font-h3);
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.item-row:hover {
    background: var(--bg-card-alt);
}

.service-name-cell {
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.service-title {
    display: block;
    font: var(--font-h6);
    color: var(--text-primary);
    font-weight: 600;
}

.service-desc {
    display: block;
    font: var(--font-body-1);
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-top: 2px;
}

.unit-cell {
    font: var(--font-body-1);
    color: var(--text-secondary);
    white-space: nowrap;
}

.price-bgn-cell {
    font: var(--font-h6);
    color: var(--text-primary);
    font-weight: 700;
    white-space: nowrap;
}

.price-eur-cell {
    font: var(--font-body-1);
    color: var(--color-success);
    white-space: nowrap;
}

.table-footer-cta {
    margin-top: 28px;
    display: flex;
    justify-content: center;
}

.bs-interio-cta-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: var(--gradient-primary);
    color: #ffffff !important;
    border: none;
    border-radius: 14px;
    padding: 16px 36px;
    font: var(--font-h6);
    cursor: pointer;
    box-shadow: var(--shadow-main);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    width: 100%;
    max-width: 600px;
}

.bs-interio-cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
}
</style>

@code {
    [Parameter]
    public string? SelectedCategory { get; set; }

    private bool IsEnglish => System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName.Equals("en", StringComparison.OrdinalIgnoreCase);

    private void NavigateToWizard()
    {
        var scope = "full";
        if (!string.IsNullOrEmpty(SelectedCategory))
        {
            var categoryLower = SelectedCategory.ToLowerInvariant();
            if (categoryLower.Contains("banya") || categoryLower.Contains("bathroom"))
            {
                scope = "bathroom";
            }
            else if (categoryLower.Contains("dovarshetelni") || categoryLower.Contains("finishing") || categoryLower.Contains("mep") || categoryLower.Contains("el") || categoryLower.Contains("vik"))
            {
                scope = "finishing";
            }
        }
        NavManager.NavigateTo($"/renovation-estimator?scope={scope}");
    }

    private string FormatEur(decimal bgnPrice)
    {
        return Math.Round(bgnPrice / 1.95583m, 2).ToString("F2");
    }

    private class PriceItem
    {
        public int CategoryId { get; set; }
        public string ServiceName { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Unit { get; set; } = string.Empty;
        public decimal PriceBgn { get; set; }
        public bool IsCategoryHeader { get; set; }
    }

    private List<PriceItem> GetPriceItems()
    {
        var isEn = IsEnglish;
        var items = new List<PriceItem>
        {
            new PriceItem { CategoryId = 1, ServiceName = isEn ? "1. Demolition, Cleaning & Waste Disposal" : "1. Къртене, Чистене и Извозване", IsCategoryHeader = true },
            new PriceItem { CategoryId = 1, ServiceName = isEn ? "Tiles & Terracotta Demolition" : "Къртене на фаянс и теракот", Description = isEn ? "Old tiles removal in bathroom/kitchen" : "Демонтаж на стари плочки в баня/кухня", Unit = isEn ? "sq.m" : "кв.м", PriceBgn = 15.00m },
            new PriceItem { CategoryId = 1, ServiceName = isEn ? "Brick Wall Demolition" : "Къртене на тухлени стени", Description = isEn ? "Partition walls removal" : "Премахване на преградни стени", Unit = isEn ? "sq.m" : "кв.м", PriceBgn = 20.00m },
            new PriceItem { CategoryId = 1, ServiceName = isEn ? "Construction Waste Hauling" : "Извозване на строителни отпадъци", Description = isEn ? "Loading and container transport to landfill" : "Товарене и контейнер до депо", Unit = isEn ? "trip" : "курс", PriceBgn = 150.00m },

            new PriceItem { CategoryId = 2, ServiceName = isEn ? "2. Plastering, Render & Drywall" : "2. Шпакловка, Мазилка и Гипсокартон", IsCategoryHeader = true },
            new PriceItem { CategoryId = 2, ServiceName = isEn ? "Gypsum Wall Plaster" : "Гипсова мазилка по стени", Description = isEn ? "Leveling plaster work by alignment" : "Изравнителна мазилка по нивелация", Unit = isEn ? "sq.m" : "кв.м", PriceBgn = 20.00m },
            new PriceItem { CategoryId = 2, ServiceName = isEn ? "Fine Plastering with Sheetrock" : "Фино шпакловане с Шитрок / Sheetrock", Description = isEn ? "2 coats for smooth mirror finish" : "2 ръце за огледален завършек", Unit = isEn ? "sq.m" : "кв.м", PriceBgn = 20.00m },
            new PriceItem { CategoryId = 2, ServiceName = isEn ? "Gypsum Drywall Suspended Ceiling" : "Окачен таван от гипсокартон", Description = isEn ? "Knauf structure with 12.5mm board" : "Конструкция Knauf с 12.5мм плоскост", Unit = isEn ? "sq.m" : "кв.м", PriceBgn = 45.00m },

            new PriceItem { CategoryId = 3, ServiceName = isEn ? "3. Bathroom & Tiling" : "3. Баня & Лепене на Плочки", IsCategoryHeader = true },
            new PriceItem { CategoryId = 3, ServiceName = isEn ? "Elastic 2-Component Waterproofing" : "Еластична двукомпонентна хидроизолация", Description = isEn ? "2 coats application with sealing tape" : "Нанасяне на 2 ръце с хидроизолационна лента", Unit = isEn ? "sq.m" : "кв.м", PriceBgn = 30.00m },
            new PriceItem { CategoryId = 3, ServiceName = isEn ? "Faience & Terracotta Tiling (60x60 cm)" : "Лепене на фаянс и теракот (60x60 см)", Description = isEn ? "Laying with high-grade C2TE adhesive" : "Полагане с висок клас лепило C2TE", Unit = isEn ? "sq.m" : "кв.м", PriceBgn = 60.00m },
            new PriceItem { CategoryId = 3, ServiceName = isEn ? "Large-Format Porcelain Tiling (60x120 cm)" : "Лепене на крупноформатен гранитогрес (60x120 см)", Description = isEn ? "With 45-degree miter corner cuts" : "С рязане под 45 градуса (жоли)", Unit = isEn ? "sq.m" : "кв.м", PriceBgn = 95.00m },

            new PriceItem { CategoryId = 4, ServiceName = isEn ? "4. Painting & Flooring" : "4. Боядисване и Настилки", IsCategoryHeader = true },
            new PriceItem { CategoryId = 4, ServiceName = isEn ? "Latex Painting (2 coats)" : "Боядисване с латекс (2 ръце)", Description = isEn ? "High-quality washable latex paint" : "Висококачествен миещ се латекс", Unit = isEn ? "sq.m" : "кв.м", PriceBgn = 7.50m },
            new PriceItem { CategoryId = 4, ServiceName = isEn ? "Laminate Flooring Installation" : "Полагане на ламиниран паркет", Description = isEn ? "Including underlayment and baseboards" : "Включително подложка и первази", Unit = isEn ? "sq.m" : "кв.м", PriceBgn = 6.00m },

            new PriceItem { CategoryId = 5, ServiceName = isEn ? "5. Electrical & Plumbing (MEP Services)" : "5. Електро и ВиК Инсталации", IsCategoryHeader = true },
            new PriceItem { CategoryId = 5, ServiceName = isEn ? "New Electrical Point (Switch / Socket)" : "Изграждане на нова ел. точка (ключ/контакт)", Description = isEn ? "Wiring and backbox installation" : "Окабеляване и конзолна кутия", Unit = isEn ? "pcs" : "бр.", PriceBgn = 35.00m },
            new PriceItem { CategoryId = 5, ServiceName = isEn ? "New Plumbing Point (Supply & Drainage)" : "Изграждане на ВиК точка (водопровод и канал)", Description = isEn ? "Polypropylene PPR and PVC pipes" : "Полипропиленови тръби PPR и PVC", Unit = isEn ? "pcs" : "бр.", PriceBgn = 70.00m }
        };

        if (!string.IsNullOrEmpty(SelectedCategory))
        {
            var categoryLower = SelectedCategory.ToLowerInvariant();
            if (categoryLower.Contains("banya") || categoryLower.Contains("bathroom"))
            {
                items = items.Where(i => i.CategoryId == 3).ToList();
            }
            else if (categoryLower.Contains("dovarshetelni") || categoryLower.Contains("finishing"))
            {
                items = items.Where(i => i.CategoryId == 2 || i.CategoryId == 4).ToList();
            }
            else if (categoryLower.Contains("mep") || categoryLower.Contains("el") || categoryLower.Contains("vik"))
            {
                items = items.Where(i => i.ServiceName.Contains("5.") || i.ServiceName.Contains("ел.") || i.ServiceName.Contains("ВиК") || i.IsCategoryHeader && i.ServiceName.Contains("5.")).ToList();
            }
        }

        return items;
    }
}
